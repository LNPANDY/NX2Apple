+EGL(eglQuerySurface, EGLBoolean, EGLDisplay d, EGLSurface surface, EGLint attr, EGLint *value) {
+    if (d != (EGLDisplay)&g_egl) { g_egl_error = 0x3008; return 0; }   // BAD_DISPLAY
+    if (!g_egl.init) { g_egl_error = 0x3001; return 0; }   // NOT_INITIALIZED
+    if (surface != (EGLSurface)(uintptr_t)3 || !g_egl.surface) { g_egl_error = 0x300d; return 0; }   // BAD_SURFACE
+    if (!value) { g_egl_error = 0x300c; return 0; }   // BAD_PARAMETER
+    switch (attr) {
+        case 0x3057: *value = (EGLint)g_win.w; break;   // WIDTH
+        case 0x3056: *value = (EGLint)g_win.h; break;   // HEIGHT
+        case 0x3028: *value = 1; break;   // CONFIG_ID
+        default: RED1("eglQuerySurface(%#x) not implemented", attr); g_egl_error = 0x3004; return 0;   // BAD_ATTRIBUTE
+    }
+    return EGL_TRUE;
