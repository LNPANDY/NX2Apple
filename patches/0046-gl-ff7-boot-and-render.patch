--- /dev/null
+++ b/dm/gfx/tests/test_gl_shaders.py
@@ -0,0 +1,49 @@
+"""gl_shaders.py: what FINAL FANTASY VII's GLSL (0100A5B00BDC6000) needs from the GL → MSL translation.
+The translation tests need glslangValidator on PATH and the in-repo spirv-cross (dmsh_chain.SPIRV_CROSS), and are skipped without them."""
+import os
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'tools'))
+import gl_shaders   # noqa: E402
+
+TOOLS = bool(shutil.which('glslangValidator')) and os.path.isfile(gl_shaders.SPIRV_CROSS)
+
+
+class FixupTests(unittest.TestCase):
+    def test_lod_zero_offset_from_a_parameter(self):   # FFVII's FXAA passes the offset through a helper's parameter, which NVIDIA inlines
+        out = gl_shaders.fixups('vec4 f(ivec2 o) { return textureLodOffset(tex, uv, 0.0, o); }')
+        self.assertIn('textureLod(tex, (uv) + vec2(o) / vec2(textureSize(tex, 0)), 0.0)', out)
+        self.assertNotIn('textureLodOffset', out)
+
+    def test_other_lods_stay(self):
+        src = 'vec4 f(ivec2 o) { return textureLodOffset(tex, uv, 1.0, o); }'
+        self.assertEqual(gl_shaders.fixups(src), src)
+
+
+@unittest.skipUnless(TOOLS, 'needs glslangValidator and spirv-cross')
+class TranslateTests(unittest.TestCase):
+    def test_es_version_without_profile_and_named_block(self):   # FFVII writes '#version 320' and binds named uniform blocks
+        src = (b'#version 320\nprecision highp float;\nlayout(binding=0) uniform BlockVertex { mat4 projection; };\n'
+               b'layout(location=0) in vec4 position;\nvoid main(){gl_Position=projection*position;}\n')
+        with tempfile.TemporaryDirectory() as d:
+            result = gl_shaders.translate(src, 'vert', 'synthetic', d)
+            self.assertIsInstance(result, tuple, result)
+            self.assertIn('B:BlockVertex=0:64', result[1])
+
+    def test_depth_writer_gets_a_depthless_variant(self):   # GL drops gl_FragDepth on a target without depth, Metal rejects the pipeline
+        src = b'#version 320\nprecision highp float;\nlayout(location=0) out vec4 color;\nvoid main(){color=vec4(1);gl_FragDepth=0.5;}\n'
+        with tempfile.TemporaryDirectory() as d:
+            result = gl_shaders.translate(src, 'frag', 'depth_test', d)
+            self.assertIsInstance(result, tuple, result)
+            variant = Path(d) / 'depth_test_nd_f.metal'
+            self.assertTrue(variant.exists())
+            self.assertNotIn('[[depth(', variant.read_text())
+            self.assertIn('[[depth(', Path(result[0]).read_text())
+
+
+if __name__ == '__main__':
+    unittest.main()
