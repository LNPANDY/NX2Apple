diff --git a/dm/ios/tests/test_quit_prompt.py b/dm/ios/tests/test_quit_prompt.py
new file mode 100644
index 0000000..f967d5f
--- /dev/null
+++ b/dm/ios/tests/test_quit_prompt.py
@@ -0,0 +1,37 @@
+"""The iOS quit prompt (dm/ios/Sources/quit_prompt.h), built and run on the Mac.
+
+quit_prompt/quit_prompt_check.m runs the touch steps of the quit state machine (a tap on the quit control opens the prompt, Cancel or a
+tap outside closes it, Quit is final, a controller button already held when it opens does not count), and lays the prompt out on the
+iPhone, iPad and iPhone Duo screens in the six languages of the launchers: the card stays on the screen, the two pills keep one fixed
+width whatever the language and every label fits at full size, and a tap lands where it should. Core Animation and Core Text only, so
+no simulator is needed. QP_CAPTURE_DIR=<dir> also draws the prompt over the touch controls to PNGs.
+"""
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+IOS = Path(__file__).resolve().parents[1]
+HERE = Path(__file__).resolve().parent
+
+
+@unittest.skipUnless(sys.platform == "darwin" and shutil.which("clang"), "needs clang and the Mac's Core Animation")
+class QuitPromptTests(unittest.TestCase):
+    def test_states_layout_and_hits(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            exe = Path(tmp) / "quit_prompt_check"
+            subprocess.run(["clang", "-x", "objective-c", "-fobjc-arc", "-Wall", "-Werror", "-Wno-unused-function",
+                            "-I", str(HERE / "pad_geometry"), "-I", str(IOS / "Sources"), "-I", str(IOS.parent / "host"),
+                            str(HERE / "quit_prompt" / "quit_prompt_check.m"),
+                            "-framework", "Foundation", "-framework", "AppKit", "-framework", "QuartzCore", "-framework", "CoreText",
+                            "-o", str(exe)], check=True)
+            run = subprocess.run([str(exe)], capture_output=True, text=True, env=os.environ)
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertIn("ok:", run.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/docs/env_switches.tsv b/docs/env_switches.tsv
index e493c69..976072b 100644
--- a/docs/env_switches.tsv
+++ b/docs/env_switches.tsv
@@ -69,9 +69,9 @@ DM_HID_MAP	switch	`=<map>` such as `A=1,B=2,X=4,Y=5`: which HID button usage pre
 DM_HID_PADS	switch	`0` stops reading raw HID gamepads that GameController does not list, such as an 8BitDo in its own mode (`pad_hid_mac.h`); Mac only
 DM_HITCH_DUMP	diagnostic	`=<ms>[:<s>]`: when no frame has been presented for that long (from s seconds on), logs every guest thread once per stall: wait, last SVC, pc, lr, frames and registers
 DM_HLECOUNT	diagnostic	`=<file>` (`%d` = process ID) writes at exit a TSV of how many times the guest called each HLE function, zero counts included
-DM_HOME_QUIT	player	`0` turns off quitting with the controller's Home button (Mac, macOS 27 or later, on by default): held for 2 s it opens a quit prompt over the game, A quits as ⌘Q does, B or Home closes it (`home_quit.h`)
+DM_HOME_QUIT	player	`0` turns off quitting with the controller's Home button (Mac on macOS 27 or later, iOS, on by default): held for 2 s it opens a quit prompt over the game, A quits as ⌘Q does (on iOS the app closes after the cloud saves went out), B or Home closes it (`home_quit.h`, `quit_prompt.h`)
 DM_HOME_QUIT_CAPTURE	test	`=<folder>`: `tests/t_home_quit_mac.m` also draws the Home button's quit prompt and hold indicator into PNG files there
-DM_HOME_QUIT_TEXT	switch	The texts of the Home button's quit prompt in the player's language, one per line: the hold indicator, the title, the note, the quit and the cancel button; the Mac launcher sets it, an empty or missing line keeps the English text
+DM_HOME_QUIT_TEXT	switch	The texts of the Home button's quit prompt in the player's language, one per line: the hold indicator, the title, the note, the quit and the cancel button; the Mac launcher and the iOS shell set it, an empty or missing line keeps the English text
 DM_HUD_PER_LAYER	switch	`1`: the shell app sets it at start together with `MTL_HUD_ENABLED`, and the game view then turns Apple's Metal HUD off on its layer unless `DM_METAL_HUD` is `1`
 DM_ICON	path	`=<image>` gives `build_ipa.sh` another app icon (default the `icon.jpg` beside the RomFS)
 DM_IMPORTS	diagnostic	When set, logs each import the loader binds to a host function and each forced takeover
@@ -329,6 +329,7 @@ DM_TEST_UP_LOST	diagnostic	`=<batch index>` treats that batch of uploads as drop
 DM_THERMAL_CAP	switch	`0` turns off the thermal cap, which holds the frame step at 30 fps while iOS reports a serious or critical thermal state (on by default)
 DM_THR	diagnostic	`=1` logs each SVC (except `SleepThread`) with its first four arguments, and each `CreateThread` with entry, stack, priority and core
 DM_THRCPU	diagnostic	`=<tsv path>[,<seconds>]` writes each thread's CPU time (100% = one core) and the total every interval (default 10 s); on iOS a relative path is under `Documents`
+DM_TOUCH_EXIT	player	`0` hides the iOS touch controls' quit control (shown by default): a small × in the top row, left of −, whose tap opens the quit prompt (`quit_prompt.h`); the shell's Touch controls setting
 DM_TOUCH_HAPTICS	player	`0` turns off the light haptic tap when a touch control is pressed (on by default); launcher setting
 DM_TOUCH_LOG	diagnostic	`=1` logs each touch-screen read with touch points (sample, finger, position, attributes) and each gesture entry, up to 500 lines
 DM_UDC_SELFTEST	diagnostic	`=1` runs a start-up check of DontCare load and store on private depth-stencil and RGBA8 textures (clear, Load + DontCare, read back) and logs one result line
