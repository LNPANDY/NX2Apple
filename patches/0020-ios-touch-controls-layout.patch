@@ -7,7 +7,8 @@ void dm_thread_service_connect(void) {}   // threads started so far have nothing
 #include <stddef.h>
 #include <sys/wait.h>
 #include <unistd.h>
-void mtl_present_screen(uint32_t w, uint32_t h) { (void)w; (void)h; }   // loader.c: a screen taller than 16:9; no renderer here
+static uint32_t g_present_w, g_present_h;
+void mtl_present_screen(uint32_t w, uint32_t h) { g_present_w = w; g_present_h = h; }   // loader.c: a screen taller than 16:9; no renderer here
 // 40 fps (loader.c, compiled here): only a stub that takes ticks of 1/120 s (the FRAME_STEP_120 capability in its fixups table) gets it; the loader writes the step's unit (+0x38)
 // for it, 120, at every start, and 0 for every other stub. Elsewhere DM_FPS_TARGET=40 holds 30
 static float page_target(const uint8_t *page) { float t; memcpy(&t, page, 4); return t; }
@@ -32,6 +33,45 @@ static void fps_40(void) {
     puts("40 fps only for a stub in ticks of 1/120 s (FRAME_STEP_120), the step's unit in the state page: OK");
 }

+static uint32_t page_u32(const uint8_t *page, size_t off) { uint32_t v; memcpy(&v, page + off, 4); return v; }
+static void screen_aspect_bounds(void) {
+    _Alignas(8) uint8_t page[0x100] = {0};
+    module_t m = {.base = page, .size = sizeof page};
+    strcpy(m.name, "main");
+    unsetenv("DM_FPS_TARGET"); unsetenv("DM_RENDER_SCALE"); unsetenv("DM_DYNAMIC_RESOLUTION");
+    install_fps_state(&m);
+
+    // Portrait full-top slot (~0.98 on Pro Max): accepted and quantized to a multiple of 48 (1968, layout 1312)
+    g_present_w = g_present_h = 0;
+    setenv("DM_SCREEN_ASPECT", "0.980", 1); dm_fps_state_apply();
+    assert(page_u32(page, 0x48) == 1968 && page_u32(page, 0x4c) == 1312);
+    assert(g_present_w == 1920 && g_present_h == 1968);
+
+    // Lower bound 0.85: accepted (2256, layout 1504)
+    memset(page, 0, sizeof page); g_present_w = g_present_h = 0;
+    install_fps_state(&m);
+    setenv("DM_SCREEN_ASPECT", "0.85", 1); dm_fps_state_apply();
+    assert(page_u32(page, 0x48) == 2256 && page_u32(page, 0x4c) == 1504);
+    assert(g_present_w == 1920 && g_present_h == 2256);
+
+    // Standard portrait 4:3 (1.333): 1920x1440, layout 1280x960
+    memset(page, 0, sizeof page); g_present_w = g_present_h = 0;
+    install_fps_state(&m);
+    setenv("DM_SCREEN_ASPECT", "1.333", 1); dm_fps_state_apply();
+    assert(page_u32(page, 0x48) == 1440 && page_u32(page, 0x4c) == 960);
+
+    // Out-of-range (< 0.85 or >= 1.77): rejected, keeping 16:9 (0)
+    memset(page, 0, sizeof page); g_present_w = g_present_h = 0;
+    install_fps_state(&m);
+    setenv("DM_SCREEN_ASPECT", "0.84", 1); dm_fps_state_apply();
+    assert(page_u32(page, 0x48) == 0 && g_present_h == 0);
+    setenv("DM_SCREEN_ASPECT", "1.77", 1); dm_fps_state_apply();
+    assert(page_u32(page, 0x48) == 0 && g_present_h == 0);
+
+    unsetenv("DM_SCREEN_ASPECT"); dm_fps_state = NULL; g_fps_mod = NULL;
+    puts("DM_SCREEN_ASPECT bounds (0.85..1.77 portrait full-top and 4:3): OK");
+}
+
 // ALIAS_CUT rows in fixups.tsv: restored at load on a 64 GB Mac alias region, kept under a smaller DM_ALIAS_SIZE or DM_KEEP_ALIAS_CUTS=1, and fail-closed on byte mismatch.
 static void alias_cuts(void) {
     char dir[] = "/tmp/dm_alias_cut_XXXXXX";
@@ -121,6 +161,7 @@ static void unload(int i) { h_ro_UnloadModule(&handles[i - 1]); assert(!g_mod[i]

 int main(void) {
     fps_40();
+    screen_aspect_bounds();
     alias_cuts();
     FILE *manifest = tmpfile(); assert(manifest);
     fputs("# NRO manifest\n\nrefused 00 128\n", manifest);
