+- (void)testPortraitAutoScreenAspectResolves43InBothFitAndFillAndRespectsOrientation {
+    char *savedAspect = getenv("DM_SCREEN_ASPECT") ? strdup(getenv("DM_SCREEN_ASPECT")) : NULL;
+    char *savedFit = getenv("DM_PICTURE_FIT") ? strdup(getenv("DM_PICTURE_FIT")) : NULL;
+    char *savedRot = getenv("DM_ROTATION") ? strdup(getenv("DM_ROTATION")) : NULL;
+    UIViewController *root = [self harnessRootViewController];
+    UIWindow *win = root.view.window;
+    CGRect savedWinFrame = win.frame;
+    @try {
+        UIEdgeInsets ptInsets = UIEdgeInsetsMake(59, 0, 34, 0);
+        UIEdgeInsets lsInsets = UIEdgeInsetsMake(0, 59, 21, 59);
+        CGSize portrait = CGSizeMake(390, 844);
+        CGSize landscape = CGSizeMake(844, 390);
+
+        // 1. Portrait + default unset / explicit fit with DM_SCREEN_ASPECT=auto resolves to 4:3 (1.333).
+        unsetenv("DM_PICTURE_FIT");
+        unsetenv("DM_ROTATION");
+        setenv("DM_SCREEN_ASPECT", "auto", 1);
+        front_ios_resolve_auto_screen_aspect(portrait, ptInsets, 0, NO);
+        XCTAssertEqualObjects(@(getenv("DM_SCREEN_ASPECT") ?: ""), @"1.333");
+
+        setenv("DM_PICTURE_FIT", "fit", 1);
+        setenv("DM_SCREEN_ASPECT", "auto", 1);
+        front_ios_resolve_auto_screen_aspect(portrait, ptInsets, 0, NO);
+        XCTAssertEqualObjects(@(getenv("DM_SCREEN_ASPECT") ?: ""), @"1.333");
+
+        // 2. Portrait + fill also resolves to 4:3 (1.333).
+        setenv("DM_PICTURE_FIT", "fill", 1);
+        setenv("DM_SCREEN_ASPECT", "auto", 1);
+        front_ios_resolve_auto_screen_aspect(portrait, ptInsets, 0, NO);
+        XCTAssertEqualObjects(@(getenv("DM_SCREEN_ASPECT") ?: ""), @"1.333");
+
+        // 3. Explicit 16:9 (0) stays 0 in portrait fit.
+        setenv("DM_PICTURE_FIT", "fit", 1);
+        setenv("DM_SCREEN_ASPECT", "0", 1);
+        front_ios_resolve_auto_screen_aspect(portrait, ptInsets, 0, NO);
+        XCTAssertEqualObjects(@(getenv("DM_SCREEN_ASPECT") ?: ""), @"0");
+
+        // 4. Landscape window with auto rotation resolves auto to 0 (16:9).
+        setenv("DM_ROTATION", "auto", 1);
+        setenv("DM_SCREEN_ASPECT", "auto", 1);
+        front_ios_resolve_auto_screen_aspect(landscape, lsInsets, 0, NO);
+        XCTAssertEqualObjects(@(getenv("DM_SCREEN_ASPECT") ?: ""), @"0");
+
+        // 5. Orientation lock overrides pending window bounds before async geometry update finishes.
+        setenv("DM_ROTATION", "landscape", 1);
+        setenv("DM_SCREEN_ASPECT", "auto", 1);
+        front_ios_resolve_auto_screen_aspect(portrait, ptInsets, 0, NO);
+        XCTAssertEqualObjects(@(getenv("DM_SCREEN_ASPECT") ?: ""), @"0");
+
+        setenv("DM_ROTATION", "portrait", 1);
+        setenv("DM_SCREEN_ASPECT", "auto", 1);
+        front_ios_resolve_auto_screen_aspect(landscape, lsInsets, 0, NO);
+        XCTAssertEqualObjects(@(getenv("DM_SCREEN_ASPECT") ?: ""), @"1.333");
+
+        // 6. Production DmRootVC in portrait Fit renders true 4:3 (1920x1440) edge-to-edge inside the 4:3 slot,
+        // while 16:9 (1920x1080) stays centered uncropped in Fit and crops only in Fill; rotating to landscape keeps 4:3.
+        if (win) {
+            win.frame = CGRectMake(0, 0, portrait.width, portrait.height);
+            dm_setting_live("DM_PICTURE_FIT", "fit");
+            front_picture_shape(1920, 1440);
+            XCTestExpectation *applied43 = [self expectationWithDescription:@"4:3 applied"];
+            dispatch_async(dispatch_get_main_queue(), ^{ [applied43 fulfill]; });
+            [self waitForExpectations:@[applied43] timeout:2];
+            [root.view setNeedsLayout];
+            [root.view layoutIfNeeded];
+            UIView *gameClip = [root valueForKey:@"gameClip"];
+            UIView *game = [root valueForKey:@"game"];
+            XCTAssertEqualWithAccuracy(gameClip.frame.size.width / gameClip.frame.size.height, 4.0 / 3.0, 0.01);
+            XCTAssertTrue(CGRectEqualToRect(game.frame, gameClip.bounds), @"4:3 output fills portrait 4:3 slot uncropped in Fit: %@ vs %@", NSStringFromCGRect(game.frame), NSStringFromCGRect(gameClip.bounds));
+
+            front_picture_shape(1920, 1080);
+            XCTestExpectation *applied169 = [self expectationWithDescription:@"16:9 applied"];
+            dispatch_async(dispatch_get_main_queue(), ^{ [applied169 fulfill]; });
+            [self waitForExpectations:@[applied169] timeout:2];
+            [root.view setNeedsLayout];
+            [root.view layoutIfNeeded];
+            XCTAssertEqualWithAccuracy(game.frame.size.width / game.frame.size.height, 16.0 / 9.0, 0.01);
+            XCTAssertLessThan(game.frame.size.height, gameClip.bounds.size.height, @"16:9 stays letterboxed inside 4:3 slot under Fit");
+            XCTAssertEqualWithAccuracy(game.frame.size.width, gameClip.bounds.size.width, 0.5);
+
+            dm_setting_live("DM_PICTURE_FIT", "fill");
+            [root.view setNeedsLayout];
+            [root.view layoutIfNeeded];
+            XCTAssertEqualWithAccuracy(game.frame.size.height, gameClip.bounds.size.height, 0.5, @"16:9 crops sides to fill 4:3 slot under Fill");
+            XCTAssertGreaterThan(game.frame.size.width, gameClip.bounds.size.width);
+
+            win.frame = CGRectMake(0, 0, landscape.width, landscape.height);
+            dm_setting_live("DM_PICTURE_FIT", "fit");
+            front_picture_shape(1920, 1440);
+            XCTestExpectation *appliedLs = [self expectationWithDescription:@"landscape 4:3 applied"];
+            dispatch_async(dispatch_get_main_queue(), ^{ [appliedLs fulfill]; });
+            [self waitForExpectations:@[appliedLs] timeout:2];
+            [root.view setNeedsLayout];
+            [root.view layoutIfNeeded];
+            XCTAssertEqualWithAccuracy(game.frame.size.width / game.frame.size.height, 4.0 / 3.0, 0.01, @"Rotating to landscape preserves 4:3 without squashing");
+        }
+    } @finally {
+        if (win) {
+            win.frame = savedWinFrame;
+            dm_setting_live("DM_PICTURE_FIT", "fit");
+            front_picture_shape(1920, 1080);
+            XCTestExpectation *restored = [self expectationWithDescription:@"layout restored"];
+            dispatch_async(dispatch_get_main_queue(), ^{ [restored fulfill]; });
+            [self waitForExpectations:@[restored] timeout:2];
+            [root.view setNeedsLayout];
+            [root.view layoutIfNeeded];
+        }
+        if (savedAspect) { setenv("DM_SCREEN_ASPECT", savedAspect, 1); free(savedAspect); } else unsetenv("DM_SCREEN_ASPECT");
+        if (savedFit) { setenv("DM_PICTURE_FIT", savedFit, 1); free(savedFit); } else unsetenv("DM_PICTURE_FIT");
+        if (savedRot) { setenv("DM_ROTATION", savedRot, 1); free(savedRot); } else unsetenv("DM_ROTATION");
