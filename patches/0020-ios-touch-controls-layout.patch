+static inline DmLayout dm_layout_with_portrait_edge(CGRect b, UIEdgeInsets insets, BOOL partiallyOpen, CGRect division, CGFloat aspect, BOOL portraitEdgeToEdge) {
+    if (!portraitEdgeToEdge || b.size.height <= b.size.width) return dm_layout(b, insets, partiallyOpen, division, aspect);
+    CGRect fit = dm_aspect_fit(b, aspect);
+    DmLayout l = { .game = fit, .gameClip = fit, .upper = b, .controls = b };
+    if (CGRectIsEmpty(b)) return l;
+    division = dm_horizontal_division(b, division);
+    if (CGRectIsNull(division)) division = CGRectMake(b.origin.x, CGRectGetMidY(b), b.size.width, 0);
+    CGRect safe = UIEdgeInsetsInsetRect(b, insets);
+    CGRect upper = CGRectMake(CGRectGetMinX(b), CGRectGetMinY(b), b.size.width,
+                             CGRectGetMinY(division) - CGRectGetMinY(b));
