+    for (int i = 0; i < n; i++) {
+        if (p[i].revents & (POLLIN | POLLHUP)) f[i].got |= CP_IN;   // a hang-up reads as end of stream
+        if (p[i].revents & POLLOUT) f[i].got |= CP_OUT;
+        if (p[i].revents & (POLLERR | POLLNVAL)) f[i].got |= CP_ERR;
+    }
+    return k;
+#endif
