@@ -38,6 +38,24 @@ mem_used	0x5600000
 # the game sets near = 0 (the log's depth mode line): the pipeline bases made before it runs are made for that mode
 depth_mode	zero
 
+# ---- Frame rate ----
+# The game steps its time by how long each frame took (whole 1/60 s ticks, up to 50 ms), so a cap needs no frame step:
+# it is applied by the present interval alone (display mode). The launcher offers 30 / 60 fps, 60 by default.
+present_interval	display
+fps_target	60
+
+# ---- Render scale ----
+# The render-scale stub (patches.py) takes the scale as a fraction of 1920x1080 and caps it to the operation mode's
+# ladder size (handheld 1600x900, docked 1920x1080), so each 0.05 step maps to a whole 32x18 ladder step.
+render_base	1920x1080 1920x1080
+render_cap	1920x1080 1600x900
+
+# ---- Operation mode ----
+# Handheld renders at 720p for iPhone memory and thermal headroom
+op_mode	handheld
+
 # ---- Shader split (shader_split.py) ----
 shader_groups	/motor_asset_re/=rdb
 shader_note	Pokemon Pokopia shaders
+# Optional fast iOS shader build (--seen-shaders) using the playtest list in shader_seen.tsv
+ios_seen_shaders	1
diff --git a/dm/games/0400A3A01EE4C000/patches.py b/dm/games/0400A3A01EE4C000/patches.py
new file mode 100644
index 0000000..656ecf8
--- /dev/null
+++ b/dm/games/0400A3A01EE4C000/patches.py
@@ -0,0 +1,59 @@
+# Pokemon Pokopia (0400A3A01EE4C000): the rewriter's patches of this game's own builds. dm/tools/patch_nso.py loads every profile's patches.py and applies those of a module's
+# CUTS, OBS and FRAME_STEP as described there ("Registered patches"). Patches of Nintendo SDK module builds are in dm/tools/sdk_patches.py
+from nso_asm import ADRP, B
+
+# Render scale (DM_RENDER_SCALE, state +0x10; the launcher's Render scale). KTGL's dynamic resolution sizes the 3D views from a ladder of 31 sizes, 960x540 to 1920x1080 in steps
+# of 32x18 (widths at main+0x2849658, heights at main+0x28496e0, read by main+0x1129990 / main+0x11299d0; indices 31-33 are 2560, 3840, 7680 wide). Its controller
+# (main+0x22cd20, run every frame on the game's task threads) picks an index into [obj+0x88]: from the operation mode and the graphics scale tier (main+0x22d338: handheld
+# tier 0 starts at 20, 1600x900; docked 30, 1920x1080), stepped down and up by its load counters (+0x9c, +0xa0 against 1.25), which on this host never move (index 20 held
+# through a 2.5-minute iPhone run and Mac runs). At main+0x22cf68 it stores the index as the current one (+0x2a), and the views' sizes follow from that index (w0, the argument
+# of the size lookups after it). The stub there replaces w0 by the ladder step of the host's scale, a fraction of the 1920x1080 output: round((2 x scale - 1) x 30), so 0.5 is
+# 960x540, 0.75 1440x810, 0.9 1728x972, held to the game's own index, so the scale only lowers the size the operation mode picks (handheld: 0.85 and up stay 1600x900;
+# docked: the whole range). 1.0 (the default), unset or over runs the game's own index. Registers: x16, x17, q16, q17 saved; the flags are free (the next consumer, fcsel at
+# main+0x22cf90, follows the cmp at main+0x22cf80). The game steps by the time that passed (game.tsv, Frame rate), so the page holds settings only: no frame step (ctx.no_step)
+_index_store = 0x22cf68   # strb w0,[x19,#0x2a]
+
+def render_scale(ctx):
+    here, emit = ctx.here, ctx.emit
+    ctx.site(_index_store, '60aa0039')
+    s = here()
+    words = [
+        0xa9bd47f0,                       # stp x16,x17,[sp,#-0x30]!
+        0xad00c7f0,                       # stp q16,q17,[sp,#0x10]
+        None,                             # adrp x16, state page
+        0xb9401211,                       # ldr w17,[x16,#0x10]     the host scale's bits
+        0x34000231,                       # cbz w17,keep            unset
+        0x52a7f010,                       # mov w16,#0x3f800000     1.0
+        0x6b10023f,                       # cmp w17,w16
+        0x540001c2,                       # b.hs keep               1.0 or over: the game's own index
+        0x1e270230,                       # fmov s16,w17
+        0x1e302a10,                       # fadd s16,s16,s16        2 x scale
+        0x1e2e1011,                       # fmov s17,#1.0
+        0x1e313a10,                       # fsub s16,s16,s17        - 1
+        0x1e27d011,                       # fmov s17,#30.0
+        0x1e310a10,                       # fmul s16,s16,s17        x 30
+        0x1e200211,                       # fcvtns w17,s16          to the nearest step
+        0x528003d0,                       # mov w16,#30
+        0x6b10023f,                       # cmp w17,w16
+        0x1a903231,                       # csel w17,w17,w16,lo     at most 30 (1920x1080)
+        0x6b00023f,                       # cmp w17,w0
+        0x1a803231,                       # csel w17,w17,w0,lo      at most the game's own index: the scale only lowers the mode's size
+        0x2a1103e0,                       # mov w0,w17              the index the game stores and sizes from
+        0xad40c7f0,                       # keep: ldp q16,q17,[sp,#0x10]
+        0xa8c347f0,                       # ldp x16,x17,[sp],#0x30
+        0x3900aa60,                       # strb w0,[x19,#0x2a]     the original
+    ]
+    for k, w in enumerate(words): emit(ADRP(16, here(), ctx.state) if w is None else w)
+    emit(B(here(), _index_store + 4))
+    ctx.put(_index_store, [B(_index_store, s)], "dynamic resolution index: the step of the host render scale below 1.0 (else the game's own)")
+    ctx.render_scale = 1   # it only lowers the game's size: the loader holds DM_RENDER_SCALE to 1.0 and the launcher offers the row (patch_nso.py RENDER_SCALE)
+    ctx.no_step = True     # settings only: the host keeps its own pacing (display mode, the player's Frame rate)
+
+FRAME_STEP = {'76a489f3bd3642fa5e18bd83d32c98ba': render_scale}   # v655360 (2.0.1) main
+
+BINDING = [
+    {'what': 'render scale at the dynamic-resolution index store', 'now': 'build', 'goal': 'game', 'purpose': 'rendering',
+     'why': "KTGL's dynamic-resolution controller in the game's main; its function fingerprint (MATCH_FRAME_STEP) would carry it to later updates of this game, and possibly other KTGL "
+            'games on the same engine version, which nobody has compared yet',
+     'checked': 'v655360 main on the Mac: the controller runs every frame and holds index 20 (1600x900) handheld; DM_RENDER_SCALE runs (2026-11-15)'},
+]
diff --git a/dm/games/README.md b/dm/games/README.md
index 1892021..5ebf9c7 100644
--- a/dm/games/README.md
+++ b/dm/games/README.md
@@ -350,6 +350,7 @@ One row per profile; the notes are each profile's `README.md`. Entries marked pr
 | `device_api` | Optional override for the NVN API version `major.minor` that `nvnDeviceGetInteger` reports. For SDK 10 and older, the host reads the 53.x minor from a recognized device-info table, with 53.313 as the fallback. Later Switch 1 SDKs use 55.15. Switch 2 SDKs report 231.x. `DM_NVN_API` also overrides the reported version. This key does not affect the shader chain. |
 | `depth_mode` | `gl` (the default, NVN's near = −w) or `zero` (near = 0): the depth mode the game sets with `nvnDeviceSetDepthMode`, for the pipeline bases made before the game runs: the [pipeline archive made offline](../../docs/development.md#the-pipeline-archive-made-offline) for the iPhone (`main0` or `main0_z` vertex entries; built for a game with `pso_mtl4 on` or with `DM_PSO_GPUS`) and the NSP script's Mac prebuild (`DM_PSO_PREBUILD_DEPTH`). The host itself follows the mode the game sets; a wrong value only costs the device its own prebuild. The heap and address region checks of a provisional or derived profile set it when their boot reaches the game's call; without that call they leave it, as no call means unknown, not GL. Keep the key when the profile moves into `dm/games`: it is no shader input. Great Ace Attorney Chronicles, 13 Sentinels (both releases), Big Brain Academy, Link's Awakening, Engage, ASTRAL CHAIN, Luigi's Mansion 3, Octopath Traveler 0 and Kirby Air Riders set `zero` |
 | `render_base` | The 3D views' base size, docked then handheld (`1600x900 1280x720`): what `DM_RENDER_SCALE` scales. `settings.py` writes it into the render scale's row of `launcher.json` as `base`, so a front end can show the setting in pixels. Only for a game with a render scale stub, and only a size its note documents. The slider's top is the stub's largest scale, which the rewriter writes as `RENDER_SCALE` in the fixups table (1.0, or 3.0 for Hades II, whose stub also raises its 1280x720) |
+| `render_cap` | With `render_base`: the largest size the render-scale stub draws in each mode, docked then handheld (`1920x1080 1600x900`), for a stub that only lowers the size the mode picks from a larger base (Pokémon Pokopia's ladder). `settings.py` writes it into the row's `base` as `cap` |
 | `op_mode` | The operation mode the game sees at start: `console` (the default, docked) or `handheld`. Super Mario Galaxy and Captain Toad: Treasure Tracker use `handheld`: docked, their pointer is the Joy-Con gyro, which the host does not have; handheld, it is the touch screen, which the iPhone front end feeds with the touches no gamepad control takes (in the 3D layout, outside the right third of the screen, which is the right stick; `DmGamepad.m`). Handheld also renders at 720p. `DM_OPMODE=0` / `1` overrides, also from `Documents/env.txt` |
 | `perf_mode` | `follow` (the default): the performance mode follows the operation mode (Boost docked, Normal handheld); `boost`: Boost whatever the operation mode (`hle_oe.c`), a combination a Switch 1 never reports, so a profile choice. Rhythm Heaven Groove plays handheld with Boost: docked means a TV to the game, which then asks for a latency calibration, and only Boost gives its 1920x1080 draw size (handheld Normal draws 1280x720) |
 | `pad_layout` | The iPhone virtual gamepad's layout on first launch: `simple` (the default) = 2D (left stick, A/B/X/Y, shoulders, − / +), `full` = 3D (adds a D-pad, a right stick and L3 / R3; the right stick is not drawn: a touch landing in the right third of the screen on no control holds it, centred where it lands), `touch` = Tap (no control but the layout button: every touch goes to the game's touch screen; needs `op_mode handheld`, Balatro). The layout button at the top centre goes to the next layout in game (Tap only in handheld mode) and the app remembers the player's choice (`DmGamepad.m`) |
diff --git a/dm/games/settings.py b/dm/games/settings.py
index bd17f67..02d1ab3 100644
--- a/dm/games/settings.py
+++ b/dm/games/settings.py
@@ -34,12 +34,18 @@ def meta(text, n):
 
 def render_base(g):
     """The profile's render_base ("<w>x<h> <w>x<h>": the 3D views' base size docked, then handheld, which DM_RENDER_SCALE scales) as
-    {"docked": [w, h], "handheld": [w, h]}, for a front end to show the render scale in pixels; None when the profile has none"""
+    {"docked": [w, h], "handheld": [w, h]} (plus optional "cap" from render_cap), for a front end to show the render scale in pixels; None when the profile has none"""
     v = g.get('render_base', '')
     if not v: return None
     m = re.fullmatch(r'\s*(\d+)x(\d+)\s+(\d+)x(\d+)\s*', v)
     if not m: sys.exit(f'{g.id}: render_base is "<w>x<h> <w>x<h>" (docked, then handheld): {v}')
-    return {'docked': [int(m[1]), int(m[2])], 'handheld': [int(m[3]), int(m[4])]}
+    out = {'docked': [int(m[1]), int(m[2])], 'handheld': [int(m[3]), int(m[4])]}
+    c = g.get('render_cap', '')   # the largest size the stub draws in each mode, when it only lowers the size the mode picks from a larger base (Pokemon Pokopia)
+    if c:
+        k = re.fullmatch(r'\s*(\d+)x(\d+)\s+(\d+)x(\d+)\s*', c)
+        if not k: sys.exit(f'{g.id}: render_cap is "<w>x<h> <w>x<h>" (docked, then handheld): {c}')
+        out['cap'] = {'docked': [int(k[1]), int(k[2])], 'handheld': [int(k[3]), int(k[4])]}
+    return out
 
 
