From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dino0005 <167996504+Dino0005@users.noreply.github.com>
Date: Mon, 2 Nov 2026 19:13:24 +0100
Subject: [PATCH] ios shell: declare Italian in CFBundleLocalizations

Upstream-Status: fork-only
Reason: frontend/l10n/it.json adds Italian, and iOS offers a language to the shell's package bundles only when the app declares it, so Italian devices got English.
Issue: LNPANDY/NX2Apple#388
---
 dm/ios/project-shell.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dm/ios/project-shell.yml b/dm/ios/project-shell.yml
index 0f82937..7c413de 100644
--- a/dm/ios/project-shell.yml
+++ b/dm/ios/project-shell.yml
@@ -48,7 +48,7 @@ targets:
       path: Gen/Info.plist
       properties:
         CFBundleDisplayName: ${DM_SHELL_NAME}
-        CFBundleLocalizations: [en, de, fr, sv, zh-Hans]   # one per file of frontend/l10n (tools/l10n_shell_catalogs.py), iOS offers only the declared ones to the package bundles
+        CFBundleLocalizations: [en, de, fr, it, sv, zh-Hans]   # one per file of frontend/l10n (tools/l10n_shell_catalogs.py), iOS offers only the declared ones to the package bundles
         CFBundleVersion: $(CURRENT_PROJECT_VERSION)
         CFBundleShortVersionString: $(MARKETING_VERSION)
         UILaunchScreen: {}
