From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Atomsk <135618857+Atomsk-debug@users.noreply.github.com>
Date: Wed, 18 Nov 2026 23:24:41 +0100
Subject: [PATCH] ios: a game framework's copies are clones of the build's own
 outputs

DM_FRAMEWORK_ONLY copied the built framework's executable and the pipeline
archive into <work>/shell-framework with rsync. rsync writes a changed file
anew, so on APFS each was a second copy on disk, every time. Measured by
Atomsk on Super Mario Bros. Wonder 1.2.1 by comparing the files' physical
extents: the executable (76 MB) shared nothing with the build's output.

Both copies are now clones (cp -c: a plain copy on a file system without
clones), made under a temporary name and renamed, so a failed or interrupted
build keeps what was there. A file whose size and time, to the nanosecond,
are its source's is left alone, as rsync left it. The pipeline archive is
cloned whole and swapped in: the old folder is set aside until the new one is
published and comes back when the last rename fails.

The shader image no longer goes through this step (0052 strips msl/ from the
framework), so the original patch's image cases are gone.

test_framework_build.py checks the sharing for the executable and the
pipeline archive at a first build and at rebuilds (it skips on a file system
without clones), that an unchanged executable keeps its file, that a copy
works where cp -c cannot clone, and that a failed final rename keeps the old
executable and the old archive.

Upstream-Status: fork-only (fixes the fork-only game framework build, declined seedds/nxnative#492)
Reason: the game framework build (ios-game-framework, fork-only) clones its copies instead of rsyncing them, which upstream does not have
Issue: LNPANDY/NX2Apple#422
---
 dm/ios/tests/test_framework_build.py | 117 +++++++++++++++++++++++++++
 dm/ios/tools/build_ipa.sh            |  17 +++-
 2 files changed, 132 insertions(+), 2 deletions(-)

diff --git a/dm/ios/tests/test_framework_build.py b/dm/ios/tests/test_framework_build.py
index 6cde102..8c0640f 100644
--- a/dm/ios/tests/test_framework_build.py
+++ b/dm/ios/tests/test_framework_build.py
@@ -467,5 +467,122 @@ class FrameworkOnlyShaderLibrariesTests(unittest.TestCase):
         self.assertFalse(app_icon_file.exists())
 
 
+class FrameworkClonesTests(unittest.TestCase):
+    """The framework's executable and pipeline archive are clones of the build's own outputs (LNPANDY/NX2Apple#422), and a failed copy keeps what was there."""
+    FW = 'DmGame' + GAME
+    BIG = 'shader ' * 40000   # 280 KB: several blocks of file data
+
+    def setUp(self):
+        self.root = root = Path(tempfile.mkdtemp()).resolve()
+        self.addCleanup(shutil.rmtree, root)
+        (root / 'dm').mkdir()
+        (root / 'dm/tools').symlink_to(REPO / 'dm/tools', target_is_directory=True)
+        (root / 'bin').mkdir()
+        (root / 'bin/xcodebuild').write_text('#!/bin/sh\nexit 0\n')
+        (root / 'bin/xcodebuild').chmod(0o755)
+        self.built = root / 'dd/Build/Products/Release-iphoneos' / f'{self.FW}.framework'
+        self.built.mkdir(parents=True)
+        (self.built / self.FW).write_text(self.BIG)
+        (self.built / 'game.manifest.json').write_text(json.dumps({'framework_executable': self.FW}))
+        (root / 'shaders/b-fixture').mkdir(parents=True)
+        (root / 'shaders/b-fixture/fixture_b.metallib').write_text('shader')
+        self.pso = root / 'pso-src'
+        (self.pso / 'applegpu_g18p').mkdir(parents=True)
+        (self.pso / 'applegpu_g18p/archive.metallib').write_text(self.BIG.replace('shader', 'pipeln'))
+        self.out = root / 'out' / f'{self.FW}.framework'
+
+    def build(self, expect=0, **extra):
+        root = self.root
+        result = run_step(FRAMEWORK_ONLY, root, FRAMEWORK_ONLY=str(root / 'out'), FW_NAME=self.FW, O=str(root / 'pkg'), DD=str(root / 'dd'),
+                          DM_BUNDLE_ID='org.nxnative.fixture', MSL_IOS=str(root / 'shaders'), MSLDIR='b-fixture', PSO=str(self.pso),
+                          ICON=str(root / 'no-icon.jpg'), PATH=f'{root / "bin"}:{os.environ["PATH"]}', **extra)
+        if expect == 0: self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        else: self.assertNotEqual(result.returncode, 0, 'the build should fail')
+        return result
+
+    def failing_rename(self, suffix):
+        """A mv that fails where it would put a finished copy in its place (the source ends in `suffix`), and is mv everywhere else."""
+        mv = self.root / 'bin/mv'
+        mv.write_text(f'#!/bin/sh\nfor a in "$@"; do case "$a" in *{suffix}) exit 1;; esac; done\nexec /bin/mv "$@"\n')
+        mv.chmod(0o755)
+
+    @staticmethod
+    def extents(path):
+        """The device offset of each run of the file's data (fcntl F_LOG2PHYS_EXT): two files that share their blocks, as a clone and its source do, have the same list."""
+        import fcntl, struct
+        runs, size, at = [], os.path.getsize(path), 0
+        with open(path, 'rb') as f:
+            while at < size:
+                _, length, device = struct.unpack('=Iqq', fcntl.fcntl(f.fileno(), 65, struct.pack('=Iqq', 0, size - at, at)))
+                if length <= 0: break
+                runs.append((at, length, device)); at += length
+        return runs
+
+    def assertShared(self, copy, source):
+        self.assertEqual(Path(copy).read_bytes(), Path(source).read_bytes())
+        self.assertEqual(self.extents(copy), self.extents(source), f'{copy} is a second copy of {source} on disk, not a clone')
+
+    def needs_clones(self):
+        """Skips where the temporary folder's file system has no clones, or does not say where a file's blocks are."""
+        a, b = self.root / 'probe', self.root / 'probe.clone'
+        a.write_text(self.BIG)
+        try:
+            subprocess.run(['cp', '-c', str(a), str(b)], check=True, capture_output=True)
+            shared = self.extents(a) == self.extents(b) != []
+        except (OSError, subprocess.CalledProcessError): shared = False
+        a.unlink(); b.unlink(missing_ok=True)
+        if not shared: self.skipTest('the temporary folder is not on a file system with clones (APFS)')
+
+    def test_the_executable_and_the_pipeline_archive_are_clones_after_every_build(self):
+        self.needs_clones()
+        for rebuilt in ('dylib2', 'dylib3'):   # a first build, then rebuilds over it
+            self.build()
+            self.assertShared(self.out / self.FW, self.built / self.FW)
+            self.assertShared(self.out / 'pso/applegpu_g18p/archive.metallib', self.pso / 'applegpu_g18p/archive.metallib')
+            self.assertEqual(sorted(p.name for p in self.out.iterdir() if p.name.endswith(('.part', '.old'))), [])
+            (self.built / self.FW).write_text(self.BIG.replace('shader', rebuilt))
+            (self.pso / 'applegpu_g18p/archive.metallib').write_text(self.BIG.replace('shader', rebuilt))
+
+    def test_what_the_archive_no_longer_has_is_gone(self):
+        self.build()
+        (self.pso / 'applegpu_g18p/archive.metallib').rename(self.pso / 'applegpu_g18p/other.metallib')
+        self.build()
+        self.assertEqual(sorted(p.name for p in (self.out / 'pso/applegpu_g18p').iterdir()), ['other.metallib'])
+
+    def test_an_unchanged_executable_keeps_its_file(self):
+        self.build()
+        before = (self.out / self.FW).stat()
+        self.build()
+        after = (self.out / self.FW).stat()
+        self.assertEqual((before.st_ino, before.st_mtime_ns), (after.st_ino, after.st_mtime_ns))
+
+    def test_a_copy_works_without_clones(self):
+        """cp -c falls back to a plain copy where the volume cannot clone, so the output is the same bytes: the fake cp refuses -c as such a volume does."""
+        cp = self.root / 'bin/cp'
+        cp.write_text('#!/bin/sh\nn=$#; i=0\nwhile [ $i -lt $n ]; do a=$1; shift; case $a in -cRp) a=-Rp;; -cp) a=-p;; esac; set -- "$@" "$a"; i=$((i+1)); done\nexec /bin/cp "$@"\n')
+        cp.chmod(0o755)
+        self.build()
+        self.assertEqual((self.out / self.FW).read_bytes(), (self.built / self.FW).read_bytes())
+        self.assertEqual((self.out / 'pso/applegpu_g18p/archive.metallib').read_bytes(), (self.pso / 'applegpu_g18p/archive.metallib').read_bytes())
+
+    def test_a_failed_final_rename_keeps_the_old_pipeline_archive(self):
+        self.build()
+        (self.pso / 'applegpu_g18p/archive.metallib').write_text('a newer archive')
+        self.failing_rename('pso.part')
+        result = self.build(expect=1)
+        self.assertIn('copy the pipeline archive', result.stdout + result.stderr)
+        self.assertEqual((self.out / 'pso/applegpu_g18p/archive.metallib').read_text(), self.BIG.replace('shader', 'pipeln'))
+        self.assertEqual(sorted(p.name for p in self.out.iterdir() if p.name.endswith(('.part', '.old'))), [])
+
+    def test_a_failed_final_rename_keeps_the_old_executable(self):
+        self.build()
+        (self.built / self.FW).write_text('a newer executable')
+        self.failing_rename(f'{self.FW}.part')
+        result = self.build(expect=1)
+        self.assertIn("copy the framework's executable", result.stdout + result.stderr)
+        self.assertEqual((self.out / self.FW).read_text(), self.BIG)
+        self.assertEqual(sorted(p.name for p in self.out.iterdir() if p.name.endswith(('.part', '.old'))), [])
+
+
 if __name__ == '__main__':
     unittest.main()
diff --git a/dm/ios/tools/build_ipa.sh b/dm/ios/tools/build_ipa.sh
index 2dde42a..0018b90 100755
--- a/dm/ios/tools/build_ipa.sh
+++ b/dm/ios/tools/build_ipa.sh
@@ -352,7 +352,19 @@ fi
 # game's per-game resources into it, so one folder is one game: the pipeline archive (pso/, DM_PSO_BUNDLE) and the icon the shell's library shows.
 # The shader libraries are stripped from the framework (msl/ removed); their source metadata is recorded under .msl-cache/<id>.json.
 # The game files and add-on content stay out (data, Documents/games/<id>/)
+# Every copy into the framework is a clone of the build's own output (cp -c: on APFS the two share their blocks, on a file system without clones it is a plain copy), made under a temporary name
+# and renamed, so a failed or interrupted build leaves what was there. rsync writes a changed file anew: the executable and the pipeline archive were each a second copy on disk (LNPANDY/NX2Apple#422).
+# A file whose size and time, to the nanosecond, are its source's is left alone, as rsync left it
 if [ -n "$FRAMEWORK_ONLY" ]; then
+  same_file() { [ -f "$2" ] && [ ! -L "$2" ] && [ "$(stat -f '%z %Fm' "$1")" = "$(stat -f '%z %Fm' "$2")" ]; }   # cp -p keeps the time to the nanosecond: a rebuild in the same second is seen
+  clone_file() { same_file "$1" "$2" || { rm -rf -- "$2.part" && cp -cp -- "$1" "$2.part" && { [ ! -d "$2" ] || rm -rf -- "$2"; } && mv -f -- "$2.part" "$2"; } || { rm -rf -- "$2.part"; return 1; }; }
+  # A folder, whole (every file a clone). The old one is set aside until the new one is in place, and comes back when the last rename fails
+  clone_tree() {
+    rm -rf -- "$2.part" "$2.old"
+    cp -cRp -- "$1" "$2.part" || { rm -rf -- "$2.part"; return 1; }
+    if [ -e "$2" ] || [ -L "$2" ]; then mv -- "$2" "$2.old" || { rm -rf -- "$2.part"; return 1; }; fi
+    if mv -- "$2.part" "$2"; then rm -rf -- "$2.old"; else rm -rf -- "$2.part"; [ ! -e "$2.old" ] || mv -- "$2.old" "$2"; return 1; fi
+  }
   t "xcodebuild (Release, unsigned, the game framework $FW_NAME with its own host)"
   mkdir -p "$O" "$FRAMEWORK_ONLY" || die "mkdir $FRAMEWORK_ONLY"
   xcodebuild -project DmIOS.xcodeproj -target DmShellGame -configuration Release -sdk iphoneos \
@@ -364,7 +376,8 @@ if [ -n "$FRAMEWORK_ONLY" ]; then
   [ -f "$BUILT/$FW_NAME" ] || die "no built framework $BUILT"
   OUTFW=$FRAMEWORK_ONLY/$FW_NAME.framework; mkdir -p "$OUTFW"
   t "copying resources into $FW_NAME.framework"
-  rsync -a --delete --exclude /msl --exclude /pso --exclude /icon.png --exclude /AppIcon.png -- "$BUILT/" "$OUTFW/" || die "copy the framework to $OUTFW"
+  rsync -a --delete --exclude /msl --exclude /pso --exclude /icon.png --exclude /AppIcon.png --exclude "/$FW_NAME" -- "$BUILT/" "$OUTFW/" || die "copy the framework to $OUTFW"
+  clone_file "$BUILT/$FW_NAME" "$OUTFW/$FW_NAME" || die "copy the framework's executable to $OUTFW"
   rm -rf "$OUTFW/msl"
   LIB=$(lib_path "$MSL_IOS/$MSLDIR") || die "shader libraries $MSL_IOS/$MSLDIR"
   PROG_DATA=
@@ -446,7 +459,7 @@ with os.fdopen(tmp_fd, 'w', encoding='utf-8') as f:
 target_json = os.path.join(cache_dir, f'{game}.json')
 os.replace(tmp_file, target_json)
 EOF
-  if [ -n "$PSO" ]; then mkdir -p "$OUTFW/pso" && rsync -a --delete -- "$PSO/" "$OUTFW/pso/" || die "copy the pipeline archive"; else rm -rf "$OUTFW/pso"; fi
+  if [ -n "$PSO" ]; then clone_tree "$PSO" "$OUTFW/pso" || die "copy the pipeline archive"; else rm -rf "$OUTFW/pso" "$OUTFW/pso.part" "$OUTFW/pso.old"; fi
   if [ -f "$ICON" ]; then
     sips -s format png -z 512 512 "$ICON" --out "$OUTFW/icon.png" > /dev/null || die "sips: cannot convert the icon $ICON"
     cp -f "$OUTFW/icon.png" "$OUTFW/AppIcon.png" || die "cp: cannot write $OUTFW/AppIcon.png"
