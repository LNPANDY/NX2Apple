+static NSString *edit_group_title(int k, BOOL full) { char t[64]; dm_pad_group_title(k, full, edit_text_env(), t, sizeof t); return @(t); }
+static UIColor *edit_cream(void) { return [UIColor colorWithRed:0.98 green:0.93 blue:0.80 alpha:1]; }
+static UIColor *edit_red(void) { return [UIColor colorWithRed:1 green:0.36 blue:0.30 alpha:1]; }
+static BOOL edit_parse(NSString *v, DmPadGroups *out) { return v && dm_pad_groups_parse(v.UTF8String, out); }   // nil, or a value the engine does not read: NO
