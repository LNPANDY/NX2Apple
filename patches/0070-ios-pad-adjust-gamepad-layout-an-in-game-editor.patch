+        if (s.reset) s.reset();
+    }] forControlEvents:UIControlEventTouchUpInside];
+    [_cancelButton addAction:[UIAction actionWithHandler:^(UIAction *a) { (void)a; DmPadEditPanel *s = weak; if (s.finish) s.finish(NO); }] forControlEvents:UIControlEventTouchUpInside];
+    [_doneButton addAction:[UIAction actionWithHandler:^(UIAction *a) { (void)a; DmPadEditPanel *s = weak; if (s.finish) s.finish(YES); }] forControlEvents:UIControlEventTouchUpInside];
+
+    // The flash line keeps its height when it shows nothing (a space, see-through), so a message never squeezes the rows of a card sized without it.
+    _flashLabel = panel_label(12, UIFontWeightSemibold, 1); _flashLabel.textColor = [UIColor colorWithRed:1 green:0.62 blue:0.45 alpha:1];
+    _flashLabel.textAlignment = NSTextAlignmentCenter; _flashLabel.text = @" "; _flashLabel.alpha = 0;
