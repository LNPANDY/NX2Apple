+
+// ---- Touches ----
+// A touch on the card that no control of it takes (its title and labels, the rows' gaps, the blur) would go on up to the gamepad, whose touches edit the
+// layout under the card: it stops here. The controls and the title's drag take their own.
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { (void)touches; (void)event; }
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { (void)touches; (void)event; }
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { (void)touches; (void)event; }
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { (void)touches; (void)event; }
+
+// ---- What the player asks for ----
+- (void)groupSlid:(UISlider *)s { if (_hasGroup && self.groupSize) self.groupSize((int)lroundf(s.value)); }
+- (void)allSlid:(UISlider *)s { if (self.allSize) self.allSize((int)lroundf(s.value)); }
+- (void)sliderDown:(UISlider *)s { (void)s; [self beginGesture]; }
+// While a finger holds a slider its thumb follows the finger, past what fits too (the value beside it says what the group got); when it lifts, the
+// thumb goes to that.
+- (void)groupSliderUp:(UISlider *)s { s.value = _groupNow; }
+- (void)allSliderUp:(UISlider *)s { s.value = _allNow; }
+- (void)stepGroup:(int)d { [self beginGesture]; if (_hasGroup && self.groupSize) self.groupSize(_groupNow + d); }
+- (void)stepAll:(int)d { [self beginGesture]; if (self.allSize) self.allSize(_allNow + d); }
+- (void)mirrorPicked:(UISegmentedControl *)c { if (self.mirror) self.mirror(c.selectedSegmentIndex == 0); }   // a tap, or the self-test's tapMirrorSegment:
+- (BOOL)tapMirrorSegment:(int)segment {
+    if (!_mirrorControl.enabled || segment < 0 || segment >= (int)_mirrorControl.numberOfSegments) return NO;
+    _mirrorControl.selectedSegmentIndex = segment;
+    [_mirrorControl sendActionsForControlEvents:UIControlEventValueChanged];
+    return YES;
+}
+- (void)scopePicked:(UISegmentedControl *)c { if (self.scope) self.scope((int)c.selectedSegmentIndex); }
+- (void)dragged:(UIPanGestureRecognizer *)r {
+    UIView *parent = self.superview; if (!parent) return;
+    CGPoint t = [r translationInView:parent];
+    self.center = CGPointMake(self.center.x + t.x, self.center.y + t.y);
+    [r setTranslation:CGPointZero inView:parent];
+    [self keepIn:parent.bounds];
+}
+
+// ---- What the gamepad shows back ----
+- (void)showGroup:(NSString *)name size:(int)percent min:(int)min max:(int)max {
+    _hasGroup = name != nil;
+    _groupNow = percent;
+    _groupName.text = name ?: _chooseText;
+    _groupName.numberOfLines = name ? 1 : 2;
+    for (UIView *v in @[_groupMinus, _groupSlider, _groupPlus, _groupValue]) { v.alpha = name ? 1 : 0.35; v.userInteractionEnabled = name != nil; }
+    _groupMinus.enabled = _groupPlus.enabled = _groupSlider.enabled = name != nil;
+    _groupSlider.minimumValue = min; _groupSlider.maximumValue = max;
+    if (!_groupSlider.tracking) _groupSlider.value = percent;   // not under the finger (groupSliderUp: puts it there when it lifts)
+    _groupValue.text = name ? [NSString stringWithFormat:@"%d %%", percent] : @"";
+    _groupSlider.accessibilityLabel = name ?: _chooseText;
+    _groupSlider.accessibilityValue = [NSString stringWithFormat:@"%d %%", percent];
+    _groupMinus.accessibilityLabel = name ? [NSString stringWithFormat:@"%@, %@", name, _smallerText] : _smallerText;
+    _groupPlus.accessibilityLabel = name ? [NSString stringWithFormat:@"%@, %@", name, _largerText] : _largerText;
+}
+- (void)showAll:(int)percent min:(int)min {
+    _allNow = percent;
+    _allSlider.minimumValue = min;
+    if (!_allSlider.tracking) _allSlider.value = percent;
+    _allValue.text = [NSString stringWithFormat:@"%d %%", percent];
+    _allSlider.accessibilityValue = _allValue.text;
+}
+- (void)showMirror:(BOOL)on applies:(BOOL)applies {
+    NSInteger segment = on ? 0 : 1;
+    if (_mirrorControl.selectedSegmentIndex != segment) _mirrorControl.selectedSegmentIndex = segment;   // set in code: no action is sent
+    _mirrorControl.enabled = applies; _mirrorControl.alpha = applies ? 1 : 0.35;   // dimmed as the group's row is without a group
+    _mirrorRow.isAccessibilityElement = !applies;   // dimmed: one element, "Move left and right groups, Both sides together, dimmed", and why (its hint)
+    _mirrorRow.accessibilityValue = [_mirrorControl titleForSegmentAtIndex:(NSUInteger)segment];
+}
+- (int)mirrorSegment { return (int)_mirrorControl.selectedSegmentIndex; }
+- (BOOL)mirrorApplies { return _mirrorControl.enabled; }
+- (void)setMirrorFont:(CGFloat)size {   // the same font selected or not, so a segment keeps its width when it is picked
+    _mirrorFont = size;
+    NSDictionary<NSAttributedStringKey, id> *a = @{NSFontAttributeName: [UIFont systemFontOfSize:size weight:UIFontWeightMedium]};
+    [_mirrorControl setTitleTextAttributes:a forState:UIControlStateNormal];
+    [_mirrorControl setTitleTextAttributes:a forState:UIControlStateSelected];
+}
+// The choice's titles at the largest of 13, 12, 11 and 10 points at which the control, as UIKit sizes it, fits the row (width). Estimated with a stand-in
+// for the system font: 13 in every language on an iPad's card and on an iPhone held upright (a 323-point row), 10 to 13 in a 320-point window. A
+// fixed size, not the player's text size, so the row stays one line; what does not fit at 10 points UIKit shortens with an ellipsis.
+- (void)fitMirrorTo:(CGFloat)width {
+    for (CGFloat size = 13; size >= 10; size -= 1) {
+        if (_mirrorFont != size) [self setMirrorFont:size];
+        if (_mirrorControl.intrinsicContentSize.width <= width) return;
+    }
+}
+- (void)showScope:(int)scope {
+    _scopeControl.selectedSegmentIndex = scope ? 1 : 0;
+    BOOL ask = _scopes && scope && _resetMenu;   // this game: Reset to default asks which default
+    if (ask) { _resetButton.menu = _resetMenu; _resetButton.showsMenuAsPrimaryAction = YES; }
+    else { _resetButton.showsMenuAsPrimaryAction = NO; _resetButton.menu = nil; }
+}
+- (void)beginGesture { [_flashed removeAllObjects]; }
+- (BOOL)flash:(NSString *)message {
+    if ([_flashed containsObject:message]) return NO;
+    [_flashed addObject:message];
+    unsigned gen = ++_flashGen;
+    _flashLabel.text = message; _flashLabel.alpha = 1;
+    UIAccessibilityPostNotification(UIAccessibilityAnnouncementNotification, message);
+    __weak DmPadEditPanel *weak = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        DmPadEditPanel *s = weak;
+        if (!s || s->_flashGen != gen) return;
+        UILabel *label = s->_flashLabel;
+        [UIView animateWithDuration:0.25 animations:^{ label.alpha = 0; }];
+    });
+    return YES;
+}
+
+// ---- Where it sits ----
+- (CGSize)fittingSizeForWidth:(CGFloat)width {
+    return [self systemLayoutSizeFittingSize:CGSizeMake(width, 0) withHorizontalFittingPriority:UILayoutPriorityRequired
+                       verticalFittingPriority:UILayoutPriorityFittingSizeLevel];
+}
+- (void)placeIn:(CGRect)bounds avoiding:(NSArray<NSValue *> *)rects {
+    CGFloat w = fmin(400, bounds.size.width - 24);
+    _hint.hidden = bounds.size.height < 520;   // a phone held sideways: the card keeps to its rows
+    [self fitMirrorTo:w - 28];   // the rows' width: the card less the stack's insets
+    CGSize size = [self fittingSizeForWidth:w];
+    size.height = fmin(size.height, bounds.size.height - 16);
+    CGFloat best = CGFLOAT_MAX; CGPoint at = CGPointMake(CGRectGetMidX(bounds), CGRectGetMidY(bounds));
+    for (int i = 0; i < 5; i++) {   // the middle, then a little higher or lower, then near the top or the bottom
+        static const CGFloat f[5] = {0.5, 0.38, 0.62, 0.25, 0.75};
+        CGPoint c = CGPointMake(CGRectGetMidX(bounds), CGRectGetMinY(bounds) + bounds.size.height * f[i]);
+        CGRect r = CGRectMake(c.x - size.width / 2, c.y - size.height / 2, size.width, size.height);
+        CGFloat cover = 0;
+        for (NSValue *v in rects) { CGRect x = CGRectIntersection(r, v.CGRectValue); if (!CGRectIsNull(x)) cover += x.size.width * x.size.height; }
+        if (cover < best - 1) { best = cover; at = c; }
+    }
+    self.bounds = CGRectMake(0, 0, size.width, size.height);
+    self.center = at;
+    [self keepIn:bounds];
+}
+- (void)keepIn:(CGRect)bounds {   // each axis inside bounds (8 points in), or centred on it where the card is larger
+    CGRect f = self.frame, b = CGRectInset(bounds, 8, 8);
+    f.origin.x = f.size.width > b.size.width ? CGRectGetMidX(b) - f.size.width / 2 : fmin(fmax(f.origin.x, CGRectGetMinX(b)), CGRectGetMaxX(b) - f.size.width);
+    f.origin.y = f.size.height > b.size.height ? CGRectGetMidY(b) - f.size.height / 2 : fmin(fmax(f.origin.y, CGRectGetMinY(b)), CGRectGetMaxY(b) - f.size.height);
+    self.frame = f;
+}
+@end
