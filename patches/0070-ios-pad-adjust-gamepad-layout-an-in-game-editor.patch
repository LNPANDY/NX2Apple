+- (void)testLayoutEditorPinchGrowsTheStickAndItsTravel {
+    [self resetLayoutEditorStore];
+    CGRect bounds = CGRectMake(0, 0, 1210, 834);
+    DmLayout layout = dm_layout(bounds, UIEdgeInsetsZero, NO, CGRectNull, DM_PICTURE_16_9);
+    UIView *pad = [self padForLayout:layout bounds:bounds];
+    dm_pad_layout_set(0);
+    [pad layoutIfNeeded];
+    CGRect ring = [self largestShapePathBoundsInLayer:pad.layer];
+    CGPoint c = CGPointMake(CGRectGetMidX(ring), CGRectGetMidY(ring));
+    CGFloat r = ring.size.width / 2;
+    [pad beginEditing];
+    [pad editPinchBegin:c];
+    [pad editPinchScale:1.25];
+    [pad editPinchScale:1.5];
+    [pad editPinchEnd];
+    [pad finishEditing:YES];
+    [pad layoutIfNeeded];
+    CGRect grown = [self largestShapePathBoundsInLayer:pad.layer];
+    XCTAssertEqualWithAccuracy(grown.size.width / 2, 1.5 * r, 1, @"the ring at 150 %%");
+    CGPoint c2 = CGPointMake(CGRectGetMidX(grown), CGRectGetMidY(grown));
+    DuoFakeTouch *stick = [self touchAt:c2 time:1];
+    [self beginTouches:@[stick] onPad:pad];
+    [self moveTouch:stick to:CGPointMake(c2.x + 0.8 * r, c2.y) onPad:pad];
+    XCTAssertLessThan(duo_harness_input().lx, 32767, @"the old full-tilt distance is no longer full tilt");
+    [self moveTouch:stick to:CGPointMake(c2.x + 0.8 * 1.5 * r + 1, c2.y) onPad:pad];
+    XCTAssertEqual(duo_harness_input().lx, 32767, @"the new one is");
+    [self endTouches:@[stick] onPad:pad cancelled:NO];
+    [self resetLayoutEditorStore];
+}
