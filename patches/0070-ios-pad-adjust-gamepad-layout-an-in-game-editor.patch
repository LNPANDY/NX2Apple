+- (void)editPinchScale:(CGFloat)scale { if (_pinchGroup >= 0) [self editGroupSize:(int)lround(_pinchFrom * scale) quiet:NO]; }
+- (void)editPinchEnd { _pinchGroup = -1; dm_pad_pinch_off(&_fingers); }
+// The chosen group's size asked for (the slider, − and +, a pinch, VoiceOver): the size it got. Its mirror image goes along as far as it has room
+// (DmPadEditing.h's dm_pad_try_size_mated), and the panel says so when it stops while the chosen group grows on (not when that comes back down).
+- (int)editGroupSize:(int)percent quiet:(BOOL)quiet {
+    int k = _editGroup;
+    if (k < 0 || !_editing) return 0;
+    DmPadScene sc = [self editScene];
+    int want = dm_pad_clampi(percent, dm_pad_size_min(&sc, &_draft, k), DM_PAD_SIZE_MAX), mate = 0, before = dm_pad_place_now(&sc, &_draft, k).size;
