+        BOOL show = !CGRectIsNull(b);
+        _outline[k].hidden = !show; _outlineTag[k].hidden = !show;
+        if (!show) continue;
+        BOOL chosen = k == _editGroup, follows = k == mate, refused = _editRefused && (chosen || follows);
+        CGRect r = CGRectInset(b, -6, -6);
+        CGPathRef path = CGPathCreateWithRoundedRect(r, 12, 12, NULL);
