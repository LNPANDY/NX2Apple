+        _outline[k].fillColor = (refused ? [edit_red() colorWithAlphaComponent:0.14] : chosen ? [edit_cream() colorWithAlphaComponent:0.10] : UIColor.clearColor).CGColor;
+        _outline[k].lineWidth = chosen ? 3 : 1.5;
+        _outline[k].lineDashPattern = chosen ? nil : @[@6, @4];
+        UILabel *tag = _outlineTag[k];
+        tag.text = edit_group_title(k, _full);
+        tag.textColor = chosen ? UIColor.blackColor : UIColor.whiteColor;
+        tag.backgroundColor = refused ? edit_red() : chosen ? edit_cream() : [UIColor colorWithWhite:0 alpha:0.6];
+        CGSize ts = [tag sizeThatFits:CGSizeMake(300, 40)];
+        CGFloat w = ceil(ts.width) + 14, h = ceil(ts.height) + 6;
+        CGFloat y = CGRectGetMinY(r) - h - 4 >= CGRectGetMinY(self.bounds) + 2 ? CGRectGetMinY(r) - h - 4 : CGRectGetMaxY(r) + 4;
+        if (y + h > CGRectGetMaxY(self.bounds) - 2) y = CGRectGetMinY(r) + 4;   // no room above or below: inside the outline's top
+        CGFloat x = fmin(fmax(CGRectGetMidX(r) - w / 2, CGRectGetMinX(self.bounds) + 2), CGRectGetMaxX(self.bounds) - w - 2);
+        tag.frame = CGRectMake(x, y, w, h); tag.layer.cornerRadius = h / 2;
+        if (elements) {
+            DmPadGroupElement *el = [self editElement:k];
+            el.accessibilityLabel = tag.text;
+            el.accessibilityValue = [NSString stringWithFormat:@"%d %%", dm_pad_place_now(&sc, &_draft, k).size];
+            el.accessibilityTraits = UIAccessibilityTraitAdjustable | (chosen ? UIAccessibilityTraitSelected : 0);
+            el.accessibilityFrameInContainerSpace = r;
+            [elements addObject:el];
+        }
+    }
+    [CATransaction commit];
+    if (elements) {
+        if (_panel) [elements addObject:_panel];
+        if (![self.accessibilityElements isEqualToArray:elements]) self.accessibilityElements = elements;   // the same elements: VoiceOver keeps its focus
+    }
+    if (!CGSizeEqualToSize(_panelFor, self.bounds.size)) {   // a rotation or another window size: the panel fits the new bounds, Done and Cancel in reach
+        _panelFor = self.bounds.size;
+        [_panel placeIn:self.bounds avoiding:[self editGroupRects]];
+    } else [_panel keepIn:self.bounds];
+}
