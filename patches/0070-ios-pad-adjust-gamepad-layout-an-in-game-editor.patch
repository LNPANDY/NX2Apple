+        [[UIAccessibilityCustomAction alloc] initWithName:edit_text(DM_PAD_TEXT_LEFT) actionHandler:^BOOL(UIAccessibilityCustomAction *a) { (void)a; [weak editMoveGroup:group by:CGPointMake(-d, 0)]; return YES; }],
+        [[UIAccessibilityCustomAction alloc] initWithName:edit_text(DM_PAD_TEXT_RIGHT) actionHandler:^BOOL(UIAccessibilityCustomAction *a) { (void)a; [weak editMoveGroup:group by:CGPointMake(d, 0)]; return YES; }],
