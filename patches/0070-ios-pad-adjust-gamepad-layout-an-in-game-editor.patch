+// The panel's two-way choice above the chosen group's row (Both sides together | Each side on its own), found by its English titles.
+- (UISegmentedControl *)mirrorChoiceInPad:(UIView *)pad {
+    NSMutableArray<UIView *> *todo = [NSMutableArray array];
+    for (UIView *v in pad.subviews) if ([NSStringFromClass(v.class) containsString:@"EditPanel"]) [todo addObject:v];
+    while (todo.count) {
+        UIView *v = todo.lastObject; [todo removeLastObject];
+        if ([v isKindOfClass:UISegmentedControl.class] && [[(UISegmentedControl *)v titleForSegmentAtIndex:0] isEqualToString:@"Both sides together"]) return (UISegmentedControl *)v;
+        [todo addObjectsFromArray:v.subviews];
+    }
+    XCTFail(@"Expected the panel's Both sides together | Each side on its own");
+    return nil;
+}
