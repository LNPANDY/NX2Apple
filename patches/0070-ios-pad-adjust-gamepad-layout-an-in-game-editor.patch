+@property (nonatomic, copy, nullable) void (^groupSize)(int percent);   // the chosen group's size asked for (the slider, − and +)
+@property (nonatomic, copy, nullable) void (^allSize)(int percent);     // all controls' size asked for
+@property (nonatomic, copy, nullable) void (^mirror)(BOOL on);          // Both sides together (YES) or Each side on its own (NO) picked
+@property (nonatomic, copy, nullable) void (^scope)(int scope);         // 0 all games, 1 this game
+@property (nonatomic, copy, nullable) void (^reset)(void);              // Reset to default (for this game: › Built-in layout)
+@property (nonatomic, copy, nullable) void (^follow)(void);             // Reset to default › Same as All games (this game, in the shell)
+@property (nonatomic, copy, nullable) void (^finish)(BOOL save);        // Done (YES) or Cancel (NO)
+// The chosen group (nil: none, the row asks for a tap on one), its size and the sizes it may take, in percent.
+- (void)showGroup:(nullable NSString *)name size:(int)percent min:(int)min max:(int)max;
+- (void)showAll:(int)percent min:(int)min;   // all controls' size, and the smallest that keeps every touch target 44 points across
+// Both sides together (on) or Each side on its own, for the layout on screen. applies: the chosen group has a mirror image there, or none is chosen
+// (DmPadEditing.h's dm_pad_mirror_applies); otherwise the choice is dimmed, still showing the layout's, and VoiceOver says why.
+- (void)showMirror:(BOOL)on applies:(BOOL)applies;
