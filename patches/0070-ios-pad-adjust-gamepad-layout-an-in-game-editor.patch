+    DmPadGroups out;
+    int got = dm_pad_try_size_mated(&sc, &_draft, k, want, &out, &mate);
+    _draft = out;
+    if (!quiet && got != want) [self editWarn:edit_text(DM_PAD_TEXT_NO_ROOM)];
+    else if (!quiet && linked && got > before && mate < got) [self editWarn:[NSString stringWithFormat:@"%@: %@", edit_group_title(dm_pad_group_mirror(k), _full), edit_text(DM_PAD_TEXT_MATE_FULL)]];
+    [self editChanged];
+    return got;
+}
+- (int)editAllSize:(int)percent {   // from the size that keeps every touch target 44 points across (dm_pad_all_min) up
+    if (!_editing) return 0;
+    DmPadScene sc = [self editScene];
+    int want = dm_pad_clampi(percent, dm_pad_all_min(&sc, &_draft), DM_PAD_ALL_MAX);
