+    _allValue = panel_label(13, UIFontWeightMedium, 0.9); _allValue.font = _groupValue.font;
+    _allValue.textAlignment = NSTextAlignmentRight; _allValue.isAccessibilityElement = NO;
+    [_allMinus addAction:[UIAction actionWithHandler:^(UIAction *a) { (void)a; [weak stepAll:-5]; }] forControlEvents:UIControlEventTouchUpInside];
+    [_allPlus addAction:[UIAction actionWithHandler:^(UIAction *a) { (void)a; [weak stepAll:5]; }] forControlEvents:UIControlEventTouchUpInside];
+
+    // Both sides together | Each side on its own, the row above the chosen group's: the longer title takes the wider segment, and the titles take the
+    // largest size that fits the card (fitMirrorTo:, from placeIn:). VoiceOver: the control's name, then each segment, the selected one said so
+    // (UIKit's own); while it is dimmed the row is one element that names what is picked and says why (showMirror:applies:).
+    _mirrorControl = [[UISegmentedControl alloc] initWithItems:@[panel_text(env, DM_PAD_TEXT_TOGETHER), panel_text(env, DM_PAD_TEXT_ON_ITS_OWN)]];
+    _mirrorControl.apportionsSegmentWidthsByContent = YES;
+    _mirrorControl.selectedSegmentIndex = 0;
+    _mirrorControl.accessibilityLabel = panel_text(env, DM_PAD_TEXT_MIRROR);
+    _mirrorControl.accessibilityContainerType = UIAccessibilityContainerTypeSemanticGroup;   // the name is said on the way into the two segments
+    [_mirrorControl addTarget:self action:@selector(mirrorPicked:) forControlEvents:UIControlEventValueChanged];
+    [self setMirrorFont:13];
+
+    _scopeLabel = panel_label(13, UIFontWeightRegular, 0.9); _scopeLabel.text = panel_text(env, DM_PAD_TEXT_SAVE_FOR);
+    _scopeControl = [[UISegmentedControl alloc] initWithItems:@[panel_text(env, DM_PAD_TEXT_ALL_GAMES), panel_text(env, DM_PAD_TEXT_THIS_GAME)]];
+    _scopeControl.selectedSegmentIndex = 0; _scopeControl.accessibilityLabel = _scopeLabel.text;
+    [_scopeControl addTarget:self action:@selector(scopePicked:) forControlEvents:UIControlEventValueChanged];
+
+    _resetButton = panel_button(panel_text(env, DM_PAD_TEXT_RESET), NO);
+    _cancelButton = panel_button(panel_text(env, DM_PAD_TEXT_CANCEL), NO);
+    _doneButton = panel_button(panel_text(env, DM_PAD_TEXT_DONE), YES);
+    // For this game Reset to default asks which default (showScope:): the layout on screen built in, or this game's layout the same as every game's.
+    if (scopes) {
+        UIAction *builtIn = [UIAction actionWithTitle:panel_text(env, DM_PAD_TEXT_BUILT_IN) image:nil identifier:nil handler:^(UIAction *a) {
+            (void)a; DmPadEditPanel *s = weak; if (s.reset) s.reset();
+        }];
+        UIAction *same = [UIAction actionWithTitle:panel_text(env, DM_PAD_TEXT_FOLLOW) image:nil identifier:nil handler:^(UIAction *a) {
