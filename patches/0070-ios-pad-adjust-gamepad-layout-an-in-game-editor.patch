+//   or this game's own), the layouts the editor neither showed nor changed kept as that scope holds them (DmPadEditing.h, "Where Done saves"); in a
+//   game's own app in NSUserDefaults (launcher.DM_TOUCH_GROUPS), read at the next start. The running game takes it at once.
+static const char *edit_text_env(void) { return getenv("DM_PAD_EDIT_TEXT"); }
