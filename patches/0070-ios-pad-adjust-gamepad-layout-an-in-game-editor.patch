+}
+static UIStackView *panel_row(NSArray<UIView *> *views) {
+    UIStackView *r = [[UIStackView alloc] initWithArrangedSubviews:views];
+    r.axis = UILayoutConstraintAxisHorizontal; r.spacing = 6; r.alignment = UIStackViewAlignmentCenter;
+    return r;
