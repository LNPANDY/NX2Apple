+    [_groupPlus addAction:[UIAction actionWithHandler:^(UIAction *a) { (void)a; [weak stepGroup:5]; }] forControlEvents:UIControlEventTouchUpInside];
+
+    _allName = panel_label(13, UIFontWeightMedium, 0.9); _allName.text = _allText;
+    _allMinus = panel_round(@"minus.circle", [NSString stringWithFormat:@"%@, %@", _allText, _smallerText]);
+    _allPlus = panel_round(@"plus.circle", [NSString stringWithFormat:@"%@, %@", _allText, _largerText]);
+    _allSlider = [UISlider new]; _allSlider.minimumValue = DM_PAD_ALL_MIN; _allSlider.maximumValue = DM_PAD_ALL_MAX; _allSlider.accessibilityLabel = _allText;
