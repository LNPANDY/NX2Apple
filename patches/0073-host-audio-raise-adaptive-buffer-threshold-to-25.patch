From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LNPANDY <lnp-andy@hotmail.com>
Date: Sun, 22 Nov 2026 02:26:45 +0800
Subject: [PATCH] host/audio: raise adaptive buffer threshold to 256 frames for
 44.1 kHz resampling

44.1 kHz speakers at 5 ms request 221 device frames, causing Core Audio resampling to ask for 240-241 source frames. Using a strict 240-frame threshold tripped adaptive target_bytes staging and prevented small_cb_streak from settling, inflating the AudioOut queue and causing zero-filled dropouts in OpenAudioOut games.

Raise the adaptive callback threshold to 256 frames (RATE / 200 + 16) across au_target_bytes, dm_audio_io_buffer_hint, small_cb_streak, and front_ios.m so 44.1 kHz 5 ms resampling stays at zero extra latency while DM_AUDIO_MIX=1 and >256-frame callbacks keep adaptive staging.

Upstream-Status: pending
Reason: Avoid tripping adaptive AudioOut buffering on 240-241 frame 44.1 kHz 5 ms resample callbacks while keeping DM_AUDIO_MIX and >256-frame staging active
Issue: LNPANDY/NX2Apple#1269

---
 dm/host/hle_audio.c           |  15 +++--
 dm/host/tests/t_audio_stats.c | 100 ++++++++++++++++++++++++++++++++--
 dm/ios/Sources/front_ios.m    |   3 +-
 3 files changed, 106 insertions(+), 12 deletions(-)

diff --git a/dm/host/hle_audio.c b/dm/host/hle_audio.c
index fe3d6d8..9ffb6a9 100644
--- a/dm/host/hle_audio.c
+++ b/dm/host/hle_audio.c
@@ -16,6 +16,7 @@ int dm_ios_output_channels(void);   // front_ios.m: the audio session's output c
 enum { FMT_PCM16 = 2, STATE_STARTED = 0, STATE_STOPPED = 1, RATE = 48000 };
 enum { BK_NONE, BK_AU, BK_NULL };   // what is consuming an output's queue right now (aout.backend)
 enum { AU_IDLE, AU_STARTING, AU_CANCELED, AU_WAIT_CALLBACK };
+enum { AU_LARGE_CB_THRESHOLD_FRAMES = RATE / 200 + 16 };   // 256 frames: absorb 44.1 kHz 5 ms resample jitter (240-241 frames) without tripping adaptive buffering
 enum { OWNED_N = 48, OWNED_MAX_FRAMES = 1024 };   // host-copied PCM slots so large callbacks (e.g. 1024-frame iOS audio mixing) never starve 4 x 240-frame producers
 
 #define QMAX 64
@@ -36,7 +37,7 @@ typedef struct {
     aout_buf owned_buf[OWNED_N];
     _Atomic uint8_t owned_busy[OWNED_N];
     _Atomic uint64_t queued_bytes;     // Unplayed PCM bytes currently queued across q[]
-    _Atomic uint64_t target_bytes;     // Adaptive in-flight target (>0 only when callback frames > 240 or DM_AUDIO_MIX is active)
+    _Atomic uint64_t target_bytes;     // Adaptive in-flight target (>0 only when callback frames > AU_LARGE_CB_THRESHOLD_FRAMES or DM_AUDIO_MIX is active)
     _Atomic uint32_t guest_in_q;       // Unreleased guest buffers currently sitting in q[]
     uint64_t prebuf_need;              // Guest bytes required before draining after target_bytes expands (consumer-only)
     unsigned prebuf_holds, small_cb_streak;
@@ -90,7 +91,7 @@ static int owned_alloc(aout *a) {
     return -1;
 }
 static uint64_t au_target_bytes(int ch, uint32_t cb_frames) {
-    if (cb_frames <= RATE / 200) return 0;
+    if (cb_frames <= AU_LARGE_CB_THRESHOLD_FRAMES) return 0;
     uint32_t want = cb_frames * 2u + 480u;
     if (want > OWNED_N * 240u) want = OWNED_N * 240u;
     return (uint64_t)want * (uint64_t)ch * sizeof(int16_t);
@@ -100,13 +101,14 @@ static void au_sync_mix_hint(aout *a) {
     int env_mix = mix_e && atoi(mix_e) != 0;
     atomic_store_explicit(&a->env_mix, env_mix, memory_order_release);
     uint32_t hint = atomic_load_explicit(&g_io_buffer_hint_frames, memory_order_acquire);
+    if (hint <= AU_LARGE_CB_THRESHOLD_FRAMES) hint = 0u;
     if (env_mix && hint < 1024u) hint = 1024u;
     uint64_t init_target = au_target_bytes(a->ch, hint);
     if (init_target > atomic_load_explicit(&a->target_bytes, memory_order_relaxed))
         atomic_store_explicit(&a->target_bytes, init_target, memory_order_release);
 }
 void dm_audio_io_buffer_hint(unsigned frames) {
-    uint32_t norm = frames > (RATE / 200) ? (uint32_t)frames : 0u;
+    uint32_t norm = frames > AU_LARGE_CB_THRESHOLD_FRAMES ? (uint32_t)frames : 0u;
     atomic_store_explicit(&g_io_buffer_hint_frames, norm, memory_order_release);
     pthread_mutex_lock(&g_aos_lock);
     for (int i = 0; i < AOMAX; i++) {
@@ -309,18 +311,21 @@ static OSStatus au_render(void *ctx, AudioUnitRenderActionFlags *f, const AudioT
         uint32_t eff_frames = frames;
         int env_mix = atomic_load_explicit(&a->env_mix, memory_order_acquire);
         uint32_t hint = atomic_load_explicit(&g_io_buffer_hint_frames, memory_order_acquire);
+        if (hint <= AU_LARGE_CB_THRESHOLD_FRAMES) hint = 0u;
         if (env_mix && eff_frames < 1024u) eff_frames = 1024u;
         if (hint > eff_frames) eff_frames = hint;
         uint64_t want_target = au_target_bytes(a->ch, eff_frames);
         uint64_t cur_target = atomic_load_explicit(&a->target_bytes, memory_order_acquire);
         if (want_target > cur_target) {
             atomic_store_explicit(&a->target_bytes, want_target, memory_order_release);
+            a->small_cb_streak = 0;
             uint64_t req_bytes = (uint64_t)frames * (uint64_t)a->ch * sizeof(int16_t);
             if (req_bytes > a->prebuf_need) { a->prebuf_need = req_bytes; a->prebuf_holds = 0; }
-        } else if (frames <= RATE / 200 && !env_mix && !hint && cur_target && ++a->small_cb_streak >= 64) {
+        } else if (frames <= AU_LARGE_CB_THRESHOLD_FRAMES && !env_mix && !hint && cur_target && ++a->small_cb_streak >= 64) {
             atomic_compare_exchange_strong_explicit(&a->target_bytes, &cur_target, 0, memory_order_acq_rel, memory_order_relaxed);
+            a->small_cb_streak = 0;
         }
-        if (frames > RATE / 200) a->small_cb_streak = 0;
+        if (frames > AU_LARGE_CB_THRESHOLD_FRAMES) a->small_cb_streak = 0;
 
         int hold_prebuf = 0;
         if (a->prebuf_need) {
diff --git a/dm/host/tests/t_audio_stats.c b/dm/host/tests/t_audio_stats.c
index f7cebf8..c145d9d 100644
--- a/dm/host/tests/t_audio_stats.c
+++ b/dm/host/tests/t_audio_stats.c
@@ -90,7 +90,7 @@ static void fill_guest_block(aout_buf *b, uint64_t start_frame, unsigned frames,
     b->size = (uint64_t)frames * (uint64_t)ch * sizeof(int16_t);
 }
 // Reproduces iPhone 17 Pro Max DM_AUDIO_MIX=1 (240-1024 frame callbacks against 4 x 240-frame guest/audren blocks),
-// forced 2048-frame callbacks, and 6-channel 2 x 256-frame Bluetooth/mix callbacks.
+// forced 512/2048-frame callbacks, 6-channel 2 x 256-frame Bluetooth/mix callbacks, and Mac 44.1 kHz 221-frame (240-241 source frame) callbacks.
 static void replay_callback_regime(const char *label, int ch, unsigned nbufs, unsigned buf_frames, int mode, int mix_env) {
     if (mix_env) setenv("DM_AUDIO_MIX", "1", 1); else unsetenv("DM_AUDIO_MIX");
     uint32_t out[16] = {0};
@@ -118,8 +118,9 @@ static void replay_callback_regime(const char *label, int ch, unsigned nbufs, un
         if (!h_au_Append(out, rel)) break;
     }
 
-    uint64_t consumed = 0, mismatches = 0;
-    int started_stream = 0;
+    uint64_t consumed = 0, mismatches = 0, requested_total = 0;
+    uint64_t target_opened = 0, early_used = 0, prebuf_held = 0;
+    int started_stream = 0, saw_241 = 0;
     unsigned total_cbs = mode == 3 ? 1000 : 2000;
     int16_t played[2048 * 2];
     for (unsigned i = 0; i < total_cbs; i++) {
@@ -128,6 +129,10 @@ static void replay_callback_regime(const char *label, int ch, unsigned nbufs, un
         else if (mode == 2) frames = (i % 5 == 0) ? 240 : ((i % 3 == 0) ? 512 : 1024); // mixed 240-1024 frames as on iOS
         else if (mode == 3) frames = 2048;
         else if (mode == 4) frames = (i + 1) * 40960 / 147 - i * 40960 / 147; // 278-279 frames (44.1->48 kHz Bluetooth)
+        else if (mode == 5) frames = (unsigned)(((uint64_t)(i + 1) * 221u * 48000u / 44100u) - ((uint64_t)i * 221u * 48000u / 44100u)); // 240-241 frames (44.1 kHz 5 ms)
+        else if (mode == 6) frames = 512;
+        requested_total += frames;
+        if (frames == 241) saw_241 = 1;
 
         memset(played, 0, (size_t)frames * 4);
         AudioBufferList bl = {.mNumberBuffers = 1, .mBuffers = {{2, frames * 4, played}}};
@@ -135,6 +140,9 @@ static void replay_callback_regime(const char *label, int ch, unsigned nbufs, un
         au_render(a, NULL, NULL, 0, frames, &bl);
         in_callback = 0;
         atomic_store(&a->st_pending, 0);
+        if (atomic_load(&a->target_bytes) != 0) target_opened++;
+        if (a->early_tail != 0) early_used++;
+        if (a->prebuf_holds != 0) prebuf_held++;
 
         unsigned j = 0;
         if (!started_stream) {
@@ -161,26 +169,106 @@ static void replay_callback_regime(const char *label, int ch, unsigned nbufs, un
     CHECK(underruns == 0, "large/mixed callbacks run with zero underruns");
     CHECK(mismatches == 0, "all played PCM samples are contiguous and in order");
 
+    if (mode == 0 || mode == 5) {
+        if (mode == 5) CHECK(saw_241, "44.1 kHz 5 ms resample regime hits 241-frame callbacks");
+        CHECK(target_opened == 0 && early_used == 0 && prebuf_held == 0,
+              "5 ms / 44.1 kHz resample callbacks never activate target_bytes or early release");
+        CHECK(consumed == requested_total, "5 ms / 44.1 kHz mode plays from sample 0 with zero prebuffer gaps");
+    } else {
+        CHECK(atomic_load(&a->target_bytes) > 0, "large-callback or DM_AUDIO_MIX regime activates adaptive target_bytes");
+    }
+
     // Stop must return every guest buffer exactly once so guest middleware can join cleanly.
     h_au_Stop(out);
     unsigned returned_after_stop = 0;
     while (h_au_Released(out) != NULL) returned_after_stop++;
     CHECK(returned_after_stop == nbufs, "stop returns all in-flight guest buffers");
 
-    // Exclusive 240-frame mode must keep zero extra prebuffer latency when DM_AUDIO_MIX is off.
-    if (mode == 0) {
-        CHECK(consumed == (uint64_t)total_cbs * 240, "240-frame exclusive mode plays from sample 0 with no prebuffer hold");
+    h_au_Close(out);
+    unsetenv("DM_AUDIO_MIX");
+}
+static void test_adaptive_threshold_and_backoff(void) {
+    unsetenv("DM_AUDIO_MIX");
+    dm_audio_io_buffer_hint(0);
+    uint32_t out[16] = {0};
+    uint8_t prm[8] = {0};
+    *(uint16_t *)(prm + 4) = 2;
+    CHECK(!h_au_OpenDef0(out, prm), "open output for adaptive threshold checks");
+    aout *a = ao(out);
+    a->dev_ch = 2;
+    atomic_store(&a->state, STATE_STARTED);
+
+    dm_audio_io_buffer_hint(241);
+    CHECK(atomic_load(&g_io_buffer_hint_frames) == 0 && atomic_load(&a->target_bytes) == 0,
+          "241-frame buffer hint is ignored below threshold");
+    dm_audio_io_buffer_hint(AU_LARGE_CB_THRESHOLD_FRAMES);
+    CHECK(atomic_load(&g_io_buffer_hint_frames) == 0 && atomic_load(&a->target_bytes) == 0,
+          "threshold-boundary buffer hint stays inactive");
+    dm_audio_io_buffer_hint(512);
+    CHECK(atomic_load(&g_io_buffer_hint_frames) == 512 && atomic_load(&a->target_bytes) > 0,
+          "512-frame buffer hint activates target_bytes");
+    dm_audio_io_buffer_hint(0);
+    CHECK(atomic_load(&g_io_buffer_hint_frames) == 0, "clearing buffer hint resets global hint");
+
+    int16_t played[512 * 2] = {0};
+    for (unsigned i = 0; i < 64; i++) {
+        unsigned frames = (i & 1) ? 241u : 240u;
+        AudioBufferList bl = {.mNumberBuffers = 1, .mBuffers = {{2, frames * 4, played}}};
+        in_callback = 1;
+        au_render(a, NULL, NULL, 0, frames, &bl);
+        in_callback = 0;
+        atomic_store(&a->st_pending, 0);
+    }
+    CHECK(atomic_load(&a->target_bytes) == 0,
+          "64 callbacks of 240-241 frames settle target_bytes back to zero");
+
+    AudioBufferList bl512 = {.mNumberBuffers = 1, .mBuffers = {{2, 512u * 4u, played}}};
+    in_callback = 1;
+    au_render(a, NULL, NULL, 0, 512, &bl512);
+    in_callback = 0;
+    atomic_store(&a->st_pending, 0);
+    CHECK(atomic_load(&a->target_bytes) > 0, "transient 512-frame callback opens target_bytes");
+    for (unsigned i = 0; i < 64; i++) {
+        unsigned frames = (i & 1) ? 241u : 240u;
+        AudioBufferList bl = {.mNumberBuffers = 1, .mBuffers = {{2, frames * 4, played}}};
+        in_callback = 1;
+        au_render(a, NULL, NULL, 0, frames, &bl);
+        in_callback = 0;
+        atomic_store(&a->st_pending, 0);
+    }
+    CHECK(atomic_load(&a->target_bytes) == 0,
+          "64 callbacks of 240-241 frames settle transient 512-frame target_bytes back to zero");
+    h_au_Close(out);
+
+    memset(out, 0, sizeof out);
+    setenv("DM_AUDIO_MIX", "1", 1);
+    CHECK(!h_au_OpenDef0(out, prm), "open output with DM_AUDIO_MIX=1");
+    a = ao(out);
+    a->dev_ch = 2;
+    atomic_store(&a->state, STATE_STARTED);
+    CHECK(atomic_load(&a->target_bytes) > 0, "DM_AUDIO_MIX=1 pre-opens target_bytes at open");
+    for (unsigned i = 0; i < 70; i++) {
+        unsigned frames = (i & 1) ? 241u : 240u;
+        AudioBufferList bl = {.mNumberBuffers = 1, .mBuffers = {{2, frames * 4, played}}};
+        in_callback = 1;
+        au_render(a, NULL, NULL, 0, frames, &bl);
+        in_callback = 0;
+        atomic_store(&a->st_pending, 0);
     }
+    CHECK(atomic_load(&a->target_bytes) > 0, "DM_AUDIO_MIX=1 keeps target_bytes active across 240-241 frame callbacks");
     h_au_Close(out);
     unsetenv("DM_AUDIO_MIX");
 }
 int main(void) {
     setenv("DM_AUDIO", "0", 1); setenv("DM_AUDIO_MUTE", "0", 1);
     replay_callback_regime("exclusive-240", 2, 4, 240, 0, 0);
+    replay_callback_regime("mac-44k-5ms-240-241", 2, 4, 240, 5, 0);
+    replay_callback_regime("unhinted-512", 2, 4, 240, 6, 0);
     replay_callback_regime("ios-mix-1024", 2, 4, 240, 1, 1);
     replay_callback_regime("ios-mix-variable-240-1024", 2, 4, 240, 2, 1);
     replay_callback_regime("unhinted-2048", 2, 4, 240, 3, 0);
     replay_callback_regime("bt-6ch-2x256", 6, 2, 256, 4, 0);
+    test_adaptive_threshold_and_backoff();
     report_entered = dispatch_semaphore_create(0); report_allow = dispatch_semaphore_create(0);
     report_done = dispatch_semaphore_create(0); released_event = dispatch_semaphore_create(0);
     uint32_t out[16] = {0}; uint8_t prm[8] = {0}, ev[64] = {0};
diff --git a/dm/ios/Sources/front_ios.m b/dm/ios/Sources/front_ios.m
index 132355a..607ebc3 100644
--- a/dm/ios/Sources/front_ios.m
+++ b/dm/ios/Sources/front_ios.m
@@ -632,7 +632,8 @@ void front_ios_audio_session(void) {
     if (g_session_off) LOG("[RED] audio session activation failed: %s", e.localizedDescription.UTF8String);
     unsigned io_frames = s.IOBufferDuration > 0 ? (unsigned)(s.IOBufferDuration * 48000.0 + 0.5) : 0;
     if (mix_on && io_frames < 1024u) io_frames = 1024u;
-    dm_audio_io_buffer_hint((mix_on || io_frames > 240u) ? io_frames : 0u);
+    // Match hle_audio.c AU_LARGE_CB_THRESHOLD_FRAMES (256) so 44.1 kHz ~5 ms buffers do not trip adaptive staging.
+    dm_audio_io_buffer_hint((mix_on || io_frames > 256u) ? io_frames : 0u);
     LOG("audio session: sample rate %.0f Hz, I/O buffer %.2f ms (asked for 5 ms), mix %s", s.sampleRate, s.IOBufferDuration * 1000, mix_on ? "on" : "off");
     front_ios_audio_channels(s);
 }
