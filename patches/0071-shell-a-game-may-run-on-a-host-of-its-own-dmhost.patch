--- /dev/null
+++ b/dm/host/host_image.h
@@ -0,0 +1,10 @@
+// The image the host's own tables live in (the __DATA sections swhle, swforce and swnvn): the app's executable when the host is
+// linked into it, as always, or DmHost<title ID>.framework when the shared app runs a game with a host of its own (a game whose
+// engine differs from the shell's: dm/ios/tools/build_host.sh). _mh_execute_header names only the executable's header, so a host in
+// a framework would read the shell's tables and call the shell's built-in host. The linker defines __dso_handle in every image
+// (executable or dylib) as that image's mach header, so in an executable it is _mh_execute_header.
+#pragma once
+#include <mach-o/loader.h>
+
+extern const struct mach_header_64 __dso_handle;
+#define DM_HOST_IMAGE (&__dso_handle)
