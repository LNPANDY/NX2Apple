+#!/bin/bash
+# Route C shell: a game's own host, DmHost<title ID>.framework, built unsigned from this engine tree (project-host.yml). The shell app
+# has one host built in, compiled from the engine that builds the shell. A game whose engine differs from it (the Mac launcher's game
+# engine file with an engine.patch: changed host sources such as dm/host/hle_*.c or dm/gfx) gets this one beside its
+# DmGame<title ID>.framework. build_shell.sh embeds it when the game's manifest names it (host_framework), and ShellMain.m dlopens it
+# instead of the built-in host when that game is played. The other games keep the built-in host.
+# Usage: GAME=<base game title ID> dm/ios/tools/build_host.sh <output folder> <work folder>
+#   <output folder>/DmHost<title ID>.framework is written (replaced); <work folder> holds Gen/, the project, the derived data and build.log
+#   The game's profile is the host's compiled defaults (gen_build.py: game_profile.h), as the first game's is in the shell
+#   DM_FORK_PATCHES: what DMForkPatches in the framework's Info.plist says (default: dm/fork_patches.txt, comma-separated); the game's log prints it
+set -u
+cd "$(dirname "$0")/.." || exit 1
+IOS_SOURCE=$PWD; DM=$(cd .. && pwd)
+t() { echo "[$(date +%T)] $*"; }; die() { t "FAIL: $*"; exit 1; }
+[ -n "${GAME:-}" ] || die "GAME is not set: GAME=<base game title ID> $0 <output folder> <work folder>"
+[ $# -eq 2 ] || die "usage: GAME=<title ID> $0 <output folder> <work folder>"
+export GAME LC_ALL=C
+NAME=DmHost$(echo "$GAME" | tr 'a-z' 'A-Z')
+mkdir -p "$1" "$2" || die "mkdir $1 $2"
+OUT=$(cd "$1" && pwd); S=$(cd "$2" && pwd)
+[ "$S" != "$IOS_SOURCE" ] || die "the work folder must be outside dm/ios"
+FORK_PATCHES=${DM_FORK_PATCHES-$(paste -sd, "$DM/fork_patches.txt" 2>/dev/null || true)}
+V=$(sed -n 's/^#define DMSH_CHAIN "\(.*\)"/\1/p' "$DM/gfx/nvn/dmsh_chain.h"); [ -n "$V" ] || die "no DMSH_CHAIN in dm/gfx/nvn/dmsh_chain.h"
+
+t "the game's own host $NAME (compiled defaults of $GAME, shader chain $V)"
+for item in Sources Shell; do ln -sfn "$IOS_SOURCE/$item" "$S/$item" || die "link $item"; done
+cd "$S" || die "cd $S"
+rm -rf Gen && mkdir -p Gen || die "mkdir Gen"
+python3 "$IOS_SOURCE/tools/gen_build.py" "$DM/host" Gen > Gen/dm.xcconfig || die "gen_build"
+echo 'OTHER_LDFLAGS = $(inherited) $(DM_FRAMEWORKS)' >> Gen/dm.xcconfig
+cp "$IOS_SOURCE/project-host.yml" project.yml || die "copy project-host.yml"
+xcodegen generate -q > /dev/null || die "xcodegen"
+/usr/libexec/PlistBuddy -c "Add :DMChain string $V" Gen/Info.plist > /dev/null || die "DMChain"
+# The glue version the shell compares before it embeds this host (build_shell.sh) and before it loads it (ShellMain.m)
+GLUE=$(sed -n 's/^#define DM_GLUE_VERSION \([0-9]*\).*/\1/p' "$IOS_SOURCE/Shell/ShellGlue.h"); [ -n "$GLUE" ] || die "no DM_GLUE_VERSION in Shell/ShellGlue.h"
+/usr/libexec/PlistBuddy -c "Add :DMGlueVersion integer $GLUE" Gen/Info.plist > /dev/null || die "DMGlueVersion"
+/usr/libexec/PlistBuddy -c "Add :DMForkPatches string $FORK_PATCHES" Gen/Info.plist > /dev/null || die "DMForkPatches"
+COMMIT=$(git -C "$DM" rev-parse --short=12 HEAD 2> /dev/null) && { [ -z "$(git -C "$DM" status --porcelain --untracked-files=no 2> /dev/null)" ] || COMMIT=$COMMIT+dirty
+  /usr/libexec/PlistBuddy -c "Add :DMCommit string $COMMIT" Gen/Info.plist > /dev/null || die "DMCommit"; }
+
+t "xcodebuild (Release, unsigned, $NAME)"
+DD=$S/dd
+xcodebuild -project DmHost.xcodeproj -target DmHost -configuration Release -sdk iphoneos \
+  CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY= PRODUCT_NAME="$NAME" \
+  PRODUCT_BUNDLE_IDENTIFIER="org.nxnative.host.$(echo "$GAME" | tr 'A-Z' 'a-z')" \
+  SYMROOT="$DD/Build/Products" OBJROOT="$DD/Build/Intermediates.noindex" build > "$S/build.log" 2>&1 \
+  || { grep -E 'error:|Undefined symbol|referenced from' "$S/build.log" | head -30; die "xcodebuild, log $S/build.log"; }
+BUILT=$DD/Build/Products/Release-iphoneos/$NAME.framework
+[ -f "$BUILT/$NAME" ] || die "no built framework $BUILT"
+# What ShellMain.m looks up in it (ShellGlue.h)
+for sym in dm_glue_version dm_glue_start_game dm_glue_present_game front_ios_focus_event; do
+  nm -gU "$BUILT/$NAME" | grep -q " _$sym\$" || die "$NAME does not export $sym"
+done
+rsync -a --delete -- "$BUILT/" "$OUT/$NAME.framework/" || die "copy $NAME.framework to $OUT"
+t "done: $OUT/$NAME.framework ($(du -sh "$OUT/$NAME.framework" | cut -f1); build_shell.sh embeds it with the game's framework)"
