index 0000000..4df4d67
--- /dev/null
+++ b/dm/ios/project-host.yml
@@ -0,0 +1,50 @@
+# A game's own host for route C's shell: DmHost<title ID>.framework, the whole host (dm/host's sources and the libraries they compile,
+# the game view, the engine side of Play) as one framework, for a game whose engine differs from the shell's. dm/ios/tools/build_host.sh
+# copies this template to its work folder, generates Gen/ there (gen_build.py, as build_shell.sh does) and builds it unsigned; the shell
+# project embeds it beside the game's DmGame<title ID>.framework and signs it, and ShellMain.m dlopens it instead of the shell's built-in
+# host when that game is played. The sources are the shell's, less the app itself (ShellMain.m, ShellApp.swift, the Swift package).
+name: DmHost
+options:
+  bundleIdPrefix: org.nxnative.host
+  deploymentTarget:
+    iOS: "26.0"
+configFiles:     # build_host.sh: the host's header paths, defines and frameworks from dm/host/Makefile (gen_build.py)
+  Release: Gen/dm.xcconfig
+  Debug: Gen/dm.xcconfig
+targets:
+  DmHost:
+    type: framework
+    platform: iOS
+    sources:
+      - path: Shell/ShellGlue.m        # the engine side of Play: what ShellMain.m calls through dlsym (ShellGlue.h)
+      - path: Sources/front_ios.m      # the game view, as in the shell
+      - path: Sources/DmGamepad.m
+      - path: Sources/GameMenu.swift   # the in-game menu the gamepad's gear opens (dm_game_menu), as in the shell: the layouts and Quit
+      - path: Sources/LauncherSettings.swift   # GameMenu.swift's model type
+      - path: Sources/CloudSaves.m
+      - path: Sources/SaveSync.m
+      - path: Sources/DataBookmark.m
+      - path: Gen/src
+      - path: Gen/main/main.c
+        compilerFlags: "-Dmain=dm_main"
+    info:
+      path: Gen/Info.plist
+      properties:
+        CFBundleVersion: "1"
+        CFBundleShortVersionString: "1.0"
+    settings:
+      PRODUCT_BUNDLE_IDENTIFIER: org.nxnative.host
+      PRODUCT_NAME: DmHost
+      CODE_SIGN_STYLE: Automatic
+      SKIP_INSTALL: YES
+      DYLIB_INSTALL_NAME_BASE: "@rpath"
+      DEFINES_MODULE: NO   # nothing imports it: the shell dlopen()s it
+      ENABLE_BITCODE: NO
+      GCC_C_LANGUAGE_STANDARD: gnu11
+      OTHER_CFLAGS: $(inherited) -mcpu=apple-a18   # the host assembly's LSE atomics, as in the shell
+      CLANG_ENABLE_OBJC_ARC: YES
+      CLANG_ENABLE_MODULES: YES
+      SWIFT_VERSION: "5.0"
+      SWIFT_OBJC_BRIDGING_HEADER: Sources/DmGameMenu.h   # what GameMenu.swift calls in DmGamepad.m and front_ios.m
+      DEBUG_INFORMATION_FORMAT: dwarf
+      GCC_WARN_INHIBIT_ALL_WARNINGS: YES
