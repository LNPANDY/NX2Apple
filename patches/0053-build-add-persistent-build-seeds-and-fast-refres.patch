+    def test_large_legacy_seed_quota_supports_over_32gib_pokopia_scale(self):
+        self.assertGreater(build_seed.SEED_MAX_BYTES, 44 << 30)
+        self.assertGreaterEqual(build_seed.SEED_MAX_ENTRIES, 2_000_000)
+
+        # Pokopia-scale quota check: 38.786 GiB metal-sources + 4.300 GiB shader/pkg + 2 GiB ios/ExeFS
+        quota = build_seed._Quota()
+        metal_bytes = int(38.786 * (1 << 30))
+        pkg_bytes = int(4.300 * (1 << 30))
+        ios_bytes = 2 << 30
+        quota.charge(600_000, metal_bytes, 'b6c0c686dc3a67a3_b.metal')
+        quota.charge(200_000, pkg_bytes, 'shader/pkg')
+        quota.charge(100_000, ios_bytes, 'shader/ios')
+        self.assertEqual(quota.used_bytes, metal_bytes + pkg_bytes + ios_bytes)
+
+        # Exceeding SEED_MAX_BYTES must still be rejected
+        with self.assertRaisesRegex(ValueError, 'seed byte quota exceeded'):
+            quota.charge(1, build_seed.SEED_MAX_BYTES, 'overflow')
+
+        # inspect_seed / _verify_no_symlinks_or_unsafe_names must allow uncompressed seeds > 32 GiB (e.g. 44 GiB)
+        seed_root = self.root / 'pokopia_inspect'
+        tid = '0400A3A01EE4C000'
+        seed_dir, _ = self._make_legacy_seed_with_uncompressed_img(seed_root, tid, chain='108c5f92c3c40000', app_name='Pokopia')
+        big_metal = seed_dir / 'metal-sources' / 'b-108c5f92c3c40000.img'
+
+        real_scandir = os.scandir
+
+        class _FakeBigEntry:
+            def __init__(self, inner):
+                self._inner = inner
+                self.name = inner.name
+                self.path = inner.path
+
+            def __getattr__(self, attr):
+                return getattr(self._inner, attr)
+
+            def stat(self, follow_symlinks=False):
+                st = self._inner.stat(follow_symlinks=follow_symlinks)
+                if self.path == str(big_metal):
+                    return os.stat_result((st.st_mode, st.st_ino, st.st_dev, st.st_nlink, st.st_uid, st.st_gid, 44 << 30, st.st_atime, st.st_mtime, st.st_ctime))
+                return st
+
+        @build_seed.contextlib.contextmanager
+        def _fake_scandir(path):
+            with real_scandir(path) as it:
+                yield [_FakeBigEntry(e) for e in it]
+
+        with mock.patch('os.scandir', side_effect=_fake_scandir):
+            insp = build_seed.inspect_seed(seed_root, tid)
+        self.assertTrue(insp['valid'], insp.get('reason'))
+        self.assertGreater(insp['size_bytes'], 44 << 30)
