+    def test_zstd_bomb_early_header_and_trailing_overflow_rejection(self):
+        # 1. Forged oversized DMROMFS1 header bomb (> SEED_MAX_BYTES) rejected at 32-byte header before disk write
+        oversized_head = romfs.HEAD.pack(romfs_image.MAGIC, build_seed.SEED_MAX_BYTES + 64, 1 << 20, 2)
+        bomb_raw = self.root / 'bomb_oversized.raw'
+        bomb_raw.write_bytes(oversized_head + (b'\x00' * (128 << 10)))
+        bomb_zst = self.root / 'bomb_oversized.img.zst'
+        build_seed._zstd_compress_stream(str(bomb_raw), str(bomb_zst), level=3)
+
+        out_img = self.root / 'bomb_out.img'
+        with self.assertRaisesRegex(ValueError, 'exceeds byte quota'):
+            build_seed._zstd_verify_and_decompress_stream(
+                str(bomb_zst), dst_path=str(out_img), expected_magic=romfs_image.MAGIC
+            )
+        self.assertFalse(out_img.exists())
+
+        # 2. Forged entry-count bomb (> SEED_MAX_ENTRIES + 1) rejected immediately at 32-byte header
+        huge_count = build_seed.SEED_MAX_ENTRIES + 10
+        count_head = romfs.HEAD.pack(romfs_image.MAGIC, 64, huge_count * romfs.ENT.size, huge_count)
+        count_raw = self.root / 'bomb_count.raw'
+        count_raw.write_bytes(count_head + b'\x00' * 128)
+        count_zst = self.root / 'bomb_count.img.zst'
+        build_seed._zstd_compress_stream(str(count_raw), str(count_zst), level=3)
+        with self.assertRaisesRegex(ValueError, 'invalid RomFS header bounds'):
+            build_seed._zstd_verify_and_decompress_stream(str(count_zst), expected_magic=romfs_image.MAGIC)
+
+        # 3. Valid small DMROMFS1 header followed by trailing bomb bytes rejected by declared bounds
+        valid_small = self.root / 'valid_small.img'
+        shader_lib.write({'0000000000000001_b.metal': b'void ok() {}\n'}, str(valid_small))
+        trailing_raw = self.root / 'bomb_trailing.raw'
+        trailing_raw.write_bytes(valid_small.read_bytes() + (b'\x00' * (3 << 20)))
+        trailing_zst = self.root / 'bomb_trailing.img.zst'
+        build_seed._zstd_compress_stream(str(trailing_raw), str(trailing_zst), level=3)
+        with self.assertRaisesRegex(ValueError, 'exceeds declared RomFS bounds'):
+            build_seed._zstd_verify_and_decompress_stream(str(trailing_zst), expected_magic=romfs_image.MAGIC)
+
+        # 4. Insufficient disk space check when dst_path is given
+        valid_zst = self.root / 'valid_small.img.zst'
+        build_seed._zstd_compress_stream(str(valid_small), str(valid_zst), level=3)
+        low_disk = shutil._ntuple_diskusage(total=1 << 30, used=1 << 30, free=64)
+        with mock.patch('shutil.disk_usage', return_value=low_disk):
+            with self.assertRaises(OSError) as cm:
+                build_seed._zstd_verify_and_decompress_stream(
+                    str(valid_zst), dst_path=str(out_img), expected_magic=romfs_image.MAGIC
+                )
+        self.assertEqual(cm.exception.errno, 28)
+        self.assertFalse(out_img.exists())
+
+    def test_prepare_prefill_streams_without_read_bytes_and_avoids_duplicate_zst_decompression(self):
