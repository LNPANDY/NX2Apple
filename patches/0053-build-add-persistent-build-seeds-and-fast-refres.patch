+                if size > MSL_EXTRACT_MAX_BYTES - total_bytes:
+                    raise ValueError(f'RomFS trailer exceeds byte quota ({MSL_EXTRACT_MAX_BYTES} bytes): {img_path}')
+                total_bytes += size
+                count += 1
