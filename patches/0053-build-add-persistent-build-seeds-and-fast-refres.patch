+
+        # 6. Stage shader/ios/ and metal-sources/b-<chain>.img
+        gfx_api = str(meta_in.get('gfx_api') or prof_kv.get('gfx_api') or 'nvn').strip().lower()
+        if gfx_api not in ('nvn', 'vulkan', 'gl'):
