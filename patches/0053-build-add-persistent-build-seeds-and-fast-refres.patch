+        ext_zst = ext_dir / f'b-{chain}.img.zst'
+        build_seed._zstd_compress_stream(str(ext_raw), str(ext_zst), level=3)
+
+        ext_only_raw = self.root / 'ext_only_raw.img'
+        shader_lib.write(
+            {
+                '0000000000000002_b.metallib': b'MAC_ONLY_BIN',
+                '0000000000000002_b.metal': b'vertex float4 ext_only_v() { return 0; }\n',
+                '0000000000000002_b.json': b'{"stage":"vs","chain_metal":"macosx"}\n',
+                'inputs.tsv': b'inputs\text_only\n',
+            },
+            str(ext_only_raw),
+        )
+        ext_only_zst = ext_dir / f'b-{ext_only_chain}.img.zst'
+        build_seed._zstd_compress_stream(str(ext_only_raw), str(ext_only_zst), level=3)
+
+        orig_resolve = build_seed._resolve_lib_for_read
+        resolve_calls = []
+
+        def _counting_resolve(lib_path, tmp_dir, quota):
+            resolve_calls.append(os.fspath(lib_path))
+            return orig_resolve(lib_path, tmp_dir, quota)
+
+        out_tmp = self.root / 'prefill_out_stream'
+        with mock.patch.object(build_seed, '_resolve_lib_for_read', side_effect=_counting_resolve), \
+                mock.patch.object(romfs.Path, 'read_bytes', side_effect=AssertionError('read_bytes must not run during prepare_prefill')), \
+                mock.patch.object(shader_lib.romfs.Path, 'read_bytes', side_effect=AssertionError('read_bytes must not run during prepare_prefill')):
+            env_val, summary = build_seed.prepare_prefill(
+                str(seed_dir), [str(ext_dir)], str(out_tmp), gfx_api='nvn', target_chain='9999000011112222'
+            )
+
+        self.assertTrue(env_val)
+        self.assertEqual(summary['chains'], [f'b-{chain}', f'b-{ext_only_chain}'])
+        # Each .img.zst source should be decompressed at most once across discovery and pairing
+        self.assertEqual(resolve_calls.count(str(ext_dir / f'b-{chain}')), 1)
+        self.assertEqual(resolve_calls.count(str(ext_dir / f'b-{ext_only_chain}')), 1)
+        self.assertEqual(resolve_calls.count(str(seed_dir / 'metal-sources' / f'b-{chain}')), 1)
+        mac_img = Path(summary['prefill_mac']) / f'b-{chain}.img'
+        self.assertIn('legacy_fn', (shader_lib.view(str(mac_img)) / '0000000000000001_b.metal').read_text())
+        self.assertEqual((shader_lib.view(str(mac_img)) / '0000000000000001_b.metallib').read_bytes(), b'MAC_BIN_PAYLOAD')
+
