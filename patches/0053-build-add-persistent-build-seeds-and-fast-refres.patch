+                if os.path.isfile(cand):
+                    eff_control = cand
+                    break
+        if eff_control and os.path.exists(eff_control):
+            _link_or_copy_file(eff_control, os.path.join(staging_dir, 'control.nacp'), quota)
+
+        eff_icon = os.fspath(icon_path) if icon_path else None
+        if not eff_icon:
