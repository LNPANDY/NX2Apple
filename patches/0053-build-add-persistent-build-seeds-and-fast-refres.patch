+    def test_compress_seeds_sigterm_preserves_completed_and_cleans_tmp(self):
+        seed_root = self.root / 'seeds_sigterm'
+        tid1 = '0100000000000401'
+        tid2 = '0100000000000402'
+        _, img1 = self._make_legacy_seed_with_uncompressed_img(
+            seed_root, tid1, chain='1111aaaa2222bbbb',
+            extra_files={'0000000000000001_b.metal': b'A' * 200000},
+        )
+        _, img2 = self._make_legacy_seed_with_uncompressed_img(
+            seed_root, tid2, chain='2222bbbb3333cccc',
+            extra_files={'0000000000000001_b.metal': b'B' * 100000},
+        )
+
+        # Spawn real subprocess and send SIGTERM right after item 1 completes
+        proc = subprocess.Popen(
+            [
+                sys.executable,
+                str(REPO / 'dm' / 'tools' / 'build_seed.py'),
+                'compress-seeds',
+                '--seed-root',
+                str(seed_root),
+                '--progress',
+                'json',
+            ],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        seen_events = []
+        sent_sig = False
+        try:
+            assert proc.stdout is not None
+            for line in proc.stdout:
+                ev = json.loads(line)
+                seen_events.append(ev)
+                if ev.get('event') == 'item_done' and not sent_sig:
+                    proc.send_signal(signal.SIGTERM)
+                    sent_sig = True
+            rc = proc.wait(timeout=10)
+        finally:
+            if proc.stdout:
+                proc.stdout.close()
+            if proc.stderr:
+                proc.stderr.close()
+
+        self.assertEqual(rc, 0)
+        self.assertTrue(sent_sig)
+        self.assertEqual(seen_events[-1]['event'], 'done')
+        self.assertEqual(seen_events[-1]['status'], 'stopped')
+        self.assertEqual(seen_events[-1]['completed_games'], 1)
+        self.assertFalse(img1.exists())
+        self.assertTrue(Path(str(img1) + '.zst').is_file())
+        self.assertTrue(img2.is_file(), 'interrupted/unstarted game must keep original .img')
+        self.assertFalse(Path(str(img2) + '.zst.tmp').exists(), 'unfinished .tmp must be cleaned on SIGTERM')
