+        zst_path = Path(str(img_path) + '.zst')
+        build_seed._zstd_compress_stream(str(img_path), str(zst_path), level=3)
+        img_path.unlink()
+
+        ext_dir = self.root / 'ext_prefill_src'
+        ext_dir.mkdir(parents=True)
+        ext_only_chain = 'cccc4444dddd5555'
+        ext_raw = self.root / 'ext_raw.img'
+        shader_lib.write(
+            {
+                '0000000000000001_b.metallib': b'MAC_BIN_PAYLOAD',
+                '0000000000000001_b.metal': b'vertex float4 ext_v() { return 0; }\n',
+                '0000000000000001_b.json': b'{"stage":"vs","chain_metal":"macosx"}\n',
+                'inputs.tsv': b'inputs\text\n',
+            },
