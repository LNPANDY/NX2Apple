+
+        raw_chain = _norm_chain(meta_in.get('chain'))
+        ios_src = _extra_ios_dir
+        if not ios_src:
+            cand_ios = os.path.join(src_shader, 'ios')
+            cand_legacy = os.path.join(work_path, 'build', 'ios', 'dmsh_b')
