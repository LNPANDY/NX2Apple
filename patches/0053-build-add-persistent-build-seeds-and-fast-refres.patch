+#!/usr/bin/env python3
+"""Persistent build seed cache (Schema v1) for fast launcher/engine refreshes without NSPs or prod.keys."""
+
+import argparse
+import contextlib
+import datetime
+import errno
+import hashlib
+import importlib
+import io
+import json
+import os
+import plistlib
+import re
+import shutil
+import signal
+import stat
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+
+_TOOLS_DIR = os.path.dirname(os.path.abspath(__file__))
+_REPO_ROOT = os.path.abspath(os.path.join(_TOOLS_DIR, '..', '..'))
+if _REPO_ROOT not in sys.path:
+    sys.path.insert(0, _REPO_ROOT)
+
+from dm.tools import nacp, romfs, romfs_image, shader_lib  # noqa: E402
+
+SEED_SCHEMA_VERSION = 1
+SEED_MAX_ENTRIES = 2_000_000
+SEED_MAX_BYTES = 128 << 30
+COPY_CHUNK = 8 << 20
+_ZSTD_CHUNK = 2 << 20
+_ZSTD_MAGIC = b'\x28\xb5\x2f\xfd'
+_ZSTD_RESERVE_MIN_BYTES = 64 << 20
+_ZSTD_RESERVE_RATIO = 0.25
+_ZSTD_ESTIMATE_RATIO = 0.08
+
+_TID_RE = re.compile(r'^[0-9A-F]{16}$')
+_PROG_RE = re.compile(r'^p(\d+)$')
+_VER_RE = re.compile(r'^v(\d+)$')
+_STALE_TMP_RE = re.compile(r'^\.([0-9A-F]{16})\.(staging|old)\.(\d+)$')
+
+SEED_FIELDS = (
+    'schema',
+    'title_id',
+    'base_title_id',
+    'pkg_ver',
+    'app_name',
+    'app_version',
+    'bundle_id',
+    'lang',
+    'langs_available',
+    'gfx_api',
+    'chain',
+    'profile_id',
+    'profile_kind',
+    'is_multi_program',
+    'uses_jit',
+    'has_aoc',
+    'has_html',
+    'has_icon',
+    'inputs_digest',
+    'romfs_identity',
+    'updated_at',
+    'programs',
+)
+
+_OPTIONAL_CAPTURE_DIRS = ('vk_capture', 'gl_capture', 'glslc_capture', 'ue_shaders')
+_EMPTY_TABLE_HEADERS = {
+    'c1_full.tsv': '# empty table placeholder\n',
+    'cb_extent.tsv': '# empty table placeholder\n',
+}
+_REPARSE_ATTR = getattr(stat, 'FILE_ATTRIBUTE_REPARSE_POINT', 0x0400)
+
+
+def _is_symlink_or_reparse(path, st=None):
+    """Returns True for symlinks and Windows directory reparse points (e.g. NTFS junctions)."""
+    if os.path.islink(path):
+        return True
+    if st is None:
+        return False
+    if stat.S_ISLNK(st.st_mode):
+        return True
+    if stat.S_ISDIR(st.st_mode) and bool(int(getattr(st, 'st_file_attributes', 0) or 0) & _REPARSE_ATTR):
+        return True
+    return False
+
+
+def _dir_loop_key(path, st):
+    """Returns a stable directory identity key, falling back to realpath when st_ino == 0."""
+    if getattr(st, 'st_ino', 0):
+        return ('ino', getattr(st, 'st_dev', 0), st.st_ino)
+    return ('path', os.path.normcase(os.path.realpath(path)))
+
+
+class _Quota:
+    """Unified entry and byte budget across file staging, hardlinking and shader archive packing."""
+
+    def __init__(self, max_entries=SEED_MAX_ENTRIES, max_bytes=SEED_MAX_BYTES):
+        self.max_entries = int(max_entries)
+        self.max_bytes = int(max_bytes)
+        self.used_entries = 0
+        self.used_bytes = 0
+
+    def charge(self, entries, nbytes, label=''):
+        if entries < 0 or nbytes < 0:
+            raise ValueError(f'negative quota charge for {label}')
+        if entries > self.max_entries - self.used_entries:
+            raise ValueError(f'seed entry quota exceeded ({self.max_entries} max) at {label}')
+        if nbytes > self.max_bytes - self.used_bytes:
+            raise ValueError(f'seed byte quota exceeded ({self.max_bytes} bytes max) at {label}')
+        self.used_entries += entries
+        self.used_bytes += nbytes
+
+
+def default_seed_root():
+    """Returns the persistent build seed cache root, honoring DM_SEED_CACHE_DIR when set."""
+    override = os.environ.get('DM_SEED_CACHE_DIR', '').strip()
+    if override:
+        return os.path.abspath(os.path.expanduser(override))
+    home = os.path.expanduser('~')
+    if sys.platform == 'darwin':
+        return os.path.join(home, 'Library', 'Application Support', 'nxnative', 'build-seeds')
+    if sys.platform in ('win32', 'cygwin') or os.name == 'nt':
+        local_app_data = os.environ.get('LOCALAPPDATA', '').strip()
+        if local_app_data:
+            return os.path.join(local_app_data, 'nxnative', 'build-seeds')
+        return os.path.join(home, '.local', 'share', 'nxnative', 'build-seeds')
+    xdg = os.environ.get('XDG_DATA_HOME', '').strip()
+    if xdg:
+        return os.path.join(xdg, 'nxnative', 'build-seeds')
+    return os.path.join(home, '.local', 'share', 'nxnative', 'build-seeds')
+
+
+def _validate_title_id(title_id):
+    if not isinstance(title_id, str):
+        raise ValueError(f'invalid title_id: {title_id!r}')
+    tid = title_id.strip().upper()
+    if not _TID_RE.fullmatch(tid):
+        raise ValueError(f'invalid 16-hex title_id: {title_id!r}')
+    return tid
+
+
+def _default_base_title_id(tid):
+    return tid[:13] + '000'
+
+
+def _norm_chain(chain_val):
+    """Normalizes 'b-<hex>' or '<hex>' to raw '<hex>' (empty string when absent)."""
+    if not chain_val:
+        return ''
+    s = str(chain_val).strip()
+    if s.startswith('b-'):
+        s = s[2:]
+    return s
+
+
+def _chain_tag(chain_val):
+    """Formats a chain value as 'b-<hex>' (empty string when absent)."""
+    raw = _norm_chain(chain_val)
+    return f'b-{raw}' if raw else ''
+
+
+def _validate_rel_path(rel_path, label='path'):
+    if not isinstance(rel_path, str) or not rel_path:
+        raise ValueError(f'empty relative path in {label}')
+    if rel_path.startswith(('/', '\\')) or '\\' in rel_path or ':' in rel_path or '\0' in rel_path:
+        raise ValueError(f'unsafe relative path {rel_path!r} in {label}')
+    if any(0xD800 <= ord(ch) <= 0xDFFF for ch in rel_path):
+        raise ValueError(f'non-UTF-8 surrogate in path {rel_path!r} in {label}')
+    parts = rel_path.split('/')
+    if any(part in ('', '.', '..') for part in parts):
+        raise ValueError(f'unsafe path segment in {rel_path!r} in {label}')
+    return parts
+
+
+def _pid_alive(pid):
+    if pid <= 0:
+        return False
+    if pid == os.getpid():
+        return True
+    try:
+        os.kill(pid, 0)
+        return True
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    except OSError as exc:
+        if exc.errno == errno.ESRCH:
+            return False
+        return True
+
+
+def _sweep_stale_temp_dirs(seed_root, tid=None):
+    if not os.path.isdir(seed_root) or os.path.islink(seed_root):
+        return
+    try:
+        entries = list(os.scandir(seed_root))
+    except OSError:
+        return
+    for entry in entries:
+        m = _STALE_TMP_RE.fullmatch(entry.name)
+        if not m:
+            continue
+        entry_tid, _kind, pid_str = m.group(1), m.group(2), m.group(3)
+        if tid and entry_tid != tid:
+            continue
+        try:
+            pid = int(pid_str)
+        except ValueError:
+            continue
+        if not _pid_alive(pid):
+            if entry.is_symlink():
+                try:
+                    os.unlink(entry.path)
+                except OSError:
+                    pass
+            else:
+                shutil.rmtree(entry.path, ignore_errors=True)
+
+
+def _assert_not_overlapping_dirs(src_dir, dst_dir):
+    src_real = os.path.realpath(src_dir)
+    dst_parent_real = os.path.realpath(os.path.dirname(os.path.abspath(dst_dir)))
+    dst_real = os.path.join(dst_parent_real, os.path.basename(os.path.abspath(dst_dir)))
+    if os.path.exists(dst_dir):
+        dst_real = os.path.realpath(dst_dir)
+    try:
+        common = os.path.commonpath([src_real, dst_real])
+    except ValueError:
+        return
+    if common == src_real or common == dst_real:
+        raise ValueError(f'refusing recursive directory copy between {src_dir} and {dst_dir}')
+
+
+def _link_or_copy_file(src, dst, quota):
+    src_path = os.fspath(src)
+    dst_path = os.fspath(dst)
+    st = os.lstat(src_path)
+    if _is_symlink_or_reparse(src_path, st):
+        raise ValueError(f'symlink forbidden in build seed input: {src_path}')
+    if not stat.S_ISREG(st.st_mode):
+        raise ValueError(f'non-regular file forbidden in build seed input: {src_path}')
+    quota.charge(1, st.st_size, src_path)
+
+    parent = os.path.dirname(dst_path)
+    if os.path.islink(parent):
+        raise ValueError(f'symlink parent forbidden: {parent}')
+    os.makedirs(parent, exist_ok=True)
+
+    if os.path.lexists(dst_path):
+        if os.path.islink(dst_path) or os.path.isdir(dst_path):
+            raise ValueError(f'refusing to overwrite directory or symlink: {dst_path}')
+        os.unlink(dst_path)
+
+    try:
+        os.link(src_path, dst_path)
+        return
+    except OSError:
+        pass
+
+    tmp_dst = f'{dst_path}.part.{os.getpid()}'
+    if os.path.islink(tmp_dst):
+        raise ValueError(f'symlink temporary path forbidden: {tmp_dst}')
+    try:
+        with open(src_path, 'rb') as fin, open(tmp_dst, 'wb') as fout:
+            while True:
+                buf = fin.read(COPY_CHUNK)
+                if not buf:
+                    break
+                fout.write(buf)
+        try:
+            os.chmod(tmp_dst, stat.S_IMODE(st.st_mode))
+        except OSError:
+            pass
+        os.replace(tmp_dst, dst_path)
+    except BaseException:
+        try:
+            os.unlink(tmp_dst)
+        except OSError:
+            pass
+        raise
+
+
+def _stage_tree(src_dir, dst_dir, quota, allow_subdirs=True, skip_names=(), _ancestors=None):
+    src_path = os.fspath(src_dir)
+    dst_path = os.fspath(dst_dir)
+    st = os.lstat(src_path)
+    if _is_symlink_or_reparse(src_path, st):
+        raise ValueError(f'symlink directory forbidden: {src_path}')
+    if not stat.S_ISDIR(st.st_mode):
+        raise ValueError(f'expected directory: {src_path}')
+    if _ancestors is None:
+        _assert_not_overlapping_dirs(src_path, dst_path)
+        _ancestors = set()
+    dev_ino = _dir_loop_key(src_path, st)
+    if dev_ino in _ancestors:
+        raise ValueError(f'recursive directory cycle detected at {src_path}')
+    next_ancestors = _ancestors | {dev_ino}
+
+    if os.path.islink(dst_path):
+        raise ValueError(f'symlink destination forbidden: {dst_path}')
+    os.makedirs(dst_path, exist_ok=True)
+    quota.charge(1, 0, src_path)
+
+    with os.scandir(src_path) as it:
+        entries = sorted(it, key=lambda e: e.name)
+
+    for entry in entries:
+        if entry.is_symlink() or _is_symlink_or_reparse(entry.path):
+            raise ValueError(f'symlink forbidden inside tree: {entry.path}')
+        name = entry.name
+        if name in ('.DS_Store',) or '.tmp' in name or name in skip_names:
+            continue
+        _validate_rel_path(name, src_path)
+        target = os.path.join(dst_path, name)
+        if entry.is_dir(follow_symlinks=False):
+            if not allow_subdirs:
+                raise ValueError(f'unexpected subdirectory inside flat folder: {entry.path}')
+            _stage_tree(entry.path, target, quota, allow_subdirs=True, skip_names=skip_names, _ancestors=next_ancestors)
+        elif entry.is_file(follow_symlinks=False):
+            _link_or_copy_file(entry.path, target, quota)
+        else:
+            raise ValueError(f'unsupported special file in tree: {entry.path}')
+
+
+def _verify_no_symlinks_or_unsafe_names(root_dir):
+    """Walks root_dir without following symlinks and returns (ok, reason, total_bytes)."""
+    st = os.lstat(root_dir)
+    if _is_symlink_or_reparse(root_dir, st):
+        return False, f'seed path is a symlink: {root_dir}', 0
+    if not stat.S_ISDIR(st.st_mode):
+        return False, f'seed path is not a directory: {root_dir}', 0
+    total_bytes = 0
+    total_entries = 0
+    stack = [root_dir]
+    visited = {_dir_loop_key(root_dir, st)}
+    while stack:
+        cur = stack.pop()
+        try:
+            with os.scandir(cur) as it:
+                entries = list(it)
+        except OSError as exc:
+            return False, f'cannot scan {cur}: {exc}', total_bytes
+        for entry in entries:
+            total_entries += 1
+            if total_entries > SEED_MAX_ENTRIES:
+                return False, f'seed exceeds entry quota ({SEED_MAX_ENTRIES})', total_bytes
+            try:
+                _validate_rel_path(entry.name, cur)
+            except ValueError as exc:
+                return False, str(exc), total_bytes
+            try:
+                est = entry.stat(follow_symlinks=False)
+            except OSError as exc:
+                return False, f'cannot stat {entry.path}: {exc}', total_bytes
+            if entry.is_symlink() or _is_symlink_or_reparse(entry.path, est):
+                return False, f'symlink forbidden inside seed: {entry.path}', total_bytes
+            if stat.S_ISDIR(est.st_mode):
+                # Re-stat directories via os.lstat: Windows DirEntry.stat(follow_symlinks=False)
+                # returns (0, 0) for st_dev/st_ino from WIN32_FIND_DATA.
+                try:
+                    lst = os.lstat(entry.path)
+                except OSError as exc:
+                    return False, f'cannot stat {entry.path}: {exc}', total_bytes
+                if _is_symlink_or_reparse(entry.path, lst):
+                    return False, f'symlink forbidden inside seed: {entry.path}', total_bytes
+                if not stat.S_ISDIR(lst.st_mode):
+                    return False, f'special file forbidden inside seed: {entry.path}', total_bytes
+                key = _dir_loop_key(entry.path, lst)
+                if key in visited:
+                    return False, f'directory loop inside seed: {entry.path}', total_bytes
+                visited.add(key)
+                stack.append(entry.path)
+            elif stat.S_ISREG(est.st_mode):
+                if est.st_size > SEED_MAX_BYTES - total_bytes:
+                    return False, f'seed exceeds byte quota ({SEED_MAX_BYTES})', total_bytes
+                total_bytes += est.st_size
+            else:
+                return False, f'special file forbidden inside seed: {entry.path}', total_bytes
+    return True, None, total_bytes
+
+
+def _dir_has_visible_files(path):
+    if not os.path.isdir(path) or os.path.islink(path):
+        return False
+    stack = [path]
+    while stack:
+        cur = stack.pop()
+        try:
+            with os.scandir(cur) as it:
+                for entry in it:
+                    if entry.name.startswith('.') or '.tmp' in entry.name:
+                        continue
+                    if entry.is_symlink():
+                        return False
+                    if entry.is_file(follow_symlinks=False):
+                        return True
+                    if entry.is_dir(follow_symlinks=False):
+                        stack.append(entry.path)
+        except OSError:
+            return False
+    return False
+
+
+def _normalize_romfs_identity(val):
+    if val is None:
+        return None
+    if isinstance(val, dict):
+        if 'size' not in val or 'index' not in val:
+            return None
+        title = str(val.get('title', '')).strip()
+        ver = str(val.get('version', '')).strip()
+        build = str(val.get('build', '')).strip()
+        return f"{romfs_image.ID_MAGIC} title={title} version={ver} build={build} size={int(val['size'])} index={val['index']}"
+    s = str(val).strip()
+    if not s:
+        return None
+    romfs_image.parse_identity(s)
+    return s
+
+
+def _utc_now_iso():
+    return datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
+
+
+def _highest_version_dir(extract_root, allow_patched=False):
+    if not extract_root or not os.path.isdir(extract_root) or os.path.islink(extract_root):
+        return None, None
+    best = None
+    try:
+        with os.scandir(extract_root) as it:
+            for entry in it:
+                if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
+                    continue
+                m = _VER_RE.fullmatch(entry.name)
+                if m and os.path.isdir(os.path.join(entry.path, 'ExeFS')):
+                    ver_num = int(m.group(1))
+                    if best is None or ver_num > best[0]:
+                        best = (ver_num, entry.name, entry.path)
+    except OSError:
+        return None, None
+    if best is not None:
+        return best[1], best[2]
+    if allow_patched:
+        try:
+            with os.scandir(extract_root) as it:
+                for entry in it:
+                    if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
+                        continue
+                    if entry.name.startswith('patched_v'):
+                        m = _VER_RE.fullmatch(entry.name[len('patched_'):])
+                        if m:
+                            ver_num = int(m.group(1))
+                            if best is None or ver_num > best[0]:
+                                best = (ver_num, entry.name[len('patched_'):], entry.path)
+        except OSError:
+            return None, None
+        if best is not None:
+            return best[1], best[2]
+    return None, None
+
+
+class _CompressStopped(Exception):
+    """Internal control-flow signal raised when SIGTERM/SIGINT interrupts seed compression."""
+
+
+class _CompressStopController:
+    """Tracks cooperative stop state, active subprocess, and temporary file cleanup on signals."""
+
+    def __init__(self):
+        self.stopped = False
+        self._lock = threading.Lock()
+        self._proc = None
+        self._tmp_paths = set()
+
+    def request_stop(self):
+        with self._lock:
+            self.stopped = True
+            proc = self._proc
+        if proc is not None:
+            try:
+                proc.terminate()
+            except OSError:
+                pass
+
+    def check(self):
+        if self.stopped:
+            raise _CompressStopped('seed compression interrupted')
+
+    def set_proc(self, proc):
+        with self._lock:
+            self._proc = proc
+            stopped = self.stopped
+        if stopped and proc is not None:
+            try:
+                proc.terminate()
+            except OSError:
+                pass
+
+    def add_tmp(self, path):
+        with self._lock:
+            self._tmp_paths.add(path)
+
+    def discard_tmp(self, path):
+        with self._lock:
+            self._tmp_paths.discard(path)
+
+    def cleanup_tmps(self):
+        with self._lock:
+            paths = list(self._tmp_paths)
+            self._tmp_paths.clear()
+        for p in paths:
+            try:
+                if os.path.lexists(p) and not os.path.islink(p):
+                    os.unlink(p)
+            except OSError:
+                pass
+
+
+def _find_zstd_cli():
+    return shutil.which('zstd')
+
+
+def _zstd_backend():
+    """Returns ('pep784'|'zstandard'|'cli', handle) in priority order, or None."""
+    for mod_name in ('compression.zstd', 'backports.zstd'):
+        try:
+            mod = importlib.import_module(mod_name)
+            if hasattr(mod, 'ZstdFile') or hasattr(mod, 'open'):
+                return ('pep784', mod)
+        except ImportError:
+            continue
+    try:
+        mod = importlib.import_module('zstandard')
+        if hasattr(mod, 'ZstdCompressor') and hasattr(mod, 'ZstdDecompressor'):
+            return ('zstandard', mod)
+    except ImportError:
+        pass
+    cli = _find_zstd_cli()
+    if cli:
+        return ('cli', cli)
+    return None
+
+
+def zstd_available():
+    """Returns True if any streaming zstd compressor/decompressor backend is available."""
+    return _zstd_backend() is not None
+
+
+def _open_regular_nofollow(path):
+    """Opens a regular file without following symlinks, verifying non-reparse regular file."""
+    p = os.fspath(path)
+    st = os.lstat(p)
+    if _is_symlink_or_reparse(p, st):
+        raise ValueError(f'symlink forbidden: {p}')
+    if not stat.S_ISREG(st.st_mode):
+        raise ValueError(f'non-regular file forbidden: {p}')
+    flags = os.O_RDONLY | getattr(os, 'O_BINARY', 0) | getattr(os, 'O_NOFOLLOW', 0)
+    fd = os.open(p, flags)
+    try:
+        fst = os.fstat(fd)
+        if not stat.S_ISREG(fst.st_mode):
+            raise ValueError(f'non-regular file forbidden: {p}')
+        return os.fdopen(fd, 'rb'), fst
+    except BaseException:
+        try:
+            os.close(fd)
+        except OSError:
+            pass
+        raise
+
+
+def _zstd_prepare_output_path(dst_tmp_path, level):
+    if isinstance(level, bool) or not isinstance(level, int) or not (1 <= level <= 22):
+        raise ValueError(f'invalid zstd compression level: {level!r}')
+    backend = _zstd_backend()
+    if backend is None:
+        raise RuntimeError('zstd compression is unavailable')
+    dst_p = os.fspath(dst_tmp_path)
+    if os.path.lexists(dst_p):
+        if os.path.islink(dst_p) or os.path.isdir(dst_p):
+            raise ValueError(f'unsafe temporary output path: {dst_p}')
+        os.unlink(dst_p)
+    return backend, dst_p
+
+
+def _zstd_write_python_chunks(kind, handle, dst_p, chunk_iter, level, stop_ctrl=None):
+    with open(dst_p, 'wb') as raw_out:
+        if kind == 'pep784':
+            zfile_cls = getattr(handle, 'ZstdFile', None) or handle.open
+            with zfile_cls(raw_out, 'wb', level=level) as zout:
+                for chunk in chunk_iter:
+                    if stop_ctrl is not None:
+                        stop_ctrl.check()
+                    if chunk:
+                        zout.write(chunk)
+        else:
+            cctx = handle.ZstdCompressor(level=level)
+            with cctx.stream_writer(raw_out, closefd=False) as writer:
+                for chunk in chunk_iter:
+                    if stop_ctrl is not None:
+                        stop_ctrl.check()
+                    if chunk:
+                        writer.write(chunk)
+        raw_out.flush()
+        os.fsync(raw_out.fileno())
+
+
+def _zstd_compress_chunks(chunk_iter, dst_tmp_path, level=3, stop_ctrl=None):
+    """Streams chunks from chunk_iter directly through zstd compression into dst_tmp_path."""
+    backend, dst_p = _zstd_prepare_output_path(dst_tmp_path, level)
+    kind, handle = backend
+    if stop_ctrl is not None:
+        stop_ctrl.add_tmp(dst_p)
+    try:
+        if kind == 'cli':
+            if stop_ctrl is not None:
+                stop_ctrl.check()
+            cmd = [handle, f'-{level}', '-q', '-f', '-o', dst_p, '-']
+            popen_kw = {}
+            if os.name == 'nt':
+                popen_kw['creationflags'] = getattr(subprocess, 'CREATE_NO_WINDOW', 0x08000000)
+            proc = subprocess.Popen(
+                cmd,
+                stdin=subprocess.PIPE,
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.PIPE,
+                **popen_kw,
+            )
+            if stop_ctrl is not None:
+                stop_ctrl.set_proc(proc)
+            try:
+                try:
+                    for chunk in chunk_iter:
+                        if stop_ctrl is not None:
+                            stop_ctrl.check()
+                        if chunk:
+                            proc.stdin.write(chunk)
+                    proc.stdin.close()
+                    proc.stdin = None
+                except BrokenPipeError:
+                    pass
+                while True:
+                    if stop_ctrl is not None and stop_ctrl.stopped:
+                        proc.terminate()
+                        try:
+                            proc.wait(timeout=2)
+                        except subprocess.TimeoutExpired:
+                            proc.kill()
+                            proc.wait(timeout=2)
+                        raise _CompressStopped('seed compression interrupted')
+                    try:
+                        rc = proc.wait(timeout=0.05)
+                        break
+                    except subprocess.TimeoutExpired:
+                        continue
+                err = proc.stderr.read() if proc.stderr else b''
+                if stop_ctrl is not None:
+                    stop_ctrl.check()
+                if rc != 0:
+                    raise OSError(f'zstd CLI compression failed (rc={rc}): {err.decode("utf-8", "replace").strip()}')
+            except BaseException:
+                if proc.poll() is None:
+                    proc.terminate()
+                    try:
+                        proc.wait(timeout=2)
+                    except subprocess.TimeoutExpired:
+                        proc.kill()
+                        proc.wait(timeout=2)
+                raise
+            finally:
+                if proc.stdin:
+                    try:
+                        proc.stdin.close()
+                    except OSError:
+                        pass
+                if proc.stderr:
+                    proc.stderr.close()
+                if stop_ctrl is not None:
+                    stop_ctrl.set_proc(None)
+        else:
+            _zstd_write_python_chunks(kind, handle, dst_p, chunk_iter, level, stop_ctrl=stop_ctrl)
+    except BaseException:
+        try:
+            if os.path.lexists(dst_p) and not os.path.islink(dst_p):
+                os.unlink(dst_p)
+        except OSError:
+            pass
+        if stop_ctrl is not None:
+            stop_ctrl.discard_tmp(dst_p)
+        raise
+
+
+def _zstd_compress_stream(src_path, dst_tmp_path, level=3, stop_ctrl=None):
+    """Streams src_path through zstd compression into dst_tmp_path using bounded chunks."""
+    backend, dst_p = _zstd_prepare_output_path(dst_tmp_path, level)
+    kind, handle = backend
+    if stop_ctrl is not None:
+        stop_ctrl.add_tmp(dst_p)
+    try:
+        fin, _ = _open_regular_nofollow(src_path)
+        if kind == 'cli':
+            fin.close()
+            if stop_ctrl is not None:
+                stop_ctrl.check()
+            cmd = [handle, f'-{level}', '-q', '-f', '-o', dst_p, '--', os.fspath(src_path)]
+            popen_kw = {}
+            if os.name == 'nt':
+                popen_kw['creationflags'] = getattr(subprocess, 'CREATE_NO_WINDOW', 0x08000000)
+            proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, **popen_kw)
+            if stop_ctrl is not None:
+                stop_ctrl.set_proc(proc)
+            try:
+                while True:
+                    if stop_ctrl is not None and stop_ctrl.stopped:
+                        proc.terminate()
+                        try:
+                            proc.wait(timeout=2)
+                        except subprocess.TimeoutExpired:
+                            proc.kill()
+                            proc.wait(timeout=2)
+                        raise _CompressStopped('seed compression interrupted')
+                    try:
+                        rc = proc.wait(timeout=0.05)
+                        break
+                    except subprocess.TimeoutExpired:
+                        continue
+                err = proc.stderr.read() if proc.stderr else b''
+                if stop_ctrl is not None:
+                    stop_ctrl.check()
+                if rc != 0:
+                    raise OSError(f'zstd CLI compression failed (rc={rc}): {err.decode("utf-8", "replace").strip()}')
+            finally:
+                if proc.stderr:
+                    proc.stderr.close()
+                if stop_ctrl is not None:
+                    stop_ctrl.set_proc(None)
+        else:
+            with fin:
+                _zstd_write_python_chunks(
+                    kind,
+                    handle,
+                    dst_p,
+                    iter(lambda: fin.read(_ZSTD_CHUNK), b''),
+                    level,
+                    stop_ctrl=stop_ctrl,
+                )
+    except BaseException:
+        try:
+            if os.path.lexists(dst_p) and not os.path.islink(dst_p):
+                os.unlink(dst_p)
+        except OSError:
+            pass
+        if stop_ctrl is not None:
+            stop_ctrl.discard_tmp(dst_p)
+        raise
+
+
+def _zstd_verify_and_decompress_stream(
+    src_zst_path,
+    dst_path=None,
+    expected_size=None,
+    expected_magic=None,
+    max_bytes=SEED_MAX_BYTES,
+    stop_ctrl=None,
+    allow_trailer=False,
+):
+    """Streams and verifies a zstd archive, optionally writing the decompressed output atomically."""
+    backend = _zstd_backend()
+    if backend is None:
+        raise RuntimeError('zstd decompression is unavailable')
+    kind, handle = backend
+
+    fin, fst = _open_regular_nofollow(src_zst_path)
+    if fst.st_size == 0:
+        fin.close()
+        raise ValueError(f'empty zstd archive: {src_zst_path}')
+
+    dst_p = os.fspath(dst_path) if dst_path is not None else None
+    tmp_dst = None
+    out_f = None
+    if dst_p is not None:
+        parent = os.path.dirname(os.path.abspath(dst_p))
+        if os.path.islink(parent):
+            fin.close()
+            raise ValueError(f'symlink parent forbidden: {parent}')
+        os.makedirs(parent, exist_ok=True)
+        tmp_dst = f'{dst_p}.part.{os.getpid()}'
+        if os.path.islink(tmp_dst):
+            fin.close()
+            raise ValueError(f'symlink temporary path forbidden: {tmp_dst}')
+        out_f = open(tmp_dst, 'wb')
+
+    total = 0
+    head_buf = bytearray()
+    magic_len = len(expected_magic) if expected_magic else 0
+    check_romfs_head = (expected_magic == romfs_image.MAGIC)
+    capture_len = romfs.HEAD.size if check_romfs_head else magic_len
+    romfs_head = None
+    try:
+        def _consume(chunk):
+            nonlocal total, romfs_head
+            if stop_ctrl is not None:
+                stop_ctrl.check()
+            if max_bytes is not None and len(chunk) > max_bytes - total:
+                raise ValueError(f'decompressed zstd payload exceeds byte quota ({max_bytes} bytes): {src_zst_path}')
+            if capture_len and len(head_buf) < capture_len:
+                need = capture_len - len(head_buf)
+                prev_len = len(head_buf)
+                head_buf.extend(chunk[:need])
+                if magic_len and prev_len < magic_len <= len(head_buf) and bytes(head_buf[:magic_len]) != expected_magic:
+                    raise ValueError(f'invalid decompressed magic in {src_zst_path}: expected {expected_magic!r}')
+                if check_romfs_head and romfs_head is None and len(head_buf) == romfs.HEAD.size:
+                    magic, off, size, count = romfs.HEAD.unpack(bytes(head_buf[:romfs.HEAD.size]))
+                    if (
+                        magic != romfs_image.MAGIC
+                        or not (0 < count <= 0xffffffff)
+                        or count > SEED_MAX_ENTRIES + 1
+                        or off < romfs.HEAD.size
+                        or size < count * romfs.ENT.size
+                    ):
+                        raise ValueError(f'truncated or invalid RomFS header bounds in decompressed {src_zst_path}')
+                    if max_bytes is not None and (off > max_bytes or size > max_bytes - off):
+                        raise ValueError(
+                            f'decompressed zstd payload exceeds byte quota ({max_bytes} bytes): {src_zst_path}'
+                        )
+                    declared_end = off + size
+                    if dst_p is not None:
+                        try:
+                            free_b = shutil.disk_usage(os.path.dirname(os.path.abspath(dst_p))).free
+                        except OSError:
+                            free_b = None
+                        if free_b is not None and declared_end > free_b:
+                            raise OSError(
+                                errno.ENOSPC,
+                                f'insufficient disk space for {src_zst_path}: {free_b} bytes free, need {declared_end} bytes',
+                            )
+                    romfs_head = (off, size, count, declared_end)
+            if romfs_head is not None and not allow_trailer:
+                declared_end = romfs_head[3]
+                if len(chunk) > declared_end - total:
+                    raise ValueError(
+                        f'decompressed zstd payload exceeds declared RomFS bounds ({declared_end} bytes): {src_zst_path}'
+                    )
+            total += len(chunk)
+            if out_f is not None:
+                out_f.write(chunk)
+
+        if kind == 'cli':
+            fin.close()
+            if stop_ctrl is not None:
+                stop_ctrl.check()
+            popen_kw = {}
+            if os.name == 'nt':
+                popen_kw['creationflags'] = getattr(subprocess, 'CREATE_NO_WINDOW', 0x08000000)
+            proc = subprocess.Popen(
+                [handle, '-d', '-q', '-c', '--', os.fspath(src_zst_path)],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                **popen_kw,
+            )
+            if stop_ctrl is not None:
+                stop_ctrl.set_proc(proc)
+            try:
+                while True:
+                    if stop_ctrl is not None and stop_ctrl.stopped:
+                        proc.terminate()
+                        raise _CompressStopped('seed decompression interrupted')
+                    chunk = proc.stdout.read(_ZSTD_CHUNK)
+                    if not chunk:
+                        break
+                    _consume(chunk)
+                err = proc.stderr.read() if proc.stderr else b''
+                rc = proc.wait()
+                if stop_ctrl is not None:
+                    stop_ctrl.check()
+                if rc != 0:
+                    raise ValueError(
+                        f'corrupt or truncated zstd stream {src_zst_path} (rc={rc}): '
+                        f'{err.decode("utf-8", "replace").strip()}'
+                    )
+            except BaseException:
+                if proc.poll() is None:
+                    proc.terminate()
+                    try:
+                        proc.wait(timeout=2)
+                    except subprocess.TimeoutExpired:
+                        proc.kill()
+                        proc.wait(timeout=2)
+                raise
+            finally:
+                if proc.stdout:
+                    proc.stdout.close()
+                if proc.stderr:
+                    proc.stderr.close()
+                if stop_ctrl is not None:
+                    stop_ctrl.set_proc(None)
+        elif kind == 'pep784':
+            with fin:
+                zfile_cls = getattr(handle, 'ZstdFile', None) or handle.open
+                with zfile_cls(fin, 'rb') as zin:
+                    while True:
+                        chunk = zin.read(_ZSTD_CHUNK)
+                        if not chunk:
+                            break
+                        _consume(chunk)
+        else:
+            with fin:
+                dctx = handle.ZstdDecompressor()
+                with dctx.stream_reader(fin, read_across_frames=True, closefd=False) as reader:
+                    while True:
+                        chunk = reader.read(_ZSTD_CHUNK)
+                        if not chunk:
+                            break
+                        _consume(chunk)
+
+        if magic_len and bytes(head_buf[:magic_len]) != expected_magic:
+            raise ValueError(f'truncated header in decompressed {src_zst_path}')
+        if check_romfs_head:
+            if len(head_buf) < romfs.HEAD.size or romfs_head is None:
+                raise ValueError(f'truncated RomFS header in decompressed {src_zst_path}')
+            off, size, count, declared_end = romfs_head
+            if (
+                off > total
+                or size > total - off
+                or count > size // romfs.ENT.size
+                or (not allow_trailer and total != declared_end)
+            ):
+                raise ValueError(f'truncated or invalid RomFS header bounds in decompressed {src_zst_path}')
+        if expected_size is not None and total != expected_size:
+            raise ValueError(
+                f'decompressed size mismatch for {src_zst_path}: got {total} bytes, expected {expected_size}'
+            )
+
+        if out_f is not None:
+            out_f.flush()
+            out_f.close()
+            out_f = None
+            os.replace(tmp_dst, dst_p)
+            tmp_dst = None
+        return total
+    except BaseException:
+        if out_f is not None:
+            try:
+                out_f.close()
+            except OSError:
+                pass
+        if tmp_dst and os.path.lexists(tmp_dst):
+            try:
+                os.unlink(tmp_dst)
+            except OSError:
+                pass
+        raise
+
+
+def _lib_folder_of(lib):
+    s = os.fspath(lib)
+    if s.endswith('.img.zst'):
+        return s[:-8]
+    if s.endswith('.img'):
+        return s[:-4]
+    return s
+
+
+def _resolve_lib_for_read(lib_path, tmp_dir, quota):
+    """Resolves a shader library path preferring valid .img.zst over .img over folder.
+    Decompresses .img.zst into tmp_dir enforcing quota and DMROMFS1 + RomFS index validation."""
+    raw_p = os.fspath(lib_path)
+    folder = _lib_folder_of(raw_p)
+    zst_p = folder + '.img.zst'
+    img_p = folder + '.img'
+
+    for cand in (folder, img_p, zst_p):
+        if os.path.islink(cand) or _is_symlink_or_reparse(cand, os.lstat(cand) if os.path.lexists(cand) else None):
+            raise ValueError(f'symlink forbidden in shader library: {cand}')
+
+    if raw_p.endswith('.img.zst') or os.path.isfile(zst_p):
+        target_zst = raw_p if raw_p.endswith('.img.zst') else zst_p
+        if os.path.isfile(target_zst):
+            os.makedirs(tmp_dir, exist_ok=True)
+            fd, dec_img = tempfile.mkstemp(prefix='dec_', suffix='.img', dir=tmp_dir)
+            os.close(fd)
+            try:
+                budget = max(0, quota.max_bytes - quota.used_bytes)
+                _zstd_verify_and_decompress_stream(
+                    target_zst,
+                    dst_path=dec_img,
+                    expected_magic=romfs_image.MAGIC,
+                    max_bytes=budget,
+                )
+                romfs.Image(dec_img)
+                return dec_img
+            except BaseException:
+                try:
+                    if os.path.lexists(dec_img):
+                        os.unlink(dec_img)
+                except OSError:
+                    pass
+                if not raw_p.endswith('.img.zst') and os.path.isfile(img_p):
+                    return img_p
+                raise
+
+    if os.path.isfile(img_p):
+        return img_p
+    return raw_p
+
+
+@contextlib.contextmanager
+def _open_shader_lib_view(lib_path, quota):
+    """Context manager yielding a shader_lib.view(...) supporting .img.zst, .img, and folder."""
+    raw_p = os.fspath(lib_path)
+    folder = _lib_folder_of(raw_p)
+    zst_p = folder + '.img.zst'
+    if raw_p.endswith('.img.zst') or os.path.isfile(zst_p):
+        with tempfile.TemporaryDirectory(prefix='msl_zst_view_') as td:
+            resolved = _resolve_lib_for_read(raw_p, td, quota)
+            yield shader_lib.view(resolved)
+    else:
+        yield shader_lib.view(raw_p)
+
+
+def _stream_pack_shader_lib_to_zst(files_spec, zst_tmp_path, level=3):
+    """Streams a DMROMFS1 shader library directly into zstd without writing an uncompressed .img to disk."""
+    names = sorted(n.encode('utf-8') for n in files_spec)
+    ents = []
+    items = []
+    off = romfs.HEAD.size
+    for name_b in names:
+        name_s = name_b.decode('utf-8')
+        src_spec, expected_size = files_spec[name_s]
+        pad = -off % shader_lib.ALIGN
+        off += pad
+        ents.append((name_b, off, expected_size))
+        items.append((name_s, pad, src_spec, expected_size))
+        off += expected_size
+
+    pool = bytearray()
+    idx = bytearray(romfs.ENT.pack(1, len(names), 0, 0, 0, 0))
+    for name_b, a, b in ents:
+        idx += romfs.ENT.pack(a, b, len(pool), len(name_b), 1, 0)
+        pool += name_b
+
+    head_bytes = romfs.HEAD.pack(romfs.MAGIC, off, len(idx) + len(pool), len(names) + 1)
+    total_raw_size = off + len(idx) + len(pool)
+    img_paths = sorted({src._image.path for _, _, src, _ in items if isinstance(src, romfs._Entry)})
+
+    def _iter_chunks():
+        with romfs.reuse_descriptors(img_paths) if img_paths else contextlib.nullcontext():
+            yield head_bytes
+            for name_s, pad, src_spec, expected_size in items:
+                if pad:
+                    yield b'\0' * pad
+                if isinstance(src_spec, bytes):
+                    if len(src_spec) != expected_size:
+                        raise ValueError(f'size mismatch for {name_s}: expected {expected_size}, got {len(src_spec)}')
+                    if src_spec:
+                        yield src_spec
+                    continue
+                if isinstance(src_spec, romfs._Entry):
+                    fin = io.BufferedReader(romfs._File(src_spec._image, src_spec._k), _ZSTD_CHUNK)
+                else:
+                    fin, fst = _open_regular_nofollow(src_spec)
+                    if fst.st_size != expected_size:
+                        fin.close()
+                        raise ValueError(
+                            f'file changed while archiving {name_s}: expected {expected_size}, got {fst.st_size}'
+                        )
+                read_n = 0
+                with fin:
+                    while True:
+                        chunk = fin.read(_ZSTD_CHUNK)
+                        if not chunk:
+                            break
+                        read_n += len(chunk)
+                        if read_n > expected_size:
+                            raise ValueError(f'file grew while archiving {name_s}: expected {expected_size}')
+                        yield chunk
+                if read_n != expected_size:
+                    raise ValueError(
+                        f'file truncated while archiving {name_s}: expected {expected_size}, got {read_n}'
+                    )
+            yield bytes(idx)
+            if pool:
+                yield bytes(pool)
+
+    _zstd_compress_chunks(_iter_chunks(), zst_tmp_path, level=level)
+    return total_raw_size
+
+
+def _pack_metal_sources_one(src_lib_path, dst_img_path, quota, extra_lib_path=None):
+    """Packs a single b-<chain> folder, .img, or .img.zst into dst_img_path (.img.zst when zstd is
+    available, else .img), keeping *.metal/*.json/*.tsv and 0-byte *_bx/*_bf placeholders."""
+    sources = [src_lib_path]
+    if extra_lib_path:
+        sources.append(extra_lib_path)
+
+    files_spec = {}
+    with contextlib.ExitStack() as stack:
+        for cur_src in sources:
+            folder = _lib_folder_of(os.fspath(cur_src))
+            img_file = folder + '.img'
+            zst_file = folder + '.img.zst'
+            for cand in (folder, img_file, zst_file):
+                if os.path.islink(cand) or _is_symlink_or_reparse(cand, os.lstat(cand) if os.path.lexists(cand) else None):
+                    raise ValueError(f'symlink forbidden in Mac shader cache: {cur_src}')
+            if os.path.isdir(folder):
+                with os.scandir(folder) as it:
+                    for entry in it:
+                        if entry.is_symlink() or _is_symlink_or_reparse(entry.path):
+                            raise ValueError(f'symlink forbidden in Mac shader folder: {entry.path}')
+                        if not entry.name.startswith('.') and '.tmp' not in entry.name:
+                            _validate_rel_path(entry.name, folder)
+
+            lib = stack.enter_context(_open_shader_lib_view(cur_src, quota))
+            if not lib.is_dir():
+                continue
+            with romfs.os.scandir(lib) as it:
+                dir_entries = sorted(it, key=lambda e: e.name)
+            for entry in dir_entries:
+                name = entry.name
+                if name.startswith('.') or '.tmp' in name or name in files_spec:
+                    continue
+                _validate_rel_path(name, str(cur_src))
+                if '/' in name:
+                    raise ValueError(f'nested path forbidden inside shader library: {name}')
+                if not isinstance(entry, romfs._Entry):
+                    if entry.is_symlink() or _is_symlink_or_reparse(entry.path):
+                        raise ValueError(f'symlink forbidden in Mac shader folder: {entry.path}')
+                est = entry.stat(follow_symlinks=False)
+                if not isinstance(entry, romfs._Entry) and _is_symlink_or_reparse(entry.path, est):
+                    raise ValueError(f'symlink forbidden in Mac shader folder: {entry.path}')
+                if not stat.S_ISREG(est.st_mode):
+                    raise ValueError(f'non-regular file forbidden in shader library: {entry.path}')
+                if name.endswith(('.metal', '.json', '.tsv')):
+                    fsize = est.st_size
+                    quota.charge(1, fsize, name)
+                    src_ref = entry if isinstance(entry, romfs._Entry) else entry.path
+                    files_spec[name] = (src_ref, fsize)
+                elif name.endswith(('_bx.metallib', '_bf.metallib')):
+                    quota.charge(1, 0, name)
+                    files_spec[name] = (b'', 0)
+        if not files_spec:
+            return False
+
+        dst_raw = os.fspath(dst_img_path)
+        if dst_raw.endswith('.img.zst'):
+            raw_target = dst_raw[:-4]
+            zst_target = dst_raw
+        else:
+            raw_target = dst_raw
+            zst_target = dst_raw + '.zst'
+
+        os.makedirs(os.path.dirname(raw_target), exist_ok=True)
+        if _zstd_backend() is not None:
+            zst_tmp = f'{zst_target}.tmp'
+            try:
+                raw_size = _stream_pack_shader_lib_to_zst(files_spec, zst_tmp, level=3)
+                _zstd_verify_and_decompress_stream(
+                    zst_tmp,
+                    dst_path=None,
+                    expected_size=raw_size,
+                    expected_magic=romfs_image.MAGIC,
+                    max_bytes=max(quota.max_bytes, raw_size),
+                )
+                os.replace(zst_tmp, zst_target)
+            finally:
+                try:
+                    if os.path.lexists(zst_tmp) and not os.path.islink(zst_tmp):
+                        os.unlink(zst_tmp)
+                except OSError:
+                    pass
+        else:
+            write_map = {
+                n: (src.path if isinstance(src, romfs._Entry) else src)
+                for n, (src, _sz) in files_spec.items()
+            }
+            shader_lib.write(write_map, raw_target)
+    return True
+
+
+def _discover_b_libs_in_dir(parent_dir, include_zst=False):
+    """Returns sorted unique b-<chain> base names present as folders, .img, or (optionally) .img.zst."""
+    if not parent_dir or not os.path.isdir(parent_dir) or os.path.islink(parent_dir):
+        return []
+    found = set()
+    with os.scandir(parent_dir) as it:
+        for entry in it:
+            if entry.is_symlink():
+                raise ValueError(f'symlink forbidden inside shader directory: {entry.path}')
+            if entry.name.startswith('.') or '.tmp' in entry.name:
+                continue
+            if entry.is_dir(follow_symlinks=False) and entry.name.startswith('b-'):
+                found.add(entry.name)
+            elif entry.is_file(follow_symlinks=False) and entry.name.startswith('b-'):
+                if entry.name.endswith('.img'):
+                    found.add(entry.name[:-4])
+                elif include_zst and entry.name.endswith('.img.zst'):
+                    found.add(entry.name[:-8])
+    return sorted(found)
+
+
+def _stage_metal_sources(mac_shader_dir, work_dir, chain, staging_dir, quota, extra_msl_dir=None, gfx_api='nvn'):
+    """Builds metal-sources/b-<chain>.img.zst (falling back to .img without zstd) inside staging_dir.
+    Returns inferred raw chain string if discovered."""
+    src = os.fspath(mac_shader_dir) if mac_shader_dir else os.path.join(work_dir, 'shader', 'cache')
+    if not src:
+        return _norm_chain(chain)
+    if os.path.islink(src):
+        raise ValueError(f'symlink forbidden for mac_shader_dir: {src}')
+
+    if gfx_api != 'nvn':
+        return ''
+
+    target_tag = _chain_tag(chain)
+    metal_out_root = os.path.join(staging_dir, 'metal-sources')
+    inferred_chain = _norm_chain(chain)
+
+    def _extra_for(b_tag):
+        if not extra_msl_dir or not os.path.isdir(extra_msl_dir) or os.path.islink(extra_msl_dir):
+            return None
+        cand = os.path.join(extra_msl_dir, b_tag)
+        if os.path.isdir(cand) or os.path.isfile(cand + '.img') or os.path.isfile(cand + '.img.zst'):
+            return cand
+        return None
+
+    # Case 1: src directly names a shader library (.img / .img.zst file, folder_of+.img, or flat library folder)
+    src_folder = _lib_folder_of(src)
+    src_base = os.path.basename(os.path.normpath(src_folder))
+    if (
+        os.path.isfile(src)
+        or os.path.isfile(src_folder + '.img')
+        or os.path.isfile(src_folder + '.img.zst')
+        or src_base.startswith('b-')
+    ):
+        out_tag = src_base if src_base.startswith('b-') else (target_tag or 'b-unknown')
+        if not inferred_chain and out_tag.startswith('b-'):
+            inferred_chain = _norm_chain(out_tag)
+        _pack_metal_sources_one(src, os.path.join(metal_out_root, f'{out_tag}.img'), quota, _extra_for(out_tag))
+        return inferred_chain
+
+    if not os.path.isdir(src):
+        return inferred_chain
+
+    # Check if src itself is a flat directory directly holding *.metal files (custom test fixture)
+    with os.scandir(src) as it:
+        entries = sorted(it, key=lambda e: e.name)
+    for entry in entries:
+        if entry.is_symlink():
+            raise ValueError(f'symlink forbidden in {src}: {entry.path}')
+    if any(e.is_file(follow_symlinks=False) and e.name.endswith('.metal') for e in entries):
+        out_tag = target_tag or 'b-default'
+        _pack_metal_sources_one(src, os.path.join(metal_out_root, f'{out_tag}.img'), quota, _extra_for(out_tag))
+        return inferred_chain
+
+    # Case 2: multi-program p<N>/ directories under src
+    prog_dirs = [e for e in entries if e.is_dir(follow_symlinks=False) and _PROG_RE.fullmatch(e.name)]
+    if prog_dirs:
+        for pe in prog_dirs:
+            b_names = _discover_b_libs_in_dir(pe.path, include_zst=True)
+            chosen = [target_tag] if (target_tag and target_tag in b_names) else b_names
+            for b_name in chosen:
+                if not inferred_chain:
+                    inferred_chain = _norm_chain(b_name)
+                _pack_metal_sources_one(
+                    os.path.join(pe.path, b_name),
+                    os.path.join(metal_out_root, pe.name, f'{b_name}.img'),
+                    quota,
+                )
+        return inferred_chain
+
+    # Case 3: parent cache directory containing b-<chain> folders and/or b-<chain>.img[.zst] files
+    b_names = set(_discover_b_libs_in_dir(src, include_zst=True))
+    if extra_msl_dir and os.path.isdir(extra_msl_dir) and not os.path.islink(extra_msl_dir):
+        b_names.update(_discover_b_libs_in_dir(extra_msl_dir, include_zst=True))
+    sorted_b = sorted(b_names)
+    chosen = [target_tag] if (target_tag and target_tag in sorted_b) else sorted_b
+    for b_name in chosen:
+        if not inferred_chain:
+            inferred_chain = _norm_chain(b_name)
+        _pack_metal_sources_one(
+            os.path.join(src, b_name),
+            os.path.join(metal_out_root, f'{b_name}.img'),
+            quota,
+            _extra_for(b_name),
+        )
+    return inferred_chain
+
+
+def _stage_shader_ios(ios_src_dir, chain, staging_dir, quota, gfx_api='nvn'):
+    """Stages shader/ios/ into staging_dir (packing loose b-<chain> folders into b-<chain>.img if needed)."""
+    dst_ios = os.path.join(staging_dir, 'shader', 'ios')
+    os.makedirs(dst_ios, exist_ok=True)
+    inferred_chain = _norm_chain(chain)
+    if not ios_src_dir or not os.path.exists(ios_src_dir):
+        return inferred_chain
+    if os.path.islink(ios_src_dir):
+        raise ValueError(f'symlink forbidden for shader/ios source: {ios_src_dir}')
+
+    if os.path.isfile(ios_src_dir):
+        base = os.path.basename(ios_src_dir)
+        _validate_rel_path(base, ios_src_dir)
+        if base.startswith('b-') and base.endswith('.img') and not inferred_chain:
+            inferred_chain = _norm_chain(base[:-4])
+        _link_or_copy_file(ios_src_dir, os.path.join(dst_ios, base), quota)
+        return inferred_chain
+
+    with os.scandir(ios_src_dir) as it:
+        entries = sorted(it, key=lambda e: e.name)
+
+    b_dirs = {}
+    b_imgs = {}
+    for entry in entries:
+        if entry.is_symlink():
+            raise ValueError(f'symlink forbidden inside shader/ios: {entry.path}')
+        name = entry.name
+        if name in ('.DS_Store',) or '.tmp' in name:
+            continue
+        _validate_rel_path(name, ios_src_dir)
+        if entry.is_dir(follow_symlinks=False) and name.startswith('b-'):
+            b_dirs[name] = entry.path
+        elif entry.is_file(follow_symlinks=False) and name.startswith('b-') and name.endswith('.img'):
+            b_imgs[name[:-4]] = entry.path
+        elif entry.is_dir(follow_symlinks=False):
+            if _PROG_RE.fullmatch(name) and not inferred_chain:
+                sub_b = _discover_b_libs_in_dir(entry.path)
+                if sub_b:
+                    inferred_chain = _norm_chain(sub_b[0])
+            _stage_tree(entry.path, os.path.join(dst_ios, name), quota, allow_subdirs=True)
+        elif entry.is_file(follow_symlinks=False):
+            _link_or_copy_file(entry.path, os.path.join(dst_ios, name), quota)
+
+    if gfx_api != 'nvn':
+        return ''
+
+    target_tag = _chain_tag(chain)
+    all_b = sorted(set(b_dirs) | set(b_imgs))
+    chosen_b = [target_tag] if (target_tag and target_tag in all_b) else all_b
+    for b_name in chosen_b:
+        if not inferred_chain:
+            inferred_chain = _norm_chain(b_name)
+        if b_name in b_imgs and b_name not in b_dirs:
+            _link_or_copy_file(b_imgs[b_name], os.path.join(dst_ios, f'{b_name}.img'), quota)
+        else:
+            # Merge folder + optional sibling .img into compact b-<chain>.img inside seed
+            lib = shader_lib.view(os.path.join(ios_src_dir, b_name))
+            files_map = {}
+            if b_name in b_dirs:
+                with os.scandir(b_dirs[b_name]) as sub_it:
+                    for sub_e in sub_it:
+                        if sub_e.is_symlink():
+                            raise ValueError(f'symlink forbidden in {b_dirs[b_name]}: {sub_e.path}')
+                        if not sub_e.name.startswith('.') and '.tmp' not in sub_e.name:
+                            _validate_rel_path(sub_e.name, b_dirs[b_name])
+            with romfs.os.scandir(lib) as sub_it:
+                ios_entries = sorted(sub_it, key=lambda e: e.name)
+            for entry in ios_entries:
+                fname = entry.name
+                if fname.startswith('.') or '.tmp' in fname:
+                    continue
+                _validate_rel_path(fname, b_name)
+                if not isinstance(entry, romfs._Entry) and (entry.is_symlink() or _is_symlink_or_reparse(entry.path)):
+                    raise ValueError(f'symlink forbidden in {b_name}: {entry.path}')
+                est = entry.stat(follow_symlinks=False)
+                if not isinstance(entry, romfs._Entry) and _is_symlink_or_reparse(entry.path, est):
+                    raise ValueError(f'symlink forbidden in {b_name}: {entry.path}')
+                if not stat.S_ISREG(est.st_mode):
+                    raise ValueError(f'non-regular file forbidden in {b_name}: {entry.path}')
+                quota.charge(1, est.st_size, fname)
+                files_map[fname] = entry.path
+            if files_map:
+                shader_lib.write(files_map, os.path.join(dst_ios, f'{b_name}.img'))
+    return inferred_chain
+
+
+def _read_game_tsv_kv(tsv_path):
+    kv = {}
+    if not tsv_path or not os.path.isfile(tsv_path) or os.path.islink(tsv_path):
+        return kv
+    try:
+        with open(tsv_path, 'r', encoding='utf-8', errors='replace') as f:
+            lines = f.read().splitlines()
+    except OSError:
+        return kv
+    kv['_header'] = '\n'.join(lines[:5])
+    for line in lines:
+        if not line or line.startswith('#'):
+            continue
+        parts = line.split('\t', 1)
+        if len(parts) == 2:
+            k, v = parts[0].strip(), parts[1].strip()
+            if k not in kv:
+                kv[k] = v
+    return kv
+
+
+def _read_game_tsv_build_versions(tsv_path):
+    """Extracts all build version keys (e.g. {'v0', 'v851968'}) from a game.tsv file."""
+    versions = set()
+    if not tsv_path or not os.path.isfile(tsv_path) or os.path.islink(tsv_path):
+        return versions
+    try:
+        with open(tsv_path, 'r', encoding='utf-8', errors='replace') as f:
+            for line in f:
+                if not line.strip() or line.lstrip().startswith('#'):
+                    continue
+                parts = line.split('\t')
+                if len(parts) >= 2 and parts[0].strip() == 'build':
+                    ver = parts[1].strip()
+                    if ver:
+                        versions.add(ver)
+    except OSError:
+        pass
+    return versions
+
+
+def _find_registered_profile_dir(tid, profile_id=''):
+    games_dir = os.path.join(_REPO_ROOT, 'dm', 'games')
+    if not os.path.isdir(games_dir):
+        return None, None
+    if profile_id:
+        cand = os.path.join(games_dir, profile_id)
+        if os.path.isdir(cand) and os.path.isfile(os.path.join(cand, 'game.tsv')):
+            return profile_id, cand
+    try:
+        with os.scandir(games_dir) as it:
+            for entry in sorted(it, key=lambda e: e.name):
+                if not entry.is_dir(follow_symlinks=False) or entry.name.startswith('.'):
+                    continue
+                tsv = os.path.join(entry.path, 'game.tsv')
+                kv = _read_game_tsv_kv(tsv)
+                if kv.get('title_id', '').strip().upper() == tid:
+                    return entry.name, entry.path
+    except OSError:
+        pass
+    return None, None
+
+
+def _has_valid_nvn_lib(dir_path):
+    if not dir_path or not os.path.isdir(dir_path) or os.path.islink(dir_path):
+        return False
+    for b_tag in _discover_b_libs_in_dir(dir_path):
+        if shader_lib.has_library(os.path.join(dir_path, b_tag)):
+            return True
+    return False
+
+
+def _infer_gfx_api(
+    explicit_api='',
+    prof_kv=None,
+    exefs_dir=None,
+    shader_dirs=(),
+    ios_dirs=(),
+    capture_roots=(),
+    profile_dirs=(),
+):
+    """Infers 'nvn', 'vulkan', or 'gl' from build artifacts, profile capture tables, or ExeFS symbols."""
+    raw = str(explicit_api or (prof_kv or {}).get('gfx_api') or '').strip().lower()
+    if raw in ('vulkan', 'gl'):
+        return raw
+
+    for d in ios_dirs:
+        if d and os.path.isfile(os.path.join(d, 'vk', 'vk_shaders.metallib')):
+            return 'vulkan'
+        if d and os.path.isfile(os.path.join(d, 'gl', 'gl_shaders.metallib')):
+            return 'gl'
+
+    for d in shader_dirs:
+        if d and os.path.isfile(os.path.join(d, 'vk', 'vk_shaders.metallib')):
+            return 'vulkan'
+        if d and os.path.isfile(os.path.join(d, 'gl', 'gl_shaders.metallib')):
+            return 'gl'
+
+    for c_root in capture_roots:
+        if c_root and _dir_has_visible_files(os.path.join(c_root, 'vk_capture')):
+            return 'vulkan'
+        if c_root and _dir_has_visible_files(os.path.join(c_root, 'gl_capture')):
+            return 'gl'
+
+    for p_dir in profile_dirs:
+        if p_dir and os.path.isfile(os.path.join(p_dir, 'vk_capture.tsv')):
+            return 'vulkan'
+        if p_dir and os.path.isfile(os.path.join(p_dir, 'gl_capture.tsv')):
+            return 'gl'
+
+    if any(_has_valid_nvn_lib(d) for d in list(ios_dirs) + list(shader_dirs)):
+        return 'nvn'
+
+    for d in shader_dirs:
+        if d and _dir_has_visible_files(os.path.join(d, 'pkg')):
+            return 'nvn'
+
+    main_path = os.path.join(exefs_dir, 'main') if exefs_dir else None
+    if main_path and os.path.isfile(main_path) and not os.path.islink(main_path):
+        try:
+            from dm.tools import nso as _nso_mod, nso_syms as _nso_syms
+            with open(main_path, 'rb') as mf:
+                raw_nso = mf.read()
+            if raw_nso[:4] == b'NSO0':
+                img = bytes(_nso_mod.load(raw_nso, main_path).image)
+                imports = {s for s, defined, _ in _nso_syms.dynsyms(img) if not defined}
+                vk = sum(1 for s in imports if re.match(r'vk[A-Z]', s) and s != 'vkGetInstanceProcAddr')
+                if vk > 0 and 'nvnBootstrapLoader' not in imports:
+                    return 'vulkan'
+                own_glslc = (
+                    'nvnBootstrapLoader' in imports
+                    and 'glslcCompile' in imports
+                    and bool(re.search(rb'#version [^\0]*\bvoid\s+main\s*\(', img))
+                )
+                if (
+                    'nvnBootstrapLoader' not in imports
+                    and 'eglCreateWindowSurface' in imports
+                    and b'glShaderSource' in img
+                    and not own_glslc
+                ):
+                    return 'gl'
+        except Exception:
+            pass
+
+    return raw if raw in ('nvn', 'vulkan', 'gl') else 'nvn'
+
+
+def _compute_inputs_digest(staging_dir, tid, pkg_ver, gfx_api, chain):
+    h = hashlib.sha256()
+    h.update(f'{tid}\0{pkg_ver}\0{gfx_api}\0{chain}\0'.encode('utf-8'))
+    exefs_dir = os.path.join(staging_dir, 'ExeFS')
+    if os.path.isdir(exefs_dir):
+        for name in sorted(os.listdir(exefs_dir)):
+            p = os.path.join(exefs_dir, name)
+            if os.path.isfile(p) and not os.path.islink(p):
+                st = os.stat(p)
+                h.update(f'exefs:{name}:{st.st_size}\0'.encode('utf-8'))
+                with open(p, 'rb') as f:
+                    h.update(f.read(65536))
+    return h.hexdigest()
+
+
+def inspect_seed(seed_dir_or_root, title_id=None):
+    """Validates a build seed directory and returns a structured status dict."""
+    base_arg = os.fspath(seed_dir_or_root)
+    expect_tid = None
+    if title_id is not None:
+        try:
+            expect_tid = _validate_title_id(title_id)
+        except ValueError as exc:
+            return {
+                'valid': False,
+                'reason': str(exc),
+                'seed': None,
+                'path': base_arg,
+                'size_bytes': 0,
+                'has_exefs': False,
+                'has_shader_pkg': False,
+                'has_shader_ios': False,
+                'has_metal_sources': False,
+                'has_tables': False,
+            }
+        cand_sub = os.path.join(base_arg, expect_tid)
+        if os.path.lexists(os.path.join(base_arg, 'seed.json')) and not os.path.lexists(cand_sub):
+            seed_dir = base_arg
+        else:
+            seed_dir = cand_sub
+    else:
+        seed_dir = base_arg
+
+    abs_path = os.path.abspath(seed_dir)
+    empty = {
+        'valid': False,
+        'reason': None,
+        'seed': None,
+        'path': abs_path,
+        'size_bytes': 0,
+        'has_exefs': False,
+        'has_shader_pkg': False,
+        'has_shader_ios': False,
+        'has_metal_sources': False,
+        'has_tables': False,
+    }
+
+    if not os.path.lexists(seed_dir):
+        empty['reason'] = f'seed directory does not exist: {abs_path}'
+        return empty
+
+    tree_ok, tree_reason, total_bytes = _verify_no_symlinks_or_unsafe_names(seed_dir)
+    empty['size_bytes'] = total_bytes
+    if not tree_ok:
+        empty['reason'] = tree_reason
+        return empty
+
+    seed_json_path = os.path.join(seed_dir, 'seed.json')
+    if not os.path.isfile(seed_json_path):
+        empty['reason'] = f'missing seed.json in {abs_path}'
+        return empty
+
+    try:
+        with open(seed_json_path, 'r', encoding='utf-8') as f:
+            seed = json.load(f)
+    except (OSError, ValueError) as exc:
+        empty['reason'] = f'invalid seed.json: {exc}'
+        return empty
+
+    if not isinstance(seed, dict):
+        empty['reason'] = 'seed.json root must be a JSON object'
+        return empty
+    if seed.get('schema') != SEED_SCHEMA_VERSION:
+        empty['reason'] = f'unsupported seed schema: {seed.get("schema")!r}'
+        return empty
+
+    try:
+        rec_tid = _validate_title_id(seed.get('title_id', ''))
+    except ValueError as exc:
+        empty['reason'] = str(exc)
+        empty['seed'] = seed
+        return empty
+
+    if expect_tid and rec_tid != expect_tid:
+        empty['reason'] = f'seed title_id {rec_tid} does not match expected {expect_tid}'
+        empty['seed'] = seed
+        return empty
+
+    dir_base = os.path.basename(abs_path)
+    if expect_tid is None and _TID_RE.fullmatch(dir_base.upper()) and dir_base.upper() != rec_tid:
+        empty['reason'] = f'seed directory {dir_base} does not match seed title_id {rec_tid}'
+        empty['seed'] = seed
+        return empty
+
+    exefs_dir = os.path.join(seed_dir, 'ExeFS')
+    pkg_dir = os.path.join(seed_dir, 'shader', 'pkg')
+    ios_dir = os.path.join(seed_dir, 'shader', 'ios')
+    metal_dir = os.path.join(seed_dir, 'metal-sources')
+    tables_dir = os.path.join(seed_dir, 'shader', 'tables')
+
+    has_exefs = _dir_has_visible_files(exefs_dir)
+    has_shader_pkg = _dir_has_visible_files(pkg_dir)
+    has_shader_ios = _dir_has_visible_files(ios_dir)
+    has_metal_sources = _dir_has_visible_files(metal_dir)
+    has_tables = (
+        os.path.isfile(os.path.join(tables_dir, 'c1_full.tsv'))
+        and os.path.isfile(os.path.join(tables_dir, 'cb_extent.tsv'))
+    )
+
+    gfx_api = str(seed.get('gfx_api') or 'nvn').strip().lower()
+    if gfx_api not in ('vulkan', 'gl'):
+        healed_api = _infer_gfx_api(
+            explicit_api=gfx_api,
+            exefs_dir=exefs_dir,
+            shader_dirs=(os.path.join(seed_dir, 'shader'),),
+            ios_dirs=(ios_dir,),
+            capture_roots=(os.path.join(seed_dir, 'captures'),),
+        )
+        if healed_api in ('vulkan', 'gl'):
+            gfx_api = healed_api
+            seed = dict(seed)
+            seed['gfx_api'] = healed_api
+            seed['chain'] = ''
+    reason = None
+    if not has_exefs:
+        reason = 'missing or empty ExeFS directory'
+    elif not os.path.isdir(pkg_dir):
+        reason = 'missing shader/pkg directory'
+    elif not os.path.isdir(ios_dir):
+        reason = 'missing shader/ios directory'
+    elif gfx_api == 'nvn' and not has_shader_ios and not has_metal_sources:
+        reason = 'seed has neither shader/ios outputs nor metal-sources'
+    elif gfx_api == 'nvn' and not has_tables:
+        reason = 'missing shader/tables/{c1_full.tsv, cb_extent.tsv}'
+
+    return {
+        'valid': reason is None,
+        'reason': reason,
+        'seed': seed,
+        'path': abs_path,
+        'size_bytes': total_bytes,
+        'has_exefs': has_exefs,
+        'has_shader_pkg': has_shader_pkg,
+        'has_shader_ios': has_shader_ios,
+        'has_metal_sources': has_metal_sources,
+        'has_tables': has_tables,
+    }
+
+
+def save_seed(
+    seed_root,
+    title_id,
+    meta,
+    work_dir,
+    mac_shader_dir=None,
+    profile_dir=None,
+    exefs_dir=None,
+    control_path=None,
+    icon_path=None,
+    html_dir=None,
+    jit_dir=None,
+    *,
+    _extra_ios_dir=None,
+    _extra_tables_dir=None,
+):
+    """Atomically stages, validates and publishes a Schema v1 build seed with rollback protection."""
+    tid = _validate_title_id(title_id)
+    root_path = os.fspath(seed_root)
+    work_path = os.fspath(work_dir)
+    if not root_path or '\0' in root_path:
+        raise ValueError('invalid seed_root')
+    if os.path.islink(root_path):
+        raise ValueError(f'seed_root must not be a symlink: {root_path}')
+    if os.path.exists(root_path) and not os.path.isdir(root_path):
+        raise ValueError(f'seed_root is not a directory: {root_path}')
+    if os.path.islink(work_path):
+        raise ValueError(f'work_dir must not be a symlink: {work_path}')
+
+    os.makedirs(root_path, exist_ok=True)
+    root_abs = os.path.abspath(root_path)
+    _sweep_stale_temp_dirs(root_abs, tid=tid)
+
+    meta_in = dict(meta or {})
+    pid = os.getpid()
+    staging_dir = os.path.join(root_abs, f'.{tid}.staging.{pid}')
+    old_dir = os.path.join(root_abs, f'.{tid}.old.{pid}')
+    target_dir = os.path.join(root_abs, tid)
+
+    if os.path.lexists(staging_dir):
+        if os.path.islink(staging_dir):
+            os.unlink(staging_dir)
+        else:
+            shutil.rmtree(staging_dir)
+
+    quota = _Quota()
+    had_backup = False
+    try:
+        os.makedirs(staging_dir, exist_ok=False)
+
+        # 1. Determine pkg_ver and version extraction folder
+        extract_root = os.path.join(work_path, 'extract')
+        disc_ver, disc_ver_dir = _highest_version_dir(extract_root, allow_patched=True)
+        pkg_ver = str(meta_in.get('pkg_ver') or disc_ver or 'v0').strip()
+        _validate_rel_path(pkg_ver, 'pkg_ver')
+        ver_dir = os.path.join(extract_root, pkg_ver)
+        if not os.path.isdir(ver_dir) and disc_ver_dir:
+            ver_dir = disc_ver_dir
+        base_extract_dir = os.path.join(extract_root, 'base')
+
+        # 2. Stage ExeFS/
+        eff_exefs = os.fspath(exefs_dir) if exefs_dir else None
+        if not eff_exefs:
+            for cand in (
+                os.path.join(ver_dir, 'ExeFS'),
+                os.path.join(work_path, 'ExeFS'),
+                os.path.join(base_extract_dir, 'ExeFS'),
+            ):
+                if os.path.isdir(cand):
+                    eff_exefs = cand
+                    break
+        if not eff_exefs or not os.path.isdir(eff_exefs):
+            raise ValueError(f'ExeFS directory not found for {tid} in {work_path}')
+        _stage_tree(eff_exefs, os.path.join(staging_dir, 'ExeFS'), quota, allow_subdirs=False)
+        if not _dir_has_visible_files(os.path.join(staging_dir, 'ExeFS')):
+            raise ValueError(f'ExeFS directory is empty: {eff_exefs}')
+
+        # 3. Stage optional control.nacp, icon.jpg, html/, jit/, and runtime captures
+        eff_control = os.fspath(control_path) if control_path else None
+        if not eff_control:
+            for cand in (
+                os.path.join(ver_dir, 'control.nacp'),
+                os.path.join(base_extract_dir, 'control.nacp'),
+                os.path.join(work_path, 'control.nacp'),
+            ):
+                if os.path.isfile(cand):
+                    eff_control = cand
+                    break
+        if eff_control and os.path.exists(eff_control):
+            _link_or_copy_file(eff_control, os.path.join(staging_dir, 'control.nacp'), quota)
+
+        eff_icon = os.fspath(icon_path) if icon_path else None
+        if not eff_icon:
+            for cand in (
+                os.path.join(ver_dir, 'icon.jpg'),
+                os.path.join(base_extract_dir, 'icon.jpg'),
+                os.path.join(work_path, 'icon.jpg'),
+            ):
+                if os.path.isfile(cand):
+                    eff_icon = cand
+                    break
+        has_icon = False
+        if eff_icon and os.path.exists(eff_icon):
+            _link_or_copy_file(eff_icon, os.path.join(staging_dir, 'icon.jpg'), quota)
+            has_icon = True
+
+        eff_html = os.fspath(html_dir) if html_dir else None
+        if not eff_html:
+            for cand in (
+                os.path.join(ver_dir, 'html'),
+                os.path.join(base_extract_dir, 'html'),
+                os.path.join(work_path, 'html'),
+            ):
+                if os.path.isdir(cand):
+                    eff_html = cand
+                    break
+        has_html = False
+        if eff_html and os.path.exists(eff_html) and _dir_has_visible_files(eff_html):
+            _stage_tree(eff_html, os.path.join(staging_dir, 'html'), quota, allow_subdirs=True)
+            has_html = True
+
+        eff_jit = os.fspath(jit_dir) if jit_dir else None
+        if not eff_jit:
+            for cand in (os.path.join(ver_dir, 'jit'), os.path.join(work_path, 'jit')):
+                if os.path.isdir(cand):
+                    eff_jit = cand
+                    break
+        has_jit_dir = False
+        if eff_jit and os.path.exists(eff_jit) and _dir_has_visible_files(eff_jit):
+            _stage_tree(eff_jit, os.path.join(staging_dir, 'jit'), quota, allow_subdirs=True)
+            has_jit_dir = True
+
+        for cap_name in _OPTIONAL_CAPTURE_DIRS:
+            cap_src = os.path.join(ver_dir, cap_name)
+            if os.path.isdir(cap_src) and _dir_has_visible_files(cap_src):
+                _stage_tree(cap_src, os.path.join(staging_dir, 'captures', cap_name), quota, allow_subdirs=True)
+
+        # 4. Discover / stage optional derived or provisional profile/<gid>/
+        profile_id = str(meta_in.get('profile_id') or '').strip()
+        profile_kind = str(meta_in.get('profile_kind') or '').strip()
+        explicit_profile_dir = os.fspath(profile_dir) if profile_dir else None
+        eff_profile_dir = explicit_profile_dir
+        discovered_work_prof = False
+        if not eff_profile_dir and profile_kind != 'registered':
+            work_prof_root = os.path.join(work_path, 'profile')
+            if os.path.isdir(work_prof_root) and not os.path.islink(work_prof_root):
+                with os.scandir(work_prof_root) as it:
+                    pdirs = sorted(
+                        (
+                            e
+                            for e in it
+                            if e.is_dir(follow_symlinks=False)
+                            and not e.name.startswith('.')
+                            and os.path.isfile(os.path.join(e.path, 'game.tsv'))
+                        ),
+                        key=lambda e: (0 if e.name in (profile_id, tid) else 1, e.name),
+                    )
+                if pdirs:
+                    eff_profile_dir = pdirs[0].path
+                    discovered_work_prof = True
+                    if not profile_id:
+                        profile_id = pdirs[0].name
+
+        reg_id, reg_dir = _find_registered_profile_dir(tid, profile_id=profile_id)
+        if not reg_dir and discovered_work_prof and profile_id:
+            reg_id, reg_dir = _find_registered_profile_dir(tid, profile_id='')
+        reg_builds = _read_game_tsv_build_versions(os.path.join(reg_dir, 'game.tsv')) if reg_dir else set()
+
+        prof_kv = {}
+        if eff_profile_dir and os.path.exists(eff_profile_dir):
+            if os.path.islink(eff_profile_dir):
+                raise ValueError(f'symlink forbidden for profile_dir: {eff_profile_dir}')
+            eff_builds = _read_game_tsv_build_versions(os.path.join(eff_profile_dir, 'game.tsv'))
+            if eff_builds and pkg_ver not in eff_builds:
+                if discovered_work_prof and reg_dir and pkg_ver in reg_builds:
+                    eff_profile_dir = None
+                    profile_id = reg_id
+                    profile_kind = 'registered'
+                else:
+                    raise ValueError(
+                        f'profile in {eff_profile_dir} describes {", ".join(sorted(eff_builds))}, '
+                        f'which does not match package version {pkg_ver}'
+                    )
+
+        if eff_profile_dir and os.path.exists(eff_profile_dir):
+            prof_kv = _read_game_tsv_kv(os.path.join(eff_profile_dir, 'game.tsv'))
+            gid = profile_id or os.path.basename(os.path.normpath(eff_profile_dir))
+            _validate_rel_path(gid, 'profile_id')
+            profile_id = gid
+            is_repo_profile = (
+                reg_dir is not None
+                and os.path.exists(reg_dir)
+                and os.path.realpath(eff_profile_dir) == os.path.realpath(reg_dir)
+            )
+            if not profile_kind:
+                hdr = prof_kv.get('_header', '')
+                if 'Provisional game profile' in hdr:
+                    profile_kind = 'provisional'
+                elif 'Derived ' in hdr:
+                    profile_kind = 'derived'
+                else:
+                    profile_kind = 'registered' if is_repo_profile else 'derived'
+            if not is_repo_profile or profile_kind in ('derived', 'provisional'):
+                _stage_tree(eff_profile_dir, os.path.join(staging_dir, 'profile', gid), quota, allow_subdirs=True)
+                dkey = eff_profile_dir.rstrip('/\\') + '.derived.key'
+                if os.path.isfile(dkey) and not os.path.islink(dkey):
+                    _link_or_copy_file(dkey, os.path.join(staging_dir, 'profile', f'{gid}.derived.key'), quota)
+        elif reg_dir:
+            prof_kv = _read_game_tsv_kv(os.path.join(reg_dir, 'game.tsv'))
+            if not profile_id:
+                profile_id = reg_id
+            if not profile_kind:
+                profile_kind = 'registered'
+        else:
+            if not profile_id:
+                profile_id = tid.lower()
+            if not profile_kind:
+                profile_kind = 'registered'
+
+        # 5. Stage shader/pkg/ and sibling stamps
+        dst_shader = os.path.join(staging_dir, 'shader')
+        dst_pkg = os.path.join(dst_shader, 'pkg')
+        os.makedirs(dst_pkg, exist_ok=True)
+        src_shader = os.path.join(work_path, 'shader')
+        src_pkg = os.path.join(src_shader, 'pkg')
+        if os.path.exists(src_pkg):
+            _stage_tree(src_pkg, dst_pkg, quota, allow_subdirs=True)
+        for stamp_name in ('pkg.key', 'pkg.outputs.key', 'pso_pairs.tsv'):
+            sp = os.path.join(src_shader, stamp_name)
+            if os.path.exists(sp):
+                _link_or_copy_file(sp, os.path.join(dst_shader, stamp_name), quota)
+
+        # Check any existing seed for same pkg_ver so mac-only or Path A refreshes do not drop cached artifacts
+        prev_seed = {}
+        prev_seed_json = os.path.join(target_dir, 'seed.json')
+        if os.path.isfile(prev_seed_json) and not os.path.islink(prev_seed_json):
+            try:
+                with open(prev_seed_json, 'r', encoding='utf-8') as pf:
+                    cand_prev = json.load(pf)
+                if isinstance(cand_prev, dict) and str(cand_prev.get('pkg_ver') or '') == pkg_ver:
+                    prev_seed = cand_prev
+            except (OSError, ValueError):
+                prev_seed = {}
+
+        # 6. Stage shader/ios/ and metal-sources/b-<chain>.img (or vk / gl Mac shader directories)
+        ios_src = _extra_ios_dir
+        if not ios_src:
+            cand_ios = os.path.join(src_shader, 'ios')
+            cand_legacy = os.path.join(work_path, 'build', 'ios', 'dmsh_b')
+            prev_ios = os.path.join(target_dir, 'shader', 'ios')
+            if _dir_has_visible_files(cand_ios) and not os.path.islink(cand_ios):
+                ios_src = cand_ios
+            elif _dir_has_visible_files(cand_legacy) and not os.path.islink(cand_legacy):
+                ios_src = cand_legacy
+            elif prev_seed and _dir_has_visible_files(prev_ios) and not os.path.islink(prev_ios):
+                ios_src = prev_ios
+
+        gfx_api = _infer_gfx_api(
+            explicit_api=meta_in.get('gfx_api'),
+            prof_kv=prof_kv,
+            exefs_dir=os.path.join(staging_dir, 'ExeFS'),
+            shader_dirs=(src_shader, mac_shader_dir, os.path.join(target_dir, 'shader') if prev_seed else None),
+            ios_dirs=(ios_src, os.path.join(src_shader, 'ios'), os.path.join(target_dir, 'shader', 'ios') if prev_seed else None),
+            capture_roots=(os.path.join(staging_dir, 'captures'), ver_dir),
+            profile_dirs=(eff_profile_dir, reg_dir),
+        )
+        if gfx_api not in ('nvn', 'vulkan', 'gl'):
+            gfx_api = 'nvn'
+
+        raw_chain = _norm_chain(meta_in.get('chain')) if gfx_api == 'nvn' else ''
+
+        inferred_ios_chain = _stage_shader_ios(ios_src, raw_chain, staging_dir, quota, gfx_api=gfx_api)
+        if gfx_api == 'nvn' and not raw_chain and inferred_ios_chain:
+            raw_chain = inferred_ios_chain
+
+        if gfx_api == 'nvn':
+            inferred_mac_chain = _stage_metal_sources(mac_shader_dir, work_path, raw_chain, staging_dir, quota, gfx_api=gfx_api)
+            if not raw_chain and inferred_mac_chain:
+                raw_chain = inferred_mac_chain
+            staged_metal = os.path.join(staging_dir, 'metal-sources')
+            prev_metal = os.path.join(target_dir, 'metal-sources')
+            if (
+                prev_seed
+                and not _dir_has_visible_files(staged_metal)
+                and os.path.isdir(prev_metal)
+                and not os.path.islink(prev_metal)
+                and _dir_has_visible_files(prev_metal)
+            ):
+                _stage_tree(prev_metal, staged_metal, quota, allow_subdirs=True)
+            if not raw_chain:
+                hdr_path = os.path.join(_REPO_ROOT, 'dm', 'gfx', 'nvn', 'dmsh_chain.h')
+                if os.path.isfile(hdr_path):
+                    try:
+                        with open(hdr_path, 'r', encoding='utf-8', errors='replace') as hf:
+                            m = re.search(r'#define\s+DMSH_CHAIN\s+"([^"]+)"', hf.read())
+                            if m:
+                                raw_chain = _norm_chain(m.group(1))
+                    except OSError:
+                        pass
+        else:
+            raw_chain = ''
+            layer_sub = 'vk' if gfx_api == 'vulkan' else 'gl'
+            src_layer = os.path.join(src_shader, layer_sub)
+            prev_layer = os.path.join(target_dir, 'shader', layer_sub)
+            if _dir_has_visible_files(src_layer) and not os.path.islink(src_layer):
+                _stage_tree(src_layer, os.path.join(dst_shader, layer_sub), quota, allow_subdirs=True)
+            elif prev_seed and _dir_has_visible_files(prev_layer) and not os.path.islink(prev_layer):
+                _stage_tree(prev_layer, os.path.join(dst_shader, layer_sub), quota, allow_subdirs=True)
+            for key_cand in (
+                os.path.join(src_shader, f'{layer_sub}.key'),
+                os.path.join(target_dir, 'shader', f'{layer_sub}.key') if prev_seed else '',
+            ):
+                if key_cand and os.path.isfile(key_cand) and not os.path.islink(key_cand):
+                    _link_or_copy_file(key_cand, os.path.join(dst_shader, f'{layer_sub}.key'), quota)
+                    break
+
+        # 7. Stage shader/tables/{c1_full.tsv, cb_extent.tsv} (and optional shader tables)
+        dst_tables = os.path.join(dst_shader, 'tables')
+        os.makedirs(dst_tables, exist_ok=True)
+        table_search_dirs = []
+        for tdir in (
+            os.path.join(src_shader, 'tables'),
+            _extra_tables_dir,
+            eff_profile_dir,
+            reg_dir,
+        ):
+            if tdir and os.path.isdir(tdir) and not os.path.islink(tdir):
+                table_search_dirs.append(tdir)
+
+        for tname in ('c1_full.tsv', 'cb_extent.tsv', 'shader_map.tsv', 'shader_facts.tsv', 'shader_pairs.tsv', 'pso_pairs.tsv'):
+            for tdir in table_search_dirs:
+                cand_t = os.path.join(tdir, tname)
+                if os.path.isfile(cand_t) and not os.path.islink(cand_t):
+                    _link_or_copy_file(cand_t, os.path.join(dst_tables, tname), quota)
+                    break
+            else:
+                if gfx_api == 'nvn' and tname in _EMPTY_TABLE_HEADERS:
+                    fallback_path = os.path.join(dst_tables, tname)
+                    payload = _EMPTY_TABLE_HEADERS[tname].encode('utf-8')
+                    quota.charge(1, len(payload), fallback_path)
+                    with open(fallback_path, 'wb') as tf:
+                        tf.write(payload)
+
+        # 8. Multi-program sub-builds (work/p1, work/p2, ...) if present
+        programs_meta = list(meta_in.get('programs') or [])
+        if os.path.isdir(work_path):
+            with os.scandir(work_path) as it:
+                sub_progs = sorted(
+                    (e for e in it if e.is_dir(follow_symlinks=False) and _PROG_RE.fullmatch(e.name) and e.name != 'p0'),
+                    key=lambda e: int(_PROG_RE.fullmatch(e.name).group(1)),
+                )
+            for pe in sub_progs:
+                p_ver, p_ver_dir = _highest_version_dir(os.path.join(pe.path, 'extract'), allow_patched=True)
+                if p_ver_dir and os.path.isdir(os.path.join(p_ver_dir, 'ExeFS')):
+                    p_dst = os.path.join(staging_dir, 'programs', pe.name)
+                    _stage_tree(os.path.join(p_ver_dir, 'ExeFS'), os.path.join(p_dst, 'ExeFS'), quota, allow_subdirs=False)
+                    if os.path.isdir(os.path.join(pe.path, 'shader', 'pkg')):
+                        _stage_tree(os.path.join(pe.path, 'shader', 'pkg'), os.path.join(p_dst, 'shader', 'pkg'), quota)
+                    if os.path.isdir(os.path.join(pe.path, 'shader', 'ios')):
+                        _stage_shader_ios(os.path.join(pe.path, 'shader', 'ios'), raw_chain, p_dst, quota)
+                    if not any(p.get('index') == int(pe.name[1:]) for p in programs_meta if isinstance(p, dict)):
+                        programs_meta.append({'index': int(pe.name[1:]), 'pkg_ver': p_ver or 'v0'})
+
+        # 9. Resolve NACP metadata fallbacks and build seed.json
+        staged_nacp = os.path.join(staging_dir, 'control.nacp')
+        has_nacp = os.path.isfile(staged_nacp)
+        nacp_langs = nacp.languages(staged_nacp) if has_nacp else []
+        nacp_titles = nacp.names(staged_nacp) if has_nacp else {}
+        langs_available = list(meta_in.get('langs_available') or nacp_langs or list(nacp_titles.keys()))
+        default_lang = (
+            'en-US' if 'en-US' in langs_available
+            else ('en' if 'en' in langs_available else (langs_available[0] if langs_available else 'en-US'))
+        )
+        lang = str(meta_in.get('lang') or default_lang).strip()
+        app_name = str(
+            meta_in.get('app_name')
+            or nacp_titles.get(lang)
+            or (nacp.name(staged_nacp) if has_nacp else '')
+            or prof_kv.get('name')
+            or tid
+        ).strip()
+        app_version = str(
+            meta_in.get('app_version')
+            or (nacp.version(staged_nacp) if os.path.isfile(staged_nacp) else '')
+            or ''
+        ).strip()
+        bundle_id = str(meta_in.get('bundle_id') or f'com.nxnative.g{tid.lower()}').strip()
+        base_tid_raw = str(meta_in.get('base_title_id') or _default_base_title_id(tid)).strip().upper()
+        base_title_id = base_tid_raw if _TID_RE.fullmatch(base_tid_raw) else _default_base_title_id(tid)
+
+        is_multi_program = bool(
+            meta_in.get('is_multi_program')
+            or bool(programs_meta)
+            or bool(prof_kv.get('programs'))
+        )
+        uses_jit = bool(meta_in.get('uses_jit') or has_jit_dir or prof_kv.get('jit') in ('1', 'true', 'yes'))
+        has_aoc = bool(meta_in.get('has_aoc') or os.path.isdir(os.path.join(work_path, 'aoc')))
+        has_html = bool(meta_in.get('has_html') or has_html)
+        has_icon = bool(meta_in.get('has_icon') or has_icon)
+
+        romfs_id = _normalize_romfs_identity(meta_in.get('romfs_identity'))
+        if romfs_id is None:
+            for id_cand in (
+                os.path.join(ver_dir, 'RomFS.img.id'),
+                os.path.join(base_extract_dir, 'RomFS.img.id'),
+                os.path.join(work_path, 'romfs.img.id'),
+            ):
+                if os.path.isfile(id_cand) and not os.path.islink(id_cand):
+                    try:
+                        with open(id_cand, 'r', encoding='utf-8') as idf:
+                            romfs_id = _normalize_romfs_identity(idf.read())
+                        if romfs_id:
+                            break
+                    except (OSError, ValueError):
+                        pass
+        if romfs_id is None and prev_seed:
+            romfs_id = _normalize_romfs_identity(prev_seed.get('romfs_identity'))
+
+        inputs_digest = str(
+            meta_in.get('inputs_digest')
+            or _compute_inputs_digest(staging_dir, tid, pkg_ver, gfx_api, raw_chain)
+        ).strip()
+
+        seed_record = {
+            'schema': SEED_SCHEMA_VERSION,
+            'title_id': tid,
+            'base_title_id': base_title_id,
+            'pkg_ver': pkg_ver,
+            'app_name': app_name,
+            'app_version': app_version,
+            'bundle_id': bundle_id,
+            'lang': lang,
+            'langs_available': langs_available,
+            'gfx_api': gfx_api,
+            'chain': raw_chain,
+            'profile_id': profile_id,
+            'profile_kind': profile_kind,
+            'is_multi_program': is_multi_program,
+            'uses_jit': uses_jit,
+            'has_aoc': has_aoc,
+            'has_html': has_html,
+            'has_icon': has_icon,
+            'inputs_digest': inputs_digest,
+            'romfs_identity': romfs_id,
+            'updated_at': str(meta_in.get('updated_at') or _utc_now_iso()),
+            'programs': programs_meta,
+        }
+
+        seed_json_bytes = (json.dumps(seed_record, indent=2, ensure_ascii=False) + '\n').encode('utf-8')
+        quota.charge(1, len(seed_json_bytes), 'seed.json')
+        with open(os.path.join(staging_dir, 'seed.json'), 'wb') as sf:
+            sf.write(seed_json_bytes)
+            sf.flush()
+            os.fsync(sf.fileno())
+
+        # 10. Validate staged seed before publishing
+        validation = inspect_seed(staging_dir, title_id=tid)
+        if not validation['valid']:
+            raise ValueError(f'staged seed validation failed: {validation["reason"]}')
+
+        # 11. Atomic swap with unconditional target cleanup + .old rollback on failure
+        if os.path.lexists(old_dir):
+            if os.path.islink(old_dir) or not os.path.isdir(old_dir):
+                os.unlink(old_dir)
+            else:
+                shutil.rmtree(old_dir)
+
+        if os.path.lexists(target_dir):
+            if os.path.islink(target_dir):
+                raise ValueError(f'seed target must not be a symlink: {target_dir}')
+            os.rename(target_dir, old_dir)
+            had_backup = True
+
+        try:
+            os.replace(staging_dir, target_dir)
+        except BaseException:
+            if os.path.islink(target_dir):
+                try:
+                    os.unlink(target_dir)
+                except OSError:
+                    pass
+            else:
+                shutil.rmtree(target_dir, ignore_errors=True)
+            if had_backup and os.path.lexists(old_dir):
+                try:
+                    os.rename(old_dir, target_dir)
+                except OSError:
+                    shutil.copytree(old_dir, target_dir)
+                    shutil.rmtree(old_dir, ignore_errors=True)
+            raise
+
+        if had_backup and os.path.lexists(old_dir):
+            shutil.rmtree(old_dir, ignore_errors=True)
+    finally:
+        if os.path.lexists(staging_dir):
+            if os.path.islink(staging_dir):
+                try:
+                    os.unlink(staging_dir)
+                except OSError:
+                    pass
+            else:
+                shutil.rmtree(staging_dir, ignore_errors=True)
+
+    return inspect_seed(root_abs, title_id=tid)
+
