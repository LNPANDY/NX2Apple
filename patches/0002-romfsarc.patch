diff --git a/dm/host/tests/t_romfs_arc.c b/dm/host/tests/t_romfs_arc.c
new file mode 100644
index 00000000..3f675332
--- /dev/null
+++ b/dm/host/tests/t_romfs_arc.c
@@ -0,0 +1,87 @@
+// Test romfs_arc.c against a packed archive: path lookup, partial reads, directory listing.
+// Build: clang -I dm/host -o /tmp/t_romfs_arc dm/host/tests/t_romfs_arc.c dm/host/romfs_arc.c
+#include "romfs_arc.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+static int fails;
+#define CHECK(cond, ...) do { if (!(cond)) { printf("FAIL: "); printf(__VA_ARGS__); printf("\n"); fails++; } } while (0)
+
+int main(int argc, char **argv) {
+    if (argc < 2) { printf("usage: %s <base>\n", argv[0]); return 2; }
+    romfsarc_hdr h;
+    if (romfsarc_open(argv[1], &h)) { perror("romfsarc_open"); return 2; }
+    printf("opened: %llu files, %llu dirs, %u shards, hash %016llx\n",
+           (unsigned long long)h.file_count, (unsigned long long)h.dir_count, h.shard_count,
+           (unsigned long long)h.tree_hash);
+    CHECK(romfsarc_active(), "active after open");
+    CHECK(h.file_count > 0 && h.dir_count > 0 && h.shard_count > 0, "header counts");
+
+    // Every file: stat it, read it whole, and read it in two halves at an offset
+    romfsarc_ent *ents = calloc(4096, sizeof *ents);
+    char path[1024] = "";
+    int listed = romfsarc_list("", ents, 4096);
+    CHECK(listed > 0, "root has entries, got %d", listed);
+    CHECK(listed == romfsarc_count(""), "list and count agree at the root: %d vs %d", listed, romfsarc_count(""));
+
+    // Walk the tree breadth first and check every file's bytes against a direct read of its shard
+    size_t dcap = 1024;
+    char **dirs = calloc(dcap, sizeof *dirs);
+    int nd = 0;
+    dirs[nd++] = strdup("");
+    int checked = 0;
+    while (nd) {
+        char *d = dirs[--nd];
+        int n = romfsarc_count(d);
+        CHECK(n >= 0, "count of '%s'", d);
+        romfsarc_ent *e = calloc((size_t)(n > 0 ? n : 1), sizeof *e);
+        int got = romfsarc_list(d, e, n);
+        CHECK(got == n, "list '%s': %d vs %d", d, got, n);
+        for (int i = 0; i < got; i++) {
+            char rel[1024];
+            snprintf(rel, sizeof rel, "%s%s%s", d, *d ? "/" : "", e[i].name);
+            if (e[i].is_dir) {
+                CHECK(romfsarc_is_dir(rel), "is_dir '%s'", rel);
+                CHECK(!romfsarc_stat_file(rel, NULL, NULL, NULL), "dir is not a file: '%s'", rel);
+                char slash[1024]; snprintf(slash, sizeof slash, "%s/", rel);   // a trailing slash names the same directory (Bayonetta 3 opens "movie/")
+                CHECK(romfsarc_is_dir(slash) && romfsarc_count(slash) == romfsarc_count(rel), "trailing slash '%s'", slash);
+                if ((size_t)nd == dcap) { dcap *= 2; dirs = realloc(dirs, dcap * sizeof *dirs); }
+                dirs[nd++] = strdup(rel);
+            } else {
+                uint32_t shard; uint64_t off, size;
+                CHECK(romfsarc_stat_file(rel, &shard, &off, &size), "stat '%s'", rel);
+                CHECK((int64_t)size == e[i].size, "size '%s': %llu vs %lld", rel,
+                      (unsigned long long)size, (long long)e[i].size);
+                char *buf = malloc(size ? size : 1);
+                ssize_t r = romfsarc_pread(shard, off, buf, size);
+                CHECK(r == (ssize_t)size, "read '%s': %zd vs %llu", rel, r, (unsigned long long)size);
+                // A read past this file's end lands in the next file's bytes: the archive is a flat
+                // container, so the reader must not fabricate zeros. The fs layer clamps to the file
+                // size (see h_fs_ReadFile), so this only checks the reader does not fail outright.
+                char extra[16];
+                ssize_t r2 = romfsarc_pread(shard, off + size, extra, sizeof extra);
+                CHECK(r2 >= 0, "read past end of '%s' errored: %zd", rel, r2);
+                free(buf);
+                checked++;
+            }
+        }
+        free(e);
+    }
+    CHECK(checked == (int)h.file_count, "walked %d files, header says %llu", checked, (unsigned long long)h.file_count);
+
+    // Missing paths
+    CHECK(!romfsarc_stat_file("nope/nothing", NULL, NULL, NULL), "missing file is not found");
+    CHECK(!romfsarc_is_dir("nope"), "missing dir is not a dir");
+    CHECK(romfsarc_list("nope", ents, 4) < 0, "list of a missing dir fails");
+
+    // Root itself is a directory, and the empty path is not a file
+    CHECK(romfsarc_is_dir(""), "root is a dir");
+    CHECK(!romfsarc_stat_file("", NULL, NULL, NULL), "root is not a file");
+
+    romfsarc_close();
+    CHECK(!romfsarc_active(), "closed");
+    free(ents);
+    printf(fails ? "%d FAILURES\n" : "all checks passed (%d files)\n", fails ? fails : checked);
+    return fails ? 1 : 0;
+}
diff --git a/dm/tools/romfs_arc.py b/dm/tools/romfs_arc.py
new file mode 100644
index 00000000..000cb4c8
--- /dev/null
+++ b/dm/tools/romfs_arc.py
@@ -0,0 +1,270 @@
+#!/usr/bin/env python3
+"""Pack a RomFS tree into a ROMFSARC archive (one index file + N shard files).
+
+Why: Tears of the Kingdom's RomFS is 304,000 files. Copying that into an App's Documents takes
+hours, and a 16 GB IPA with that many entries fails to install on iOS (PackageExtractionFailed).
+An archive is ~120 files instead, so one copy moves it.
+
+Shard layout: files are grouped by their top-level directory (so one shard holds one kind of
+content), then split so that no shard passes --shard-mib. Files are written in path order within
+a shard; a shard never mixes content from different top-level directories unless that directory
+alone exceeds the limit.
+
+Usage:
+  romfs_arc.py pack <romfs dir> <output base> [--shard-mib 200]
+  romfs_arc.py list <base> [path]          # debug: list a directory
+  romfs_arc.py verify <base> <romfs dir>   # compare every file's bytes against the source tree
+
+Format: see dm/host/romfs_arc.h.
+"""
+import argparse
+import collections
+import os
+import struct
+import sys
+
+MAGIC = b"ROMFSARC"
+VERSION = 1
+HDR = 64
+FILEREC = 32
+DIRREC = 16
+CHILD_DIR = 0x80000000
+
+
+def fnv1a(data, h=0xCBF29CE484222325):
+    for b in data:
+        h = ((h ^ b) * 0x100000001B3) & 0xFFFFFFFFFFFFFFFF
+    return h
+
+
+def walk(root):
+    """Every file and directory under root, as (relpath, size) / relpath. Relpaths use '/' and have
+    no leading slash; the root itself is ''. Symlinks are followed (RomFS has none in the games
+    seen so far); anything that is neither a file nor a directory is an error."""
+    files, dirs = [], [""]
+    for dp, dn, fn in os.walk(root):
+        rel_dir = os.path.relpath(dp, root).replace(os.sep, "/")
+        if rel_dir == ".":
+            rel_dir = ""
+        dn.sort()
+        for d in dn:
+            dirs.append(f"{rel_dir}/{d}" if rel_dir else d)
+        for f in sorted(fn):
+            p = os.path.join(dp, f)
+            try:
+                st = os.stat(p)
+            except OSError as e:
+                sys.exit(f"[RED] cannot stat {p}: {e}")
+            files.append((f"{rel_dir}/{f}" if rel_dir else f, st.st_size))
+    files.sort(key=lambda x: x[0])
+    dirs.sort()
+    return files, dirs
+
+
+def plan_shards(files, shard_bytes):
+    """Assign every file a shard. Files are grouped by top-level directory, keeping the walk order
+    (path order) inside a group; a group is cut into shards of at most shard_bytes."""
+    by_top = collections.OrderedDict()
+    for rel, size in files:
+        top = rel.split("/", 1)[0]
+        by_top.setdefault(top, []).append((rel, size))
+    # Big groups first, so the shard count stays close to the size total / shard_bytes
+    order = sorted(by_top.items(), key=lambda kv: -sum(s for _, s in kv[1]))
+    assign, shard = {}, 0
+    for top, items in order:
+        cur = 0
+        for rel, size in items:
+            if cur and cur + size > shard_bytes:
+                shard += 1
+                cur = 0
+            assign[rel] = (shard, cur)
+            cur += size
+        shard += 1
+    return assign, shard
+
+
+def pack(romfs, base, shard_mib):
+    shard_bytes = shard_mib << 20
+    files, dirs = walk(romfs)
+    total = sum(s for _, s in files)
+    print(f"pack: {len(files):,} files, {len(dirs):,} directories, {total / 2**30:.2f} GiB", flush=True)
+    assign, nshard = plan_shards(files, shard_bytes)
+    print(f"pack: {nshard} shards of at most {shard_mib} MiB", flush=True)
+
+    # Shard files: written in path order within each shard
+    per_shard = collections.defaultdict(list)
+    for rel, size in files:
+        per_shard[assign[rel][0]].append((rel, size))
+    os.makedirs(os.path.dirname(base) or ".", exist_ok=True)
+    written = 0
+    for i in range(nshard):
+        path = f"{base}.{i:02d}"
+        with open(path, "wb") as out:
+            for rel, size in sorted(per_shard[i]):
+                with open(os.path.join(romfs, rel), "rb") as f:
+                    left = size
+                    while left:
+                        buf = f.read(min(left, 1 << 22))
+                        if not buf:
+                            sys.exit(f"[RED] {rel}: file shrank while packing")
+                        out.write(buf)
+                        left -= len(buf)
+                written += size
+        print(f"\r  shard {i + 1}/{nshard}: {os.path.getsize(path) / 2**20:.0f} MiB", end="", flush=True)
+    print(f"\n  wrote {written / 2**30:.2f} GiB in {nshard} shards", flush=True)
+
+    # Name pool
+    pool = bytearray()
+    name_off = {}
+
+    def intern(s):
+        if s not in name_off:
+            name_off[s] = len(pool)
+            pool.extend(s.encode("utf-8") + b"\0")
+        return name_off[s]
+
+    for rel, _ in files:
+        intern(rel)
+    for d in dirs:
+        intern(d)
+
+    # File table (sorted by path, same order as `files`)
+    file_idx = {}
+    ftab = bytearray()
+    for n, (rel, size) in enumerate(files):
+        file_idx[rel] = n
+        shard, off = assign[rel]
+        ftab += struct.pack("<IIQQII", intern(rel), shard, off, size, 0o644, 0)
+
+    # Directory table + child list. A directory's children are its immediate files and directories,
+    # sorted by name, contiguous in the child list.
+    dir_idx = {d: n for n, d in enumerate(dirs)}
+    children_of = collections.defaultdict(list)
+    for rel, _ in files:
+        parent, _, name = rel.rpartition("/")
+        children_of[parent].append((name, file_idx[rel]))
+    for d in dirs:
+        for sub in dirs:
+            if sub and sub.rpartition("/")[0] == d and sub != d:
+                # Only the leaf name goes in the child list; the directory's own path is in its record
+                children_of[d].append((sub.rpartition("/")[2], dir_idx[sub] | CHILD_DIR))
+
+    dtab = bytearray()
+    child_list = []
+    for d in dirs:
+        kids = sorted(children_of[d])
+        first = len(child_list)
+        child_list.extend(tag for _, tag in kids)
+        dtab += struct.pack("<IIII", intern(d), first, len(kids), 0)
+
+    tree = bytearray()
+    for rel, size in files:
+        tree += f"{rel}\0{size}\0".encode()
+    tree_hash = fnv1a(tree)
+
+    idx_path = f"{base}.idx"
+    with open(idx_path, "wb") as out:
+        out.write(struct.pack("<8sIIQQQQQQ", MAGIC, VERSION, nshard, 0, len(files), len(dirs),
+                              len(pool), 0, tree_hash))
+        out.write(pool)
+        out.write(ftab)
+        out.write(dtab)
+        out.write(struct.pack(f"<{len(child_list)}I", *child_list) if child_list else b"")
+    print(f"pack: index {os.path.getsize(idx_path) / 2**20:.1f} MiB ({len(pool) / 2**20:.1f} MiB names, "
+          f"{len(files):,} files, {len(dirs):,} directories), tree hash {tree_hash:016x}", flush=True)
+    print(f"pack: total {nshard + 1} files", flush=True)
+
+
+def load(base):
+    with open(f"{base}.idx", "rb") as f:
+        b = f.read()
+    magic, ver, nshard, _pad, nfiles, ndirs, pool_sz, _r, tree_hash = struct.unpack_from("<8sIIQQQQQQ", b, 0)
+    if magic != MAGIC or ver != VERSION:
+        sys.exit("[RED] not a ROMFSARC index")
+    pool = b[HDR:HDR + pool_sz]
+    off = HDR + pool_sz
+    files = []
+    for i in range(nfiles):
+        name_off, shard, foff, size, mode, _ = struct.unpack_from("<IIQQII", b, off + i * FILEREC)
+        name = pool[name_off:pool.index(b"\0", name_off)].decode()
+        files.append((name, shard, foff, size))
+    off += nfiles * FILEREC
+    dirs = []
+    for i in range(ndirs):
+        name_off, first, count, _ = struct.unpack_from("<IIII", b, off + i * DIRREC)
+        name = pool[name_off:pool.index(b"\0", name_off)].decode()
+        dirs.append((name, first, count))
+    off += ndirs * DIRREC
+    kids = struct.unpack_from(f"<{len(b) - off >> 2}I", b, off) if len(b) > off else ()
+    return dict(nshard=nshard, files=files, dirs=dirs, kids=kids, tree_hash=tree_hash)
+
+
+def cmd_list(base, path):
+    a = load(base)
+    target = path.strip("/")
+    d = next((x for x in a["dirs"] if x[0] == target), None)
+    if not d:
+        sys.exit(f"[RED] no such directory: {target or '/'}")
+    _, first, count = d
+    print(f"{target or '/'}: {count} entries")
+    for k in a["kids"][first:first + count]:
+        if k & CHILD_DIR:
+            print(f"  d  {a['dirs'][k & ~CHILD_DIR][0].rpartition('/')[2]}/")
+        else:
+            name, shard, off, size = a["files"][k]
+            print(f"  f  {name.rpartition('/')[2]:50} {size:12,}  shard {shard:3} off {off:,}")
+
+
+def cmd_verify(base, romfs):
+    a = load(base)
+    print(f"verify: {len(a['files']):,} files")
+    bad = 0
+    for n, (rel, shard, off, size) in enumerate(a["files"]):
+        src = os.path.join(romfs, rel)
+        try:
+            with open(src, "rb") as f:
+                want = f.read()
+        except OSError as e:
+            print(f"[RED] missing source {rel}: {e}")
+            bad += 1
+            continue
+        if len(want) != size:
+            print(f"[RED] size mismatch {rel}: source {len(want)} archive {size}")
+            bad += 1
+            continue
+        with open(f"{base}.{shard:02d}", "rb") as f:
+            f.seek(off)
+            got = f.read(size)
+        if got != want:
+            print(f"[RED] content mismatch {rel}")
+            bad += 1
+        if (n + 1) % 20000 == 0:
+            print(f"  {n + 1:,}/{len(a['files']):,}", flush=True)
+    print(f"verify: {'OK' if not bad else f'{bad} problems'}")
+    return 1 if bad else 0
+
+
+def main():
+    ap = argparse.ArgumentParser(description="Pack a RomFS tree into a ROMFSARC archive")
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    p = sub.add_parser("pack")
+    p.add_argument("romfs")
+    p.add_argument("base")
+    p.add_argument("--shard-mib", type=int, default=200)
+    l = sub.add_parser("list")
+    l.add_argument("base")
+    l.add_argument("path", nargs="?", default="")
+    v = sub.add_parser("verify")
+    v.add_argument("base")
+    v.add_argument("romfs")
+    a = ap.parse_args()
+    if a.cmd == "pack":
+        pack(a.romfs, a.base, a.shard_mib)
+    elif a.cmd == "list":
+        cmd_list(a.base, a.path)
+    else:
+        sys.exit(cmd_verify(a.base, a.romfs))
+
+
+if __name__ == "__main__":
+    main()
