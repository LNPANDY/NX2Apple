-        unsigned toggles = dm_pad_toggle_parse(getenv("DM_TOUCH_TOGGLE"));
-        for (int c = 0; c < DM_PAD_C_N; c++) if (toggles & (1u << c)) _toggle |= 1ull << toggleKey(c);
-        if (toggles) LOG("front end: touch keys that toggle (DM_TOUCH_TOGGLE): %s", getenv("DM_TOUCH_TOGGLE"));
+        const char *toggleEnv = getenv("DM_TOUCH_TOGGLE");
+        NSString *savedToggles = toggleEnv ? nil : [NSUserDefaults.standardUserDefaults stringForKey:k_toggle_key];   // the in-game menu's choice in a game's own app
+        unsigned toggles = dm_pad_toggle_parse(toggleEnv ? toggleEnv : savedToggles.UTF8String);
+        [self setToggleMask:toggles];
+        if (toggles) LOG("front end: touch keys that toggle (%s): %s", toggleEnv ? "DM_TOUCH_TOGGLE" : "in-game menu", toggleEnv ? toggleEnv : savedToggles.UTF8String);
         [self registerForTraitChanges:@[UITraitDisplayScale.class] withHandler:^(id<UITraitEnvironment> environment, UITraitCollection *previous) {
             [(UIView *)environment setNeedsLayout];
         }];
@@ -291,6 +301,21 @@ - (void)opmodeChanged {   // docked: the Tap layout goes (the game reads no touc
     if (!_tap || dm_opmode() == 0) return;
     [self reset]; _tap = NO; _full = NO; [self applyLayout]; [self setNeedsLayout];
 }
+- (void)setToggleMask:(unsigned)mask {   // DmPadGeometry.h's controls → the keys that toggle; a key that stops toggling is released
+    _toggleControls = mask; uint64_t keys = 0;
+    for (int c = 0; c < DM_PAD_C_N; c++) if (mask & (1u << c)) keys |= 1ull << toggleKey(c);
+    _toggle = keys; _latched &= keys;
+}
+- (unsigned)toggleMask { return _toggleControls; }
+- (void)setToggle:(int)control on:(BOOL)on {   // the in-game menu: at once, saved for the next start, and the same value the shell passes
+    if (control < 0 || control >= DM_PAD_C_N || !dm_pad_toggleable(control)) return;
+    unsigned mask = on ? _toggleControls | 1u << control : _toggleControls & ~(1u << control);
+    [self setToggleMask:mask]; [self recompute];
+    char value[128]; dm_pad_toggle_encode(mask, value, sizeof value);
+    if (*value) { [NSUserDefaults.standardUserDefaults setObject:@(value) forKey:k_toggle_key]; setenv("DM_TOUCH_TOGGLE", value, 1); }
+    else { [NSUserDefaults.standardUserDefaults removeObjectForKey:k_toggle_key]; unsetenv("DM_TOUCH_TOGGLE"); }
+    LOG("front end: touch keys that toggle set in the in-game menu: %s", *value ? value : "none");
+}
 - (void)setTouchFeedback:(BOOL)on {
     if (!on) { _touchFeedback = nil; return; }
     if (!_touchFeedback) { _touchFeedback = [[UIImpactFeedbackGenerator alloc] initWithStyle:UIImpactFeedbackStyleLight]; [_touchFeedback prepare]; }
@@ -844,6 +869,9 @@ int front_ctrl_support(int min, int max) {
 int dm_pad_layout(void) { return g_view ? [g_view padLayout] : 0; }
 bool dm_pad_layout_offered(int layout) { return layout == 0 || layout == 1 || (layout == 2 && dm_opmode() == 0); }
 void dm_pad_layout_set(int layout) { [g_view setPadLayout:layout]; }
+bool dm_pad_toggle_offered(void) { return g_view && !dlsym(RTLD_DEFAULT, "dm_shell_return_to_library"); }   // a game's own app: the shell has its layout editor
+bool dm_pad_toggles(int control) { return g_view && ([g_view toggleMask] & (1u << control)); }
+void dm_pad_toggle_set(int control, bool on) { [g_view setToggle:control on:on]; }
 void dm_gamepad_pads_read(void) {   // front_ios.m: the quit prompt closed, the game reads every controller as it is now (a button held through it counts again)
     if (g_merge) { for (GCController *c in GCController.controllers) if (c.extendedGamepad) read_pad(c.extendedGamepad); }
     else for (int p = 0; p < DM_PLAYERS; p++) if (g_held[p].extendedGamepad) read_pad(g_held[p].extendedGamepad);
diff --git a/dm/ios/Sources/DmPadGeometry.h b/dm/ios/Sources/DmPadGeometry.h
index e5b749f..8515ca0 100644
--- a/dm/ios/Sources/DmPadGeometry.h
+++ b/dm/ios/Sources/DmPadGeometry.h
@@ -297,6 +297,16 @@ static inline unsigned dm_pad_toggle_parse(const char *_Nullable v) {   // the c
     }
     return mask;
 }
+// The value for a mask, names in dm_pad_control_names' order joined by commas ("" for none): what the in-game menu saves.
+static inline void dm_pad_toggle_encode(unsigned mask, char *_Nonnull out, size_t size) {
+    size_t n = 0;
+    if (size) out[0] = 0;
+    for (int c = 0; c < DM_PAD_C_N; c++) if ((mask & (1u << c)) && dm_pad_toggleable(c)) {
+        int w = snprintf(out + n, size - n, "%s%s", n ? "," : "", dm_pad_control_names[c]);
+        if (w < 0 || (size_t)w >= size - n) { out[n] = 0; return; }
+        n += (size_t)w;
+    }
+}
 
 // The drawn shapes (dm_pad_shapes ids) of a control.
