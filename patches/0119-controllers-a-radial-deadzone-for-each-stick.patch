diff --git a/dm/host/tests/t_stick_deadzone.c b/dm/host/tests/t_stick_deadzone.c
new file mode 100644
index 00000000..d9ac75c2
--- /dev/null
+++ b/dm/host/tests/t_stick_deadzone.c
@@ -0,0 +1,52 @@
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "../stick_deadzone.h"
+
+static void t_percent(void) {
+    assert(stick_deadzone_percent(NULL) == 0 && stick_deadzone_percent("") == 0);   // unset: the stick is left alone
+    assert(stick_deadzone_percent("0") == 0 && stick_deadzone_percent("25") == 25 && stick_deadzone_percent("50") == 50);
+    assert(stick_deadzone_percent("51") == 0 && stick_deadzone_percent("-3") == 0 && stick_deadzone_percent("12x") == 0 && stick_deadzone_percent("1.5") == 0);
+}
+static void t_unset_is_unchanged(void) {
+    int32_t x = 1234, y = -4321;
+    stick_deadzone_apply(&x, &y, 0);
+    assert(x == 1234 && y == -4321);
+}
+static void t_inside_reads_centred(void) {
+    int32_t x = DM_STICK_MAX / 10, y = DM_STICK_MAX / 10;   // radius 0.14, inside 20%
+    stick_deadzone_apply(&x, &y, 20);
+    assert(x == 0 && y == 0);
+}
+static void t_outside_is_rescaled_and_radial(void) {
+    int32_t x = DM_STICK_MAX / 2, y = 0;   // half travel with a 20% deadzone: (0.5-0.2)/(0.8) = 0.375 of the range
+    stick_deadzone_apply(&x, &y, 20);
+    assert(abs(x - (int32_t)(0.375f * DM_STICK_MAX)) <= 1 && y == 0);
+    int32_t dx = DM_STICK_MAX * 6 / 10, dy = DM_STICK_MAX * 6 / 10;   // a diagonal keeps its angle
+    stick_deadzone_apply(&dx, &dy, 20);
+    assert(dx == dy && dx > 0);
+}
+static void t_full_travel_stays_full(void) {
+    int32_t x = DM_STICK_MAX, y = 0;
+    stick_deadzone_apply(&x, &y, 50);
+    assert(x == DM_STICK_MAX && y == 0);
+    int32_t cx = DM_STICK_MAX, cy = DM_STICK_MAX;   // a square corner is beyond a full radius: not rotated
+    stick_deadzone_apply(&cx, &cy, 30);
+    assert(cx == DM_STICK_MAX && cy == DM_STICK_MAX);
+    int32_t nx = -DM_STICK_MAX, ny = 0;
+    stick_deadzone_apply(&nx, &ny, 10);
+    assert(nx == -DM_STICK_MAX);
+}
+static void t_monotonic(void) {
+    int32_t last = -1;
+    for (int v = 0; v <= DM_STICK_MAX; v += 97) {
+        int32_t x = v, y = 0;
+        stick_deadzone_apply(&x, &y, 35);
+        assert(x >= last); last = x;
+    }
+}
+int main(void) {
+    t_percent(); t_unset_is_unchanged(); t_inside_reads_centred(); t_outside_is_rescaled_and_radial(); t_full_travel_stays_full(); t_monotonic();
+    puts("t_stick_deadzone: ok");
+    return 0;
+}
diff --git a/docs/env_switches.tsv b/docs/env_switches.tsv
index 4b075826..44fe595a 100644
--- a/docs/env_switches.tsv
+++ b/docs/env_switches.tsv
@@ -358,6 +358,8 @@ DM_SPIN_LIST	diagnostic	`=1` makes `patch_nso.py` print every guest poll loop it
 DM_SPIN_POLL	switch	`=<µs>`: how long a spin-gate wait polls before it sleeps with the yield back-off (default 2000; `0` yields on every pass)
 DM_STEAM_DEADZONE	switch	`=0..0.9` (exclusive upper bound) sets the radial deadzone for both raw Steam Controller sticks; default 0.10, `0` disables it; invalid values use the default
 DM_STEAM_HID	switch	`=0` disables the Mac direct Steam Controller HID adapter and leaves input to Apple GameController; enabled otherwise
+DM_STICK_DEADZONE_L	switch	`=1..50` sets a radial deadzone of that many percent of the travel for the left stick of every physical controller (inside it the stick reads centred, outside it the rest of the travel is rescaled to the full range); unset, `0` or anything else leaves the stick as the controller reports it. The Mac launcher's Controls settings write it (Use custom deadzones)
+DM_STICK_DEADZONE_R	switch	`=1..50` the same for the right stick
 DM_SVC	diagnostic	`=1` logs memory SVCs (`SetHeapSize`, `MapMemory`, `Map`/`UnmapPhysicalMemory`) with their addresses and sizes
 DM_SW2	player	`=1` turns on Switch 2 controllers over Bluetooth LE (Joy-Con 2, Pro Controller 2): the settings window's Switch 2 controllers. Off, no Bluetooth client is created and macOS asks nothing. The host also stays off when the app's Info.plist has no NSBluetoothAlwaysUsageDescription, without which macOS ends the process at the first Bluetooth scan
 DM_SW2_GYRO_DPS	diagnostic	`=<degrees per second per count>` is the Switch 2 controllers' gyro scale (default 0.0607, measured on a left and a right Joy-Con 2; the Switch family's nominal 0.070 turned a 90 degree tilt into 104)
