diff --git a/dm/host/hle_hid.c b/dm/host/hle_hid.c
index ebe65345..99e21649 100644
--- a/dm/host/hle_hid.c
+++ b/dm/host/hle_hid.c
@@ -7,6 +7,7 @@
 #include "hle.h"
 #include "hle_haptics.h"
 #include "dm_input.h"
+#include "stick_deadzone.h"
 #include "front.h"
 #include <stdatomic.h>
 #include <stdbool.h>
@@ -61,8 +62,16 @@ void dm_input_set(uint64_t buttons, int32_t lx, int32_t ly, int32_t rx, int32_t
     uint64_t old = atomic_exchange(&g_btn, buttons); atomic_fetch_or(&g_latch, buttons & ~old); atomic_fetch_or(&g_peek_latch, buttons & ~old); atomic_store(&g_axes, pack(lx, ly, rx, ry));
     shake_note(0);
 }
+// The front end's per-stick deadzones (stick_deadzone.h), read once: the environment is fixed at launch. Every physical controller passes through
+// dm_pad_set_player, so the same deadzone holds on the Mac and the iPhone; keyboard, touch and scripted input do not use it.
+static int stick_dz(int right) {
+    static int cached[2] = {-1, -1};
+    if (cached[right] < 0) cached[right] = stick_deadzone_percent(getenv(right ? "DM_STICK_DEADZONE_R" : "DM_STICK_DEADZONE_L"));
+    return cached[right];
+}
 void dm_pad_set_player(int p, uint64_t buttons, int32_t lx, int32_t ly, int32_t rx, int32_t ry) {
     if (p < 0 || p >= DM_PLAYERS) return;
+    stick_deadzone_apply(&lx, &ly, stick_dz(0)); stick_deadzone_apply(&rx, &ry, stick_dz(1));
     uint64_t old = atomic_exchange(&g_pad_btn[p], buttons); atomic_fetch_or(&g_pad_latch[p], buttons & ~old); atomic_fetch_or(&g_peek_latch, buttons & ~old); atomic_store(&g_pad_axes[p], pack(lx, ly, rx, ry));
     shake_note(p);
 }
diff --git a/dm/host/stick_deadzone.h b/dm/host/stick_deadzone.h
new file mode 100644
index 00000000..36fa9e79
--- /dev/null
+++ b/dm/host/stick_deadzone.h
@@ -0,0 +1,27 @@
+// A radial deadzone for each stick of a physical controller, set by the front end: DM_STICK_DEADZONE_L and DM_STICK_DEADZONE_R,
+// each a whole percent of the stick's travel from 0 to 50. Unset (or invalid, or 0) leaves the stick exactly as the controller reports it.
+// Inside the deadzone the stick reads centred, outside it the remaining travel is rescaled to the full range, so a stick pushed all the way
+// still reads full. A square-range diagonal beyond a full radius is left alone, as steam_deadzone does (steam_input.h).
+#pragma once
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include "dm_input.h"
+
+// The percent a switch's text means: 1..50, or 0 for "leave the stick as reported" (unset, empty, not a whole number, above 50).
+static inline int stick_deadzone_percent(const char *text) {
+    if (!text || !*text) return 0;
+    char *end; long v = strtol(text, &end, 10);
+    return end != text && !*end && v >= 1 && v <= 50 ? (int)v : 0;
+}
+
+// x and y in -DM_STICK_MAX..DM_STICK_MAX, percent as stick_deadzone_percent returns it.
+static inline void stick_deadzone_apply(int32_t *x, int32_t *y, int percent) {
+    if (percent <= 0) return;
+    float dz = percent / 100.0f, fx = *x / (float)DM_STICK_MAX, fy = *y / (float)DM_STICK_MAX, radius = hypotf(fx, fy);
+    if (radius <= dz) { *x = *y = 0; return; }
+    if (radius >= 1) return;
+    float scale = (radius - dz) / ((1 - dz) * radius);
+    *x = (int32_t)lrintf(fmaxf(-1, fminf(1, fx * scale)) * DM_STICK_MAX);
+    *y = (int32_t)lrintf(fmaxf(-1, fminf(1, fy * scale)) * DM_STICK_MAX);
+}
