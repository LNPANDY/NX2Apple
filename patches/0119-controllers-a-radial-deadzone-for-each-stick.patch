 dm/host/stick_deadzone.h         | 27 +++++++++++++++++
 dm/host/tests/Makefile           |  4 ++-
 dm/host/tests/t_stick_deadzone.c | 52 ++++++++++++++++++++++++++++++++
 docs/env_switches.tsv            |  2 ++
 5 files changed, 93 insertions(+), 1 deletion(-)
 create mode 100644 dm/host/stick_deadzone.h
