+      DEVELOPMENT_TEAM: ${DM_TEAM_ID}
+      CODE_SIGN_STYLE: Automatic
+      CODE_SIGN_ENTITLEMENTS: ""
+      SKIP_INSTALL: YES
+      DYLIB_INSTALL_NAME_BASE: "@rpath"
+      DEFINES_MODULE: NO
+      ENABLE_BITCODE: NO
+      GCC_C_LANGUAGE_STANDARD: gnu11
+      SWIFT_VERSION: "5.0"
+      OTHER_SWIFT_FLAGS: $(inherited) -import-objc-header $(SRCROOT)/Sources/DmGameMenu.h
+      OTHER_CFLAGS: $(inherited) -mcpu=apple-a18
+      OTHER_LDFLAGS: $(inherited) -framework UIKit -framework UserNotifications
+      CLANG_ENABLE_OBJC_ARC: YES
+      DEBUG_INFORMATION_FORMAT: dwarf
