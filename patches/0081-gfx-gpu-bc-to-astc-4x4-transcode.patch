+            checks++; if (bad) { fails++; printf("  ✗ %s: %zu of %zu bytes differ (first at %zu)\n", kn[kind], bad, out_size, first); }
+            int want[6] = {1, 1, kind == 2 || kind == 3, kind == 1, kind == 2 || kind == 3, kind == 4};
+            for (int l = 0; l < 6; l++) { if (!want[l]) continue; checks++; if (!layouts[l]) { fails++; printf("  ✗ %s: layout %d never reached\n", kn[kind], l); } }
+            for (int l = 1; l < 6; l++) { if (!want[l]) continue; checks++; if (!swap_by[l] || swap_by[l] == layouts[l]) { fails++; printf("  ✗ %s: layout %d swapped %ld of %ld blocks (need both)\n", kn[kind], l, swap_by[l], layouts[l]); } }
+            printf("%s: %u blocks, L0 %ld L1a %ld L1b %ld L2 %ld L3 %ld L4 %ld, %ld swapped, %s, %.1f ms (%.0f Mblocks/s)\n",
+                   kn[kind], n, layouts[0], layouts[1], layouts[2], layouts[3], layouts[4], layouts[5], swapped, bad ? "DIFFERENT" : "byte-identical", ms, n / ms / 1e3);
+            free(in); free(out_ref);
+        }
+        printf("%d checks, %d failed\n", checks, fails);
+        return fails != 0;
+    }
+}
