+    def test_bc3_keep_table_is_copied_for_nvn_when_present(self):
+        keep = b'# bc3 keep\n0123456789abcdef\n'
+        (self.profile / 'bc3_keep_rgba8.tsv').write_bytes(keep)
+        for api in ('nvn', 'vulkan', 'gl'):
+            with self.subTest(api=api):
+                for f in self.tables.iterdir(): f.unlink()
+                result = self.stage(api)
+                self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+                if api == 'nvn':
+                    self.assertEqual((self.tables / 'bc3_keep_rgba8.tsv').read_bytes(), keep)
+                else:
+                    self.assertFalse((self.tables / 'bc3_keep_rgba8.tsv').exists())
+        for f in self.tables.iterdir(): f.unlink()
+        (self.profile / 'c1_full.tsv').unlink()
+        partial = self.stage('nvn', extra_env={'DM_PARTIAL_SHADERS': '1'})
+        self.assertEqual(partial.returncode, 0, partial.stdout + partial.stderr)
+        self.assertEqual((self.tables / 'bc3_keep_rgba8.tsv').read_bytes(), keep)
+        (self.profile / 'c1_full.tsv').write_text('c1_full.tsv\n')
+        fail = self.stage('nvn', 'cp() { for arg in "$@"; do case "$arg" in */bc3_keep_rgba8.tsv) return 1;; esac; done; command cp "$@"; }\n')
+        self.assertNotEqual(fail.returncode, 0)
+        self.assertIn('FAIL:', fail.stdout)
+
 
 if __name__ == '__main__': unittest.main()
