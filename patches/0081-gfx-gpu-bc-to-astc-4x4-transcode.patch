+        MLOG("no BC: DM_NO_BC_ASTC=%s: %s%s", e && *e ? e : "(unset) all",
+             g_astc_mode_cache == 2 ? "BC1, BC2 and BC3 stored as ASTC 4x4 (1 B/px), BC4-7 and 3D decompressed" :
+             g_astc_mode_cache == 1 ? "BC1 stored as ASTC 4x4, other BC formats decompressed" :
+             "all BC formats decompressed to uncompressed formats",
+             g_astc_mode_cache && !keep_on() ? " (DM_NO_BC_ASTC_KEEP=0: BC3 keep table ignored)" : "");
+    }
+    return g_astc_mode_cache;
+}
+static uint64_t *g_keep_keys; static _Atomic size_t g_keep_n;
+static _Atomic uint64_t g_keep_lookups, g_keep_hits;
+static nvn_hmap g_keep_dec = {.klen = 8};   // serial -> 1 ASTC / 2 kept RGBA8: stable decision per texture lifetime
+static pthread_mutex_t g_keep_mu = PTHREAD_MUTEX_INITIALIZER;
+static int keep_cmp(const void *a, const void *b) { uint64_t x = *(const uint64_t *)a, y = *(const uint64_t *)b; return x < y ? -1 : x > y; }
+static void keep_load(NSString *path) {   // optional bc3_keep_rgba8.tsv beside shader_map.tsv
+    NSString *txt = [NSString stringWithContentsOfFile:path encoding:NSUTF8StringEncoding error:nil];
+    if (!txt) return;
+    NSArray *lines = [txt componentsSeparatedByString:@"\n"];
+    pthread_mutex_lock(&g_keep_mu);
+    free(g_keep_keys);
+    g_keep_keys = calloc(lines.count + 1, sizeof *g_keep_keys);
+    size_t cnt = 0;
+    for (NSString *ln in lines) {
+        if (!ln.length || [ln hasPrefix:@"#"]) continue;
+        unsigned long long k = strtoull(ln.UTF8String, NULL, 16);
+        if (k) g_keep_keys[cnt++] = k;
+    }
+    qsort(g_keep_keys, cnt, sizeof *g_keep_keys, keep_cmp);
+    atomic_store_explicit(&g_keep_n, cnt, memory_order_release);
+    nvn_hm_clear(&g_keep_dec, NULL);
+    pthread_mutex_unlock(&g_keep_mu);
+    MLOG("BC3 keep table (bc3_keep_rgba8.tsv): %zu textures stay RGBA8 on GPUs without BC%s", cnt, keep_on() ? "" : " (DM_NO_BC_ASTC_KEEP=0: ignored)");
+}
+int nvn_sparse_pool(const void *pool);   // hle_nvn.c
+// Whether this texture is stored as ASTC 4x4 instead of RGBA8; *pf receives the Metal format.
+static int bc_astc(const tex_t *t, uint32_t *pf) {
+    if (!no_bc()) return 0;
+    int mode = astc_mode(); uint32_t apf; int kind;
+    if (!mode || !nvn_bc_astc_fmt((uint32_t)t->d.format, &apf, &kind) || (mode == 1 && kind != NVN_BCA_BC1_RGBA && kind != NVN_BCA_BC1_RGB)) return 0;
+    if (t->d.target == 2 || t->d.samples > 1) return 0;   // 3D and multisample stay decompressed
+    if (kind == 3 && atomic_load_explicit(&g_keep_n, memory_order_acquire) && keep_on() && t->has_layout && t->mem
+        && !(t->pool && nvn_sparse_pool(t->pool))) {
+        uint64_t sk = t->serial;
+        intptr_t dec = 0;
+        if (sk) {
+            pthread_mutex_lock(&g_keep_mu);
+            dec = (intptr_t)nvn_hm_get(&g_keep_dec, &sk);
+            pthread_mutex_unlock(&g_keep_mu);
+        }
+        if (!dec) {
+            size_t span = t->L.size < 65536 ? t->L.size : 65536;
+            if (!span || !nvn_host_readable((uint64_t)(uintptr_t)t->mem, span)) { *pf = apf; return 1; }
+            uint32_t kf = t->d.format == 0x48 ? 0x44 : (uint32_t)t->d.format;
+            uint64_t key = nvn_texkey(t->mem, t->L.size, kf, t->d.width, t->d.height, t->d.levels);
+            pthread_mutex_lock(&g_keep_mu);
+            size_t kn = atomic_load_explicit(&g_keep_n, memory_order_acquire);
+            int hit = g_keep_keys && kn && bsearch(&key, g_keep_keys, kn, sizeof *g_keep_keys, keep_cmp) != NULL;
+            dec = hit ? 2 : 1;
+            if (sk) nvn_hm_put(&g_keep_dec, &sk, (void *)dec);
+            pthread_mutex_unlock(&g_keep_mu);
+            atomic_fetch_add(&g_keep_lookups, 1);
+            if (hit) atomic_fetch_add(&g_keep_hits, 1);
+        }
+        if (dec == 2) return 0;
+    }
+    *pf = apf; return 1;
+}
+int mtl_no_bc(void) { return no_bc(); }
+int mtl_no_bc_astc_mode(void) { return astc_mode(); }
