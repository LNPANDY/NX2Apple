index 0000000..a99db20
--- /dev/null
+++ b/dm/gfx/tex/tests/t_bc2astc.c
@@ -0,0 +1,484 @@
+// BC1 (RGBA & RGB) / BC2 / BC3 → ASTC 4x4 transcoder (bc2astc_core.h, nvn_bc2astc.c): per-category error against bcdec,
+// with ARM's astcenc (full mode) and a built-in spec ASTC 4x4 block decoder (--unit mode, ASan+UBSan).
+// Usage: t_bc2astc [-v] [--unit]
+
+#define BCDEC_IMPLEMENTATION
+#include "../../../third_party/bcdec/bcdec.h"
+#include "../bc2astc_core.h"
+#include "../nvn_bc2astc.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+char *mkdtemp(char *);   // POSIX; not visible under the default feature level here
+static int checks, fails, verbose;
+#define CHECK(c, ...) do { checks++; if (!(c)) { fails++; printf("  ✗ "); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static uint64_t rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd32(void) { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return (uint32_t)(rng >> 16); }
+static uint32_t rndn(uint32_t n) { return rnd32() % n; }
+
+static char tmpdir[256]; static const char *astcenc;
+
+// ---------- Built-in spec ASTC 4x4 LDR decoder for all layouts emitted by bc2astc_body.inc (used in --unit mode) ----------
+static uint32_t get_bits(const uint32_t w[4], uint32_t pos, uint32_t n) {
+    uint32_t v = 0;
+    for (uint32_t i = 0; i < n; i++) {
+        uint32_t p = pos + i;
+        if (p < 128u && ((w[p >> 5] >> (p & 31u)) & 1u)) v |= 1u << i;
+    }
+    return v;
+}
+static void decode_trit_group(uint32_t T, uint32_t t[5]) {
+    uint32_t C, b7 = (T >> 7) & 1u;
+    if (((T >> 2) & 7u) == 7u) { C = (((T >> 5) & 7u) << 2) | (T & 3u); t[4] = 2; t[3] = 2; }
+    else { C = T & 31u; if (((T >> 5) & 3u) == 3u) { t[4] = 2; t[3] = b7; } else { t[4] = b7; t[3] = (T >> 5) & 3u; } }
+    if ((C & 3u) == 3u) { t[2] = 2; t[1] = (C >> 4) & 1u; t[0] = (((C >> 3) & 1u) << 1) | (((C >> 2) & 1u) & ~((C >> 3) & 1u) & 1u); }
+    else if (((C >> 2) & 3u) == 3u) { t[2] = 2; t[1] = 2; t[0] = C & 3u; }
+    else { t[2] = (C >> 4) & 1u; t[1] = (C >> 2) & 3u; t[0] = (((C >> 1) & 1u) << 1) | ((C & 1u) & ~((C >> 1) & 1u) & 1u); }
+}
+static void decode_ise_trit(const uint32_t src[4], uint32_t pos, uint32_t n, uint32_t nb, uint32_t *out) {
+    uint32_t total = n * nb + (n * 8u + 4u) / 5u, lim = pos + total, p = pos;
+    for (uint32_t g = 0; g < n; g += 5) {
+        uint32_t m[5] = {0}, tb = 0;
+        uint32_t n0 = (p + nb <= lim) ? nb : (p < lim ? lim - p : 0); m[0] = get_bits(src, p, n0); p += nb;
+        uint32_t t0 = (p + 2 <= lim) ? 2 : (p < lim ? lim - p : 0); tb |= get_bits(src, p, t0); p += 2;
+        uint32_t n1 = (p + nb <= lim) ? nb : (p < lim ? lim - p : 0); m[1] = get_bits(src, p, n1); p += nb;
+        uint32_t t1 = (p + 2 <= lim) ? 2 : (p < lim ? lim - p : 0); tb |= get_bits(src, p, t1) << 2; p += 2;
+        uint32_t n2 = (p + nb <= lim) ? nb : (p < lim ? lim - p : 0); m[2] = get_bits(src, p, n2); p += nb;
+        uint32_t t2 = (p + 1 <= lim) ? 1 : 0; tb |= get_bits(src, p, t2) << 4; p += 1;
+        uint32_t n3 = (p + nb <= lim) ? nb : (p < lim ? lim - p : 0); m[3] = get_bits(src, p, n3); p += nb;
+        uint32_t t3 = (p + 2 <= lim) ? 2 : (p < lim ? lim - p : 0); tb |= get_bits(src, p, t3) << 5; p += 2;
+        uint32_t n4 = (p + nb <= lim) ? nb : (p < lim ? lim - p : 0); m[4] = get_bits(src, p, n4); p += nb;
+        uint32_t t4 = (p + 1 <= lim) ? 1 : 0; tb |= get_bits(src, p, t4) << 7; p += 1;
+        uint32_t tr[5]; decode_trit_group(tb, tr);
+        for (uint32_t k = 0; k < 5 && g + k < n; k++) out[g + k] = (tr[k] << nb) | m[k];
+    }
+}
+static void decode_cem_pair(uint32_t cem, const int v[8], int e0[4], int e1[4]) {
+    if (cem == 8u) {
+        int s0 = v[0] + v[2] + v[4], s1 = v[1] + v[3] + v[5];
+        if (s1 >= s0) { e0[0] = v[0]; e0[1] = v[2]; e0[2] = v[4]; e0[3] = 255; e1[0] = v[1]; e1[1] = v[3]; e1[2] = v[5]; e1[3] = 255; }
+        else { e0[0] = (v[1] + v[5]) >> 1; e0[1] = (v[3] + v[5]) >> 1; e0[2] = v[5]; e0[3] = 255; e1[0] = (v[0] + v[4]) >> 1; e1[1] = (v[2] + v[4]) >> 1; e1[2] = v[4]; e1[3] = 255; }
+    } else {   // CEM 12 (LDR RGBA Direct)
+        int s0 = v[0] + v[2] + v[4], s1 = v[1] + v[3] + v[5];
+        if (s1 >= s0) { e0[0] = v[0]; e0[1] = v[2]; e0[2] = v[4]; e0[3] = v[6]; e1[0] = v[1]; e1[1] = v[3]; e1[2] = v[5]; e1[3] = v[7]; }
+        else { e0[0] = (v[1] + v[5]) >> 1; e0[1] = (v[3] + v[5]) >> 1; e0[2] = v[5]; e0[3] = v[7]; e1[0] = (v[0] + v[4]) >> 1; e1[1] = (v[2] + v[4]) >> 1; e1[2] = v[4]; e1[3] = v[6]; }
+    }
+}
+static int astc_soft_decode(const uint8_t blk[16], uint8_t rgba[16][4]) {
+    uint32_t w[4]; memcpy(w, blk, 16);
+    if ((w[0] & 0xfffu) == 0xdfcu) {   // constant-colour void-extent
+        uint8_t c[4] = { (uint8_t)(w[2] >> 8), (uint8_t)(w[2] >> 24), (uint8_t)(w[3] >> 8), (uint8_t)(w[3] >> 24) };
+        for (int i = 0; i < 16; i++) memcpy(rgba[i], c, 4);
+        return 0;
+    }
+    uint32_t mode = get_bits(w, 0, 11), parts = get_bits(w, 11, 2) + 1u;
+    uint32_t dual = (mode >> 10) & 1u, is_trit_w = (mode & 0x3ffu) == 0x051u;
+    uint32_t nw = dual ? 32u : 16u, wbits = is_trit_w ? (nw * 8u + 4u) / 5u : nw * 2u;
+    uint32_t rev_w[4] = {0};
+    for (uint32_t i = 0; i < wbits; i++) if (bca_getb(w, 127u - i)) bca_putl(rev_w, i, 128, 1, 1);
+    uint32_t wq[32] = {0}, wvals[32] = {0};
+    if (is_trit_w) { decode_ise_trit(rev_w, 0, nw, 0, wq); for (uint32_t i = 0; i < nw; i++) wvals[i] = wq[i] * 32u; }
+    else { for (uint32_t i = 0; i < nw; i++) { wq[i] = get_bits(rev_w, 2 * i, 2); wvals[i] = bca_w4[wq[i]]; } }
+    uint32_t ccs = dual ? get_bits(w, 128u - wbits - 2u, 2) : 4u;
+    if (parts == 1u) {
+        uint32_t cem = get_bits(w, 13, 4);
+        int v[8] = {0}, e0[4], e1[4];
+        if (mode == 0x042u || (mode == 0x051u && cem == 8u) || (mode == 0x451u && cem == 8u)) {
+            uint32_t nv = cem == 12u ? 8u : 6u;
+            for (uint32_t i = 0; i < nv; i++) v[i] = (int)get_bits(w, 17 + 8 * i, 8);
+        } else if (mode == 0x451u && cem == 12u) {
+            for (uint32_t i = 0; i < 8; i++) { uint32_t q = get_bits(w, 17 + 7 * i, 7); v[i] = (int)((q << 1) | (q >> 6)); }
+        } else if (mode == 0x442u && cem == 12u) {
+            uint32_t raw[8]; decode_ise_trit(w, 17, 8, 4, raw);
+            for (uint32_t i = 0; i < 8; i++) {
+                int found = 0;
+                for (int l = 0; l < 48; l++) if (bca_raw48[l] == raw[i]) { v[i] = bca_unq48[l]; found = 1; break; }
+                if (!found) return -1;
+            }
+        } else return -2;
+        decode_cem_pair(cem, v, e0, e1);
+        for (uint32_t i = 0; i < 16; i++) {
+            for (uint32_t ch = 0; ch < 4; ch++) {
+                uint32_t wt = (dual && ch == ccs) ? wvals[2 * i + 1] : (dual ? wvals[2 * i] : wvals[i]);
+                rgba[i][ch] = (uint8_t)bca_lerp(e0[ch], e1[ch], (s32)wt);
+            }
+        }
+        return 0;
+    }
+    if (parts == 2u && mode == 0x051u) {
+        uint32_t seed = get_bits(w, 13, 10), cem_sel = get_bits(w, 23, 6);
+        if (cem_sel != (8u << 2)) return -3;
+        uint32_t pmask = 0; int found = 0;
+        for (int i = 0; i < 64; i++) if ((bca_p2[i] >> 16) == seed) { pmask = bca_p2[i] & 0xffffu; found = 1; break; }
+        if (!found) return -4;
+        int e0[2][4], e1[2][4];
+        for (uint32_t p = 0; p < 2; p++) {
+            int v[8] = {0};
+            for (uint32_t j = 0; j < 6; j++) { uint32_t q = get_bits(w, 29 + 6 * (p * 6 + j), 6); v[j] = (int)((q << 2) | (q >> 4)); }
+            decode_cem_pair(8u, v, e0[p], e1[p]);
+        }
+        for (uint32_t i = 0; i < 16; i++) {
+            uint32_t p = (pmask >> i) & 1u;
+            for (uint32_t ch = 0; ch < 4; ch++) rgba[i][ch] = (uint8_t)bca_lerp(e0[p][ch], e1[p][ch], (s32)wvals[i]);
+        }
+        return 0;
+    }
+    return -5;
+}
+
+// ---------- ASTC decode through astcenc: N blocks in one row-major image (nbx wide) → RGBA8 pixels (4*nbx wide) ----------
+static int astc_decode(const uint8_t *blocks, int nbx, int nby, int srgb, uint8_t *rgba) {
+    char in[300], out[300], cmd[900];
+    snprintf(in, sizeof in, "%s/in.astc", tmpdir); snprintf(out, sizeof out, "%s/out.ktx", tmpdir);
+    FILE *f = fopen(in, "wb"); if (!f) return -1;
+    int w = nbx * 4, h = nby * 4;
+    uint8_t hd[16] = {0x13, 0xAB, 0xA1, 0x5C, 4, 4, 1, (uint8_t)w, (uint8_t)(w >> 8), (uint8_t)(w >> 16), (uint8_t)h, (uint8_t)(h >> 8), (uint8_t)(h >> 16), 1, 0, 0};
+    fwrite(hd, 1, 16, f); fwrite(blocks, 16, (size_t)nbx * nby, f); fclose(f);
+    snprintf(out, sizeof out, "%s/out.tga", tmpdir);
+    snprintf(cmd, sizeof cmd, "\"%s\" %s \"%s\" \"%s\" >/dev/null 2>&1", astcenc, srgb ? "-ds" : "-dl", in, out);
+    if (system(cmd) != 0) return -2;
+    f = fopen(out, "rb"); if (!f) return -3;
+    fseek(f, 0, SEEK_END); long fs = ftell(f); fseek(f, 0, SEEK_SET);
+    uint8_t *d = malloc(fs); if (fread(d, 1, fs, f) != (size_t)fs) { fclose(f); free(d); return -4; } fclose(f);
+    int type = d[2], bpp = d[16], top = (d[17] >> 5) & 1, tw = d[12] | d[13] << 8, th = d[14] | d[15] << 8;
+    if ((type != 2 && type != 10) || bpp != 32 || tw != w || th != h) { free(d); return -5; }
+    const uint8_t *p = d + 18 + d[0]; size_t npx = (size_t)w * h, i = 0; uint8_t *lin = malloc(npx * 4);
+    while (i < npx) {
+        if (type == 2) { memcpy(lin + i * 4, p, 4); p += 4; i++; continue; }
+        int hd = *p++, cnt = (hd & 127) + 1;
+        for (int k = 0; k < cnt && i < npx; k++, i++) { memcpy(lin + i * 4, p, 4); if (hd & 128) continue; p += 4; }
+        if (hd & 128) p += 4;
+    }
+    for (int y = 0; y < h; y++) for (int x = 0; x < w; x++) {
+        const uint8_t *s = lin + ((size_t)(top ? y : h - 1 - y) * w + x) * 4; uint8_t *o = rgba + ((size_t)y * w + x) * 4;
+        o[0] = s[2]; o[1] = s[1]; o[2] = s[0]; o[3] = s[3];
+    }
+    free(lin); free(d);
+    return 0;
+}
+
+// ---------- block generators ----------
+enum { K1 = NVN_BCA_BC1_RGBA, K2 = NVN_BCA_BC2, K3 = NVN_BCA_BC3, K4 = NVN_BCA_BC1_RGB };
+typedef struct { const char *name; int kind; void (*gen)(uint8_t b[16]); int (*ok)(const uint8_t b[16]); int layout, swap, max_rgb; double psnr_rgb; int max_a; double psnr_a; } cat_t;
+
+static void put16(uint8_t *b, uint32_t v) { b[0] = (uint8_t)v; b[1] = (uint8_t)(v >> 8); }
+static void put32(uint8_t *b, uint32_t v) { put16(b, v & 0xffff); put16(b + 2, v >> 16); }
+static uint32_t get32(const uint8_t *b) { return b[0] | b[1] << 8 | b[2] << 16 | (uint32_t)b[3] << 24; }
+static void colblk(uint8_t *b, uint32_t c0, uint32_t c1, uint32_t ix) { put16(b, c0); put16(b + 2, c1); put32(b + 4, ix); }
+static uint32_t rampidx(void) { uint32_t ix = 0; for (int i = 0; i < 16; i++) ix |= (uint32_t)(((i & 3) + (i >> 2)) * 3 / 6) << (2 * i); return ix; }
+static uint32_t rnd565(void) { return rndn(65536); }
+static void esums(const uint8_t *cb, int *s0, int *s1) {
+    uint32_t w[4] = {get32(cb), 0, 0, 0}; int ref[16]; bca_col(w[0] & 0xffff, w[0] >> 16, 0, ref);
+    *s0 = ref[0] + ref[1] + ref[2]; *s1 = ref[4] + ref[5] + ref[6];
+}
+static int sums7(const uint8_t *cb, int *s0, int *s1) {
+    uint32_t w = get32(cb); int ref[16]; bca_col(w & 0xffff, w >> 16, 1, ref); *s0 = 0; *s1 = 0;
+    for (int c = 0; c < 3; c++) { int q0 = bca_near7(ref[c]), q1 = bca_near7(ref[4 + c]); *s0 += (q0 << 1) | (q0 >> 6); *s1 += (q1 << 1) | (q1 >> 6); }
+    return 0;
+}
+
+static void g_bc1_op(uint8_t *b) { uint32_t a = rnd565(), c = rnd565(); if (a == c) c ^= 0x20; if (a < c) { uint32_t t = a; a = c; c = t; } colblk(b, a, c, rnd32()); }
+static int ok_bc1_noswap(const uint8_t *b) { int s0, s1; esums(b, &s0, &s1); return s1 >= s0; }
+static int ok_bc1_swap(const uint8_t *b) { int s0, s1; esums(b, &s0, &s1); return s1 < s0; }
+static void g_bc1_ramp(uint8_t *b) { uint32_t a = rnd565(), c = (a & 0xffe0) ^ 0x0841; if (a < c) { uint32_t t = a; a = c; c = t; } colblk(b, a, c, rampidx()); }
+static void g_bc1_pt(uint8_t *b) { uint32_t a = rnd565(), c = rnd565(); if (a > c) { uint32_t t = a; a = c; c = t; } colblk(b, a, c, rnd32()); }
+static int ok_pt_noswap(const uint8_t *b) { int s0, s1; sums7(b, &s0, &s1); return s1 >= s0; }
+static int ok_pt_swap(const uint8_t *b) { int s0, s1; sums7(b, &s0, &s1); return s1 < s0; }
+static void g_bc1_pt_no3(uint8_t *b) { uint32_t a = rnd565(), c = rnd565(); if (a > c) { uint32_t t = a; a = c; c = t; } uint32_t ix = 0; for (int i = 0; i < 16; i++) ix |= rndn(3) << (2 * i); colblk(b, a, c, ix); }
+static void g_bc1_pt_edge(uint8_t *b) {
+    uint32_t pick = rndn(4); uint32_t a = pick == 0 ? 0 : rnd565(), c = pick == 1 ? 0xffff : rnd565(); if (a > c) { uint32_t t = a; a = c; c = t; } colblk(b, a, c, rnd32()); }
+static void g_bc1_solid(uint8_t *b) { uint32_t a = rnd565(); colblk(b, a, a, rnd32()); }
+static void g_bc1_all(uint8_t *b) { for (int i = 0; i < 8; i++) b[i] = (uint8_t)rnd32(); }
+static void g_bc1_rgb_edge(uint8_t *b) {   // structured black region (half-block / corner / row from bca_p2) + arbitrary 3-colour endpoints
+    uint32_t a = rnd565(), c = rnd565(); if (a > c) { uint32_t t = a; a = c; c = t; }
+    uint32_t m = bca_p2[rndn(64)] & 0xffffu; if (rndn(2)) m = (~m) & 0xffffu;
+    uint32_t ix = 0;
+    for (int i = 0; i < 16; i++) ix |= (((m >> i) & 1u) ? 3u : rndn(3)) << (2 * i);
+    colblk(b, a, c, ix);
+}
+static void g_bc1_rgb_speck(uint8_t *b) {   // saturated endpoints where one channel is shared (e.g. c0=0x07E0, c1=0xFFFF) and random indices including 3
+    static const uint16_t pairs[6][2] = { {0x07E0, 0xFFFF}, {0x001F, 0xFFFF}, {0xF800, 0xFFFF}, {0x07FF, 0xFFFF}, {0x001F, 0x07FF}, {0x07E0, 0xFFE0} };
+    uint32_t p = rndn(6); colblk(b, pairs[p][0], pairs[p][1], rnd32() | 0xC0u);
+}
+
+static void alpha2(uint8_t *b, uint32_t (*f)(int)) { uint32_t lo = 0, hi = 0; for (int i = 0; i < 8; i++) lo |= f(i) << (4 * i); for (int i = 8; i < 16; i++) hi |= f(i) << (4 * (i - 8)); put32(b, lo); put32(b + 4, hi); }
+static uint32_t alpha_k = 0;
+static uint32_t af_const(int i) { (void)i; return alpha_k; }
+static uint32_t af_rand(int i) { (void)i; return rndn(16); }
+static uint32_t af_ramp(int i) { return (uint32_t)((i & 3) * 4 + (i >> 2) * 1 + (alpha_k & 3)) % 16; }
+static void colorpart(uint8_t *b, int mode) {
+    uint32_t a = rnd565(), c = rnd565();
+    if (mode == 1) { a = rnd565() & 0x7bef; c = rnd565() | 0x8410; }
+    if (mode == 2) { a = rnd565() | 0x8410; c = rnd565() & 0x7bef; }
+    colblk(b + 8, a, c, rnd32());
+}
+static void g_bc2_a255(uint8_t *b) { alpha_k = 15; alpha2(b, af_const); colorpart(b, 0); }
+static void g_bc2_const(uint8_t *b) { alpha_k = rndn(15); alpha2(b, af_const); colorpart(b, 0); }
+static void g_bc2_rand(uint8_t *b) { alpha2(b, af_rand); colorpart(b, 0); }
+static void g_bc2_ramp(uint8_t *b) { alpha_k = rndn(4); alpha2(b, af_ramp); colorpart(b, 0); }
+static void g_bc2_swap(uint8_t *b) { alpha2(b, af_ramp); colorpart(b, 2); }
+static void g_bc2_noswap(uint8_t *b) { alpha2(b, af_ramp); colorpart(b, 1); }
+static void bc3a(uint8_t *b, uint32_t a0, uint32_t a1, uint64_t ix) { b[0] = (uint8_t)a0; b[1] = (uint8_t)a1; for (int i = 0; i < 6; i++) b[2 + i] = (uint8_t)(ix >> (8 * i)); }
+static uint64_t ix3(int mode) {
+    uint64_t ix = 0;
+    for (int i = 0; i < 16; i++) { uint64_t v = mode == 0 ? rndn(8) : (mode == 1 ? rndn(6) : (uint64_t)(((i & 3) + (i >> 2)) * 7 / 6)); ix |= v << (3 * i); }
+    return ix;
+}
+static void g_bc3_a255(uint8_t *b) { bc3a(b, 255, 255, ix3(1)); colorpart(b, 0); }
+static void g_bc3_const(uint8_t *b) { uint32_t a = rndn(255); bc3a(b, a, a, ix3(1)); colorpart(b, 0); }
+static void g_bc3_rand8(uint8_t *b) { uint32_t a = rndn(256), c = rndn(256); if (a < c) { uint32_t t = a; a = c; c = t; } if (a == c) a++; bc3a(b, a & 255, c, ix3(0)); colorpart(b, 0); }
+static void g_bc3_rand6(uint8_t *b) { uint32_t a = rndn(256), c = rndn(256); if (a > c) { uint32_t t = a; a = c; c = t; } bc3a(b, a, c, ix3(0)); colorpart(b, 0); }
+static void g_bc3_ramp(uint8_t *b) { bc3a(b, 255, rndn(100), ix3(2)); colorpart(b, 0); }
+static void g_bc3_swap(uint8_t *b) { bc3a(b, 255, rndn(100), ix3(2)); colorpart(b, 2); }
+static void g_bc3_noswap(uint8_t *b) { bc3a(b, 255, rndn(100), ix3(2)); colorpart(b, 1); }
+
+static uint32_t af_gentle(int i) { return alpha_k + (uint32_t)((i & 3) + (i >> 2)) * 2 / 6; }
+static void g_bc2_gentle(uint8_t *b) { alpha_k = rndn(13); alpha2(b, af_gentle); colorpart(b, 0); }
+static void g_bc2_const_swap(uint8_t *b) { alpha_k = rndn(15); alpha2(b, af_const); colorpart(b, 2); }
+static void g_bc3_gentle(uint8_t *b) { uint32_t a1 = rndn(200), a0 = a1 + 8 + rndn(25); bc3a(b, a0, a1, ix3(2)); colorpart(b, 0); }
+static void g_bc3_gentle_noise(uint8_t *b) { uint32_t a1 = rndn(200), a0 = a1 + 8 + rndn(25); bc3a(b, a0, a1, ix3(0)); colorpart(b, 0); }
+static void g_solid1(uint8_t *b) { uint32_t a = rnd565(), c = rnd565(); if (a == c) c ^= 1; if (a < c) { uint32_t t = a; a = c; c = t; } colblk(b, a, c, 0x55555555u * rndn(4)); }
+static void g_solid2(uint8_t *b) { alpha_k = rndn(16); alpha2(b, af_const); colorpart(b, 0); put32(b + 12, 0x55555555u * rndn(4)); }
+static void g_solid3(uint8_t *b) { uint32_t a = rndn(256); bc3a(b, a, a, 0); colorpart(b, 0); put32(b + 12, 0x55555555u * rndn(4)); }
