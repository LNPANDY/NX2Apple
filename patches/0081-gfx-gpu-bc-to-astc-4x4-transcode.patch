+BCA_FN s32 bca_near6(s32 x) {   // 6-bit endpoint index whose bit-replicated 8-bit value is nearest to x
+    s32 q = x >> 2, best = q, bd = 1 << 20;
+    for (s32 k = 0; k < 3; k++) {
+        s32 c = q - 1 + k;
+        if (c < 0 || c > 63) continue;
+        s32 u = (c << 2) | (c >> 4), d = u - x; d = d < 0 ? -d : d;
+        if (d < bd) { bd = d; best = c; }
+    }
