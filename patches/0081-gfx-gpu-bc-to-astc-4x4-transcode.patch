+// ---------- reference decode (bcdec; BC1 RGB forces opaque alpha so index 3 in 3-colour mode is (0, 0, 0, 255)) ----------
+static void ref_decode(int kind, const uint8_t *b, uint8_t px[16][4]) {
+    if (kind == K1 || kind == K4) {
+        bcdec_bc1(b, px, 16);
+        if (kind == K4) for (int i = 0; i < 16; i++) px[i][3] = 255;
+    } else if (kind == K2) bcdec_bc2(b, px, 16);
+    else bcdec_bc3(b, px, 16);
+}
+
+typedef struct { int n, layout[6], swapped; int maxrgb, maxa, bad_rgb3; double se_rgb, se_a; int nrgb, na; } stat_t;
+
+static int run_cat(const cat_t *c, int n, int srgb, stat_t *st, uint8_t *bcs, uint8_t *astc) {
+    memset(st, 0, sizeof *st);
+    for (int i = 0; i < n; i++) {
+        uint8_t *b = bcs + (size_t)i * 16; int tries = 0;
+        do { memset(b, 0, 16); c->gen(b); } while (c->ok && !c->ok(b + ((c->kind == K1 || c->kind == K4) ? 0 : 8)) && ++tries < 1000);
+        uint32_t w[4], o[4]; memcpy(w, b, 16);
+        uint32_t r = bca_transcode(w, (u32)c->kind, o);
+        st->layout[r & 0xff]++; if (r & BCA_SWAPPED) st->swapped++;
+        memcpy(astc + (size_t)i * 16, o, 16);
+    }
+    int nbx = 64, nby = (n + nbx - 1) / nbx;
+    uint8_t *img = malloc((size_t)nbx * nby * 16 * 16);
+    uint8_t *padded = calloc((size_t)nbx * nby, 16); memcpy(padded, astc, (size_t)n * 16);
+    for (int i = n; i < nbx * nby; i++) { uint32_t o[4], bc[4] = {0, 0, 0, 0}; bca_transcode(bc, 1, o); memcpy(padded + (size_t)i * 16, o, 16); }
+    int rc = astc_decode(padded, nbx, nby, srgb, img);
+    if (rc) { printf("  astcenc decode failed (%d)\n", rc); free(img); free(padded); return rc; }
+    for (int i = 0; i < n; i++) {
+        const uint8_t *b = bcs + (size_t)i * 16;
+        uint8_t ref[16][4]; ref_decode(c->kind, b, ref);
+        uint32_t c0 = b[0] | b[1] << 8, c1 = b[2] | b[3] << 8, ix = get32(b + 4);
+        int bx = i % nbx, by = i / nbx;
+        for (int t = 0; t < 16; t++) {
+            const uint8_t *p = img + (((size_t)(by * 4 + t / 4) * nbx * 4) + bx * 4 + (t & 3)) * 4;
+            int skip = c->kind == K1 && ref[t][3] == 0;   // BC1 RGBA transparent texel only: BC1 RGB index 3 is opaque black and MUST match (0,0,0,255)
+            if (c->kind == K4 && c0 <= c1 && ((ix >> (2 * t)) & 3u) == 3u) {
+                if (p[0] != 0 || p[1] != 0 || p[2] != 0 || p[3] != 255) st->bad_rgb3++;
+            }
+            for (int k = 0; k < 4; k++) {
+                if (skip && k < 3) continue;
+                int d = abs((int)p[k] - (int)ref[t][k]);
+                if (k < 3) { if (d > st->maxrgb) st->maxrgb = d; st->se_rgb += (double)d * d; st->nrgb++; }
+                else { if (d > st->maxa) st->maxa = d; st->se_a += (double)d * d; st->na++; }
+            }
+        }
+    }
+    st->n = n; free(img); free(padded); return 0;
+}
+static double psnr(double se, int n) { if (se == 0) return 99.0; return 10.0 * log10(255.0 * 255.0 / (se / n)); }
+
+// ---------- checks that do not need astcenc ----------
+static void check_trit_table(void) {
+    for (int T = 0; T < 256; T++) {
+        uint32_t t[5]; decode_trit_group((uint32_t)T, t);
+        int k = (int)(t[0] + 3 * t[1] + 9 * t[2] + 27 * t[3] + 81 * t[4]);
+        if (k < 243) { int e = bca_trit_enc[k]; CHECK(e < 256, "trit table entry %d", k); }
+    }
+    for (int k = 0; k < 243; k++) {
+        uint32_t t[5]; decode_trit_group(bca_trit_enc[k], t);
+        CHECK((int)(t[0] + 3 * t[1] + 9 * t[2] + 27 * t[3] + 81 * t[4]) == k, "trit table: entry %d decodes to a different trit vector", k);
+    }
+}
+static void check_col_vs_bcdec(void) {
+    int bad = 0;
+    for (int i = 0; i < 20000; i++) {
+        uint8_t b[8]; for (int k = 0; k < 8; k++) b[k] = (uint8_t)rnd32();
+        uint8_t px[16][4]; bcdec_bc1(b, px, 16);
+        uint32_t c0 = b[0] | b[1] << 8, c1 = b[2] | b[3] << 8, ix = get32(b + 4); int ref[16]; bca_col(c0, c1, c0 <= c1, ref);
+        for (int t = 0; t < 16; t++) { int k = (ix >> (2 * t)) & 3; for (int c = 0; c < 4; c++) if (ref[k * 4 + c] != px[t][c]) bad++; }
+    }
+    CHECK(bad == 0, "bca_col differs from bcdec in %d values", bad);
+}
+static void check_bc1_rgb_opaque_black(void) {   // regression for PR #1563 review item 1: BC1 RGB three-colour index 3 must decode to (0, 0, 0, 255)
+    // 1. Explicit saturated green/white case from review: c0=0x07E0 (0,255,0), c1=0xFFFF (255,255,255), rows of index 0, 1, 2, 3
+    uint8_t ex[8] = {0xE0, 0x07, 0xFF, 0xFF, 0x00, 0x55, 0xAA, 0xFF}, astc[16], dec[16][4], ref[16][4];
+    nvn_bc2astc(0x41, ex, 8, 4, 4, astc, 16);
+    ref_decode(K4, ex, ref);
+    CHECK(astc_soft_decode(astc, dec) == 0, "BC1 RGB c0=0x07E0, c1=0xFFFF block failed ASTC decode");
+    int ex_bad = 0;
+    for (int t = 0; t < 16; t++) for (int c = 0; c < 4; c++) if (dec[t][c] != ref[t][c]) ex_bad++;
+    CHECK(ex_bad == 0, "BC1 RGB c0=0x07E0, c1=0xFFFF differs in %d channel values (got idx3=(%u,%u,%u,%u), expected (0,0,0,255))",
+          ex_bad, dec[12][0], dec[12][1], dec[12][2], dec[12][3]);
+
+    // 2. All-index-3 block in BC1 RGB (0x41 / 0x45) must decode to (0,0,0,255), whereas BC1 RGBA (0x42 / 0x46) decodes to (0,0,0,0)
+    uint8_t all3[8] = {0xE0, 0x07, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF}, astc_rgba[16], dec_rgba[16][4];
+    nvn_bc2astc(0x45, all3, 8, 4, 4, astc, 16);
+    nvn_bc2astc(0x46, all3, 8, 4, 4, astc_rgba, 16);
+    CHECK(astc_soft_decode(astc, dec) == 0 && astc_soft_decode(astc_rgba, dec_rgba) == 0, "all-index-3 BC1 blocks failed ASTC decode");
+    CHECK(dec[0][0] == 0 && dec[0][1] == 0 && dec[0][2] == 0 && dec[0][3] == 255, "BC1 RGB all-index-3 must decode to (0,0,0,255)");
+    CHECK(dec_rgba[0][3] == 0, "BC1 RGBA all-index-3 must decode to alpha 0");
+}
