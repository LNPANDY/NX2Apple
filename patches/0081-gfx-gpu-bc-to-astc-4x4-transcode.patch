+        u32 sw = 0;
+        if (u1[0] + u1[1] + u1[2] < u0[0] + u0[1] + u0[2]) {   // blue contraction would apply: swap all endpoints, invert both planes
+            sw = BCA_SWAPPED;
+            for (u32 c = 0; c < 3; c++) { s32 t = q0[c]; q0[c] = q1[c]; q1[c] = t; }
+            s32 t = a0; a0 = a1; a1 = t;
+            for (u32 i = 0; i < 16; i++) { wc[i] = 2u - wc[i]; wa[i] = 2u - wa[i]; }
+        }
+        u32 ev[8], wv[32], tmp[4] = { 0, 0, 0, 0 };
+        for (u32 c = 0; c < 3; c++) { ev[2 * c] = (u32)q0[c]; ev[2 * c + 1] = (u32)q1[c]; }
+        ev[6] = (u32)a0; ev[7] = (u32)a1;
+        bca_putl(out, 0, 128, 11, 0x451u); bca_putl(out, 13, 128, 4, 12u);
+        for (u32 i = 0; i < 8; i++) bca_putl(out, 17 + 7 * i, 128, 7, ev[i]);
+        for (u32 i = 0; i < 16; i++) { wv[2 * i] = wc[i]; wv[2 * i + 1] = wa[i]; }
+        u32 nbits = bca_ise_trit(tmp, 0, wv, 32, 0);
+        bca_rev(out, tmp, nbits);
+        bca_putl(out, 128u - nbits - 2u, 128, 2, 3u);
+        return BCA_L2_BC1_PUNCH | sw;
+    }
+
+    if (three) {   // L4: BC1 RGB three-colour mode. Every index-3 texel decodes to exact opaque black (0, 0, 0, 255)
+        u32 m[4] = { 0, 0, 0, 0 }, cnt[4] = { 0, 0, 0, 0 };
+        for (u32 i = 0; i < 16; i++) { u32 k = (u32)ci[i]; m[k] |= 1u << i; cnt[k]++; }
+        u32 nk = (cnt[0] ? 1u : 0u) + (cnt[1] ? 1u : 0u) + (cnt[2] ? 1u : 0u);
+        if (!cnt[3] || c0 == c1 || nk <= 1u) {   // single plane 0x051 (trit weights 0/32/64, 8-bit RGB direct): exact when index 3 is absent or paired with one non-black colour
+            s32 e0[3], e1[3]; u32 wv[16], tmp[4] = { 0, 0, 0, 0 }, sw = 0;
+            if (!cnt[3]) {
+                for (u32 c = 0; c < 3; c++) { e0[c] = ref[c]; e1[c] = ref[4 + c]; }
+                for (u32 i = 0; i < 16; i++) { u32 k = (u32)ci[i]; wv[i] = k == 0u ? 0u : (k == 1u ? 2u : 1u); }
+                if (e1[0] + e1[1] + e1[2] < e0[0] + e0[1] + e0[2]) {
+                    for (u32 c = 0; c < 3; c++) { s32 t = e0[c]; e0[c] = e1[c]; e1[c] = t; }
+                    for (u32 i = 0; i < 16; i++) wv[i] = 2u - wv[i];
+                    sw = BCA_SWAPPED;
+                }
+            } else {
+                u32 pk = cnt[0] ? 0u : (cnt[1] ? 1u : 2u);
+                for (u32 c = 0; c < 3; c++) { e0[c] = 0; e1[c] = ref[4u * pk + c]; }
+                for (u32 i = 0; i < 16; i++) wv[i] = ci[i] == 3 ? 0u : 2u;
+            }
+            bca_putl(out, 0, 128, 11, 0x051u); bca_putl(out, 13, 128, 4, 8u);
+            for (u32 c = 0; c < 3; c++) { bca_putl(out, 17 + 16 * c, 128, 8, (u32)e0[c]); bca_putl(out, 25 + 16 * c, 128, 8, (u32)e1[c]); }
+            u32 nbits = bca_ise_trit(tmp, 0, wv, 16, 0);
+            bca_rev(out, tmp, nbits);
+            return BCA_L4_BC1_RGB3 | sw;
+        }
+
+        // Exact 2-partition match (0x051 + part=2 + shared CEM 8, 6-bit endpoints): black side [0, A1] holds all index-3 texels at w=0 -> exact (0, 0, 0, 255)
+        // and at most one non-black colour index at w=2; colour side holds [C0, C1] -> <= 2 levels on every texel
+        u32 m01 = m[0] | m[1], m02 = m[0] | m[2], m12 = m[1] | m[2];
+        for (u32 idx = 0; idx < 64; idx++) {
+            u32 entry = bca_p2[idx], seed = entry >> 16, mask1 = entry & 0xffffu;
+            for (u32 inv = 0; inv < 2; inv++) {
+                u32 bm = inv ? ((~mask1) & 0xffffu) : mask1;   // inv=0: black is partition 1; inv=1: black is partition 0
+                if ((bm & m[3]) != m[3]) continue;
+                u32 sp = bm & (~m[3] & 0xffffu);
+                if ((sp & m12) && (sp & m02) && (sp & m01)) continue;
+                s32 qC0[3] = { bca_near6(ref[0]), bca_near6(ref[1]), bca_near6(ref[2]) };
+                s32 qC1[3] = { bca_near6(ref[4]), bca_near6(ref[5]), bca_near6(ref[6]) };
+                s32 uC0 = ((qC0[0] << 2) | (qC0[0] >> 4)) + ((qC0[1] << 2) | (qC0[1] >> 4)) + ((qC0[2] << 2) | (qC0[2] >> 4));
+                s32 uC1 = ((qC1[0] << 2) | (qC1[0] >> 4)) + ((qC1[1] << 2) | (qC1[1] >> 4)) + ((qC1[2] << 2) | (qC1[2] >> 4));
+                u32 sw = 0;
+                if (uC1 < uC0) {
+                    for (u32 c = 0; c < 3; c++) { s32 t = qC0[c]; qC0[c] = qC1[c]; qC1[c] = t; }
+                    sw = BCA_SWAPPED;
+                }
+                s32 qA1[3] = { 0, 0, 0 };
+                if (sp) {
+                    u32 pk = (sp & m[0]) ? 0u : ((sp & m[1]) ? 1u : 2u);
+                    for (u32 c = 0; c < 3; c++) qA1[c] = bca_near6(ref[4u * pk + c]);
+                }
+                u32 ev[12], wv[16], tmp[4] = { 0, 0, 0, 0 };
+                u32 blk_off = inv ? 0u : 6u, col_off = inv ? 6u : 0u;
+                for (u32 c = 0; c < 3; c++) {
+                    ev[blk_off + 2u * c] = 0u; ev[blk_off + 2u * c + 1u] = (u32)qA1[c];
+                    ev[col_off + 2u * c] = (u32)qC0[c]; ev[col_off + 2u * c + 1u] = (u32)qC1[c];
+                }
+                for (u32 i = 0; i < 16; i++) {
+                    u32 k = (u32)ci[i];
+                    if ((bm >> i) & 1u) wv[i] = k == 3u ? 0u : 2u;
+                    else { u32 cw = k == 0u ? 0u : (k == 1u ? 2u : 1u); wv[i] = sw ? (2u - cw) : cw; }
+                }
+                bca_putl(out, 0, 128, 11, 0x051u); bca_putl(out, 11, 128, 2, 1u);
+                bca_putl(out, 13, 128, 10, seed); bca_putl(out, 23, 128, 6, 8u << 2);
+                for (u32 j = 0; j < 12; j++) bca_putl(out, 29 + 6 * j, 128, 6, ev[j]);
+                u32 nbits = bca_ise_trit(tmp, 0, wv, 16, 0);
+                bca_rev(out, tmp, nbits);
+                return BCA_L4_BC1_RGB3 | sw;
+            }
+        }
+
+        // Fallback: 1-partition dual-plane RGB (0x451 + CEM 8, 8-bit endpoints e0 = 0, CCS in 0..2); index 3 gets w0 = w1 = 0 -> exact (0, 0, 0, 255)
+        s32 dp_score = 1 << 30, dp_e1[3] = { 0, 0, 0 };
+        u32 dp_ccs = 0, dp_w0[4] = { 0, 0, 0, 0 }, dp_w1[4] = { 0, 0, 0, 0 };
+        for (u32 ccs = 0; ccs < 3; ccs++) {
+            s32 e1[3] = { ref[0] > ref[4] ? ref[0] : ref[4], ref[1] > ref[5] ? ref[1] : ref[5], ref[2] > ref[6] ? ref[2] : ref[6] };
+            u32 wk0[4] = { 0, 0, 0, 0 }, wk1[4] = { 0, 0, 0, 0 };
+            for (u32 it = 0; it < 2; it++) {
+                for (u32 k = 0; k < 3; k++) {
+                    s32 be0 = 1 << 30, be1 = 1 << 30; u32 bw0 = 0, bw1 = 0;
+                    for (u32 wi = 0; wi < 3; wi++) {
+                        s32 w = (s32)(wi * 32u), mx0 = 0, se0 = 0;
+                        for (u32 ch = 0; ch < 3; ch++) if (ch != ccs) {
+                            s32 d = bca_lerp(0, e1[ch], w) - ref[4u * k + ch];
+                            s32 ad = d < 0 ? -d : d; if (ad > mx0) mx0 = ad; se0 += d * d;
+                        }
+                        s32 sc0 = mx0 * 64 + se0;
+                        if (sc0 < be0) { be0 = sc0; bw0 = wi; }
+                        s32 d1 = bca_lerp(0, e1[ccs], w) - ref[4u * k + ccs];
+                        if (d1 * d1 < be1) { be1 = d1 * d1; bw1 = wi; }
+                    }
+                    wk0[k] = bw0; wk1[k] = bw1;
+                }
+                if (it == 0) {
+                    for (u32 ch = 0; ch < 3; ch++) {
+                        s32 num = 0, den = 0;
+                        for (u32 k = 0; k < 3; k++) if (cnt[k]) {
+                            s32 w = (s32)((ch == ccs ? wk1[k] : wk0[k]) * 32u);
+                            num += (s32)cnt[k] * w * ref[4u * k + ch] * 64;
+                            den += (s32)cnt[k] * w * w;
+                        }
+                        if (den > 0) { s32 v = (num + den / 2) / den; e1[ch] = v < 0 ? 0 : (v > 255 ? 255 : v); }
+                    }
+                }
+            }
+            s32 se = 0, mx = 0;
+            for (u32 k = 0; k < 3; k++) {
+                if (!cnt[k]) continue;
+                for (u32 ch = 0; ch < 3; ch++) {
+                    s32 d = bca_lerp(0, e1[ch], (s32)((ch == ccs ? wk1[k] : wk0[k]) * 32u)) - ref[4u * k + ch];
+                    s32 ad = d < 0 ? -d : d; if (ad > mx) mx = ad;
+                    se += (s32)cnt[k] * d * d;
+                }
+            }
+            s32 score = mx * 128 + se;
+            if (score < dp_score) {
+                dp_score = score; dp_ccs = ccs;
+                for (u32 c = 0; c < 3; c++) dp_e1[c] = e1[c];
+                for (u32 k = 0; k < 4; k++) { dp_w0[k] = wk0[k]; dp_w1[k] = wk1[k]; }
+            }
+        }
+        {
+            u32 wv[32], tmp[4] = { 0, 0, 0, 0 };
+            bca_putl(out, 0, 128, 11, 0x451u); bca_putl(out, 13, 128, 4, 8u);
+            for (u32 c = 0; c < 3; c++) { bca_putl(out, 17 + 16 * c, 128, 8, 0u); bca_putl(out, 25 + 16 * c, 128, 8, (u32)dp_e1[c]); }
+            for (u32 i = 0; i < 16; i++) { u32 k = (u32)ci[i]; wv[2 * i] = k == 3u ? 0u : dp_w0[k]; wv[2 * i + 1] = k == 3u ? 0u : dp_w1[k]; }
+            u32 nbits = bca_ise_trit(tmp, 0, wv, 32, 0);
+            bca_rev(out, tmp, nbits);
+            bca_putl(out, 128u - nbits - 2u, 128, 2, dp_ccs);
+            return BCA_L4_BC1_RGB3;
+        }
+    }
+
+    // L3: BC2 / BC3 with varying alpha. Plane 0 colour, plane 1 alpha, 2-bit weights, endpoints in 48 levels
+    s32 cw[16], vals[16], q0[4], q1[4];
+    u32 wc[16], wa[16], sw = 0;
+    for (u32 i = 0; i < 16; i++) { wc[i] = wmap[ci[i]]; cw[i] = (s32)bca_w4[wc[i]]; }
+    for (u32 c = 0; c < 3; c++) {
+        for (u32 i = 0; i < 16; i++) vals[i] = px[i][c];
+        bca_fit48(vals, cw, &q0[c], &q1[c]);
+    }
+    {   // alpha: start from min / max, then reassign the four levels and refit twice
+        s32 lo = 255, hi = 0, aw[16];
+        for (u32 i = 0; i < 16; i++) { lo = al[i] < lo ? al[i] : lo; hi = al[i] > hi ? al[i] : hi; }
+        s32 a0 = bca_near48(lo), a1 = bca_near48(hi);
+        for (u32 it = 0; it < 3; it++) {
+            for (u32 i = 0; i < 16; i++) {
+                s32 bk = 0, bd = 1 << 20;
+                for (s32 k = 0; k < 4; k++) { s32 d = bca_lerp((s32)bca_unq48[a0], (s32)bca_unq48[a1], (s32)bca_w4[k]) - al[i]; d = d < 0 ? -d : d; if (d < bd) { bd = d; bk = k; } }
+                wa[i] = (u32)bk; aw[i] = (s32)bca_w4[bk];
+            }
+            if (it < 2) bca_fit48(al, aw, &a0, &a1);
+        }
+        q0[3] = a0; q1[3] = a1;
+    }
+    {
+        s32 s0 = (s32)bca_unq48[q0[0]] + (s32)bca_unq48[q0[1]] + (s32)bca_unq48[q0[2]];
+        s32 s1 = (s32)bca_unq48[q1[0]] + (s32)bca_unq48[q1[1]] + (s32)bca_unq48[q1[2]];
+        if (s1 < s0) {
+            sw = BCA_SWAPPED;   // swap all endpoints (alpha too) and invert both planes
+            for (u32 c = 0; c < 4; c++) { s32 t = q0[c]; q0[c] = q1[c]; q1[c] = t; }
+            for (u32 i = 0; i < 16; i++) { wc[i] = 3u - wc[i]; wa[i] = 3u - wa[i]; }
+        }
+    }
+    {
+        u32 ev[8], tmp[4] = { 0, 0, 0, 0 };
+        for (u32 c = 0; c < 4; c++) { ev[2 * c] = bca_raw48[q0[c]]; ev[2 * c + 1] = bca_raw48[q1[c]]; }
+        bca_putl(out, 0, 128, 11, 0x442u); bca_putl(out, 13, 128, 4, 12u);
+        u32 n = bca_ise_trit(out, 17, ev, 8, 4);
+        for (u32 i = 0; i < 16; i++) { bca_putl(tmp, 4 * i, 128, 2, wc[i]); bca_putl(tmp, 4 * i + 2, 128, 2, wa[i]); }
+        bca_rev(out, tmp, 64);
+        bca_putl(out, 128u - 64u - 2u, 128, 2, 3u);
+        (void)n;
+        return BCA_L3_ALPHA | sw;
+    }
+}
+)
diff --git a/dm/gfx/tex/bc2astc_core.h b/dm/gfx/tex/bc2astc_core.h
new file mode 100644
index 0000000..6b2d0b6
--- /dev/null
+++ b/dm/gfx/tex/bc2astc_core.h
@@ -0,0 +1,14 @@
+// BC1 / BC2 / BC3 block → ASTC 4x4 LDR block (16 bytes), integer only. Public C interface: nvn_bc2astc.h. See dm/gfx/tex/README.md ("Devices without BC support") for the layouts and bit budgets.
+// The code is in bc2astc_body.inc, which is written in the subset of C that Metal Shading Language also accepts; bc2astc_msl.h turns the same text into the GPU kernel (nvn_mtl.m, tests).
+// The C build is the reference and the GPU output must match it bit for bit (dm/gfx/tests/t_bc2astc_gpu.m).
+// Rules for editing the body: no floats, no static state, no pointers except the BCA_T arrays, fixed loop counts, 64-bit integers only where they already are, no preprocessor lines or string literals.
+#pragma once
+#include <stdint.h>
+typedef uint32_t u32; typedef int32_t s32; typedef int64_t s64; typedef uint64_t u64; typedef uint8_t u8;
+#define BCA_FN static inline   // MSL: inline
+#define BCA_T                  // MSL: thread
+#define BCA_K static const     // MSL: constant
+
+#define BCA_BODY(...) __VA_ARGS__
+#include "bc2astc_body.inc"
+#undef BCA_BODY
diff --git a/dm/gfx/tex/bc2astc_msl.h b/dm/gfx/tex/bc2astc_msl.h
new file mode 100644
index 0000000..e4e352e
--- /dev/null
+++ b/dm/gfx/tex/bc2astc_msl.h
@@ -0,0 +1,19 @@
+// The Metal source of the BC1/2/3 → ASTC 4x4 transcoder: the text of bc2astc_body.inc (stringified) plus the kernel `bca`. Include in one place per program; the string is nvn_bca_msl.
+// Kernel: one thread per BC block. buffer(0) the BC blocks (bytes), buffer(1) BcaP, buffer(2) the ASTC blocks (written as four words per block, so off_out and pitch_out are multiples of 16).
+#pragma once
+#define BCA_BODY(...) #__VA_ARGS__
+static const char nvn_bca_msl[] =
+"#include <metal_stdlib>\nusing namespace metal;\n"
+"typedef uint u32; typedef int s32; typedef long s64; typedef ulong u64; typedef uchar u8;\n"
+"#define BCA_FN inline\n#define BCA_T thread\n#define BCA_K constant\n"
+#include "bc2astc_body.inc"
+"\nstruct BcaP { uint off_in, pitch_in, off_out, pitch_out, nbx, nby, kind; };\n"   // pitch_in: bytes per BC block row; kind: 1 BC1 RGBA, 2 BC2, 3 BC3, 4 BC1 RGB
+"kernel void bca(device const uchar *src [[buffer(0)]], device const BcaP &p [[buffer(1)]], device uint *dst [[buffer(2)]], uint2 g [[thread_position_in_grid]]) {\n"
+"  if (g.x >= p.nbx || g.y >= p.nby) return;\n"
+"  uint bb = (p.kind == 1 || p.kind == 4) ? 8 : 16; device const uchar *b = src + p.off_in + g.y * p.pitch_in + g.x * bb;\n"
+"  u32 w[4], o[4];\n"
+"  for (uint i = 0; i < 4; i++) w[i] = i * 4 < bb ? (u32(b[i * 4]) | (u32(b[i * 4 + 1]) << 8) | (u32(b[i * 4 + 2]) << 16) | (u32(b[i * 4 + 3]) << 24)) : 0;\n"
+"  bca_transcode(w, p.kind, o);\n"
+"  device uint *d = dst + (p.off_out + g.y * p.pitch_out + g.x * 16) / 4;\n"
+"  for (uint i = 0; i < 4; i++) d[i] = o[i]; }\n";
+#undef BCA_BODY
diff --git a/dm/gfx/tex/nvn_bc2astc.c b/dm/gfx/tex/nvn_bc2astc.c
new file mode 100644
index 0000000..9acd06d
--- /dev/null
+++ b/dm/gfx/tex/nvn_bc2astc.c
@@ -0,0 +1,35 @@
+// See nvn_bc2astc.h. The transcoder itself is bc2astc_core.h.
+#include "nvn_bc2astc.h"
+#include "bc2astc_core.h"
+#include <string.h>
+
+int nvn_bc_astc_fmt(uint32_t f, uint32_t *pf, int *kind) {
+    // NVN: 0x41 RGB_DXT1, 0x42 RGBA_DXT1, 0x43 DXT3, 0x44 DXT5, 0x45–0x48 the same in sRGB
+    if (f < 0x41 || f > 0x48) return 0;
+    *pf = f >= 0x45 ? 186 : 204;
+    uint32_t m = f & 3u;
+    *kind = m == 1u ? NVN_BCA_BC1_RGB : (m == 2u ? NVN_BCA_BC1_RGBA : (m == 3u ? NVN_BCA_BC2 : NVN_BCA_BC3));
+    return 1;
+}
+
+uint32_t nvn_bc2astc_block(int kind, const uint8_t *bc, uint8_t *astc) {
+    if (kind < 1 || kind > 4) { memset(astc, 0, 16); return 0; }
+    uint32_t w[4] = {0, 0, 0, 0}, o[4];
+    memcpy(w, bc, (kind == NVN_BCA_BC1_RGBA || kind == NVN_BCA_BC1_RGB) ? 8 : 16);
+    uint32_t r = bca_transcode(w, (u32)kind, o);
+    memcpy(astc, o, 16);
+    return r;
+}
+
+int nvn_bc2astc(uint32_t f, const uint8_t *src, size_t pitch, uint32_t w, uint32_t h, uint8_t *dst, size_t dpitch) {
+    uint32_t pf; int kind; if (!nvn_bc_astc_fmt(f, &pf, &kind)) return -1;
+    size_t bb = (kind == NVN_BCA_BC1_RGBA || kind == NVN_BCA_BC1_RGB) ? 8 : 16;
+    for (uint32_t by = 0; by * 4 < h; by++) for (uint32_t bx = 0; bx * 4 < w; bx++)
+        nvn_bc2astc_block(kind, src + by * pitch + bx * bb, dst + by * dpitch + (size_t)bx * 16);
+    return 0;
+}
+
+void nvn_astc_zero_block(uint8_t out[16]) {
+    static const uint8_t z[16] = {0xFC, 0xFD, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};   // void-extent block, colour 0
+    memcpy(out, z, 16);
+}
diff --git a/dm/gfx/tex/nvn_bc2astc.h b/dm/gfx/tex/nvn_bc2astc.h
new file mode 100644
index 0000000..779420c
--- /dev/null
+++ b/dm/gfx/tex/nvn_bc2astc.h
@@ -0,0 +1,16 @@
+// GPUs without BC support: BC1 / BC2 / BC3 (NVN 0x41–0x48) are stored as ASTC 4x4 (8 bits per texel) by transcoding every BC block into one ASTC block, which is 4× smaller than RGBA8.
+// The algorithm is bc2astc_core.h, which the GPU kernel (nvn_mtl.m) compiles from the same text; this file is the CPU side (sparse pools, copy_b2t, tests) and the reference for the kernel.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+enum { NVN_BCA_BC1_RGBA = 1, NVN_BCA_BC2 = 2, NVN_BCA_BC3 = 3, NVN_BCA_BC1_RGB = 4 };
+
+// NVN format is BC1/2/3 → returns 1, *mtl_pf = MTLPixelFormatASTC_4x4_LDR (204) or ASTC_4x4_sRGB (186), *kind = NVN_BCA_* (1..4); returns 0 for every other format
+int nvn_bc_astc_fmt(uint32_t nvn_fmt, uint32_t *mtl_pf, int *kind);
+// One block: bc has 8 bytes (kind 1 or 4, BC1) or 16 bytes (kind 2 or 3, BC2/BC3), astc receives 16 bytes. Returns the layout id of bc2astc_core.h (| BCA_SWAPPED)
+uint32_t nvn_bc2astc_block(int kind, const uint8_t *bc, uint8_t *astc);
+// A w×h texel region: src has pitch bytes per block row, dst dpitch bytes per block row (16 per ASTC block). Returns 0 on success, -1 if the format is not BC1/2/3
+int nvn_bc2astc(uint32_t nvn_fmt, const uint8_t *src, size_t pitch, uint32_t w, uint32_t h, uint8_t *dst, size_t dpitch);
+// The block that ASTC textures are filled with where BC textures are zero-filled: a constant (0,0,0,0) block (an all-zero ASTC block is invalid)
+void nvn_astc_zero_block(uint8_t out[16]);
diff --git a/dm/gfx/tex/nvn_texkey.h b/dm/gfx/tex/nvn_texkey.h
new file mode 100644
index 0000000..394a5a3
--- /dev/null
+++ b/dm/gfx/tex/nvn_texkey.h
@@ -0,0 +1,13 @@
+// Identity of a packaged (block-linear) texture across runs, computed from the bytes the game stores: used by the BC3 keep table (dm/games/<id>/bc3_keep_rgba8.tsv), which names the BC3 textures
+// that stay RGBA8 on GPUs without BC because ASTC would lose too much alpha. The benchmark (tests/bench_bc2astc_dread.c) and the host compute the key with this one function.
+#pragma once
+#include <stdint.h>
+
+// 64-bit FNV-1a over the first min(size, 64 KB) bytes of the storage, then mixed with the total size, NVN format, width, height and level count
+static inline uint64_t nvn_texkey(const void *storage, uint64_t size, uint32_t fmt, uint32_t w, uint32_t h, uint32_t levels) {
+    const uint8_t *p = storage; uint64_t n = size < 65536 ? size : 65536, x = 0xcbf29ce484222325ull;
+    for (uint64_t i = 0; i < n; i++) { x ^= p[i]; x *= 0x100000001b3ull; }
+    uint64_t m[5] = {size, fmt, w, h, levels};
+    for (int i = 0; i < 5; i++) { x ^= m[i]; x *= 0x100000001b3ull; x ^= x >> 29; }
+    return x;
+}
