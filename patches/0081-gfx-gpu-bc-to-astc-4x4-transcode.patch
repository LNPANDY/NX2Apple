+// GPUs without hardware BC texture compression (A15 / A16 etc.): BC1-3 are transcoded to ASTC 4x4 (1 B/px, 1/4 of RGBA8) and BC4-7 / 3D are decompressed (GPU compute for BC4-5, parallel CPU decode for BC6H/BC7/3D).
+// DM_TEST_NO_BC=1 forces this path on BC-capable Macs; g_bc_cpu=1 also forces it for unit tests.
+static int no_bc(void) {
+    if (g_bc_cpu) return 1;
+    if (g_no_bc_cache < 0) {
+        const char *e = getenv("DM_TEST_NO_BC");
+        int hw_no_bc = g_dev ? ![g_dev supportsBCTextureCompression] : !g_bc_gpu;
+        g_no_bc_cache = (e && *e && strcmp(e, "0")) || hw_no_bc;
+        if (g_no_bc_cache) MLOG("the GPU has no BC compressed formats%s: BC textures are stored as ASTC 4x4 (BC1-3) or decompressed (see DM_NO_BC_ASTC)",
+            (e && *e && strcmp(e, "0")) ? " (test switch DM_TEST_NO_BC)" : "");
+    }
+    return g_no_bc_cache;
+}
+static int bc_unpack(uint32_t nvn_fmt, uint32_t *pf, int *bpp) { return no_bc() && nvn_bc_unpacked(nvn_fmt, pf, bpp); }
+static int keep_on(void) {
+    if (g_keep_on_cache < 0) { const char *e = getenv("DM_NO_BC_ASTC_KEEP"); g_keep_on_cache = !(e && !strcmp(e, "0")); }
+    return g_keep_on_cache;
+}
+// DM_NO_BC_ASTC=all (default, 2) | bc1 (1) | 0 (all BC decompressed to RGBA8 / R8 / RG8 / RGB9E5 / RGBA16F).
+static int astc_mode(void) {
