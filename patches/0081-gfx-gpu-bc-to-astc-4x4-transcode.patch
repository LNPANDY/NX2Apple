+        uint8_t src[4 * 3 * 16], dst[4 * 3 * 16], ref[16]; for (size_t i = 0; i < sizeof src; i++) src[i] = (uint8_t)rnd32();
+        CHECK(nvn_bc2astc(0x41, src, 3 * 8, 10, 7, dst, 3 * 16) == 0, "nvn_bc2astc 0x41 failed");
