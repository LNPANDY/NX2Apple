--- /dev/null
+++ b/dm/gfx/tests/t_bc2astc_gpu.m
@@ -0,0 +1,85 @@
+// GPU BC1 (RGBA & RGB) / BC2 / BC3 → ASTC 4x4 transcoder (kernel `bca`, text from bc2astc_msl.h) against the C reference (nvn_bc2astc.c): the output must be byte-identical.
+// Millions of blocks across all four kinds, mixed so that every layout and both swap directions are reached, through a pitched and offset source / destination; padding stays untouched.
+// Usage: t_bc2astc_gpu
+#import <Metal/Metal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include "../tex/nvn_bc2astc.h"
+#include "../tex/bc2astc_msl.h"
+
+static uint64_t rng = 0x243F6A8885A308D3ull;
+static uint32_t rnd(void) { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return (uint32_t)(rng >> 16); }
+static uint64_t now_ns(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (uint64_t)t.tv_sec * 1000000000ull + t.tv_nsec; }
+
+static void gen(int kind, uint8_t *b) {
+    for (int i = 0; i < 16; i++) b[i] = (uint8_t)rnd();
+    int is_bc1 = kind == NVN_BCA_BC1_RGBA || kind == NVN_BCA_BC1_RGB;
+    uint8_t *c = is_bc1 ? b : b + 8; uint32_t mode = rnd() % 12;
+    uint32_t c0 = c[0] | c[1] << 8, c1 = c[2] | c[3] << 8;
+    if (mode == 1) { c[4] = c[5] = c[6] = c[7] = (uint8_t)(0x55 * (rnd() & 3)); }
+    if (mode == 2) { c1 = c0; }
+    if (mode == 3) { c0 = (rnd() & 1) ? 0 : 0xffff; c1 = (rnd() & 1) ? 0 : 0xffff; }
+    if (mode == 4 && c0 < c1) { uint32_t t = c0; c0 = c1; c1 = t; }
+    if (mode == 5 && c0 > c1) { uint32_t t = c0; c0 = c1; c1 = t; }
+    c[0] = (uint8_t)c0; c[1] = (uint8_t)(c0 >> 8); c[2] = (uint8_t)c1; c[3] = (uint8_t)(c1 >> 8);
+    uint32_t am = rnd() % 8;
+    if (kind == NVN_BCA_BC2) {
+        if (am == 1) { uint8_t n = (uint8_t)(rnd() & 15); for (int i = 0; i < 8; i++) b[i] = (uint8_t)(n | n << 4); }
+        if (am == 2) { for (int i = 0; i < 8; i++) b[i] = 0xff; }
+    }
+    if (kind == NVN_BCA_BC3) {
+        if (am == 1) { b[1] = b[0]; for (int i = 2; i < 8; i++) b[i] = 0; }
+        if (am == 2) { b[0] = 255; b[1] = 255; for (int i = 2; i < 8; i++) b[i] = 0; }
+        if (am == 3 && b[0] < b[1]) { uint8_t t = b[0]; b[0] = b[1]; b[1] = t; }
+    }
+}
+
+int main(void) {
+    @autoreleasepool {
+        id<MTLDevice> dev = MTLCreateSystemDefaultDevice(); if (!dev) { printf("no Metal device\n"); return 1; }
+        NSError *err = nil; id<MTLLibrary> lib = [dev newLibraryWithSource:@(nvn_bca_msl) options:nil error:&err];
+        if (!lib) { printf("MSL compile failed: %s\n", err.localizedDescription.UTF8String); return 1; }
