+void nvn_hle_teardown(void) {
+    nq_teardown();
+    pthread_mutex_lock(&g_vp_mu);
+    for (int i = 0; i < g_nvp; i++) {
+        struct vpool *v = g_vp[i];
+        if (!v) continue;
+        if (v->base && v->len) munmap(v->base, v->len);
+        for (uint64_t l = 0; l < (v->size + (2u << 20) - 1) >> 21; l++) free(v->pt[l]);
+        free(v->pt);
+        free(v->log);
