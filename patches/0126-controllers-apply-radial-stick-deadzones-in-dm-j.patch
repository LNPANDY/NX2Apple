@@ -430,8 +431,8 @@ profile-runtime: $(B)/t_profile_runtime
 	TMPDIR="$(abspath $(B))" $(B)/t_profile_runtime
 
 run: $(B)/t_pad_map $(B)/t_pad_motion $(B)/t_controllers_mac $(B)/t_stick_deadzone
-$(B)/t_stick_deadzone: t_stick_deadzone.c ../stick_deadzone.h ../dm_input.h | $(B)
-	$(CLANG) -O1 -Wall -Werror -o $@ t_stick_deadzone.c
+$(B)/t_stick_deadzone: t_stick_deadzone.c ../stick_deadzone.h ../hle_hid.c ../motion_fusion.h ../hle_haptics.c ../hle_haptics.h ../dm_input.h ../hle.h ../dm.h $(GAME_H) | $(B)
+	$(CLANG) -O1 -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_stick_deadzone.c ../hle_haptics.c
 $(B)/t_pad_motion: t_pad_motion.c ../pad_motion.h ../dm_input.h | $(B)
 	$(CLANG) -O1 -Wall -Werror -o $@ t_pad_motion.c
 $(B)/t_pad_map: t_pad_map.c ../pad_map.h ../steam_input.h ../dm_input.h | $(B)
diff --git a/dm/host/tests/t_stick_deadzone.c b/dm/host/tests/t_stick_deadzone.c
index d9ac75c2..6b1b97bc 100644
--- a/dm/host/tests/t_stick_deadzone.c
+++ b/dm/host/tests/t_stick_deadzone.c
@@ -1,7 +1,53 @@
 #include <assert.h>
 #include <stdio.h>
 #include <stdlib.h>
-#include "../stick_deadzone.h"
+#include <time.h>
+#include <unistd.h>
+
+static int dz_clock_gettime(clockid_t clock, struct timespec *ts) { (void)clock; *ts = (struct timespec){.tv_sec = 1}; return 0; }
