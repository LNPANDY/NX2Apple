 static NSMutableArray *g_l3_gpu_leaks;
 static int g_nvn_deswz_gpu;
 static id<MTLCommandQueue> g_q;
@@ -388,6 +391,9 @@ void mtl_init(void) {
     g_dev = MTLCreateSystemDefaultDevice();
     if (!g_dev) MDIE("no Metal device");
     if (!g_dev.hasUnifiedMemory) MDIE("needs a unified-memory device (zero-copy memory pools)");
+    g_bc_gpu = [g_dev supportsBCTextureCompression];
+    g_bc_cpu = !g_bc_gpu && DM_GAME_TEX_BC_CPU;
+    if (g_bc_cpu) MLOG("BC textures: this GPU has no BC support, decoding them on the CPU (profile tex_bc_cpu)");
     g_q = [g_dev newCommandQueue];
     // A device without Metal 4 (the paravirtualized GPU of a virtual Mac, such as GitHub's macos-26 runner: no residency set, no MTL4CommandQueue) cannot run the NVN layer. The GL and
     // Vulkan layers draw on classic queues of their own and need only the device (mtl_device_classic): there the classic part starts and presents are dropped, which is all a
@@ -1773,7 +1779,12 @@ static MTLTextureUsage img_usage(const tex_t *t, MTLPixelFormat pf) {
 static int tex_atomic_capable(id<MTLTexture> base) { return pf_r32i(base.pixelFormat) && (base.usage & MTLTextureUsageShaderWrite); }
 static MTLTextureDescriptor *tex_desc(const tex_t *t, int packaged) {
     uint32_t pf = 0; uint8_t swz[4];
-    if (!nvn_fmt_to_mtl(t->d.format, &pf, swz) || !pf) { RED_ONCE(0, "texture format %#x has no Metal equivalent (first case)", t->d.format); return nil; }
+    // A BC format on a GPU without BC support: create the texture in the uncompressed format the
+    // decoder produces, and let the upload path fill it through nvn_bc_decode (below). Without
+    // this the Metal format is a BC one the device cannot allocate, and every such texture is nil.
+    uint32_t bc_unpacked = 0; int bc_bpp = 0;
+    if (g_bc_cpu && nvn_bc_unpacked(t->d.format, &bc_unpacked, &bc_bpp)) pf = bc_unpacked;
+    if (!pf && (!nvn_fmt_to_mtl(t->d.format, &pf, swz) || !pf)) { RED_ONCE(0, "texture format %#x has no Metal equivalent (first case)", t->d.format); return nil; }
     // Metal's limits: 16384 in 2D, 2048 in 3D, 2048 array layers; beyond them Metal aborts the process on an assertion, so they are caught here with a red line
     if (t->d.width > 16384 || t->d.height > 16384 || t->d.depth > 2048) { RED_ONCE(71, "texture size exceeds Metal limits: %u×%u×%u levels %u format %#x target %d (first case ser=%llu)", t->d.width, t->d.height, t->d.depth, t->d.levels, t->d.format, t->d.target, (unsigned long long)t->serial); return nil; }
     MTLTextureDescriptor *d = [MTLTextureDescriptor new];
@@ -2217,15 +2228,43 @@ static void zb_report(const tex_t *t, unsigned base, const char *why) {
         if (!(part = malloc(t->L.size ? t->L.size : 1))) MDIE("sparse texture copy of %llu bytes failed", (unsigned long long)t->L.size);
         nvn_sparse_copy(t->pool, part, (uint64_t)(uintptr_t)t->mem, t->L.size); src = part;
     }
+    // A BC texture on a GPU without BC support: tex_desc made the Metal texture RGBA8 (or R8/RG8,
+    // RGBA16F for BC6H), so the staging slot is per-pixel, not per-block, and the deswizzled block
+    // data is expanded through nvn_bc_decode before the blit. bc_cpu stays 0 on Macs and A19+,
+    // where the compressed path below is used unchanged.
+    uint32_t bc_pf = 0; int bc_bpp = 0;
+    int bc_cpu = g_bc_cpu && nvn_bc_unpacked(t->d.format, &bc_pf, &bc_bpp);
+    size_t total_bc = 0;
+    if (bc_cpu) {
+        total_bc = 0;
+        for (unsigned l = 0; l < d.mipmapLevelCount; l++) {
+            uint32_t w = MAX(t->d.width >> l, 1u), h = MAX(t->d.height >> l, 1u), z = t->d.target == 2 ? MAX(t->d.depth >> l, 1u) : 1;
+            total_bc += (size_t)w * h * z * layers * (size_t)bc_bpp;
+        }
+    }
     up_begin();
-    id<MTLBuffer> stg = [g_dev newBufferWithLength:total ? total : 16 options:MTLResourceStorageModeShared];
+    id<MTLBuffer> stg = [g_dev newBufferWithLength:(bc_cpu ? total_bc : total) ? (bc_cpu ? total_bc : total) : 16 options:MTLResourceStorageModeShared];
     res_add(stg); [g_up_keep addObject:stg];
     size_t off = 0;
     int zb = zblock_on() && t->d.format >= 0x79 && t->d.format <= 0x94; if (zb) { g_zb_ser = t->serial; g_zb_n = (int)MIN(d.mipmapLevelCount, 16u); memset(g_zb, 0, sizeof g_zb); memset(g_zb_tot, 0, sizeof g_zb_tot); }
+    // CPU-side scratch for the compressed block data when bc_cpu (one level-slice at a time)
+    uint8_t *bc_tmp = NULL; size_t bc_tmp_sz = 0;
     for (unsigned l = 0; l < d.mipmapLevelCount; l++) {
         uint32_t w = MAX(t->d.width >> l, 1u), h = MAX(t->d.height >> l, 1u), z = t->d.target == 2 ? MAX(t->d.depth >> l, 1u) : 1;
         size_t pitch = (size_t)((w + bw - 1) / bw) * bpb, rows = (h + bh - 1) / bh;
         for (unsigned y = 0; y < layers; y++) {
+            if (bc_cpu) {
+                size_t need = pitch * rows * z;
+                if (need > bc_tmp_sz) { free(bc_tmp); bc_tmp = malloc(need); bc_tmp_sz = need; if (!bc_tmp) MDIE("BC decode scratch of %zu bytes failed", need); }
+                if (nvn_deswizzle(&t->d, l, y, src, bc_tmp, pitch)) { RED_ONCE(9, "deswizzle failed format %#x target %d", t->d.format, t->d.target); break; }
+                size_t dst_pitch = (size_t)w * bc_bpp;
+                for (uint32_t zz = 0; zz < z; zz++)
+                    nvn_bc_decode(t->d.format, bc_tmp + (size_t)zz * pitch * rows, pitch, w, h,
+                                  (uint8_t *)stg.contents + off + (size_t)zz * dst_pitch * h, dst_pitch);
+                up_blit_add(stg, off, dst_pitch, dst_pitch * h, MTLSizeMake(w, h, z), mt, y, l);
+                off += dst_pitch * h * z;
+                continue;
+            }
             if (nvn_deswizzle(&t->d, l, y, src, (uint8_t *)stg.contents + off, pitch)) { RED_ONCE(9, "deswizzle failed format %#x target %d", t->d.format, t->d.target); break; }
             if (zb && l < 16) { const uint64_t *q = (const uint64_t *)((const uint8_t *)stg.contents + off); size_t nb = pitch * rows * z / 16;
                 for (size_t i = 0; i < nb; i++) g_zb[l] += !(q[2 * i] | q[2 * i + 1]);
@@ -2234,6 +2273,7 @@ static void zb_report(const tex_t *t, unsigned base, const char *why) {
             off += pitch * rows * z;
         }
     }
+    free(bc_tmp);
     free(part);
     up_flush();
     return mt;
diff --git a/dm/gfx/tex/nvn_bcdec.c b/dm/gfx/tex/nvn_bcdec.c
new file mode 100644
index 00000000..7b2d83c9
--- /dev/null
+++ b/dm/gfx/tex/nvn_bcdec.c
@@ -0,0 +1,58 @@
+// 见 nvn_bcdec.h。解码用 bcdec（dm/third_party/bcdec，单头文件，MIT / 公有领域）。
+// See nvn_bcdec.h. Decoding uses bcdec (dm/third_party/bcdec, single header, MIT / public domain).
+#define BCDEC_IMPLEMENTATION
+#define BCDEC_BC4BC5_PRECISE   // BC4 / BC5 带有符号版本的接口 | interface with signed variants of BC4 / BC5
+#include "../../third_party/bcdec/bcdec.h"
+#include "nvn_bcdec.h"
+#include <string.h>
+
+enum { R8Unorm = 10, R8Snorm = 12, RG8Unorm = 30, RG8Snorm = 32, RGBA8Unorm = 70, RGBA8Unorm_sRGB = 71, RGBA16Float = 115 };
+// NVN：0x41 RGB_DXT1、0x42 RGBA_DXT1、0x43 DXT3、0x44 DXT5、0x45–0x48 同上 sRGB、0x49 / 0x4a BC4 无 / 有符号、0x4b / 0x4c BC5、0x4d / 0x4e BC7（sRGB）、0x4f / 0x50 BC6H 有 / 无符号
+// NVN: 0x41 RGB_DXT1, 0x42 RGBA_DXT1, 0x43 DXT3, 0x44 DXT5, 0x45–0x48 the same in sRGB, 0x49 / 0x4a BC4 unsigned / signed, 0x4b / 0x4c BC5, 0x4d / 0x4e BC7 (sRGB), 0x4f / 0x50 BC6H signed / unsigned
+int nvn_bc_unpacked(uint32_t f, uint32_t *pf, int *bpp) {
+    switch (f) {
+    case 0x41: case 0x42: case 0x43: case 0x44: case 0x4d: *pf = RGBA8Unorm; *bpp = 4; return 1;
+    case 0x45: case 0x46: case 0x47: case 0x48: case 0x4e: *pf = RGBA8Unorm_sRGB; *bpp = 4; return 1;
+    case 0x49: *pf = R8Unorm; *bpp = 1; return 1;
+    case 0x4a: *pf = R8Snorm; *bpp = 1; return 1;
+    case 0x4b: *pf = RG8Unorm; *bpp = 2; return 1;
+    case 0x4c: *pf = RG8Snorm; *bpp = 2; return 1;
+    case 0x4f: case 0x50: *pf = RGBA16Float; *bpp = 8; return 1;
+    default: return 0;
+    }
+}
+
+static void block(uint32_t f, const uint8_t *b, uint8_t *o, int op) {   // 一块 → 4×4 像素（o 每行 op 字节） | one block → 4×4 pixels (o has op bytes per row)
+    switch (f) {
+    case 0x41: case 0x42: case 0x45: case 0x46: bcdec_bc1(b, o, op); break;
+    case 0x43: case 0x47: bcdec_bc2(b, o, op); break;
+    case 0x44: case 0x48: bcdec_bc3(b, o, op); break;
+    case 0x49: bcdec_bc4(b, o, op, 0); break;
+    case 0x4a: bcdec_bc4(b, o, op, 1); break;
+    case 0x4b: bcdec_bc5(b, o, op, 0); break;
+    case 0x4c: bcdec_bc5(b, o, op, 1); break;
+    case 0x4d: case 0x4e: bcdec_bc7(b, o, op); break;
+    case 0x4f: case 0x50: {   // bcdec 出 RGB 半精度，补 alpha = 1.0 | bcdec outputs RGB half-float; add alpha = 1.0
+        uint16_t rgb[16 * 3]; bcdec_bc6h_half(b, rgb, 4 * 3, f == 0x4f);
+        for (int y = 0; y < 4; y++) for (int x = 0; x < 4; x++) {
+            uint16_t *d = (uint16_t *)(o + y * op) + x * 4; const uint16_t *s = rgb + (y * 4 + x) * 3;
+            d[0] = s[0]; d[1] = s[1]; d[2] = s[2]; d[3] = 0x3c00;
+        }
+        break; }
+    }
+}
+
+int nvn_bc_decode(uint32_t f, const uint8_t *src, size_t pitch, uint32_t w, uint32_t h, uint8_t *dst, size_t dpitch) {
+    uint32_t pf; int bpp; if (!nvn_bc_unpacked(f, &pf, &bpp)) return -1;
+    int bb = (f == 0x41 || f == 0x42 || f == 0x45 || f == 0x46 || f == 0x49 || f == 0x4a) ? 8 : 16;   // 每块字节 | bytes per block
+    uint8_t tmp[4 * 4 * 8];
+    for (uint32_t by = 0; by * 4 < h; by++) for (uint32_t bx = 0; bx * 4 < w; bx++) {
+        const uint8_t *b = src + by * pitch + bx * bb;
+        uint32_t cw = w - bx * 4 < 4 ? w - bx * 4 : 4, ch = h - by * 4 < 4 ? h - by * 4 : 4;
+        uint8_t *o = dst + (size_t)by * 4 * dpitch + (size_t)bx * 4 * bpp;
+        if (cw == 4 && ch == 4) { block(f, b, o, (int)dpitch); continue; }
+        block(f, b, tmp, 4 * bpp);   // 边上不满 4×4 的块：先解到临时块再拷需要的部分 | blocks at the edge that are not a full 4×4: decode into a temporary block first, then copy the needed part
+        for (uint32_t y = 0; y < ch; y++) memcpy(o + y * dpitch, tmp + y * 4 * bpp, cw * bpp);
+    }
+    return 0;
+}
diff --git a/dm/gfx/tex/nvn_bcdec.h b/dm/gfx/tex/nvn_bcdec.h
new file mode 100644
index 00000000..abf3d2d1
--- /dev/null
+++ b/dm/gfx/tex/nvn_bcdec.h
@@ -0,0 +1,14 @@
+// 不支持 BC 压缩格式的显卡（A15 / A16 等，苹果 GPU 族 Apple8 及以下）：BC 贴图在 CPU 上解压成不压缩格式。
+// 游戏贴图里的 BC3 由老机型补充包离线换成 ASTC（dm/tools/astc_pack.py）；剩下的 BC（精灵图里的 BC3、少量 BC1 / BC4 / BC5 / BC6H）走这里。
+// GPUs without BC compressed format support (A15 / A16 etc., Apple GPU family Apple8 and below): BC textures are decompressed on the CPU into uncompressed formats.
+// BC3 in game textures is converted offline to ASTC by the Legacy Device Pack (dm/tools/astc_pack.py); the remaining BC (BC3 in sprites, a few BC1 / BC4 / BC5 / BC6H) goes through here.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+// NVN 格式是 BC → 返回 1，*mtl_pf = 解压后的 Metal 像素格式、*bpp = 解压后每像素字节；不是 BC 返回 0
+// NVN format is BC → returns 1, *mtl_pf = Metal pixel format after decompression, *bpp = bytes per pixel after decompression; returns 0 if not BC
+int nvn_bc_unpacked(uint32_t nvn_fmt, uint32_t *mtl_pf, int *bpp);
+// 解一片 w×h 像素：src 按块行排（每块行 pitch 字节），dst 每像素行 dpitch 字节。成功 0
+// Decode a w×h pixel region: src is laid out by block rows (pitch bytes per block row), dst has dpitch bytes per pixel row. Returns 0 on success
+int nvn_bc_decode(uint32_t nvn_fmt, const uint8_t *src, size_t pitch, uint32_t w, uint32_t h, uint8_t *dst, size_t dpitch);
diff --git a/dm/gfx/tex/tests/t_bcdec.c b/dm/gfx/tex/tests/t_bcdec.c
new file mode 100644
index 00000000..5fd5efe4
--- /dev/null
+++ b/dm/gfx/tex/tests/t_bcdec.c
@@ -0,0 +1,137 @@
+// BC decode correctness: decode a known block with bcdec through our glue, and compare against
+// bytes produced by an independent path (a second, hand-written DXT1 decoder in this file).
+// Formats with no independent reference here are checked structurally instead: every decoded
+// pixel must be opaque, the block must fit its 4x4 grid, and edge blocks must be trimmed.
+#include "../nvn_bcdec.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static int failures;
+
+static void check(int cond, const char *what) {
+    if (!cond) { printf("FAIL: %s\n", what); failures++; }
+}
+
+// ---- reference DXT1 (BC1) decoder: the textbook algorithm, written independently of bcdec ----
+static void put565(unsigned char *o, unsigned v, int srgb) {
+    (void)srgb;
+    int r = (v >> 11) & 0x1f, g = (v >> 5) & 0x3f, b = v & 0x1f;
+    o[0] = (unsigned char)((r << 3) | (r >> 2));
+    o[1] = (unsigned char)((g << 2) | (g >> 4));
+    o[2] = (unsigned char)((b << 3) | (b >> 2));
+    o[3] = 255;
+}
+static void ref_bc1(const unsigned char *blk, unsigned char *out, int op) {
+    unsigned c0 = blk[0] | (blk[1] << 8), c1 = blk[2] | (blk[3] << 8);
+    unsigned char pal[4][4];
+    put565(pal[0], c0, 0);
+    put565(pal[1], c1, 0);
+    if (c0 > c1) {
+        for (int i = 0; i < 3; i++) {
+            // bcdec rounds; a truncating reference differs by one on every interpolated stop
+            pal[2][i] = (unsigned char)((2 * pal[0][i] + pal[1][i] + 1) / 3);
+            pal[3][i] = (unsigned char)((pal[0][i] + 2 * pal[1][i] + 1) / 3);
+        }
+        pal[2][3] = pal[3][3] = 255;
+    } else {
+        for (int i = 0; i < 3; i++) {
+            pal[2][i] = (unsigned char)((pal[0][i] + pal[1][i] + 1) / 2);
+            pal[3][i] = 0;
+        }
+        pal[2][3] = 255;
+        pal[3][3] = 255;   // RGB_DXT1: the fourth colour is black but opaque
+    }
+    unsigned idx = blk[4] | (blk[5] << 8) | (blk[6] << 16) | ((unsigned)blk[7] << 24);
+    for (int y = 0; y < 4; y++)
+        for (int x = 0; x < 4; x++) {
+            int p = (int)((idx >> (2 * (y * 4 + x))) & 3);
+            memcpy(out + y * op + x * 4, pal[p], 4);
+        }
+}
+
+static void test_bc1_matches_reference(void) {
+    // Two blocks: one with c0 > c1 (four-colour mode) and one with c0 <= c1 (three-colour).
+    unsigned char blocks[2][8] = {
+        { 0x00, 0xF8, 0xE0, 0x07, 0x1B, 0x36, 0x6C, 0xD8 },   // c0 = red-ish 0xF800, c1 = green-ish 0x07E0
+        { 0xE0, 0x07, 0x00, 0xF8, 0x55, 0xAA, 0x55, 0xAA },   // swapped: three-colour mode
+    };
+    for (int k = 0; k < 2; k++) {
+        unsigned char got[4 * 16], want[4 * 16];
+        int r = nvn_bc_decode(0x41, blocks[k], 8, 4, 4, got, 16);   // 0x41 = RGB_DXT1 (no alpha semantics)
+        check(r == 0, "bc1 decode returns 0");
+        ref_bc1(blocks[k], want, 16);
+        if (memcmp(got, want, sizeof want) != 0) {
+            char msg[96];
+            snprintf(msg, sizeof msg, "BC1 block %d matches the reference decoder", k);
+            check(0, msg);
+            for (int i = 0; i < 16; i++)
+                if (got[i] != want[i]) { printf("  byte %d: got %u want %u\n", i, got[i], want[i]); break; }
+        } else {
+            check(1, "");
+        }
+    }
+}
+
+static void test_formats_map(void) {
+    unsigned pf; int bpp;
+    struct { uint32_t fmt; unsigned pf; int bpp; } cases[] = {
+        { 0x41, 70, 4 }, { 0x42, 70, 4 }, { 0x43, 70, 4 }, { 0x44, 70, 4 }, { 0x4d, 70, 4 },
+        { 0x45, 71, 4 }, { 0x46, 71, 4 }, { 0x47, 71, 4 }, { 0x48, 71, 4 }, { 0x4e, 71, 4 },
+        { 0x49, 10, 1 }, { 0x4a, 12, 1 }, { 0x4b, 30, 2 }, { 0x4c, 32, 2 },
+        { 0x4f, 115, 8 }, { 0x50, 115, 8 },
+    };
+    for (unsigned i = 0; i < sizeof cases / sizeof cases[0]; i++) {
+        check(nvn_bc_unpacked(cases[i].fmt, &pf, &bpp) == 1, "format is recognised as BC");
+        check(pf == cases[i].pf && bpp == cases[i].bpp, "format maps to the expected pixel format");
+    }
+    check(nvn_bc_unpacked(0x25, &pf, &bpp) == 0, "a non-BC format is rejected");
+}
+
+static void test_edge_blocks_trimmed(void) {
+    // A 6x3 image: blocks at x=4 and y=0 are partial. Decoding must write only real pixels,
+    // and the sentinel after the last row must survive (nothing written past the height).
+    // 6 pixels wide = two 4-pixel blocks per block row, so the source needs two blocks and a
+    // pitch of 2 * 8 bytes. (Passing one block made the second one read past the array.)
+    unsigned char blk[2][8] = {
+        { 0x00, 0xF8, 0xE0, 0x07, 0x1B, 0x36, 0x6C, 0xD8 },
+        { 0xE0, 0x07, 0x1F, 0x00, 0x1B, 0x36, 0x6C, 0xD8 },
+    };
+    enum { W = 6, H = 3 };
+    unsigned char out[H * W * 4 + 64];
+    memset(out, 0xAB, sizeof out);
+    int r = nvn_bc_decode(0x41, (const unsigned char *)blk, 16, W, H, out, W * 4);
+    check(r == 0, "partial-block decode returns 0");
+    for (int y = 0; y < H; y++)
+        for (int x = 0; x < W; x++) {
+            const unsigned char *p = out + y * W * 4 + x * 4;
+            check(p[3] == 255, "RGB_DXT1 decodes every pixel opaque");
+        }
+    for (unsigned i = H * W * 4; i < sizeof out; i++)
+        if (out[i] != 0xAB) { check(0, "nothing is written past the last row"); break; }
+}
+
+static void test_bc4_single_channel(void) {
+    // BC4 stores one channel; the unpacked format is R8, so bytes 1..3 of each pixel stay as the
+    // caller left them (tex_mtl fills alpha itself). Check the red channel varies with the block.
+    unsigned char blk[8] = { 0xFF, 0x00, 0, 0, 0, 0, 0, 0 };   // endpoints 255 and 0
+    // BC4 decodes to R8: one byte per pixel, dpitch = 4 for a 4-pixel row.
+    unsigned char out[4 * 4];
+    memset(out, 0xCC, sizeof out);
+    int r = nvn_bc_decode(0x49, blk, 8, 4, 4, out, 4);   // 0x49 = BC4 unsigned
+    check(r == 0, "bc4 decode returns 0");
+    int uniform = 1;
+    for (int i = 0; i < 16; i++) if (out[i] != 255) uniform = 0;
+    check(uniform, "bc4 decodes the whole block to the endpoint value");
+    check(out[1 + 4] == 255, "bc4 writes every row (not just the first)");
+}
+
+int main(void) {
+    test_bc1_matches_reference();
+    test_formats_map();
+    test_edge_blocks_trimmed();
+    test_bc4_single_channel();
+    if (failures) { printf("%d check(s) failed\n", failures); return 1; }
+    printf("bc decode: BC1 matches an independent DXT1 decoder, format map, edge trimming, BC4 - all OK\n");
+    return 0;
+}
