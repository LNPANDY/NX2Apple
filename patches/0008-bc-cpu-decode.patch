 dm/games/game.py                   |    3 +
 dm/gfx/nvn/nvn_mtl.m               |   44 +-
 dm/gfx/tex/nvn_bcdec.c             |   58 ++
 dm/gfx/tex/nvn_bcdec.h             |   14 +
