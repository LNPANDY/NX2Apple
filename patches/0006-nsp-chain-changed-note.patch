From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: v0lumehi <aljic.zijad@googlemail.com>
Date: Wed, 28 Oct 2026 13:33:54 +0100
Subject: [PATCH] NSP script: a [NOTE] chain-changed line when cached libraries
 are stale

Printed before the shader step when b-<chain> differs from the cached libraries.

Upstream-Status: fork-only (seedds/nxnative#490 is the event form, not this text note)
Reason: The front ends turn the [NOTE] chain-changed marker into a notice when cached shader libraries are from an older chain; upstream will have a shaders_stale event (seedds/nxnative#490) instead
Issue: LNPANDY/NX2Apple#123
---
 scripts/build_ipa_from_nsp.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/scripts/build_ipa_from_nsp.py b/scripts/build_ipa_from_nsp.py
index 99f9aa95..16cfd4f2 100755
--- a/scripts/build_ipa_from_nsp.py
+++ b/scripts/build_ipa_from_nsp.py
@@ -1725,6 +1725,11 @@ def build_shaders(py, repo, sh, xlate, env, logs, g, pkg_key=None, mac=False):
     ios, log = sh / 'ios', logs / 'dmsh_build.log'
     PROG.stage('Mac shaders' if mac else 'iOS shaders')
     chain = chain_of(repo)
+    stale = sorted(d.name for d in (sh / 'cache').glob('b-*') if d.name != f'b-{chain}' and any(d.glob('*_b.metallib'))
+                   ) + sorted(d.name for d in ios.glob('b-*') if d.name != f'b-{chain}' and any(d.glob('*_b.metallib')))
+    if stale: say(f'[NOTE] chain-changed: {", ".join(stale)} -> b-{chain}: the upstream update changed the shader '
+                  'translator, so the cached libraries cannot be reused and this build rebuilds them with it '
+                  '(once per update; later builds reuse as before)')
     out = sh / 'cache' if mac else ios
     libs, kf, kmac = out / f'b-{chain}', ios / f'b-{chain}.key', sh / f'mac-b-{chain}.key'
     pso_pairs = g.table('pso_pairs.tsv')
