From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Victor Wads <victor.laureano@gmail.com>
Date: Fri, 13 Nov 2026 08:09:32 -0300
Subject: [PATCH] Avoid duplicate menu actions when those sources map to rails

Upstream-Status: pending
Reason: Prevent rail remapping from also activating menu buttons in horizontal preview
Issue: LNPANDY/NX2Apple#1206

---
 dm/mac/Motion/Protocol.swift                  | 4 +++-
 dm/mac/Motion/Tests/MotionContractTests.swift | 2 ++
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/dm/mac/Motion/Protocol.swift b/dm/mac/Motion/Protocol.swift
index 9a9d422..d84fb02 100644
--- a/dm/mac/Motion/Protocol.swift
+++ b/dm/mac/Motion/Protocol.swift
@@ -67,7 +67,9 @@ enum DSU {
         func horizontalPreview(role: DSURole, railSL: Int = -1, railSR: Int = -1) -> Inputs {
             guard role != .full else { return self }
             let pairs: [(Int,Int)] = role == .left ? [(15,0),(12,1),(14,2),(13,3),(11,11),(4,4),(6,8),(8,9)] : [(2,0),(0,1),(3,2),(1,3),(10,10),(5,4),(7,8),(9,9)]
-            var result=Inputs(buttons: buttons & ((1 << 10) | (1 << 11)))
+            var menu=buttons & ((1 << 10) | (1 << 11))
+            for source in [railSL,railSR] where (0...15).contains(source) { menu &= ~(1 << source) }
+            var result=Inputs(buttons:menu)
             for (source,target) in pairs where buttons & (1 << source) != 0 { result.buttons |= 1 << target }
             // Remove selected sources before adding outputs: SR mapped from L must
             // not erase SL mapped to L in the same packet.
diff --git a/dm/mac/Motion/Tests/MotionContractTests.swift b/dm/mac/Motion/Tests/MotionContractTests.swift
index 11407ee..fffec8f 100644
--- a/dm/mac/Motion/Tests/MotionContractTests.swift
+++ b/dm/mac/Motion/Tests/MotionContractTests.swift
@@ -7,6 +7,8 @@ final class MotionContractTests:XCTestCase {
         let rails=DSU.Inputs(buttons:(1 << 7)|(1 << 9)).horizontalPreview(role:.left,railSL:7,railSR:9)
         XCTAssertNotEqual(rails.buttons & (1 << 6),0)
         XCTAssertNotEqual(rails.buttons & (1 << 7),0)
+        let reassignedMenu=DSU.Inputs(buttons:(1 << 10)|(1 << 11)).horizontalPreview(role:.left,railSL:10,railSR:11)
+        XCTAssertEqual(reassignedMenu.buttons,(1 << 6)|(1 << 7))
         for role in [DSURole.left,.right] {
             let shoulders = role == .left ? [(6,8),(8,9)] : [(7,8),(9,9)]
             for (source,target) in shoulders {
