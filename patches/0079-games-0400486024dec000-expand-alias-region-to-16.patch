From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LNPANDY <lnp-andy@hotmail.com>
Date: Sun, 22 Nov 2026 19:41:47 +0800
Subject: [PATCH] games/0400486024DEC000: expand alias region to 16 GB for
 Master Sword cutscene

Upstream-Status: pending
Reason: Expand Ocarina of Time (0400486024DEC000) alias region to 16 GB so the Master Sword cutscene does not exhaust address space after long sessions
Issue: none
---
 dm/games/0400486024DEC000/game.tsv  |  7 ++++---
 dm/tools/tests/test_game_profile.py | 18 ++++++++++++++++++
 2 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/dm/games/0400486024DEC000/game.tsv b/dm/games/0400486024DEC000/game.tsv
index 5fe097d..0439148 100644
--- a/dm/games/0400486024DEC000/game.tsv
+++ b/dm/games/0400486024DEC000/game.tsv
@@ -24,9 +24,10 @@ zip_store	.zs:.bwav:.webm:.metallib
 
 # ---- Memory ----
 # The Switch 2 leaves games 9 GB of its 12 GB (Donkey Kong Bananza's figure). The NPDM declares 48 MB of system resource, so virtual address memory is on.
-# 256 MiB in front + 8 GiB heap + 256 MiB stacks + 8 GiB alias region. At 4 GiB the Chamber of Sages transition runs out of room for a 50.03 MiB address region (#3103).
-mem_reserve	0x420000000
-mem_alias	0x200000000
+# nninitStartup asks SetHeapSize 0x18ce00000 (6.2 GB) with the 9 GB pool, as Mario Kart World.
+# 256 MB in front + 16 GB alias region + 256 MB stack region + 8 GB heap region: addresses cost nothing until mapped (sparse guest files), preventing Chamber of Sages (#3103) and Master Sword cutscene crashes from exhausting alias space after long sessions.
+mem_reserve	0x620000000
+mem_alias	0x400000000
 mem_map_limit	on
 mem_stack	0x10000000
 app_pool	0x240000000
diff --git a/dm/tools/tests/test_game_profile.py b/dm/tools/tests/test_game_profile.py
index 55f5cf9..db02479 100644
--- a/dm/tools/tests/test_game_profile.py
+++ b/dm/tools/tests/test_game_profile.py
@@ -121,3 +121,21 @@ class BuildModules(unittest.TestCase):
         r, text = self.run_game(self.ROWS.replace('subsdk1=', 'subsdk2='), 'header', ID, '{d}/game.h')
         self.assertEqual(r.returncode, 0, r.stderr)
         self.assertIn('{"' + 'd' * 32 + '", "main subsdk0 sdk"}', text)
+
+
+class OcarinaMemoryRegion(unittest.TestCase):
+    def test_16gb_alias_layout_keeps_8gb_heap(self):
+        sys.path.insert(0, str(REPO / 'dm/games'))
+        import game
+        g = game.load('0400486024DEC000')
+        self.assertEqual(g.int('mem_reserve'), 0x620000000)
+        self.assertEqual(g.int('mem_alias'), 0x400000000)
+        self.assertEqual(g.int('mem_reserve') - g.int('mem_alias') - g.int('mem_stack') - 0x10000000, 0x200000000)
+        with tempfile.TemporaryDirectory() as d:
+            out = Path(d) / 'game.h'
+            r = subprocess.run([sys.executable, str(GAME), 'header', '0400486024DEC000', str(out)],
+                               capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0, r.stderr)
+            text = out.read_text()
+            self.assertIn('#define DM_GAME_MEM_RESERVE 0x620000000ull', text)
+            self.assertIn('#define DM_GAME_MEM_ALIAS 0x400000000ull', text)
