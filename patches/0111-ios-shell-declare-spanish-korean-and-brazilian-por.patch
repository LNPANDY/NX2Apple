From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: v0lumehi <aljic.zijad@gmail.com>
Date: Mon, 9 Nov 2026 21:00:00 +0100
Subject: [PATCH] ios shell: declare Spanish, Korean and Brazilian Portuguese in CFBundleLocalizations

Upstream-Status: fork-only
Reason: frontend/l10n adds es, ko and pt-br, and iOS offers a language to the shell's package bundles only when the app declares it, so devices in those languages got English.
Issue: LNPANDY/NX2Apple#547, LNPANDY/NX2Apple#885, LNPANDY/NX2Apple#988
---
 dm/ios/project-shell.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dm/ios/project-shell.yml b/dm/ios/project-shell.yml
index aecb47f..fe73f4d 100644
--- a/dm/ios/project-shell.yml
+++ b/dm/ios/project-shell.yml
@@ -40,7 +40,7 @@ targets:
       path: Gen/Info.plist
       properties:
         CFBundleDisplayName: ${DM_SHELL_NAME}
-        CFBundleLocalizations: [en, de, fr, it, ja, sv, zh-Hans]   # one per file of frontend/l10n (tools/l10n_shell_catalogs.py), iOS offers only the declared ones to the package bundles
+        CFBundleLocalizations: [en, de, es, fr, it, ja, ko, pt-BR, sv, zh-Hans]   # one per file of frontend/l10n (tools/l10n_shell_catalogs.py), iOS offers only the declared ones to the package bundles
         CFBundleVersion: $(CURRENT_PROJECT_VERSION)
         CFBundleShortVersionString: $(MARKETING_VERSION)
         UILaunchScreen: {}
