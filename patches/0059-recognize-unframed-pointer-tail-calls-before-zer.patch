 dm/tools/patch_nso.py            | 12 ++++++++++++
 dm/tools/tests/test_tail_call.py | 28 ++++++++++++++++++++++++++--
 docs/reference/rewriter.md       |  8 ++++++++
 3 files changed, 46 insertions(+), 2 deletions(-)

