+    }
     void *owned = objmap_del(obj), *sev = rev_find(obj);
     orig(obj, state);
     free(owned);
@@ -627,7 +648,13 @@ void dm_audren_stop_all(void) {
         atomic_store(&g_ar[i].open, 0);
         if (g_ar[i].handle[0]) {
             pthread_mutex_lock(&g_ar[i].cq_mu);
+            if (g_ar[i].pcmout) dm_pcmout_wake(g_ar[i].pcmout);
