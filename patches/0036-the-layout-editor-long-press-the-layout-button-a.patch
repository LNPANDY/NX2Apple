+++ b/dm/ios/Sources/DmGamepad.m
@@ -11,6 +11,9 @@
 //     labelled R points at it while the 3D layout is new (it fades on the first touch there or after three seconds) — players could not find it otherwise.
 //   Everything hugs the edges and corners to leave the picture room; controls sit over the picture, one CAShapeLayer each: a press only swaps the fill, a stick only moves its knob, nothing redraws the whole screen.
 //   Touches no control takes (in 3D, those outside the right third) go to the game's touch screen (pushGame; Super Mario Galaxy's pointer in handheld mode).
+//   The layout editor: long-press the layout button (half a second) and every movable control becomes a dashed outline to drag anywhere; tapping the button
+//     again saves, long-pressing it inside the editor resets every position. Positions are kept in NSUserDefaults per game as screen fractions (each game is
+//     its own app, so its own layout), and a control without one sits exactly where the built-in layout puts it. The editor holds no game input.
 //   The virtual gamepad (layout button included) hides while a physical controller is connected and comes back when it is removed; meanwhile every touch goes to the game. Physical controllers keep every button (D-pad and right stick included) and map by position: bottom = B, right = A, left = Y, top = X (same positions as on a Switch controller); a Nintendo pad maps by its labels (pad_apple.h).
 //   Each physical controller is a player of its own (local co-op), as on the Mac: the first one connected is player 1, together with the touch gamepad, the next player 2, and so on up to 8; see "Physical controllers" below.
 //   Shaking the phone shakes the controller (DM_BTN_SHAKE: its six-axis sensor, hle_hid.c), whichever controls are in use; see "Shaking the phone" below.
@@ -128,7 +131,18 @@ static const CGFloat
     K_CLICK_X = 102, K_CLICK_R = 17;                // L3 / R3: centre from the outer edge (level with ZL / ZR), radius
 static const int k_btns[] = {B_ZL, B_L, B_ZR, B_R, B_MINUS, B_PLUS, B_LS, B_RS};   // keys locked at touch-down (L3 / R3 only in the 3D layout)
 static NSString *const k_layout_key = @"DmPadLayout";   // NSUserDefaults: 0 = 2D, 1 = 3D, 2 = Tap (DM_GAME_PAD_LAYOUT's numbers)
+static NSString *const k_custom_key = @"DmPadCustom";   // NSUserDefaults: group → [x, y] as fractions of the screen (the layout editor's positions, per game)
 int dm_opmode(void);   // hle_oe.c: 0 = handheld
+static NSString *groupOf(int b) {   // the group a key moves with in the layout editor; nil = not movable
+    switch (b) {
+        case B_A: case B_B: case B_X: case B_Y: return @"face";
+        case B_UP: case B_DOWN: case B_LEFT: case B_RIGHT: return @"dpad";
+        case B_LS: return @"LS"; case B_RS: return @"RS";
+        case B_L: return @"L"; case B_ZL: return @"ZL"; case B_R: return @"R"; case B_ZR: return @"ZR";
+        case B_MINUS: return @"minus"; case B_PLUS: return @"plus";
+        default: return nil;
+    }
+}
 
 @interface DmGamepad : UIView
 @end
