+
+// ---- The layout editor (see the header) ----
+- (CGPoint)placed:(CGPoint)fallback group:(NSString *)g {   // the group's kept position, falling back to the built-in layout
+    NSArray<NSNumber *> *p = _draft[g] ?: [NSUserDefaults.standardUserDefaults dictionaryForKey:k_custom_key][g];
+    if (p.count == 2) return CGPointMake(p[0].doubleValue * self.bounds.size.width, p[1].doubleValue * self.bounds.size.height);
+    return fallback;
+}
+- (CGPoint)groupAnchor:(NSString *)g {
+    if ([g isEqualToString:@"stick"]) return self.stickHome;
+    if ([g isEqualToString:@"face"]) return self.faceCenter;
+    if ([g isEqualToString:@"dpad"]) return self.dpadCenter;
+    if ([g isEqualToString:@"L"]) return [self dropCenter:B_L];
+    if ([g isEqualToString:@"ZL"]) return [self dropCenter:B_ZL];
+    if ([g isEqualToString:@"R"]) return [self dropCenter:B_R];
+    if ([g isEqualToString:@"ZR"]) return [self dropCenter:B_ZR];
+    if ([g isEqualToString:@"LS"]) return [self clickCenter:B_LS];
+    if ([g isEqualToString:@"RS"]) return [self clickCenter:B_RS];
+    if ([g isEqualToString:@"minus"]) { CGRect rc = [self pillRect:B_MINUS]; return CGPointMake(CGRectGetMidX(rc), CGRectGetMidY(rc)); }
+    CGRect rc = [self pillRect:B_PLUS]; return CGPointMake(CGRectGetMidX(rc), CGRectGetMidY(rc));
+}
+- (CGFloat)groupR:(NSString *)g {
+    if ([g isEqualToString:@"stick"]) return [self stickR:0];
+    if ([g isEqualToString:@"face"]) return self.faceR + self.faceGap;
+    if ([g isEqualToString:@"dpad"]) return self.dpadR + 6 * self.u;
+    if ([g isEqualToString:@"L"] || [g isEqualToString:@"R"]) return [self dropR:B_L] + 4 * self.u;
+    if ([g isEqualToString:@"ZL"] || [g isEqualToString:@"ZR"]) return [self dropR:B_ZL] + 4 * self.u;
+    if ([g isEqualToString:@"LS"] || [g isEqualToString:@"RS"]) return K_CLICK_R * self.u + 4 * self.u;
+    return K_PILL_H * self.u / 2 + 4 * self.u;   // the pills
+}
+- (void)openEditor {   // long-press on the layout button: drag the controls, tap the button to save and leave, long-press it to reset everything
+    if (_tap || _edit) return;   // the Tap layout has no controls to move
+    _edit = YES; _draft = [NSMutableDictionary dictionary];
+    [self reset];
+    [self applyLayout]; [self setNeedsLayout];
+}
+- (void)closeEditor {
+    _edit = NO;
+    if (_draft.count) {
+        NSMutableDictionary *d = [[NSUserDefaults.standardUserDefaults dictionaryForKey:k_custom_key] mutableCopy] ?: [NSMutableDictionary dictionary];
+        [d addEntriesFromDictionary:_draft];   // a group the editor never touched keeps its saved place
+        [NSUserDefaults.standardUserDefaults setObject:d forKey:k_custom_key];
+    }
+    _draft = nil;
+    [self reset];
+    [self applyLayout]; [self setNeedsLayout];
+}
+- (void)editDown:(UITouch *)t at:(CGPoint)p {
+    if ([self inSwap:p]) { [_owner setObject:@(C_SWAP) forKey:t]; _swapDown = [NSDate date]; return; }   // tap = save and leave, long press = reset
+    if (_editTouch) return;   // one dragged group at a time
+    NSString *best = nil; CGFloat bd = INFINITY;
+    for (NSString *g in _ghosts) {
+        if (_ghosts[g].hidden) continue;
+        CGFloat d = dist(p, [self groupAnchor:g]);
+        if (d <= [self groupR:g] * 1.6 && d < bd) { bd = d; best = g; }
+    }
+    if (!best) return;
+    _editTouch = t; _editGroup = best;
+    CGPoint c = [self groupAnchor:best]; _editGrab = CGPointMake(c.x - p.x, c.y - p.y);
+}
+- (void)editMove:(CGPoint)p {
+    if (!_editGroup) return;
+    CGPoint c = CGPointMake(p.x + _editGrab.x, p.y + _editGrab.y);
+    UIEdgeInsets i = self.safeAreaInsets; CGFloat m = 30 * self.u;   // the group's centre stays a margin inside the safe area
+    c.x = fminf(fmaxf(c.x, CGRectGetMinX(self.bounds) + i.left + m), CGRectGetMaxX(self.bounds) - i.right - m);
+    c.y = fminf(fmaxf(c.y, CGRectGetMinY(self.bounds) + i.top + m), CGRectGetMaxY(self.bounds) - i.bottom - m);
+    _draft[_editGroup] = @[@(c.x / self.bounds.size.width), @(c.y / self.bounds.size.height)];
+    [self setNeedsLayout];   // the keys and the outlines follow live
+}
 - (void)nextLayout {   // 2D → 3D (→ Tap in handheld mode) → 2D: release every touch first (no key stays held), save, lay out again
     int l = _tap ? 0 : _full ? (dm_opmode() == 0 ? 2 : 0) : 1;
     [self reset];
@@ -242,25 +335,25 @@ static BOOL fullOnly(int b) { return b == B_LS || b == B_RS || b >= B_LEFT; }
