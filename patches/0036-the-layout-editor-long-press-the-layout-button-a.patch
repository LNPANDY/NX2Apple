         if (l == 2 && dm_opmode() != 0) l = 0;   // Tap only in handheld mode (env.txt's DM_OPMODE may have changed it)
@@ -216,9 +239,11 @@ static BOOL fullOnly(int b) { return b == B_LS || b == B_RS || b >= B_LEFT; }
     [CATransaction begin]; [CATransaction setDisableActions:YES];
     for (int b = 0; b < B_N; b++) _key[b].hidden = _tap || (fullOnly(b) && !_full);
     _ring.hidden = _knob.hidden = _tap;
-    _swapLabel.string = _tap ? @"Tap" : _full ? @"3D" : @"2D";
+    _controls.opacity = _edit ? 0.5 : 1;   // the editor dims the controls so its dashed outlines read as handles, not keys
+    _swapLabel.string = _edit ? @"✓" : _tap ? @"Tap" : _full ? @"3D" : @"2D";
+    for (NSString *g in _ghosts) [_ghosts[g] setHidden:!_edit];
     [CATransaction commit];
