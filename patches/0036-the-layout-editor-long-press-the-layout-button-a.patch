+        for (NSString *g in @[@"stick", @"face", @"dpad", @"L", @"ZL", @"R", @"ZR", @"LS", @"RS", @"minus", @"plus"]) {
+            CAShapeLayer *gh = shape(_controls); gh.fillColor = nil; gh.strokeColor = k_line.CGColor; gh.lineWidth = 1.5;
+            gh.lineDashPattern = @[@6, @5]; gh.hidden = YES; _ghosts[g] = gh;   // the editor's drag handles, one per movable group
