From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: v0lumehi <aljic.zijad@gmail.com>
Date: Mon, 9 Nov 2026 21:20:57 +0100
Subject: [PATCH] build_ipa_from_nsp: a front end's stand-in icon for a Mac app
 without control data (NX_FALLBACK_ICON)

A NUP or a dump folder has no control data, so the Mac app is packed with no icon and shows a blank one. A front end may now name
a 256x256 JPEG in NX_FALLBACK_ICON. The Mac app takes it only when the game has no icon of its own. The iOS app and the shared
shell never use it.

Upstream-Status: forwarded seedds/nxnative#2099
Reason: A Switch 2 game from a NUP or a dump has no control data, so its Mac app had a blank icon, the launcher can now hand over an icon
Issue: LNPANDY/NX2Apple#784
---
 dm/tools/tests/test_nsp_nup.py |  7 +++++++
 scripts/build_ipa_from_nsp.py  | 13 +++++++++++--
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/dm/tools/tests/test_nsp_nup.py b/dm/tools/tests/test_nsp_nup.py
index 1e2c67bd..e7f58d10 100644
--- a/dm/tools/tests/test_nsp_nup.py
+++ b/dm/tools/tests/test_nsp_nup.py
@@ -484,6 +484,13 @@ class Pack(Base):
                 (u / 'control.nacp').write_bytes(control_nacp('Test Game', 'テス', '1.2.3'))
                 self.assertEqual(nsp.app_display_version(package, u, b, True), '1.2.3')   # the update's own control data wins
 
+    def test_fallback_icon_is_a_front_ends_file_that_exists(self):   # #784: a NUP or a dump has no control data, so no icon; a front end may name a stand-in
+        with tempfile.TemporaryDirectory() as tmp:
+            icon = Path(tmp) / 'stand-in.jpg'; icon.write_bytes(b'jpg')
+            with mock.patch.dict(os.environ, {'NX_FALLBACK_ICON': str(icon)}): self.assertEqual(nsp.fallback_icon(), icon)
+            with mock.patch.dict(os.environ, {'NX_FALLBACK_ICON': str(Path(tmp) / 'gone.jpg')}): self.assertIsNone(nsp.fallback_icon())
+            with mock.patch.dict(os.environ, {'NX_FALLBACK_ICON': ''}): self.assertIsNone(nsp.fallback_icon())
+
     def test_ipa_settings_read_the_picked_file_and_the_version_the_packed_one(self):   # build_ipa.sh's own lines: CONTROL is the NSP script's languages_control
         self.assertIn('CONTROL=str(control)', (REPO / 'scripts/build_ipa_from_nsp.py').read_text(encoding='utf-8'))
         script = (REPO / 'dm/ios/tools/build_ipa.sh').read_text(encoding='utf-8')
diff --git a/scripts/build_ipa_from_nsp.py b/scripts/build_ipa_from_nsp.py
index 2ccc63cf..c1c91f04 100755
--- a/scripts/build_ipa_from_nsp.py
+++ b/scripts/build_ipa_from_nsp.py
@@ -3047,6 +3047,13 @@ def mac_app_name(name):   # the app's file name: the game name with the characte
     return re.sub(r'\s*[:/]\s*', ' - ', name).strip(' .-') or 'nxnative'
 
 
+def fallback_icon():
+    """A front end's stand-in icon for a Mac app whose game carries no control data (a NUP, a dump folder): the 256x256 JPEG that NX_FALLBACK_ICON names, when the file exists.
+    The game's own icon always wins, and the iOS app and the shared shell never use it (their icon is the shell's)"""
+    path = os.environ.get('NX_FALLBACK_ICON', '')
+    return Path(path) if path and Path(path).is_file() else None
+
+
 def mac_app(py, repo, out, app, work, game, patched, host, font, msl, aoc, gfx, lang, g, name, version, bundle_id, icon, sign, env, logs, env_file='', gpus='', programs=None, control=None, package=''):
     """The last stage of PLATFORM 'mac-app': pack the Mac app (dm/mac/pack_app.py) from what a Mac-only build made: the Mac host and font (mac_host), the packed version's RomFS and rewritten
     modules, the Mac shader libraries (msl: <shader>/cache, whose b-<chain> goes in, or a Vulkan or GL game's <shader>, whose vk / gl goes in), the DLC, the profile's tables (with the shader pairs
@@ -3528,8 +3535,10 @@ def main(args=None):
             rmtree(work / 'tmp'); return {'patched': patched, 'romfs': rfs.source(game), 'msl': ios / (f'b-{chain_of(repo)}' if gfx == 'nvn' else 'vk' if gfx == 'vulkan' else 'gl'), 'tables': g.table('shader_map.tsv').parent, 'html': game / 'html', 'gfx': gfx}
         host, font = mac_host(py, repo, work, env, logs, g)
         programs = other_programs(args, g)
-        if not icon: say(('no game icon: the NUP carries none' if nup else 'no game icon: a dump folder has no control data') + '; the app\'s icon will be blank; --icon / ICON gives it one' if dump else '[RED] no game icon in the extraction (an older extraction did not save it: delete extract/ and run again); the app\'s icon will be blank')
-        mac_app(py, repo, out_ipa, app, work, game, patched, host, font, ios, aoc, gfx, lang, g, app_name, app_version, bundle_id, icon, args.mac_sign or MAC_SIGN, env, logs, env_file,
+        stand_in = None if icon else fallback_icon()
+        if stand_in: say(f'no game icon in the control data: the app takes the front end\'s stand-in icon {stand_in}')
+        elif not icon: say(('no game icon: the NUP carries none' if nup else 'no game icon: a dump folder has no control data') + '; the app\'s icon will be blank; --icon / ICON gives it one' if dump else '[RED] no game icon in the extraction (an older extraction did not save it: delete extract/ and run again); the app\'s icon will be blank')
+        mac_app(py, repo, out_ipa, app, work, game, patched, host, font, ios, aoc, gfx, lang, g, app_name, app_version, bundle_id, icon or stand_in, args.mac_sign or MAC_SIGN, env, logs, env_file,
                 (args.gpu or PSO_GPUS).strip(), programs, control, pkg_ver)
         rmtree(work / 'tmp')
         say(f'done: {out_ipa} ({tree_size(out_ipa)[1] / 2**30:.1f} GB); '
