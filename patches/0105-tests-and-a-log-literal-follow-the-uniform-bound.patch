From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: v0lumehi <aljic.zijad@gmail.com>
Date: Mon, 9 Nov 2026 18:39:14 +0100
Subject: [PATCH] Tests and a log literal follow the uniform bounds of 8190693

The translator now bounds a game uniform read, so the ampere memory tests read the MSL through dmsh_fetch.unguard and the mesh stage tests give int_outputs its dmsh_fetch. The unknown call site in the embedded compute kernel log no longer spells the ABI kind "?", which the ratchet counts.

Upstream-Status: pending
Reason: seedds/nxnative 8190693 fails its own test_dmsh_meshstage, test_dmsh_ampere_mem and test_dmsh_abi, the fork's CI runs them
Issue: LNPANDY/NX2Apple#1063
---
 dm/gfx/nvn/nvn_mtl.m | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index ce5e5be6..fb8f5a5e 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -14603,7 +14603,7 @@ static void dispatch(const p_dispatch *dp) {
         if (!mtl_addr(u->addr, 4, &ub, &uo) || !mtl_addr(a0->addr, 8, &sb, &so) || !mtl_addr(a1->addr, 8, &db, &dof)) { RED_ONCE(30, "embedded compute kernel %s does not have all its buffers bound", cs->builtin); return; }
         if (!cs->logged++) {
             module_t *m = module_of((void *)dp->caller);
-            MLOG("embedded compute kernel %s first dispatch: call site %s+%#llx, threadgroups %dx%dx%d, element count (current CPU-side value) %u", cs->builtin, m ? m->name : "?",
+            MLOG("embedded compute kernel %s first dispatch: call site %s+%#llx, threadgroups %dx%dx%d, element count (current CPU-side value) %u", cs->builtin, m ? m->name : "(no module)",
                  m ? (unsigned long long)(dp->caller - (uint64_t)m->base) : (unsigned long long)dp->caller, dp->x, dp->y, dp->z, *(uint32_t *)u->addr);
         }
         rp_end(); if (g_blit) { enc_b_end(g_blit); g_blit = nil; }
