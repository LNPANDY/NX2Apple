From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: v0lumehi <aljic.zijad@gmail.com>
Date: Mon, 9 Nov 2026 18:39:14 +0100
Subject: [PATCH] Tests and a log literal follow the uniform bounds of 8190693

The translator now bounds a game uniform read, so the ampere memory tests read the MSL through dmsh_fetch.unguard and the mesh stage tests give int_outputs its dmsh_fetch. The unknown call site in the embedded compute kernel log no longer spells the ABI kind "?", which the ratchet counts.

Upstream-Status: pending
Reason: seedds/nxnative 8190693 fails its own test_dmsh_meshstage, test_dmsh_ampere_mem and test_dmsh_abi, the fork's CI runs them
Issue: LNPANDY/NX2Apple#1063
---
 dm/gfx/nvn/nvn_mtl.m                 | 2 +-
 dm/gfx/tests/test_dmsh_ampere_mem.py | 3 ++-
 dm/gfx/tests/test_dmsh_meshstage.py  | 4 ++--
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index 634d459..5e56a8b 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -13702,7 +13702,7 @@ static void dispatch(const p_dispatch *dp, const uint8_t *next) {
         if (!mtl_addr(u->addr, 4, &ub, &uo) || !mtl_addr(a0->addr, 8, &sb, &so) || !mtl_addr(a1->addr, 8, &db, &dof)) { RED_ONCE(30, "embedded compute kernel %s does not have all its buffers bound", cs->builtin); return; }
         if (!cs->logged++) {
             module_t *m = module_of((void *)dp->caller);
-            MLOG("embedded compute kernel %s first dispatch: call site %s+%#llx, threadgroups %dx%dx%d, element count (current CPU-side value) %u", cs->builtin, m ? m->name : "?",
+            MLOG("embedded compute kernel %s first dispatch: call site %s+%#llx, threadgroups %dx%dx%d, element count (current CPU-side value) %u", cs->builtin, m ? m->name : "(no module)",
                  m ? (unsigned long long)(dp->caller - (uint64_t)m->base) : (unsigned long long)dp->caller, dp->x, dp->y, dp->z, *(uint32_t *)u->addr);
         }
         rp_end(); if (g_blit) { enc_b_end(g_blit); g_blit = nil; }
diff --git a/dm/gfx/tests/test_dmsh_ampere_mem.py b/dm/gfx/tests/test_dmsh_ampere_mem.py
index 7651bb6..f2e9b22 100644
--- a/dm/gfx/tests/test_dmsh_ampere_mem.py
+++ b/dm/gfx/tests/test_dmsh_ampere_mem.py
@@ -441,7 +441,8 @@ class Pokopia(Translated):
     ERRBAR = (0x000fc00000000000, 0x00000000000079ab)
 
     def msl(self, *code):
-        return self.translate(b''.join(inst(*c) for c in code) + inst(*SUATOM) + inst(*EXIT))
+        sys.path.insert(0, str(TOOLS)); import dmsh_fetch
+        return dmsh_fetch.unguard(self.translate(b''.join(inst(*c) for c in code) + inst(*SUATOM) + inst(*EXIT)))   # the uniform bounds (MetalUniformBounds) wrap a game uniform's word in a size check; these tests look at the word
 
     def test_merge_shifts_c_into_the_high_half(self):   # word 6, converted first, ends in the high half; word 5 in the low one
         msl = self.msl(self.MERGE_FIRST, self.MERGE_SECOND)
diff --git a/dm/gfx/tests/test_dmsh_meshstage.py b/dm/gfx/tests/test_dmsh_meshstage.py
index 1dc0569..7939c6b 100644
--- a/dm/gfx/tests/test_dmsh_meshstage.py
+++ b/dm/gfx/tests/test_dmsh_meshstage.py
@@ -253,8 +253,8 @@ fragment main0_out main0(main0_in in [[stage_in]])
         import ast, re
         tools = Path(__file__).resolve().parents[1] / 'tools'
         tree = ast.parse((tools / 'dmsh_build.py').read_text())
-        sys.path.insert(0, str(tools)); import dmsh_side   # fs_uint's entry points call main0's shared body
-        scope = {'re': re, 'collections': __import__('collections'), 'dmsh_side': dmsh_side}
+        sys.path.insert(0, str(tools)); import dmsh_side, dmsh_fetch   # fs_uint's entry points call main0's shared body, int_outputs unguards a bounded uniform word
+        scope = {'re': re, 'collections': __import__('collections'), 'dmsh_side': dmsh_side, 'dmsh_fetch': dmsh_fetch}
         exec(compile(ast.Module(body=[n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in ('fs_uint', 'int_outputs', 'in_word')], type_ignores=[]), 'dmsh_build.py', 'exec'), scope)
         cls.fs_uint = staticmethod(scope['fs_uint'])
 
