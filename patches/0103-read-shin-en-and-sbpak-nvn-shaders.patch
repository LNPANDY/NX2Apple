diff --git a/dm/tools/tests/test_early_nvn_containers.py b/dm/tools/tests/test_early_nvn_containers.py
new file mode 100644
index 0000000000000000000000000000000000000000..0e5a26466e6f4a3b00309a6f11bf5e20bf7f27aa
--- /dev/null
+++ b/dm/tools/tests/test_early_nvn_containers.py
@@ -0,0 +1,107 @@
+"""Shin'en and SBPAK shader records, including compressed blocks and unaligned embedded sections."""
+from pathlib import Path
+import os
+import struct
+import sys
+import tempfile
+import unittest
+import lz4.block
+
+REPO = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPO / 'dm/gfx/tools'))
+_prior_game = os.environ.get('DM_GAME')
+os.environ['DM_GAME'] = '0100152000022000'
+import shader_split as ss
+if _prior_game is None:
+    del os.environ['DM_GAME']
+else:
+    os.environ['DM_GAME'] = _prior_game
+
+
+def shader(stage):
+    code = bytearray(0x80)
+    code[:4] = ss.GFX_MAGIC
+    struct.pack_into('<I', code, 0x30, {'vs': 1, 'ps': 5}[stage] << 10)
+    control = bytearray(0x780)
+    control[:4] = ss.CTL_MAGIC
+    struct.pack_into('<2I', control, 4, 1, 9)
+    struct.pack_into('<I', control, 0x20, len(control))
+    struct.pack_into('<I', control, 0x704, len(code))
+    return bytes(control), bytes(code)
+
+
+def shn(compressed=False, stages=('ps', 'vs')):
+    pairs = [shader(stage) for stage in stages]
+    blocks = (b'SHDR' + b''.join(control for control, _ in pairs), b''.join(code for _, code in pairs))
+    out = bytearray(0x44)
+    out[:4] = b'SHN!'
+    for descriptor, raw in zip((4, 0x24), blocks):
+        stored = lz4.block.compress(raw, store_size=False) if compressed else raw
+        struct.pack_into('<3I', out, descriptor, len(out), len(stored), len(raw))
+        out.extend(stored)
+    return bytes(out)
+
+
+def prefixed(stage='vs'):
+    control, code = shader(stage)
+    head = bytearray(0x94)
+    payload = len(control) + len(code)
+    struct.pack_into('<3I', head, 0, 0x90 + payload, payload, 0x3f0)
+    struct.pack_into('<I', head, 0x30, ('vs', 'ps', 'gs').index(stage))
+    struct.pack_into('<4I', head, 0x34, 0, len(control), len(code), len(control))
+    struct.pack_into('<I', head, 0x4c, 1)
+    struct.pack_into('<I', head, 0x54, payload)
+    return bytes(head) + control + code
+
+
+class EarlyContainers(unittest.TestCase):
+    def test_shn_stored_and_lz4_pairs(self):
+        for compressed in (False, True):
+            with self.subTest(compressed=compressed):
+                records = ss.shn_shaders(shn(compressed), 'test.shdr')
+                self.assertEqual([row[1] for row in records], ['ps', 'vs'])
+                self.assertEqual(records[0][0], records[1][0])
+                self.assertEqual(len(ss.var_pairs(records)), 1)
+
+    def test_shn_rejects_truncated_gpu_block(self):
+        with self.assertRaises(SystemExit):
+            ss.shn_shaders(shn()[:-1], 'short.shdr')
+
+    def test_shn_rejects_incomplete_or_reversed_pair(self):
+        for stages in (('ps',), ('vs', 'ps')):
+            with self.subTest(stages=stages), self.assertRaises(SystemExit):
+                ss.shn_shaders(shn(stages=stages), 'bad.shdr')
+
+    def test_unaligned_prefixed_control(self):
+        data = b'x' + prefixed()
+        self.assertEqual(ss.prefixed_nvn(data, 0x95), ('vs', *shader('vs')))
+        self.assertIsNone(ss.prefixed_nvn(data[:-1], 0x95))
+
+    def test_masked_sbpak_and_marker_validation(self):
+        head = bytearray(25)
+        head[:len(ss.SBPAK)] = ss.SBPAK
+        head[20:24] = b'\x04\x03\x02\x01'.translate(ss.SBPAK_XOR)
+        data = bytes(head) + prefixed('ps').translate(ss.SBPAK_XOR)
+        self.assertEqual([row[1] for row in ss.sbpak_shaders(data, 'test.sbpak')], ['ps'])
+        corrupt = bytearray(data)
+        corrupt[20] ^= 1
+        self.assertEqual(ss.sbpak_shaders(bytes(corrupt), 'bad.sbpak'), [])
+
+    def test_dispatch_finds_shn_and_sbpak(self):
+        head = bytearray(24)
+        head[:len(ss.SBPAK)] = ss.SBPAK
+        head[20:24] = b'\x04\x03\x02\x01'.translate(ss.SBPAK_XOR)
+        with tempfile.TemporaryDirectory() as folder:
+            for name, data, expected in (
+                ('test.shdr', shn(), 2),
+                ('test.sbpak', bytes(head) + prefixed().translate(ss.SBPAK_XOR), 1),
+            ):
+                path = Path(folder) / name
+                path.write_bytes(data)
+                _, found, _, extra = ss.scan_file((str(path), name))
+                self.assertEqual(len(found), expected)
+                self.assertFalse(extra)
+
+
+if __name__ == '__main__':
+    unittest.main()
