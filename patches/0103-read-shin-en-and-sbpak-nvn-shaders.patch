index 86716e1be89ed5de6d824dd3b24e2643076323c9..1026335ad787b56a718bd8e99d7c6619982e1a60 100644
--- a/dm/gfx/tools/shader_split.py
+++ b/dm/gfx/tools/shader_split.py
@@ -1912,6 +1912,78 @@ def phyre_shaders(d, label):
     return out
 
 
+def shn_block(d, off, label):
+    start, stored, size = field(d, '<3I', off, label)
+    if not stored and not size: return b''
+    if start < 0x44 or not 0 < stored <= size <= stored * 255: red(f'{label}: invalid SHN block at {off:#x}')
+    data = span(d, start, stored, label)
+    if stored == size: return data
+    import lz4.block
+    data = lz4.block.decompress(data, uncompressed_size=size)
+    if len(data) != size: red(f'{label}: SHN block at {off:#x} has the wrong decoded length')
+    return data
+
+
+def shn_shaders(d, label):
+    """FAST RMX's Shin'en .shdr and .w3d files. SHN! holds three block descriptors. SHDR/SCEN metadata is at descriptor +4, and GPU data at +0x24.
+    Blocks whose stored and decoded sizes differ use raw LZ4. SDK 1 control sections are ordered pixel, vertex per pass; GPU code follows that order,
+    starting at offset zero and advancing by control +0x704. The GPU block of a scene can hold geometry after the last shader."""
+    meta = shn_block(d, 4, label)
+    if meta[:4] not in (b'SHDR', b'SCEN'): return []
+    offsets = [m.start() for m in re.finditer(re.escape(CTL_MAGIC + struct.pack('<2I', 1, 9)), meta)]
+    if not offsets: return []
+    if len(offsets) % 2: red(f'{label}: SHN shader controls do not form complete pairs')
+    gpu, k, out = shn_block(d, 0x24, label), 0, []
+    for i, c in enumerate(offsets):
+        cn, = field(meta, '<I', c + 0x20, label)
+        kn, = field(meta, '<I', c + 0x704, label)
+        if not 0x708 <= cn <= 0x880 or kn < 0x34: red(f'{label}: invalid SHN shader lengths at {c:#x}')
+        ctl, code = span(meta, c, cn, label), span(gpu, k, kn, label)
+        st = ('ps', 'vs')[i % 2]
+        if glslc_stage(ctl, code) != st or check(label, st, ctl, code):
+            red(f'{label}: SHN shader at {c:#x} does not match its {st} code at {k:#x}')
+        out.append((f'{label}#SHN#var{i // 2}', st, ctl, code))
+        k += kn
+    return out
+
+
+SBPAK = b'SBPAK V 1.0\r\n'
+SBPAK_XOR = bytes(i ^ 0xb6 for i in range(256))
+
+
+def prefixed_nvn(d, c, unmask=None):
+    """SDK 4 GPU code section without an outer GLSLC header (Giana Sisters). A u32 size and 0x90-byte header precede the control bytes; the code begins at their exact end,
+    even at an unaligned address. SBPAK's entries mask these bytes, so decode just the checked record, not the whole archive."""
+    if c < 0x94 or c + 0x708 > len(d): return None
+    h = c - 0x94
+    header = d[h:c + 0x708]
+    if unmask: header = header.translate(unmask)
+    cn = struct.unpack_from('<I', header, 0x94 + 0x20)[0]
+    kn = struct.unpack_from('<I', header, 0x94 + 0x704)[0]
+    payload = cn + kn
+    if cn < 0x760 or kn < 0x34 or c + payload > len(d): return None
+    if struct.unpack_from('<3I', header) != (0x90 + payload, payload, 0x3f0): return None
+    if struct.unpack_from('<4I', header, 0x34) != (0, cn, kn, cn): return None
+    if struct.unpack_from('<I', header, 0x4c)[0] != 1 or struct.unpack_from('<I', header, 0x54)[0] != payload: return None
+    stage = struct.unpack_from('<I', header, 0x30)[0]
+    if stage >= 3: return None
+    data = d[c:c + payload]
+    if unmask: data = data.translate(unmask)
+    ctl, code = data[:cn], data[cn:]
+    st = ('vs', 'ps', 'gs')[stage]
+    return (st, ctl, code) if sph_stage(code) == st and not check('prefixed NVN', st, ctl, code) else None
+
+
+def sbpak_shaders(d, label):
+    """Giana Sisters' SBPAK v1 shader archive. The masked endian marker distinguishes the layout, and each candidate must pass the GPU section header checks."""
+    if d[:len(SBPAK)] != SBPAK or d[20:24].translate(SBPAK_XOR) != b'\x04\x03\x02\x01': return []
+    out = []
+    for m in re.finditer(re.escape(CTL_MAGIC.translate(SBPAK_XOR)), d):
+        c = m.start()
+        if sh := prefixed_nvn(d, c, SBPAK_XOR): out.append((f'{label}#SBPAK@{c:#x}', *sh))
+    return out
+
+
