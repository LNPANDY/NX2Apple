diff --git a/dm/host/pad_joycon.h b/dm/host/pad_joycon.h
new file mode 100644
index 0000000..18a2f0d
--- /dev/null
+++ b/dm/host/pad_joycon.h
@@ -0,0 +1,139 @@
+#pragma once
+#include <math.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include "dm_input.h"
+#include "motion_pro.h"
+
+// Nintendo Switch Joy-Con sideways decoder (DM_JOYCON_SPLIT=1, LNPANDY/NX2Apple#740):
+// macOS switches Bluetooth Joy-Con (L) (0x057e:0x2006) and Joy-Con (R) (0x057e:0x2007) to standard
+// 0x30 49-byte input reports at 60 Hz, while GCController merges the pair into one controller and
+// drops the rail SL and SR buttons. Each half here becomes one horizontal sideways controller with
+// its stick rotated 90 degrees and its rail SL and SR mapped to L and R.
+
+#define JOYCON_VID             0x057e
+#define JOYCON_PID_L           0x2006
+#define JOYCON_PID_R           0x2007
+#define JOYCON_REPORT_0x30     0x30
+#define JOYCON_REPORT_MIN_LEN  12
+#define JOYCON_STICK_CENTER    2048
+#define JOYCON_STICK_RADIUS    1400.0f
+#define JOYCON_STICK_DZ        0.12f
+
+typedef struct {
+    uint16_t pid;
+    int calibrated;
+    int cx, cy;
+    uint64_t buttons;
+    float sx, sy;
+    int home;
+    int battery;   // 0..4 from the upper nibble of byte 2 (4=full, 3=75%, 2=50%, 1=25%, 0=empty)
+    int charging;  // 1 when bit 4 of byte 2 is set
+} joycon_state;
+
+static inline int joycon_is_pid(long vid, long pid) {
+    return vid == JOYCON_VID && (pid == JOYCON_PID_L || pid == JOYCON_PID_R);
+}
+
+static inline void joycon_init(joycon_state *s, uint16_t pid) {
+    if (!s) return;
+    memset(s, 0, sizeof *s);
+    s->pid = pid;
+    s->cx = JOYCON_STICK_CENTER;
+    s->cy = JOYCON_STICK_CENTER;
+}
+
+static inline void joycon_stick_scale(float x, float y, float *ox, float *oy) {
+    float m = sqrtf(x * x + y * y);
+    if (m <= JOYCON_STICK_DZ) { *ox = 0.0f; *oy = 0.0f; return; }
+    float k = (m - JOYCON_STICK_DZ) / ((1.0f - JOYCON_STICK_DZ) * m);
+    float sx = x * k, sy = y * k;
+    *ox = sx < -1.0f ? -1.0f : (sx > 1.0f ? 1.0f : sx);
+    *oy = sy < -1.0f ? -1.0f : (sy > 1.0f ? 1.0f : sy);
+}
+
+static inline int joycon_decode_0x30(joycon_state *s, const uint8_t *r, size_t n) {
+    if (!s || !r || n < JOYCON_REPORT_MIN_LEN || r[0] != JOYCON_REPORT_0x30) return 0;
+    if (s->pid != JOYCON_PID_L && s->pid != JOYCON_PID_R) return 0;
+
+    s->charging = (r[2] >> 4) & 1;
+    s->battery = (r[2] >> 5) & 7;
+
+    uint64_t b = 0;
+    int rx = 0, ry = 0;
+    if (s->pid == JOYCON_PID_L) {
+        // Left Joy-Con held sideways (rotated 90 degrees counter-clockwise, rail on top):
+        // Down->A (right), Left->B (bottom), Right->X (top), Up->Y (left), SL->L, SR->R
+        uint8_t lb = r[5], sh = r[4];
+        if (lb & 0x01) b |= DM_BTN_A;
+        if (lb & 0x08) b |= DM_BTN_B;
+        if (lb & 0x04) b |= DM_BTN_X;
+        if (lb & 0x02) b |= DM_BTN_Y;
+        if (lb & 0x20) b |= DM_BTN_L;
+        if (lb & 0x10) b |= DM_BTN_R;
+        if (lb & 0x40) b |= DM_BTN_ZL;
+        if (lb & 0x80) b |= DM_BTN_ZR;
+        if (sh & 0x01) b |= DM_BTN_PLUS;
+        if (sh & 0x20) b |= DM_BTN_MINUS;
+        if (sh & 0x08) b |= DM_BTN_LS;
+        s->home = 0;
+        rx = (int)r[6] | (((int)(r[7] & 0x0f)) << 8);
+        ry = ((int)(r[7] >> 4)) | (((int)r[8]) << 4);
+    } else {
+        // Right Joy-Con held sideways (rotated 90 degrees clockwise, rail on top):
+        // X->A (right), A->B (bottom), Y->X (top), B->Y (left), SL->L, SR->R
+        uint8_t rb = r[3], sh = r[4];
+        if (rb & 0x02) b |= DM_BTN_A;
+        if (rb & 0x08) b |= DM_BTN_B;
+        if (rb & 0x01) b |= DM_BTN_X;
+        if (rb & 0x04) b |= DM_BTN_Y;
+        if (rb & 0x20) b |= DM_BTN_L;
+        if (rb & 0x10) b |= DM_BTN_R;
+        if (rb & 0x40) b |= DM_BTN_ZL;
+        if (rb & 0x80) b |= DM_BTN_ZR;
+        if (sh & 0x02) b |= DM_BTN_PLUS;
+        if (sh & 0x04) b |= DM_BTN_LS;
+        s->home = (sh & 0x10) != 0;
+        rx = (int)r[9] | (((int)(r[10] & 0x0f)) << 8);
+        ry = ((int)(r[10] >> 4)) | (((int)r[11]) << 4);
+    }
+    s->buttons = b;
+
+    if (rx == 0 && ry == 0) {
+        s->sx = 0.0f;
+        s->sy = 0.0f;
+        return 1;
+    }
+    if (!s->calibrated && rx >= 1650 && rx <= 2450 && ry >= 1650 && ry <= 2450) {
+        s->cx = rx;
+        s->cy = ry;
+        s->calibrated = 1;
+    }
+    float dx = (float)(rx - s->cx) / JOYCON_STICK_RADIUS;
+    float dy = (float)(ry - s->cy) / JOYCON_STICK_RADIUS;
+    float rot_x = (s->pid == JOYCON_PID_L) ? -dy : dy;
+    float rot_y = (s->pid == JOYCON_PID_L) ? dx : -dx;
+    joycon_stick_scale(rot_x, rot_y, &s->sx, &s->sy);
+    return 1;
+}
+
+static inline int joycon_motion_decode(pro_motion *s, uint16_t pid, const uint8_t *r, size_t len, uint64_t now, pro_motion_sample out[3]) {
+    if (pid != JOYCON_PID_L && pid != JOYCON_PID_R) return 0;
+    int n = pro_motion_decode(s, r, len, now, out);
+    for (int i = 0; i < n; i++) {
+        float ax = out[i].acc[0], ay = out[i].acc[1], az = out[i].acc[2];
+        float gx = out[i].rot[0], gy = out[i].rot[1], gz = out[i].rot[2];
+        if (pid == JOYCON_PID_L) {
+            // Left Joy-Con rotated 90 degrees counter-clockwise (rail on top)
+            out[i].acc[0] = -ay; out[i].acc[1] = ax; out[i].acc[2] = az;
+            out[i].rot[0] = -gy; out[i].rot[1] = gx; out[i].rot[2] = gz;
+        } else {
+            // Right Joy-Con IMU sensor is mounted flipped 180 degrees around X (raw Y and Z inverted
+            // relative to Left/Pro, see Linux hid-nintendo.c), then rotated 90 degrees clockwise
+            out[i].acc[0] = ay; out[i].acc[1] = ax; out[i].acc[2] = -az;
+            out[i].rot[0] = gy; out[i].rot[1] = gx; out[i].rot[2] = -gz;
+        }
+    }
+    return n;
+}
diff --git a/dm/host/pad_joycon_mac.h b/dm/host/pad_joycon_mac.h
new file mode 100644
index 0000000..a995be7
--- /dev/null
+++ b/dm/host/pad_joycon_mac.h
@@ -0,0 +1,115 @@
+// Mac: split a Bluetooth Joy-Con pair into two sideways controllers (pad_joycon.h, LNPANDY/NX2Apple#740).
+// When DM_JOYCON_SPLIT=1 is set, front_mac.m skips GameController's combined Joy-Con entry and reads Joy-Con (L) (0x057e:0x2006)
+// and Joy-Con (R) (0x057e:0x2007) directly with IOHIDManager so each half gets its own player slot.
+#pragma once
+#import <IOKit/hid/IOHIDManager.h>
+#import <GameController/GameController.h>
+#import <GameController/GCSyntheticDeviceKeys.h>
+#include "pad_joycon.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+typedef struct joycon_pad {
+    IOHIDDeviceRef hid;
+    joycon_state st;
+    pro_motion motion;
+    char name[64];
+    uint8_t rep[128];
+    struct joycon_pad *next;
+} joycon_pad;
+
+static IOHIDManagerRef g_joycon_manager;
+static joycon_pad *g_joycons;
+static int g_joycon_split;
+static void joycon_attach(joycon_pad *d);
+static void joycon_detach(joycon_pad *d);
+static void joycon_read(joycon_pad *d);
+static void joycon_read_motion(joycon_pad *d, const uint8_t *rep, size_t len);
+static void joycon_home_changed(void);
+
+static int joycon_is_gc_controller(GCController *c) {
+    if (!c) return 0;
+    NSString *cat = c.productCategory ?: @"";
+    NSString *ven = c.vendorName ?: @"";
+    return [cat rangeOfString:@"Joy-Con" options:NSCaseInsensitiveSearch].location != NSNotFound
+        || [cat rangeOfString:@"JoyCon" options:NSCaseInsensitiveSearch].location != NSNotFound
+        || [ven rangeOfString:@"Joy-Con" options:NSCaseInsensitiveSearch].location != NSNotFound
+        || [ven rangeOfString:@"JoyCon" options:NSCaseInsensitiveSearch].location != NSNotFound;
+}
+
+static void joycon_report(void *ctx, IOReturn result, void *sender, IOHIDReportType type, uint32_t id, uint8_t *rep, CFIndex len) {
+    (void)sender; (void)type; (void)id;
+    joycon_pad *d = ctx;
+    if (result != kIOReturnSuccess || !d || len <= 0) return;
+    int was_home = d->st.home;
+    if (!joycon_decode_0x30(&d->st, rep, (size_t)len)) return;
+    joycon_read(d);
+    joycon_read_motion(d, rep, (size_t)len);
+    if (d->st.home != was_home) joycon_home_changed();
+}
+
+static void joycon_found(void *ctx, IOReturn result, void *sender, IOHIDDeviceRef hid) {
+    (void)ctx; (void)sender;
+    if (!g_joycon_split || result != kIOReturnSuccess || IOHIDDeviceGetProperty(hid, CFSTR(kIOHIDGCSyntheticDeviceKey)) == kCFBooleanTrue) return;
+    for (joycon_pad *d = g_joycons; d; d = d->next) if (d->hid == hid) return;
+    NSNumber *vendor = (__bridge NSNumber *)IOHIDDeviceGetProperty(hid, CFSTR(kIOHIDVendorIDKey));
+    NSNumber *product = (__bridge NSNumber *)IOHIDDeviceGetProperty(hid, CFSTR(kIOHIDProductIDKey));
+    long vid = vendor.longValue, pid = product.longValue;
+    if (!joycon_is_pid(vid, pid)) return;
+    joycon_pad *d = calloc(1, sizeof *d);
+    if (!d) { LOG("[RED] Split Joy-Con: cannot allocate device state"); return; }
+    joycon_init(&d->st, (uint16_t)pid);
+    snprintf(d->name, sizeof d->name, "%s", pid == JOYCON_PID_L ? "Joy-Con (L)" : "Joy-Con (R)");
+    d->hid = (IOHIDDeviceRef)CFRetain(hid);
+    joycon_pad **link = &g_joycons;
+    while (*link) link = &(*link)->next;
+    *link = d;
+    IOHIDDeviceRegisterInputReportCallback(hid, d->rep, sizeof d->rep, joycon_report, d);
+    joycon_attach(d);
+}
+
+static void joycon_removed(void *ctx, IOReturn result, void *sender, IOHIDDeviceRef hid) {
+    (void)ctx; (void)result; (void)sender;
+    joycon_pad **link = &g_joycons;
+    while (*link && (*link)->hid != hid) link = &(*link)->next;
+    if (!*link) return;
+    joycon_pad *d = *link;
+    *link = d->next;
+    IOHIDDeviceRegisterInputReportCallback(hid, d->rep, 0, NULL, NULL);
+    joycon_detach(d);
+    CFRelease(d->hid);
+    free(d);
+}
+
+static void joycon_start(void) {
+    const char *e = getenv("DM_JOYCON_SPLIT");
+    g_joycon_split = e && atoi(e);
+    if (!g_joycon_split || g_joycon_manager) return;
+    g_joycon_manager = IOHIDManagerCreate(kCFAllocatorDefault, kIOHIDOptionsTypeNone);
+    if (!g_joycon_manager) return;
+    IOHIDManagerSetDeviceMatchingMultiple(g_joycon_manager, (__bridge CFArrayRef)@[
+        @{@kIOHIDVendorIDKey: @(JOYCON_VID), @kIOHIDProductIDKey: @(JOYCON_PID_L)},
+        @{@kIOHIDVendorIDKey: @(JOYCON_VID), @kIOHIDProductIDKey: @(JOYCON_PID_R)}]);
+    IOHIDManagerRegisterDeviceMatchingCallback(g_joycon_manager, joycon_found, NULL);
+    IOHIDManagerRegisterDeviceRemovalCallback(g_joycon_manager, joycon_removed, NULL);
+    IOHIDManagerScheduleWithRunLoop(g_joycon_manager, CFRunLoopGetMain(), kCFRunLoopCommonModes);
+    IOReturn r = IOHIDManagerOpen(g_joycon_manager, kIOHIDOptionsTypeNone);
+    if (r != kIOReturnSuccess) {
+        LOG("[RED] Split Joy-Con: cannot open HID (0x%x), keeping GameController's combined pair", r);
+        IOHIDManagerUnscheduleFromRunLoop(g_joycon_manager, CFRunLoopGetMain(), kCFRunLoopCommonModes);
+        CFRelease(g_joycon_manager);
+        g_joycon_manager = NULL;
+        g_joycon_split = 0;
+        return;
+    }
+    // Attach Joy-Con (L) before Joy-Con (R) when both are already connected at launch so (L) gets Player 1 and (R) gets Player 2.
+    NSSet *devs = CFBridgingRelease(IOHIDManagerCopyDevices(g_joycon_manager));
+    const int order[2] = {JOYCON_PID_L, JOYCON_PID_R};
+    for (int i = 0; i < 2; i++) {
+        for (id obj in devs) {
+            IOHIDDeviceRef hid = (__bridge IOHIDDeviceRef)obj;
+            NSNumber *pid = (__bridge NSNumber *)IOHIDDeviceGetProperty(hid, CFSTR(kIOHIDProductIDKey));
+            if (pid.intValue == order[i]) joycon_found(NULL, kIOReturnSuccess, NULL, hid);
+        }
+    }
+}
