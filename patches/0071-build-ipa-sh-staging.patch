From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiaoge-tou <85100527+Tiaoge-tou@users.noreply.github.com>
Date: Tue, 3 Nov 2026 19:49:31 +0800
Subject: [PATCH] iOS build: stage the pad skin art by env gate and stamp
 DMBuildTime

build_ipa.sh wiring carried from the Tiaoge-tou/nxnative fork (patch port 0071, group B of the port inventory).

The virtual-pad skin art sets (Silksong padskin, padskin-badge, padskin-metal and padskin-glass, Hades II hadesskin and hadesskin-badge) are copied into Gen/dm only when the game env file turns the pad on (DM_PAD_SKIN=1 or DM_PAD_HADES=1) and the art folder exists, so games without the pad carry none of it. The art itself lands with the skin-art patch later in the queue.

DMBuildTime (seconds since the epoch) is stamped into Info.plist next to DMCommit and DMChain. The launcher shows it under the Play button in the device time zone once the launcher patch lands.

Upstream-Status: fork-only
Reason: Pad skin staging and the build-time stamp for Silksong and Hades II, ported from the nxnative fork (PROJECT.md Phase 2)
Issue: Tiaoge-tou/NX2Apple PROJECT.md Phase 2

---
 dm/ios/tools/build_ipa.sh | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/dm/ios/tools/build_ipa.sh b/dm/ios/tools/build_ipa.sh
index dae55ee..e995e84 100755
--- a/dm/ios/tools/build_ipa.sh
+++ b/dm/ios/tools/build_ipa.sh
@@ -124,6 +124,20 @@ LD=$(python3 -c 'import json, sys; print(next((s["default"] for s in json.load(o
 if [ -n "$LD" ] && [ "$LD" != "$DM_LANG" ]; then t "game language: the game has no $DM_LANG; packing $LD, its first"; export DM_LANG=$LD; fi
 # Diagnostic build: DM_ENV_FILE=file → dm/env.txt in the bundle (main.m sets one environment variable per line at boot)
 if [ -n "${DM_ENV_FILE:-}" ]; then cp "$DM_ENV_FILE" Gen/dm/env.txt || die "copy DM_ENV_FILE"; t "env: $(grep -v '^#' "$DM_ENV_FILE" | tr '\n' ' ')"; fi
+# Virtual-pad skin art (dm/ios/padskin in this repo): bundled at DmIOS.app/dm/padskin only for DM_PAD_SKIN builds
+# (DmGamepad.m) — the art belongs to the game whose env turns the skin on; other games' IPAs do not carry it.
+if [ -d "$IOS_SOURCE/padskin" ] && grep -q '^DM_PAD_SKIN=1' Gen/dm/env.txt 2>/dev/null; then mkdir -p Gen/dm/padskin && cp "$IOS_SOURCE"/padskin/*.png Gen/dm/padskin/ || die "copy padskin art"; fi
+# The padskin's letter-badge set (dm/ios/padskin-badge in this repo): the same gate; the launcher's DM_SILK_SKIN choice (2) picks it at runtime.
+if [ -d "$IOS_SOURCE/padskin-badge" ] && grep -q '^DM_PAD_SKIN=1' Gen/dm/env.txt 2>/dev/null; then mkdir -p Gen/dm/padskin-badge && cp "$IOS_SOURCE"/padskin-badge/*.png Gen/dm/padskin-badge/ || die "copy padskin badge art"; fi
+# The padskin's black-iron set (dm/ios/padskin-metal in this repo): the same gate; the launcher's DM_SILK_SKIN choice (3) picks it at runtime.
+if [ -d "$IOS_SOURCE/padskin-metal" ] && grep -q '^DM_PAD_SKIN=1' Gen/dm/env.txt 2>/dev/null; then mkdir -p Gen/dm/padskin-metal && cp "$IOS_SOURCE"/padskin-metal/*.png Gen/dm/padskin-metal/ || die "copy padskin metal art"; fi
+# The glass skin's cutscene medallions (dm/ios/padskin-glass in this repo): the same gate; the glass choice (DM_SILK_SKIN=0) reads its Skip and Pad-recall discs there at runtime.
+if [ -d "$IOS_SOURCE/padskin-glass" ] && grep -q '^DM_PAD_SKIN=1' Gen/dm/env.txt 2>/dev/null; then mkdir -p Gen/dm/padskin-glass && cp "$IOS_SOURCE"/padskin-glass/*.png Gen/dm/padskin-glass/ || die "copy padskin glass art"; fi
+# Hades II button-skin art (dm/ios/hadesskin in this repo): bundled at DmIOS.app/dm/hadesskin only for DM_PAD_HADES builds
+# (DmGamepad.m; the launcher's DM_HADES_SKIN toggle picks it over the glass controls at runtime) — other games' IPAs do not carry it.
+if [ -d "$IOS_SOURCE/hadesskin" ] && grep -q '^DM_PAD_HADES=1' Gen/dm/env.txt 2>/dev/null; then mkdir -p Gen/dm/hadesskin && cp "$IOS_SOURCE"/hadesskin/*.png Gen/dm/hadesskin/ || die "copy hadesskin art"; fi
+# The hadesskin's letter-badge set (dm/ios/hadesskin-badge in this repo): the same gate; the launcher's DM_HADES_SKIN choice (2) picks it at runtime.
+if [ -d "$IOS_SOURCE/hadesskin-badge" ] && grep -q '^DM_PAD_HADES=1' Gen/dm/env.txt 2>/dev/null; then mkdir -p Gen/dm/hadesskin-badge && cp "$IOS_SOURCE"/hadesskin-badge/*.png Gen/dm/hadesskin-badge/ || die "copy hadesskin badge art"; fi
 # The shader libraries go into the archive as DmIOS.app/msl/<folder> (main.m sets DM_MSL_DIR to it)
 if [ "$GFXAPI" = vulkan ]; then MSLDIR=vk; elif [ "$GFXAPI" = gl ]; then MSLDIR=gl; else MSLDIR=b-$V; fi
 # Shared-font stand-ins: standard = macOS's Arial Unicode (absent on iOS), Nintendo extension = button icons generated by make_ext_font.py (needs fontTools; FONT_PY names a python that has it)
@@ -192,6 +206,8 @@ else xcodegen generate -q --spec project-framework.yml > /dev/null || die "xcode
 COMMIT=$(git -C "$DM" rev-parse --short=12 HEAD 2> /dev/null) && { [ -z "$(git -C "$DM" status --porcelain --untracked-files=no 2> /dev/null)" ] || COMMIT=$COMMIT+dirty
   /usr/libexec/PlistBuddy -c "Add :DMCommit string $COMMIT" Gen/Info.plist > /dev/null || die "DMCommit"; t "source: $COMMIT"; }
 case "$MSLDIR" in b-*) /usr/libexec/PlistBuddy -c "Add :DMChain string ${MSLDIR#b-}" Gen/Info.plist > /dev/null || die "DMChain";; esac
+# DMBuildTime: when this build ran (seconds since the epoch, an absolute moment); the launcher shows it under the Play button in the device's own time zone (Launcher.swift)
+/usr/libexec/PlistBuddy -c "Add :DMBuildTime integer $(date +%s)" Gen/Info.plist > /dev/null || die "DMBuildTime"
 # DM_METAL_CAPTURE=1: a development build that may write GPU frame captures (MetalCaptureEnabled; the host's DM_GPU_CAPTURE switch writes them to Documents/gpu_captures)
 if [ "${DM_METAL_CAPTURE:-0}" = 1 ]; then /usr/libexec/PlistBuddy -c "Add :MetalCaptureEnabled bool true" Gen/Info.plist > /dev/null || die "MetalCaptureEnabled"; t "Metal frame capture: enabled (DM_METAL_CAPTURE=1)"; fi
 DM_RESOURCE_BUILD=${PKG:-} GAME=$GAME python3 tools/gen_resources.py "$IOS" "$ROMFS" "$MARKER" "$MSL_IOS/$MSLDIR" "$MSLDIR" "$AOC" "$XCODE_DD" "$DM/gfx/nvn/dmsh_chain.h" "$PSO" || die "generate Xcode resource paths"
