+    input = duo_harness_input();
+    XCTAssertEqual(input.touches[0].id, 0);
+    XCTAssertEqualWithAccuracy(input.touches[0].x, 0.5, 0.001);
+    XCTAssertEqualWithAccuracy(input.touches[0].y, 0.5, 0.001);
