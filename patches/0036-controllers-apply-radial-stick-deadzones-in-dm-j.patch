+// SetNpadJoyHoldType (0 = Vertical, 1 = Horizontal): single Joy-Con whole-controller fallback (KIND_PAD) rotates sideways only when Horizontal, while native JoyLeft/JoyRight/JoyDual stay upright per Horizon OS
+static void t_joy_hold_type(void) {
+    g_mode = 1; ids((uint32_t[]){0, 1, 2, 3}, 4);
+    CHECK(h_hid_GetHold() == 0, "NpadJoyHoldType defaults to 0 (Vertical)");
+
+    // Fallback KIND_PAD (e.g. Sports Resort lobby: Handheld | JoyDual only, no JoyLeft/JoyRight): 2P single right Joy-Con + poisoned g_pad_btn
+    dm_pad_players(3); dm_joy_attach(1, 2);
+    dm_pad_set_player(1, DM_BTN_A, 1234, -1234, 0, 0);
+    h_hid_SetStyles(STYLE_HANDHELD | STYLE_JOYDUAL);
+    CHECK(h_hid_GetStyle(&(uint32_t){1}) == STYLE_JOYDUAL, "single right Joy-Con without JoyRight support falls back to KIND_PAD (JoyDual)");
+
+    dm_joy_set(1, 1, DM_BTN_X | DM_BTN_A | DM_BTN_R | DM_BTN_ZR | DM_BTN_PLUS | DM_BTN_RS | DM_BTN_RSR, 0, 20000);
+    NpadState st = npad_of(1, STYLE_JOYDUAL);
+    CHECK((st.buttons & 0xffffull) == (DM_BTN_X | DM_BTN_A | DM_BTN_R | DM_BTN_ZR | DM_BTN_PLUS | DM_BTN_RS),
+          "KIND_PAD Vertical right Joy-Con: keeps physical X/A (no sideways X->A swap) and suppresses rail");
+    CHECK(st.lx == 0 && st.ly == 20000 && st.rx == 0 && st.ry == 0 && (st.buttons & (1u << 17)) && !(st.buttons & (1u << 21)),
+          "KIND_PAD Vertical right Joy-Con: stick goes to lx/ly unrotated with StickLUp");
+
+    h_hid_HoldType(1); CHECK(h_hid_GetHold() == 1, "SetNpadJoyHoldType(1) sets Horizontal");
+    dm_joy_set(1, 1, DM_BTN_X | DM_BTN_R | DM_BTN_RSL, 0, 20000);
+    st = npad_of(1, STYLE_JOYDUAL);
