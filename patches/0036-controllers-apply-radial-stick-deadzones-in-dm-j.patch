@@ -65,12 +65,16 @@ void dm_input_set(uint64_t buttons, int32_t lx, int32_t ly, int32_t rx, int32_t
     uint64_t old = atomic_exchange(&g_btn, buttons); atomic_fetch_or(&g_latch, buttons & ~old); atomic_fetch_or(&g_peek_latch, buttons & ~old); atomic_store(&g_axes, pack(lx, ly, rx, ry));
     shake_note(0);
 }
-// The front end's per-stick deadzones (stick_deadzone.h), read once: the environment is fixed at launch. Every physical controller passes through
-// dm_pad_set_player, so the same deadzone holds on the Mac and the iPhone; keyboard, touch and scripted input do not use it.
+// The front end's per-stick deadzones (stick_deadzone.h), read once: the environment is fixed at launch. Physical controllers pass through
+// dm_pad_set_player and Joy-Cons through dm_joy_set, so the same deadzone holds across controller modes on the Mac and the iPhone.
+static _Atomic int g_stick_dz[2] = {-1, -1};
 static int stick_dz(int right) {
-    static int cached[2] = {-1, -1};
-    if (cached[right] < 0) cached[right] = stick_deadzone_percent(getenv(right ? "DM_STICK_DEADZONE_R" : "DM_STICK_DEADZONE_L"));
-    return cached[right];
+    int d = atomic_load_explicit(&g_stick_dz[right], memory_order_relaxed);
+    if (d < 0) {
+        d = stick_deadzone_percent(getenv(right ? "DM_STICK_DEADZONE_R" : "DM_STICK_DEADZONE_L"));
+        atomic_store_explicit(&g_stick_dz[right], d, memory_order_relaxed);
+    }
+    return d;
 }
 void dm_pad_set_player(int p, uint64_t buttons, int32_t lx, int32_t ly, int32_t rx, int32_t ry) {
     if (p < 0 || p >= DM_PLAYERS) return;
@@ -462,6 +466,7 @@ void dm_joy_attach(int p, uint32_t sides) {
 }
 void dm_joy_set(int p, int side, uint64_t buttons, int32_t sx, int32_t sy) {
     if (p < 0 || p >= DM_PLAYERS || (side != 0 && side != 1)) return;
+    stick_deadzone_apply(&sx, &sy, stick_dz(side));
     uint64_t old = atomic_exchange(&g_joy_btn[p][side], buttons); atomic_fetch_or(&g_joy_latch[p][side], buttons & ~old);
     atomic_store(&g_joy_axes[p][side], pack(sx, sy, 0, 0));
 }
@@ -651,6 +656,52 @@ static uint64_t single_joy_fold(uint32_t style, uint64_t buttons, int32_t a[4])
     a[2 * !side] = 0; a[2 * !side + 1] = 0;
     return folded;
 }
+static _Atomic uint32_t g_hold_type;   // NpadJoyHoldType: 0 = Vertical (default), 1 = Horizontal
+// Sideways mapping for a single Joy-Con shown as a whole controller (KIND_PAD) when NpadJoyHoldType is Horizontal: match jc1_sideways_buttons / jc1_sideways_stick across Joy-Con 1 and 2
+static uint64_t joy_sideways_buttons(uint64_t b, int right) {
+    static const uint64_t from_l[4] = {DM_BTN_DOWN, DM_BTN_LEFT, DM_BTN_RIGHT, DM_BTN_UP};
+    static const uint64_t from_r[4] = {DM_BTN_X, DM_BTN_A, DM_BTN_Y, DM_BTN_B};
+    static const uint64_t to[4] = {DM_BTN_A, DM_BTN_B, DM_BTN_X, DM_BTN_Y};
+    const uint64_t *from = right ? from_r : from_l;
+    uint64_t m = b & (DM_BTN_L | DM_BTN_R | DM_BTN_ZL | DM_BTN_ZR | DM_BTN_PLUS | DM_BTN_MINUS | DM_BTN_SHAKE);
+    for (int i = 0; i < 4; i++) if (b & from[i]) m |= to[i];
+    if (b & (DM_BTN_LSL | DM_BTN_RSL)) m |= DM_BTN_L;
+    if (b & (DM_BTN_LSR | DM_BTN_RSR)) m |= DM_BTN_R;
+    if (b & (DM_BTN_LS | DM_BTN_RS)) m |= DM_BTN_LS;
+    return m;
+}
+static void fill_pad_slot(int p, uint64_t *b, int32_t a[4], uint32_t shown) {
+    uint64_t pb = atomic_load(&g_pad_btn[p]) | atomic_exchange(&g_pad_latch[p], 0);
+    if (!joy_active(p)) {
+        *b |= pb;
+        uint64_t v = atomic_load(&g_pad_axes[p]); for (int i = 0; i < 4; i++) a[i] = pick(a[i], ax(v, i));
+        return;
+    }
+    *b |= pb & DM_BTN_SHAKE;
+    uint32_t sides = atomic_load(&g_joy_sides[p]);
+    if (sides == 3) {
+        for (int side = 0; side < 2; side++) {
+            *b |= atomic_load(&g_joy_btn[p][side]) | atomic_exchange(&g_joy_latch[p][side], 0);
+            uint64_t v = atomic_load(&g_joy_axes[p][side]);
+            a[2 * side] = pick(a[2 * side], ax(v, 0));
+            a[2 * side + 1] = pick(a[2 * side + 1], ax(v, 1));
+        }
+        return;
+    }
+    int side = sides == 2;
+    uint64_t jb = atomic_load(&g_joy_btn[p][side]) | atomic_exchange(&g_joy_latch[p][side], 0);
+    uint64_t v = atomic_load(&g_joy_axes[p][side]);
+    int32_t jx = ax(v, 0), jy = ax(v, 1);
+    if (!single_joy_style(shown) && atomic_load(&g_hold_type) == 1) {
+        *b |= joy_sideways_buttons(jb, side);
+        a[0] = pick(a[0], side ? jy : -jy);
+        a[1] = pick(a[1], side ? -jx : jx);
+    } else {
+        *b |= jb;
+        a[0] = pick(a[0], jx);
+        a[1] = pick(a[1], jy);
+    }
+}
 static void fill(NpadState *s, uint32_t id, uint32_t style) {
     memset(s, 0, sizeof *s);
     s->sampling = atomic_fetch_add(&g_sampling, 1) + 1;
@@ -667,10 +718,7 @@ static void fill(NpadState *s, uint32_t id, uint32_t style) {
         b = atomic_load(&g_btn) | atomic_exchange(&g_latch, 0);
         uint64_t k = atomic_load(&g_axes); for (int i = 0; i < 4; i++) a[i] = ax(k, i);
     }
-    for (int p = 0; p < DM_PLAYERS; p++) if (src >> p & 1) {
-        b |= atomic_load(&g_pad_btn[p]) | atomic_exchange(&g_pad_latch[p], 0);
-        uint64_t v = atomic_load(&g_pad_axes[p]); for (int i = 0; i < 4; i++) a[i] = pick(a[i], ax(v, i));
-    }
+    for (int p = 0; p < DM_PLAYERS; p++) if (src >> p & 1) fill_pad_slot(p, &b, a, shown);
     if (!pl) {   // the physical sources so far (DM_REC records them, DM_BTN_SHAKE only from player 1's own controller and the keyboard, as shake_note), then the scripted path
         if (atomic_load_explicit(&g_rec_on, memory_order_relaxed)) rec_read((b & 0xffffull) | ((atomic_load(&g_btn) | atomic_load(&g_pad_btn[0])) & DM_BTN_SHAKE), a);
         b |= atomic_load(&g_sc_btn) | atomic_exchange(&g_sc_latch, 0);
@@ -750,8 +798,7 @@ HLE_FORCE("_ZN2nn3hid13GetNpadStatesEPNS0_16NpadJoyDualStateEiRKj", "dual Joy-Co
 HLE_FORCE("_ZN2nn3hid13GetNpadStatesEPNS0_16NpadJoyLeftStateEiRKj", "left Joy-Con states (not connected on the host)", int, h_hid_StatesJoyLeft, NpadState *s, int n, const uint32_t *id) { return states(s, n, *id, STYLE_JOYLEFT); }
 HLE_FORCE("_ZN2nn3hid13GetNpadStatesEPNS0_17NpadJoyRightStateEiRKj", "right Joy-Con states (not connected on the host)", int, h_hid_StatesJoyRight, NpadState *s, int n, const uint32_t *id) { return states(s, n, *id, STYLE_JOYRIGHT); }
 HLE_FORCE("_ZN2nn3hid14DisconnectNpadERKj", "disconnect a controller; ignored by the host", void, h_hid_Disconnect, const uint32_t *id) { (void)id; }
-static uint32_t g_hold_type;
-HLE_FORCE("_ZN2nn3hid18SetNpadJoyHoldTypeENS0_15NpadJoyHoldTypeE", "Joy-Con hold orientation; the host only records it", void, h_hid_HoldType, int t) { g_hold_type = (uint32_t)t; }
+HLE_FORCE("_ZN2nn3hid18SetNpadJoyHoldTypeENS0_15NpadJoyHoldTypeE", "Joy-Con hold orientation: recorded for fallback whole-controller reads", void, h_hid_HoldType, int t) { atomic_store(&g_hold_type, (uint32_t)t); }
 // The game's choice of how the Joy-Cons of a pad are used (npad_resolve): single, left or right staying on the npad, or dual. NpadJoyDeviceType: Left 0, Right 1; NpadJoyAssignmentMode: Dual 0, Single 1
 static void joy_assign(uint32_t id, int single, int keep) {
     if (id >= DM_PLAYERS) return;
@@ -1839,7 +1886,7 @@ HLE_FORCE("_ZN2nn3hid12GetNpadStateEPNS0_16NpadJoyLeftStateERKj", "left Joy-Con
 HLE_FORCE("_ZN2nn3hid12GetNpadStateEPNS0_17NpadJoyRightStateERKj", "right Joy-Con current state (not connected on the host)", void, h_hid_StateJoyRight, NpadState *s, const uint32_t *id) { fill(s, *id, STYLE_JOYRIGHT); }
 
 static uint32_t g_comm_mode, g_hh_mode;
-HLE_FORCE("_ZN2nn3hid18GetNpadJoyHoldTypeEv", "Joy-Con hold orientation: returns the value that was set", int, h_hid_GetHold, void) { return (int)g_hold_type; }
+HLE_FORCE("_ZN2nn3hid18GetNpadJoyHoldTypeEv", "Joy-Con hold orientation: returns the value that was set", int, h_hid_GetHold, void) { return (int)atomic_load(&g_hold_type); }
 HLE_FORCE("_ZN2nn3hid24GetSupportedNpadStyleSetEv", "supported controller styles: all", uint32_t, h_hid_GetStyles, void) { return atomic_load(&g_styles_supported); }
 HLE_FORCE("_ZN2nn3hid24GetNpadCommunicationModeEv", "wireless communication mode: returns the value that was set", int, h_hid_GetComm, void) { return (int)g_comm_mode; }
 HLE_FORCE("_ZN2nn3hid24SetNpadCommunicationModeENS0_21NpadCommunicationModeE", "wireless communication mode; the host only records it", void, h_hid_SetComm, int m) { g_comm_mode = (uint32_t)m; }
@@ -1920,6 +1967,8 @@ static int touch_read(void *s, int N, int want) {
     return cnt;
 }
