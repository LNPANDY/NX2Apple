new file mode 100644
index 0000000000000000000000000000000000000000..cd51b2b5f522a74315a565cbce64a8ee60e41514
--- /dev/null
+++ b/dm/apple/GameTime/Sources/GameTime/include/DMGameTime.h
@@ -0,0 +1,17 @@
+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+NSURL * _Nullable DMGameTimeCloudURL(NSString * _Nullable folder, NSString *titleID);
+NSURL * _Nullable DMGameTimeLocalURL(NSURL *saveURL, NSURL * _Nullable cloudURL, NSString *titleID);
+// Legacy undated records remain readable and are never added twice to dated history.
+BOOL DMGameTimeUpdateRun(NSURL *localURL, NSString *runID, uint64_t milliseconds, NSError **error);
+BOOL DMGameTimeUpdateSegments(NSURL *localURL, NSArray<NSDictionary *> *segments, uint64_t lastActivityAt, NSError **error);
+NSArray<NSDictionary *> *DMGameTimeSplitInterval(NSDate *start, NSDate *end, uint64_t milliseconds, NSString *previousZone, NSString *currentZone);
+NSNumber * _Nullable DMGameTimeTotal(NSURL *localURL, NSError **error);
+NSDictionary * _Nullable DMGameTimeSummary(NSURL *localURL, NSError **error);
+NSDictionary * _Nullable DMGameTimeDailyTotals(NSURL *localURL, NSError **error);
+// Blocking provider work: call off the UI/game thread. A summary reuses the coordinated merge, without rereading the file.
+NSDictionary * _Nullable DMGameTimeSynchronizeSummary(NSURL *localURL, NSURL * _Nullable cloudURL, NSError **error);
+BOOL DMGameTimeSynchronize(NSURL *localURL, NSURL * _Nullable cloudURL, NSError **error);
+int DMGameTimeSynchronizePaths(const char *save, const char *titleID, const char * _Nullable folder, int timeoutMilliseconds);
+NS_ASSUME_NONNULL_END
