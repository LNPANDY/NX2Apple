diff --git a/dm/host/play_time.h b/dm/host/play_time.h
new file mode 100644
index 0000000000000000000000000000000000000000..d5a1738af357b32db78e4625f4747052b37ad35e
--- /dev/null
+++ b/dm/host/play_time.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <stdint.h>
+void dm_play_time_start(void);
+void dm_play_time_pause(int paused);
+void dm_play_time_committed(void);
+void dm_play_time_sync(void);
+int dm_play_time_flush(int timeout_ms);
+// Background expiry cancels publication until resume; local checkpoints remain durable.
+void dm_play_time_cancel_sync(void);
+void dm_play_time_finish(void);
+
+typedef struct { uint64_t elapsed, anchor; int running; } dm_play_clock;
+static inline void dm_play_clock_set(dm_play_clock *c, uint64_t now, int running) {
+    if (c->running && now >= c->anchor) c->elapsed += now - c->anchor;
+    c->anchor = now; c->running = running;
+}
diff --git a/dm/host/play_time.m b/dm/host/play_time.m
new file mode 100644
index 0000000000000000000000000000000000000000..f940b7f6ee83de4c2752b1144fc6bcdc2377a229
--- /dev/null
+++ b/dm/host/play_time.m
@@ -0,0 +1,163 @@
+#import <Foundation/Foundation.h>
+#import "../apple/GameTime/Sources/GameTime/include/DMGameTime.h"
+#include "play_time.h"
+#include "hle_profile.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <pthread.h>
+uint64_t now_ns(void);
+
+static pthread_mutex_t g_time_mu = PTHREAD_MUTEX_INITIALIZER;
+static dm_play_clock g_time_clock;
+static int g_time_paused, g_time_publication_suspended;
+static NSString *g_time_run, *g_time_day, *g_time_zone;
+static NSDate *g_time_wall;
+static uint64_t g_time_remainder;
+static NSMutableDictionary *g_time_state, *g_time_finished_state;
+static dispatch_source_t g_time_timer;
+
+static void time_error(NSError *error) {
+    if (error) fprintf(stderr, "[dm] play time: %s\n", error.localizedDescription.UTF8String);
+}
+__attribute__((weak)) NSDate *dm_play_time_wall_now(void) { return [NSDate date]; }
+__attribute__((weak)) NSString *dm_play_time_zone_now(void) { return NSTimeZone.localTimeZone.name; }
+// Each writer captures its session state; a delayed old session cannot clear a new session's pending work.
+static void schedule_write(NSMutableDictionary *state, dispatch_queue_t queue) {
+    if ([state[@"writing"] boolValue]) return;
+    state[@"writing"] = @YES;
+    dispatch_group_t group = state[@"group"]; dispatch_group_enter(group);
+    dispatch_async(queue, ^{
+        for (;;) { @autoreleasepool {
+            pthread_mutex_lock(&g_time_mu);
+            NSArray *batch = [state[@"pending"] allValues]; NSNumber *last = state[@"last"];
+            pthread_mutex_unlock(&g_time_mu);
+            NSError *error = nil;
+            BOOL ok = DMGameTimeUpdateSegments(state[@"local"], batch, last.unsignedLongLongValue, &error); time_error(error);
+            pthread_mutex_lock(&g_time_mu);
+            if (ok) for (NSDictionary *part in batch) {
+                NSDictionary *current = state[@"pending"][part[@"id"]];
+                if ([current[@"milliseconds"] unsignedLongLongValue] <= [part[@"milliseconds"] unsignedLongLongValue]) [state[@"pending"] removeObjectForKey:part[@"id"]];
+            }
+            BOOL again = ok && [state[@"pending"] count] > 0;
+            if (!again) state[@"writing"] = @NO;
+            pthread_mutex_unlock(&g_time_mu);
+            if (!again) break;
+        }}
+        dispatch_group_leave(group);
+    });
+}
+static dispatch_queue_t g_time_local_queue;
+static NSOperationQueue *g_time_sync, *g_time_finished_sync;
+static dispatch_queue_t g_time_finished_queue;
+static void checkpoint(uint64_t now) { // g_time_mu held; filesystem work stays off the caller's thread.
+    uint64_t before = g_time_clock.elapsed;
+    dm_play_clock_set(&g_time_clock, now, g_time_clock.running);
+    uint64_t delta = g_time_clock.elapsed - before;
+    NSDate *wall = dm_play_time_wall_now(); NSString *zone = dm_play_time_zone_now();
+    uint64_t whole = (delta + g_time_remainder) / 1000000; g_time_remainder = (delta + g_time_remainder) % 1000000;
+    NSArray *parts = DMGameTimeSplitInterval(g_time_wall, wall, whole, g_time_zone, zone);
+    for (NSDictionary *part in parts) {
+        if (![g_time_day isEqual:part[@"day"]]) { g_time_run = NSUUID.UUID.UUIDString.lowercaseString; g_time_day = part[@"day"]; g_time_state[@"segmentMs"] = @0; }
+        uint64_t ms = [g_time_state[@"segmentMs"] unsignedLongLongValue] + [part[@"milliseconds"] unsignedLongLongValue];
+        g_time_state[@"segmentMs"] = @(ms);
+        g_time_state[@"pending"][g_time_run] = @{@"id": g_time_run, @"day": g_time_day, @"milliseconds": @(ms)};
+    }
+    // A finish while already paused must not move Last played into the suspended gap.
+    if (whole) g_time_state[@"last"] = @(MAX([g_time_state[@"last"] unsignedLongLongValue], (uint64_t)MAX(0, [wall timeIntervalSince1970] * 1000)));
+    g_time_wall = wall; g_time_zone = zone;
+    schedule_write(g_time_state, g_time_local_queue);
+}
+static void request_sync_state(NSMutableDictionary *state, dispatch_queue_t writes, NSOperationQueue *sync) {
+    if (!state[@"cloud"] || [state[@"suspended"] boolValue] || sync.operationCount > 1) return;
+    NSProgress *progress = DMGameTimeSyncProgress(); [state[@"attempts"] addObject:progress];
+    dispatch_group_t group = state[@"group"]; dispatch_group_enter(group);
+    [sync addOperationWithBlock:^{ @autoreleasepool {
+        if (!progress.cancelled) dispatch_sync(writes, ^{});
+        NSError *error = nil; BOOL ok = DMGameTimeSynchronizeSummaryWithProgress(state[@"local"], state[@"cloud"], progress, &error) != nil;
+        if (!progress.cancelled) time_error(error);
+        pthread_mutex_lock(&g_time_mu); state[@"syncOK"] = @(ok); [state[@"attempts"] removeObject:progress]; pthread_mutex_unlock(&g_time_mu);
+        dispatch_group_leave(group);
+    }}];
+}
+static void request_sync(void) { request_sync_state(g_time_state, g_time_local_queue, g_time_sync); }
+void dm_play_time_start(void) { @autoreleasepool {
+    pthread_mutex_lock(&g_time_mu);
+    const char *save = getenv("DM_SAVE");
+    if (g_time_state || !save || !*save) { pthread_mutex_unlock(&g_time_mu); return; }
+    NSURL *cloud = DMGameTimeCloudURL(getenv("DM_SAVE_SYNC") ? @(getenv("DM_SAVE_SYNC")) : nil, @(dm_profile()->id));
+    NSURL *local = DMGameTimeLocalURL([NSURL fileURLWithPath:@(save)], cloud, @(dm_profile()->id));
+    if (!local) { pthread_mutex_unlock(&g_time_mu); return; }
+    g_time_state = [@{@"local": local, @"pending": [NSMutableDictionary dictionary], @"last": @0, @"segmentMs": @0, @"group": dispatch_group_create(), @"attempts": [NSMutableArray array], @"suspended": @(g_time_publication_suspended)} mutableCopy];
+    if (cloud) g_time_state[@"cloud"] = cloud;
+    g_time_state[@"syncOK"] = @(!cloud);
+    g_time_run = NSUUID.UUID.UUIDString.lowercaseString; g_time_day = nil; g_time_remainder = 0;
+    g_time_wall = dm_play_time_wall_now(); g_time_zone = dm_play_time_zone_now();
+    g_time_clock = (dm_play_clock){.anchor = now_ns(), .running = !g_time_paused};
+    g_time_local_queue = dispatch_queue_create("game-time.local", dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_UTILITY, 0));
+    g_time_sync = [NSOperationQueue new]; g_time_sync.maxConcurrentOperationCount = 1; g_time_sync.qualityOfService = NSQualityOfServiceUtility;
+    g_time_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, g_time_local_queue);
+    dispatch_source_set_timer(g_time_timer, g_time_paused ? DISPATCH_TIME_FOREVER : dispatch_time(DISPATCH_TIME_NOW, 60 * NSEC_PER_SEC), 60 * NSEC_PER_SEC, 5 * NSEC_PER_SEC);
+    NSMutableDictionary *state = g_time_state;
+    dispatch_source_set_event_handler(g_time_timer, ^{
+        pthread_mutex_lock(&g_time_mu);
+        if (g_time_state == state && g_time_clock.running) checkpoint(now_ns());
+        pthread_mutex_unlock(&g_time_mu);
+    });
+    dispatch_resume(g_time_timer); request_sync(); pthread_mutex_unlock(&g_time_mu);
+    static int registered; if (!registered) { registered = 1; atexit(dm_play_time_finish); }
+}}
+void dm_play_time_committed(void) {
+    pthread_mutex_lock(&g_time_mu);
+    if (g_time_state) checkpoint(now_ns());
+    pthread_mutex_unlock(&g_time_mu);
+}
+void dm_play_time_sync(void) {
+    pthread_mutex_lock(&g_time_mu); if (g_time_state) request_sync(); pthread_mutex_unlock(&g_time_mu);
+}
+void dm_play_time_pause(int paused) {
+    pthread_mutex_lock(&g_time_mu); g_time_paused = paused;
+    if (!paused) { g_time_publication_suspended = 0; g_time_state[@"suspended"] = @NO; }
+    if (g_time_state) {
+        checkpoint(now_ns()); dm_play_clock_set(&g_time_clock, now_ns(), !paused);
+        g_time_wall = dm_play_time_wall_now(); g_time_zone = dm_play_time_zone_now();
+        dispatch_source_set_timer(g_time_timer, paused ? DISPATCH_TIME_FOREVER : dispatch_time(DISPATCH_TIME_NOW, 60 * NSEC_PER_SEC), 60 * NSEC_PER_SEC, 5 * NSEC_PER_SEC);
+        request_sync();
+    }
+    pthread_mutex_unlock(&g_time_mu);
+}
+int dm_play_time_flush(int timeout_ms) {
+    pthread_mutex_lock(&g_time_mu);
+    NSMutableDictionary *state = g_time_state ?: g_time_finished_state;
+    if (g_time_state) { checkpoint(now_ns()); request_sync(); }
+    else if (state) { schedule_write(state, g_time_finished_queue); request_sync_state(state, g_time_finished_queue, g_time_finished_sync); }
+    dispatch_group_t group = state[@"group"];
+    NSArray *attempts = [state[@"attempts"] copy];
+    pthread_mutex_unlock(&g_time_mu);
+    if (!group) return 1;
+    if (dispatch_group_wait(group, dispatch_time(DISPATCH_TIME_NOW, (int64_t)MAX(0, timeout_ms) * NSEC_PER_MSEC))) {
+        for (NSProgress *attempt in attempts) [attempt cancel];
+        return 0;
+    }
+    pthread_mutex_lock(&g_time_mu);
+    int ok = ![state[@"pending"] count] && [state[@"syncOK"] boolValue];
+    pthread_mutex_unlock(&g_time_mu); return ok;
+}
+void dm_play_time_cancel_sync(void) {
+    pthread_mutex_lock(&g_time_mu);
+    g_time_publication_suspended = 1; g_time_state[@"suspended"] = @YES; g_time_finished_state[@"suspended"] = @YES;
+    NSMutableArray *attempts = [NSMutableArray arrayWithArray:g_time_state[@"attempts"] ?: @[]];
+    [attempts addObjectsFromArray:g_time_finished_state[@"attempts"] ?: @[]];
+    pthread_mutex_unlock(&g_time_mu);
+    for (NSProgress *attempt in attempts) [attempt cancel];
+}
+void dm_play_time_finish(void) {
+    pthread_mutex_lock(&g_time_mu); dispatch_queue_t writes = nil;
+    if (g_time_state) {
+        checkpoint(now_ns()); g_time_clock.running = 0;
+        dispatch_source_cancel(g_time_timer); g_time_timer = nil; request_sync(); writes = g_time_local_queue;
+        g_time_finished_state = g_time_state; g_time_finished_queue = writes; g_time_finished_sync = g_time_sync;
+        g_time_run = nil; g_time_day = nil; g_time_state = nil; g_time_sync = nil; g_time_local_queue = nil;
+    }
+    pthread_mutex_unlock(&g_time_mu);
+    if (writes) dispatch_sync(writes, ^{});
+}
