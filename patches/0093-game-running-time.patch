+import PackageDescription
+
+let package = Package(
+    name: "GameTime",
+    platforms: [.macOS(.v13), .iOS(.v16)],
+    products: [.library(name: "GameTime", targets: ["GameTime"])],
+    targets: [.target(name: "GameTime", linkerSettings: [.linkedFramework("Foundation")])]
