diff --git a/dm/apple/GameTime/Sources/GameTime/DMGameTime.m b/dm/apple/GameTime/Sources/GameTime/DMGameTime.m
new file mode 100644
index 0000000..2a3d5c6
--- /dev/null
+++ b/dm/apple/GameTime/Sources/GameTime/DMGameTime.m
@@ -0,0 +1,155 @@
+#import "DMGameTime.h"
+#import <CommonCrypto/CommonDigest.h>
+#import <TargetConditionals.h>
+#import <math.h>
+
+static const NSUInteger MaxBytes = 32 * 1024 * 1024;
+static NSError *invalid(NSString *why) {
+    return [NSError errorWithDomain:@"GameTime" code:1 userInfo:@{NSLocalizedDescriptionKey: why}];
+}
+
+NSURL *DMGameTimeCloudURL(NSString *folder, NSString *titleID) {
+    if (!folder.length || [folder isEqual:@"0"]) return nil;
+    NSCharacterSet *hex = [NSCharacterSet characterSetWithCharactersInString:@"0123456789ABCDEF"];
+    NSString *title = titleID.uppercaseString;
+    if (title.length != 16 || [title rangeOfCharacterFromSet:hex.invertedSet].location != NSNotFound) return nil;
+    if ([folder isEqual:@"icloud"]) {
+#if TARGET_OS_OSX
+        folder = [NSHomeDirectory() stringByAppendingPathComponent:@"Library/Mobile Documents/com~apple~CloudDocs/nxnative Saves"];
+        if (![NSFileManager.defaultManager fileExistsAtPath:folder.stringByDeletingLastPathComponent]) return nil;
+#else
+        return nil;
+#endif
+    }
+    NSURL *url = [NSURL fileURLWithPath:folder isDirectory:YES];
+    if (![url.lastPathComponent.uppercaseString isEqual:title]) url = [url URLByAppendingPathComponent:title isDirectory:YES];
+    return [url URLByAppendingPathComponent:@"playtime.json"];
+}
+NSURL *DMGameTimeLocalURL(NSURL *saveURL, NSURL *cloudURL, NSString *titleID) {
+    NSCharacterSet *hex = [NSCharacterSet characterSetWithCharactersInString:@"0123456789ABCDEF"];
+    if (titleID.length != 16 || [titleID.uppercaseString rangeOfCharacterFromSet:hex.invertedSet].location != NSNotFound) return nil;
+    // A different chosen cloud destination must not inherit another destination's downloaded history.
+    NSString *scope = @"local";
+    if (cloudURL) {
+        NSData *path = [cloudURL.URLByStandardizingPath.path dataUsingEncoding:NSUTF8StringEncoding];
+        unsigned char digest[CC_SHA256_DIGEST_LENGTH]; CC_SHA256(path.bytes, (CC_LONG)path.length, digest);
+        NSMutableString *hex = [NSMutableString string];
+        for (NSUInteger i = 0; i < sizeof digest; i++) [hex appendFormat:@"%02x", digest[i]];
+        scope = hex;
+    }
+    NSURL *dir = [saveURL.URLByDeletingLastPathComponent URLByAppendingPathComponent:@"playtime" isDirectory:YES];
+    dir = [dir URLByAppendingPathComponent:titleID.uppercaseString isDirectory:YES];
+    return [dir URLByAppendingPathComponent:[scope stringByAppendingString:@".json"]];
+}
+static NSMutableDictionary *readRuns(NSURL *url, BOOL allowMissing, NSError **error) {
+    NSString *placeholder = [url.URLByDeletingLastPathComponent.path stringByAppendingPathComponent:[NSString stringWithFormat:@".%@.icloud", url.lastPathComponent]];
+    if ([NSFileManager.defaultManager fileExistsAtPath:placeholder] && ![NSFileManager.defaultManager fileExistsAtPath:url.path]) {
+        if (error) *error = invalid(@"Play time is still downloading."); return nil;
+    }
+    NSError *e;
+    NSDictionary *attributes = [NSFileManager.defaultManager attributesOfItemAtPath:url.path error:&e];
+    if (!attributes) {
+        if (allowMissing && [e.domain isEqual:NSCocoaErrorDomain] && (e.code == NSFileReadNoSuchFileError || e.code == NSFileNoSuchFileError)) return [NSMutableDictionary dictionary];
+        if (error) *error = e; return nil;
+    }
+    if ([attributes[NSFileSize] unsignedLongLongValue] > MaxBytes) { if (error) *error = invalid(@"Play time document exceeds 32 MiB."); return nil; }
+    NSData *data = [NSData dataWithContentsOfURL:url options:0 error:error];
+    if (!data) return nil;
+    id doc = [NSJSONSerialization JSONObjectWithData:data options:0 error:error];
+    if (!doc) return nil;
+    if (![doc isKindOfClass:NSDictionary.class] || ![doc[@"version"] isEqual:@1] || CFGetTypeID((__bridge CFTypeRef)doc[@"version"]) == CFBooleanGetTypeID() ||
+        ![doc[@"runs"] isKindOfClass:NSDictionary.class]) { if (error) *error = invalid(@"Unsupported play time document."); return nil; }
+    NSMutableDictionary *runs = [NSMutableDictionary dictionary];
+    for (NSString *key in doc[@"runs"]) {
+        id n = doc[@"runs"][key];
+        double d = [n isKindOfClass:NSNumber.class] ? [n doubleValue] : -1;
+        NSUUID *uuid = [[NSUUID alloc] initWithUUIDString:key];
+        // JSON doubles above 2^53 cannot represent every integer, so refuse ambiguous durations.
+        if (!uuid || ![n isKindOfClass:NSNumber.class] || CFGetTypeID((__bridge CFTypeRef)n) == CFBooleanGetTypeID() ||
+            !isfinite(d) || d < 0 || d > 9007199254740991.0 || floor(d) != d) {
+            if (error) *error = invalid(@"Invalid play time entry."); return nil;
+        }
+        NSString *canonical = uuid.UUIDString.lowercaseString;
+        runs[canonical] = @(MAX([runs[canonical] unsignedLongLongValue], [n unsignedLongLongValue]));
+    }
+    return runs;
+}
+static void join(NSMutableDictionary *into, NSDictionary *other) {
+    for (NSString *key in other) into[key] = @(MAX([into[key] unsignedLongLongValue], [other[key] unsignedLongLongValue]));
+}
+static BOOL writeRuns(NSDictionary *runs, NSURL *url, NSError **error) {
+    NSData *data = [NSJSONSerialization dataWithJSONObject:@{@"version": @1, @"runs": runs} options:NSJSONWritingSortedKeys error:error];
+    if (!data) return NO;
+    if (data.length > MaxBytes) { if (error) *error = invalid(@"Play time document exceeds 32 MiB."); return NO; }
+    return [data writeToURL:url options:NSDataWritingAtomic error:error];
+}
+static NSDictionary *mergeLocal(NSURL *localURL, NSDictionary *incoming, NSError **error) {
+    NSFileManager *fm = NSFileManager.defaultManager;
+    if (![fm createDirectoryAtURL:localURL.URLByDeletingLastPathComponent withIntermediateDirectories:YES attributes:nil error:error]) return nil;
+    __block NSDictionary *result;
+    __block NSError *failure;
+    NSError *coordination;
+    [[[NSFileCoordinator alloc] initWithFilePresenter:nil] coordinateWritingItemAtURL:localURL options:NSFileCoordinatorWritingForMerging error:&coordination byAccessor:^(NSURL *url) {
+        NSMutableDictionary *runs = readRuns(url, YES, &failure);
+        if (!runs) return;
+        NSDictionary *before = runs.copy;
+        join(runs, incoming);
+        if (![before isEqual:runs] && !writeRuns(runs, url, &failure)) return;
+        result = runs;
+    }];
+    if (!result && error) *error = coordination ?: failure ?: invalid(@"Could not read play time.");
+    return result;
+}
+BOOL DMGameTimeUpdateRun(NSURL *localURL, NSString *runID, uint64_t milliseconds, NSError **error) {
+    NSUUID *uuid = [[NSUUID alloc] initWithUUIDString:runID];
+    if (!uuid || milliseconds > 9007199254740991ULL) { if (error) *error = invalid(@"Invalid play time entry."); return NO; }
+    return mergeLocal(localURL, @{uuid.UUIDString.lowercaseString: @(milliseconds)}, error) != nil;
+}
+NSNumber *DMGameTimeTotal(NSURL *localURL, NSError **error) {
+    NSError *missing;
+    if (![NSFileManager.defaultManager attributesOfItemAtPath:localURL.path error:&missing]) {
+        if ([missing.domain isEqual:NSCocoaErrorDomain] && (missing.code == NSFileReadNoSuchFileError || missing.code == NSFileNoSuchFileError)) return @0;
+        if (error) *error = missing;
+        return nil;
+    }
+    NSDictionary *runs = mergeLocal(localURL, @{}, error);
+    if (!runs) return nil;
+    uint64_t total = 0;
+    for (NSNumber *n in runs.allValues) {
+        uint64_t value = n.unsignedLongLongValue;
+        if (UINT64_MAX - total < value) { if (error) *error = invalid(@"Play time total overflow."); return nil; }
+        total += value;
+    }
+    return @(total);
+}
+BOOL DMGameTimeSynchronize(NSURL *localURL, NSURL *cloudURL, NSError **error) {
+    if (!cloudURL) return YES;
+    NSFileManager *fm = NSFileManager.defaultManager;
+    if (![fm createDirectoryAtURL:cloudURL.URLByDeletingLastPathComponent withIntermediateDirectories:YES attributes:nil error:error]) return NO;
+    [fm startDownloadingUbiquitousItemAtURL:cloudURL error:nil];
+    __block BOOL ok = NO;
+    __block NSError *failure;
+    NSError *coordination;
+    [[[NSFileCoordinator alloc] initWithFilePresenter:nil] coordinateWritingItemAtURL:cloudURL options:NSFileCoordinatorWritingForMerging error:&coordination byAccessor:^(NSURL *url) {
+        NSMutableDictionary *remote = readRuns(url, YES, &failure);
+        if (!remote) return;
+        NSDictionary *before = remote.copy;
+        NSArray<NSFileVersion *> *versions = [NSFileVersion unresolvedConflictVersionsOfItemAtURL:url];
+        for (NSFileVersion *version in versions) {
+            NSDictionary *runs = readRuns(version.URL, NO, &failure);
+            if (!runs) return; // Keep unknown versions intact instead of replacing data this version cannot understand.
+            join(remote, runs);
+        }
+        // Lock ordering is cloud then local; checkpoints acquire only the local coordinator.
+        NSDictionary *merged = mergeLocal(localURL, remote, &failure);
+        if (!merged) return;
+        if (![before isEqual:merged] && !writeRuns(merged, url, &failure)) return;
+        for (NSFileVersion *version in versions) {
+            version.resolved = YES;
+            if (![version removeAndReturnError:&failure]) return;
+        }
+        ok = YES;
+    }];
+    if (!ok && error) *error = coordination ?: failure ?: invalid(@"Could not synchronize play time.");
+    return ok;
+}
