+NSURL * _Nullable DMGameTimeLocalURL(NSURL *saveURL, NSURL * _Nullable cloudURL, NSString *titleID);
+// Legacy undated records remain readable and are never added twice to dated history.
+BOOL DMGameTimeUpdateRun(NSURL *localURL, NSString *runID, uint64_t milliseconds, NSError **error);
