+#import <Foundation/Foundation.h>
+#import "DMGameTime.h"
+#include "../play_time.h"
+#include "../hle_profile.h"
+#include <assert.h>
+#include <stdatomic.h>
+
+static _Atomic uint64_t ticks;
+static NSDate *wall;
+NSDate *dm_play_time_wall_now(void) { return wall; }
+NSString *dm_play_time_zone_now(void) { return @"America/Chicago"; }
+uint64_t now_ns(void) { return atomic_load(&ticks); }
+const struct dm_profile *dm_profile(void) { static const struct dm_profile p = {.id = "0100000000000000"}; return &p; }
+static void advance(uint64_t ns) { atomic_fetch_add(&ticks, ns); wall = [wall dateByAddingTimeInterval:(double)ns / 1e9]; }
+int main(void) { @autoreleasepool {
+    NSURL *root = [[NSURL fileURLWithPath:NSTemporaryDirectory()] URLByAppendingPathComponent:NSUUID.UUID.UUIDString];
+    NSURL *save = [root URLByAppendingPathComponent:@"save"];
+    NSURL *local = DMGameTimeLocalURL(save, nil, @"0100000000000000");
+    wall = [[NSISO8601DateFormatter new] dateFromString:@"2026-11-12T05:59:50Z"];
+    unsetenv("DM_SAVE_SYNC"); setenv("DM_SAVE", save.path.fileSystemRepresentation, 1);
+    atomic_store(&ticks, 1000000000); dm_play_time_start();
+    advance(17000000000); dm_play_time_committed(); assert(dm_play_time_flush(5000));
+    NSError *error = nil;
+    assert(DMGameTimeTotal(local, &error).unsignedLongLongValue == 17000 && !error);
+    assert(([DMGameTimeDailyTotals(local, &error) isEqual:@{@"2026-11-11": @10000, @"2026-11-12": @7000}]));
+    dm_play_time_pause(1); NSNumber *last = DMGameTimeSummary(local, &error)[@"lastActivityAt"];
+    advance(36000000000000); assert(dm_play_time_flush(5000));
+    assert([DMGameTimeSummary(local, &error)[@"lastActivityAt"] isEqual:last]);
+    assert(DMGameTimeTotal(local, &error).unsignedLongLongValue == 17000);
+    dm_play_time_pause(0); advance(200000000); dm_play_time_finish(); assert(dm_play_time_flush(5000));
+    assert(DMGameTimeTotal(local, &error).unsignedLongLongValue == 17200);
+    assert(![NSFileManager.defaultManager fileExistsAtPath:save.path]); // no game save mount is needed
+    dm_play_time_finish(); assert(dm_play_time_flush(5000));
+    assert(DMGameTimeTotal(local, &error).unsignedLongLongValue == 17200);
+    dm_play_time_pause(1); dm_play_time_start(); advance(1000000000000); assert(dm_play_time_flush(5000));
+    assert(DMGameTimeTotal(local, &error).unsignedLongLongValue == 17200);
+    dm_play_time_pause(0); advance(25000000); dm_play_time_finish(); assert(dm_play_time_flush(5000));
+    assert(DMGameTimeTotal(local, &error).unsignedLongLongValue == 17225);
+    // Fractional milliseconds carry across checkpoints instead of disappearing at every commit.
+    dm_play_time_start(); advance(1500000); dm_play_time_committed(); advance(1500000); dm_play_time_finish(); assert(dm_play_time_flush(5000));
+    assert(DMGameTimeTotal(local, &error).unsignedLongLongValue == 17228);
+    NSURL *cloudRoot = [root URLByAppendingPathComponent:@"cloud"];
+    setenv("DM_SAVE_SYNC", cloudRoot.path.fileSystemRepresentation, 1);
+    NSURL *cloud = DMGameTimeCloudURL(cloudRoot.path, @"0100000000000000");
+    dm_play_time_start(); advance(17000000000); dm_play_time_committed(); dm_play_time_sync();
+    assert(dm_play_time_flush(5000)); assert(DMGameTimeTotal(cloud, &error).unsignedLongLongValue == 17000);
+    dm_play_time_finish(); assert(dm_play_time_flush(5000));
+    unsetenv("DM_SAVE"); dm_play_time_start(); dm_play_time_finish();
+    assert([NSFileManager.defaultManager removeItemAtURL:root error:nil]);
+    puts("game time runtime: commit checkpoint/publication, midnight, paused last-activity, background startup, fresh IDs, remainder and finish passed");
+    return 0;
+} }
