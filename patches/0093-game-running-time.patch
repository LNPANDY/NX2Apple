@@ -0,0 +1,93 @@
+#import <Foundation/Foundation.h>
+#import "../apple/GameTime/Sources/GameTime/include/DMGameTime.h"
+#include "play_time.h"
+#include "hle_profile.h"
+#include <stdio.h>
+#include <stdlib.h>
+uint64_t now_ns(void);
+#include <pthread.h>
+
+static pthread_mutex_t g_time_mu = PTHREAD_MUTEX_INITIALIZER;
+static dm_play_clock g_time_clock;
+static int g_time_paused;
+static NSString *g_time_run;
+static NSURL *g_time_local, *g_time_cloud;
+static dispatch_queue_t g_time_local_queue;
+static dispatch_source_t g_time_timer;
+static NSOperationQueue *g_time_sync;
+
+static void time_error(NSError *error) {
+    if (error) fprintf(stderr, "[dm] play time: %s\n", error.localizedDescription.UTF8String);
+}
+// Caller holds g_time_mu. The queued writes capture their own run, never another game's mutable globals.
+static void checkpoint(uint64_t now) {
+    dm_play_clock_set(&g_time_clock, now, g_time_clock.running);
+    NSURL *local = g_time_local; NSString *run = g_time_run;
+    uint64_t ms = g_time_clock.elapsed / 1000000;
+    dispatch_async(g_time_local_queue, ^{
+        @autoreleasepool { NSError *error; DMGameTimeUpdateRun(local, run, ms, &error); time_error(error); }
+    });
+}
+static void request_sync(void) {
+    if (!g_time_cloud || g_time_sync.operationCount > 1) return;
+    NSURL *local = g_time_local, *cloud = g_time_cloud;
+    dispatch_queue_t writes = g_time_local_queue;
+    [g_time_sync addOperationWithBlock:^{
+        @autoreleasepool {
+            dispatch_sync(writes, ^{}); // Publish only after the lifecycle checkpoint reaches the durable local replica.
+            NSError *error; DMGameTimeSynchronize(local, cloud, &error); time_error(error);
+        }
+    }];
+}
+void dm_play_time_start(void) {
+    @autoreleasepool {
+        pthread_mutex_lock(&g_time_mu);
+        const char *save = getenv("DM_SAVE");
+        if (g_time_run || !save || !*save) { pthread_mutex_unlock(&g_time_mu); return; }
+        const char *cloud = getenv("DM_SAVE_SYNC");
+        g_time_cloud = DMGameTimeCloudURL(cloud ? @(cloud) : nil, @(dm_profile()->id));
+        g_time_local = DMGameTimeLocalURL([NSURL fileURLWithPath:@(save)], g_time_cloud, @(dm_profile()->id));
+        if (!g_time_local) { g_time_cloud = nil; pthread_mutex_unlock(&g_time_mu); return; }
+        g_time_run = NSUUID.UUID.UUIDString.lowercaseString;
+        g_time_clock = (dm_play_clock){.anchor = now_ns(), .running = !g_time_paused};
+        g_time_local_queue = dispatch_queue_create("game-time.local", dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_UTILITY, 0));
+        g_time_sync = [NSOperationQueue new]; g_time_sync.maxConcurrentOperationCount = 1; g_time_sync.qualityOfService = NSQualityOfServiceUtility;
+        g_time_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, g_time_local_queue);
+        dispatch_source_set_timer(g_time_timer, g_time_paused ? DISPATCH_TIME_FOREVER : dispatch_time(DISPATCH_TIME_NOW, 60 * NSEC_PER_SEC), 60 * NSEC_PER_SEC, 5 * NSEC_PER_SEC);
+        dispatch_source_set_event_handler(g_time_timer, ^{
+            pthread_mutex_lock(&g_time_mu);
+            if (g_time_run && g_time_clock.running) checkpoint(now_ns());
+            pthread_mutex_unlock(&g_time_mu);
+        });
+        dispatch_resume(g_time_timer);
+        request_sync();
+        pthread_mutex_unlock(&g_time_mu);
+        static int registered; if (!registered) { registered = 1; atexit(dm_play_time_finish); }
+    }
+}
+void dm_play_time_pause(int paused) {
+    pthread_mutex_lock(&g_time_mu);
+    g_time_paused = paused;
+    if (g_time_run) {
+        checkpoint(now_ns());
+        dm_play_clock_set(&g_time_clock, now_ns(), !paused);
+        dispatch_source_set_timer(g_time_timer, paused ? DISPATCH_TIME_FOREVER : dispatch_time(DISPATCH_TIME_NOW, 60 * NSEC_PER_SEC),
+                                  60 * NSEC_PER_SEC, 5 * NSEC_PER_SEC);
+        request_sync();
+    }
+    pthread_mutex_unlock(&g_time_mu);
+}
+void dm_play_time_finish(void) {
+    pthread_mutex_lock(&g_time_mu);
+    dispatch_queue_t writes = nil;
+    if (g_time_run) {
+        checkpoint(now_ns());
+        g_time_clock.running = 0;
+        dispatch_source_cancel(g_time_timer); g_time_timer = nil;
+        request_sync();
+        writes = g_time_local_queue;
+        g_time_run = nil; g_time_local = nil; g_time_cloud = nil; g_time_sync = nil; g_time_local_queue = nil;
+    }
+    pthread_mutex_unlock(&g_time_mu);
+    if (writes) dispatch_sync(writes, ^{}); // A clean exit waits for local persistence, never for cloud receipt.
+}
