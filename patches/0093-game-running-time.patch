index 0000000..694ad38
--- /dev/null
+++ b/dm/apple/GameTime/Sources/GameTimeLibrary/GameTimeLibrary.swift
@@ -0,0 +1,156 @@
+import Foundation
+import GameTime
+
+public struct GameTimeStats: Codable, Equatable, Sendable {
+    public var totalMilliseconds: UInt64
+    public var lastActivityAt: Date?
+    public var dated: Bool
+    public init(totalMilliseconds: UInt64, lastActivityAt: Date? = nil, dated: Bool = false) {
+        self.totalMilliseconds = totalMilliseconds; self.lastActivityAt = lastActivityAt; self.dated = dated
+    }
+    fileprivate init?(_ value: NSDictionary) {
+        guard let total = value["totalMs"] as? NSNumber else { return nil }
+        totalMilliseconds = total.uint64Value
+        lastActivityAt = (value["lastActivityAt"] as? NSNumber).map { Date(timeIntervalSince1970: $0.doubleValue / 1000) }
+        dated = (value["dated"] as? NSNumber)?.boolValue ?? false
+    }
+}
+
+/// Rebuildable launcher summaries. History, including removed games, stays in the per-game documents.
+public actor GameTimeLibrary {
+    private struct Signature: Codable, Equatable, Sendable {
+        let size: UInt64
+        let modified: Double
+        let inode: UInt64
+        init?(_ value: NSDictionary?) {
+            guard let value, let size = value["size"] as? NSNumber, let modified = value["modified"] as? NSNumber,
+                  let inode = value["inode"] as? NSNumber else { return nil }
+            self.size = size.uint64Value; self.modified = modified.doubleValue; self.inode = inode.uint64Value
+        }
+        static func read(_ url: URL?) -> Self? {
+            guard let url, let a = try? FileManager.default.attributesOfItem(atPath: url.path) else { return nil }
+            return Signature(["size": a[.size] ?? 0, "modified": (a[.modificationDate] as? Date)?.timeIntervalSince1970 ?? 0,
+                              "inode": a[.systemFileNumber] ?? 0] as NSDictionary)
+        }
+    }
+    private struct Entry: Codable, Equatable, Sendable {
+        var stats: GameTimeStats
+        var source: Signature?
+        var cloudSource: Signature?
+        var synchronized: Bool
+    }
+    private struct Index: Codable, Sendable {
+        var version = 1
+        var games: [String: Entry]
+    }
+    private let indexURL: URL
+    private var entries: [String: Entry] = [:]
+    private var loadTask: Task<[String: Entry], Never>?
+    private var loaded = false
+    private struct Flight { let id: UUID; let task: Task<Entry?, Never> }
+    private var work: [String: Flight] = [:]
+    private var writeTask: Task<Void, Never>?
+    private var revision = 0
+
+    public init(indexURL: URL) { self.indexURL = indexURL }
+    private func load() async {
+        guard !loaded else { return }
+        if loadTask == nil {
+            let url = indexURL
+            loadTask = Task.detached(priority: .utility) {
+                guard let data = try? Data(contentsOf: url), data.count <= 32 * 1024 * 1024,
+                      let file = try? JSONDecoder().decode(Index.self, from: data), file.version == 1 else { return [:] }
+                return file.games
+            }
+        }
+        let value = await loadTask!.value
+        if !loaded { entries = value; loaded = true; loadTask = nil }
+    }
+    private static func locations(save: URL, cloudFolder: String?, titleID: String) -> (URL, URL?)? {
+        let cloud = DMGameTimeCloudURL(cloudFolder, titleID)
+        guard let local = DMGameTimeLocalURL(save, cloud, titleID) else { return nil }
+        return (local, cloud)
+    }
+    public func cached(save: URL, cloudFolder: String?, titleID: String) async -> GameTimeStats? {
+        await load()
+        guard let (local, _) = Self.locations(save: save, cloudFolder: cloudFolder, titleID: titleID) else { return nil }
+        return entries[local.path]?.stats
+    }
+    public func refresh(save: URL, cloudFolder: String?, titleID: String, synchronize: Bool = true) async -> GameTimeStats? {
+        await load()
+        guard let (local, cloud) = Self.locations(save: save, cloudFolder: cloudFolder, titleID: titleID) else { return nil }
+        let key = local.path
+        if let pending = work[key] {
+            let value = await pending.task.value
+            complete(pending.id, key: key, value: value)
+            if !synchronize || cloud == nil || value?.synchronized == true { return value?.stats }
+        }
+        let old = entries[key]
+        let task = Task.detached(priority: .utility) { () -> Entry? in
+            let source = Signature.read(local), remote = synchronize ? Signature.read(cloud) : nil
+            let placeholder = cloud.map { $0.deletingLastPathComponent().appendingPathComponent(".\($0.lastPathComponent).icloud") }
+            let downloading = placeholder.map { FileManager.default.fileExists(atPath: $0.path) } ?? false
+            let conflicts = (synchronize ? cloud : nil).map { !(NSFileVersion.unresolvedConflictVersionsOfItem(at: $0) ?? []).isEmpty } ?? false
+            if let old, old.source == source, !synchronize || cloud == nil || (old.synchronized && old.cloudSource == remote && !downloading && !conflicts) { return old }
+            // Missing source history is retained in the index for removal/re-add; it is never added as a new run.
+            if source == nil && (cloud == nil || remote == nil && !downloading) { return old }
+            var failure: NSError?
+            var value: NSDictionary?
+            var synced = cloud == nil || !synchronize
+            if synchronize, cloud != nil {
+                for delay in [0.0, 0.25, 0.75, 1.5] {
+                    if delay > 0 { try? await Task.sleep(nanoseconds: UInt64(delay * 1_000_000_000)) }
+                    failure = nil; value = DMGameTimeSynchronizeSummary(local, cloud, &failure) as NSDictionary?
+                    if value != nil { synced = true; break }
+                    guard downloading else { break }
+                }
+            }
+            if value == nil { value = DMGameTimeSummary(local, nil) as NSDictionary? }
+            guard let value, let stats = GameTimeStats(value) else { return old }
+            let signature = Signature(value["source"] as? NSDictionary)
+            if signature == nil { return old }
+            if let failure { NSLog("Play time: %@", failure.localizedDescription) }
+            return Entry(stats: stats, source: signature,
+                         cloudSource: synced ? Signature(value["cloudSource"] as? NSDictionary) ?? remote : old?.cloudSource,
+                         synchronized: Self.synchronizedCloud(cloud, requested: synchronize, succeeded: synced))
+        }
+        let id = UUID()
+        work[key] = Flight(id: id, task: task)
+        let result = await task.value
+        complete(id, key: key, value: result)
+        return result?.stats
+    }
+    private func complete(_ id: UUID, key: String, value: Entry?) {
+        guard work[key]?.id == id else { return }
+        work[key] = nil
+        if let value, value != entries[key] { entries[key] = value; revision += 1; scheduleWrite() }
+    }
+    private static func synchronizedCloud(_ cloud: URL?, requested: Bool, succeeded: Bool) -> Bool { cloud == nil || requested && succeeded }
+    private func scheduleWrite() {
+        guard writeTask == nil else { return }
+        writeTask = Task { [weak self] in
+            try? await Task.sleep(nanoseconds: 200_000_000)
+            await self?.persist()
+        }
+    }
+    private func persist() async {
+        let snapshot = entries, url = indexURL, savedRevision = revision
+        await Task.detached(priority: .utility) {
+            guard !snapshot.isEmpty else { return }
+            do {
+                try FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+                var error: NSError?
+                NSFileCoordinator(filePresenter: nil).coordinate(writingItemAt: url, options: .forMerging, error: &error) { target in
+                    var games = ((try? Data(contentsOf: target)).flatMap { try? JSONDecoder().decode(Index.self, from: $0) })?.games ?? [:]
+                    games.merge(snapshot) { _, new in new }
+                    do { try JSONEncoder().encode(Index(games: games)).write(to: target, options: .atomic) }
+                    catch { NSLog("Play time cache: %@", error.localizedDescription) }
+                }
+                if let error { NSLog("Play time cache: %@", error.localizedDescription) }
+            } catch { NSLog("Play time cache: %@", error.localizedDescription) }
+        }.value
+        writeTask = nil
+        if savedRevision != revision { scheduleWrite() }
+    }
+    public func flush() async { while let pending = writeTask { await pending.value } }
+}
