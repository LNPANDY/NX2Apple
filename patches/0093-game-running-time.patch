+// Blocking provider work: call off the UI/game thread. A summary reuses the coordinated merge, without rereading the file.
+// Cancelling stops pending coordination; an entered transaction finishes or rolls back safely.
+NSProgress *DMGameTimeSyncProgress(void);
+NSDictionary * _Nullable DMGameTimeSynchronizeSummaryWithProgress(NSURL *localURL, NSURL * _Nullable cloudURL, NSProgress *progress, NSError **error);
