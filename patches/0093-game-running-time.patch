diff --git a/dm/apple/GameTime/Sources/GameTime/DMGameTime.m b/dm/apple/GameTime/Sources/GameTime/DMGameTime.m
new file mode 100644
index 0000000000000000000000000000000000000000..f64a92a344bbb1298226b03f5330dc32b29dee7f
--- /dev/null
+++ b/dm/apple/GameTime/Sources/GameTime/DMGameTime.m
@@ -0,0 +1,430 @@
+#import "DMGameTime.h"
+#import <CommonCrypto/CommonDigest.h>
+#import <TargetConditionals.h>
+#import <math.h>
+#import <sqlite3.h>
+#import <errno.h>
+
+static const NSUInteger MaxBytes = 32 * 1024 * 1024;
+static NSError *invalid(NSString *why) {
+    return [NSError errorWithDomain:@"GameTime" code:1 userInfo:@{NSLocalizedDescriptionKey: why}];
+}
+
+NSURL *DMGameTimeCloudURL(NSString *folder, NSString *titleID) {
+    if (!folder.length || [folder isEqual:@"0"]) return nil;
+    NSCharacterSet *hex = [NSCharacterSet characterSetWithCharactersInString:@"0123456789ABCDEF"];
+    NSString *title = titleID.uppercaseString;
+    if (title.length != 16 || [title rangeOfCharacterFromSet:hex.invertedSet].location != NSNotFound) return nil;
+    if ([folder isEqual:@"icloud"]) {
+#if TARGET_OS_OSX
+        folder = [NSHomeDirectory() stringByAppendingPathComponent:@"Library/Mobile Documents/com~apple~CloudDocs/nxnative Saves"];
+        if (![NSFileManager.defaultManager fileExistsAtPath:folder.stringByDeletingLastPathComponent]) return nil;
+#else
+        return nil;
+#endif
+    }
+    NSURL *url = [NSURL fileURLWithPath:folder isDirectory:YES];
+    if (![url.lastPathComponent.uppercaseString isEqual:title]) url = [url URLByAppendingPathComponent:title isDirectory:YES];
+    return [url URLByAppendingPathComponent:@"playtime.json"];
+}
+NSURL *DMGameTimeLocalURL(NSURL *saveURL, NSURL *cloudURL, NSString *titleID) {
+    NSCharacterSet *hex = [NSCharacterSet characterSetWithCharactersInString:@"0123456789ABCDEF"];
+    if (titleID.length != 16 || [titleID.uppercaseString rangeOfCharacterFromSet:hex.invertedSet].location != NSNotFound) return nil;
+    // A different chosen cloud destination must not inherit another destination's downloaded history.
+    NSString *scope = @"local";
+    if (cloudURL) {
+        // Standardize the existing ancestor: Foundation otherwise changes /private paths once a missing file appears.
+        NSURL *ancestor = cloudURL; NSMutableArray<NSString *> *missing = [NSMutableArray array];
+        while (![NSFileManager.defaultManager fileExistsAtPath:ancestor.path] && ancestor.path.length > 1) {
+            [missing addObject:ancestor.lastPathComponent]; ancestor = ancestor.URLByDeletingLastPathComponent;
+        }
+        NSString *stable = ancestor.URLByStandardizingPath.path;
+        for (NSString *component in missing.reverseObjectEnumerator) stable = [stable stringByAppendingPathComponent:component];
+        NSData *path = [stable dataUsingEncoding:NSUTF8StringEncoding];
+        unsigned char digest[CC_SHA256_DIGEST_LENGTH]; CC_SHA256(path.bytes, (CC_LONG)path.length, digest);
+        NSMutableString *hex = [NSMutableString string];
+        for (NSUInteger i = 0; i < sizeof digest; i++) [hex appendFormat:@"%02x", digest[i]];
+        scope = hex;
+    }
+    NSURL *dir = [saveURL.URLByDeletingLastPathComponent URLByAppendingPathComponent:@"playtime" isDirectory:YES];
+    dir = [dir URLByAppendingPathComponent:titleID.uppercaseString isDirectory:YES];
+    return [dir URLByAppendingPathComponent:[scope stringByAppendingString:@".sqlite"]];
+}
+static BOOL integer(id n) {
+    if (![n isKindOfClass:NSNumber.class] || CFGetTypeID((__bridge CFTypeRef)n) == CFBooleanGetTypeID()) return NO;
+    double d = [n doubleValue]; return isfinite(d) && d >= 0 && d <= 9007199254740991.0 && floor(d) == d;
+}
+static NSString *dayKey(NSDate *date, NSCalendar *calendar) {
+    NSDateComponents *c = [calendar components:NSCalendarUnitYear | NSCalendarUnitMonth | NSCalendarUnitDay fromDate:date];
+    return [NSString stringWithFormat:@"%04ld-%02ld-%02ld", (long)c.year, (long)c.month, (long)c.day];
+}
+static BOOL validDay(NSString *day) {
+    if (![day isKindOfClass:NSString.class] || day.length != 10 || [day characterAtIndex:4] != '-' || [day characterAtIndex:7] != '-') return NO;
+    NSString *digits = [day stringByReplacingOccurrencesOfString:@"-" withString:@""];
+    if (digits.length != 8 || [digits rangeOfCharacterFromSet:[NSCharacterSet characterSetWithCharactersInString:@"0123456789"].invertedSet].location != NSNotFound) return NO;
+    NSCalendar *cal = [[NSCalendar alloc] initWithCalendarIdentifier:NSCalendarIdentifierGregorian]; cal.timeZone = [NSTimeZone timeZoneForSecondsFromGMT:0];
+    NSDateComponents *c = [NSDateComponents new]; c.year = [[day substringToIndex:4] integerValue]; c.month = [[day substringWithRange:NSMakeRange(5, 2)] integerValue]; c.day = [[day substringFromIndex:8] integerValue];
+    NSDate *date = [cal dateFromComponents:c]; return c.year > 0 && date && [dayKey(date, cal) isEqual:day];
+}
+static NSMutableDictionary *normalizedRuns(id value, NSError **error) {
+    if (![value isKindOfClass:NSDictionary.class]) { if (error) *error = invalid(@"Invalid play time records."); return nil; }
+    NSMutableDictionary *out = [NSMutableDictionary dictionary];
+    for (NSString *key in value) {
+        NSUUID *uuid = [[NSUUID alloc] initWithUUIDString:key]; id n = value[key];
+        if (!uuid || !integer(n)) { if (error) *error = invalid(@"Invalid play time entry."); return nil; }
+        NSString *canonical = uuid.UUIDString.lowercaseString;
+        out[canonical] = @(MAX([out[canonical] unsignedLongLongValue], [n unsignedLongLongValue]));
+    }
+    return out;
+}
+static void joinRuns(NSMutableDictionary *into, NSDictionary *other) {
+    for (NSString *key in other) into[key] = @(MAX([into[key] unsignedLongLongValue], [other[key] unsignedLongLongValue]));
+}
+static NSDictionary *summary(NSDictionary *doc, NSError **error) {
+    uint64_t total = 0;
+    NSMutableArray *groups = [NSMutableArray arrayWithObject:doc[@"runs"] ?: @{}];
+    [groups addObjectsFromArray:[doc[@"days"] allValues]];
+    for (NSDictionary *runs in groups) for (NSNumber *n in runs.allValues) {
+        uint64_t v = n.unsignedLongLongValue;
+        if (UINT64_MAX - total < v) { if (error) *error = invalid(@"Play time total overflow."); return nil; }
+        total += v;
+    }
+    NSMutableDictionary *out = [@{@"totalMs": @(total), @"dated": @([doc[@"version"] intValue] == 2)} mutableCopy];
+    if ([doc[@"lastActivityAt"] unsignedLongLongValue]) out[@"lastActivityAt"] = doc[@"lastActivityAt"];
+    return out;
+}
+static NSMutableDictionary *readDoc(NSURL *url, BOOL allowMissing, NSError **error) {
+    NSFileManager *fm = NSFileManager.defaultManager;
+    NSString *placeholder = [url.URLByDeletingLastPathComponent.path stringByAppendingPathComponent:[NSString stringWithFormat:@".%@.icloud", url.lastPathComponent]];
+    if ([fm fileExistsAtPath:placeholder] && ![fm fileExistsAtPath:url.path]) { if (error) *error = invalid(@"Play time is still downloading."); return nil; }
+    NSError *e = nil; NSDictionary *a = [fm attributesOfItemAtPath:url.path error:&e];
+    if (!a) {
+        if (allowMissing && [e.domain isEqual:NSCocoaErrorDomain] && (e.code == NSFileReadNoSuchFileError || e.code == NSFileNoSuchFileError)) return [@{@"version": @1, @"runs": [NSMutableDictionary dictionary]} mutableCopy];
+        if (error) *error = e; return nil;
+    }
+    if ([a[NSFileSize] unsignedLongLongValue] > MaxBytes) { if (error) *error = invalid(@"Play time document exceeds 32 MiB."); return nil; }
+    NSData *data = [NSData dataWithContentsOfURL:url options:0 error:error];
+    if (!data) return nil;
+    if (data.length > MaxBytes) { if (error) *error = invalid(@"Play time document exceeds 32 MiB."); return nil; }
+    id raw = [NSJSONSerialization JSONObjectWithData:data options:0 error:error];
+    if (!raw) return nil;
+    if (![raw isKindOfClass:NSDictionary.class] || !integer(raw[@"version"]) || (![raw[@"version"] isEqual:@1] && ![raw[@"version"] isEqual:@2])) { if (error) *error = invalid(@"Unsupported play time document."); return nil; }
+    BOOL dated = [raw[@"version"] intValue] == 2;
+    if ((!dated && (raw[@"days"] || raw[@"lastActivityAt"])) || (dated && ![raw[@"days"] isKindOfClass:NSDictionary.class])) { if (error) *error = invalid(@"Unsupported play time document."); return nil; }
+    NSMutableDictionary *runs = normalizedRuns(raw[@"runs"] ?: (dated ? @{} : nil), error); if (!runs) return nil;
+    NSMutableDictionary *out = [@{@"version": raw[@"version"], @"runs": runs} mutableCopy];
+    if (dated) {
+        NSMutableDictionary *days = [NSMutableDictionary dictionary];
+        for (NSString *day in raw[@"days"]) {
+            if (!validDay(day)) { if (error) *error = invalid(@"Invalid play time date."); return nil; }
+            NSMutableDictionary *entries = normalizedRuns(raw[@"days"][day], error); if (!entries) return nil;
+            days[day] = entries;
+        }
+        out[@"days"] = days;
+        if (raw[@"lastActivityAt"]) {
+            if (!integer(raw[@"lastActivityAt"])) { if (error) *error = invalid(@"Invalid last-played time."); return nil; }
+            out[@"lastActivityAt"] = raw[@"lastActivityAt"];
+        }
+    }
+    return summary(out, error) ? out : nil;
+}
+static BOOL writeDoc(NSDictionary *doc, NSURL *url, NSError **error) {
+    if (!summary(doc, error)) return NO;
+    NSMutableDictionary *stored = doc.mutableCopy;
+    if ([stored[@"version"] intValue] == 2 && ![stored[@"runs"] count]) [stored removeObjectForKey:@"runs"];
+    NSData *data = [NSJSONSerialization dataWithJSONObject:stored options:NSJSONWritingSortedKeys error:error];
+    if (!data) return NO;
+    if (data.length > MaxBytes) { if (error) *error = invalid(@"Play time document exceeds 32 MiB."); return NO; }
+    return [data writeToURL:url options:NSDataWritingAtomic error:error];
+}
+static NSDictionary *sourceSignature(NSURL *url) {
+    NSDictionary *a = [NSFileManager.defaultManager attributesOfItemAtPath:url.path error:nil];
+    return a ? @{@"size": a[NSFileSize], @"modified": @([a[NSFileModificationDate] timeIntervalSince1970]), @"inode": a[NSFileSystemFileNumber]} : nil;
+}
+static BOOL cancelled(NSProgress *progress, NSError **error) {
+    if (!progress.cancelled) return NO;
+    if (error) *error = [NSError errorWithDomain:NSCocoaErrorDomain code:NSUserCancelledError userInfo:nil];
+    return YES;
+}
+NSProgress *DMGameTimeSyncProgress(void) {
+    NSProgress *progress = [NSProgress discreteProgressWithTotalUnitCount:1];
+    NSFileCoordinator *cloud = [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+    NSFileCoordinator *local = [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+    [progress setUserInfoObject:cloud forKey:@"GameTimeCloudCoordinator"];
+    [progress setUserInfoObject:local forKey:@"GameTimeLocalCoordinator"];
+    progress.cancellationHandler = ^{ [cloud cancel]; [local cancel]; };
+    return progress;
+}
+static BOOL sql(sqlite3 *db, const char *command, NSError **error) {
+    int rc = sqlite3_exec(db, command, NULL, NULL, NULL);
+    if (rc == SQLITE_OK) return YES;
+    if (error) *error = invalid([NSString stringWithFormat:@"Play time database: %s", sqlite3_errmsg(db)]);
+    return NO;
+}
+static sqlite3_stmt *statement(sqlite3 *db, const char *command, NSError **error) {
+    sqlite3_stmt *s = NULL;
+    if (sqlite3_prepare_v2(db, command, -1, &s, NULL) == SQLITE_OK) return s;
+    if (error) *error = invalid([NSString stringWithFormat:@"Play time database: %s", sqlite3_errmsg(db)]);
+    return NULL;
+}
+static BOOL stepDone(sqlite3_stmt *s, NSError **error) {
+    int rc = sqlite3_step(s);
+    if (rc == SQLITE_DONE) return YES;
+    if (error) *error = invalid([NSString stringWithFormat:@"Play time database: %s", sqlite3_errmsg(sqlite3_db_handle(s))]);
+    return NO;
+}
+static int pragmaValue(sqlite3 *db, const char *command) {
+    sqlite3_stmt *s = NULL; int value = -1;
+    if (sqlite3_prepare_v2(db, command, -1, &s, NULL) == SQLITE_OK && sqlite3_step(s) == SQLITE_ROW) value = sqlite3_column_int(s, 0);
+    sqlite3_finalize(s); return value;
+}
+static int databaseBusy(void *context, int count) {
+    NSProgress *progress = (__bridge NSProgress *)context;
+    if (progress.cancelled || count >= 100) return 0;
+    sqlite3_sleep(10); return !progress.cancelled;
+}
+static BOOL openDatabase(NSURL *url, sqlite3 **out, NSProgress *progress, NSError **error) {
+    if (cancelled(progress, error)) return NO;
+    NSDictionary *attributes = [NSFileManager.defaultManager attributesOfItemAtPath:url.path error:nil];
+    if ([attributes[NSFileSize] unsignedLongLongValue] > 128ULL * 1024 * 1024) { if (error) *error = invalid(@"Play time database exceeds 128 MiB."); return NO; }
+    sqlite3 *db = NULL;
+    if (sqlite3_open_v2(url.fileSystemRepresentation, &db, SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE | SQLITE_OPEN_FULLMUTEX, NULL) != SQLITE_OK) {
+        if (error) *error = invalid(@"Could not open the play time database."); sqlite3_close(db); return NO;
+    }
+    sqlite3_busy_handler(db, databaseBusy, (__bridge void *)progress);
+    sqlite3_limit(db, SQLITE_LIMIT_LENGTH, (int)MaxBytes);
+    int version = pragmaValue(db, "PRAGMA user_version"), app = pragmaValue(db, "PRAGMA application_id");
+    if (version == 0 && app == 0 && pragmaValue(db, "SELECT count(*) FROM sqlite_master") == 0) {
+        if (!sql(db, "PRAGMA journal_mode=DELETE; PRAGMA synchronous=FULL; BEGIN IMMEDIATE;"
+                     "CREATE TABLE segments(day TEXT NOT NULL,id TEXT NOT NULL,ms INTEGER NOT NULL CHECK(ms BETWEEN 0 AND 9007199254740991),PRIMARY KEY(day,id)) WITHOUT ROWID;"
+                     "CREATE TABLE stats(id INTEGER PRIMARY KEY CHECK(id=1),total TEXT NOT NULL,dated INTEGER NOT NULL,last INTEGER NOT NULL);"
+                     "INSERT INTO stats VALUES(1,'0',0,0); PRAGMA application_id=1145915220; PRAGMA user_version=1; COMMIT;", error)) { sqlite3_exec(db, "ROLLBACK", NULL, NULL, NULL); sqlite3_close(db); return NO; }
+    } else if (version != 1 || app != 1145915220) {
+        if (error) *error = invalid(@"Unsupported play time database."); sqlite3_close(db); return NO;
+    }
+    // A local transaction may need a recovery journal; neither it nor a live database is synced as a cloud document.
+    sqlite3_stmt *mode = statement(db, "PRAGMA journal_mode", error);
+    BOOL rollback = mode && sqlite3_step(mode) == SQLITE_ROW && !strcmp((const char *)sqlite3_column_text(mode, 0), "delete");
+    sqlite3_finalize(mode);
+    if (pragmaValue(db, "PRAGMA page_size") != 4096) rollback = NO;
+    if (!rollback || !sql(db, "PRAGMA synchronous=FULL; PRAGMA trusted_schema=OFF; PRAGMA max_page_count=32768; BEGIN IMMEDIATE", error)) {
+        if (!rollback && error) *error = invalid(@"Unsupported play time journal mode."); cancelled(progress, error); sqlite3_close(db); return NO;
+    }
+    *out = db; return YES;
+}
+static NSMutableDictionary *databaseStats(sqlite3 *db, NSError **error) {
+    sqlite3_stmt *s = statement(db, "SELECT total,dated,last FROM stats WHERE id=1", error);
+    NSMutableDictionary *out = nil;
+    if (s && sqlite3_step(s) == SQLITE_ROW) {
+        const char *text = (const char *)sqlite3_column_text(s, 0); char *end = NULL; errno = 0;
+        uint64_t total = text ? strtoull(text, &end, 10) : 0;
+        int dated = sqlite3_column_int(s, 1); sqlite3_int64 last = sqlite3_column_int64(s, 2);
+        if (text && *text >= '0' && *text <= '9' && end && !*end && !errno && (dated == 0 || dated == 1) && last >= 0 && last <= 9007199254740991LL) {
+            out = [@{@"totalMs": @(total), @"dated": @(dated)} mutableCopy]; if (last) out[@"lastActivityAt"] = @(last);
+        }
+    }
+    sqlite3_finalize(s);
+    if (!out && error) *error = invalid(@"Invalid play time database summary.");
+    return out;
+}
+static BOOL applyDocument(sqlite3 *db, NSDictionary *doc, NSProgress *progress, NSError **error) {
+    if (!doc) return YES;
+    NSMutableDictionary *stats = databaseStats(db, error); if (!stats) return NO;
+    uint64_t total = [stats[@"totalMs"] unsignedLongLongValue], original = total;
+    sqlite3_stmt *get = statement(db, "SELECT ms FROM segments WHERE day=? AND id=?", error);
+    sqlite3_stmt *put = statement(db, "INSERT INTO segments VALUES(?,?,?) ON CONFLICT(day,id) DO UPDATE SET ms=excluded.ms WHERE excluded.ms>segments.ms", error);
+    if (!get || !put) { sqlite3_finalize(get); sqlite3_finalize(put); return NO; }
+    NSMutableDictionary *groups = [doc[@"days"] mutableCopy] ?: [NSMutableDictionary dictionary]; groups[@""] = doc[@"runs"] ?: @{};
+    BOOL ok = YES;
+    for (NSString *day in groups) {
+        for (NSString *identifier in groups[day]) {
+            if (cancelled(progress, error)) { ok = NO; break; }
+            uint64_t value = [groups[day][identifier] unsignedLongLongValue];
+            sqlite3_reset(get); sqlite3_bind_text(get, 1, day.UTF8String, -1, SQLITE_TRANSIENT); sqlite3_bind_text(get, 2, identifier.UTF8String, -1, SQLITE_TRANSIENT);
+            int rc = sqlite3_step(get); uint64_t old = rc == SQLITE_ROW ? (uint64_t)sqlite3_column_int64(get, 0) : 0;
+            if (rc != SQLITE_ROW && rc != SQLITE_DONE) { if (error) *error = invalid(@"Could not read a play time segment."); ok = NO; break; }
+            if (rc == SQLITE_ROW && value <= old) continue;
+            if (UINT64_MAX - total < value - old) { if (error) *error = invalid(@"Play time total overflow."); ok = NO; break; }
+            total += value - old;
+            sqlite3_reset(put); sqlite3_bind_text(put, 1, day.UTF8String, -1, SQLITE_TRANSIENT); sqlite3_bind_text(put, 2, identifier.UTF8String, -1, SQLITE_TRANSIENT); sqlite3_bind_int64(put, 3, (sqlite3_int64)value);
+            if (!stepDone(put, error)) { ok = NO; break; }
+        }
+        if (!ok) break;
+    }
+    sqlite3_finalize(get); sqlite3_finalize(put); if (!ok) return NO;
+    BOOL dated = [stats[@"dated"] boolValue] || [doc[@"version"] intValue] == 2;
+    uint64_t last = MAX([stats[@"lastActivityAt"] unsignedLongLongValue], [doc[@"lastActivityAt"] unsignedLongLongValue]);
+    if (total == original && dated == [stats[@"dated"] boolValue] && last == [stats[@"lastActivityAt"] unsignedLongLongValue]) return YES;
+    sqlite3_stmt *putStats = statement(db, "UPDATE stats SET total=?,dated=?,last=? WHERE id=1", error); if (!putStats) return NO;
+    NSString *text = [NSString stringWithFormat:@"%llu", (unsigned long long)total];
+    sqlite3_bind_text(putStats, 1, text.UTF8String, -1, SQLITE_TRANSIENT); sqlite3_bind_int(putStats, 2, dated); sqlite3_bind_int64(putStats, 3, (sqlite3_int64)last);
+    ok = stepDone(putStats, error); sqlite3_finalize(putStats); return ok;
+}
+static NSMutableDictionary *databaseDocument(sqlite3 *db, NSDictionary *stats, NSError **error) {
+    NSMutableDictionary *doc = [@{@"version": [stats[@"dated"] boolValue] ? @2 : @1, @"runs": [NSMutableDictionary dictionary], @"days": [NSMutableDictionary dictionary]} mutableCopy];
+    if (stats[@"lastActivityAt"]) doc[@"lastActivityAt"] = stats[@"lastActivityAt"];
+    if (![stats[@"dated"] boolValue]) [doc removeObjectForKey:@"days"];
+    NSMutableDictionary *empty = [doc mutableCopy]; if ([stats[@"dated"] boolValue]) [empty removeObjectForKey:@"runs"];
+    NSUInteger bytes = [NSJSONSerialization dataWithJSONObject:empty options:NSJSONWritingSortedKeys error:error].length;
+    sqlite3_stmt *s = statement(db, "SELECT day,id,ms FROM segments", error); if (!s) return nil;
+    int rc;
+    while ((rc = sqlite3_step(s)) == SQLITE_ROW) {
+        const char *dayText = (const char *)sqlite3_column_text(s, 0), *idText = (const char *)sqlite3_column_text(s, 1);
+        NSString *day = dayText ? @(dayText) : nil, *identifier = idText ? @(idText) : nil; sqlite3_int64 ms = sqlite3_column_int64(s, 2);
+        if (!day || !identifier || ms < 0 || ms > 9007199254740991LL || (day.length && !validDay(day)) || ![[NSUUID alloc] initWithUUIDString:identifier]) { rc = SQLITE_CORRUPT; break; }
+        NSMutableDictionary *runs = doc[@"runs"];
+        if (day.length) {
+            runs = doc[@"days"][day];
+            if (!runs) { bytes += 15 + ([doc[@"days"] count] ? 1 : 0); runs = [NSMutableDictionary dictionary]; doc[@"days"][day] = runs; }
+        } else if (!runs.count && [stats[@"dated"] boolValue]) bytes += 10;
+        bytes += 39 + [[NSString stringWithFormat:@"%lld", ms] length] + (runs.count ? 1 : 0);
+        if (bytes > MaxBytes) { rc = SQLITE_TOOBIG; break; }
+        runs[identifier] = @(ms);
+    }
+    sqlite3_finalize(s);
+    if (rc != SQLITE_DONE) { if (error) *error = invalid(rc == SQLITE_TOOBIG ? @"Play time document exceeds 32 MiB." : @"Invalid play time database records."); return nil; }
+    if (![stats[@"dated"] boolValue]) [doc removeObjectForKey:@"days"];
+    NSDictionary *actual = summary(doc, error);
+    if (!actual || ![actual isEqual:stats]) { if (error) *error = invalid(@"Play time database summary does not match its records."); return nil; }
+    return doc;
+}
+static NSDictionary *localOperation(NSURL *local, NSDictionary *incoming, BOOL document, NSProgress *progress, NSError **error) {
+    if (![local.pathExtension isEqual:@"sqlite"]) { if (error) *error = invalid(@"Expected a local play time database."); return nil; }
+    NSFileManager *fm = NSFileManager.defaultManager;
+    NSURL *legacy = [[local URLByDeletingPathExtension] URLByAppendingPathExtension:@"json"];
+    if (!incoming && ![fm fileExistsAtPath:local.path] && ![fm fileExistsAtPath:legacy.path]) return @{@"totalMs": @0, @"dated": @NO};
+    if (![fm createDirectoryAtURL:local.URLByDeletingLastPathComponent withIntermediateDirectories:YES attributes:nil error:error]) return nil;
+    __block NSDictionary *out = nil; __block NSError *failure = nil; NSError *coordination = nil;
+    NSFileCoordinator *coordinator = progress.userInfo[@"GameTimeLocalCoordinator"] ?: [[NSFileCoordinator alloc] initWithFilePresenter:nil];
+    [coordinator coordinateWritingItemAtURL:local options:NSFileCoordinatorWritingForMerging writingItemAtURL:legacy options:NSFileCoordinatorWritingForMerging error:&coordination byAccessor:^(NSURL *url, NSURL *old) {
+        if (cancelled(progress, &failure)) return;
+        BOOL exists = [fm fileExistsAtPath:old.path]; NSDictionary *import = exists ? readDoc(old, NO, &failure) : nil;
+        if (exists && !import) return;
+        if (!incoming && !import && ![fm fileExistsAtPath:url.path]) { out = @{@"totalMs": @0, @"dated": @NO}; return; }
+        sqlite3 *db = NULL; if (!openDatabase(url, &db, progress, &failure)) return;
+        BOOL ok = !cancelled(progress, &failure) && applyDocument(db, import, progress, &failure) && applyDocument(db, incoming, progress, &failure);
+        NSMutableDictionary *stats = ok ? databaseStats(db, &failure) : nil;
+        NSDictionary *doc = stats && (document || import) ? databaseDocument(db, stats, &failure) : nil;
+        if ((document || import) && !doc) ok = NO;
+        if (ok) ok = sql(db, "COMMIT", &failure); else sqlite3_exec(db, "ROLLBACK", NULL, NULL, NULL);
+        if (sqlite3_close(db) != SQLITE_OK) { ok = NO; failure = invalid(@"Could not close the play time database."); }
+        if (!ok) return;
+        if (import && !cancelled(progress, &failure) && ![fm removeItemAtURL:old error:&failure]) return;
+        if (cancelled(progress, &failure)) return;
+        NSMutableDictionary *result = [(document ? doc : stats) mutableCopy]; result[@"source"] = sourceSignature(url); out = result;
+    }];
+    if (!out && error) *error = coordination ?: failure ?: invalid(@"Could not read play time.");
+    return out;
+}
+BOOL DMGameTimeUpdateRun(NSURL *local, NSString *runID, uint64_t ms, NSError **error) {
+    NSUUID *uuid = [[NSUUID alloc] initWithUUIDString:runID];
+    if (!uuid || ms > 9007199254740991ULL) { if (error) *error = invalid(@"Invalid play time entry."); return NO; }
+    return localOperation(local, @{@"version": @1, @"runs": @{uuid.UUIDString.lowercaseString: @(ms)}}, NO, nil, error) != nil;
+}
+BOOL DMGameTimeUpdateSegments(NSURL *local, NSArray<NSDictionary *> *segments, uint64_t last, NSError **error) {
+    if (last > 9007199254740991ULL) { if (error) *error = invalid(@"Invalid last-played time."); return NO; }
+    NSMutableDictionary *days = [NSMutableDictionary dictionary];
+    for (NSDictionary *segment in segments) {
+        NSString *day = segment[@"day"]; NSUUID *uuid = [[NSUUID alloc] initWithUUIDString:segment[@"id"]]; id ms = segment[@"milliseconds"];
+        if (!validDay(day) || !uuid || !integer(ms)) { if (error) *error = invalid(@"Invalid play time segment."); return NO; }
+        NSMutableDictionary *runs = days[day] ?: [NSMutableDictionary dictionary];
+        NSString *key = uuid.UUIDString.lowercaseString; runs[key] = @(MAX([runs[key] unsignedLongLongValue], [ms unsignedLongLongValue])); days[day] = runs;
+    }
+    if (!days.count) return YES;
+    NSMutableDictionary *doc = [@{@"version": @2, @"runs": @{}, @"days": days} mutableCopy]; if (last) doc[@"lastActivityAt"] = @(last);
+    return localOperation(local, doc, NO, nil, error) != nil;
+}
+NSDictionary *DMGameTimeSummary(NSURL *local, NSError **error) { return localOperation(local, nil, NO, nil, error); }
+NSNumber *DMGameTimeTotal(NSURL *local, NSError **error) { return DMGameTimeSummary(local, error)[@"totalMs"]; }
+NSDictionary *DMGameTimeDailyTotals(NSURL *local, NSError **error) {
+    NSDictionary *doc = localOperation(local, nil, YES, nil, error); if (!doc) return nil;
+    NSMutableDictionary *days = [NSMutableDictionary dictionary];
+    for (NSString *day in doc[@"days"]) { uint64_t total = 0; for (NSNumber *n in [doc[@"days"][day] allValues]) total += n.unsignedLongLongValue; days[day] = @(total); }
+    return days;
+}
+NSDictionary *DMGameTimeSynchronizeSummaryWithProgress(NSURL *local, NSURL *cloud, NSProgress *progress, NSError **error) {
+    if (cancelled(progress, error)) return nil;
+    if (!cloud) return localOperation(local, nil, NO, progress, error);
+    NSFileManager *fm = NSFileManager.defaultManager;
+    if (![fm createDirectoryAtURL:cloud.URLByDeletingLastPathComponent withIntermediateDirectories:YES attributes:nil error:error]) return nil;
+    [fm startDownloadingUbiquitousItemAtURL:cloud error:nil];
+    __block NSDictionary *out = nil; __block NSError *failure = nil; NSError *coordination = nil;
+    [progress.userInfo[@"GameTimeCloudCoordinator"] coordinateWritingItemAtURL:cloud options:NSFileCoordinatorWritingForMerging error:&coordination byAccessor:^(NSURL *url) {
+        if (cancelled(progress, &failure)) return;
+        NSDictionary *before = readDoc(url, YES, &failure); if (!before) return;
+        NSMutableDictionary *remote = [before mutableCopy];
+        NSArray<NSFileVersion *> *versions = [NSFileVersion unresolvedConflictVersionsOfItemAtURL:url];
+        for (NSFileVersion *version in versions) {
+            NSDictionary *doc = readDoc(version.URL, NO, &failure); if (!doc) return;
+            joinRuns(remote[@"runs"], doc[@"runs"] ?: @{});
+            if ([doc[@"version"] intValue] == 2) {
+                remote[@"version"] = @2;
+                if (!remote[@"days"]) remote[@"days"] = [NSMutableDictionary dictionary];
+                for (NSString *day in doc[@"days"]) {
+                    if (!remote[@"days"][day]) remote[@"days"][day] = [NSMutableDictionary dictionary];
+                    joinRuns(remote[@"days"][day], doc[@"days"][day]);
+                }
+                remote[@"lastActivityAt"] = @(MAX([remote[@"lastActivityAt"] unsignedLongLongValue], [doc[@"lastActivityAt"] unsignedLongLongValue]));
+            }
+        }
+        // Cloud then local: checkpoints never acquire the cloud coordinator.
+        NSDictionary *merged = localOperation(local, remote, YES, progress, &failure); if (!merged) return;
+        NSDictionary *localSource = merged[@"source"];
+        NSMutableDictionary *snapshot = [merged mutableCopy]; [snapshot removeObjectForKey:@"source"];
+        merged = snapshot;
+        if (cancelled(progress, &failure)) return;
+        if (![before isEqual:merged] && !writeDoc(merged, url, &failure)) return;
+        if (cancelled(progress, &failure)) return;
+        for (NSFileVersion *version in versions) { if (cancelled(progress, &failure)) return; version.resolved = YES; if (![version removeAndReturnError:&failure]) return; }
+        NSMutableDictionary *stats = [summary(merged, &failure) mutableCopy];
+        if (localSource) stats[@"source"] = localSource;
+        if (sourceSignature(url)) stats[@"cloudSource"] = sourceSignature(url);
+        out = stats;
+    }];
+    if (!out && error) *error = coordination ?: failure ?: invalid(@"Could not synchronize play time.");
+    return out;
+}
+NSDictionary *DMGameTimeSynchronizeSummary(NSURL *local, NSURL *cloud, NSError **error) { return DMGameTimeSynchronizeSummaryWithProgress(local, cloud, DMGameTimeSyncProgress(), error); }
+BOOL DMGameTimeSynchronize(NSURL *local, NSURL *cloud, NSError **error) { return DMGameTimeSynchronizeSummary(local, cloud, error) != nil; }
+NSArray<NSDictionary *> *DMGameTimeSplitInterval(NSDate *start, NSDate *end, uint64_t ms, NSString *previousZone, NSString *currentZone) {
+    if (!ms) return @[];
+    NSCalendar *cal = [[NSCalendar alloc] initWithCalendarIdentifier:NSCalendarIdentifierGregorian]; cal.timeZone = [NSTimeZone timeZoneWithName:currentZone] ?: [NSTimeZone timeZoneForSecondsFromGMT:0];
+    NSString *current = dayKey(end, cal);
+    double wall = [end timeIntervalSinceDate:start];
+    if (![previousZone isEqual:currentZone] || wall <= 0 || fabs(wall * 1000 - (double)ms) > 1000 || [dayKey(start, cal) isEqual:current]) return @[@{@"day": current, @"milliseconds": @(ms)}];
+    NSMutableArray *out = [NSMutableArray array]; NSDate *cursor = start; uint64_t allocated = 0;
+    while ([cursor compare:end] == NSOrderedAscending) {
+        NSDate *dayStart = nil; NSTimeInterval duration = 0;
+        if (![cal rangeOfUnit:NSCalendarUnitDay startDate:&dayStart interval:&duration forDate:cursor]) return @[@{@"day": current, @"milliseconds": @(ms)}];
+        NSDate *boundary = [dayStart dateByAddingTimeInterval:duration];
+        NSDate *stop = [boundary compare:end] == NSOrderedAscending ? boundary : end;
+        uint64_t target = [stop isEqual:end] ? ms : (uint64_t)((long double)ms * [stop timeIntervalSinceDate:start] / wall);
+        if (target > allocated) [out addObject:@{@"day": dayKey(cursor, cal), @"milliseconds": @(target - allocated)}];
+        allocated = target; cursor = stop;
+    }
+    return out;
+}
+
+int DMGameTimeSynchronizePaths(const char *save, const char *title, const char *folder, int timeout) { @autoreleasepool {
+    if (!save || !title || !folder) return 1;
+    NSString *savePath = @(save), *titleID = @(title), *cloudFolder = @(folder);
+    NSProgress *progress = DMGameTimeSyncProgress();
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    __block BOOL ok = NO;
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{ @autoreleasepool {
+        if (!progress.cancelled) {
+            NSURL *cloud = DMGameTimeCloudURL(cloudFolder, titleID);
+            if (!progress.cancelled) {
+                if (!cloud) ok = YES;
+                else {
+                    NSURL *local = DMGameTimeLocalURL([NSURL fileURLWithPath:savePath], cloud, titleID);
+                    NSError *error = nil;
+                    if (local) ok = DMGameTimeSynchronizeSummaryWithProgress(local, cloud, progress, &error) != nil;
+                }
+            }
+        }
+        dispatch_semaphore_signal(done);
+    }});
+    if (dispatch_semaphore_wait(done, dispatch_time(DISPATCH_TIME_NOW, (int64_t)MAX(0, timeout) * NSEC_PER_MSEC))) { [progress cancel]; return 0; }
+    return ok;
+} }
