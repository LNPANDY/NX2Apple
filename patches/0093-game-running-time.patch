+    update(local, A, 130); syncTime(local, cloud);
+    assert([backup writeToURL:local atomically:YES]);
+    update(local, B, 20); assert(total(local) == 120); // stale same-device restore, then new offline execution
+    syncTime(local, cloud); assert(total(local) == 150);
+    assert([[NSData dataWithContentsOfURL:local] writeToURL:other atomically:YES]);
+    update(other, C, 30); update(local, B, 40); // independently running copies
+    syncTime(local, cloud); syncTime(other, cloud); syncTime(local, cloud);
+    assert(total(local) == 200 && total(other) == 200);
+    NSDictionary *attributes = [fm attributesOfItemAtPath:cloud.path error:nil];
+    syncTime(local, cloud);
+    assert([attributes[NSFileModificationDate] isEqual:[fm attributesOfItemAtPath:cloud.path error:nil][NSFileModificationDate]]);
+    writeDoc(cloud, @{A: @1}); // a lower remote snapshot must not remove local IDs or lower a run
+    syncTime(local, cloud); assert(total(local) == 200);
+
+    dispatch_apply(40, dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^(size_t i) {
+        @autoreleasepool { update(local, i % 2 ? A : B, 1000 + i); }
+    });
+    assert(total(local) == 1039 + 1038 + 30);
+    syncTime(local, cloud);
+    update(local, C, 50); // a later checkpoint remains pending after the earlier publication
+    syncTime(local, cloud); syncTime(other, cloud);
+    assert(total(other) == 1039 + 1038 + 50);
+
+    NSArray *bad = @[@{@"version": @YES, @"runs": @{}}, @{@"version": @2, @"runs": @{}}, @{@"version": @1, @"runs": @{A: @(-1)}},
+                    @{@"version": @1, @"runs": @{A: @YES}}, @{@"version": @1, @"runs": @{A: @1.5}},
+                    @{@"version": @1, @"runs": @{@"invalid": @1}}];
+    for (NSDictionary *doc in bad) {
+        NSData *data = [NSJSONSerialization dataWithJSONObject:doc options:0 error:nil];
+        assert([data writeToURL:cloud atomically:YES]);
+        NSError *e; assert(!DMGameTimeSynchronize(local, cloud, &e) && e);
+        assert([[NSData dataWithContentsOfURL:cloud] isEqual:data]);
+        assert(total(local) == 1039 + 1038 + 50);
+    }
+    assert([fm removeItemAtURL:cloud error:nil]);
+    NSURL *placeholder = [cloud.URLByDeletingLastPathComponent URLByAppendingPathComponent:@".playtime.json.icloud"];
+    assert([[NSData data] writeToURL:placeholder atomically:YES]);
+    NSError *e; assert(!DMGameTimeSynchronize(local, cloud, &e) && e);
+    assert(![fm fileExistsAtPath:cloud.path]);
+    assert([fm removeItemAtURL:placeholder error:nil]); syncTime(local, cloud);
+    assert(DMGameTimeSynchronize(local, nil, &e));
+    NSMutableArray<NSTask *> *writers = [NSMutableArray array];
+    for (NSArray *args in @[@[local.path, A, @"2000"], @[local.path, B, @"3000"]]) {
+        NSTask *task = [NSTask new];
+        task.executableURL = [NSURL fileURLWithPath:@(argv[0])]; task.arguments = args;
+        assert([task launchAndReturnError:nil]); [writers addObject:task];
+    }
+    for (NSTask *task in writers) { [task waitUntilExit]; assert(task.terminationStatus == 0); }
+    assert(total(local) == 2000 + 3000 + 50); // distinct Mac processes must retain each other's entries
+
+
+    NSURL *base = [root URLByAppendingPathComponent:@"cloud"], *own = [base URLByAppendingPathComponent:@"0100000000000000"];
+    assert([DMGameTimeCloudURL(base.path, @"0100000000000000") isEqual:DMGameTimeCloudURL(own.path, @"0100000000000000")]);
+    assert(!DMGameTimeCloudURL(@"0", @"0100000000000000"));
+    assert(!DMGameTimeCloudURL(base.path, @"../escape"));
+    assert(!DMGameTimeLocalURL(local, nil, @"../escape"));
+    NSURL *save = [root URLByAppendingPathComponent:@"save"];
+    assert(![DMGameTimeLocalURL(save, cloud, @"0100000000000000") isEqual:DMGameTimeLocalURL(save, nil, @"0100000000000000")]);
+    assert(![DMGameTimeLocalURL(save, nil, @"0100000000000000") isEqual:DMGameTimeLocalURL(save, nil, @"0200000000000000")]);
+
+    dm_play_clock clock = {.anchor = 100, .running = 1};
+    dm_play_clock_set(&clock, 250, 0); dm_play_clock_set(&clock, 900, 0);
+    assert(clock.elapsed == 150);
+    dm_play_clock_set(&clock, 1000, 1); dm_play_clock_set(&clock, 1125, 1);
+    assert(clock.elapsed == 275); // pause and a delayed checkpoint use elapsed time, not timer ticks
+
+    NSURL *v2 = [root URLByAppendingPathComponent:@"dated.json"], *replica = [root URLByAppendingPathComponent:@"replica.json"], *remote2 = [root URLByAppendingPathComponent:@"dated-cloud/playtime.json"];
+    update(v2, A, 600000); NSData *legacy = [NSData dataWithContentsOfURL:v2];
+    assert(DMGameTimeSummary(v2, nil) && [[NSData dataWithContentsOfURL:v2] isEqual:legacy]);
+    assert((DMGameTimeUpdateSegments(v2, @[@{@"id": B, @"day": @"2026-11-11", @"milliseconds": @1200000}], 1794438000000ULL, nil)));
+    assert((DMGameTimeUpdateSegments(replica, @[@{@"id": C, @"day": @"2026-11-12", @"milliseconds": @300000}], 1794524400000ULL, nil)));
+    syncTime(v2, remote2); syncTime(replica, remote2); syncTime(v2, remote2);
+    assert(total(v2) == 2100000 && total(replica) == 2100000);
+    assert(([DMGameTimeDailyTotals(v2, nil) isEqual:@{@"2026-11-11": @1200000, @"2026-11-12": @300000}]));
+    assert([DMGameTimeSummary(v2, nil)[@"lastActivityAt"] unsignedLongLongValue] == 1794524400000ULL);
+    update(v2, A, 500000); syncTime(v2, remote2); assert(total(v2) == 2100000); // stale v1 restored history stays undated and is not counted twice
+    for (NSString *badDay in @[@"2026-02-29", @"2026-13-01", @"2026-11-00", @"2026-1-01", @"2026-01-01x"]) {
+        NSError *failure = nil; NSData *before = [NSData dataWithContentsOfURL:v2];
+        assert((!DMGameTimeUpdateSegments(v2, @[@{@"id": B, @"day": badDay, @"milliseconds": @1}], 1, &failure) && failure));
+        assert([[NSData dataWithContentsOfURL:v2] isEqual:before]);
+    }
+    NSDate *(^date)(NSString *) = ^NSDate *(NSString *text) { return [[NSISO8601DateFormatter new] dateFromString:text]; };
+    NSArray *parts = DMGameTimeSplitInterval(date(@"2026-11-12T05:50:00Z"), date(@"2026-11-12T06:10:00Z"), 1200000, @"America/Chicago", @"America/Chicago");
+    assert(([parts isEqual:@[@{@"day": @"2026-11-11", @"milliseconds": @600000}, @{@"day": @"2026-11-12", @"milliseconds": @600000}]]));
+    NSArray *discontinuous = DMGameTimeSplitInterval(date(@"2026-11-12T05:50:00Z"), date(@"2026-11-12T18:00:00Z"), 60000, @"America/Chicago", @"Asia/Tokyo");
+    assert(([discontinuous isEqual:@[@{@"day": @"2026-11-13", @"milliseconds": @60000}]]));
+    NSArray *spring = DMGameTimeSplitInterval(date(@"2026-03-08T05:50:00Z"), date(@"2026-03-09T05:10:00Z"), 84000000, @"America/Chicago", @"America/Chicago");
+    assert(([spring isEqual:@[@{@"day": @"2026-03-07", @"milliseconds": @600000}, @{@"day": @"2026-03-08", @"milliseconds": @82800000}, @{@"day": @"2026-03-09", @"milliseconds": @600000}]]));
+
+    for (NSNumber *count in @[@2190, @18250, @91250]) {
+        NSMutableDictionary *runs = [NSMutableDictionary dictionary];
+        for (NSUInteger i = 0; i < count.unsignedIntegerValue; i++) {
+            NSString *id = [NSString stringWithFormat:@"550e8400-e29b-41d4-a716-%012lx", (unsigned long)i];
+            runs[id] = @3600000;
+        }
+        writeDoc(local, runs);
+        assert([fm removeItemAtURL:cloud error:nil]);
+        NSTimeInterval start = NSProcessInfo.processInfo.systemUptime;
+        update(local, B, 7200000);
+        NSTimeInterval localTime = NSProcessInfo.processInfo.systemUptime - start;
+        start = NSProcessInfo.processInfo.systemUptime; syncTime(local, cloud);
+        printf("game time: %lu entries, %llu bytes, checkpoint %.3fs, folder sync %.3fs\n", (unsigned long)runs.count,
+               [[fm attributesOfItemAtPath:cloud.path error:nil][NSFileSize] unsignedLongLongValue], localTime,
+               NSProcessInfo.processInfo.systemUptime - start);
+    }
+    assert([fm removeItemAtURL:root error:nil]);
+    puts("game time: restore, clone, concurrent merge, retry, validation, paths, clock and size checks passed");
+    return 0;
+} }
