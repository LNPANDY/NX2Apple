+        if len(head) != HEAD.size:
+            raise ValueError(f'not a RomFS image: {img_path}')
+        magic, ioff, isz, _ = HEAD.unpack(head)
+        if magic != MAGIC:
+            raise ValueError(f'not a RomFS image: {img_path}')
+        info = check_bounds_and_trailer(f, file_size, ioff, isz, img_path)
