+    dm_pad_layout_parse("1;2d/face:0,0/stick:0,0;3d/a:0,0/zl:0,0", &named);
+    dm_pad_layout_parse("1;2s/face:3,-2/stick:2,-2;3s/a:-2,0", &other);   // only the split layouts
+    for (int i = 0; i < nscreens; i++)
+        for (int full = 0; full < 2; full++)
+            for (int z = 0; z < 3; z++) {
