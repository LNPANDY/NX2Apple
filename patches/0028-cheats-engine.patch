+        self.assertIn('copy 2 of 2 by order: weak', got['Second'][3]['how'])
+        # each copy followed by a function of its own: the window identifies the copy, and contradicts a changed order
+        tail = lambda k: [MOVZ(k, k), MOVZ(k, k + 1), RET]
