+// Cheat engine unit test (hle_cheats.c): the Atmosphère opcodes against hand-computed results held to
+// docs/reference/cheats.md (the memory and key conditionals, else, loops, the four load forms and the narrow load that
+// keeps a register's upper bytes, the register-address store, legacy arithmetic, nested skipping, the 8-byte word order,
+// a truncated instruction, 9 register arithmetic in every math type and width with the shifts and the float forms, A
+// store register, C0 register conditional, C1 / C2 save and restore across cheats and their reset between passes, C3
+// static registers, C4 extended key-press across passes with its one previous-keys value), the pass (registers shared
+// between the cheats of one pass, masters first, reset between passes), what an access may reach (main, the heap, another
+// module's data but not its code, a mapped page of the guest block but not an unmapped one) and that a failed access is
+// ignored and counted, never turning the cheat off; and the host's own layer over the format: labels and EdiZon
+// sections, a header glued to a code line, duplicate names in <build>.enabled, on / off pairs as one switch, the meta
+// file of scripts/cheat_anchor.py (typed "ask" values kept in <build>.values, "set" cheats that run once, never-decrease,
+// the compiler's left-outs, the display version), the dry run, the master switch, safe mode after an unclean exit, toggles
+// carried over to a new build, DM_CHEATS_ANY_BUILD's count of build-named files, and the load report. A synthetic main
+// image (text, data, key page), a second module, a heap and a guest block (one mapped page, one PROT_NONE page) live in
+// host memory; writes go through the engine's real paths (the writable alias of main, vm_write for a guest page).
+// Expectations are written by hand, not generated by the code under test.
+#include "../hle_cheats.c"
+#include <sys/stat.h>
+
+static module_t test_modules[3]; module_t *g_mod = test_modules; int g_nmod;   // the loader's module table (loader.c): "main" and a second module "sdk" here
+uint64_t now_ns(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec; }
+void dm_guest_write_prepare(void *addr, size_t len) { (void)addr; (void)len; }   // no dirty-page tracking in the test
+static uint8_t *heap; static size_t heap_open;   // the guest heap (hle_svc.c): a plain buffer, opened in full
+void dm_guest_heap_range(uint64_t *base, size_t *open_len) { *base = (uint64_t)(uintptr_t)heap; *open_len = heap_open; }
+int dm_guest_heap_read(uint64_t a, void *out, size_t n) { memcpy(out, (void *)(uintptr_t)a, n); return 0; }
+int dm_guest_heap_write(uint64_t a, const void *src, size_t n) { memcpy((void *)(uintptr_t)a, src, n); return 0; }
+// The reserved guest address block (hle_svc.c g_as): GAS bytes, of which only the first page is mapped (a thread stack,
+// say); the second page stays PROT_NONE, an address the game has unmapped, which the engine must fail on without faulting
+#define GAS 0x20000
+static uint8_t *gas;
+int dm_guest_as_contains(uintptr_t a) { uintptr_t b = (uintptr_t)gas; return gas && a >= b && a - b < GAS; }
+static int as_ready = 1;   // 0: the block is not reserved yet (a pass before hle_svc.c's mem_init): svc_guest_range answers NULL
+void svc_guest_range(uint8_t **base, size_t *size) { *base = as_ready ? gas : NULL; *size = as_ready ? GAS : 0; }
+static uint64_t held;                            // the keys "held" for the key-press conditional (hle_hid.c)
+uint64_t dm_cheats_keys(void) { return held; }
+
+static int checks, fails;
+#define CHECK(c, s) do { checks++; int ok_ = !!(c); fails += !ok_; printf("%s %s\n", ok_ ? "✓" : "✗", s); } while (0)
+
