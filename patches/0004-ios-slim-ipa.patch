diff --git a/dm/ios/tools/build_ipa.sh b/dm/ios/tools/build_ipa.sh
index 1bb65f08..6a338846 100755
--- a/dm/ios/tools/build_ipa.sh
+++ b/dm/ios/tools/build_ipa.sh
@@ -178,6 +178,9 @@ if [ -n "${DM_ENTITLEMENTS-default}" ]; then
 fi
 P=Payload/DmIOS.app
 MAPS=()
+# The fork packs the slim IPA by default (upstream: DM_COPY_ROMFS=NO): DM_FULL_ROMFS=1 or DM_COPY_ROMFS=YES packs the
+# game files into the package, which for a large game is many GB and iOS refuses to install it (PackageExtractionFailed)
+[ -n "${DM_COPY_ROMFS:-}" ] || { [ -n "${DM_FULL_ROMFS:-}" ] && DM_COPY_ROMFS=YES || DM_COPY_ROMFS=NO; }
 if [ "${DM_COPY_ROMFS:-YES}" = NO ]; then
   t "no game files in the IPA (DM_COPY_ROMFS=NO): the app takes Documents/romfs.img (scripts/push_romfs.sh)"
   # The image's identity (dm/host/romfs_identity.h) goes into the app as romfs.id: main.m then uses only a Documents/romfs.img with the same size and index hash, and says so when it is another version or missing.
@@ -187,7 +190,11 @@ if [ "${DM_COPY_ROMFS:-YES}" = NO ]; then
     MAPS=("$P/romfs.id=$O/romfs.id"); t "game files identity: $(cat "$O/romfs.id")"
   fi
 elif [ -f "$ROMFS" ]; then MAPS=("$P/romfs.img=$ROMFS"); else MAPS=("$P/romfs=$ROMFS"); fi
-if [ -n "$AOC" ] && [ -d "$AOC" ]; then MAPS+=("$P/aoc=$AOC"); t "add-on content: $(ls "$AOC" | tr '\n' ' ')"; fi
+if [ "$DM_COPY_ROMFS" != NO ] && [ -n "$AOC" ] && [ -d "$AOC" ]; then
+  MAPS+=("$P/aoc=$AOC"); t "add-on content packed into the IPA: $(ls "$AOC" | tr '\n' ' ')"
+elif [ -n "$AOC" ] && [ -d "$AOC" ]; then
+  t "add-on content alongside the game data (DM_FULL_ROMFS=1 packs it): $(ls "$AOC" | tr '\n' ' ')"
+fi
 if [ -n "${PSO:-}" ]; then MAPS+=("$P/pso=$PSO"); fi
 MAPS+=("$P/msl/$MSLDIR=$MSL_IOS/$MSLDIR" "$P=$APP")
 t "pack IPA (already-compressed game files stored, everything else deflated)"
diff --git a/dm/ios/tools/xcode_projects.py b/dm/ios/tools/xcode_projects.py
index a832ad5a..0f5485df 100644
--- a/dm/ios/tools/xcode_projects.py
+++ b/dm/ios/tools/xcode_projects.py
@@ -33,10 +33,42 @@ def workspace_projects(workspace):
         if kind == 'absolute': yield Path(path).resolve()
 
 
+def prune_unreadable(workspace):
+    """Remove workspace entries the current user cannot access, and save the file.
+
+    The workspace records absolute paths, and the launcher's saved state crosses accounts on a
+    shared Mac: a new user's build inherits the first user's entries and dies with PermissionError
+    when it stats them. A project this user cannot read is not this user's project — removing the
+    entry is the fix, not a message telling them to edit XML."""
+    path = Path(workspace) / 'contents.xcworkspacedata'
+    if not path.exists(): return 0
+    tree = workspace_tree(workspace)
+    removed = 0
+    for group in tree.iter('Group'):
+        for ref in list(group.findall('FileRef')):
+            kind, _, loc = ref.get('location', '').partition(':')
+            if kind != 'absolute': continue
+            try:
+                Path(loc).exists()
+                continue   # the current user can read it: a real project, not a stale entry
+            except (PermissionError, OSError):
+                pass
+            group.remove(ref)
+            removed += 1
+    if removed:
+        tree.write(str(path), xml_declaration=True, encoding='unicode')
+        print(f'[NOTE] removed {removed} workspace entr{"y" if removed == 1 else "ies"} the current user cannot read (registered by another macOS user)')
+    return removed
+
+
 def check_bundle_id(workspace, project, bundle_id):
+    prune_unreadable(workspace)
     for other in workspace_projects(workspace):
         if other == Path(project).resolve() or not other.exists(): continue
-        used = signing_settings(other).get('PRODUCT_BUNDLE_IDENTIFIER', '')
+        try:
+            used = signing_settings(other).get('PRODUCT_BUNDLE_IDENTIFIER', '')
+        except (PermissionError, OSError):
+            continue
         if used.lower() == bundle_id.lower():
             raise ValueError(f'bundle ID {bundle_id} is already used by {other}; choose a different --bundle-id for this game')
 
diff --git a/docs/env_switches.tsv b/docs/env_switches.tsv
index 1400e86e..2dc79e65 100644
--- a/docs/env_switches.tsv
+++ b/docs/env_switches.tsv
@@ -36,6 +36,7 @@ DM_FS	diagnostic	When set, logs file opens, paths not found or not mounted, and
 DM_FSLOG	diagnostic	`=<file>` writes one TSV line per ReadFile: seconds since boot, guest path, offset, length and guest buffer address
 DM_FSLOG_HASH	diagnostic	With `DM_FSLOG`, adds a column with the FNV-1a 64 hash of the bytes read
 DM_FULLSCREEN	player	`1` (any value but `0`) starts the Mac window in fullscreen; `0` or unset, a window. The Mac settings window's Display mode
+DM_FULL_ROMFS	diagnostic	`=1` in `build_ipa.sh` packs the game data into the IPA as it did before the slim package; the default leaves it in `Documents/games/<id>/` (`romfs.img`, `aoc/<index>.img`) and the DLC beside it. Only for small games — a full package of a large one is many GB and iOS refuses it (`PackageExtractionFailed`)
 DM_GAME	switch	Selects the game profile (a title ID under `dm/games` or `DM_GAMES_DIR`) for the Python tools and the rewriter; there is no default
 DM_GAMES_DIR	path	Profile folders outside the repository, separated by `:`, searched after `dm/games`; the NSP script points it at a provisional or derived profile
 DM_GAMES_FIRST	switch	`=1` searches `DM_GAMES_DIR` before `dm/games`, so a provisional or derived profile wins over the game's own (the NSP script's `--provisional`)
