+    def test_cli_sigterm_race_raises_compress_stopped_not_error(self):
+        src = self.root / 'race.img'
+        shader_lib.write({'0000000000000001_b.metal': b'void f(){}'}, str(src))
+        zst = self.root / 'race.img.zst'
+        build_seed._zstd_compress_stream(str(src), str(zst), level=3)
+
+        class _FakeProc:
+            def __init__(self, stdout_chunks=None, rc=-15):
+                self._chunks = list(stdout_chunks or [])
+                self.stdout = self
+                self.stderr = self
+                self._rc = rc
+
+            def read(self, _n=-1):
+                if self._chunks:
+                    return self._chunks.pop(0)
+                return b''
+
+            def wait(self, timeout=None):
+                return self._rc
+
+            def poll(self):
+                return self._rc
+
+            def terminate(self):
+                pass
+
+            def kill(self):
+                pass
+
+            def close(self):
+                pass
+
+        # 1. Compress CLI exits -15 while stop_ctrl.stopped became True
+        ctrl_c = build_seed._CompressStopController()
+
+        def _fake_popen_compress(*args, **kwargs):
+            ctrl_c.stopped = True
+            return _FakeProc(rc=-15)
+
+        with mock.patch.object(build_seed, '_zstd_backend', return_value=('cli', 'zstd')), \
+                mock.patch('subprocess.Popen', side_effect=_fake_popen_compress):
+            with self.assertRaises(build_seed._CompressStopped):
+                build_seed._zstd_compress_stream(str(src), str(self.root / 'race.tmp'), stop_ctrl=ctrl_c)
+
+        # 2. Decompress CLI exits -15 after EOF while stop_ctrl.stopped became True
+        ctrl_d = build_seed._CompressStopController()
+
+        def _fake_popen_decompress(*args, **kwargs):
+            ctrl_d.stopped = True
+            return _FakeProc(stdout_chunks=[], rc=-15)
+
+        with mock.patch.object(build_seed, '_zstd_backend', return_value=('cli', 'zstd')), \
+                mock.patch('subprocess.Popen', side_effect=_fake_popen_decompress):
+            with self.assertRaises(build_seed._CompressStopped):
