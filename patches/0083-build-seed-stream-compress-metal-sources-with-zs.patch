+    def test_open_shader_lib_view_prefers_zst_over_residual_img(self):
+        d = self.root / 'dual_view'
+        d.mkdir(parents=True, exist_ok=True)
+        chain = '1234567890abcdef'
+        lib_base = d / f'b-{chain}'
+        shader_lib.write({'0000000000000001_b.metal': b'void old_img() {}\n'}, str(d / f'b-{chain}.img'))
+
+        new_raw = self.root / 'new_view.img'
+        shader_lib.write({'0000000000000001_b.metal': b'void new_zst() {}\n'}, str(new_raw))
+        build_seed._zstd_compress_stream(str(new_raw), str(d / f'b-{chain}.img.zst'), level=3)
+
+        quota = build_seed._Quota()
+        with build_seed._open_shader_lib_view(str(lib_base), quota) as view:
+            text = (view / '0000000000000001_b.metal').read_text()
+        self.assertIn('new_zst', text)
+        self.assertNotIn('old_img', text)
+
+        # Corrupt .img.zst must fall back safely to sibling .img
+        (d / f'b-{chain}.img.zst').write_bytes(b'CORRUPT')
+        with build_seed._open_shader_lib_view(str(lib_base), quota) as view_fb:
+            text_fb = (view_fb / '0000000000000001_b.metal').read_text()
+        self.assertIn('old_img', text_fb)
