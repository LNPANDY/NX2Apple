+class _CompressStopped(Exception):
+    """Internal control-flow signal raised when SIGTERM/SIGINT interrupts seed compression."""
+
+
+class _CompressStopController:
+    """Tracks cooperative stop state, active subprocess, and temporary file cleanup on signals."""
+
+    def __init__(self):
+        self.stopped = False
+        self._lock = threading.Lock()
+        self._proc = None
+        self._tmp_paths = set()
+
+    def request_stop(self):
+        with self._lock:
+            self.stopped = True
+            proc = self._proc
+        if proc is not None:
+            try:
+                proc.terminate()
+            except OSError:
+                pass
+
+    def check(self):
+        if self.stopped:
+            raise _CompressStopped('seed compression interrupted')
+
+    def set_proc(self, proc):
+        with self._lock:
+            self._proc = proc
+            stopped = self.stopped
+        if stopped and proc is not None:
+            try:
+                proc.terminate()
+            except OSError:
+                pass
+
+    def add_tmp(self, path):
+        with self._lock:
+            self._tmp_paths.add(path)
+
+    def discard_tmp(self, path):
+        with self._lock:
+            self._tmp_paths.discard(path)
+
+    def cleanup_tmps(self):
+        with self._lock:
+            paths = list(self._tmp_paths)
+            self._tmp_paths.clear()
+        for p in paths:
+            try:
+                if os.path.lexists(p) and not os.path.islink(p):
+                    os.unlink(p)
+            except OSError:
+                pass
+
+
+def _find_zstd_cli():
+    return shutil.which('zstd')
+
+
+def _zstd_backend():
+    """Returns ('pep784'|'zstandard'|'cli', handle) in priority order, or None."""
+    for mod_name in ('compression.zstd', 'backports.zstd'):
+        try:
+            mod = importlib.import_module(mod_name)
+            if hasattr(mod, 'ZstdFile') or hasattr(mod, 'open'):
+                return ('pep784', mod)
+        except ImportError:
+            continue
+    try:
+        mod = importlib.import_module('zstandard')
+        if hasattr(mod, 'ZstdCompressor') and hasattr(mod, 'ZstdDecompressor'):
+            return ('zstandard', mod)
+    except ImportError:
+        pass
+    cli = _find_zstd_cli()
+    if cli:
+        return ('cli', cli)
+    return None
+
+
+def zstd_available():
+    """Returns True if any streaming zstd compressor/decompressor backend is available."""
+    return _zstd_backend() is not None
+
+
+def _open_regular_nofollow(path):
+    """Opens a regular file without following symlinks, verifying non-reparse regular file."""
+    p = os.fspath(path)
+    st = os.lstat(p)
+    if _is_symlink_or_reparse(p, st):
+        raise ValueError(f'symlink forbidden: {p}')
+    if not stat.S_ISREG(st.st_mode):
+        raise ValueError(f'non-regular file forbidden: {p}')
+    flags = os.O_RDONLY | getattr(os, 'O_BINARY', 0) | getattr(os, 'O_NOFOLLOW', 0)
+    fd = os.open(p, flags)
+    try:
+        fst = os.fstat(fd)
+        if not stat.S_ISREG(fst.st_mode):
+            raise ValueError(f'non-regular file forbidden: {p}')
+        return os.fdopen(fd, 'rb'), fst
+    except BaseException:
+        try:
+            os.close(fd)
+        except OSError:
+            pass
+        raise
+
+
+def _zstd_compress_stream(src_path, dst_tmp_path, level=3, stop_ctrl=None):
+    """Streams src_path through zstd compression into dst_tmp_path using bounded chunks."""
+    if isinstance(level, bool) or not isinstance(level, int) or not (1 <= level <= 22):
+        raise ValueError(f'invalid zstd compression level: {level!r}')
+    backend = _zstd_backend()
+    if backend is None:
+        raise RuntimeError('zstd compression is unavailable')
+
+    dst_p = os.fspath(dst_tmp_path)
+    if os.path.lexists(dst_p):
+        if os.path.islink(dst_p) or os.path.isdir(dst_p):
+            raise ValueError(f'unsafe temporary output path: {dst_p}')
+        os.unlink(dst_p)
+
+    kind, handle = backend
+    if stop_ctrl is not None:
+        stop_ctrl.add_tmp(dst_p)
+    try:
+        fin, _ = _open_regular_nofollow(src_path)
+        if kind == 'cli':
+            fin.close()
+            if stop_ctrl is not None:
+                stop_ctrl.check()
+            cmd = [handle, f'-{level}', '-q', '-f', '-o', dst_p, '--', os.fspath(src_path)]
+            popen_kw = {}
+            if os.name == 'nt':
+                popen_kw['creationflags'] = getattr(subprocess, 'CREATE_NO_WINDOW', 0x08000000)
+            proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, **popen_kw)
+            if stop_ctrl is not None:
+                stop_ctrl.set_proc(proc)
+            try:
+                while True:
+                    if stop_ctrl is not None and stop_ctrl.stopped:
+                        proc.terminate()
+                        try:
+                            proc.wait(timeout=2)
+                        except subprocess.TimeoutExpired:
+                            proc.kill()
+                            proc.wait(timeout=2)
+                        raise _CompressStopped('seed compression interrupted')
+                    try:
+                        rc = proc.wait(timeout=0.05)
+                        break
+                    except subprocess.TimeoutExpired:
+                        continue
+                err = proc.stderr.read() if proc.stderr else b''
+                if stop_ctrl is not None:
+                    stop_ctrl.check()
+                if rc != 0:
+                    raise OSError(f'zstd CLI compression failed (rc={rc}): {err.decode("utf-8", "replace").strip()}')
+            finally:
+                if proc.stderr:
+                    proc.stderr.close()
+                if stop_ctrl is not None:
+                    stop_ctrl.set_proc(None)
+        elif kind == 'pep784':
+            with fin, open(dst_p, 'wb') as raw_out:
+                zfile_cls = getattr(handle, 'ZstdFile', None) or handle.open
+                with zfile_cls(raw_out, 'wb', level=level) as zout:
+                    while True:
+                        if stop_ctrl is not None:
+                            stop_ctrl.check()
+                        chunk = fin.read(_ZSTD_CHUNK)
+                        if not chunk:
+                            break
+                        zout.write(chunk)
+                raw_out.flush()
+                os.fsync(raw_out.fileno())
+        else:
+            with fin, open(dst_p, 'wb') as raw_out:
+                cctx = handle.ZstdCompressor(level=level)
+                with cctx.stream_writer(raw_out, closefd=False) as writer:
+                    while True:
+                        if stop_ctrl is not None:
+                            stop_ctrl.check()
+                        chunk = fin.read(_ZSTD_CHUNK)
+                        if not chunk:
+                            break
+                        writer.write(chunk)
+                raw_out.flush()
+                os.fsync(raw_out.fileno())
+    except BaseException:
+        try:
+            if os.path.lexists(dst_p) and not os.path.islink(dst_p):
+                os.unlink(dst_p)
+        except OSError:
+            pass
+        if stop_ctrl is not None:
+            stop_ctrl.discard_tmp(dst_p)
+        raise
+
+
+def _zstd_verify_and_decompress_stream(
+    src_zst_path,
+    dst_path=None,
+    expected_size=None,
+    expected_magic=None,
+    max_bytes=SEED_MAX_BYTES,
+    stop_ctrl=None,
+):
+    """Streams and verifies a zstd archive, optionally writing the decompressed output atomically."""
+    backend = _zstd_backend()
+    if backend is None:
+        raise RuntimeError('zstd decompression is unavailable')
+    kind, handle = backend
+
+    fin, fst = _open_regular_nofollow(src_zst_path)
+    if fst.st_size == 0:
+        fin.close()
+        raise ValueError(f'empty zstd archive: {src_zst_path}')
+
+    dst_p = os.fspath(dst_path) if dst_path is not None else None
+    tmp_dst = None
+    out_f = None
+    if dst_p is not None:
+        parent = os.path.dirname(os.path.abspath(dst_p))
+        if os.path.islink(parent):
+            fin.close()
+            raise ValueError(f'symlink parent forbidden: {parent}')
+        os.makedirs(parent, exist_ok=True)
+        tmp_dst = f'{dst_p}.part.{os.getpid()}'
+        if os.path.islink(tmp_dst):
+            fin.close()
+            raise ValueError(f'symlink temporary path forbidden: {tmp_dst}')
+        out_f = open(tmp_dst, 'wb')
+
+    total = 0
+    head_buf = bytearray()
+    magic_len = len(expected_magic) if expected_magic else 0
+    check_romfs_head = (expected_magic == romfs_image.MAGIC)
+    capture_len = romfs.HEAD.size if check_romfs_head else magic_len
+    try:
+        def _consume(chunk):
+            nonlocal total
+            if stop_ctrl is not None:
+                stop_ctrl.check()
+            if max_bytes is not None and len(chunk) > max_bytes - total:
+                raise ValueError(f'decompressed zstd payload exceeds byte quota ({max_bytes} bytes): {src_zst_path}')
+            if capture_len and len(head_buf) < capture_len:
+                need = capture_len - len(head_buf)
+                prev_len = len(head_buf)
+                head_buf.extend(chunk[:need])
+                if magic_len and prev_len < magic_len <= len(head_buf) and bytes(head_buf[:magic_len]) != expected_magic:
+                    raise ValueError(f'invalid decompressed magic in {src_zst_path}: expected {expected_magic!r}')
+            total += len(chunk)
+            if out_f is not None:
+                out_f.write(chunk)
+
+        if kind == 'cli':
+            fin.close()
+            if stop_ctrl is not None:
+                stop_ctrl.check()
+            popen_kw = {}
+            if os.name == 'nt':
+                popen_kw['creationflags'] = getattr(subprocess, 'CREATE_NO_WINDOW', 0x08000000)
+            proc = subprocess.Popen(
+                [handle, '-d', '-q', '-c', '--', os.fspath(src_zst_path)],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                **popen_kw,
+            )
+            if stop_ctrl is not None:
+                stop_ctrl.set_proc(proc)
+            try:
+                while True:
+                    if stop_ctrl is not None and stop_ctrl.stopped:
+                        proc.terminate()
+                        raise _CompressStopped('seed decompression interrupted')
+                    chunk = proc.stdout.read(_ZSTD_CHUNK)
+                    if not chunk:
+                        break
+                    _consume(chunk)
+                err = proc.stderr.read() if proc.stderr else b''
+                rc = proc.wait()
+                if stop_ctrl is not None:
+                    stop_ctrl.check()
+                if rc != 0:
+                    raise ValueError(
+                        f'corrupt or truncated zstd stream {src_zst_path} (rc={rc}): '
+                        f'{err.decode("utf-8", "replace").strip()}'
+                    )
+            except BaseException:
+                if proc.poll() is None:
+                    proc.terminate()
+                    try:
+                        proc.wait(timeout=2)
+                    except subprocess.TimeoutExpired:
+                        proc.kill()
+                        proc.wait(timeout=2)
+                raise
+            finally:
+                if proc.stdout:
+                    proc.stdout.close()
+                if proc.stderr:
+                    proc.stderr.close()
+                if stop_ctrl is not None:
+                    stop_ctrl.set_proc(None)
+        elif kind == 'pep784':
+            with fin:
+                zfile_cls = getattr(handle, 'ZstdFile', None) or handle.open
+                with zfile_cls(fin, 'rb') as zin:
+                    while True:
+                        chunk = zin.read(_ZSTD_CHUNK)
+                        if not chunk:
+                            break
+                        _consume(chunk)
+        else:
+            with fin:
+                dctx = handle.ZstdDecompressor()
+                with dctx.stream_reader(fin, read_across_frames=True, closefd=False) as reader:
+                    while True:
+                        chunk = reader.read(_ZSTD_CHUNK)
+                        if not chunk:
+                            break
+                        _consume(chunk)
+
+        if magic_len and bytes(head_buf[:magic_len]) != expected_magic:
+            raise ValueError(f'truncated header in decompressed {src_zst_path}')
+        if check_romfs_head:
+            if len(head_buf) < romfs.HEAD.size:
+                raise ValueError(f'truncated RomFS header in decompressed {src_zst_path}')
+            magic, off, size, count = romfs.HEAD.unpack(bytes(head_buf[:romfs.HEAD.size]))
+            if (
+                magic != romfs_image.MAGIC
+                or not (0 < count <= 0xffffffff)
+                or off < romfs.HEAD.size
+                or off > total
+                or size > total - off
+                or count > size // romfs.ENT.size
+            ):
+                raise ValueError(f'truncated or invalid RomFS header bounds in decompressed {src_zst_path}')
+        if expected_size is not None and total != expected_size:
+            raise ValueError(
+                f'decompressed size mismatch for {src_zst_path}: got {total} bytes, expected {expected_size}'
+            )
+
+        if out_f is not None:
+            out_f.flush()
+            out_f.close()
+            out_f = None
+            os.replace(tmp_dst, dst_p)
+            tmp_dst = None
+        return total
+    except BaseException:
+        if out_f is not None:
+            try:
+                out_f.close()
+            except OSError:
+                pass
+        if tmp_dst and os.path.lexists(tmp_dst):
+            try:
+                os.unlink(tmp_dst)
+            except OSError:
+                pass
+        raise
+
+
+def _lib_folder_of(lib):
+    s = os.fspath(lib)
+    if s.endswith('.img.zst'):
+        return s[:-8]
+    if s.endswith('.img'):
+        return s[:-4]
+    return s
+
+
+def _resolve_lib_for_read(lib_path, tmp_dir, quota):
+    """Resolves a shader library path preferring valid .img.zst over .img over folder.
+    Decompresses .img.zst into tmp_dir enforcing quota and DMROMFS1 + RomFS index validation."""
+    raw_p = os.fspath(lib_path)
+    folder = _lib_folder_of(raw_p)
+    zst_p = folder + '.img.zst'
+    img_p = folder + '.img'
+
+    for cand in (folder, img_p, zst_p):
+        if os.path.islink(cand) or _is_symlink_or_reparse(cand, os.lstat(cand) if os.path.lexists(cand) else None):
+            raise ValueError(f'symlink forbidden in shader library: {cand}')
+
+    if raw_p.endswith('.img.zst') or os.path.isfile(zst_p):
+        target_zst = raw_p if raw_p.endswith('.img.zst') else zst_p
+        if os.path.isfile(target_zst):
+            os.makedirs(tmp_dir, exist_ok=True)
+            fd, dec_img = tempfile.mkstemp(prefix='dec_', suffix='.img', dir=tmp_dir)
+            os.close(fd)
+            try:
+                budget = max(0, quota.max_bytes - quota.used_bytes)
+                _zstd_verify_and_decompress_stream(
+                    target_zst,
+                    dst_path=dec_img,
+                    expected_magic=romfs_image.MAGIC,
+                    max_bytes=budget,
+                )
+                romfs.Image(dec_img)
+                return dec_img
+            except BaseException:
+                try:
+                    if os.path.lexists(dec_img):
+                        os.unlink(dec_img)
+                except OSError:
+                    pass
+                if not raw_p.endswith('.img.zst') and os.path.isfile(img_p):
+                    return img_p
+                raise
+
+    if os.path.isfile(img_p):
+        return img_p
+    return raw_p
+
+
+@contextlib.contextmanager
+def _open_shader_lib_view(lib_path, quota):
+    """Context manager yielding a shader_lib.view(...) supporting .img.zst, .img, and folder."""
+    raw_p = os.fspath(lib_path)
+    folder = _lib_folder_of(raw_p)
+    zst_p = folder + '.img.zst'
+    if raw_p.endswith('.img.zst') or os.path.isfile(zst_p):
+        with tempfile.TemporaryDirectory(prefix='msl_zst_view_') as td:
+            resolved = _resolve_lib_for_read(raw_p, td, quota)
+            yield shader_lib.view(resolved)
+    else:
+        yield shader_lib.view(raw_p)
+
+
