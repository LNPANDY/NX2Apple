+    def _make_nvn_work(self, name='work', chain='1122334455667788', metal_tag='v1'):
+        work = self.root / name
+        (work / 'extract' / 'v0' / 'ExeFS').mkdir(parents=True)
+        (work / 'extract' / 'v0' / 'ExeFS' / 'main').write_bytes(b'MAIN_BIN')
+        (work / 'shader' / 'pkg').mkdir(parents=True)
+        (work / 'shader' / 'pkg' / 'pkg.bin').write_bytes(b'PKG')
+        (work / 'shader' / 'tables').mkdir(parents=True)
+        (work / 'shader' / 'tables' / 'c1_full.tsv').write_text('# c1\n', encoding='utf-8')
+        (work / 'shader' / 'tables' / 'cb_extent.tsv').write_text('# cb\n', encoding='utf-8')
+        (work / 'shader' / 'ios').mkdir(parents=True)
+        shader_lib.write(
+            {'0000000000000001_b.metallib': b'IOS_METALLIB', 'inputs.tsv': b'inputs\tst\n'},
+            str(work / 'shader' / 'ios' / f'b-{chain}.img'),
+        )
+        (work / 'shader' / 'cache').mkdir(parents=True)
+        shader_lib.write(
+            {
+                '0000000000000001_b.metal': f'vertex float4 {metal_tag}() {{ return 0; }}\n'.encode('utf-8') * 200,
+                '0000000000000001_b.json': b'{"stage":"vs"}\n',
+                '0000000000000001_bx.metallib': b'SIDE_BIN',
