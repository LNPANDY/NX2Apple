+    def test_cli_windows_sets_create_no_window_flag(self):
+        src = self.root / 'win.img'
+        shader_lib.write({'0000000000000001_b.metal': b'void f(){}'}, str(src))
+        zst = self.root / 'win.img.zst'
+        build_seed._zstd_compress_stream(str(src), str(zst), level=3)
+
+        seen_flags = []
+        raw_bytes = src.read_bytes()
+
+        class _OkProc:
+            def __init__(self, chunks):
+                self._chunks = list(chunks)
+                self.stdout = self
+                self.stderr = self
+
+            def read(self, _n=-1):
+                if self._chunks:
+                    return self._chunks.pop(0)
+                return b''
+
+            def wait(self, timeout=None):
+                return 0
+
+            def poll(self):
+                return 0
+
+            def close(self):
+                pass
+
+        def _capture_popen(cmd, **kwargs):
+            seen_flags.append(kwargs.get('creationflags'))
+            return _OkProc([raw_bytes] if '-d' in cmd else [])
+
+        with mock.patch.object(build_seed, '_zstd_backend', return_value=('cli', 'zstd')), \
+                mock.patch.object(build_seed.os, 'name', 'nt'), \
+                mock.patch('subprocess.Popen', side_effect=_capture_popen):
+            build_seed._zstd_compress_stream(str(src), str(self.root / 'win.tmp'))
+            build_seed._zstd_verify_and_decompress_stream(str(zst), expected_magic=romfs_image.MAGIC)
+
+        expected_flag = getattr(subprocess, 'CREATE_NO_WINDOW', 0x08000000)
+        self.assertEqual(seen_flags, [expected_flag, expected_flag])
