+    def test_compress_seeds_rejects_truncated_romfs_header_in_existing_zst(self):
+        seed_root = self.root / 'seeds_trunc_hdr'
+        tid = '0100000000000701'
+        chain = '7777888899990000'
+        _, img_path = self._make_legacy_seed_with_uncompressed_img(seed_root, tid, chain=chain)
+        orig_img_bytes = img_path.read_bytes()
+
+        # Case A: intact zstd frame containing < 32 bytes starting with DMROMFS1
+        trunc_src = self.root / 'trunc_short.img'
+        trunc_src.write_bytes(romfs_image.MAGIC + b'\x00' * 8)
+        zst_path = Path(str(img_path) + '.zst')
+        build_seed._zstd_compress_stream(str(trunc_src), str(zst_path), level=3)
+
+        with self.assertRaisesRegex(ValueError, 'truncated RomFS header'):
+            build_seed._zstd_verify_and_decompress_stream(str(zst_path), expected_magic=romfs_image.MAGIC)
+
+        # Case B: intact zstd frame with 32-byte DMROMFS1 header whose index offset exceeds decompressed length
+        bad_bounds_src = self.root / 'trunc_bounds.img'
+        bad_bounds_src.write_bytes(orig_img_bytes[:64])
+        build_seed._zstd_compress_stream(str(bad_bounds_src), str(zst_path), level=3)
+
+        with self.assertRaisesRegex(ValueError, 'invalid RomFS header bounds'):
+            build_seed._zstd_verify_and_decompress_stream(str(zst_path), expected_magic=romfs_image.MAGIC)
+
+        # compress_seeds must NOT trust the truncated .img.zst; it must recompress from good img_path
+        summary = build_seed.compress_seeds(seed_root)
+        self.assertEqual(summary['status'], 'completed')
+        self.assertFalse(img_path.exists())
+        dec_bytes = build_seed._zstd_verify_and_decompress_stream(
+            str(zst_path), expected_size=len(orig_img_bytes), expected_magic=romfs_image.MAGIC
+        )
+        self.assertEqual(dec_bytes, len(orig_img_bytes))
+
