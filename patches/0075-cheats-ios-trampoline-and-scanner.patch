+        self.assertEqual(by_name['ClearsR1ThenWrites'].kind, 'baked_static')
+        self.assertEqual(by_name['ClearsR1WithC1'].kind, 'baked_static')
+        self.assertEqual(by_name['AfterClearStillDirty'].kind, 'unbaked_code')
