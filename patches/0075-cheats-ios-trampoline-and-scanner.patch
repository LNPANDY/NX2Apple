+static void trampolines_apply_site(const tramp_site_t *st, uint8_t *buf) {
+    if (st->group_bytes > 1) {
+        for (int b = 0; b < st->group_bytes; b++) buf[st->group_base + b] = 0;
+    }
+    buf[st->slot_id] = st->variant_mask;
+}
