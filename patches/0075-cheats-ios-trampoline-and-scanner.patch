+"""Unit tests for dm/tools/cheat_fetch.py: multi-source aggregation, deduplication,
+{Master} ordering, user-file SHA-256 protection, atomic .cheats-fetch.json receipt
+schema, 4 MiB response cap, offline/timeout/404/malformed JSON degradation, and CLI.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+import urllib.error
+
+REPO = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPO / 'dm/tools'))
+import cheat_fetch as cf  # noqa: E402
+
+
+TID = '01006F8002326000'
+BID = '20CA968C082118C2'
+FULL_BID = '20ca968c082118c29988776655443322'
+
+
+def _make_transport(routes: dict[str, tuple[int, bytes] | Exception]):
+    calls: list[str] = []
+
+    def transport(url: str, timeout: float, max_bytes: int) -> tuple[int, bytes]:
+        calls.append(url)
+        item = routes.get(url)
+        if item is None:
+            return 404, b''
+        if isinstance(item, Exception):
+            raise item
+        status, body = item
+        return status, body[: max_bytes + 1]
+
+    return transport, calls
+
+
+class CheatFetchTests(unittest.TestCase):
+    def test_aggregates_three_sources_deduplicates_and_orders_master_first(self):
+        u1 = cf.SOURCES[0][1].format(tid=TID)
+        u2 = cf.SOURCES[1][1].format(tid=TID)
+        u3 = cf.SOURCES[2][1].format(tid=TID)
+
+        doc1 = {
+            'attribution': {'author.txt': 'some credit'},
+            BID.lower(): {
+                '[Infinite Stamina]': '[Infinite Stamina]\r\n04000000 00100000 D503201F\r\n\r\n',
+                '[Empty Entry]': '[Empty Entry]\n   \n',
+                '[Shared Name]': '[Shared Name]\n04000000 00200000 00000001\n',
+            },
+        }
+        doc2 = {
+            BID: {
+                # Duplicate title -> source 1 must win!
+                '[Shared Name]': '[Shared Name]\n04000000 00200000 00000099\n',
+                # Master code in source 2 -> must move to top of output!
+                '{Master Code}': '{Master Code}\n04000000 00001000 52800020\n',
+                'Bare Title': '04000000 00300000 00000007',
+            },
+        }
+        doc3 = {
+            BID: {
+                '[60 FPS GFX]': '[60 FPS GFX]\n04000000 00400000 00000001\n',
+            },
+        }
+        transport, calls = _make_transport({
+            u1: (200, json.dumps(doc1).encode('utf-8')),
+            u2: (200, json.dumps(doc2).encode('utf-8')),
+            u3: (200, json.dumps(doc3).encode('utf-8')),
+        })
+
+        with tempfile.TemporaryDirectory() as d:
+            cdir = Path(d) / 'cheats'
+            res = cf.fetch_cheats(
+                TID.lower(), FULL_BID, cdir, transport=transport, now_fn=lambda: 1795770000,
+            )
+            self.assertEqual(len(calls), 3)
+            self.assertEqual(res.status, 'found')
+            self.assertEqual(res.entry_count, 5)
+            self.assertEqual(
+                res.sources,
+                [
+                    'HamletDuFromage/switch-cheats-db',
+                    'HamletDuFromage/switch-cheats-db (gbatemp)',
+                    'HamletDuFromage/switch-cheats-db (gfx)',
+                ],
+            )
+
+            txt_path = cdir / f'{BID}.txt'
+            self.assertTrue(txt_path.is_file())
+            raw_bytes = txt_path.read_bytes()
+            self.assertNotIn(b'\r', raw_bytes, 'output must use LF line endings only')
+            txt = raw_bytes.decode('utf-8')
+
+            # {Master Code} must appear first, no doubled headers, first-seen [Shared Name] wins, empty skipped.
+            expected = (
+                '{Master Code}\n'
+                '04000000 00001000 52800020\n\n'
+                '[Infinite Stamina]\n'
+                '04000000 00100000 D503201F\n\n'
+                '[Shared Name]\n'
+                '04000000 00200000 00000001\n\n'
+                '[Bare Title]\n'
+                '04000000 00300000 00000007\n\n'
+                '[60 FPS GFX]\n'
+                '04000000 00400000 00000001\n'
+            )
+            self.assertEqual(txt, expected)
+            self.assertFalse((cdir / f'{BID}.enabled').exists(), 'must never write .enabled')
+
+            # Verify .cheats-fetch.json schema exact match.
+            receipt = json.loads((cdir / '.cheats-fetch.json').read_text(encoding='utf-8'))
+            self.assertEqual(
+                receipt,
+                {
+                    'schemaVersion': 1,
+                    'titleID': TID,
+                    'buildID': BID,
+                    'status': 'found',
+                    'sources': [
+                        'HamletDuFromage/switch-cheats-db',
+                        'HamletDuFromage/switch-cheats-db (gbatemp)',
+                        'HamletDuFromage/switch-cheats-db (gfx)',
+                    ],
+                    'entryCount': 5,
+                    'fetchedAt': 1795770000,
+                    'fileName': f'{BID}.txt',
+                    'fileSHA256': hashlib.sha256(raw_bytes).hexdigest().lower(),
+                    'origin': 'fetched',
+                    'detail': '',
+                },
+            )
+
+    def test_preserves_user_supplied_and_user_edited_files_across_repeated_runs(self):
+        u1 = cf.SOURCES[0][1].format(tid=TID)
+        remote_doc = {BID: {'[Remote Cheat]': '[Remote Cheat]\n04000000 00001000 00000002\n'}}
+        transport, calls = _make_transport({u1: (200, json.dumps(remote_doc).encode('utf-8'))})
+
+        with tempfile.TemporaryDirectory() as d:
+            cdir = Path(d)
+            user_txt = cdir / f'{BID}.txt'
+            user_content = '[My Custom Cheat]\n04000000 00009999 00000042\n'
+            user_txt.write_text(user_content, encoding='utf-8')
+            user_sha = hashlib.sha256(user_content.encode('utf-8')).hexdigest()
+
+            # 1. User-supplied file with no receipt -> preserved_user, never overwritten!
+            r1 = cf.fetch_cheats(TID, BID, cdir, transport=transport, now_fn=lambda: 100)
+            self.assertEqual(r1.status, 'preserved_user')
+            self.assertEqual(user_txt.read_text(encoding='utf-8'), user_content)
+            self.assertEqual(len(calls), 0, 'need not even hit network when user file is locked')
+
+            # 2. Second run against preserved_user receipt -> STILL preserved_user!
+            r2 = cf.fetch_cheats(TID, BID, cdir, transport=transport, now_fn=lambda: 200)
+            self.assertEqual(r2.status, 'preserved_user')
+            self.assertEqual(user_txt.read_text(encoding='utf-8'), user_content)
+            rec = json.loads((cdir / '.cheats-fetch.json').read_text(encoding='utf-8'))
+            self.assertEqual(rec['origin'], 'user')
+            self.assertEqual(rec['fileSHA256'], user_sha)
+
+            # 3. Explicit --force overwrites and marks origin == "fetched".
+            r3 = cf.fetch_cheats(TID, BID, cdir, transport=transport, force=True, now_fn=lambda: 300)
+            self.assertEqual(r3.status, 'found')
+            self.assertIn('[Remote Cheat]', user_txt.read_text(encoding='utf-8'))
+
+            # 4. Unmodified fetched file CAN be updated cleanly when upstream adds cheats.
+            remote_doc_v2 = {
+                BID: {
+                    '[Remote Cheat]': '[Remote Cheat]\n04000000 00001000 00000002\n',
+                    '[New Upstream Cheat]': '[New Upstream Cheat]\n04000000 00001004 00000003\n',
+                },
+            }
+            transport2, _ = _make_transport({u1: (200, json.dumps(remote_doc_v2).encode('utf-8'))})
+            r4 = cf.fetch_cheats(TID, BID, cdir, transport=transport2, now_fn=lambda: 400)
+            self.assertEqual(r4.status, 'found')
+            self.assertEqual(r4.entry_count, 2)
+
+            # 5. User edits the fetched file -> SHA-256 changes -> subsequent fetch preserves user edits!
+            edited = user_txt.read_text(encoding='utf-8') + '\n[Hand Added]\n04000000 00002000 00000001\n'
+            user_txt.write_text(edited, encoding='utf-8')
+            r5 = cf.fetch_cheats(TID, BID, cdir, transport=transport2, now_fn=lambda: 500)
+            self.assertEqual(r5.status, 'preserved_user')
+            self.assertEqual(user_txt.read_text(encoding='utf-8'), edited)
+
+    def test_degrades_silently_on_not_found_offline_oversized_and_malformed_json(self):
+        u1 = cf.SOURCES[0][1].format(tid=TID)
+        u2 = cf.SOURCES[1][1].format(tid=TID)
+        u3 = cf.SOURCES[2][1].format(tid=TID)
+
+        with tempfile.TemporaryDirectory() as d:
+            cdir = Path(d)
+
+            # A. 404 + 200 with another build ID -> status == "not_found"
+            t_nf, _ = _make_transport({
+                u1: (200, json.dumps({'AAAAAAAAAAAAAAAA': {'[X]': '[X]\n04000000 00000100 00000001\n'}}).encode()),
+                u2: (404, b''),
+                u3: (404, b''),
+            })
+            res_nf = cf.fetch_cheats(TID, BID, cdir, transport=t_nf, now_fn=lambda: 10)
+            self.assertEqual(res_nf.status, 'not_found')
+            self.assertFalse((cdir / f'{BID}.txt').exists())
+
+            # B. All sources raise URLError / TimeoutError -> status == "offline"
+            t_off, _ = _make_transport({
+                u1: urllib.error.URLError('offline'),
+                u2: TimeoutError('timed out'),
+                u3: OSError('network unreachable'),
+            })
+            res_off = cf.fetch_cheats(TID, BID, cdir, transport=t_off, now_fn=lambda: 20)
+            self.assertEqual(res_off.status, 'offline')
+            self.assertNotIn(';', res_off.detail)
+
+            # C. Malformed JSON + oversized response (> max_bytes) -> status == "error" (never raises!)
+            t_err, _ = _make_transport({
+                u1: (200, b'{broken json'),
+                u2: (200, b'x' * 2048),
+                u3: (404, b''),
+            })
+            res_err = cf.fetch_cheats(TID, BID, cdir, max_bytes=1024, transport=t_err, now_fn=lambda: 30)
+            self.assertEqual(res_err.status, 'error')
+            self.assertIn('exceeds 1024 bytes', res_err.detail)
+            self.assertNotIn(';', res_err.detail)
+
+            # D. Partial failure: source 1 malformed, source 2 succeeds -> status == "found"!
+            t_partial, _ = _make_transport({
+                u1: (200, b'not json'),
+                u2: (200, json.dumps({BID: {'[Fallback Hit]': '[Fallback Hit]\n04000000 00000100 00000001\n'}}).encode()),
+                u3: TimeoutError('slow'),
+            })
+            res_ok = cf.fetch_cheats(TID, BID, cdir, transport=t_partial, now_fn=lambda: 40)
+            self.assertEqual(res_ok.status, 'found')
+            self.assertEqual(res_ok.sources, ['HamletDuFromage/switch-cheats-db (gbatemp)'])
+            self.assertEqual(res_ok.entry_count, 1)
+
+            # E. Subsequent offline run keeps previously fetched <BID>.txt and its fetched origin/hash!
+            prev_bytes = (cdir / f'{BID}.txt').read_bytes()
+            res_off2 = cf.fetch_cheats(TID, BID, cdir, transport=t_off, now_fn=lambda: 50)
+            self.assertEqual(res_off2.status, 'offline')
+            self.assertEqual((cdir / f'{BID}.txt').read_bytes(), prev_bytes)
+            rec_off2 = json.loads((cdir / '.cheats-fetch.json').read_text(encoding='utf-8'))
+            self.assertEqual(rec_off2['origin'], 'fetched')
+            self.assertEqual(rec_off2['fileSHA256'], hashlib.sha256(prev_bytes).hexdigest())
+
+    def test_cli_entry_point_handles_existing_user_file_without_network(self):
+        with tempfile.TemporaryDirectory() as d:
+            cdir = Path(d)
+            (cdir / f'{BID}.txt').write_text('[User]\n04000000 00000100 00000001\n', encoding='utf-8')
+            r = subprocess.run(
+                [
+                    sys.executable,
+                    str(REPO / 'dm/tools/cheat_fetch.py'),
+                    '--title-id', TID,
+                    '--build-id', FULL_BID,
+                    '--cheat-dir', str(cdir),
+                    '--timeout', '1',
+                ],
+                capture_output=True,
+                text=True,
+            )
+            self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
+            self.assertIn('preserved user cheat file', r.stdout)
+            self.assertTrue((cdir / '.cheats-fetch.json').is_file())
+
+    def test_build_ipa_from_nsp_cli_flags_and_bundled_cheats_staging(self):
+        import importlib.util
+        spec = importlib.util.spec_from_file_location('build_ipa_from_nsp', REPO / 'scripts/build_ipa_from_nsp.py')
+        assert spec and spec.loader
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+
+        # Default --fetch-cheats is False; --fetch-cheats / --no-fetch-cheats toggle cleanly.
+        a_def = mod.parse_args([])
+        self.assertFalse(a_def.fetch_cheats)
+        a_on = mod.parse_args(['--fetch-cheats', '--cheat-dir', '/tmp/custom-cheats'])
+        self.assertTrue(a_on.fetch_cheats)
+        a_off = mod.parse_args(['--fetch-cheats', '--no-fetch-cheats'])
+        self.assertFalse(a_off.fetch_cheats)
+
+        with tempfile.TemporaryDirectory() as d:
+            root = Path(d)
+            out_patched = root / 'patched_v0'
+            out_patched.mkdir()
+            cdir = root / 'cheats_src'
+            cdir.mkdir()
+            cheat_file = cdir / f'{BID.lower()}.txt'
+            cheat_file.write_text('[Test]\n04000000 00001000 00000001\n', encoding='utf-8')
+            good_receipt = {'schemaVersion': 1, 'titleID': TID, 'buildID': BID, 'status': 'found'}
+            (cdir / '.cheats-fetch.json').write_text(json.dumps(good_receipt), encoding='utf-8')
+
+            # Stages canonical uppercase <BID>.txt and matching .cheats-fetch.json into $PATCHED/cheats/
+            mod._stage_bundled_cheats(out_patched, FULL_BID, cheat_file, cdir)
+            self.assertTrue((out_patched / 'cheats' / f'{BID}.txt').is_file())
+            self.assertTrue((out_patched / 'cheats' / '.cheats-fetch.json').is_file())
+
+            # Mismatched buildID in .cheats-fetch.json must NOT be staged (anti-cross-build guard).
+            bad_receipt = {'schemaVersion': 1, 'titleID': TID, 'buildID': 'DEADBEEFDEADBEEF', 'status': 'found'}
+            (cdir / '.cheats-fetch.json').write_text(json.dumps(bad_receipt), encoding='utf-8')
+            mod._stage_bundled_cheats(out_patched, FULL_BID, cheat_file, cdir)
+            self.assertTrue((out_patched / 'cheats' / f'{BID}.txt').is_file())
+            self.assertFalse((out_patched / 'cheats' / '.cheats-fetch.json').exists())
+
+            # Removing both cheat_file and matching receipt cleans up stale $PATCHED/cheats/
+            mod._stage_bundled_cheats(out_patched, FULL_BID, None, cdir)
+            self.assertFalse((out_patched / 'cheats').exists())
+
+
+if __name__ == '__main__':
+    unittest.main()
