 dm/host/front.h                   |   26 +
 dm/host/hle_cheats.c              |  886 ++++++++++++++++-
 dm/host/loader.c                  |    8 +
 dm/host/tests/t_cheats.c          |  212 +++-
 dm/ios/tools/build_ipa.sh         |    1 +
 dm/tools/cheat_bake.py            | 1534 +++++++++++++++++++++++++++++
 dm/tools/patch_nso.py             |   89 +-
 dm/tools/tests/test_cheat_bake.py |  587 +++++++++++
 dm/tools/tests/test_ipa_tables.py |   10 +
 scripts/build_ipa_from_nsp.py     |   32 +-
 11 files changed, 3390 insertions(+), 23 deletions(-)
 create mode 100644 dm/tools/cheat_bake.py
 create mode 100644 dm/tools/tests/test_cheat_bake.py

