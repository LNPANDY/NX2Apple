+static const tramp_site_t *trampolines_find_site(const char *ckey, uint64_t off, uint32_t word) {
+    const tramp_site_t *fallback = NULL;
+    for (int i = 0; i < g_ntramp_sites; i++) {
+        const tramp_site_t *st = &g_tramp_sites[i];
+        if (st->target_off != off || st->patched_word != word) continue;
+        if (!strcmp(st->cheat_key, ckey)) return st;
+        if (!fallback) fallback = st;
+    }
+    return fallback;
+}
+
+static const tramp_site_t *trampolines_find_any_at_off(uint64_t off) {
+    for (int i = 0; i < g_ntramp_sites; i++) {
+        if (g_tramp_sites[i].target_off == off) return &g_tramp_sites[i];
+    }
+    return NULL;
+}
+
+static const tramp_cave_t *trampolines_find_cave(uint64_t off, uint32_t word) {
+    for (int i = 0; i < g_ntramp_caves; i++) {
+        if (g_tramp_caves[i].target_off == off && g_tramp_caves[i].word == word) return &g_tramp_caves[i];
+    }
+    return NULL;
+}
+
+static const tramp_cave_t *trampolines_find_cave_any(uint64_t off) {
+    for (int i = 0; i < g_ntramp_caves; i++) {
+        if (g_tramp_caves[i].target_off == off) return &g_tramp_caves[i];
+    }
+    return NULL;
+}
