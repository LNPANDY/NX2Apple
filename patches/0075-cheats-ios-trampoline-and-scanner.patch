diff --git a/dm/host/hle_cheats.c b/dm/host/hle_cheats.c
index 26199b3..9a00d4e 100644
--- a/dm/host/hle_cheats.c
+++ b/dm/host/hle_cheats.c
@@ -69,6 +69,7 @@
 #include <stdarg.h>
 #include <stdatomic.h>
 #include <ctype.h>
+#include <math.h>
 
 // Limits of Atmosphère's own order (0x2000 dwords of program, 256 cheats per file): no shared cheat-site file and no
 // hand-made one can exhaust the arrays
@@ -122,6 +123,8 @@ typedef struct {
     double vmin, vmax; uint8_t has_min, has_max;   // the meta ask bounds
     uint8_t nd_region; uint64_t nd_off;            // never-decrease: region 0 main / 1 heap, offset in it
     uint8_t nd_have; uint64_t nd_max;              // never-decrease: the highest value seen since it was turned on
+    uint8_t baked_kind;                            // DM_CHEAT_BAKED_*: status from dm/cheat_trampolines.tsv
+    uint64_t key_mask;                             // union of Opcode 8 / C4 key masks in this entry
 } cheat_t;
 
 static cheat_t g_cheat[CHEAT_MAX]; static int g_ncheat;
@@ -580,6 +583,526 @@ static int changed_hit(uint64_t off, uint64_t len) {
 // Data is written through the alias too when there is one, else directly (those pages are read + write). The checks
 // run in a dry run too (main_write_check, before the description), so the preview says the write would stop the cheat
 static uint64_t main_rx_end(void) { static long pg; if (!pg) pg = getpagesize(); return (g_main_mod->text_end + pg - 1) & ~(uint64_t)(pg - 1); }
+
+// ---------- Baked iOS trampolines (cheat_state_page) and Mac original_code restore ----------
+#define TRAMP_SLOT_MAX 4096
+#define TRAMP_MIRROR_OFF 0x1000u
+#define TRAMP_MIRROR_END 0x4000u
+
+typedef struct {
+    char cheat_key[NAME_MAX + 16];
+    uint64_t target_off;
+    uint32_t patched_word;
+    uint32_t orig_word;
+    uint16_t slot_id;
+    uint16_t group_base;
+    uint8_t group_bytes;
+    uint8_t variant_mask;
+    uint8_t conditional;
+    uint8_t has_orig_word;
+} tramp_site_t;
+
+typedef struct {
+    uint64_t orig_off;
+    uint32_t mirror_off;
+    uint32_t size;
+    uint8_t *init_bytes;
+} tramp_mirror_t;
+
+typedef struct {
+    uint64_t target_off;
+    uint32_t word;
+    uint32_t orig_word;
+    uint8_t has_orig_word;
+} tramp_cave_t;
+
+static tramp_site_t *g_tramp_sites;
+static int g_ntramp_sites, g_tramp_sites_cap;
+static tramp_mirror_t *g_tramp_mirrors;
+static int g_ntramp_mirrors, g_tramp_mirrors_cap;
+static tramp_cave_t *g_tramp_caves;
+static int g_ntramp_caves, g_tramp_caves_cap;
+static int g_tramp_slots_used;
+static _Atomic uint8_t *g_cheat_state;   // main->base + main->cheat_state_off (16 KB RW), or NULL
+static uint8_t g_slot_cur[TRAMP_SLOT_MAX];
+static uint8_t g_slot_next[TRAMP_SLOT_MAX];
+
+// Lock order when acquiring both mutexes: always g_scan_lock before g_lock.
+#define DM_SCAN_CAP 65536u
+static pthread_mutex_t g_scan_lock = PTHREAD_MUTEX_INITIALIZER;
+static dm_scan_hit_t *g_scan_hits;
+static size_t g_scan_n, g_scan_cap;
+static int g_scan_type;
+
+typedef struct { uint64_t off; uint8_t orig; } orig_code_byte_t;
+typedef struct { int cheat_idx; uint64_t off; uint32_t len; } cheat_code_span_t;
+static orig_code_byte_t *g_orig_bytes;
+static int g_norig_bytes, g_orig_bytes_cap;
+static cheat_code_span_t *g_code_spans;
+static int g_ncode_spans, g_code_spans_cap;
+static uint64_t g_icache_flushes;
+
+static void cheat_key(const cheat_t *c, char *out, size_t n);
+static int tsv_split(char *line, char **f, int max);
+
+static void orig_code_snapshot(uint64_t off, uint8_t byte) {
+    for (int i = 0; i < g_norig_bytes; i++) if (g_orig_bytes[i].off == off) return;
+    if (g_norig_bytes == g_orig_bytes_cap) {
+        int ncap = g_orig_bytes_cap ? g_orig_bytes_cap * 2 : 256;
+        orig_code_byte_t *grown = realloc(g_orig_bytes, (size_t)ncap * sizeof *grown);
+        if (!grown) return;
+        g_orig_bytes = grown; g_orig_bytes_cap = ncap;
+    }
+    g_orig_bytes[g_norig_bytes].off = off;
+    g_orig_bytes[g_norig_bytes].orig = byte;
+    g_norig_bytes++;
+}
+
+static int orig_code_lookup(uint64_t off, uint8_t *out) {
+    for (int i = 0; i < g_norig_bytes; i++) {
+        if (g_orig_bytes[i].off == off) { *out = g_orig_bytes[i].orig; return 1; }
+    }
+    return 0;
+}
+
+static void code_span_record(int cheat_idx, uint64_t off, uint32_t len) {
+    for (int i = 0; i < g_ncode_spans; i++) {
+        if (g_code_spans[i].cheat_idx == cheat_idx && g_code_spans[i].off == off && g_code_spans[i].len == len) return;
+    }
+    if (g_ncode_spans == g_code_spans_cap) {
+        int ncap = g_code_spans_cap ? g_code_spans_cap * 2 : 128;
+        cheat_code_span_t *grown = realloc(g_code_spans, (size_t)ncap * sizeof *grown);
+        if (!grown) return;
+        g_code_spans = grown; g_code_spans_cap = ncap;
+    }
+    g_code_spans[g_ncode_spans].cheat_idx = cheat_idx;
+    g_code_spans[g_ncode_spans].off = off;
+    g_code_spans[g_ncode_spans].len = len;
+    g_ncode_spans++;
+}
+
+static int code_byte_claimed_by_other(int skip_idx, uint64_t off) {
+    for (int i = 0; i < g_ncode_spans; i++) {
+        int idx = g_code_spans[i].cheat_idx;
+        if (idx == skip_idx || idx < 0 || idx >= g_ncheat) continue;
+        const cheat_t *o = &g_cheat[idx];
+        if (o->broken || o->dead || o->label || !(o->on || (o->master && !g_safe))) continue;
+        if (off >= g_code_spans[i].off && off - g_code_spans[i].off < g_code_spans[i].len) return 1;
+    }
+    return 0;
+}
+
+// Restore Mac .text bytes written by cheat_idx (non-paired code cheats) when disabled or reloaded.
+static void orig_code_restore_cheat(int cheat_idx) {
+    if (!g_main_mod || !g_alias) return;
+    uint64_t flush_lo = UINT64_MAX, flush_hi = 0;
+    for (int i = 0; i < g_ncode_spans; i++) {
+        if (g_code_spans[i].cheat_idx != cheat_idx) continue;
+        uint64_t base_off = g_code_spans[i].off;
+        uint32_t len = g_code_spans[i].len;
+        for (uint32_t k = 0; k < len; k++) {
+            uint64_t off = base_off + k;
+            if (off >= main_rx_end() || code_byte_claimed_by_other(cheat_idx, off)) continue;
+            uint8_t orig = 0;
+            if (!orig_code_lookup(off, &orig)) continue;
+            if (g_alias[off] != orig) {
+                dm_guest_write_prepare(g_main_mod->base + off, 1);
+                g_alias[off] = orig;
+                if (off < flush_lo) flush_lo = off;
+                if (off + 1 > flush_hi) flush_hi = off + 1;
+            }
+        }
+    }
+    if (flush_hi > flush_lo) {
+        sys_icache_invalidate(g_main_mod->base + flush_lo, (size_t)(flush_hi - flush_lo));
+        g_icache_flushes++;
+    }
+    int kept = 0;
+    for (int i = 0; i < g_ncode_spans; i++) {
+        if (g_code_spans[i].cheat_idx != cheat_idx) g_code_spans[kept++] = g_code_spans[i];
+    }
+    g_ncode_spans = kept;
+}
+
+static void orig_code_restore_all(void) {
+    if (!g_main_mod || !g_alias) { g_ncode_spans = 0; return; }
+    uint64_t flush_lo = UINT64_MAX, flush_hi = 0;
+    for (int i = 0; i < g_norig_bytes; i++) {
+        uint64_t off = g_orig_bytes[i].off;
+        if (off < main_rx_end() && g_alias[off] != g_orig_bytes[i].orig) {
+            dm_guest_write_prepare(g_main_mod->base + off, 1);
+            g_alias[off] = g_orig_bytes[i].orig;
+            if (off < flush_lo) flush_lo = off;
+            if (off + 1 > flush_hi) flush_hi = off + 1;
+        }
+    }
+    if (flush_hi > flush_lo) {
+        sys_icache_invalidate(g_main_mod->base + flush_lo, (size_t)(flush_hi - flush_lo));
+        g_icache_flushes++;
+    }
+    g_ncode_spans = 0;
+}
+
+static void trampolines_commit(void) {
+    if (!g_cheat_state || g_alias) return;
+    int lim = g_tramp_slots_used < TRAMP_SLOT_MAX ? g_tramp_slots_used : TRAMP_SLOT_MAX;
+    for (int s = 0; s < lim; s++) {
+        if (g_slot_next[s] != g_slot_cur[s]) {
+            atomic_store_explicit(&g_cheat_state[s], g_slot_next[s], memory_order_release);
+            g_slot_cur[s] = g_slot_next[s];
+        }
+    }
+}
+
+static void trampolines_clear(void) {
+    if (g_cheat_state && !g_alias) {
+        memset(g_slot_next, 0, sizeof g_slot_next);
+        trampolines_commit();
+    }
+    for (int i = 0; i < g_ntramp_mirrors; i++) free(g_tramp_mirrors[i].init_bytes);
+    g_ntramp_sites = 0;
+    g_ntramp_mirrors = 0;
+    g_ntramp_caves = 0;
+    g_tramp_slots_used = 0;
+    memset(g_slot_cur, 0, sizeof g_slot_cur);
+    memset(g_slot_next, 0, sizeof g_slot_next);
+}
+
+static int hex_nibble(char ch) {
+    if (ch >= '0' && ch <= '9') return ch - '0';
+    if (ch >= 'a' && ch <= 'f') return 10 + (ch - 'a');
+    if (ch >= 'A' && ch <= 'F') return 10 + (ch - 'A');
+    return -1;
+}
+
+static void trampolines_bind_state_page(void) {
+    g_cheat_state = NULL;
+    if (!g_main_mod || !g_main_mod->base || !g_main_mod->cheat_state_off) return;
+    uint64_t off = g_main_mod->cheat_state_off;
+    if ((off & 0x3FFFull) || g_main_mod->size < 0x4000 || off > g_main_mod->size - 0x4000) return;
+    if (g_main_mod->key_page_off > g_main_mod->size || g_main_mod->key_page_size > g_main_mod->size - g_main_mod->key_page_off) return;
+    if (off < g_main_mod->key_page_off + g_main_mod->key_page_size) return;
+    g_cheat_state = (_Atomic uint8_t *)(g_main_mod->base + off);
+}
+
+static int parse_detail_orig_word(const char *detail, uint32_t *out_word) {
+    const char *op = strstr(detail, "orig=");
+    if (!op) return 0;
+    char *ep = NULL;
+    unsigned long ow = strtoul(op + 5, &ep, 0);
+    if (ep == op + 5) return 0;
+    *out_word = (uint32_t)ow;
+    return 1;
+}
+
+static void trampolines_load(void) {
+    trampolines_clear();
+    trampolines_bind_state_page();
+    if (!g_main_mod) return;
+    const char *mdir = dm_module_dir();
+    if (!mdir || !mdir[0]) return;
+    char p[1100]; snprintf(p, sizeof p, "%s/cheat_trampolines.tsv", mdir);
+    FILE *f = fopen(p, "r");
+    if (!f) return;
+    char line[2048], bid[40] = "";
+    int header_seen = 0;
+    while (fgets(line, sizeof line, f)) {   // NOLINT(clang-analyzer-unix.BlockInCriticalSection): file load under g_lock; passes trylock
+        if (line[0] == '#') {
+            if (sscanf(line, "# BUILD_ID %39s", bid) == 1) continue;
+            continue;
+        }
+        char *fld[16]; int nf = tsv_split(line, fld, 16);
+        if (!header_seen) { header_seen = 1; continue; }
+        if (bid[0] && g_build[0] && strncasecmp(bid, g_build, 16) != 0) break;
+        if (nf < 9) continue;
+        const char *rtype = fld[0], *ckey = fld[2], *kind = fld[3], *detail = nf >= 10 ? fld[9] : "";
+        long slot_id = strtol(fld[4], NULL, 0);
+        unsigned long vmask = strtoul(fld[5], NULL, 0);
+        uint64_t toff = strtoull(fld[6], NULL, 0);
+        uint64_t pword = strtoull(fld[7], NULL, 0);
+        uint64_t kmask = strtoull(fld[8], NULL, 0);
+        uint8_t bkind = !strcmp(kind, "baked_static") ? DM_CHEAT_BAKED_STATIC
+                      : !strcmp(kind, "baked_conditional") ? DM_CHEAT_BAKED_CONDITIONAL
+                      : !strcmp(kind, "unbaked_code") ? DM_CHEAT_BAKED_UNBAKED : DM_CHEAT_BAKED_NONE;
+        if (!strcmp(rtype, "entry")) {
+            for (int i = 0; i < g_ncheat; i++) {
+                char k[NAME_MAX + 16]; cheat_key(&g_cheat[i], k, sizeof k);
+                if (!strcmp(k, ckey)) {
+                    g_cheat[i].baked_kind = bkind;
+                    if (kmask) g_cheat[i].key_mask |= kmask;
+                    break;
+                }
+            }
+        } else if (!strcmp(rtype, "site")) {
+            if (slot_id < 0 || slot_id >= TRAMP_SLOT_MAX || vmask == 0 || vmask > 0xFF) continue;
+            if (g_ntramp_sites == g_tramp_sites_cap) {
+                int ncap = g_tramp_sites_cap ? g_tramp_sites_cap * 2 : 128;
+                tramp_site_t *grown = realloc(g_tramp_sites, (size_t)ncap * sizeof *grown);
+                if (!grown) break;
+                g_tramp_sites = grown; g_tramp_sites_cap = ncap;
+            }
+            tramp_site_t *st = &g_tramp_sites[g_ntramp_sites++];
+            memset(st, 0, sizeof *st);
+            snprintf(st->cheat_key, sizeof st->cheat_key, "%s", ckey);
+            st->target_off = toff;
+            st->patched_word = (uint32_t)pword;
+            st->slot_id = (uint16_t)slot_id;
+            st->variant_mask = (uint8_t)vmask;
+            st->conditional = (uint8_t)(bkind == DM_CHEAT_BAKED_CONDITIONAL);
+            st->group_base = (uint16_t)slot_id;
+            st->group_bytes = 1;
+            uint32_t ow = 0;
+            if (parse_detail_orig_word(detail, &ow)) {
+                st->orig_word = ow;
+                st->has_orig_word = 1;
+            }
+            unsigned gb = 0, gn = 0;
+            const char *gp = strstr(detail, "group=");
+            if (gp && sscanf(gp, "group=%u:%u", &gb, &gn) == 2 && gn >= 1 && gn <= 4 && gb <= TRAMP_SLOT_MAX && gn <= TRAMP_SLOT_MAX - gb) {
+                st->group_base = (uint16_t)gb;
+                st->group_bytes = (uint8_t)gn;
+            }
