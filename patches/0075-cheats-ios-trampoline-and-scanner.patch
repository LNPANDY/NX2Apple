+#!/usr/bin/env python3
+"""Zero-dependency public Switch cheat fetcher for Atmosphère <BID>.txt files.
+
+Queries static JSON mirrors from HamletDuFromage/switch-cheats-db by 16-hex
+(title_id, build_id), merges entries in source priority order with {Master}
+codes placed first, protects user-supplied or user-edited <BID>.txt files via
+SHA-256 verification against .cheats-fetch.json, and degrades silently on
+offline, timeout, HTTP 404, oversized, or malformed responses so builds never
+fail on network issues.
+"""
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass, field
+import hashlib
+import http.client
+import json
+import os
+from pathlib import Path
+import re
+import sys
+import tempfile
+import time
+from typing import Callable
+import urllib.error
+import urllib.request
+
+SCHEMA_VERSION = 1
+RECEIPT_FILENAME = '.cheats-fetch.json'
+DEFAULT_TIMEOUT = 5.0
+MAX_RESPONSE_BYTES = 4 * 1024 * 1024  # 4 MiB hard cap per source response
+USER_AGENT = 'NX2Apple-CheatFetch/1.0'
+
+SOURCES: tuple[tuple[str, str], ...] = (
+    (
+        'HamletDuFromage/switch-cheats-db',
+        'https://raw.githubusercontent.com/HamletDuFromage/switch-cheats-db/master/cheats/{tid}.json',
+    ),
+    (
+        'HamletDuFromage/switch-cheats-db (gbatemp)',
+        'https://raw.githubusercontent.com/HamletDuFromage/switch-cheats-db/master/cheats_gbatemp/{tid}.json',
+    ),
+    (
+        'HamletDuFromage/switch-cheats-db (gfx)',
+        'https://raw.githubusercontent.com/HamletDuFromage/switch-cheats-db/master/cheats_gfx/{tid}.json',
+    ),
+)
+
+_HEX16_RE = re.compile(r'^[0-9A-F]{16}$')
+_HEX_ALL_RE = re.compile(r'^[0-9A-Fa-f]+$')
+
+# Transport callable signature: (url, timeout_sec, max_bytes) -> (http_status, body_bytes)
+TransportFn = Callable[[str, float, int], tuple[int, bytes]]
+
+
+@dataclass
+class FetchResult:
+    schema_version: int = SCHEMA_VERSION
+    title_id: str = ''
+    build_id: str = ''
+    status: str = 'error'  # found | not_found | preserved_user | offline | error
+    sources: list[str] = field(default_factory=list)
+    entry_count: int = 0
+    fetched_at: int = 0
+    file_name: str = ''
+    file_sha256: str = ''
+    origin: str = 'fetched'
+    detail: str = ''
+    file_path: Path | None = None
+    receipt_path: Path | None = None
+
+    def to_receipt_dict(self) -> dict[str, object]:
+        return {
+            'schemaVersion': self.schema_version,
+            'titleID': self.title_id,
+            'buildID': self.build_id,
+            'status': self.status,
+            'sources': list(self.sources),
+            'entryCount': self.entry_count,
+            'fetchedAt': self.fetched_at,
+            'fileName': self.file_name,
+            'fileSHA256': self.file_sha256,
+            'origin': self.origin,
+            'detail': _sanitize_detail(self.detail),
+        }
+
+
+def _sanitize_detail(text: str) -> str:
+    # Keep details single-line and free of ASCII semicolons per repository text rules.
+    return ' '.join(text.replace(';', ',').split())
+
+
+def normalize_ids(title_id: str, build_id: str) -> tuple[str, str] | None:
+    tid_raw = (title_id or '').strip()
+    if tid_raw.lower().startswith('0x'):
+        tid_raw = tid_raw[2:]
+    tid = tid_raw.upper()
+    if not _HEX16_RE.fullmatch(tid):
+        return None
+
+    bid_raw = (build_id or '').strip()
+    if bid_raw.lower().startswith('0x'):
+        bid_raw = bid_raw[2:]
+    if len(bid_raw) < 16 or not _HEX_ALL_RE.fullmatch(bid_raw[:16]):
+        return None
+    bid = bid_raw[:16].upper()
+    return tid, bid
+
+
+def _sha256_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest().lower()
+
+
+def _sha256_file(path: Path) -> str | None:
+    try:
+        h = hashlib.sha256()
+        with open(path, 'rb') as f:
+            while True:
+                chunk = f.read(65536)
+                if not chunk:
+                    break
+                h.update(chunk)
+        return h.hexdigest().lower()
+    except OSError:
+        return None
+
+
+def _atomic_write_bytes(dest: Path, payload: bytes) -> None:
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp_name = tempfile.mkstemp(prefix=f'.{dest.name}.tmp.', dir=str(dest.parent))
+    tmp_path = Path(tmp_name)
+    try:
+        with os.fdopen(fd, 'wb') as f:
+            f.write(payload)
+            f.flush()
+        os.replace(tmp_path, dest)
+    except BaseException:
+        try:
+            tmp_path.unlink(missing_ok=True)
+        except OSError:
+            pass
+        raise
+
+
+def _read_receipt(receipt_path: Path) -> dict[str, object] | None:
+    if not receipt_path.is_file():
+        return None
+    try:
+        raw = receipt_path.read_bytes()
+        if len(raw) > 256 * 1024:
+            return None
+        parsed = json.loads(raw.decode('utf-8'))
+        return parsed if isinstance(parsed, dict) else None
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError):
+        return None
+
+
+def _write_receipt(receipt_path: Path, result: FetchResult) -> None:
+    payload = (json.dumps(result.to_receipt_dict(), indent=2) + '\n').encode('utf-8')
+    _atomic_write_bytes(receipt_path, payload)
+
+
+def _find_existing_cheat_file(cheat_dir: Path, bid: str) -> Path | None:
+    exact = cheat_dir / f'{bid}.txt'
+    if exact.is_file():
+        return exact
+    if not cheat_dir.is_dir():
+        return None
+    want = f'{bid.lower()}.txt'
+    try:
+        for item in sorted(cheat_dir.iterdir()):
+            if item.is_file() and item.name.lower() == want:
+                return item
+    except OSError:
+        return None
+    return None
+
+
+def _can_overwrite_existing(
+    existing_file: Path,
+    actual_sha: str | None,
+    receipt: dict[str, object] | None,
+    bid: str,
+    force: bool,
+) -> bool:
+    if force:
+        return True
+    if not actual_sha or not isinstance(receipt, dict):
+        return False
+    if receipt.get('origin') != 'fetched':
+        return False
+    rec_sha = str(receipt.get('fileSHA256') or '').strip().lower()
+    if not rec_sha or rec_sha != actual_sha:
+        return False
+    rec_bid = str(receipt.get('buildID') or '').strip().upper()
+    if rec_bid and rec_bid != bid:
+        return False
+    rec_name = str(receipt.get('fileName') or '').strip()
+    if rec_name and rec_name.lower() != existing_file.name.lower():
+        return False
+    return True
+
+
+def _default_transport(url: str, timeout: float, max_bytes: int) -> tuple[int, bytes]:
+    req = urllib.request.Request(url, headers={'User-Agent': USER_AGENT})
+    try:
+        with urllib.request.urlopen(req, timeout=timeout) as resp:
+            status = getattr(resp, 'status', None) or resp.getcode() or 200
+            data = resp.read(max_bytes + 1)
+            return int(status), data
+    except urllib.error.HTTPError as exc:
+        try:
+            exc.close()
+        except Exception:
+            pass
+        return int(exc.code), b''
+
+
+def _normalize_entry(raw_key: str, raw_val: str) -> tuple[str, bool, str] | None:
+    """Normalize one JSON cheat entry into (dedup_header, is_master, formatted_block)."""
+    if not isinstance(raw_key, str) or not isinstance(raw_val, str):
+        return None
+    key_s = raw_key.strip()
+    val_s = raw_val.replace('\r\n', '\n').replace('\r', '\n').strip()
+    if not val_s:
+        return None
+
+    if len(key_s) >= 3 and (
+        (key_s.startswith('[') and key_s.endswith(']'))
+        or (key_s.startswith('{') and key_s.endswith('}'))
+    ):
+        hdr = key_s
+    elif key_s:
+        hdr = f'[{key_s}]'
+    else:
+        hdr = ''
+
+    first_line, _, rest = val_s.partition('\n')
+    fl = first_line.strip()
+    if fl and fl[0] in ('[', '{'):
+        end_ch = ']' if fl[0] == '[' else '}'
+        q = fl.find(end_ch, 1)
+        if q > 1:
+            fl_hdr = fl[:q + 1]
+            inline_tail = fl[q + 1:].strip()
+            key_inner = key_s[1:-1].strip() if len(key_s) >= 2 and key_s[0] in '[{' and key_s[-1] in ']}' else key_s
+            fl_inner = fl_hdr[1:-1].strip()
+            if not hdr or fl_hdr.lower() == hdr.lower() or fl_inner.lower() == key_inner.lower():
+                final_hdr = fl_hdr if fl_hdr.startswith('{') or not hdr else hdr
+                if hdr.startswith('{') and hdr.endswith('}'):
+                    final_hdr = hdr
+                body_parts: list[str] = []
+                if inline_tail:
+                    body_parts.append(inline_tail)
+                if rest.strip():
+                    body_parts.append('\n'.join(ln.rstrip() for ln in rest.splitlines()).strip())
+                body = '\n'.join(body_parts).strip()
+                if not body:
+                    return None
+                is_master = final_hdr.startswith('{') and final_hdr.endswith('}')
+                return final_hdr, is_master, f'{final_hdr}\n{body}'
+
+    if not hdr:
+        return None
+    body = '\n'.join(ln.rstrip() for ln in val_s.splitlines()).strip()
+    if not body:
+        return None
+    is_master = hdr.startswith('{') and hdr.endswith('}')
+    return hdr, is_master, f'{hdr}\n{body}'
+
+
+def _extract_bid_entries(doc: dict[str, object], bid: str) -> list[dict[str, object]]:
+    """Return matching build-ID entry dicts from a top-level cheat JSON object."""
+    exact_matches: list[dict[str, object]] = []
+    prefix_matches: list[dict[str, object]] = []
+    for k, v in doc.items():
+        if not isinstance(k, str) or not isinstance(v, dict):
+            continue
+        ks = k.strip()
+        if ks.lower() == 'attribution':
+            continue
+        if len(ks) == 16 and ks.upper() == bid:
+            exact_matches.append(v)
+        elif len(ks) > 16 and _HEX_ALL_RE.fullmatch(ks) and ks[:16].upper() == bid:
+            prefix_matches.append(v)
+    return exact_matches + prefix_matches
+
+
+def merge_cheat_sources(
+    source_docs: list[tuple[str, dict[str, object]]],
+    bid: str,
+) -> tuple[str, int, list[str]]:
+    """Merge parsed JSON dicts in source order for `bid`.
+
+    Returns (formatted_txt, entry_count, contributing_sources).
+    """
+    seen_headers: set[str] = set()
+    masters: list[str] = []
+    normals: list[str] = []
+    used_sources: list[str] = []
+
+    for source_name, doc in source_docs:
+        bid_dicts = _extract_bid_entries(doc, bid)
+        if not bid_dicts:
+            continue
+        source_had_valid = False
+        for entries_map in bid_dicts:
+            for raw_title, raw_body in entries_map.items():
+                norm = _normalize_entry(raw_title, raw_body)  # type: ignore[arg-type]
+                if norm is None:
+                    continue
+                source_had_valid = True
+                hdr, is_master, block = norm
+                if hdr in seen_headers:
+                    continue
+                seen_headers.add(hdr)
+                if is_master:
+                    masters.append(block)
+                else:
+                    normals.append(block)
+        if source_had_valid and source_name not in used_sources:
+            used_sources.append(source_name)
+
+    ordered = masters + normals
+    if not ordered:
+        return '', 0, []
+    return '\n\n'.join(ordered) + '\n', len(ordered), used_sources
+
+
+def fetch_cheats(
+    title_id: str,
+    build_id: str,
+    cheat_dir: str | os.PathLike[str],
+    *,
+    timeout: float = DEFAULT_TIMEOUT,
+    force: bool = False,
+    max_bytes: int = MAX_RESPONSE_BYTES,
+    transport: TransportFn | None = None,
+    now_fn: Callable[[], int] | None = None,
+) -> FetchResult:
+    """Fetch and atomically persist <BID>.txt + .cheats-fetch.json without raising."""
+    now_ts = int(now_fn() if now_fn is not None else time.time())
+    norm = normalize_ids(title_id, build_id)
+    if norm is None:
+        return FetchResult(
+            title_id=(title_id or '').strip().upper()[:16],
+            build_id=(build_id or '').strip().upper()[:16],
+            status='error',
+            fetched_at=now_ts,
+            detail='invalid title_id or build_id (expected 16 hex digits)',
+        )
+    tid, bid = norm
+
+    try:
+        cdir = Path(cheat_dir)
+        receipt_path = cdir / RECEIPT_FILENAME
+        prev_receipt = _read_receipt(receipt_path)
+        existing_file = _find_existing_cheat_file(cdir, bid)
+        existing_sha = _sha256_file(existing_file) if existing_file is not None else None
+
+        if existing_file is not None and not _can_overwrite_existing(
+            existing_file, existing_sha, prev_receipt, bid, force
+        ):
+            res = FetchResult(
+                title_id=tid,
+                build_id=bid,
+                status='preserved_user',
+                sources=[],
+                entry_count=0,
+                fetched_at=now_ts,
+                file_name=existing_file.name,
+                file_sha256=existing_sha or '',
+                origin='user',
+                detail='existing cheat file preserved',
+                file_path=existing_file,
+                receipt_path=receipt_path,
+            )
+            _write_receipt(receipt_path, res)
+            return res
+
+        fetch_fn = transport or _default_transport
+        eff_timeout = timeout if timeout > 0 else DEFAULT_TIMEOUT
+        source_docs: list[tuple[str, dict[str, object]]] = []
+        reachable_count = 0
+        network_errors: list[str] = []
+        data_errors: list[str] = []
+
+        for source_name, url_tmpl in SOURCES:
+            url = url_tmpl.format(tid=tid)
+            try:
+                status_code, raw_bytes = fetch_fn(url, eff_timeout, max_bytes)
+            except (urllib.error.URLError, TimeoutError, http.client.HTTPException, OSError, ValueError) as exc:
+                network_errors.append(f'{source_name}: {exc}')
+                continue
+            except Exception as exc:  # Defensive catch-all so builds never abort
+                data_errors.append(f'{source_name}: {exc}')
+                continue
+
+            if status_code == 404:
+                reachable_count += 1
+                continue
+            if status_code != 200:
+                reachable_count += 1
+                data_errors.append(f'{source_name}: HTTP {status_code}')
+                continue
+            reachable_count += 1
+            if len(raw_bytes) > max_bytes:
+                data_errors.append(f'{source_name}: response exceeds {max_bytes} bytes')
+                continue
+            try:
+                parsed = json.loads(raw_bytes.decode('utf-8'))
+            except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:
+                data_errors.append(f'{source_name}: invalid JSON ({exc})')
+                continue
+            if not isinstance(parsed, dict):
+                data_errors.append(f'{source_name}: top-level JSON is not an object')
+                continue
+            source_docs.append((source_name, parsed))
+
+        # Re-check existing file after network wait to guard against concurrent user edits.
+        latest_receipt = _read_receipt(receipt_path) or prev_receipt
+        latest_existing = _find_existing_cheat_file(cdir, bid)
+        latest_sha = _sha256_file(latest_existing) if latest_existing is not None else None
+        if latest_existing is not None and not _can_overwrite_existing(
+            latest_existing, latest_sha, latest_receipt, bid, force
+        ):
+            res = FetchResult(
+                title_id=tid,
+                build_id=bid,
+                status='preserved_user',
+                sources=[],
+                entry_count=0,
+                fetched_at=int(now_fn() if now_fn is not None else time.time()),
+                file_name=latest_existing.name,
+                file_sha256=latest_sha or '',
+                origin='user',
+                detail='existing cheat file preserved',
+                file_path=latest_existing,
+                receipt_path=receipt_path,
+            )
+            _write_receipt(receipt_path, res)
+            return res
+
+        merged_text, entry_count, used_sources = merge_cheat_sources(source_docs, bid)
+        done_ts = int(now_fn() if now_fn is not None else time.time())
+
+        if entry_count > 0:
+            out_bytes = merged_text.encode('utf-8')
+            out_sha = _sha256_bytes(out_bytes)
+            canonical_path = cdir / f'{bid}.txt'
+            _atomic_write_bytes(canonical_path, out_bytes)
+            if latest_existing is not None and latest_existing.name != canonical_path.name:
+                try:
+                    if not os.path.samefile(latest_existing, canonical_path):
+                        latest_existing.unlink(missing_ok=True)
+                except OSError:
+                    pass
+            res = FetchResult(
+                title_id=tid,
+                build_id=bid,
+                status='found',
+                sources=used_sources,
+                entry_count=entry_count,
+                fetched_at=done_ts,
+                file_name=canonical_path.name,
+                file_sha256=out_sha,
+                origin='fetched',
+                detail='',
+                file_path=canonical_path,
+                receipt_path=receipt_path,
+            )
+            _write_receipt(receipt_path, res)
+            return res
+
+        if reachable_count == 0:
+            status = 'offline'
+            detail = network_errors[0] if network_errors else 'network unreachable'
+        elif data_errors:
+            status = 'error'
+            detail = ', '.join(data_errors)
+        else:
+            status = 'not_found'
+            detail = ''
+
+        kept_name = latest_existing.name if (latest_existing is not None and latest_sha) else ''
+        kept_sha = latest_sha if (latest_existing is not None and latest_sha) else ''
+        kept_path = latest_existing if (latest_existing is not None and latest_sha) else None
+        res = FetchResult(
+            title_id=tid,
+            build_id=bid,
+            status=status,
+            sources=[],
+            entry_count=0,
+            fetched_at=done_ts,
+            file_name=kept_name,
+            file_sha256=kept_sha,
+            origin='fetched',
+            detail=detail,
+            file_path=kept_path,
+            receipt_path=receipt_path,
+        )
+        _write_receipt(receipt_path, res)
+        return res
+    except Exception as exc:
+        return FetchResult(
+            title_id=tid,
+            build_id=bid,
+            status='error',
+            fetched_at=now_ts,
+            detail=str(exc),
+        )
+
+
+def format_log_summary(res: FetchResult) -> str:
+    """Format a concise single-line build log summary (no semicolons)."""
+    prefix = f'cheats fetch ({res.title_id} / {res.build_id})'
+    if res.status == 'found':
+        srcs = ', '.join(res.sources)
+        return f'{prefix}: {res.entry_count} cheat(s) from {srcs} -> {res.file_name}'
+    if res.status == 'preserved_user':
+        return f'{prefix}: preserved user cheat file {res.file_name}'
+    if res.status == 'not_found':
+        return f'{prefix}: not listed in public cheat databases'
+    if res.status == 'offline':
+        return f'{prefix}: offline or timed out, skipped'
+    why = f' ({res.detail})' if res.detail else ''
+    return f'{prefix}: skipped{why}'
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(
+        description='Fetch public Switch Atmosphère <BID>.txt cheats into --cheat-dir with user-file protection.',
+    )
+    ap.add_argument('--title-id', required=True, help='16-hex-digit Switch application title ID')
+    ap.add_argument('--build-id', required=True, help='Switch main NSO build ID (at least 16 hex digits)')
+    ap.add_argument('--cheat-dir', required=True, help='target directory for <BID>.txt and .cheats-fetch.json')
+    ap.add_argument('--timeout', type=float, default=DEFAULT_TIMEOUT, help='per-source HTTP timeout in seconds (default: 5)')
+    ap.add_argument('--force', action='store_true', help='overwrite an existing <BID>.txt even if user-supplied or edited')
+    args = ap.parse_args(argv)
+
+    res = fetch_cheats(
+        args.title_id,
+        args.build_id,
+        args.cheat_dir,
+        timeout=args.timeout,
+        force=args.force,
+    )
+    print(format_log_summary(res))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
