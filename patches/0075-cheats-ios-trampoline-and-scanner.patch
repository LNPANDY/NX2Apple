index 6becc99..99aa018 100644
--- a/dm/host/dm.h
+++ b/dm/host/dm.h
@@ -78,6 +78,7 @@ typedef struct {
     uint64_t unity_qs_ptr;     // Unity's QualitySettings (main's offset of the global pointer); the current level's vSyncCount, an int32, is at
     uint32_t unity_qs_idx, unity_qs_arr, unity_qs_size, unity_qs_vsync;   // [obj + arr] + (int32)[obj + idx] * size + vsync; 0 = none
     uint64_t fps_state_off;    // frame step state page (patch_nso.py FRAME_STEP: Tears of the Kingdom 1.4.3 and Breath of the Wild 1.9.0 main); 0 = none
+    uint64_t cheat_state_off;  // 16 KB writable cheat state page (patch_nso.py / cheat_bake.py: 4 KB slot bytes + 12 KB Code Cave mirror); 0 = none
     uint32_t step_max;         // the largest step the frame step stubs give the game (the fixups table's STEP_MAX, patch_nso.py ctx.step_max); 0 = FSTEP_MAX
     uint32_t render_scale_max; // a render-scale stub's largest scale (the fixups table's RENDER_SCALE, patch_nso.py): DM_RENDER_SCALE is held to it; 0 = no such stub
     int fstep_t120;            // the frame step stub takes its step in ticks of 1/120 s (the FRAME_STEP_120 capability: state +0x38 120, and 40 fps)
@@ -241,6 +242,33 @@ const char *dm_cheats_skipped_name(int i);
 const char *dm_cheats_skipped_why(int i);
 int dm_cheats_nsources(void);         // anchored sources (*.cheats.toml) in the cheats folder
 const char *dm_cheats_source(int i);
+// Baked iOS cheat trampolines and key-mask metadata (hle_cheats.c, dm/cheat_trampolines.tsv)
+enum { DM_CHEAT_BAKED_NONE = 0, DM_CHEAT_BAKED_STATIC = 1, DM_CHEAT_BAKED_CONDITIONAL = 2, DM_CHEAT_BAKED_UNBAKED = 3 };
+int dm_cheat_baked_kind_at(int i);
+uint64_t dm_cheat_key_mask_at(int i);
+int dm_cheats_baked_slots(void);
+// Lightweight safe data-only memory value scanner (main .data/.bss and opened heap)
+#ifndef DM_SCAN_HIT_DEFINED
+#define DM_SCAN_HIT_DEFINED
+enum { DM_SCAN_U8 = 1, DM_SCAN_U16 = 2, DM_SCAN_U32 = 3, DM_SCAN_U64 = 4, DM_SCAN_F32 = 5 };
+enum { DM_SCAN_EQ = 0, DM_SCAN_NE = 1, DM_SCAN_GT = 2, DM_SCAN_LT = 3,
+       DM_SCAN_INCREASED = 4, DM_SCAN_DECREASED = 5, DM_SCAN_UNCHANGED = 6, DM_SCAN_CHANGED = 7 };
+typedef struct {
+    uint8_t region;       // 0 = main (.data/.bss), 1 = heap
+    uint8_t type;         // DM_SCAN_*
+    uint16_t reserved;
+    uint64_t offset;      // offset relative to region base
+    uint64_t value;       // raw value bits (f32 in low 32 bits)
+} dm_scan_hit_t;
+#endif
+int dm_cheat_scan_start(int type, uint64_t target_raw, size_t *total_out);
+int dm_cheat_scan_refine(int cmp, uint64_t target_raw, size_t *total_out);
+int dm_cheat_scan_count(void);
+int dm_cheat_scan_get(int index, dm_scan_hit_t *out);
+int dm_cheat_scan_write(uint8_t region, uint64_t offset, int type, uint64_t value_raw);
+int dm_cheat_scan_format_cheat(const char *name, uint8_t region, uint64_t offset, int type, uint64_t value_raw, char *out, size_t cap);
+int dm_cheat_scan_append_cheat(const char *name, uint8_t region, uint64_t offset, int type, uint64_t value_raw);
+void dm_cheat_scan_reset(void);
 void dm_cheats_exit(void);            // a clean exit (hle_lifecycle.c, atexit): removes the safe-mode flag
 // Graphics lifecycle (hle_nvn.c): on=1 closes submission and waits up to three seconds for the drain, on=0 requests reopening once the drain completes.
 void dm_gfx_suspend(int on);
