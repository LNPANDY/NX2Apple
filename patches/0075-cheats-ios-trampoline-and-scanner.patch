+    def test_protected_svc_and_unrelocatable_insns_are_skipped_safely(self):
+        orig_words = {
+            0x0100: 0xD4000001,  # svc #0 (unrelocatable)
+            0x0104: 0x91000412,  # add x18, x0, #1 (uses x18)
