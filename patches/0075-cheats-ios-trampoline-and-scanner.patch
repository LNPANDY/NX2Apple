+    def test_enhanced_code_cave_switch_relocation_all_4_addressing_modes(self):
+        # Cave at 0x3000..0x3040 (originally 0), switch table data at 0x3100..0x3110 (originally 0).
+        # Hook at 0x0200 branches to 0x3000.
+        # Cave uses:
+        #   0x3000: adrp x9, 0x3000 ; add x9, x9, #0x100  -> [0x3100]
+        #   0x3008: adrp x10, 0x3000 ; ldr w11, [x10, #0x104] -> [0x3104]
+        #   0x3010: adr x12, 0x3108 (out-of-range when cheat_state_off = 0x200000 -> forces stub!)
+        #   0x3014: ldr w13, 0x310C (out-of-range -> forces stub!)
+        #   0x3018: b 0x0204
+        orig_words = {off: 0 for off in range(0x3000, 0x3200, 4)}
+        cave_insns = {
+            0x3000: ADRP(9, 0x3000, 0x3000),
+            0x3004: ADDI(9, 9, 0x100),
+            0x3008: ADRP(10, 0x3008, 0x3000),
+            0x300C: cb.LDRW_UIMM(11, 10, 0x104 // 4),
+            0x3010: 0x10000000 | (((0x3108 - 0x3010) & 3) << 29) | ((((0x3108 - 0x3010) >> 2) & 0x7FFFF) << 5) | 12,
+            0x3014: 0x18000000 | (((0x310C - 0x3014) >> 2) << 5) | 13,
+            0x3018: B(0x3018, 0x0204),
+        }
+        hook_b = B(0x0200, 0x3000)
+        lines = ['{Master Cave}\n', f'04000000 00000200 {hook_b:08X}\n']
+        for off, w in cave_insns.items():
+            lines.append(f'04000000 {off:08X} {w:08X}\n')
+        # Switch toggles writing different values to 0x3100..0x310C
+        lines.append('[Switch A]\n04000000 00003100 00000001\n04000000 00003104 00000002\n')
+        lines.append('[Switch B]\n04000000 00003108 00000003\n04000000 0000310C 00000004\n')
+
+        cheat_state = 0x200000  # > 1 MB away from 0x3000 so adr & ldr literal MUST emit stubs!
+        plan, img, patch, pbase, notes = run_bake_synthetic(
+            ''.join(lines), orig_words, cheat_state_off=cheat_state, patch_base=0x220000,
+        )
+        self.assertEqual(len(plan.mirrors), 1)
+        mb = plan.mirrors[0]
+        self.assertEqual(mb.orig_off, 0x3100)
+        self.assertEqual(mb.size, 16)
+        self.assertEqual(mb.mirror_rel, cb.CHEAT_MIRROR_OFFSET)
+        mirror_va = cheat_state + mb.mirror_rel
+
+        # 1. Verify adrp + add points to mirror_va + 0.
+        i0, i1 = dis_all(bytes(img[0x3000:0x3008]), 0x3000)
+        self.assertEqual(i0.mnemonic, 'adrp')
+        self.assertEqual(i1.mnemonic, 'add')
+        self.assertEqual(i0.operands[1].imm + i1.operands[2].imm, mirror_va)
+
+        # 2. Verify adrp + ldr w11 points to mirror_va + 4.
+        i2, i3 = dis_all(bytes(img[0x3008:0x3010]), 0x3008)
+        self.assertEqual(i2.mnemonic, 'adrp')
+        self.assertEqual(i3.mnemonic, 'ldr')
+        self.assertEqual(i2.operands[1].imm + i3.operands[1].mem.disp, mirror_va + 4)
+
+        # 3. Verify adr x12 redirected to stub loading mirror_va + 8.
+        i4 = dis_all(bytes(img[0x3010:0x3014]), 0x3010)[0]
+        self.assertEqual(i4.mnemonic, 'b')
+        st1 = i4.operands[0].imm
+        s1 = dis_all(bytes(patch[st1 - pbase:st1 - pbase + 12]), st1)
+        self.assertEqual([x.mnemonic for x in s1], ['adrp', 'add', 'b'])
+        self.assertEqual(s1[0].operands[1].imm + s1[1].operands[2].imm, mirror_va + 8)
+        self.assertEqual(s1[2].operands[0].imm, 0x3014)
+
