+    def test_arm64_dataflow_bypass_blocks_unsafe_patch_and_allows_safe_patches(self):
+        # 1. Pure-Python AArch64 decoder sanity checks across branch/alu/mem/mov/fp families.
+        self.assertEqual(cb.decode_arm64_insn(0xAA0203F8, 0x100).writes, {24})  # mov x24, x2
+        self.assertEqual(cb.decode_arm64_insn(0xAA0203F8, 0x100).reads, {2})
+        self.assertEqual(cb.decode_arm64_insn(0xB9400B00, 0x104).reads, {24})   # ldr w0, [x24, #8]
+        self.assertEqual(cb.decode_arm64_insn(0xB9400B00, 0x104).writes, {0})
+        self.assertTrue(cb.decode_arm64_insn(0xD65F03C0, 0x108).is_return)      # ret
+
+        # 2. Construct realistic AArch64 function layout:
+        #    UnsafeBypass:
+        #      0x0200: cbz x0, 0x0210        ; external conditional branch jumping into (D, U]!
+        #      0x0208 (D): patched to `mov x24, x2` (0xAA0203F8), orig `add x1, x1, #1` (0x91000421)
+        #      0x020C:     orig `mov w3, #0` (0x52800003)
+        #      0x0210:     branch landing target inside (D, U] (`add x3, x3, #1`, 0x91000463)
+        #      0x0218 (U): patched to `ldr w0, [x24, #8]` (0xB9400B00), orig `ldr w0, [x19, #8]` (0xB9400A60)
+        #      0x021C:     orig `ret` (0xD65F03C0) -> original code after 0x0210 never reads x24!
+        #
+        #    SafeSequential:
+        #      0x0300 (D): patched to `mov x24, x2` (0xAA0203F8)
+        #      0x0308 (U): patched to `ldr w0, [x24, #8]` (0xB9400B00)
+        #      0x030C:     orig `ret` (0xD65F03C0) -> no branch bypasses 0x0300!
+        #
+        #    SafeAlreadyLive:
+        #      0x0400: cbz x0, 0x0410        ; external branch into (D, U], BUT original code at 0x0414
+        #      0x0408 (D): patched `mov x24, x2` ; ALREADY reads x24 before returning, proving x24 was
+        #      0x0410 (U): patched `ldr w5, [x24, #4]` (0xB9400705), orig `nop` ; live on entry!
+        #      0x0414:     orig `ldr w6, [x24, #12]` (0xB9400F06)
+        #      0x0418:     orig `ret` (0xD65F03C0)
+        #
+        #    TopFallthroughBypass:
+        #      0x0500: patched `cbnz w0, 0x050C` (0x35000060) ; cluster top falls in from 0x04FC and jumps over D!
+        #      0x0504 (D): patched `movz x25, #0x10` (0xD2800219)
+        #      0x050C (U): patched `add x1, x1, x25` (0x8B190021), orig `add x1, x1, #1`
+        #      0x0510:     orig `ret` (0xD65F03C0)
+        orig_words = {
+            0x0200: 0xB4000080,  # cbz x0, +0x10 (0x0210)
+            0x0208: 0x91000421,  # add x1, x1, #1
+            0x020C: 0x52800003,  # movz w3, #0
+            0x0210: 0x91000463,  # add x3, x3, #1
+            0x0218: 0xB9400A60,  # ldr w0, [x19, #8]
+            0x021C: 0xD65F03C0,  # ret
+
+            0x0300: 0x91000421,
+            0x0308: 0xB9400A60,
+            0x030C: 0xD65F03C0,
+
+            0x0400: 0xB4000080,  # cbz x0, +0x10 (0x0410)
+            0x0408: 0x91000421,
+            0x0410: 0xD503201F,  # nop
+            0x0414: 0xB9400F06,  # ldr w6, [x24, #12] -> x24 is live in original code!
+            0x0418: 0xD65F03C0,
+
+            0x0500: 0xD503201F,
+            0x0504: 0x91000421,
+            0x050C: 0x91000421,
+            0x0510: 0xD65F03C0,
+        }
+        cheat_txt = (
+            '[UnsafeBypass]\n'
+            '04000000 00000208 AA0203F8\n'
+            '04000000 00000218 B9400B00\n'
+            '[SafeSequential]\n'
+            '04000000 00000300 AA0203F8\n'
+            '04000000 00000308 B9400B00\n'
+            '[SafeAlreadyLive]\n'
+            '04000000 00000408 AA0203F8\n'
+            '04000000 00000410 B9400705\n'
+            '[TopFallthroughBypass]\n'
+            '04000000 00000500 35000060\n'
+            '04000000 00000504 D2800219\n'
+            '04000000 0000050C 8B190021\n'
+        )
+        plan, img, _, _, _ = run_bake_synthetic(cheat_txt, orig_words)
+        by_key = {e.cheat_key: e for e in plan.entries}
+
+        # Unsafe entries MUST be blocked as unsafe_code with exact diagnostic and no semicolon!
+        self.assertEqual(by_key['UnsafeBypass'].kind, 'unsafe_code')
+        self.assertEqual(
+            by_key['UnsafeBypass'].detail,
+            'dataflow_bypass: x24 read at +0x218 bypassed def at +0x208',
+        )
+        self.assertNotIn(';', by_key['UnsafeBypass'].detail)
+        # Original instructions at 0x208 and 0x218 must remain untouched (no trampoline emitted)!
+        self.assertEqual(struct.unpack_from('<I', img, 0x0208)[0], 0x91000421)
+        self.assertEqual(struct.unpack_from('<I', img, 0x0218)[0], 0xB9400A60)
+
+        self.assertEqual(by_key['TopFallthroughBypass'].kind, 'unsafe_code')
+        self.assertEqual(
+            by_key['TopFallthroughBypass'].detail,
+            'dataflow_bypass: x25 read at +0x50c bypassed def at +0x504',
+        )
+
+        # Safe entries MUST still bake cleanly as baked_static!
+        self.assertEqual(by_key['SafeSequential'].kind, 'baked_static')
+        self.assertEqual(by_key['SafeAlreadyLive'].kind, 'baked_static')
+
+        tsv = cb.format_trampolines_tsv(plan)
+        self.assertIn(
+            'entry\tUnsafeBypass\tUnsafeBypass\tunsafe_code\t-1\t0x0\t0x208\t0xaa0203f8\t0x0\t'
+            'dataflow_bypass: x24 read at +0x218 bypassed def at +0x208\n',
+            tsv,
+        )
+
+
+if __name__ == '__main__':
+    unittest.main()
