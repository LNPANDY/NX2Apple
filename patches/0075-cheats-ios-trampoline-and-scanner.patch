+// ---------- Lightweight safe data-only memory value scanner ----------
+// Scans only writable guest data regions: main (.data/.bss, strictly inside [data_start, key_page_off))
+// and the currently opened heap (WH_HEAP, read chunk-by-chunk via dm_guest_heap_read under the memory lock).
+// Never touches .text, key_page, patch areas, or unmapped pages.
+
+static unsigned scan_elem_size(int type) {
+    switch (type) {
+        case DM_SCAN_U8:  return 1;
+        case DM_SCAN_U16: return 2;
+        case DM_SCAN_U32: return 4;
+        case DM_SCAN_U64: return 8;
+        case DM_SCAN_F32: return 4;
+        default:          return 0;
+    }
+}
+
+static int scan_main_data_range(uint64_t *start_out, uint64_t *end_out) {
+    if (!g_main_mod || !g_main_mod->base || !g_main_mod->size) return 0;
+    uint64_t rx = main_rx_end();
+    uint64_t start = g_main_mod->data_off >= rx ? g_main_mod->data_off : rx;
+    uint64_t end = g_main_mod->key_page_off;
+    if (end > g_main_mod->size) end = g_main_mod->size;
+    if (start >= end) return 0;
+    *start_out = start;
+    *end_out = end;
+    return 1;
+}
+
+static int scan_match(int type, int cmp, uint64_t cur, uint64_t ref) {
+    unsigned sz = scan_elem_size(type);
+    if (!sz) return 0;
+    if (type == DM_SCAN_F32) {
+        uint32_t uc = (uint32_t)cur, ur = (uint32_t)ref;
+        float fc = 0.0f, fr = 0.0f;
+        memcpy(&fc, &uc, 4); memcpy(&fr, &ur, 4);
+        if (isnan(fc) || isnan(fr)) return 0;
+        switch (cmp) {
+            case DM_SCAN_EQ:
+            case DM_SCAN_UNCHANGED: return fabsf(fc - fr) <= 1e-4f;
+            case DM_SCAN_NE:
+            case DM_SCAN_CHANGED:   return fabsf(fc - fr) > 1e-4f;
+            case DM_SCAN_GT:
+            case DM_SCAN_INCREASED: return fc > fr;
+            case DM_SCAN_LT:
+            case DM_SCAN_DECREASED: return fc < fr;
+            default:                return 0;
+        }
+    }
+    uint64_t m = width_mask(sz);
+    uint64_t a = cur & m, b = ref & m;
+    switch (cmp) {
+        case DM_SCAN_EQ:
+        case DM_SCAN_UNCHANGED: return a == b;
+        case DM_SCAN_NE:
+        case DM_SCAN_CHANGED:   return a != b;
+        case DM_SCAN_GT:
+        case DM_SCAN_INCREASED: return a > b;
+        case DM_SCAN_LT:
+        case DM_SCAN_DECREASED: return a < b;
+        default:                return 0;
+    }
+}
+
+static void scan_push_hit(uint8_t region, int type, uint64_t offset, uint64_t val) {
+    if (g_scan_n >= DM_SCAN_CAP) return;
+    if (g_scan_n == g_scan_cap) {
+        size_t ncap = g_scan_cap ? g_scan_cap * 2 : 1024;
+        if (ncap > DM_SCAN_CAP) ncap = DM_SCAN_CAP;
+        dm_scan_hit_t *grown = realloc(g_scan_hits, ncap * sizeof *grown);
+        if (!grown) return;
+        g_scan_hits = grown;
+        g_scan_cap = ncap;
+    }
+    g_scan_hits[g_scan_n].region = region;
+    g_scan_hits[g_scan_n].type = (uint8_t)type;
+    g_scan_hits[g_scan_n].reserved = 0;
+    g_scan_hits[g_scan_n].offset = offset;
+    g_scan_hits[g_scan_n].value = val;
+    g_scan_n++;
+}
+
+int dm_cheat_scan_start(int type, uint64_t target_raw, size_t *total_out) {
+    unsigned sz = scan_elem_size(type);
+    if (!sz) { if (total_out) *total_out = 0; return -1; }
+    pthread_mutex_lock(&g_scan_lock);
+    g_scan_n = 0;
+    g_scan_type = type;
+    size_t total = 0;
+
+    // 1. Scan main .data/.bss safely.
+    uint64_t dstart = 0, dend = 0;
+    if (scan_main_data_range(&dstart, &dend) && dend - dstart >= sz) {
+        uint64_t first = (dstart + sz - 1) & ~(uint64_t)(sz - 1);
+        for (uint64_t off = first; off <= dend - sz; off += sz) {
+            uint64_t cur = 0;
+            memcpy(&cur, g_main_mod->base + off, sz);
+            if (scan_match(type, DM_SCAN_EQ, cur, target_raw)) {
+                total++;
+                scan_push_hit(0, type, off, cur);
+            }
+        }
+    }
+
+    // 2. Scan opened guest heap safely in 4 KB chunks under dm_guest_heap_read.
+    uint64_t hb = 0; size_t hopen = 0;
+    dm_guest_heap_range(&hb, &hopen);
+    if (hb && hopen >= sz) {
+        uint8_t chunk[4096];
+        for (uint64_t base_off = 0; base_off < hopen; base_off += sizeof chunk) {
+            size_t avail = hopen - (size_t)base_off;
+            size_t n = avail > sizeof chunk ? sizeof chunk : avail;
+            if (n < sz) break;
+            if (dm_guest_heap_read(hb + base_off, chunk, n) != 0) break;
+            for (size_t i = 0; i <= n - sz; i += sz) {
+                uint64_t cur = 0;
+                memcpy(&cur, chunk + i, sz);
+                if (scan_match(type, DM_SCAN_EQ, cur, target_raw)) {
+                    total++;
+                    scan_push_hit(1, type, base_off + i, cur);
+                }
+            }
+        }
+    }
+
+    int kept = (int)g_scan_n;
+    if (total_out) *total_out = total;
+    pthread_mutex_unlock(&g_scan_lock);
+    return kept;
+}
+
+static int scan_read_current(uint8_t region, uint64_t offset, unsigned sz, uint64_t *out) {
+    uint64_t v = 0;
+    if (region == 0) {
+        uint64_t dstart = 0, dend = 0;
+        if (!scan_main_data_range(&dstart, &dend)) return -1;
+        if (offset < dstart || offset > dend || sz > dend - offset) return -1;
+        memcpy(&v, g_main_mod->base + offset, sz);
+        *out = v;
+        return 0;
+    }
+    if (region == 1) {
+        uint64_t hb = 0; size_t hopen = 0;
+        dm_guest_heap_range(&hb, &hopen);
+        if (!hb || offset > hopen || sz > hopen - offset) return -1;
+        if (dm_guest_heap_read(hb + offset, &v, sz) != 0) return -1;
+        *out = v;
+        return 0;
+    }
+    return -1;
+}
+
+int dm_cheat_scan_refine(int cmp, uint64_t target_raw, size_t *total_out) {
+    if (cmp < DM_SCAN_EQ || cmp > DM_SCAN_CHANGED) { if (total_out) *total_out = 0; return -1; }
+    pthread_mutex_lock(&g_scan_lock);
+    unsigned sz = scan_elem_size(g_scan_type);
+    if (!sz) {
+        if (total_out) *total_out = 0;
+        pthread_mutex_unlock(&g_scan_lock);
+        return -1;
+    }
+    size_t kept = 0;
+    int relative = cmp >= DM_SCAN_INCREASED;
+    for (size_t i = 0; i < g_scan_n; i++) {
+        dm_scan_hit_t h = g_scan_hits[i];
+        uint64_t cur = 0;
+        if (scan_read_current(h.region, h.offset, sz, &cur) != 0) continue;
+        uint64_t ref = relative ? h.value : target_raw;
+        if (scan_match(g_scan_type, cmp, cur, ref)) {
+            h.value = cur;
+            g_scan_hits[kept++] = h;
+        }
+    }
+    g_scan_n = kept;
+    if (total_out) *total_out = kept;
+    pthread_mutex_unlock(&g_scan_lock);
+    return (int)kept;
+}
+
+int dm_cheat_scan_count(void) {
+    pthread_mutex_lock(&g_scan_lock);
+    int n = (int)g_scan_n;
+    pthread_mutex_unlock(&g_scan_lock);
+    return n;
+}
+
+int dm_cheat_scan_get(int index, dm_scan_hit_t *out) {
+    if (!out || index < 0) return -1;
+    pthread_mutex_lock(&g_scan_lock);
+    if ((size_t)index >= g_scan_n) { pthread_mutex_unlock(&g_scan_lock); return -1; }
+    *out = g_scan_hits[index];
+    pthread_mutex_unlock(&g_scan_lock);
+    return 0;
+}
+
+int dm_cheat_scan_write(uint8_t region, uint64_t offset, int type, uint64_t value_raw) {
+    unsigned sz = scan_elem_size(type);
+    if (!sz) return -1;
+    uint64_t v = value_raw & width_mask(sz);
+    int rc = -1;
+    pthread_mutex_lock(&g_scan_lock);
+    if (region == 0) {
+        uint64_t dstart = 0, dend = 0;
+        if (scan_main_data_range(&dstart, &dend) && offset >= dstart && offset <= dend && sz <= dend - offset) {
+            uint8_t *addr = g_main_mod->base + offset;
+            dm_guest_write_prepare(addr, sz);
+            memcpy(g_alias ? g_alias + (size_t)offset : addr, &v, sz);
+            rc = 0;
+        }
+    } else if (region == 1) {
+        uint64_t hb = 0; size_t hopen = 0;
+        dm_guest_heap_range(&hb, &hopen);
+        if (hb && offset <= hopen && sz <= hopen - offset) {
+            rc = dm_guest_heap_write(hb + offset, &v, sz) == 0 ? 0 : -1;
+        }
+    }
+    pthread_mutex_unlock(&g_scan_lock);
+    return rc;
+}
+
+int dm_cheat_scan_format_cheat(const char *name, uint8_t region, uint64_t offset, int type, uint64_t value_raw, char *out, size_t cap) {
+    unsigned sz = scan_elem_size(type);
+    if (!name || !name[0] || region > 1 || !sz || !out || !cap || offset > 0xFFFFFFFFFFull) return -1;
+    char safe[NAME_MAX];
+    size_t j = 0;
+    for (size_t i = 0; name[i] && j + 1 < sizeof safe; i++) {
+        char ch = name[i];
+        if (ch == '[' || ch == ']' || ch == '{' || ch == '}' || ch == '\r' || ch == '\n') continue;
+        safe[j++] = ch;
+    }
+    safe[j] = 0;
+    if (!safe[0]) return -1;
+    unsigned hi_off = (unsigned)((offset >> 32) & 0xFFu);
+    uint32_t lo_off = (uint32_t)(offset & 0xFFFFFFFFu);
+    int n;
+    if (sz == 8) {
+        n = snprintf(out, cap, "[%s]\n08%X000%02X %08X %08X %08X\n",
+                     safe, (unsigned)region, hi_off, lo_off,
+                     (uint32_t)(value_raw >> 32), (uint32_t)(value_raw & 0xFFFFFFFFu));
+    } else {
+        uint32_t v32 = (uint32_t)(value_raw & width_mask(sz));
+        n = snprintf(out, cap, "[%s]\n0%u%X000%02X %08X %08X\n",
+                     safe, sz, (unsigned)region, hi_off, lo_off, v32);
+    }
+    return (n > 0 && (size_t)n < cap) ? n : -1;
+}
+
+int dm_cheat_scan_append_cheat(const char *name, uint8_t region, uint64_t offset, int type, uint64_t value_raw) {
+    char snippet[512];
+    if (dm_cheat_scan_format_cheat(name, region, offset, type, value_raw, snippet, sizeof snippet) < 0) return -1;
+    char target_path[2048] = "";
+    pthread_mutex_lock(&g_lock);
+    if (g_path[0]) snprintf(target_path, sizeof target_path, "%s", g_path);
+    else if (g_dir[0] && g_build[0]) snprintf(target_path, sizeof target_path, "%s/%s.txt", g_dir, g_build);
+    pthread_mutex_unlock(&g_lock);
+    if (!target_path[0]) return -1;
+    int need_nl = 0;
+    FILE *rf = fopen(target_path, "rb");
+    if (rf) {
+        if (fseek(rf, -1, SEEK_END) == 0) {
+            int last = fgetc(rf);
+            if (last != EOF && last != '\n') need_nl = 1;
+        }
+        fclose(rf);
+    }
+    FILE *wf = fopen(target_path, "ab");
+    if (!wf) return -1;
+    int ok = (!need_nl || fputc('\n', wf) != EOF) && fputs(snippet, wf) >= 0;
+    if (fclose(wf) != 0 || !ok) return -1;
+    dm_cheats_reload();
+    return 0;
+}
+
+void dm_cheat_scan_reset(void) {
+    pthread_mutex_lock(&g_scan_lock);
+    free(g_scan_hits);
+    g_scan_hits = NULL;
+    g_scan_n = 0;
+    g_scan_cap = 0;
+    g_scan_type = 0;
+    pthread_mutex_unlock(&g_scan_lock);
+}
