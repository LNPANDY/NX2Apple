diff --git a/dm/tools/cheat_bake.py b/dm/tools/cheat_bake.py
new file mode 100644
index 0000000..4193cb5
--- /dev/null
+++ b/dm/tools/cheat_bake.py
@@ -0,0 +1,2050 @@
+"""Offline Atmosphère cheat trampoline baker and Code Cave switch-table relocator.
+
+Used by dm/tools/patch_nso.py when baking cheats into main so unjailbroken iOS
+(where .text pages are signed read-only/execute without JIT) can toggle both
+unconditional static code cheats and key/memory-conditional code cheats at
+runtime via a dedicated 16 KB writable cheat_state_page:
+  +0x0000 .. +0x0FFF : uint8_t slot[4096] (0 = original insn, nonzero = variant mask)
+  +0x1000 .. +0x3FFF : 12 KB relocated Code Cave switch-table / data mirror area
+
+All generated trampolines strictly preserve NZCV condition flags (using only
+cbz/cbnz/tbz/tbnz for dispatch, never cmp/subs/adds/ands) and all guest
+registers including sp.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+import os
+from pathlib import Path
+import re
+import struct
+from typing import Callable
+
+import capstone
+from capstone import CS_ARCH_ARM64, CS_MODE_ARM, Cs
+from capstone.arm64 import ARM64_OP_IMM, ARM64_OP_MEM, ARM64_OP_REG
+
+import nso_asm
+from nso_asm import ADDI, ADRP, B, BL, BR, CBNZW, LDRX, NOP
+
+CHEAT_STATE_PAGE_SIZE = 0x4000
+CHEAT_SLOTS_SIZE = 0x1000
+CHEAT_MIRROR_OFFSET = 0x1000
+CHEAT_MIRROR_SIZE = 0x3000
+MAX_SLOTS = CHEAT_SLOTS_SIZE
+MAX_VARIANTS_PER_SITE = 32
+FILE_MAX = 4 << 20
+INS_MAX = 0x2000
+
+# AArch64 encodings used by trampolines and relocations (all NZCV-preserving).
+def STR_X_PRE(rt: int, rn: int, off: int) -> int:
+    assert -256 <= off <= 255
+    return 0xF8000C00 | ((off & 0x1FF) << 12) | (rn << 5) | rt
+
+
+def LDR_X_POST(rt: int, rn: int, off: int) -> int:
+    assert -256 <= off <= 255
+    return 0xF8400400 | ((off & 0x1FF) << 12) | (rn << 5) | rt
+
+
+def LDRB_UIMM(rt: int, rn: int, imm12: int) -> int:
+    assert 0 <= imm12 <= 0xFFF
+    return 0x39400000 | (imm12 << 10) | (rn << 5) | rt
+
+
+def LDRW_UIMM(rt: int, rn: int, imm12: int) -> int:
+    assert 0 <= imm12 <= 0xFFF
+    return 0xB9400000 | (imm12 << 10) | (rn << 5) | rt
+
+
+def LDRSW_UIMM(rt: int, rn: int, imm12: int) -> int:
+    assert 0 <= imm12 <= 0xFFF
+    return 0xB9800000 | (imm12 << 10) | (rn << 5) | rt
+
+
+def LDR_FP_UIMM(opc: int, rt: int, rn: int, imm12: int = 0) -> int:
+    assert 0 <= imm12 <= 0xFFF and opc in (0, 1, 2)
+    base = {0: 0xBD400000, 1: 0xFD400000, 2: 0x3DC00000}[opc]
+    return base | (imm12 << 10) | (rn << 5) | rt
+
+
+def CBZW(rt: int, frm: int, to: int) -> int:
+    off = to - frm
+    assert -(1 << 20) <= off < (1 << 20) and off % 4 == 0
+    return 0x34000000 | (((off >> 2) & 0x7FFFF) << 5) | rt
+
+
+def TBNZW(rt: int, bit: int, frm: int, to: int) -> int:
+    off = to - frm
+    assert 0 <= bit < 32 and -(1 << 15) <= off < (1 << 15) and off % 4 == 0
+    return 0x37000000 | (bit << 19) | (((off >> 2) & 0x3FFF) << 5) | rt
+
+
+def _sext(val: int, bits: int) -> int:
+    sign = 1 << (bits - 1)
+    return (val ^ sign) - sign
+
+
+def _width_ok(t: int) -> bool:
+    return t in (1, 2, 4, 8)
+
+
+def _width_mask(t: int) -> int:
+    return 0xFFFFFFFFFFFFFFFF if t == 8 else (1 << (8 * t)) - 1
+
+
+def _section_marker(name: str) -> tuple[int, str]:
+    if len(name) >= 4 and name.endswith('--'):
+        if name.startswith('--SectionStart:'):
+            return 1, name[15:-2]
+        if name.startswith('--SectionEnd:'):
+            return 2, name[13:-2]
+    return 0, ''
+
+
+@dataclass
+class StaticWrite:
+    offset: int
+    width: int
+    value: int
+    conditional: bool
+    key_mask: int = 0
+
+
+@dataclass
+class CheatEntry:
+    name: str
+    cheat_key: str
+    master: bool = False
+    label: bool = False
+    sec_mark: int = 0
+    section: str = ''
+    broken: bool = False
+    broken_why: str = ''
+    words: list[int] = field(default_factory=list)
+    writes: list[StaticWrite] = field(default_factory=list)
+    has_dynamic_text_write: bool = False
+    has_non_main_write: bool = False
+    key_mask: int = 0
+    kind: str = 'data'  # data | baked_static | baked_conditional | unbaked_code | unsafe_code
+    detail: str = ''
+
+
+@dataclass
+class MirrorBlock:
+    orig_off: int
+    mirror_rel: int
+    size: int
+    init_bytes: bytes
+    cheat_keys: list[str] = field(default_factory=list)
+
+
+@dataclass
+class BakedSite:
+    cheat_key: str
+    name: str
+    kind: str
+    slot_id: int
+    variant_mask: int
+    target_off: int
+    patched_word: int
+    key_mask: int
+    orig_word: int = 0
+    group_base: int = -1
+    group_bytes: int = 1
+
+
+@dataclass
+class BakePlan:
+    build_id: str
+    full_build_id: str
+    text_end: int
+    rx_end: int
+    entries: list[CheatEntry] = field(default_factory=list)
+    # Sites to turn into trampolines: target_off -> list of (patched_word, cheat_keys)
+    patch_sites: dict[int, list[int]] = field(default_factory=dict)
+    # Code cave words written into zero/UDF padding: off -> word
+    cave_code: dict[int, int] = field(default_factory=dict)
+    cave_owners: dict[int, str] = field(default_factory=dict)
+    cave_orig_words: dict[int, int] = field(default_factory=dict)
+    # Standalone restore/no-op writes matching original .text (when off has no trampoline): off -> (orig_word, cheat_key)
+    cave_noops: dict[int, tuple[int, str]] = field(default_factory=dict)
+    # Relocated cave data/switch blocks: orig_off -> MirrorBlock
+    mirrors: list[MirrorBlock] = field(default_factory=list)
+    baked_sites: list[BakedSite] = field(default_factory=list)
+    slots_used: int = 0
+    mirror_bytes: int = 0
+    cheat_state_off: int = 0
+    skipped: list[tuple[str, str]] = field(default_factory=list)
+
+    @property
+    def needs_state_page(self) -> bool:
+        return bool(self.patch_sites or self.mirrors)
+
+
+def resolve_cheat_file(
+    build_id: str,
+    cheat_file: str | os.PathLike[str] | None = None,
+    cheat_dir: str | os.PathLike[str] | None = None,
+    title_id: str | None = None,
+) -> Path | None:
+    """Locate the cheat file for build_id (matching hle_cheats.c search order)."""
+    if cheat_file:
+        p = Path(cheat_file)
+        return p if p.is_file() else None
+    if not cheat_dir or len(build_id) < 16:
+        return None
+    bid16 = build_id[:16].lower()
+    root = Path(cheat_dir)
+    dirs = [root]
+    if title_id:
+        tid = title_id.upper()
+        dirs.append(root / 'atmosphere' / 'contents' / tid / 'cheats')
+        dirs.append(root / 'contents' / tid / 'cheats')
+    for d in dirs:
+        if not d.is_dir():
+            continue
+        try:
+            for item in sorted(d.iterdir()):
+                if not item.is_file():
+                    continue
+                nm = item.name.lower()
+                if nm == f'{bid16}.txt':
+                    return item
+        except OSError:
+            continue
+    return None
+
+
+def _split_glued_headers(raw: str) -> str:
+    """Mirror hle_cheats.c read_text(): split headers glued after an 8-hex-digit word."""
+    out: list[str] = []
+    n = len(raw)
+    hex_chars = frozenset('0123456789abcdefABCDEF')
+    for i, ch in enumerate(raw):
+        if ch in ('[', '{') and i >= 8:
+            if all(raw[k] in hex_chars for k in range(i - 8, i)):
+                if i == 8 or raw[i - 9] in (' ', '\t', '\n', '\r'):
+                    out.append('\v')
+        out.append(ch)
+    return ''.join(out)
+
+
+def parse_cheat_text(text: str) -> list[CheatEntry]:
+    """Parse Atmosphère cheat text, supporting EdiZon and Zing section markers."""
+    expanded = _split_glued_headers(text)
+    pieces = re.split(r'[\n\v]', expanded)
+    entries: list[CheatEntry] = []
+    cur: CheatEntry | None = None
+    section = ''
+    name_counts: dict[str, int] = {}
+
+    def finalize_prev(ent: CheatEntry | None) -> None:
+        nonlocal section
+        if ent is None or ent.broken or ent.master:
+            return
+        # Zing group markers: single-word 20000000 (start) / 20000001 (end).
+        if len(ent.words) == 1 and ent.words[0] in (0x20000000, 0x20000001):
+            is_start = ent.words[0] == 0x20000000
+            ent.words.clear()
+            ent.label = True
+            ent.sec_mark = 1 if is_start else 2
+            if is_start:
+                section = ent.name
+                ent.section = section
+            else:
+                ent.section = section
+                section = ''
+
+    for piece in pieces:
+        p = piece.lstrip(' \t')
+        if p.startswith('[') or p.startswith('{'):
+            end_ch = ']' if p[0] == '[' else '}'
+            q = p.find(end_ch, 1)
+            if q > 1:
+                finalize_prev(cur)
+                nm = p[1:q]
+                dup = name_counts.get(nm, 0)
+                name_counts[nm] = dup + 1
+                ckey = f'{nm} #{dup + 1}' if dup else nm
+                master = end_ch == '}'
+                mark, sec = _section_marker(nm)
+                if mark == 1:
+                    section = sec
+                ent = CheatEntry(
+                    name=nm,
+                    cheat_key=ckey,
+                    master=master,
+                    sec_mark=mark,
+                    section=sec if mark == 1 else section,
+                )
+                if mark == 2:
+                    section = ''
+                entries.append(ent)
+                cur = ent
+                p = p[q + 1:].lstrip(' \t\r')
+                if not p:
+                    continue
+            else:
+                finalize_prev(cur)
+                cur = None
+                continue
+        if cur is None:
+            continue
+        tokens = p.strip().split()
+        if not tokens:
+            continue
+        got: list[int] = []
+        prose = False
+        oddhex = False
+        for tok in tokens:
+            if not all(c in '0123456789abcdefABCDEF' for c in tok):
+                prose = True
+                continue
+            if len(tok) % 8 != 0:
+                oddhex = True
+                continue
+            for k in range(0, len(tok), 8):
+                got.append(int(tok[k:k + 8], 16))
+        if prose and not got and not oddhex:
+            continue
+        if prose or oddhex:
+            if not cur.broken:
+                cur.broken = True
+                cur.broken_why = 'malformed line'
+            continue
+        if len(cur.words) + len(got) <= INS_MAX:
+            cur.words.extend(got)
+
+    finalize_prev(cur)
+    for ent in entries:
+        if not ent.broken and not ent.words:
+            ent.label = True
+    return entries
+
+
+def parse_cheat_file(path: str | os.PathLike[str]) -> list[CheatEntry]:
+    data = Path(path).read_bytes()
+    if len(data) > FILE_MAX:
+        raise ValueError(f'cheat file {path} exceeds {FILE_MAX} bytes')
+    return parse_cheat_text(data.decode('utf-8', errors='replace'))
+
+
+def _decode_op(words: list[int], idx: int) -> tuple[int, dict] | None:
+    """Decode one Atmosphère VM instruction at words[idx], mirroring hle_cheats.c ins_dec."""
+    n = len(words) - idx
+    if n <= 0:
+        return None
+    w = words[idx]
+    op = w >> 28
+    if op >= 0xC:
+        op = (op << 4) | ((w >> 24) & 0xF)
+    if op >= 0xF0:
+        op = (op << 4) | ((w >> 20) & 0xF)
+    info: dict = {'op': op, 'len': 1}
+    if op == 0:
+        t = (w >> 24) & 0xF
+        if not _width_ok(t) or n < (4 if t == 8 else 3):
+            return None
+        info.update(
+            t=t,
+            m=(w >> 20) & 0xF,
+            r=(w >> 16) & 0xF,
+            rel=((w & 0xFF) << 32) | words[idx + 1],
+            val=((words[idx + 2] << 32) | words[idx + 3]) if t == 8 else words[idx + 2],
+            len=4 if t == 8 else 3,
+        )
+    elif op == 1:
+        t = (w >> 24) & 0xF
+        c = (w >> 16) & 0xF
+        if not _width_ok(t) or c < 1 or c > 6 or n < (4 if t == 8 else 3):
+            return None
+        info.update(t=t, m=(w >> 20) & 0xF, c=c, len=4 if t == 8 else 3)
+    elif op == 2:
+        info['else'] = ((w >> 24) & 0xF) == 1
+    elif op == 3:
+        is_end = ((w >> 24) & 0xF) != 0
+        info.update(r=(w >> 16) & 0xF, is_end=is_end, len=1 if is_end else 2)
+        if not is_end and n < 2:
+            return None
+    elif op == 4:
+        if n < 3:
+            return None
+        info.update(r=(w >> 16) & 0xF, val=(words[idx + 1] << 32) | words[idx + 2], len=3)
+    elif op == 5:
+        t = (w >> 24) & 0xF
+        flags = (w >> 12) & 0xF
+        if not _width_ok(t) or flags > 3 or n < 2:
+            return None
+        info.update(t=t, r=(w >> 16) & 0xF, len=2)
+    elif op == 6:
+        t = (w >> 24) & 0xF
+        if not _width_ok(t) or n < 3:
+            return None
+        info.update(t=t, r=(w >> 16) & 0xF, inc=((w >> 12) & 0xF) != 0, len=3)
+    elif op == 7:
+        t = (w >> 24) & 0xF
+        c = (w >> 12) & 0xF
+        if not _width_ok(t) or c > 4 or n < 2:
+            return None
+        info.update(t=t, r=(w >> 16) & 0xF, len=2)
+    elif op == 8:
+        info['key_mask'] = w & 0x0FFFFFFF
+    elif op == 9:
+        t = (w >> 24) & 0xF
+        if not _width_ok(t):
+            return None
+        imm = ((w >> 8) & 0xF) != 0
+        ln = (3 if t == 8 else 2) if imm else 1
+        if n < ln:
+            return None
+        info.update(t=t, r=(w >> 16) & 0xF, len=ln)
+    elif op == 0xA:
+        t = (w >> 24) & 0xF
+        o = (w >> 8) & 0xF
+        if not _width_ok(t) or o > 5:
+            return None
+        ln = 2 if o in (2, 4, 5) else 1
+        if n < ln:
+            return None
+        info.update(t=t, r=(w >> 16) & 0xF, inc=((w >> 12) & 0xF) != 0, o=o, m=(w >> 4) & 0xF, len=ln)
+    elif op == 0xC0:
+        t = (w >> 20) & 0xF
+        c = (w >> 16) & 0xF
+        o = (w >> 8) & 0xF
+        if not _width_ok(t) or c < 1 or c > 6 or o > 5:
+            return None
+        ln = 2 if o in (0, 2) else ((3 if t == 8 else 2) if o == 4 else 1)
+        if n < ln:
+            return None
+        info.update(t=t, len=ln)
+    elif op == 0xC1:
+        info.update(r=(w >> 16) & 0xF, c=(w >> 4) & 0xF)
+    elif op == 0xC2:
+        info.update(c=(w >> 20) & 0xF, mask=w & 0xFFFF)
+    elif op == 0xC3:
+        info.update(x=(w >> 4) & 0xFF, r=w & 0xF)
+    elif op == 0xC4:
+        if n < 3:
+            return None
+        info.update(key_mask=(words[idx + 1] << 32) | words[idx + 2], len=3)
+    else:
+        return None
+    return info['len'], info
+
+
+def analyze_entries(entries: list[CheatEntry], rx_end: int) -> None:
+    """Decode entries, extract static .text writes, conditional depth, and key masks."""
+    # Only registers modified by always-on {Master} entries carry into subsequent entries.
+    # Optional [...] entries are independent and must not pollute later unrelated entries.
+    master_dirty: set[int] = set()
+    master_wrap_dirty: set[int] = set()
+    for half in (0, 1):
+        for ent in entries:
+            if ent.label or ent.broken or (ent.master != (half == 0)):
+                continue
+            dirty = set(master_dirty)
+            wrap_dirty = set(master_wrap_dirty)
+            ent_dirty: set[int] = set()
+            ent_wrap_dirty: set[int] = set()
+            cond_stack: list[int] = []  # key_mask for each enclosing conditional (0 for non-key)
+            idx = 0
+            while idx < len(ent.words):
+                dec = _decode_op(ent.words, idx)
+                if dec is None:
+                    ent.broken = True
+                    ent.broken_why = f'unsupported or truncated opcode at word {idx}'
+                    break
+                ln, info = dec
+                op = info['op']
+                if op == 0:
+                    m, t, r, rel, val = info['m'], info['t'], info['r'], info['rel'], info['val']
+                    is_main = m == 0 or m >= 5
+                    if is_main and r not in dirty:
+                        if rel < rx_end:
+                            km = 0
+                            for cm in cond_stack:
+                                km |= cm
+                            ent.writes.append(StaticWrite(
+                                offset=rel,
+                                width=t,
+                                value=val & _width_mask(t),
+                                conditional=len(cond_stack) > 0,
+                                key_mask=km,
+                            ))
+                    elif is_main and r in dirty:
+                        # An unsigned rel >= rx_end cannot wrap into main.text unless r itself
+                        # may carry a negative/wrapping offset (e.g. arithmetic or high-bit const).
+                        if rel < rx_end or r in wrap_dirty:
+                            ent.has_dynamic_text_write = True
+                    else:
+                        ent.has_non_main_write = True
+                elif op in (1, 0xC0):
+                    cond_stack.append(0)
+                elif op in (8, 0xC4):
+                    km = info['key_mask']
+                    ent.key_mask |= km
+                    cond_stack.append(km)
+                elif op == 2:
+                    if not info['else'] and cond_stack:
+                        cond_stack.pop()
+                elif op == 3:
+                    dirty.add(info['r'])
+                    ent_dirty.add(info['r'])
+                elif op == 4:
+                    if info['val'] == 0 and not cond_stack:
+                        dirty.discard(info['r'])
+                        wrap_dirty.discard(info['r'])
+                    else:
+                        dirty.add(info['r'])
+                        ent_dirty.add(info['r'])
+                        if info['val'] >= 0x8000_0000_0000_0000:
+                            wrap_dirty.add(info['r'])
+                            ent_wrap_dirty.add(info['r'])
+                elif op in (5,):
+                    dirty.add(info['r'])
+                    ent_dirty.add(info['r'])
+                elif op in (7, 9):
+                    dirty.add(info['r'])
+                    ent_dirty.add(info['r'])
+                    wrap_dirty.add(info['r'])
+                    ent_wrap_dirty.add(info['r'])
+                elif op == 6:
+                    if info['inc']:
+                        dirty.add(info['r'])
+                        ent_dirty.add(info['r'])
+                elif op == 0xA:
+                    if info['inc']:
+                        dirty.add(info['r'])
+                        ent_dirty.add(info['r'])
+                    if info['o'] in (3, 4, 5) and (info['m'] == 0 or info['m'] >= 5):
+                        ent.has_dynamic_text_write = True
+                elif op == 0xC1:
+                    if info['c'] == 3:
+                        if not cond_stack:
+                            dirty.discard(info['r'])
+                            wrap_dirty.discard(info['r'])
+                    elif info['c'] not in (1, 2):
+                        dirty.add(info['r'])
+                        ent_dirty.add(info['r'])
+                        wrap_dirty.add(info['r'])
+                        ent_wrap_dirty.add(info['r'])
+                elif op == 0xC2:
+                    if info['c'] == 3:
+                        if not cond_stack:
+                            for bit in range(16):
+                                if info['mask'] & (1 << bit):
+                                    dirty.discard(bit)
+                                    wrap_dirty.discard(bit)
+                    elif info['c'] not in (1, 2):
+                        for bit in range(16):
+                            if info['mask'] & (1 << bit):
+                                dirty.add(bit)
+                                ent_dirty.add(bit)
+                                wrap_dirty.add(bit)
+                                ent_wrap_dirty.add(bit)
+                elif op == 0xC3:
+                    if info['x'] < 0x80:
+                        dirty.add(info['r'])
+                        ent_dirty.add(info['r'])
+                        wrap_dirty.add(info['r'])
+                        ent_wrap_dirty.add(info['r'])
+                idx += ln
+            if not ent.broken and half == 0:
+                master_dirty |= ent_dirty
+                master_wrap_dirty |= ent_wrap_dirty
+
+
+def _expand_word_writes(w: StaticWrite, orig_text: bytes) -> list[tuple[int, int]] | None:
+    """Expand a 1/2/4/8-byte StaticWrite into aligned (off, u32) pairs, or None if invalid."""
+    if w.offset < 0 or w.offset + w.width > len(orig_text):
+        return None
+    if w.width == 4:
+        if w.offset & 3:
+            return None
+        return [(w.offset, w.value & 0xFFFFFFFF)]
+    if w.width == 8:
+        if w.offset & 3:
+            return None
+        return [
+            (w.offset, w.value & 0xFFFFFFFF),
+            (w.offset + 4, (w.value >> 32) & 0xFFFFFFFF),
+        ]
+    # Narrow 1/2-byte write inside a 4-byte word: merge into aligned word.
+    aligned = w.offset & ~3
+    shift = (w.offset & 3) * 8
+    if shift + w.width * 8 > 32 or aligned + 4 > len(orig_text):
+        return None
+    orig_w = struct.unpack_from('<I', orig_text, aligned)[0]
+    mask = ((1 << (w.width * 8)) - 1) << shift
+    merged = (orig_w & ~mask) | ((w.value << shift) & mask)
+    return [(aligned, merged)]
+
+
+# ---- AArch64 instruction classification & PC-relative relocation ----
+
+_FORBIDDEN_TRAMPOLINE_MNEMONICS = frozenset({
+    'svc', 'hvc', 'smc', 'mrs', 'msr',
+    'ldxr', 'ldaxr', 'ldxp', 'ldaxp', 'ldxrb', 'ldaxrb', 'ldxrh', 'ldaxrh',
+    'stxr', 'stlxr', 'stxp', 'stlxp', 'stxrb', 'stlxrb', 'stxrh', 'stlxrh',
+    'clrex',
+})
+
+_NZCV_MODIFYING_MNEMONICS = frozenset({
+    'cmp', 'cmn', 'tst', 'ccmp', 'ccmn', 'fcmp', 'fcmpe', 'fccmp', 'fccmpe',
+    'adds', 'subs', 'ands', 'bics', 'adcs', 'sbcs', 'ngcs', 'negs',
+})
+
+
+def is_relocatable_insn(word: int, orig_pc: int, md: Cs) -> tuple[bool, str]:
+    """Check whether a single AArch64 instruction word can be safely relocated into a trampoline."""
+    insns = list(md.disasm(struct.pack('<I', word), orig_pc))
+    if len(insns) != 1:
+        return False, f'undecodable instruction 0x{word:08x}'
+    ins = insns[0]
+    mnem = ins.mnemonic
+    if mnem in _FORBIDDEN_TRAMPOLINE_MNEMONICS:
+        return False, f'host-rewritten instruction {mnem}'
+    if re.search(r'\b[xw]18\b', ins.op_str):
+        return False, 'uses platform register x18'
+    # blr x30 overwrites lr while reading it; skip defensively.
+    if mnem == 'blr' and ins.op_str.strip() in ('x30', 'lr'):
+        return False, 'blr x30 cannot safely preserve return address'
+    return True, ''
+
+
+def relocate_insn(
+    word: int,
+    orig_pc: int,
+    here_fn: Callable[[], int],
+    emit_fn: Callable[[int], None],
+    bx_fn: Callable[[int, int], int],
+    md: Cs,
+) -> tuple[bool, str]:
+    """Emit relocated instruction sequence for `word` (originally at `orig_pc`) + exit branch.
+
+    Preserves NZCV flags and all guest registers (x0..x30, sp).
+    Returns (True, '') on success or (False, reason) if out of range / unsupported.
+    """
+    ok, why = is_relocatable_insn(word, orig_pc, md)
+    if not ok:
+        return False, why
+
+    fallthrough = orig_pc + 4
+
+    try:
+        # Unconditional branch: B imm26
+        if (word & 0xFC000000) == 0x14000000:
+            tgt = orig_pc + _sext(word & 0x3FFFFFF, 26) * 4
+            emit_fn(bx_fn(here_fn(), tgt))
+            return True, ''
+
+        # Branch with link: BL imm26 -> set x30 = orig_pc + 4, B target
+        if (word & 0xFC000000) == 0x94000000:
+            tgt = orig_pc + _sext(word & 0x3FFFFFF, 26) * 4
+            emit_fn(ADRP(30, here_fn(), fallthrough))
+            emit_fn(ADDI(30, 30, fallthrough & 0xFFF))
+            emit_fn(bx_fn(here_fn(), tgt))
+            return True, ''
+
+        # Indirect call: BLR Xn (Xn != x30) -> set x30 = orig_pc + 4, BR Xn
+        if (word & 0xFFFFFC1F) == 0xD63F0000:
+            rn = (word >> 5) & 31
+            emit_fn(ADRP(30, here_fn(), fallthrough))
+            emit_fn(ADDI(30, 30, fallthrough & 0xFFF))
+            emit_fn(BR(rn))
+            return True, ''
+
+        # Indirect jump / return: BR Xn / RET Xn (no fallthrough)
+        if (word & 0xFFFFFC1F) in (0xD61F0000, 0xD65F0000):
+            emit_fn(word)
+            return True, ''
+
+        # Conditional branch: B.cond imm19 -> b.cond +8; b fallthrough; b target
+        if (word & 0xFF000010) == 0x54000000:
+            cond = word & 0xF
+            tgt = orig_pc + _sext((word >> 5) & 0x7FFFF, 19) * 4
+            emit_fn(0x54000040 | cond)
+            emit_fn(bx_fn(here_fn(), fallthrough))
+            emit_fn(bx_fn(here_fn(), tgt))
+            return True, ''
+
+        # Compare and branch zero/nonzero: CBZ / CBNZ imm19
+        if (word & 0x7E000000) == 0x34000000:
+            tgt = orig_pc + _sext((word >> 5) & 0x7FFFF, 19) * 4
+            emit_fn((word & 0xFF00001F) | (2 << 5))
+            emit_fn(bx_fn(here_fn(), fallthrough))
+            emit_fn(bx_fn(here_fn(), tgt))
+            return True, ''
+
+        # Test bit and branch: TBZ / TBNZ imm14
+        if (word & 0x7E000000) == 0x36000000:
+            tgt = orig_pc + _sext((word >> 5) & 0x3FFF, 14) * 4
+            emit_fn((word & 0xFFF8001F) | (2 << 5))
+            emit_fn(bx_fn(here_fn(), fallthrough))
+            emit_fn(bx_fn(here_fn(), tgt))
+            return True, ''
+
+        # ADRP Xd, page
+        if (word & 0x9F000000) == 0x90000000:
+            rd = word & 0x1F
+            imm21 = (((word >> 5) & 0x7FFFF) << 2) | ((word >> 29) & 3)
+            page = (orig_pc & ~0xFFF) + (_sext(imm21, 21) << 12)
+            emit_fn(NOP if rd == 31 else ADRP(rd, here_fn(), page))
+            emit_fn(bx_fn(here_fn(), fallthrough))
+            return True, ''
+
+        # ADR Xd, target -> adrp Xd, target; add Xd, Xd, #lo
+        if (word & 0x9F000000) == 0x10000000:
+            rd = word & 0x1F
+            imm21 = (((word >> 5) & 0x7FFFF) << 2) | ((word >> 29) & 3)
+            tgt = orig_pc + _sext(imm21, 21)
+            if rd == 31:
+                emit_fn(NOP)
+            else:
+                emit_fn(ADRP(rd, here_fn(), tgt))
+                emit_fn(ADDI(rd, rd, tgt & 0xFFF))
+            emit_fn(bx_fn(here_fn(), fallthrough))
+            return True, ''
+
+        # LDR (literal): Wt, Xt, LDRSW Xt, PRFM, and SIMD/FP St, Dt, Qt
+        if (word & 0x3B000000) == 0x18000000:
+            opc = (word >> 30) & 3
+            is_fp = ((word >> 26) & 1) == 1
+            rt = word & 0x1F
+            tgt = orig_pc + _sext((word >> 5) & 0x7FFFF, 19) * 4
+            if not is_fp:
+                if opc == 3 or rt == 31:  # PRFM or xzr/wzr destination
+                    emit_fn(NOP)
+                elif opc == 0:  # LDR Wt, literal
+                    emit_fn(ADRP(rt, here_fn(), tgt))
+                    emit_fn(LDRW_UIMM(rt, rt, (tgt & 0xFFF) // 4))
+                elif opc == 1:  # LDR Xt, literal
+                    emit_fn(ADRP(rt, here_fn(), tgt))
+                    if (tgt & 7) == 0:
+                        emit_fn(LDRX(rt, rt, (tgt & 0xFFF) // 8))
+                    else:
+                        emit_fn(ADDI(rt, rt, tgt & 0xFFF))
+                        emit_fn(LDRX(rt, rt, 0))
+                else:  # opc == 2: LDRSW Xt, literal
+                    emit_fn(ADRP(rt, here_fn(), tgt))
+                    emit_fn(LDRSW_UIMM(rt, rt, (tgt & 0xFFF) // 4))
+                emit_fn(bx_fn(here_fn(), fallthrough))
+                return True, ''
+            else:
+                if opc == 3:
+                    return False, f'invalid FP literal ldr 0x{word:08x}'
+                emit_fn(STR_X_PRE(16, 31, -16))
+                emit_fn(ADRP(16, here_fn(), tgt))
+                emit_fn(ADDI(16, 16, tgt & 0xFFF))
+                emit_fn(LDR_FP_UIMM(opc, rt, 16, 0))
+                emit_fn(LDR_X_POST(16, 31, 16))
+                emit_fn(bx_fn(here_fn(), fallthrough))
+                return True, ''
+
+        # Plain position-independent instruction
+        emit_fn(word)
+        emit_fn(bx_fn(here_fn(), fallthrough))
+        return True, ''
+    except AssertionError as exc:
+        return False, f'relocation range error: {exc}'
+
+
+# ---- Code Cave detection & enhanced switch-table relocation ----
+
+def _branch_target(word: int, pc: int) -> int | None:
+    if (word & 0x7C000000) == 0x14000000:  # B / BL
+        return pc + _sext(word & 0x3FFFFFF, 26) * 4
+    if (word & 0xFF000010) == 0x54000000:  # B.cond
+        return pc + _sext((word >> 5) & 0x7FFFF, 19) * 4
+    if (word & 0x7E000000) == 0x34000000:  # CBZ / CBNZ
+        return pc + _sext((word >> 5) & 0x7FFFF, 19) * 4
+    if (word & 0x7E000000) == 0x36000000:  # TBZ / TBNZ
+        return pc + _sext((word >> 5) & 0x3FFF, 14) * 4
+    return None
+
+
+def _is_cave_padding_word(word: int) -> bool:
+    return word == 0x00000000
+
+
+# ---- Pure-Python zero-dependency AArch64 dataflow bypass safety analyzer ----
+
+@dataclass
+class A64Insn:
+    reads: set[int] = field(default_factory=set)   # 0..30 = x0..x30, 32..63 = v0..v31
+    writes: set[int] = field(default_factory=set)
+    branch_target: int | None = None
+    is_uncond_jump: bool = False
+    is_cond_branch: bool = False
+    is_return: bool = False
+    is_call: bool = False
+    unknown: bool = False
+
+
+def _gpr_zr(reg: int) -> set[int]:
+    return {reg} if 0 <= reg < 31 else set()
+
+
+def _gpr_sp(reg: int) -> set[int]:
+    return {reg} if 0 <= reg < 31 else set()
+
+
+def _reg_label(reg: int) -> str:
+    return f'x{reg}' if reg < 32 else f'v{reg - 32}'
+
+
+def decode_arm64_insn(word: int, pc: int) -> A64Insn:
+    """Decode register reads/writes and control-flow edges of common AArch64 instructions without Capstone."""
+    w = word & 0xFFFFFFFF
+
+    # Unconditional B / BL imm26
+    if (w & 0x7C000000) == 0x14000000:
+        tgt = pc + _sext(w & 0x3FFFFFF, 26) * 4
+        if (w >> 31) & 1:  # BL: clobbers caller-saved x0..x17, x30 and may read arg regs x0..x7
+            return A64Insn(
+                reads=set(range(8)),
+                writes=set(range(18)) | {30},
+                is_call=True,
+            )
+        return A64Insn(branch_target=tgt, is_uncond_jump=True)
+
+    # Conditional B.cond imm19
+    if (w & 0xFF000010) == 0x54000000:
+        tgt = pc + _sext((w >> 5) & 0x7FFFF, 19) * 4
+        cond = w & 0xF
+        if cond in (0xE, 0xF):  # B.AL / B.NV
+            return A64Insn(branch_target=tgt, is_uncond_jump=True)
+        return A64Insn(branch_target=tgt, is_cond_branch=True)
+
+    # CBZ / CBNZ Rt, imm19
+    if (w & 0x7E000000) == 0x34000000:
+        rt = w & 0x1F
+        tgt = pc + _sext((w >> 5) & 0x7FFFF, 19) * 4
+        return A64Insn(reads=_gpr_zr(rt), branch_target=tgt, is_cond_branch=True)
+
+    # TBZ / TBNZ Rt, #bit, imm14
+    if (w & 0x7E000000) == 0x36000000:
+        rt = w & 0x1F
+        tgt = pc + _sext((w >> 5) & 0x3FFF, 14) * 4
+        return A64Insn(reads=_gpr_zr(rt), branch_target=tgt, is_cond_branch=True)
+
+    # Unconditional register branch / call / return
+    if (w & 0xFFFFFC1F) == 0xD61F0000:  # BR Xn
+        return A64Insn(reads=_gpr_zr((w >> 5) & 0x1F), is_uncond_jump=True)
+    if (w & 0xFFFFFC1F) == 0xD63F0000:  # BLR Xn
+        return A64Insn(
+            reads=_gpr_zr((w >> 5) & 0x1F) | set(range(8)),
+            writes=set(range(18)) | {30},
+            is_call=True,
+        )
+    if (w & 0xFFFFFC1F) == 0xD65F0000:  # RET [Xn]
+        return A64Insn(reads=_gpr_zr((w >> 5) & 0x1F), is_return=True, is_uncond_jump=True)
+    if w in (0xD65F0BFF, 0xD65F0FFF):  # RETAA / RETAB
+        return A64Insn(reads={30}, is_return=True, is_uncond_jump=True)
+
+    # Hints / NOP / barriers
+    if (w & 0xFFFFF01F) == 0xD503201F or (w & 0xFFFFF01F) == 0xD503301F:
+        return A64Insn()
+
+    # UDF / BRK / HLT traps (do not fall through)
+    if (w & 0xFFFF0000) == 0x00000000 or (w & 0xFFE0001F) in (0xD4200000, 0xD4400000):
+        return A64Insn(is_uncond_jump=True)
+
+    # ADR / ADRP Xd, label
+    if (w & 0x1F000000) == 0x10000000:
+        return A64Insn(writes=_gpr_zr(w & 0x1F))
+
+    # ADD / ADDS / SUB / SUBS (immediate)
+    if (w & 0x1F800000) == 0x11000000:
+        rn = (w >> 5) & 0x1F
+        rd = w & 0x1F
+        return A64Insn(reads=_gpr_sp(rn), writes=_gpr_zr(rd))
+
+    # AND / ORR / EOR / ANDS (immediate, incl. MOV bitmask)
+    if (w & 0x1F800000) == 0x12000000:
+        rn = (w >> 5) & 0x1F
+        rd = w & 0x1F
+        return A64Insn(reads=_gpr_zr(rn), writes=_gpr_zr(rd))
+
+    # MOVN / MOVZ / MOVK (wide immediate)
+    if (w & 0x1F800000) == 0x12800000:
+        opc = (w >> 29) & 3
+        if opc == 1:
+            return A64Insn(unknown=True)
+        rd = w & 0x1F
+        return A64Insn(reads=_gpr_zr(rd) if opc == 3 else set(), writes=_gpr_zr(rd))
+
+    # SBFM / BFM / UBFM (bitfield, incl. LSL/LSR/ASR/SXTW/UBFX/BFI)
+    if (w & 0x1F800000) == 0x13000000:
+        opc = (w >> 29) & 3
+        if opc == 3:
+            return A64Insn(unknown=True)
+        rn = (w >> 5) & 0x1F
+        rd = w & 0x1F
+        return A64Insn(reads=_gpr_zr(rn) | (_gpr_zr(rd) if opc == 1 else set()), writes=_gpr_zr(rd))
+
+    # EXTR / ROR (immediate)
+    if (w & 0x1F800000) == 0x13800000:
+        rm = (w >> 16) & 0x1F
+        rn = (w >> 5) & 0x1F
+        rd = w & 0x1F
+        return A64Insn(reads=_gpr_zr(rn) | _gpr_zr(rm), writes=_gpr_zr(rd))
+
+    # Logical (shifted register, incl. MOV Xd, Xm / MVN / TST)
+    if (w & 0x1F000000) == 0x0A000000:
+        rm = (w >> 16) & 0x1F
+        rn = (w >> 5) & 0x1F
+        rd = w & 0x1F
+        return A64Insn(reads=_gpr_zr(rn) | _gpr_zr(rm), writes=_gpr_zr(rd))
+
+    # ADD / ADDS / SUB / SUBS (shifted or extended register, incl. CMP/CMN/NEG)
+    if (w & 0x1F000000) == 0x0B000000:
+        is_ext = ((w >> 21) & 1) == 1
+        if is_ext and ((w >> 22) & 3) != 0:
+            return A64Insn(unknown=True)
+        rm = (w >> 16) & 0x1F
+        rn = (w >> 5) & 0x1F
+        rd = w & 0x1F
+        return A64Insn(reads=(_gpr_sp(rn) if is_ext else _gpr_zr(rn)) | _gpr_zr(rm), writes=_gpr_zr(rd))
+
+    # ADC / ADCS / SBC / SBCS
+    if (w & 0x1FE00000) == 0x1A000000:
+        rm = (w >> 16) & 0x1F
+        rn = (w >> 5) & 0x1F
+        rd = w & 0x1F
+        return A64Insn(reads=_gpr_zr(rn) | _gpr_zr(rm), writes=_gpr_zr(rd))
+
+    # CCMP / CCMN (register or immediate)
+    if (w & 0x1FE00810) == 0x1A400000:
+        is_imm = ((w >> 11) & 1) == 1
+        rm = (w >> 16) & 0x1F
+        rn = (w >> 5) & 0x1F
+        return A64Insn(reads=_gpr_zr(rn) | (set() if is_imm else _gpr_zr(rm)))
+
+    # CSEL / CSINC / CSINV / CSNEG (incl. CSET / CINC / CINV / CNEG)
+    if (w & 0x1FE00000) == 0x1A800000:
+        rm = (w >> 16) & 0x1F
+        rn = (w >> 5) & 0x1F
+        rd = w & 0x1F
+        cond = (w >> 12) & 0xF
+        # CSET / CSETM encode Rn=31, Rm=31 -> _gpr_zr(31) is empty.
+        _ = cond
+        return A64Insn(reads=_gpr_zr(rn) | _gpr_zr(rm), writes=_gpr_zr(rd))
+
+    # Data-processing (2 source): UDIV / SDIV / LSLV / LSRV / ASRV / RORV
+    if (w & 0x5FE00000) == 0x1AC00000:
+        rm = (w >> 16) & 0x1F
+        rn = (w >> 5) & 0x1F
+        rd = w & 0x1F
+        return A64Insn(reads=_gpr_zr(rn) | _gpr_zr(rm), writes=_gpr_zr(rd))
+
+    # Data-processing (1 source): RBIT / REV16 / REV32 / REV / CLZ / CLS
+    if (w & 0x5FE00000) == 0x5AC00000:
+        rn = (w >> 5) & 0x1F
+        rd = w & 0x1F
+        return A64Insn(reads=_gpr_zr(rn), writes=_gpr_zr(rd))
+
+    # Data-processing (3 source): MADD / MSUB / SMADDL / SMSUBL / SMULH / UMADDL / UMSUBL / UMULH
+    if (w & 0x1F000000) == 0x1B000000:
+        rm = (w >> 16) & 0x1F
+        o0 = (w >> 15) & 1
+        ra = (w >> 10) & 0x1F
+        rn = (w >> 5) & 0x1F
+        rd = w & 0x1F
+        op31 = (w >> 21) & 7
+        use_ra = not (op31 in (2, 6) and o0 == 0)
+        return A64Insn(reads=_gpr_zr(rn) | _gpr_zr(rm) | (_gpr_zr(ra) if use_ra else set()), writes=_gpr_zr(rd))
+
+    # LDR (literal, GPR & SIMD/FP)
+    if (w & 0x3B000000) == 0x18000000:
+        opc = (w >> 30) & 3
+        is_fp = ((w >> 26) & 1) == 1
+        rt = w & 0x1F
+        if not is_fp:
+            return A64Insn(writes=set() if opc == 3 else _gpr_zr(rt))
+        if opc == 3:
+            return A64Insn(unknown=True)
+        return A64Insn(writes={32 + rt})
+
+    # Load/Store Pair: LDP / STP / LDPSW / LDNP / STNP (GPR & SIMD/FP)
+    if (w & 0x3A000000) == 0x28000000:
+        is_fp = ((w >> 26) & 1) == 1
+        op2 = (w >> 23) & 3
+        is_load = ((w >> 22) & 1) == 1
+        rt2 = (w >> 10) & 0x1F
+        rn = (w >> 5) & 0x1F
+        rt = w & 0x1F
+        wback = op2 in (1, 3)
+        rds = set(_gpr_sp(rn))
+        wrs = set(_gpr_sp(rn)) if wback else set()
+        regs = {32 + rt, 32 + rt2} if is_fp else (_gpr_zr(rt) | _gpr_zr(rt2))
+        if is_load:
+            wrs |= regs
+        else:
+            rds |= regs
+        return A64Insn(reads=rds, writes=wrs)
+
+    # Load/Store Single Register (unsigned immediate, GPR & SIMD/FP)
+    if (w & 0x3B000000) == 0x39000000:
+        size = (w >> 30) & 3
+        is_fp = ((w >> 26) & 1) == 1
+        opc = (w >> 22) & 3
+        rn = (w >> 5) & 0x1F
+        rt = w & 0x1F
+        rds = set(_gpr_sp(rn))
+        wrs: set[int] = set()
+        if not is_fp:
+            if opc == 0:
+                rds |= _gpr_zr(rt)
+            elif not (size == 3 and opc == 2):  # exclude PRFM
+                wrs |= _gpr_zr(rt)
+        else:
+            if (opc & 1) == 0:  # STR B/H/S/D (opc=0) and STR Q (size=0, opc=2)
+                rds.add(32 + rt)
+            else:
+                wrs.add(32 + rt)
+        return A64Insn(reads=rds, writes=wrs)
+
+    # Load/Store Single Register (unscaled / post-index / pre-index / unpriv / register-offset)
+    if (w & 0x3B000000) == 0x38000000:
+        size = (w >> 30) & 3
+        is_fp = ((w >> 26) & 1) == 1
+        opc = (w >> 22) & 3
+        rn = (w >> 5) & 0x1F
+        rt = w & 0x1F
+        rds = set(_gpr_sp(rn))
+        wrs = set()
+        if (w & 0x00200000) == 0:
+            mode = (w >> 10) & 3
+            if mode in (1, 3):  # post-index / pre-index writeback
+                wrs |= _gpr_sp(rn)
+        elif (w & 0x00200C00) == 0x00200800:  # register offset [Xn, Xm, extend]
+            rm = (w >> 16) & 0x1F
+            rds |= _gpr_zr(rm)
+        else:
+            return A64Insn(unknown=True)
+        if not is_fp:
+            if opc == 0:
+                rds |= _gpr_zr(rt)
+            elif not (size == 3 and opc == 2):
+                wrs |= _gpr_zr(rt)
+        else:
+            if (opc & 1) == 0:
+                rds.add(32 + rt)
+            else:
+                wrs.add(32 + rt)
+        return A64Insn(reads=rds, writes=wrs)
+
+    # Scalar FP <-> Integer conversions & FMOV between GPR and FP registers
+    if (w & 0x5F200000) == 0x1E200000 and (w & 0x0000FC00) == 0x00000000:
+        rmode = (w >> 19) & 3
+        opcode = (w >> 16) & 7
+        rn = (w >> 5) & 0x1F
+        rd = w & 0x1F
+        if opcode in (2, 3) or (opcode == 7 and rmode in (0, 1)):  # GPR -> FP (SCVTF/UCVTF/FMOV Vd, Xn)
+            return A64Insn(reads=_gpr_zr(rn), writes={32 + rd})
+        if opcode in (0, 1, 4, 5) or (opcode == 6 and rmode in (0, 1)):  # FP -> GPR (FCVT*/FMOV Xd, Vn)
+            return A64Insn(reads={32 + rn}, writes=_gpr_zr(rd))
+        return A64Insn(unknown=True)
+
+    # Scalar FP immediate FMOV Sd/Dd, #imm8
+    if (w & 0x5F201FE0) == 0x1E201000:
+        return A64Insn(writes={32 + (w & 0x1F)})
+
+    # Scalar FP 1-source (FMOV Sd, Sn / FABS / FNEG / FSQRT / FCVT)
+    if (w & 0x5F207C00) == 0x1E204000:
+        return A64Insn(reads={32 + ((w >> 5) & 0x1F)}, writes={32 + (w & 0x1F)})
+
+    # Scalar FP 2-source (FMUL / FDIV / FADD / FSUB / FMAX / FMIN)
+    if (w & 0x5F200C00) == 0x1E200800:
+        return A64Insn(reads={32 + ((w >> 5) & 0x1F), 32 + ((w >> 16) & 0x1F)}, writes={32 + (w & 0x1F)})
+
+    # Scalar FP compare (FCMP / FCMPE)
+    if (w & 0x5F203C00) == 0x1E202000:
+        opc2 = w & 0x1F
+        rds = {32 + ((w >> 5) & 0x1F)}
+        if (opc2 & 8) == 0:
+            rds.add(32 + ((w >> 16) & 0x1F))
+        return A64Insn(reads=rds)
+
+    # Scalar FP conditional select (FCSEL)
+    if (w & 0x5F200C00) == 0x1E200C00:
+        return A64Insn(reads={32 + ((w >> 5) & 0x1F), 32 + ((w >> 16) & 0x1F)}, writes={32 + (w & 0x1F)})
+
+    # SIMD MOVI / EOR vD, vN, vM (common zeroing idioms)
+    if (w & 0xBFE0FC00) == 0x0F00E400:
+        return A64Insn(writes={32 + (w & 0x1F)})
+    if (w & 0xBFF89C00) == 0x0F000400:
+        rn = (w >> 5) & 0x1F
+        rm = (w >> 16) & 0x1F
+        rd = w & 0x1F
+        return A64Insn(reads=set() if rn == rm else {32 + rn, 32 + rm}, writes={32 + rd})
+
+    return A64Insn(unknown=True)
+
+
+def _orig_depends_on_reg(orig_text: bytes, start_pc: int, reg: int, limit_end: int, max_steps: int = 256) -> bool:
+    """Return True if original code starting at `start_pc` may read `reg` before overwriting it or returning."""
+    queue = [start_pc]
+    visited: set[int] = set()
+    steps = 0
+    while queue and steps < max_steps:
+        pc = queue.pop(0)
+        if pc in visited or pc < 0 or pc + 4 > limit_end:
+            continue
+        visited.add(pc)
+        steps += 1
+        w = struct.unpack_from('<I', orig_text, pc)[0]
+        ins = decode_arm64_insn(w, pc)
+        if ins.unknown:
+            return True  # Conservative: unknown instruction might read `reg`
+        if reg in ins.reads:
+            return True
+        if reg in ins.writes:
+            continue  # Killed (written before read) along this path
+        if ins.is_return:
+            # Function return: x0/x1 or v0..v3 may hold return values if live across the epilogue;
+            # scratch/callee-saved registers unread up to `ret` are not depended upon by this block.
+            if reg in (0, 1, 32, 33):
+                return True
+            continue
+        if not ins.is_uncond_jump and pc + 4 + 4 <= limit_end:
+            queue.append(pc + 4)
+        if not ins.is_call and ins.branch_target is not None and 0 <= ins.branch_target <= limit_end - 4:
+            queue.append(ins.branch_target)
+    return False
+
+
+def _can_reach_without_write(
+    start_pc: int,
+    goal_pc: int,
+    reg: int,
+    lo_pc: int,
+    hi_pc: int,
+    word_at: Callable[[int], int],
+) -> bool:
+    """Return True if control flow from `start_pc` can reach `goal_pc` within [lo_pc, hi_pc] without writing `reg`."""
+    queue = [start_pc]
+    visited: set[int] = set()
+    while queue:
+        pc = queue.pop(0)
+        if pc in visited or pc < lo_pc or pc > hi_pc:
+            continue
+        visited.add(pc)
+        if pc == goal_pc:
+            return True
+        ins = decode_arm64_insn(word_at(pc), pc)
+        if ins.unknown or reg in ins.writes:
+            continue
+        if not ins.is_uncond_jump and pc + 4 <= hi_pc:
+            queue.append(pc + 4)
+        if not ins.is_call and ins.branch_target is not None and lo_pc <= ins.branch_target <= hi_pc:
+            queue.append(ins.branch_target)
+    return False
+
+
+def check_dataflow_bypass(
+    patch_words: list[tuple[int, int]],
+    orig_text: bytes,
+    text_end: int,
+) -> str:
+    """Conservatively detect ARM64 intra-patch register def-use bypasses.
+
+    Clusters non-cave `.text` writes with adjacent gaps <= 0x20. Reports a non-empty
+    reason string (no semicolons) when a patched write at D defines register R, a
+    downstream patched write at U reads R (while original U did not read R), and
+    original control flow can enter `(D, U]` bypassing D while original code at that
+    entry does not depend on R.
+    """
+    limit_end = min(len(orig_text), text_end)
+    effective: dict[int, int] = {}
+    for off, word in patch_words:
+        if 0 <= off <= limit_end - 4 and (off & 3) == 0:
+            orig_w = struct.unpack_from('<I', orig_text, off)[0]
+            if not _is_cave_padding_word(orig_w):
+                effective[off] = word & 0xFFFFFFFF
+
+    changed_offs = sorted(off for off, w in effective.items() if w != struct.unpack_from('<I', orig_text, off)[0])
+    if len(changed_offs) < 2:
+        return ''
+
+    # Group nearby patch offsets (gap <= 0x20) into contiguous analysis clusters.
+    clusters: list[list[int]] = [[changed_offs[0]]]
+    for off in changed_offs[1:]:
+        if off - clusters[-1][-1] <= 0x20:
+            clusters[-1].append(off)
+        else:
+            clusters.append([off])
+
+    for c_offs in clusters:
+        if len(c_offs) < 2:
+            continue
+        seg_lo, seg_hi = c_offs[0], c_offs[-1]
+        pmap = {off: effective[off] for off in c_offs}
+
+        def _orig_w(pc: int) -> int:
+            return struct.unpack_from('<I', orig_text, pc)[0]
+
+        def _patched_w(pc: int) -> int:
+            return pmap.get(pc, _orig_w(pc))
+
+        win_lo = max(0, (seg_lo - 0x1000) & ~3)
+        win_hi = min((limit_end - 4) & ~3, seg_hi + 0x1000)
+
+        # Pre-scan external original branches targeting addresses inside [seg_lo, seg_hi].
+        ext_branch_targets: set[int] = set()
+        for src_pc in range(win_lo, win_hi + 4, 4):
+            if seg_lo <= src_pc <= seg_hi:
+                continue
+            orig_src = decode_arm64_insn(_orig_w(src_pc), src_pc)
+            if not orig_src.is_call and orig_src.branch_target is not None:
+                if seg_lo <= orig_src.branch_target <= seg_hi:
+                    ext_branch_targets.add(orig_src.branch_target)
+
+        top_falls_in = seg_lo == 0 or (
+            seg_lo >= 4 and not decode_arm64_insn(_patched_w(seg_lo - 4), seg_lo - 4).is_uncond_jump
+        )
+
+        for i, d_pc in enumerate(c_offs):
+            p_def = decode_arm64_insn(pmap[d_pc], d_pc)
+            if p_def.unknown or not p_def.writes:
+                continue
+            for u_pc in c_offs[i + 1:]:
+                p_use = decode_arm64_insn(pmap[u_pc], u_pc)
+                o_use = decode_arm64_insn(_orig_w(u_pc), u_pc)
+                if p_use.unknown or o_use.unknown:
+                    continue
+                for reg in sorted(p_def.writes):
+                    if reg not in p_use.reads or reg in o_use.reads:
+                        continue
+                    # Ensure D's definition actually reaches U without being overwritten in between.
+                    def_reaches_u = False
+                    if not p_def.is_uncond_jump and d_pc + 4 <= u_pc:
+                        if _can_reach_without_write(d_pc + 4, u_pc, reg, d_pc + 4, u_pc, _patched_w):
+                            def_reaches_u = True
+                    if not def_reaches_u and not p_def.is_call and p_def.branch_target is not None:
+                        if d_pc < p_def.branch_target <= u_pc:
+                            if _can_reach_without_write(p_def.branch_target, u_pc, reg, d_pc + 4, u_pc, _patched_w):
+                                def_reaches_u = True
+                    if not def_reaches_u:
+                        continue
+
+                    # Collect candidate bypass entry points in `(d_pc, u_pc]`:
+                    # 1. External branches from `< d_pc` or `> u_pc` jumping into `(d_pc, u_pc]`
+                    bypass_entries: set[int] = {t for t in ext_branch_targets if d_pc < t <= u_pc}
+                    for src_pc in range(seg_lo, seg_hi + 4, 4):
+                        if d_pc <= src_pc <= u_pc:
+                            continue
+                        p_src = decode_arm64_insn(_patched_w(src_pc), src_pc)
+                        o_src = decode_arm64_insn(_orig_w(src_pc), src_pc)
+                        if not p_src.is_call and p_src.branch_target is not None and d_pc < p_src.branch_target <= u_pc:
+                            # Either original code already branched from src_pc into (d_pc, u_pc],
+                            # or sequential fallthrough into seg_lo reaches src_pc before d_pc.
+                            if (not o_src.is_call and o_src.branch_target == p_src.branch_target) or (
+                                top_falls_in
+                                and src_pc < d_pc
+                                and _can_reach_without_write(seg_lo, src_pc, reg, seg_lo, d_pc - 4, _patched_w)
+                            ):
+                                bypass_entries.add(p_src.branch_target)
+
+                    # 2. Sequential fallthrough across `d_pc` when `d_pc` itself is only reachable by branch
+                    # (e.g., original instruction at `d_pc - 4` jumps over `d_pc` directly into `(d_pc, u_pc]`,
+                    # already captured above, or `seg_lo < d_pc` falls into `(d_pc, u_pc]` bypassing `d_pc`).
+                    for entry_pc in sorted(bypass_entries):
+                        if not _can_reach_without_write(entry_pc, u_pc, reg, d_pc + 4, u_pc, _patched_w):
+                            continue
+                        if not _orig_depends_on_reg(orig_text, entry_pc, reg, limit_end):
+                            return f'dataflow_bypass: {_reg_label(reg)} read at +0x{u_pc:x} bypassed def at +0x{d_pc:x}'
+
+    return ''
+
+
+def _trace_cave_code(
+    cave_words: dict[int, int],
+    entry_points: set[int],
+    md: Cs,
+) -> set[int]:
+    """Trace reachable instructions inside a Code Cave starting from branch targets."""
+    code: set[int] = set()
+    todo = [a for a in entry_points if a in cave_words]
+    while todo:
+        pc = todo.pop()
+        if pc in code or pc not in cave_words:
+            continue
+        w = cave_words[pc]
+        insns = list(md.disasm(struct.pack('<I', w), pc))
+        if len(insns) != 1:
+            continue
+        ins = insns[0]
+        if ins.mnemonic == 'udf':
+            continue
+        code.add(pc)
+        m = ins.mnemonic
+        tgt = _branch_target(w, pc)
+        if m == 'b':
+            if tgt is not None and tgt in cave_words:
+                todo.append(tgt)
+        elif m in ('ret', 'br'):
+            continue
+        elif tgt is not None:
+            if tgt in cave_words:
+                todo.append(tgt)
+            if pc + 4 in cave_words:
+                todo.append(pc + 4)
+        else:
+            if pc + 4 in cave_words:
+                todo.append(pc + 4)
+    return code
+
+
+def relocate_cave_switches(
+    cave_code: dict[int, int],
+    mirrors: list[MirrorBlock],
+    cheat_state_off: int,
+    md: Cs,
+    emit_stub: Callable[[list[int], int], int] | None = None,
+    bx_fn: Callable[[int, int], int] = B,
+) -> tuple[dict[int, int], list[str]]:
+    """Rewrite cave instructions that reference relocated switch-table addresses.
+
+    Handles four AArch64 addressing forms:
+      1. adrp Xd, page + add Xm, Xd, #imm
+      2. adrp Xd, page + ldr/str/ldrb/strb/ldrh/strh/ldrsw Wt/Xt/St/Dt/Qt, [Xd, #imm]
+      3. adr  Xd, target
+      4. ldr  Wt/Xt/St/Dt/Qt, literal
+
+    `emit_stub(stub_words, orig_pc)` allocates a small out-of-line stub in patch_area
+    and returns its address (used when `adr` or `ldr literal` cannot be rewritten in-place).
+    """
+    if not mirrors:
+        return dict(cave_code), []
+
+    out = dict(cave_code)
+    notes: list[str] = []
+
+    def lookup_mirror(addr: int) -> int | None:
+        for mb in mirrors:
+            if mb.orig_off <= addr < mb.orig_off + mb.size:
+                return cheat_state_off + mb.mirror_rel + (addr - mb.orig_off)
+        return None
+
+    sorted_pcs = sorted(out)
+    pc_set = set(sorted_pcs)
+
+    def _insn_reads_writes(ins) -> tuple[set[int], set[int]]:
+        rset: set[int] = set()
+        wset: set[int] = set()
+        try:
+            rd_regs, wr_regs = ins.regs_access()
+            for reg_id in rd_regs:
+                nm = ins.reg_name(reg_id)
+                m = re.fullmatch(r'[xw](\d+)', nm or '')
+                if m:
+                    rset.add(int(m.group(1)))
+            for reg_id in wr_regs:
+                nm = ins.reg_name(reg_id)
+                m = re.fullmatch(r'[xw](\d+)', nm or '')
+                if m:
+                    wset.add(int(m.group(1)))
+        except Exception:
+            return set(range(31)), set(range(31))
+        return rset, wset
+
+    # Pass 1: detect ADRP definitions whose base register targets multiple mirror pages
+    # or is also consumed by non-mirror instructions. Such ADRP instructions must stay
+    # untouched in place, with conflicting mirror users routed through out-of-line stubs.
+    adrp_defs_p1: dict[int, tuple[int, int]] = {}
+    adrp_pages: dict[int, set[int | None]] = {}
+    for pc in sorted_pcs:
+        if (pc - 4) not in pc_set:
+            adrp_defs_p1.clear()
+        w = out[pc]
+        insns = list(md.disasm(struct.pack('<I', w), pc))
+        if len(insns) != 1:
+            adrp_defs_p1.clear()
+            continue
+        ins = insns[0]
+        mnem = ins.mnemonic
+        if (w & 0x9F000000) == 0x90000000:
+            rd = w & 0x1F
+            imm21 = (((w >> 5) & 0x7FFFF) << 2) | ((w >> 29) & 3)
+            page = (pc & ~0xFFF) + (_sext(imm21, 21) << 12)
+            if rd != 31:
+                adrp_defs_p1[rd] = (pc, page)
+            continue
+        if (w & 0xFFC00000) == 0x91000000:
+            rd = w & 0x1F
+            rn = (w >> 5) & 0x1F
+            imm12 = (w >> 10) & 0xFFF
+            if rn in adrp_defs_p1:
+                adrp_pc, base_page = adrp_defs_p1[rn]
+                new_addr = lookup_mirror(base_page + imm12)
+                adrp_pages.setdefault(adrp_pc, set()).add((new_addr & ~0xFFF) if new_addr is not None else None)
+            adrp_defs_p1.pop(rd, None)
+            continue
+        if (w & 0x3B000000) == 0x39000000:
+            rn = (w >> 5) & 0x1F
+            rt = w & 0x1F
+            imm12 = (w >> 10) & 0xFFF
+            size = (w >> 30) & 3
+            is_fp = ((w >> 26) & 1) == 1
+            opc = (w >> 22) & 3
+            scale_shift = 4 if (is_fp and size == 0 and (opc & 2)) else size
+            scale = 1 << scale_shift
+            if rn in adrp_defs_p1:
+                adrp_pc, base_page = adrp_defs_p1[rn]
+                new_addr = lookup_mirror(base_page + imm12 * scale)
+                hit_page = (new_addr & ~0xFFF) if (new_addr is not None and (new_addr % scale) == 0) else None
+                adrp_pages.setdefault(adrp_pc, set()).add(hit_page)
+            if not is_fp and opc == 0 and rt in adrp_defs_p1 and rt != rn:
+                adrp_pages.setdefault(adrp_defs_p1[rt][0], set()).add(None)
+            if not is_fp and opc != 0:
+                adrp_defs_p1.pop(rt, None)
+            continue
+        rset, wset = _insn_reads_writes(ins)
+        for r in rset:
+            if r in adrp_defs_p1:
+                adrp_pages.setdefault(adrp_defs_p1[r][0], set()).add(None)
+        if mnem in ('b', 'bl', 'br', 'blr', 'ret', 'cbz', 'cbnz', 'tbz', 'tbnz') or mnem.startswith('b.'):
+            adrp_defs_p1.clear()
+        else:
+            for r in wset:
+                adrp_defs_p1.pop(r, None)
+
+    conflicting_adrps = {apc for apc, pages in adrp_pages.items() if len(pages) > 1 or None in pages}
+
+    # Pass 2: rewrite cave references in place where safe, or route via out-of-line stubs.
+    # Track per-basic-block adrp definitions: reg -> (adrp_pc, base_page)
+    adrp_defs: dict[int, tuple[int, int]] = {}
+    adrp_rewritten: dict[int, int] = {}
+
+    for pc in sorted_pcs:
+        # Reset register tracking on non-contiguous jumps/blocks.
+        if (pc - 4) not in pc_set:
+            adrp_defs.clear()
+        w = out[pc]
+        insns = list(md.disasm(struct.pack('<I', w), pc))
+        if len(insns) != 1:
+            adrp_defs.clear()
+            continue
+        ins = insns[0]
+        mnem = ins.mnemonic
+
+        # 1. ADRP Xd, page
+        if (w & 0x9F000000) == 0x90000000:
+            rd = w & 0x1F
+            imm21 = (((w >> 5) & 0x7FFFF) << 2) | ((w >> 29) & 3)
+            page = (pc & ~0xFFF) + (_sext(imm21, 21) << 12)
+            if rd != 31:
+                adrp_defs[rd] = (pc, page)
+            continue
+
+        # 2. ADD Xd, Xn, #imm12 (no shift) paired with ADRP
+        if (w & 0xFFC00000) == 0x91000000:
+            rd = w & 0x1F
+            rn = (w >> 5) & 0x1F
+            imm12 = (w >> 10) & 0xFFF
+            if rn in adrp_defs:
+                adrp_pc, base_page = adrp_defs[rn]
+                target = base_page + imm12
+                new_addr = lookup_mirror(target)
+                if new_addr is not None:
+                    new_page = new_addr & ~0xFFF
+                    if adrp_pc in conflicting_adrps or (adrp_pc in adrp_rewritten and adrp_rewritten[adrp_pc] != new_page):
+                        if emit_stub is None or rd == 31:
+                            raise ValueError(f'cave adrp at 0x{adrp_pc:x} conflicts across mirror pages at add 0x{pc:x}')
+                        stub_pc = emit_stub([0xFFFFFFFF, rd, new_addr], pc)
+                        out[pc] = bx_fn(pc, stub_pc)
+                        notes.append(f'cave adrp+add 0x{pc:x} -> 0x{new_addr:x} (conflict stub 0x{stub_pc:x})')
+                    else:
+                        out[adrp_pc] = ADRP(rn, adrp_pc, new_page)
+                        adrp_rewritten[adrp_pc] = new_page
+                        out[pc] = ADDI(rd, rn, new_addr & 0xFFF)
+                        notes.append(f'cave adrp+add 0x{pc:x} -> 0x{new_addr:x}')
+            if rd in adrp_defs:
+                del adrp_defs[rd]
+            continue
+
+        # 3. Unsigned-offset LDR/STR/LDRB/STRB/LDRH/STRH/LDRSW/FP paired with ADRP
+        # Encoding: size(31:30) 111 V(26) 01 opc(23:22) imm12(21:10) Rn(9:5) Rt(4:0)
+        if (w & 0x3B000000) == 0x39000000:
+            rn = (w >> 5) & 0x1F
+            rt = w & 0x1F
+            imm12 = (w >> 10) & 0xFFF
+            size = (w >> 30) & 3
+            is_fp = ((w >> 26) & 1) == 1
+            opc = (w >> 22) & 3
+            scale_shift = 4 if (is_fp and size == 0 and (opc & 2)) else size
+            scale = 1 << scale_shift
+            if rn in adrp_defs:
+                adrp_pc, base_page = adrp_defs[rn]
+                target = base_page + imm12 * scale
+                new_addr = lookup_mirror(target)
+                if new_addr is not None and (new_addr % scale) == 0:
+                    new_page = new_addr & ~0xFFF
+                    if adrp_pc in conflicting_adrps or (adrp_pc in adrp_rewritten and adrp_rewritten[adrp_pc] != new_page):
+                        if emit_stub is None:
+                            raise ValueError(f'cave adrp at 0x{adrp_pc:x} conflicts across mirror pages at {mnem} 0x{pc:x}')
+                        stub_pc = emit_stub([0xFFFFFFFD, w, new_addr], pc)
+                        out[pc] = bx_fn(pc, stub_pc)
+                        notes.append(f'cave adrp+{mnem} 0x{pc:x} -> 0x{new_addr:x} (conflict stub 0x{stub_pc:x})')
+                    else:
+                        out[adrp_pc] = ADRP(rn, adrp_pc, new_page)
+                        adrp_rewritten[adrp_pc] = new_page
+                        new_imm12 = (new_addr & 0xFFF) >> scale_shift
+                        out[pc] = (w & ~(0xFFF << 10)) | (new_imm12 << 10)
+                        notes.append(f'cave adrp+{mnem} 0x{pc:x} -> 0x{new_addr:x}')
+            if not is_fp and (opc != 0) and rt in adrp_defs:
+                del adrp_defs[rt]
+            continue
+
+        # 4. ADR Xd, target
+        if (w & 0x9F000000) == 0x10000000:
+            rd = w & 0x1F
+            imm21 = (((w >> 5) & 0x7FFFF) << 2) | ((w >> 29) & 3)
+            target = pc + _sext(imm21, 21)
+            new_addr = lookup_mirror(target)
+            if new_addr is not None and rd != 31:
+                delta = new_addr - pc
+                if -(1 << 20) <= delta < (1 << 20):
+                    d = delta & 0x1FFFFF
+                    out[pc] = 0x10000000 | ((d & 3) << 29) | (((d >> 2) & 0x7FFFF) << 5) | rd
+                    notes.append(f'cave adr 0x{pc:x} -> 0x{new_addr:x} (in-place)')
+                elif emit_stub is not None:
+                    stub_pc = emit_stub([0xFFFFFFFF, rd, new_addr], pc)  # marker handled by caller
+                    out[pc] = bx_fn(pc, stub_pc)
+                    notes.append(f'cave adr 0x{pc:x} -> 0x{new_addr:x} (stub 0x{stub_pc:x})')
+            if rd in adrp_defs:
+                del adrp_defs[rd]
+            continue
+
+        # 5. LDR (literal) Wt/Xt/LDRSW/St/Dt/Qt
+        if (w & 0x3B000000) == 0x18000000:
+            opc = (w >> 30) & 3
+            is_fp = ((w >> 26) & 1) == 1
+            rt = w & 0x1F
+            target = pc + _sext((w >> 5) & 0x7FFFF, 19) * 4
+            new_addr = lookup_mirror(target)
+            if new_addr is not None and not (not is_fp and opc == 3):
+                delta = new_addr - pc
+                if -(1 << 20) <= delta < (1 << 20) and (delta & 3) == 0:
+                    out[pc] = (w & 0xFF00001F) | (((delta >> 2) & 0x7FFFF) << 5)
+                    notes.append(f'cave ldr-lit 0x{pc:x} -> 0x{new_addr:x} (in-place)')
+                elif emit_stub is not None:
+                    stub_pc = emit_stub([0xFFFFFFFE, w, new_addr], pc)
+                    out[pc] = bx_fn(pc, stub_pc)
+                    notes.append(f'cave ldr-lit 0x{pc:x} -> 0x{new_addr:x} (stub 0x{stub_pc:x})')
+            if not is_fp and rt in adrp_defs:
+                del adrp_defs[rt]
+            continue
+
+        # Branch or write clobbers tracked adrp registers
+        if mnem in ('b', 'bl', 'br', 'blr', 'ret', 'cbz', 'cbnz', 'tbz', 'tbnz') or mnem.startswith('b.'):
+            adrp_defs.clear()
+        else:
+            try:
+                _, wr = ins.regs_access()
+                for reg_id in wr:
+                    nm = ins.reg_name(reg_id)
+                    m = re.fullmatch(r'[xw](\d+)', nm or '')
+                    if m:
+                        adrp_defs.pop(int(m.group(1)), None)
+            except Exception:
+                adrp_defs.clear()
+
+    return out, notes
+
+
+def build_plan(
+    entries: list[CheatEntry],
+    orig_text: bytes,
+    build_id: str,
+    text_end: int,
+    protected_offsets: set[int] | None = None,
+) -> BakePlan:
+    """Analyze parsed cheat entries against orig_text and plan cave code, mirrors, and trampolines."""
+    rx_end = (text_end + 0x3FFF) & ~0x3FFF
+    analyze_entries(entries, rx_end)
+    protected = protected_offsets or set()
+    md = Cs(CS_ARCH_ARM64, CS_MODE_ARM)
+    md.detail = True
+
+    plan = BakePlan(
+        build_id=build_id[:16].upper(),
+        full_build_id=build_id.lower(),
+        text_end=text_end,
+        rx_end=rx_end,
+        entries=entries,
+    )
+
+    # First pass: collect candidate .text word writes per entry.
+    entry_words: dict[str, list[tuple[int, int, bool, int]]] = {}  # cheat_key -> [(off, u32, cond, key_mask)]
+    zero_writes: dict[int, set[int]] = {}
+    zero_writers: dict[int, list[str]] = {}
+    branch_into_zero: set[int] = set()
+
+    for ent in entries:
+        if ent.label:
+            ent.kind = 'data'
+            continue
+        if ent.broken:
+            ent.kind = 'unbaked_code' if ent.writes else 'data'
+            ent.detail = ent.broken_why
+            continue
+        if not ent.writes:
+            if ent.has_dynamic_text_write:
+                ent.kind = 'unbaked_code'
+                ent.detail = 'dynamic register offset cannot be baked statically'
+                plan.skipped.append((ent.cheat_key, ent.detail))
+            else:
+                ent.kind = 'data'
+            continue
+        if ent.has_dynamic_text_write:
+            ent.kind = 'unbaked_code'
+            ent.detail = 'mixes static and dynamic register .text writes'
+            plan.skipped.append((ent.cheat_key, ent.detail))
+            continue
+
+        expanded: list[tuple[int, int, bool, int]] = []
+        bad_reason = ''
+        for sw in ent.writes:
+            pairs = _expand_word_writes(sw, orig_text)
+            if pairs is None:
+                bad_reason = f'unaligned or out-of-range .text write at 0x{sw.offset:x}'
+                break
+            for off, word in pairs:
+                if off in protected:
+                    bad_reason = f'conflict with rewriter site at 0x{off:x}'
+                    break
+                expanded.append((off, word, sw.conditional, sw.key_mask))
+            if bad_reason:
+                break
+
+        if bad_reason:
+            ent.kind = 'unbaked_code'
+            ent.detail = bad_reason
+            plan.skipped.append((ent.cheat_key, bad_reason))
+            continue
+
+        bypass_reason = check_dataflow_bypass([(off, word) for off, word, _, _ in expanded], orig_text, text_end)
+        if bypass_reason:
+            ent.kind = 'unsafe_code'
+            ent.detail = bypass_reason
+            plan.skipped.append((ent.cheat_key, bypass_reason))
+            continue
+
+        entry_words[ent.cheat_key] = expanded
+        for off, word, _, _ in expanded:
+            orig_w = struct.unpack_from('<I', orig_text, off)[0]
+            if _is_cave_padding_word(orig_w):
+                zero_writes.setdefault(off, set()).add(word)
+                zero_writers.setdefault(off, []).append(ent.cheat_key)
+            else:
+                tgt = _branch_target(word, off)
+                if tgt is not None and 0 <= tgt < text_end - 3:
+                    if _is_cave_padding_word(struct.unpack_from('<I', orig_text, tgt)[0]):
+                        branch_into_zero.add(tgt)
+
+    # Identify Code Cave code vs. Code Cave switch/data words.
+    single_zero_words = {off: next(iter(vals)) for off, vals in zero_writes.items() if len(vals) == 1}
+    cave_code_addrs = _trace_cave_code(single_zero_words, branch_into_zero, md)
+
+    # Also treat contiguous decodable non-zero instruction blocks starting at a branch target
+    # or referenced only once with a valid instruction when there is a branch into the cave.
+    cave_data_addrs: set[int] = set()
+    if branch_into_zero:
+        # Any zero-padding word written with multiple values, or not reachable as code while
+        # sitting near cave_code_addrs (within 64 KB), is a candidate switch/data word.
+        cave_min = min(cave_code_addrs) if cave_code_addrs else 0
+        cave_max = max(cave_code_addrs) if cave_code_addrs else 0
+        for off, vals in sorted(zero_writes.items()):
+            if off in cave_code_addrs:
+                continue
+            if len(vals) > 1 or (cave_code_addrs and cave_min - 0x10000 <= off <= cave_max + 0x10000):
+                cave_data_addrs.add(off)
+
+    # Pack contiguous cave_data_addrs into MirrorBlocks in the 12 KB mirror area.
+    mirror_cursor = 0
+    mirror_addr_set: set[int] = set()
+    if cave_data_addrs:
+        runs: list[list[int]] = []
+        for off in sorted(cave_data_addrs):
+            if runs and off == runs[-1][1]:
+                runs[-1][1] = off + 4
+            else:
+                runs.append([off, off + 4])
+        for lo, hi in runs:
+            sz = hi - lo
+            # Align mirror block to 16 bytes so 128-bit Qt (and all smaller) loads stay aligned.
+            aligned_cur = (mirror_cursor + 15) & ~15
+            if aligned_cur + sz > CHEAT_MIRROR_SIZE:
+                plan.skipped.append(('code_cave_mirror', f'mirror area overflow at 0x{lo:x} ({sz} bytes)'))
+                continue
+            init = bytearray()
+            keys: list[str] = []
+            for a in range(lo, hi, 4):
+                # Default initial value is 0 (original cave padding); single-value static master writes
+                # still get driven at runtime or initialized via mirror row.
+                init.extend(struct.pack('<I', 0))
+                for ck in zero_writers.get(a, ()):
+                    if ck not in keys:
+                        keys.append(ck)
+                mirror_addr_set.add(a)
+            plan.mirrors.append(MirrorBlock(
+                orig_off=lo,
+                mirror_rel=CHEAT_MIRROR_OFFSET + aligned_cur,
+                size=sz,
+                init_bytes=bytes(init),
+                cheat_keys=keys,
+            ))
+            mirror_cursor = aligned_cur + sz
+    plan.mirror_bytes = mirror_cursor
+
+    for off in sorted(cave_code_addrs):
+        plan.cave_code[off] = single_zero_words[off]
+        plan.cave_owners[off] = zero_writers.get(off, ['code_cave'])[0]
+        plan.cave_orig_words[off] = struct.unpack_from('<I', orig_text, off)[0]
+
+    # Second pass: validate relocatability of all non-cave, non-mirror patch sites and register variants.
+    site_variants: dict[int, list[int]] = {}
+    for ent in entries:
+        if ent.cheat_key not in entry_words:
+            continue
+        words_list = entry_words[ent.cheat_key]
+        any_cond = any(cond for _, _, cond, _ in words_list)
+        bad_reason = ''
+        ent_patch_sites: list[tuple[int, int]] = []
+        ent_noop_sites: list[tuple[int, int]] = []
+        for off, word, _, _ in words_list:
+            if off in cave_code_addrs or off in mirror_addr_set:
+                continue
+            orig_w = struct.unpack_from('<I', orig_text, off)[0]
+            if word == orig_w:
+                # Restoring original word (e.g. an "- off" or standalone restore cheat): no variant needed.
+                ent_noop_sites.append((off, orig_w))
+                continue
+            ok_orig, why_orig = is_relocatable_insn(orig_w, off, md)
+            if not ok_orig:
+                bad_reason = f'original insn at 0x{off:x} not relocatable: {why_orig}'
+                break
+            ok_new, why_new = is_relocatable_insn(word, off, md)
+            if not ok_new:
+                bad_reason = f'patched insn at 0x{off:x} not relocatable: {why_new}'
+                break
+            ent_patch_sites.append((off, word))
+
+        if bad_reason:
+            ent.kind = 'unbaked_code'
+            ent.detail = bad_reason
+            plan.skipped.append((ent.cheat_key, bad_reason))
+            continue
+
+        # Check variant limit per site before committing.
+        over_limit = False
+        for off, word in ent_patch_sites:
+            cur_list = site_variants.get(off, [])
+            if word not in cur_list and len(cur_list) >= MAX_VARIANTS_PER_SITE:
+                bad_reason = f'over {MAX_VARIANTS_PER_SITE} variants at 0x{off:x}'
+                over_limit = True
+                break
+        if over_limit:
+            ent.kind = 'unbaked_code'
+            ent.detail = bad_reason
+            plan.skipped.append((ent.cheat_key, bad_reason))
+            continue
+
+        for off, word in ent_patch_sites:
+            vlist = site_variants.setdefault(off, [])
+            if word not in vlist:
+                vlist.append(word)
+        for off, orig_w in ent_noop_sites:
+            plan.cave_noops.setdefault(off, (orig_w, ent.cheat_key))
+
+        ent.kind = 'baked_conditional' if any_cond else 'baked_static'
+
+    plan.patch_sites = site_variants
+    return plan
+
+
+def emit_trampolines(
+    plan: BakePlan,
+    img: bytearray,
+    orig_text: bytes,
+    cheat_state_off: int,
+    use_area_fn: Callable[[int], None],
+    here_fn: Callable[[], int],
+    emit_fn: Callable[[int], None],
+    bx_fn: Callable[[int, int], int],
+    put_branch_fn: Callable[[int, int], None],
+    patch_buf_getter: Callable[[], tuple[bytearray, int]],
+) -> None:
+    """Emit all NZCV-preserving trampolines for `plan` and populate `plan.baked_sites`.
+
+    `patch_buf_getter()` returns `(active_patch_bytearray, active_patch_base)` so
+    forward branch placeholders inside each trampoline can be patched in place.
+    """
+    assert cheat_state_off % 0x4000 == 0
+    plan.cheat_state_off = cheat_state_off
+    md = Cs(CS_ARCH_ARM64, CS_MODE_ARM)
+    md.detail = True
+
+    # Build quick lookup from (off, word) -> owning entries.
+    # Assign slots: sites sharing the exact same single owner can share one slot_id!
+    # Sites with multiple variants get their own dedicated slot (1 byte for <=8 variants,
+    # 4-byte aligned group of 4 bytes for 9..32 variants).
+    site_owners: dict[tuple[int, int], list[CheatEntry]] = {}
+    for ent in plan.entries:
+        if ent.kind not in ('baked_static', 'baked_conditional'):
+            continue
+        for sw in ent.writes:
+            pairs = _expand_word_writes(sw, orig_text) or []
+            for off, word in pairs:
+                if off in plan.patch_sites and word in plan.patch_sites[off]:
+                    site_owners.setdefault((off, word), []).append(ent)
+
+    next_slot = 0
+    shared_single_slot: dict[tuple[str, ...], int] = {}
+    # off -> (base_slot, nbytes, list_of_variants)
+    site_slot_info: dict[int, tuple[int, int, list[int]]] = {}
+
+    for off in sorted(plan.patch_sites):
+        variants = plan.patch_sites[off]
+        nvar = len(variants)
+        if nvar == 1:
+            owners = tuple(sorted({e.cheat_key for e in site_owners.get((off, variants[0]), ())}))
+            # Conditional sites that belong to the exact same conditional cheat(s) share 1 slot
+            # ONLY if they are unconditional; conditional writes inside different if/else branches
+            # of the same cheat must NOT share a slot unless they write the same site.
+            all_static = all(e.kind == 'baked_static' for e in site_owners.get((off, variants[0]), ()))
+            if owners and all_static and owners in shared_single_slot:
+                slot = shared_single_slot[owners]
+            else:
+                if next_slot >= MAX_SLOTS:
+                    plan.skipped.append((f'0x{off:x}', f'exceeded {MAX_SLOTS} cheat slots'))
+                    continue
+                slot = next_slot
+                next_slot += 1
+                if owners and all_static:
+                    shared_single_slot[owners] = slot
+            site_slot_info[off] = (slot, 1, variants)
+        elif nvar <= 8:
+            if next_slot >= MAX_SLOTS:
+                plan.skipped.append((f'0x{off:x}', f'exceeded {MAX_SLOTS} cheat slots'))
+                continue
+            slot = next_slot
+            next_slot += 1
+            site_slot_info[off] = (slot, 1, variants)
+        else:
+            aligned = (next_slot + 3) & ~3
+            if aligned + 4 > MAX_SLOTS:
+                plan.skipped.append((f'0x{off:x}', f'exceeded {MAX_SLOTS} cheat slots'))
+                continue
+            site_slot_info[off] = (aligned, 4, variants)
+            next_slot = aligned + 4
+
+    plan.slots_used = next_slot
+
+    # Emit trampolines in ascending site order.
+    for off in sorted(site_slot_info):
+        base_slot, nbytes, variants = site_slot_info[off]
+        orig_w = struct.unpack_from('<I', orig_text, off)[0]
+        use_area_fn(off)
+        tramp_start = here_fn()
+
+        # Prologue: save x16 on stack (16-byte aligned, above sp -> safe against signals),
+        # load state slot without touching NZCV!
+        emit_fn(STR_X_PRE(16, 31, -16))
+        emit_fn(ADRP(16, here_fn(), cheat_state_off))
+        if nbytes == 1:
+            emit_fn(LDRB_UIMM(16, 16, base_slot))
+        else:
+            emit_fn(LDRW_UIMM(16, 16, base_slot >> 2))
+
+        pbuf, pbase = patch_buf_getter()
+        if len(variants) == 1:
+            # Fast single-variant path: cbnz w16, patch_0
+            branch_idx = len(pbuf)
+            emit_fn(NOP)  # placeholder for CBNZW
+            emit_fn(LDR_X_POST(16, 31, 16))
+            ok, why = relocate_insn(orig_w, off, here_fn, emit_fn, bx_fn, md)
+            assert ok, f'unexpected orig relocation failure at 0x{off:x}: {why}'
+            patch0_pc = here_fn()
+            struct.pack_into('<I', pbuf, branch_idx, CBNZW(16, pbase + branch_idx, patch0_pc))
+            emit_fn(LDR_X_POST(16, 31, 16))
+            ok, why = relocate_insn(variants[0], off, here_fn, emit_fn, bx_fn, md)
+            assert ok, f'unexpected variant relocation failure at 0x{off:x}: {why}'
+        else:
+            # Multi-variant NZCV-preserving dispatch:
+            #   cbz w16, orig_path
+            #   tbnz w16, #0, patch_0
+            #   ...
+            #   tbnz w16, #(k-1), patch_{k-1}
+            # orig_path:
+            #   ldr x16, [sp], #16; <orig>; b off+4
+            cbz_idx = len(pbuf)
+            emit_fn(NOP)
+            tbnz_idxs: list[int] = []
+            for bit in range(len(variants)):
+                tbnz_idxs.append(len(pbuf))
+                emit_fn(NOP)
+            orig_pc_tramp = here_fn()
+            struct.pack_into('<I', pbuf, cbz_idx, CBZW(16, pbase + cbz_idx, orig_pc_tramp))
+            emit_fn(LDR_X_POST(16, 31, 16))
+            ok, why = relocate_insn(orig_w, off, here_fn, emit_fn, bx_fn, md)
+            assert ok, f'unexpected orig relocation failure at 0x{off:x}: {why}'
+            for bit, vword in enumerate(variants):
+                v_pc = here_fn()
+                tidx = tbnz_idxs[bit]
+                struct.pack_into('<I', pbuf, tidx, TBNZW(16, bit, pbase + tidx, v_pc))
+                emit_fn(LDR_X_POST(16, 31, 16))
+                ok, why = relocate_insn(vword, off, here_fn, emit_fn, bx_fn, md)
+                assert ok, f'unexpected variant relocation failure at 0x{off:x}: {why}'
+
+        put_branch_fn(off, tramp_start)
+
+        # Record baked site metadata for every owning cheat entry.
+        for bit, vword in enumerate(variants):
+            byte_slot = base_slot + (bit // 8)
+            vmask = 1 << (bit % 8)
+            for ent in site_owners.get((off, vword), ()):
+                plan.baked_sites.append(BakedSite(
+                    cheat_key=ent.cheat_key,
+                    name=ent.name,
+                    kind=ent.kind,
+                    slot_id=byte_slot,
+                    variant_mask=vmask,
+                    target_off=off,
+                    patched_word=vword,
+                    key_mask=ent.key_mask,
+                    orig_word=orig_w,
+                    group_base=base_slot,
+                    group_bytes=nbytes,
+                ))
+
+
+def format_trampolines_tsv(plan: BakePlan) -> str:
+    """Serialize BakePlan into dm/cheat_trampolines.tsv for runtime VM and UI metadata."""
+    lines = [
+        f'# BUILD_ID\t{plan.build_id}',
+        f'# FULL_BUILD_ID\t{plan.full_build_id}',
+        f'# MAIN_RX_END\t{plan.rx_end:#x}',
+        f'# CHEAT_STATE_OFF\t{plan.cheat_state_off:#x}',
+        f'# SLOTS_USED\t{plan.slots_used}',
+        f'# MIRROR_BYTES\t{plan.mirror_bytes}',
+        'row_type\tname\tcheat_key\tkind\tslot_id\tvariant_mask\ttarget_off\tpatched_word\tkey_mask\tdetail',
+    ]
+
+    first_site_by_key: dict[str, BakedSite] = {}
+    for bs in plan.baked_sites:
+        first_site_by_key.setdefault(bs.cheat_key, bs)
+
+    def _clean(s: str) -> str:
+        return s.replace('\t', ' ').replace('\r', ' ').replace('\n', ' ')
+
+    for ent in plan.entries:
+        if ent.label:
+            continue
+        fs = first_site_by_key.get(ent.cheat_key)
+        slot_id = fs.slot_id if fs else -1
+        vmask = fs.variant_mask if fs else 0
+        toff = fs.target_off if fs else (ent.writes[0].offset if ent.writes else 0)
+        pword = fs.patched_word if fs else (ent.writes[0].value & 0xFFFFFFFF if ent.writes else 0)
+        lines.append(
+            f'entry\t{_clean(ent.name)}\t{_clean(ent.cheat_key)}\t{ent.kind}\t'
+            f'{slot_id}\t{vmask:#x}\t{toff:#x}\t{pword:#x}\t{ent.key_mask:#x}\t{_clean(ent.detail)}'
+        )
+
+    for bs in plan.baked_sites:
+        parts = [f'orig=0x{bs.orig_word:08x}']
+        if bs.group_bytes > 1:
+            parts.append(f'group={bs.group_base}:{bs.group_bytes}')
+        detail = ' '.join(parts)
+        lines.append(
+            f'site\t{_clean(bs.name)}\t{_clean(bs.cheat_key)}\t{bs.kind}\t'
+            f'{bs.slot_id}\t{bs.variant_mask:#x}\t{bs.target_off:#x}\t{bs.patched_word:#x}\t{bs.key_mask:#x}\t{detail}'
+        )
+
+    for off, word in sorted(plan.cave_code.items()):
+        ckey = plan.cave_owners.get(off, 'code_cave')
+        ow = plan.cave_orig_words.get(off, 0)
+        lines.append(
+            f'cave\t{_clean(ckey)}\t{_clean(ckey)}\tbaked_static\t-1\t0x0\t'
+            f'{off:#x}\t{word:#x}\t0x0\torig=0x{ow:08x}'
+        )
+
+    for off, (orig_w, ckey) in sorted(plan.cave_noops.items()):
+        if off in plan.patch_sites or off in plan.cave_code:
+            continue
+        lines.append(
+            f'cave\t{_clean(ckey)}\t{_clean(ckey)}\tbaked_static\t-1\t0x0\t'
+            f'{off:#x}\t{orig_w:#x}\t0x0\torig=0x{orig_w:08x}'
+        )
+
+    for mb in plan.mirrors:
+        ckey = mb.cheat_keys[0] if mb.cheat_keys else 'cave_mirror'
+        lines.append(
+            f'mirror\t{_clean(ckey)}\t{_clean(ckey)}\tbaked_static\t-1\t0x0\t'
+            f'{mb.orig_off:#x}\t{mb.mirror_rel:#x}\t0x0\tsize={mb.size} init={mb.init_bytes.hex()}'
+        )
+
+    return '\n'.join(lines) + '\n'
+
+
+def write_trampolines_tsv(plan: BakePlan, path: str | os.PathLike[str]) -> None:
+    Path(path).write_text(format_trampolines_tsv(plan), encoding='utf-8')
+
+
+def emit_cave_reloc_stub(
+    stub_desc: list[int],
+    orig_pc: int,
+    here_fn: Callable[[], int],
+    emit_fn: Callable[[int], None],
+    bx_fn: Callable[[int, int], int],
+) -> int:
+    """Emit an out-of-line patch_area stub for out-of-range or conflicting cave mirror refs."""
+    kind = stub_desc[0]
+    start = here_fn()
+    if kind == 0xFFFFFFFF:  # adr Xd, new_addr (or conflicting adrp+add)
+        rd, new_addr = stub_desc[1], stub_desc[2]
+        emit_fn(ADRP(rd, here_fn(), new_addr))
+        emit_fn(ADDI(rd, rd, new_addr & 0xFFF))
+        emit_fn(bx_fn(here_fn(), orig_pc + 4))
+    elif kind == 0xFFFFFFFD:  # conflicting adrp + unsigned-offset ldr/str
+        w, new_addr = stub_desc[1], stub_desc[2]
+        is_fp = ((w >> 26) & 1) == 1
+        rt = w & 0x1F
+        tmp = 17 if (not is_fp and rt == 16) else 16
+        emit_fn(STR_X_PRE(tmp, 31, -16))
+        emit_fn(ADRP(tmp, here_fn(), new_addr))
+        emit_fn(ADDI(tmp, tmp, new_addr & 0xFFF))
+        emit_fn((w & ~((0xFFF << 10) | (0x1F << 5))) | (tmp << 5))
+        emit_fn(LDR_X_POST(tmp, 31, 16))
+        emit_fn(bx_fn(here_fn(), orig_pc + 4))
+    else:  # 0xFFFFFFFE: ldr literal -> adrp + ldr
+        w, new_addr = stub_desc[1], stub_desc[2]
+        opc = (w >> 30) & 3
+        is_fp = ((w >> 26) & 1) == 1
+        rt = w & 0x1F
+        if not is_fp:
+            if opc == 0:
+                emit_fn(ADRP(rt, here_fn(), new_addr))
+                emit_fn(LDRW_UIMM(rt, rt, (new_addr & 0xFFF) // 4))
+            elif opc == 1:
+                emit_fn(ADRP(rt, here_fn(), new_addr))
+                if (new_addr & 7) == 0:
+                    emit_fn(LDRX(rt, rt, (new_addr & 0xFFF) // 8))
+                else:
+                    emit_fn(ADDI(rt, rt, new_addr & 0xFFF))
+                    emit_fn(LDRX(rt, rt, 0))
+            else:
+                emit_fn(ADRP(rt, here_fn(), new_addr))
+                emit_fn(LDRSW_UIMM(rt, rt, (new_addr & 0xFFF) // 4))
+        else:
+            emit_fn(STR_X_PRE(16, 31, -16))
+            emit_fn(ADRP(16, here_fn(), new_addr))
+            emit_fn(ADDI(16, 16, new_addr & 0xFFF))
+            emit_fn(LDR_FP_UIMM(opc, rt, 16, 0))
+            emit_fn(LDR_X_POST(16, 31, 16))
+        emit_fn(bx_fn(here_fn(), orig_pc + 4))
+    return start
