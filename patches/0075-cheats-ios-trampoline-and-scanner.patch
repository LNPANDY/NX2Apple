+def format_trampolines_tsv(plan: BakePlan) -> str:
+    """Serialize BakePlan into dm/cheat_trampolines.tsv for runtime VM and UI metadata."""
+    lines = [
+        f'# BUILD_ID\t{plan.build_id}',
+        f'# FULL_BUILD_ID\t{plan.full_build_id}',
+        f'# MAIN_RX_END\t{plan.rx_end:#x}',
+        f'# CHEAT_STATE_OFF\t{plan.cheat_state_off:#x}',
+        f'# SLOTS_USED\t{plan.slots_used}',
+        f'# MIRROR_BYTES\t{plan.mirror_bytes}',
+        'row_type\tname\tcheat_key\tkind\tslot_id\tvariant_mask\ttarget_off\tpatched_word\tkey_mask\tdetail',
+    ]
+
+    first_site_by_key: dict[str, BakedSite] = {}
+    for bs in plan.baked_sites:
+        first_site_by_key.setdefault(bs.cheat_key, bs)
+
+    def _clean(s: str) -> str:
+        return s.replace('\t', ' ').replace('\r', ' ').replace('\n', ' ')
+
+    for ent in plan.entries:
+        if ent.label:
+            continue
+        fs = first_site_by_key.get(ent.cheat_key)
+        slot_id = fs.slot_id if fs else -1
+        vmask = fs.variant_mask if fs else 0
+        toff = fs.target_off if fs else (ent.writes[0].offset if ent.writes else 0)
+        pword = fs.patched_word if fs else (ent.writes[0].value & 0xFFFFFFFF if ent.writes else 0)
+        lines.append(
+            f'entry\t{_clean(ent.name)}\t{_clean(ent.cheat_key)}\t{ent.kind}\t'
+            f'{slot_id}\t{vmask:#x}\t{toff:#x}\t{pword:#x}\t{ent.key_mask:#x}\t{_clean(ent.detail)}'
+        )
+
+    for bs in plan.baked_sites:
+        parts = [f'orig=0x{bs.orig_word:08x}']
+        if bs.group_bytes > 1:
+            parts.append(f'group={bs.group_base}:{bs.group_bytes}')
+        detail = ' '.join(parts)
+        lines.append(
+            f'site\t{_clean(bs.name)}\t{_clean(bs.cheat_key)}\t{bs.kind}\t'
+            f'{bs.slot_id}\t{bs.variant_mask:#x}\t{bs.target_off:#x}\t{bs.patched_word:#x}\t{bs.key_mask:#x}\t{detail}'
+        )
+
+    for off, word in sorted(plan.cave_code.items()):
+        ckey = plan.cave_owners.get(off, 'code_cave')
+        ow = plan.cave_orig_words.get(off, 0)
+        lines.append(
+            f'cave\t{_clean(ckey)}\t{_clean(ckey)}\tbaked_static\t-1\t0x0\t'
+            f'{off:#x}\t{word:#x}\t0x0\torig=0x{ow:08x}'
+        )
+
+    for off, (orig_w, ckey) in sorted(plan.cave_noops.items()):
+        if off in plan.patch_sites or off in plan.cave_code:
+            continue
+        lines.append(
+            f'cave\t{_clean(ckey)}\t{_clean(ckey)}\tbaked_static\t-1\t0x0\t'
+            f'{off:#x}\t{orig_w:#x}\t0x0\torig=0x{orig_w:08x}'
+        )
+
+    for mb in plan.mirrors:
+        ckey = mb.cheat_keys[0] if mb.cheat_keys else 'cave_mirror'
+        lines.append(
+            f'mirror\t{_clean(ckey)}\t{_clean(ckey)}\tbaked_static\t-1\t0x0\t'
+            f'{mb.orig_off:#x}\t{mb.mirror_rel:#x}\t0x0\tsize={mb.size} init={mb.init_bytes.hex()}'
+        )
+
+    return '\n'.join(lines) + '\n'
+
+
+def write_trampolines_tsv(plan: BakePlan, path: str | os.PathLike[str]) -> None:
+    Path(path).write_text(format_trampolines_tsv(plan), encoding='utf-8')
+
+
+def emit_cave_reloc_stub(
+    stub_desc: list[int],
+    orig_pc: int,
+    here_fn: Callable[[], int],
+    emit_fn: Callable[[int], None],
+    bx_fn: Callable[[int, int], int],
+) -> int:
+    """Emit an out-of-line patch_area stub for out-of-range or conflicting cave mirror refs."""
+    kind = stub_desc[0]
+    start = here_fn()
+    if kind == 0xFFFFFFFF:  # adr Xd, new_addr (or conflicting adrp+add)
+        rd, new_addr = stub_desc[1], stub_desc[2]
+        emit_fn(ADRP(rd, here_fn(), new_addr))
+        emit_fn(ADDI(rd, rd, new_addr & 0xFFF))
+        emit_fn(bx_fn(here_fn(), orig_pc + 4))
+    elif kind == 0xFFFFFFFD:  # conflicting adrp + unsigned-offset ldr/str
+        w, new_addr = stub_desc[1], stub_desc[2]
+        is_fp = ((w >> 26) & 1) == 1
+        rt = w & 0x1F
+        tmp = 17 if (not is_fp and rt == 16) else 16
+        emit_fn(STR_X_PRE(tmp, 31, -16))
+        emit_fn(ADRP(tmp, here_fn(), new_addr))
+        emit_fn(ADDI(tmp, tmp, new_addr & 0xFFF))
+        emit_fn((w & ~((0xFFF << 10) | (0x1F << 5))) | (tmp << 5))
+        emit_fn(LDR_X_POST(tmp, 31, 16))
+        emit_fn(bx_fn(here_fn(), orig_pc + 4))
+    else:  # 0xFFFFFFFE: ldr literal -> adrp + ldr
+        w, new_addr = stub_desc[1], stub_desc[2]
+        opc = (w >> 30) & 3
+        is_fp = ((w >> 26) & 1) == 1
+        rt = w & 0x1F
+        if not is_fp:
+            if opc == 0:
+                emit_fn(ADRP(rt, here_fn(), new_addr))
+                emit_fn(LDRW_UIMM(rt, rt, (new_addr & 0xFFF) // 4))
+            elif opc == 1:
+                emit_fn(ADRP(rt, here_fn(), new_addr))
+                if (new_addr & 7) == 0:
+                    emit_fn(LDRX(rt, rt, (new_addr & 0xFFF) // 8))
+                else:
+                    emit_fn(ADDI(rt, rt, new_addr & 0xFFF))
+                    emit_fn(LDRX(rt, rt, 0))
+            else:
+                emit_fn(ADRP(rt, here_fn(), new_addr))
+                emit_fn(LDRSW_UIMM(rt, rt, (new_addr & 0xFFF) // 4))
+        else:
+            emit_fn(STR_X_PRE(16, 31, -16))
+            emit_fn(ADRP(16, here_fn(), new_addr))
+            emit_fn(ADDI(16, 16, new_addr & 0xFFF))
+            emit_fn(LDR_FP_UIMM(opc, rt, 16, 0))
+            emit_fn(LDR_X_POST(16, 31, 16))
+        emit_fn(bx_fn(here_fn(), orig_pc + 4))
+    return start
