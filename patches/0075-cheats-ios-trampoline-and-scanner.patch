+"""Unit tests for dm/tools/cheat_bake.py: AArch64 NZCV-preserving trampolines,
+PC-relative instruction relocation, multi-variant (>8) dispatch, key-mask
+extraction, EdiZon/Zing sections, protected-site conflict skipping, and
+enhanced Code Cave switch-table relocation. No game files required.
+"""
+from pathlib import Path
+import hashlib
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from capstone import CS_ARCH_ARM64, CS_MODE_ARM, Cs
+
+REPO = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPO / 'dm/tools'))
+import cheat_bake as cb  # noqa: E402
+from nso_asm import ADDI, ADRP, B, BL, NOP  # noqa: E402
+
+MD = Cs(CS_ARCH_ARM64, CS_MODE_ARM)
+MD.detail = True
+
+
+def dis_all(buf: bytes, base: int) -> list:
+    return list(MD.disasm(buf, base))
+
+
+def run_bake_synthetic(
+    cheat_text: str,
+    orig_words: dict[int, int],
+    *,
+    text_end: int = 0x4000,
+    cheat_state_off: int = 0x10000,
+    patch_base: int = 0x20000,
+    protected: set[int] | None = None,
+):
+    """Run build_plan + cave relocation + emit_trampolines on a synthetic main image."""
+    img = bytearray(text_end)
+    # Fill default text with harmless `add x0, x0, #1` (0x91000400) so non-cave slots are valid code.
+    for off in range(0, text_end, 4):
+        struct.pack_into('<I', img, off, 0x91000400)
+    for off, w in orig_words.items():
+        struct.pack_into('<I', img, off, w)
+    orig_text = bytes(img)
+
+    entries = cb.parse_cheat_text(cheat_text)
+    plan = cb.build_plan(entries, orig_text, '1122334455667788aabbccddeeff0011', text_end, protected_offsets=protected)
+
+    patch = bytearray()
+
+    def use_area(_a: int) -> None:
+        pass
+
+    def here() -> int:
+        return patch_base + len(patch)
+
+    def emit(w: int) -> None:
+        patch.extend(struct.pack('<I', w & 0xFFFFFFFF))
+
+    def bx(frm: int, to: int) -> int:
+        return B(frm, to)
+
+    def put_branch(at: int, to: int) -> None:
+        struct.pack_into('<I', img, at, B(at, to))
+
+    # Write cave code and relocate switches if any.
+    for coff, cword in plan.cave_code.items():
+        struct.pack_into('<I', img, coff, cword)
+
+    cave_notes: list[str] = []
+    if plan.cave_code and plan.mirrors:
+        def emit_stub(desc: list[int], orig_pc: int) -> int:
+            return cb.emit_cave_reloc_stub(desc, orig_pc, here, emit, bx)
+
+        reloc_cave, cave_notes = cb.relocate_cave_switches(
+            plan.cave_code, plan.mirrors, cheat_state_off, MD, emit_stub=emit_stub, bx_fn=bx,
+        )
+        for coff, cword in reloc_cave.items():
+            struct.pack_into('<I', img, coff, cword)
+
+    if plan.needs_state_page:
+        cb.emit_trampolines(
+            plan, img, orig_text, cheat_state_off,
+            use_area, here, emit, bx, put_branch, lambda: (patch, patch_base),
+        )
+    return plan, img, patch, patch_base, cave_notes
+
+
+class CheatBakeTests(unittest.TestCase):
+    def test_parse_edizon_and_zing_sections_and_duplicates(self):
+        txt = (
+            '[--SectionStart:Combat--]\n'
+            '[God Mode]\n04000000 00004010 00000001\n'
+            '[--SectionEnd:Combat--]\n'
+            '[Movement]\n20000000\n'
+            '[Speed]\n04000000 00004014 00000002\n'
+            '[Speed]\n04000000 00004018 00000003\n'
+            '[Movement End]\n20000001\n'
+            '[Outside]\n04000000 0000401C 00000004\n'
+        )
+        entries = cb.parse_cheat_text(txt)
+        by_key = {e.cheat_key: e for e in entries}
+        self.assertTrue(by_key['Movement'].label)
+        self.assertEqual(by_key['Movement'].sec_mark, 1)
+        self.assertTrue(by_key['Movement End'].label)
+        self.assertEqual(by_key['Movement End'].sec_mark, 2)
+        self.assertEqual(by_key['God Mode'].section, 'Combat')
+        self.assertEqual(by_key['Speed'].section, 'Movement')
+        self.assertEqual(by_key['Speed #2'].section, 'Movement')
+        self.assertEqual(by_key['Outside'].section, '')
+
+    def test_single_and_conditional_trampoline_preserves_nzcv_and_extracts_key_mask(self):
+        # 80000202 = ZR (bit 9 = 0x200) + B (bit 1 = 0x2)
+        txt = (
+            '[Static Inf Ammo]\n'
+            '04000000 00000100 D503201F\n'
+            '04000000 00000104 D503201F\n'
+            '[Hold ZR+B Moon Jump]\n'
+            '80000202\n'
+            '04000000 00000200 52800020\n'
+            '20000000\n'
+            '[Pure Data Gold]\n'
+            '04000000 00005000 0000270F\n'
+        )
+        plan, img, patch, pbase, _ = run_bake_synthetic(txt, {})
+        by_key = {e.cheat_key: e for e in plan.entries}
+        self.assertEqual(by_key['Static Inf Ammo'].kind, 'baked_static')
+        self.assertEqual(by_key['Hold ZR+B Moon Jump'].kind, 'baked_conditional')
+        self.assertEqual(by_key['Hold ZR+B Moon Jump'].key_mask, 0x202)
+        self.assertEqual(by_key['Pure Data Gold'].kind, 'data')
+
+        # Two static sites owned by the same cheat share 1 slot; conditional gets its own slot.
+        self.assertEqual(plan.slots_used, 2)
+
+        # Verify patched sites branch into patch area.
+        for off in (0x100, 0x104, 0x200):
+            ins = dis_all(bytes(img[off:off + 4]), off)[0]
+            self.assertEqual(ins.mnemonic, 'b')
+            self.assertGreaterEqual(ins.operands[0].imm, pbase)
+            self.assertLess(ins.operands[0].imm, pbase + len(patch))
+
+        # Strict NZCV zero-pollution assertion across EVERY emitted trampoline instruction.
+        tramp_insns = dis_all(bytes(patch), pbase)
+        self.assertGreater(len(tramp_insns), 10)
+        for ins in tramp_insns:
+            self.assertNotIn(
+                ins.mnemonic, cb._NZCV_MODIFYING_MNEMONICS,
+                f'trampoline must not modify NZCV: {ins.address:#x} {ins.mnemonic} {ins.op_str}',
+            )
+        # Verify stack push/pop and ldrb/cbnz sequence exist.
+        mnems = [ins.mnemonic for ins in tramp_insns]
+        self.assertIn('str', mnems)
+        self.assertIn('adrp', mnems)
+        self.assertIn('ldrb', mnems)
+        self.assertIn('cbnz', mnems)
+        self.assertIn('ldr', mnems)
+
+        # Verify TSV output header & rows.
+        tsv = cb.format_trampolines_tsv(plan)
+        self.assertIn('# BUILD_ID\t1122334455667788\n', tsv)
+        self.assertIn('# MAIN_RX_END\t0x4000\n', tsv)
+        self.assertIn('# CHEAT_STATE_OFF\t0x10000\n', tsv)
+        self.assertIn('entry\tHold ZR+B Moon Jump\tHold ZR+B Moon Jump\tbaked_conditional\t', tsv)
+        self.assertIn('\t0x202\t', tsv)
+
+    def test_multi_variant_over_8_uses_aligned_ldrw_and_tbnz_zero_nzcv(self):
+        # 10 distinct variants targeting the same offset 0x300 -> needs 4-byte aligned slot group + ldr w16 + tbnz.
+        lines = []
+        for k in range(1, 11):
+            # movz w0, #k -> 0x52800000 | (k << 5)
+            word = 0x52800000 | (k << 5)
+            lines.append(f'[Dmg x{k}]\n04000000 00000300 {word:08X}\n')
+        plan, img, patch, pbase, _ = run_bake_synthetic(''.join(lines), {})
+        self.assertEqual(len(plan.baked_sites), 10)
+        self.assertEqual(plan.slots_used, 4)  # 4-byte aligned group at slots 0..3
+
+        # Check byte slots and bit masks span bytes 0 and 1 cleanly.
+        slots_masks = [(s.slot_id, s.variant_mask, s.group_base, s.group_bytes) for s in plan.baked_sites]
+        self.assertEqual(slots_masks[0], (0, 0x1, 0, 4))
+        self.assertEqual(slots_masks[7], (0, 0x80, 0, 4))
+        self.assertEqual(slots_masks[8], (1, 0x1, 0, 4))
+        self.assertEqual(slots_masks[9], (1, 0x2, 0, 4))
+
+        tramp_insns = dis_all(bytes(patch), pbase)
+        for ins in tramp_insns:
+            self.assertNotIn(ins.mnemonic, cb._NZCV_MODIFYING_MNEMONICS)
+        # Must use `ldr w16, [x16]` + `cbz w16` + 10 `tbnz w16, #bit`.
+        self.assertTrue(any(ins.mnemonic == 'ldr' and 'w16' in ins.op_str for ins in tramp_insns))
+        self.assertTrue(any(ins.mnemonic == 'cbz' and 'w16' in ins.op_str for ins in tramp_insns))
+        tbnzs = [ins for ins in tramp_insns if ins.mnemonic == 'tbnz']
+        self.assertEqual(len(tbnzs), 10)
+
