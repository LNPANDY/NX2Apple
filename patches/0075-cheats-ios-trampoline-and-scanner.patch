+def _decode_op(words: list[int], idx: int) -> tuple[int, dict] | None:
+    """Decode one Atmosphère VM instruction at words[idx], mirroring hle_cheats.c ins_dec."""
+    n = len(words) - idx
+    if n <= 0:
+        return None
+    w = words[idx]
+    op = w >> 28
+    if op >= 0xC:
+        op = (op << 4) | ((w >> 24) & 0xF)
+    if op >= 0xF0:
+        op = (op << 4) | ((w >> 20) & 0xF)
+    info: dict = {'op': op, 'len': 1}
+    if op == 0:
+        t = (w >> 24) & 0xF
+        if not _width_ok(t) or n < (4 if t == 8 else 3):
+            return None
+        info.update(
+            t=t,
+            m=(w >> 20) & 0xF,
+            r=(w >> 16) & 0xF,
+            rel=((w & 0xFF) << 32) | words[idx + 1],
+            val=((words[idx + 2] << 32) | words[idx + 3]) if t == 8 else words[idx + 2],
+            len=4 if t == 8 else 3,
+        )
+    elif op == 1:
+        t = (w >> 24) & 0xF
+        c = (w >> 16) & 0xF
+        if not _width_ok(t) or c < 1 or c > 6 or n < (4 if t == 8 else 3):
+            return None
+        info.update(t=t, m=(w >> 20) & 0xF, c=c, len=4 if t == 8 else 3)
+    elif op == 2:
+        info['else'] = ((w >> 24) & 0xF) == 1
+    elif op == 3:
+        is_end = ((w >> 24) & 0xF) != 0
+        info.update(r=(w >> 16) & 0xF, is_end=is_end, len=1 if is_end else 2)
+        if not is_end and n < 2:
+            return None
+    elif op == 4:
+        if n < 3:
+            return None
+        info.update(r=(w >> 16) & 0xF, val=(words[idx + 1] << 32) | words[idx + 2], len=3)
+    elif op == 5:
+        t = (w >> 24) & 0xF
+        flags = (w >> 12) & 0xF
+        if not _width_ok(t) or flags > 3 or n < 2:
+            return None
+        info.update(t=t, r=(w >> 16) & 0xF, len=2)
+    elif op == 6:
+        t = (w >> 24) & 0xF
+        if not _width_ok(t) or n < 3:
+            return None
+        info.update(t=t, r=(w >> 16) & 0xF, inc=((w >> 12) & 0xF) != 0, len=3)
+    elif op == 7:
+        t = (w >> 24) & 0xF
+        c = (w >> 12) & 0xF
+        if not _width_ok(t) or c > 4 or n < 2:
+            return None
+        info.update(t=t, r=(w >> 16) & 0xF, len=2)
+    elif op == 8:
+        info['key_mask'] = w & 0x0FFFFFFF
+    elif op == 9:
+        t = (w >> 24) & 0xF
+        if not _width_ok(t):
+            return None
+        imm = ((w >> 8) & 0xF) != 0
+        ln = (3 if t == 8 else 2) if imm else 1
+        if n < ln:
+            return None
+        info.update(t=t, r=(w >> 16) & 0xF, len=ln)
+    elif op == 0xA:
+        t = (w >> 24) & 0xF
+        o = (w >> 8) & 0xF
+        if not _width_ok(t) or o > 5:
+            return None
+        ln = 2 if o in (2, 4, 5) else 1
+        if n < ln:
+            return None
+        info.update(t=t, r=(w >> 16) & 0xF, inc=((w >> 12) & 0xF) != 0, o=o, m=(w >> 4) & 0xF, len=ln)
+    elif op == 0xC0:
+        t = (w >> 20) & 0xF
+        c = (w >> 16) & 0xF
+        o = (w >> 8) & 0xF
+        if not _width_ok(t) or c < 1 or c > 6 or o > 5:
+            return None
+        ln = 2 if o in (0, 2) else ((3 if t == 8 else 2) if o == 4 else 1)
+        if n < ln:
+            return None
+        info.update(t=t, len=ln)
+    elif op == 0xC1:
+        info.update(r=(w >> 16) & 0xF, c=(w >> 4) & 0xF)
+    elif op == 0xC2:
+        info.update(c=(w >> 20) & 0xF, mask=w & 0xFFFF)
+    elif op == 0xC3:
+        info.update(x=(w >> 4) & 0xFF, r=w & 0xF)
+    elif op == 0xC4:
+        if n < 3:
+            return None
+        info.update(key_mask=(words[idx + 1] << 32) | words[idx + 2], len=3)
+    else:
+        return None
+    return info['len'], info
+
+
+def analyze_entries(entries: list[CheatEntry], rx_end: int) -> None:
+    """Decode entries, extract static .text writes, conditional depth, and key masks."""
+    # Registers modified by master entries carry into every normal entry during a pass.
+    # Normal entries also share g_reg in file order within a pass, so registers dirtied by
+    # earlier normal entries conservatively propagate to later normal entries.
+    master_dirty: set[int] = set()
+    for half in (0, 1):
+        running_dirty = set(master_dirty) if half == 1 else set()
+        for ent in entries:
+            if ent.label or ent.broken or (ent.master != (half == 0)):
+                continue
+            dirty = set(running_dirty)
+            ent_dirty: set[int] = set()
+            cond_stack: list[int] = []  # key_mask for each enclosing conditional (0 for non-key)
+            idx = 0
+            while idx < len(ent.words):
+                dec = _decode_op(ent.words, idx)
+                if dec is None:
+                    ent.broken = True
+                    ent.broken_why = f'unsupported or truncated opcode at word {idx}'
+                    break
+                ln, info = dec
+                op = info['op']
+                if op == 0:
+                    m, t, r, rel, val = info['m'], info['t'], info['r'], info['rel'], info['val']
+                    is_main = m == 0 or m >= 5
+                    if is_main and r not in dirty:
+                        if rel < rx_end:
+                            km = 0
+                            for cm in cond_stack:
+                                km |= cm
+                            ent.writes.append(StaticWrite(
+                                offset=rel,
+                                width=t,
+                                value=val & _width_mask(t),
+                                conditional=len(cond_stack) > 0,
+                                key_mask=km,
+                            ))
+                    elif is_main and r in dirty:
+                        # Offset depends on a runtime register: cannot know if it targets .text statically.
+                        ent.has_dynamic_text_write = True
+                    else:
+                        ent.has_non_main_write = True
+                elif op in (1, 0xC0):
+                    cond_stack.append(0)
+                elif op in (8, 0xC4):
+                    km = info['key_mask']
+                    ent.key_mask |= km
+                    cond_stack.append(km)
+                elif op == 2:
+                    if not info['else'] and cond_stack:
+                        cond_stack.pop()
+                elif op == 3:
+                    dirty.add(info['r'])
+                    ent_dirty.add(info['r'])
+                elif op == 4:
+                    if info['val'] == 0 and not cond_stack:
+                        dirty.discard(info['r'])
+                    else:
+                        dirty.add(info['r'])
+                        ent_dirty.add(info['r'])
+                elif op in (5, 7, 9):
+                    dirty.add(info['r'])
+                    ent_dirty.add(info['r'])
+                elif op == 6:
+                    if info['inc']:
+                        dirty.add(info['r'])
+                        ent_dirty.add(info['r'])
+                elif op == 0xA:
+                    if info['inc']:
+                        dirty.add(info['r'])
+                        ent_dirty.add(info['r'])
+                    if info['o'] in (3, 4, 5) and (info['m'] == 0 or info['m'] >= 5):
+                        ent.has_dynamic_text_write = True
+                elif op == 0xC1:
+                    if info['c'] == 3:
+                        if not cond_stack:
+                            dirty.discard(info['r'])
+                    elif info['c'] not in (1, 2):
+                        dirty.add(info['r'])
+                        ent_dirty.add(info['r'])
+                elif op == 0xC2:
+                    if info['c'] == 3:
+                        if not cond_stack:
+                            for bit in range(16):
+                                if info['mask'] & (1 << bit):
+                                    dirty.discard(bit)
+                    elif info['c'] not in (1, 2):
+                        for bit in range(16):
+                            if info['mask'] & (1 << bit):
+                                dirty.add(bit)
+                                ent_dirty.add(bit)
+                elif op == 0xC3:
+                    if info['x'] < 0x80:
+                        dirty.add(info['r'])
+                        ent_dirty.add(info['r'])
+                idx += ln
+            if not ent.broken:
+                if half == 0:
+                    master_dirty |= ent_dirty
+                    running_dirty |= ent_dirty
+                else:
+                    running_dirty |= ent_dirty
+
