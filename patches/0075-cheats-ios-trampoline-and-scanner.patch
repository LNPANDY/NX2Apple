+    def test_shared_adrp_across_4kb_mirror_pages_and_16b_q_load(self):
+        # Place filler (0x2000..0x2FF0 -> mirror 0x1000..0x1FF0), Block A (0x4000..0x4010 ->
+        # mirror 0x1FF0..0x2000, page +0x1000), and Block B (0x4F00..0x4F10 -> mirror
+        # 0x2000..0x2010, page +0x2000). Both A and B lie on original page 0x4000 so one
+        # shared `adrp x8, 0x4000` drives accesses across two different 4 KB mirror pages,
+        # including a 16-byte `ldr q0` that requires 16-byte mirror block alignment.
+        text_end = 0x8000
+        orig_words = {off: 0 for off in range(0x1000, 0x5000, 4)}
+        orig_words[0x0200] = 0x91000400
+        cave_pc = 0x1000
+        adrp_x8 = ADRP(8, cave_pc, 0x4000)
+        ldr_w9_a = cb.LDRW_UIMM(9, 8, 0x000 // 4)        # [x8, #0x000] -> 0x4000 (mirror page 1)
+        ldr_q0_b = cb.LDR_FP_UIMM(2, 0, 8, 0xF00 // 16)  # ldr q0, [x8, #0xF00] -> 0x4F00 (mirror page 2, scale=16)
+        add_x10_b = ADDI(10, 8, 0xF00)                   # add x10, x8, #0xF00 -> 0x4F00 (mirror page 2)
+        ret_b = B(cave_pc + 16, 0x0204)
+        lines = [
+            '{SharedAdrpCave}\n',
+            f'04000000 00000200 {B(0x0200, cave_pc):08X}\n',
+            f'04000000 {cave_pc + 0:08X} {adrp_x8:08X}\n',
+            f'04000000 {cave_pc + 4:08X} {ldr_w9_a:08X}\n',
+            f'04000000 {cave_pc + 8:08X} {ldr_q0_b:08X}\n',
+            f'04000000 {cave_pc + 12:08X} {add_x10_b:08X}\n',
+            f'04000000 {cave_pc + 16:08X} {ret_b:08X}\n',
+            '[FillerMirror]\n',
+        ]
+        for off in range(0x2000, 0x2FF0, 4):
+            lines.append(f'04000000 {off:08X} 00000001\n')
+        lines.append('[SwitchesAB]\n')
+        for off in (0x4000, 0x4004, 0x4008, 0x400C, 0x4F00, 0x4F04, 0x4F08, 0x4F0C):
+            lines.append(f'04000000 {off:08X} 00000002\n')
+        plan, img, patch, pbase, _ = run_bake_synthetic(''.join(lines), orig_words, text_end=text_end)
+        cheat_state = plan.cheat_state_off
+        self.assertEqual(len(plan.mirrors), 3)
+        for mb in plan.mirrors:
+            self.assertEqual(mb.mirror_rel % 16, 0, 'all mirror blocks must be 16-byte aligned for Qt loads')
+        mb_a = next(m for m in plan.mirrors if m.orig_off == 0x4000)
+        mb_b = next(m for m in plan.mirrors if m.orig_off == 0x4F00)
+        va_a = cheat_state + mb_a.mirror_rel
+        va_b = cheat_state + mb_b.mirror_rel
+        self.assertNotEqual(va_a & ~0xFFF, va_b & ~0xFFF, 'Block A and Block B must straddle a 4 KB mirror page boundary')
+
+        # Original ADRP X8 must stay intact (not rewritten to either conflicting mirror page).
+        self.assertEqual(struct.unpack_from('<I', img, cave_pc)[0], adrp_x8)
+
+        # ldr w9, ldr q0, and add x10 must all branch to out-of-line stubs targeting exact mirror addresses.
+        for pc, expect_va, expect_mnem in (
+            (cave_pc + 4, va_a, 'ldr'),
+            (cave_pc + 8, va_b, 'ldr'),
+            (cave_pc + 12, va_b, 'add'),
+        ):
+            br = dis_all(bytes(img[pc:pc + 4]), pc)[0]
+            self.assertEqual(br.mnemonic, 'b')
+            st_pc = br.operands[0].imm
+            if expect_mnem == 'add':
+                st_ins = dis_all(bytes(patch[st_pc - pbase:st_pc - pbase + 12]), st_pc)
+                self.assertEqual([x.mnemonic for x in st_ins], ['adrp', 'add', 'b'])
+                self.assertEqual(st_ins[0].operands[1].imm + st_ins[1].operands[2].imm, expect_va)
+                self.assertEqual(st_ins[2].operands[0].imm, pc + 4)
+            else:
+                st_ins = dis_all(bytes(patch[st_pc - pbase:st_pc - pbase + 24]), st_pc)
+                self.assertEqual([x.mnemonic for x in st_ins], ['str', 'adrp', 'add', 'ldr', 'ldr', 'b'])
+                self.assertEqual(st_ins[1].operands[1].imm + st_ins[2].operands[2].imm, expect_va)
+                self.assertEqual(st_ins[5].operands[0].imm, pc + 4)
+                for ins in st_ins:
+                    self.assertNotIn(ins.mnemonic, cb._NZCV_MODIFYING_MNEMONICS)
+
+        # Calling relocate_cave_switches without emit_stub must raise ValueError, never silently skip.
+        md = Cs(CS_ARCH_ARM64, CS_MODE_ARM)
+        md.detail = True
+        with self.assertRaises(ValueError):
+            cb.relocate_cave_switches(plan.cave_code, plan.mirrors, cheat_state, md, emit_stub=None)
