+// Synchronize static trampoline slots (and clear slots for disabled cheats) immediately on toggle / master switch / reload.
+static void trampolines_sync_static(void) {
+    if (!g_cheat_state || g_alias || g_tramp_slots_used <= 0) return;
+    int lim = g_tramp_slots_used < TRAMP_SLOT_MAX ? g_tramp_slots_used : TRAMP_SLOT_MAX;
+    if (!atomic_load(&g_master) || g_safe) {
+        memset(g_slot_next, 0, (size_t)lim);
+        trampolines_commit();
+        return;
+    }
+    uint8_t dyn_active[TRAMP_SLOT_MAX];
+    memset(dyn_active, 0, (size_t)lim);
+    for (int i = 0; i < g_ncheat; i++) {
+        const cheat_t *c = &g_cheat[i];
+        if (c->broken || c->dead || c->label || !(c->on || c->master)) continue;
+        char k[NAME_MAX + 16]; cheat_key(c, k, sizeof k);
+        for (int j = 0; j < g_ntramp_sites; j++) {
+            const tramp_site_t *st = &g_tramp_sites[j];
+            if (st->conditional && !strcmp(st->cheat_key, k)) {
+                for (int b = 0; b < st->group_bytes; b++) dyn_active[st->group_base + b] = 1;
+            }
+        }
+    }
+    for (int s = 0; s < lim; s++) g_slot_next[s] = dyn_active[s] ? g_slot_cur[s] : 0;
+    for (int half = 0; half < 2; half++) {
+        for (int i = 0; i < g_ncheat; i++) {
+            const cheat_t *c = &g_cheat[i];
+            if (c->broken || c->dead || c->label || ((half == 0) != (c->master != 0))) continue;
+            if (half && !c->on) continue;
+            if (c->baked_kind != DM_CHEAT_BAKED_STATIC) continue;
+            char k[NAME_MAX + 16]; cheat_key(c, k, sizeof k);
+            for (int j = 0; j < g_ntramp_sites; j++) {
+                const tramp_site_t *st = &g_tramp_sites[j];
+                if (!st->conditional && !strcmp(st->cheat_key, k)) trampolines_apply_site(st, g_slot_next);
+            }
+        }
+    }
+    trampolines_commit();
+}
