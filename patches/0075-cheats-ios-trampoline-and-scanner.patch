+    def test_patch_nso_end_to_end_cli_with_cheat_file(self):
+        # Build a minimal valid NSO with MOD0, empty eh_frame_hdr, and empty DT_NULL dynamic section.
+        text = bytearray(0x4000)
+        for off in range(0, 0x4000, 4):
+            struct.pack_into('<I', text, off, 0x91000400)  # add x0, x0, #1
+        # Place branch at 0x0 and MOD0 offset at 0x4.
+        struct.pack_into('<I', text, 0x0, B(0x0, 0x80))
+        struct.pack_into('<I', text, 0x4, 0x40)  # MOD0 at 0x40
+        # Real SVC instruction at 0x100 (patch_nso.py rewrites it -> cheat targeting 0x100 must be skipped!).
+        struct.pack_into('<I', text, 0x100, 0xD4000001)
+        # Normal instruction at 0x120 (safe for baking).
+        struct.pack_into('<I', text, 0x120, 0x91000400)
+        struct.pack_into('<I', text, 0x124, 0xD65F03C0)  # ret
+        # MOD0 header at 0x40: magic, dyn_off, bss_start, bss_end, eh_start, eh_end
+        ro_off = 0x4000
+        data_off = 0x5000
+        eh_off = ro_off + 0x100
+        dyn_off = data_off + 0x100
+        struct.pack_into('<4siiiii', text, 0x40, b'MOD0', dyn_off - 0x40, data_off + 0x200 - 0x40, data_off + 0x200 - 0x40, eh_off - 0x40, eh_off + 0x20 - 0x40)
+
+        ro = bytearray(0x1000)
+        # eh_frame_hdr at ro+0x100: version=1, eh_frame_ptr_enc=0x1b (sdata4|pcrel), fde_count_enc=0x03 (udata4), table_enc=0x3b (sdata4|datarel)
+        ro[0x100:0x104] = bytes([1, 0x1B, 0x03, 0x3B])
+        struct.pack_into('<iI', ro, 0x104, 0, 0)  # 0 FDEs
+
+        data = bytearray(0x1000)
+        # Empty DT_NULL at data+0x100 (16 zero bytes already)
+
+        # Assemble NSO0 file (uncompressed).
+        hdr = bytearray(0x100)
+        hdr[0:4] = b'NSO0'
+        hdr[0x40:0x60] = bytes.fromhex('1122334455667788aabbccddeeff001100000000000000000000000000000000')
+        segs = (bytes(text), bytes(ro), bytes(data))
+        body = b''
+        mo = 0
+        for i, s in enumerate(segs):
+            struct.pack_into('<III', hdr, 0x10 + i * 0x10, 0x100 + len(body), mo, len(s))
+            struct.pack_into('<I', hdr, 0x60 + 4 * i, len(s))
+            hdr[0xA0 + 0x20 * i:0xC0 + 0x20 * i] = hashlib.sha256(s).digest()
+            body += s
+            mo += len(s)
+        struct.pack_into('<I', hdr, 0xC, 0x38)  # hashes present, uncompressed
+        struct.pack_into('<I', hdr, 0x3C, 0x1000)  # bss
+
+        with tempfile.TemporaryDirectory() as d:
+            root = Path(d)
+            nso_path = root / 'main'
+            nso_path.write_bytes(bytes(hdr) + body)
+            cheat_path = root / '1122334455667788.txt'
+            cheat_path.write_text(
+                '[Hold B Jump]\n80000002\n04000000 00000120 D503201F\n20000000\n'
+                '[Conflict SVC]\n04000000 00000100 D503201F\n',
+                encoding='utf-8',
+            )
+            out_dir = root / 'patched'
+            r = subprocess.run(
+                [sys.executable, str(REPO / 'dm/tools/patch_nso.py'), str(nso_path), str(out_dir), 'main', '--cheat-file', str(cheat_path)],
+                capture_output=True, text=True,
+            )
+            self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
+            fixups = (out_dir / 'main.fixups.tsv').read_text(encoding='utf-8')
+            self.assertIn('# MAIN_RX_END\t0x4000\n', fixups)
+            self.assertIn('# CHEAT_STATE_OFF\t0x', fixups)
+            tsv = (out_dir / 'cheat_trampolines.tsv').read_text(encoding='utf-8')
+            self.assertIn('# BUILD_ID\t1122334455667788\n', tsv)
+            self.assertIn('# MAIN_RX_END\t0x4000\n', tsv)
+            self.assertIn('entry\tHold B Jump\tHold B Jump\tbaked_conditional\t0\t0x1\t0x120\t0xd503201f\t0x2\t', tsv)
+            self.assertIn('entry\tConflict SVC\tConflict SVC\tunbaked_code\t-1\t0x0\t0x100\t', tsv)
+            self.assertIn('conflict with rewriter site', tsv)
