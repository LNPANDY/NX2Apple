+// Intercept a .text write on iOS (!g_alias) and drive baked trampolines, Code Cave mirrors,
+// or statically-baked cave/no-op words. Returns 1 if handled, 0 if unbaked (falls through to cheat_kill).
+static int trampolines_try_write(cheat_t *c, uint64_t off, uint64_t len, uint64_t val) {
+    if (g_alias) return 0;
+    // 1. Relocated Code Cave switch-table mirror writes (1/2/4/8 bytes).
+    if (g_cheat_state) {
+        for (int i = 0; i < g_ntramp_mirrors; i++) {
+            const tramp_mirror_t *mb = &g_tramp_mirrors[i];
+            if (off >= mb->orig_off && off - mb->orig_off <= mb->size && len <= mb->size - (off - mb->orig_off)) {
+                uint32_t dst_off = mb->mirror_off + (uint32_t)(off - mb->orig_off);
+                if (g_dry) {
+                    dry_line("main+0x%llX (%llu bytes, cave mirror +0x%X): -> 0x%llX", (unsigned long long)off, (unsigned long long)len, dst_off, (unsigned long long)val);
+                    g_dry_writes++;
+                    return 1;
+                }
+                memcpy((uint8_t *)g_cheat_state + dst_off, &val, (size_t)len);
+                atomic_thread_fence(memory_order_release);
+                return 1;
+            }
+        }
+    }
+    // 2. Baked trampoline slots, restore-to-original writes, and statically baked cave words.
+    uint64_t woffs[2] = {0, 0};
+    uint32_t wvals[2] = {0, 0};
+    int nwords = 0;
+    if (len == 1 || len == 2) {
+        uint64_t aligned = off & ~3ull;
+        unsigned shift = (unsigned)(off & 3ull) * 8u;
+        if (shift + (unsigned)len * 8u > 32u) return 0;
+        uint32_t mask = (len == 1 ? 0xFFu : 0xFFFFu) << shift;
+        uint32_t ins_bits = ((uint32_t)val << shift) & mask;
+        // Reconstruct merged 32-bit word from baked orig_word (never read live .text which now holds B trampoline).
+        const tramp_site_t *any = trampolines_find_any_at_off(aligned);
+        if (any && any->has_orig_word) {
+            woffs[0] = aligned;
+            wvals[0] = (any->orig_word & ~mask) | ins_bits;
+            nwords = 1;
+        } else {
+            const tramp_cave_t *cv = trampolines_find_cave_any(aligned);
+            if (!cv || !cv->has_orig_word) return 0;
+            woffs[0] = aligned;
+            wvals[0] = (cv->orig_word & ~mask) | ins_bits;
+            nwords = 1;
+        }
+    } else if ((off & 3) == 0 && (len == 4 || len == 8)) {
+        nwords = (int)(len / 4);
+        for (int k = 0; k < nwords; k++) {
+            woffs[k] = off + (uint64_t)k * 4;
+            wvals[k] = (uint32_t)(val >> (k * 32));
+        }
+    } else {
+        return 0;
+    }
+
+    enum { ACT_NONE = 0, ACT_SITE, ACT_RESTORE, ACT_CAVE };
+    int act[2] = {ACT_NONE, ACT_NONE};
+    const tramp_site_t *matched[2] = {NULL, NULL};
+    char ckey[NAME_MAX + 16]; cheat_key(c, ckey, sizeof ckey);
+    for (int k = 0; k < nwords; k++) {
+        const tramp_site_t *st = trampolines_find_site(ckey, woffs[k], wvals[k]);
+        if (st) {
+            if (!g_cheat_state) return 0;
+            act[k] = ACT_SITE;
+            matched[k] = st;
+            continue;
+        }
+        const tramp_site_t *any = trampolines_find_any_at_off(woffs[k]);
+        if (any && (any->has_orig_word ? (wvals[k] == any->orig_word) : (c->pair_off != 0))) {
+            if (!g_cheat_state) return 0;
+            act[k] = ACT_RESTORE;
+            matched[k] = any;
+            continue;
+        }
+        if (trampolines_find_cave(woffs[k], wvals[k])) {
+            act[k] = ACT_CAVE;
+            continue;
+        }
+        return 0;
+    }
+    for (int k = 0; k < nwords; k++) {
+        if (act[k] == ACT_CAVE) {
+            if (g_dry) {
+                dry_line("main+0x%llX (baked cave/orig word 0x%08X)", (unsigned long long)woffs[k], wvals[k]);
+                g_dry_writes++;
+            }
+            continue;
+        }
+        const tramp_site_t *st = matched[k];
+        if (g_dry) {
+            if (act[k] == ACT_RESTORE) dry_line("main+0x%llX (baked trampoline slot %u -> 0 restore)", (unsigned long long)woffs[k], st->slot_id);
+            else dry_line("main+0x%llX (baked trampoline slot %u, mask 0x%X)", (unsigned long long)woffs[k], st->slot_id, st->variant_mask);
+            g_dry_writes++;
+        } else if (act[k] == ACT_RESTORE) {
+            for (int b = 0; b < st->group_bytes; b++) g_slot_next[st->group_base + b] = 0;
+        } else {
+            trampolines_apply_site(st, g_slot_next);
+        }
+    }
+    return 1;
+}
