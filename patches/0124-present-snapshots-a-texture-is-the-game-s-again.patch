     snap_present(&big);
     CHECK("slot 1's old texture is still resident", [g_snap_res containsAllocation:old1]);
-    uint64_t ticket = present_enqueue(&big, 1. / 60, NULL, 0); mtl_present_flush();
-    CHECK("a present while slot 0's copy is queued falls back", ticket != 0);
+    uint64_t copies = g_snap_v; present_enqueue(&big, 1. / 60, NULL, 0); mtl_present_flush();
+    CHECK("a present while slot 0's copy is queued falls back", g_snap_v == copies);
     CHECK("the old texture stays resident while the copy is queued", [g_snap_res containsAllocation:old0]);
     gpu_gate.signaledValue = 1;
     CHECK("the replacing copies complete", [g_snap_ev waitUntilSignaledValue:g_snap_v timeoutMS:2000]);
@@ -155,6 +158,46 @@ static void resize_case(void) {
     h_nvnWindowAcquireTexture((NVNwindow *)job->window, NULL, &job->index);
     dispatch_semaphore_signal(job->done);
 } return NULL; }
+// A snapshot present keeps its ticket (LNPANDY/NX2Apple#1117): acquiring that texture again waits until its copy, and with it the frame drawn into it, has run on the GPU,
+// though not for the screen. Before, the ticket was 0 and only the next ring slot paced the acquire; with more ring slots than window textures, or a game that
+// acquires its next texture before presenting the current frame, the game ran frames further ahead of the GPU and rewrote per-frame data queued draws still read
+// (Xenoblade Chronicles 3: the scene one flat colour in a third to a half of the frames)
+static void ticket_case(void) {
+    state_reset(); memset(&R, 0, sizeof R); mtl_sub_begin();
+    CHECK("prior submission completed", mtl_wait(mtl_sub_commit(), 2000000000ull));
+    g_snap_n = 4;   // more ring slots than window textures: ring capacity alone does not hold the acquire
+    tex_t textures[2]; win_t win = {.ntex=2};
+    for (int i = 0; i < 2; i++) { textures[i] = source(i); win.tex[i] = (NVNtexture *)&textures[i]; }
+    id<MTLSharedEvent> gpu_gate = [g_dev newSharedEvent]; if (!gpu_gate) abort();
+    mtl_present_test_stall(400000000); uint64_t copies = g_snap_v; int idx;
+    h_nvnWindowAcquireTexture((NVNwindow *)&win, NULL, &idx); h_nvnQueuePresentTexture(&fixture_queue, (NVNwindow *)&win, idx);
+    queue_encoded(); snap_commit_wait(g_snap_v);
+    [g_q4 waitForEvent:gpu_gate value:1];   // holds the queue: the next copy stays unrun until the gate opens
+    h_nvnWindowAcquireTexture((NVNwindow *)&win, NULL, &idx); h_nvnQueuePresentTexture(&fixture_queue, (NVNwindow *)&win, idx);
+    for (uint64_t t0 = now_ns(); g_snap_v < copies + 2 && now_ns() - t0 < 2000000000ull;) usleep(1000);   // the queue worker takes the second snapshot (its copy waits behind the gate)
+    CHECK("both presents took snapshots", g_snap_v == copies + 2);
+    // The window holds the queue's receipts; the ticket the next acquire waits for is the present ticket the receipt was published with (0: nothing to wait for)
+    nq_receipt *r0 = (nq_receipt *)(uintptr_t)win.ticket[0];
+    CHECK("snapshot presents keep their present tickets", r0 && r0->published && r0->present);
+    uint64_t ev0 = 0; pthread_mutex_lock(&g_pq_mu); if (r0 && g_snap_tex[r0->present % 64].tk == r0->present) ev0 = g_snap_tex[r0->present % 64].ev; pthread_mutex_unlock(&g_pq_mu);
+    CHECK("the first texture's copy is known by its ticket", ev0 == copies + 1);
+    h_nvnWindowAcquireTexture((NVNwindow *)&win, NULL, &idx);   // (it also takes the stalled display link's pacing wait, as any acquire with snapshots does)
+    CHECK("acquiring the first texture again waited for its copy", idx == 0 && g_snap_ev.signaledValue >= ev0);
+    // the second texture's copy is still behind the gate: its acquire must hold until the gate opens
+    h_nvnQueuePresentTexture(&fixture_queue, (NVNwindow *)&win, idx);
+    acquire_job job = {.window = &win, .started = dispatch_semaphore_create(0), .done = dispatch_semaphore_create(0)};
+    pthread_t thread; if (pthread_create(&thread, NULL, acquire_thread, &job)) { gpu_gate.signaledValue = 1; exit(2); }
+    dispatch_semaphore_wait(job.started, DISPATCH_TIME_FOREVER);
+    int returned = dispatch_semaphore_wait(job.done, dispatch_time(DISPATCH_TIME_NOW, 100000000ll)) == 0;
+    CHECK("acquiring the second texture waits for its unrun copy", !returned);
+    gpu_gate.signaledValue = 1;
+    if (!returned) returned = dispatch_semaphore_wait(job.done, dispatch_time(DISPATCH_TIME_NOW, 2000000000ll)) == 0;
+    CHECK("that acquire returns once the copy has run", returned && job.index == 1);
+    if (!returned) exit(2); pthread_join(thread, NULL);
+    h_nvnQueuePresentTexture(&fixture_queue, (NVNwindow *)&win, job.index); queue_encoded();
+    mtl_present_flush(); mtl_present_test_stall(0); snap_commit_wait(g_snap_v);
+    CHECK("the last snapshot completes", [g_snap_ev waitUntilSignaledValue:g_snap_v timeoutMS:2000]);
+}
 static void queued_case(void) {
     uint8_t *memory = NULL; if (posix_memalign((void **)&memory, getpagesize(), 65536)) exit(2); memset(memory, 0, 65536);
     NVNmemoryPool pool; NVNmemoryPoolBuilder pb = {0}; h_nvnMemoryPoolBuilderSetDefaults(&pb); h_nvnMemoryPoolBuilderSetDevice(&pb, &fixture_device);
@@ -211,6 +254,7 @@ int main(int argc, char **argv) { @autoreleasepool {
     else if (!strcmp(argv[1], "copy")) pending_copy_case();
     else if (!strcmp(argv[1], "resize")) resize_case();
     else if (!strcmp(argv[1], "queued")) queued_case();
+    else if (!strcmp(argv[1], "ticket")) ticket_case();
     else return 2;
     printf("present snapshots: %d checks, %d failed\n", checks, failed); return failed != 0;
 } }
diff --git a/docs/reference/frame-rate.md b/docs/reference/frame-rate.md
index 1f066f9..8d27cf3 100644
--- a/docs/reference/frame-rate.md
+++ b/docs/reference/frame-rate.md
@@ -293,10 +293,14 @@ Frame pacing: the host's frame step, engine frame limiters, present intervals an
 
 - **Symptom:** frames miss the screen while the GPU stays at its lowest clock (444 MHz on an M2 Max); more work (a higher render scale) only makes the frames slower.
 - **Cause:** a game with two swapchain textures gets one back only when the display link has taken its previous present, so each frame's CPU work starts on a tick and the GPU idles from the end of one frame to the first work of the next. macOS reads that idle time as room and keeps the clock low.
-- **Fix:** present snapshots (`DM_PRESENT_SNAP=<n>`, a ring of n host textures, 2 to 4; off by default on iOS and Mac; `nvn_mtl.m` `snap_take`): each present is copied on the game's queue, right after the frame's work, into the next ring slot; the display link shows the copy, and the game's texture is free at once. The game runs up to a frame ahead of the screen, and a frame whose work runs long is absorbed instead of shown late. Acquire waits for ring capacity and counts it as pacing (`mtl_snap_acquire_wait`). Present never waits for a snapshot slot: if it is still busy (several textures acquired ahead of time, or a copy not finished), the original texture is queued with its usual acquire ticket. Waiting inside present held the game's locks while the screen was stalled.
+- **Fix:** present snapshots (`DM_PRESENT_SNAP=<n>`, a ring of n host textures, 2 to 4; off by default on iOS and Mac; `nvn_mtl.m` `snap_take`): each present is copied on the game's queue, right after the frame's work, into the next ring slot; the display link shows the copy, and the game's texture is the game's again as soon as the copy has run on the GPU, without waiting for the screen. The game runs up to a frame ahead of the screen, and a frame whose work runs long is absorbed instead of shown late. Acquire waits for ring capacity and counts it as pacing (`mtl_snap_acquire_wait`). Present never waits for a snapshot slot: if it is still busy (several textures acquired ahead of time, or a copy not finished), the original texture is queued with its usual acquire ticket. Waiting inside present held the game's locks while the screen was stalled.
 - **Setting:** the iOS launcher's **Frame buffering** toggle is offered for NVN builds and remembers the choice. Its default is the profile's `present_snap` (off unless a game was tested with it on: Breath of the Wild, a steady 60 fps on an iPhone 17 Pro Max where it fell to 30 without). `Documents/env.txt` overrides it (`DM_PRESENT_SNAP=1` on, `0` off); restart the app after editing the file. The Mac uses the same environment variable and the same profile default.
 - **Fix:** the frame step judges lateness by what the screen shows while snapshots are on: the on-screen interval of the frame 8 presents back, against its hold (`fstep_tick`, `nvn_fstep.screen`). Judged by its cost, a frame whose CPU time holds the game's waits on its own GPU work (which now runs a frame later) looked late at a GPU time of 0.75 vsyncs.
 - **Note:** the cost is up to a frame more latency.
+- **Symptom:** with snapshots on, Xenoblade Chronicles 3's 3D scene is one flat colour in a third to a half of the frames (black, grey, blue, orange, white; a new colour each time), while the HUD drawn over it is right. The more ring slots, the more often: 32 of 80 screen captures with 2 slots, 49 of 80 with 4, none with snapshots off ([LNPANDY/NX2Apple#1117](https://github.com/LNPANDY/NX2Apple/issues/1117)).
+- **Cause:** a present that took a snapshot returned ticket 0, so the game's next acquire of that texture waited for nothing; only the next ring slot paced it. The ring slot is counted per present, not per texture, so with more slots than swapchain textures, or a game that acquires its next texture before it presents the current frame, the game ran more frames ahead of the GPU than its swapchain allows. A game that keeps its CPU-written per-frame data (uniform blocks read by the GPU from the shared pool when the draw runs) in a ring sized on the swapchain then rewrote the data of a frame still queued: here the composite's block.
+- **Fix:** a snapshot present keeps its ticket, and the acquire of its texture waits until that snapshot's copy has run on the GPU (`mtl_present_wait_texture`, from `nvn_queue_present_wait`); the frame drawn into the texture has run before it. The game never has more frames in flight than its swapchain holds, and still does not wait for the screen. With the fix, 0 of 80 flat frames with 2 slots and with 4.
+- **Check:** `t_present_snap ticket`: with 4 ring slots and 2 window textures, both presents keep their tickets, acquiring the first texture again waits for its copy, and acquiring the second waits while its copy is held behind a GPU gate and returns once the gate opens. Before the fix the tickets were 0 and the acquire returned at once.
 - **Note:** with Metal encoding on its own thread (`DM_NVN_ENC_THREAD`, the default on iOS) the copy is a block of the encode thread's own queue (`rec_own_push`), behind everything submitted before the present, so a present from another thread than the submitting one gets a snapshot too; the present waits only until that block is encoded (`snap_commit_wait`). The wait ledger `DM_NVN_WAITS=1` counts every CPU wait for the GPU or the encode thread (`[waits]` every 300 frames).
 - **Fix:** suspend drains snapshot commits and their GPU event even when their display tickets were discarded (`snap_drain` in `mtl_drain`). Submission fences and upload completion do not cover these copies; previously suspend could return while the encoder still held a copy to submit.
 - **Fix:** with snapshots on and the display link ticking, the acquire waits for the link's present-interval ticks like any present (`nvnWindowAcquireTexture` in `hle_nvn.c`); only a silent link falls back to the texture's slot time. The wait for a free ring slot alone did not pace: the link takes frames in order and drops all but the newest two, and a dropped frame frees its slot. Donkey Kong Bananza at the 30 fps cap ran 43-65 fps of game time on an M1 Pro and 45-50 fps on an iPhone 15 Pro Max, each frame still stepping 1/30 s (fast-forward), and about 110 of every 300 frames never reached the screen; after, 30.0 fps and 300 of 300 frames on screen (Mac; measured by the author of PR #1073 on their build). The game still runs up to a frame ahead of the screen: the link wait limits how often a frame starts, not how far ahead of the display it is. `t_link_ticks` checks the acquire with snapshots on: two ticks of a 60 Hz link at interval 2, one at interval 1, none while the link is stalled.
