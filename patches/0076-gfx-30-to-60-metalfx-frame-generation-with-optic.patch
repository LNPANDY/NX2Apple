+static void fg_on_enqueue(uint64_t ss, int slot, pq_item *it, uint64_t tk) {
+    if (ss && g_fg_snap[slot].gen_ok) it->gen = g_fg_snap[slot].gen_serial;
+    if (ss && fg_on()) g_snap[slot].ticket = tk + 1;
+}
