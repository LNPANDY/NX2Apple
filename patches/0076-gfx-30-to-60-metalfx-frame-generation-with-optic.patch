+static int fg_scale(id<MTL4CommandBuffer> cb, int k, id<MTLTexture> src, id<MTLTexture> dst, const NSUInteger r[4]) {
+    NSError *e = nil;
+    if (!g_fg_scale_pso || g_fg_scale_fmt != dst.pixelFormat) {
+        id<MTLLibrary> lib = host_lib("present", &e);
+        MTLRenderPipelineDescriptor *pd = [MTLRenderPipelineDescriptor new];
+        pd.vertexFunction = [lib newFunctionWithName:@"vs"];
+        pd.fragmentFunction = [lib newFunctionWithName:@"fs"];
+        pd.colorAttachments[0].pixelFormat = dst.pixelFormat;
+        g_fg_scale_pso = lib ? [g_dev newRenderPipelineStateWithDescriptor:pd error:&e] : nil;
+        g_fg_scale_fmt = dst.pixelFormat;
+        if (!g_fg_scale_pso) {
+            RED_ONCE(182, "frame generation: no pipeline to copy the picture at its shown size (format %lu): %s",
+                     (unsigned long)dst.pixelFormat, e.description.UTF8String);
+            return 0;
+        }
+    }
+    if (!g_fg_args) {
+        MTL4ArgumentTableDescriptor *ad = [MTL4ArgumentTableDescriptor new];
+        ad.maxTextureBindCount = 1;
+        ad.maxSamplerStateBindCount = 1;
+        ad.maxBufferBindCount = 1;
+        g_fg_args = [g_dev newArgumentTableWithDescriptor:ad error:&e];
+        MTLSamplerDescriptor *sd = [MTLSamplerDescriptor new];
+        sd.minFilter = sd.magFilter = MTLSamplerMinMagFilterLinear;
+        sd.supportArgumentBuffers = YES;
+        g_fg_samp = [g_dev newSamplerStateWithDescriptor:sd];
+        if (!g_fg_args || !g_fg_samp) {
+            RED_ONCE(182, "frame generation: no argument table to copy the picture at its shown size");
+            g_fg_args = nil;
+            return 0;
+        }
+    }
+    if (!g_fg_uv[k]) {
+        g_fg_uv[k] = [g_dev newBufferWithLength:sizeof(float) * 8 options:MTLResourceStorageModeShared];
+        if (!g_fg_uv[k]) return 0;
+        [g_snap_res addAllocation:g_fg_uv[k]];
+        [g_snap_res commit];
+    }
+    float *uv = g_fg_uv[k].contents;
+    float w = (float)src.width, h = (float)src.height;
+    uv[0] = r[0] / w; uv[1] = r[1] / h; uv[2] = r[2] / w; uv[3] = r[3] / h;
+    uv[4] = (r[0] + 0.5f) / w; uv[5] = (r[1] + 0.5f) / h; uv[6] = (r[0] + r[2] - 0.5f) / w; uv[7] = (r[1] + r[3] - 0.5f) / h;
+    MTL4RenderPassDescriptor *rp = [MTL4RenderPassDescriptor new];
+    rp.colorAttachments[0].texture = dst;
+    rp.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+    rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTL4RenderCommandEncoder> en = [cb renderCommandEncoderWithDescriptor:rp];
+    if (!en) { RED_ONCE(182, "frame generation: no render encoder to copy the picture at its shown size"); return 0; }
+    [en barrierAfterQueueStages:MTLStageAll beforeStages:MTLStageFragment visibilityOptions:resource_vis()];
+    [en setArgumentTable:g_fg_args atStages:MTLRenderStageFragment];
+    [g_fg_args setTexture:src.gpuResourceID atIndex:0];
+    [g_fg_args setSamplerState:g_fg_samp.gpuResourceID atIndex:0];
+    [g_fg_args setAddress:g_fg_uv[k].gpuAddress atIndex:0];
+    [en setViewport:(MTLViewport){0, 0, dst.width, dst.height, 0, 1}];
+    [en setRenderPipelineState:g_fg_scale_pso];
+    [en drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [en barrierAfterStages:MTLStageFragment beforeQueueStages:MTLStageAll visibilityOptions:resource_vis()];
+    [en endEncoding];
+    return 1;
+}
