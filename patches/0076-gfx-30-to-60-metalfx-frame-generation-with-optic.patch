+            return g_fgmv_ok = 0;
+        }
+    }
+    if (g_fgmv_ps[FGMV_SEARCH].maxTotalThreadsPerThreadgroup < 256) {
+        MLOG("[RED] frame generation: the motion search needs 256 threads a group, this GPU gives %lu: no motion given",
+             (unsigned long)g_fgmv_ps[FGMV_SEARCH].maxTotalThreadsPerThreadgroup);
+        return g_fgmv_ok = 0;
+    }
+    MTL4ArgumentTableDescriptor *ad = [MTL4ArgumentTableDescriptor new];
+    ad.maxTextureBindCount = 5;
+    g_fgmv_args = [g_dev newArgumentTableWithDescriptor:ad error:&err];
+    if (!g_fgmv_args) {
