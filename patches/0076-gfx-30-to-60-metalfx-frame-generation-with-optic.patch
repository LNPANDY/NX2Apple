+static int fg_on(void) {
+    int m = atomic_load_explicit(&g_fg_mode, memory_order_acquire);
+    if (m >= 0) return m;
+    pthread_mutex_lock(&g_fg_cfg_mu);
+    m = atomic_load_explicit(&g_fg_mode, memory_order_relaxed);
+    if (m < 0) {
+        const char *e = getenv("DM_FRAMEGEN");
+        int v = e && atoi(e) > 0;
+        int sup = g_q4 && [MTLFXFrameInterpolatorDescriptor supportsMetal4FX:g_dev];
+        [[NSUserDefaults standardUserDefaults] setBool:!sup forKey:@"dm.framegen.unsupported"];
+        if (v && !sup) {
+            MLOG("[RED] frame generation (DM_FRAMEGEN): this GPU has no Metal 4 MetalFX frame interpolator; frames are shown as the game draws them");
+            v = 0;
+        } else if (v) {
+            MLOG("frame generation (DM_FRAMEGEN=1): MetalFX's frame interpolator makes a frame between each two presents, shown on the display link between them");
+        }
+        atomic_store_explicit(&g_fg_mode, v, memory_order_release);
+        m = v;
+    }
+    pthread_mutex_unlock(&g_fg_cfg_mu);
+    return m;
