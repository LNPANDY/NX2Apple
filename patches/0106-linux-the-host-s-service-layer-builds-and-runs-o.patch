+// ---- the allocator zones
+//
+// The host installs its own zone for the games whose allocator is cut (Unreal's
+// FMallocBinned3, hle_uemalloc.c). Linux's malloc has no zones, so the zone is a name and
+// the allocations go to the C library, which is what the zone would do anyway.
+
+struct malloc_zone {
+    char name[64];
+    size_t size;
+};
+
+malloc_zone_t malloc_create_zone(size_t size, void *start) {
+    (void)size;
+    (void)start;
+    malloc_zone_t z = (malloc_zone_t)calloc(1, sizeof *z);
+    if (!z) return NULL;
+    snprintf(z->name, sizeof z->name, "zone");
+    return z;
+}
+
+void malloc_set_zone_name(malloc_zone_t zone, const char *name) {
+    if (!zone || !name) return;
+    snprintf(zone->name, sizeof zone->name, "%s", name);
+}
+
+const char *malloc_zone_name(malloc_zone_t zone) {
+    if (!zone) return "default";
+    return zone->name[0] ? zone->name : "default";
+}
+
+#ifdef __GNUC__
+#define DM_ALIGNOF(t) __alignof__(t)
+#else
+#define DM_ALIGNOF(t) sizeof(t)
+#endif
+
+static void *zone_alloc(malloc_zone_t zone, size_t size, size_t alignment) {
+    (void)zone;
+    if (size < 16) size = 16;
+    void *p = NULL;
+    if (alignment <= DM_ALIGNOF(max_align_t)) {
+        p = malloc(size);
+    } else {
+        if (posix_memalign(&p, alignment, size)) return NULL;
+    }
+    return p;
+}
+
+void *malloc_zone_malloc(malloc_zone_t zone, size_t size) { return zone_alloc(zone, size, 16); }
+
+void *malloc_zone_memalign(malloc_zone_t zone, size_t alignment, size_t size) {
+    if (alignment < 16) alignment = 16;
+    return zone_alloc(zone, size, alignment);
+}
+
+void *malloc_zone_realloc(malloc_zone_t zone, void *ptr, size_t size) {
+    (void)zone;
+    if (!ptr) return malloc_zone_malloc(NULL, size);
+    if (size < 16) size = 16;
+    return realloc(ptr, size);
+}
+
+void malloc_zone_free(malloc_zone_t zone, void *ptr) {
+    (void)zone;
+    free(ptr);
+}
+
+#include <malloc.h>   // malloc_usable_size (glibc)
+
+size_t malloc_size(const void *ptr) {
+    if (!ptr) return 0;
+    return malloc_usable_size((void *)ptr);
+}
+
+// ---- the BSD functions Apple's libc has that Linux's does not
+//
+// mergesort is the stable sort the scripted-input recorder uses (hle_hid.c): a stable
+// order matters there, because two entries with the same key keep the order they were
+// written in. qsort is not stable, so the merge sort is implemented here.
+void mergesort(void *base, size_t nmemb, size_t size, int (*compar)(const void *, const void *)) {
+    if (!base || nmemb < 2 || !size) return;
+    uint8_t *a = (uint8_t *)base;
+    void *tmp = malloc(nmemb * size);
+    if (!tmp) {
+        qsort(base, nmemb, size, compar);   // no room: the unstable sort is better than none
+        return;
+    }
+    // bottom-up: runs of 1, 2, 4 ... merged in pairs
+    uint8_t *dst = (uint8_t *)tmp;
+    for (size_t run = 1; run < nmemb; run *= 2) {
+        for (size_t lo = 0; lo < nmemb; lo += 2 * run) {
+            size_t mid = lo + run < nmemb ? lo + run : nmemb;
+            size_t hi = lo + 2 * run < nmemb ? lo + 2 * run : nmemb;
+            size_t i = lo, j = mid, k = lo;
+            while (i < mid && j < hi) {
+                if (compar(a + j * size, a + i * size) < 0) memcpy(dst + (k++) * size, a + (j++) * size, size);
+                else memcpy(dst + (k++) * size, a + (i++) * size, size);
+            }
+            while (i < mid) memcpy(dst + (k++) * size, a + (i++) * size, size);
+            while (j < hi) memcpy(dst + (k++) * size, a + (j++) * size, size);
+        }
+        memcpy(a, tmp, nmemb * size);
+    }
+    free(tmp);
+}
+
+// The randomness the host uses for its identifiers (hle_os.c). Linux's getrandom is the
+// same thing.
+unsigned int arc4random(void) {
+    uint32_t v = 0;
+    getrandom(&v, sizeof v, 0);
+    return v;
+}
+
+void arc4random_buf(void *buf, size_t nbytes) {
+    if (!buf) return;
+    // The kernel fills at most 32 bytes per call, so the rest needs a loop. The host's
+    // keys are at most one page.
+    uint8_t *p = (uint8_t *)buf;
+    size_t left = nbytes;
+    while (left) {
+        size_t n = left < 32 ? left : 32;
+        ssize_t got = getrandom(p, n, 0);
+        if (got < 0 && errno == EINTR) continue;
+        if (got <= 0) {
+            getentropy(p, left);
+            return;
+        }
+        p += got;
+        left -= (size_t)got;
+    }
+}
+
+// The per-process resource usage, from /proc/self/io: the page-ins and the bytes read are
+// there; the rest stays zero, which the host's report prints as -1.
+static void rusage_fill(rusage_info_v4 *ru) {
+    memset(ru, 0, sizeof *ru);
+    FILE *f = fopen("/proc/self/io", "r");
+    if (!f) return;
+    char line[256];
+    while (fgets(line, sizeof line, f)) {
+        unsigned long long v = 0;
+        if (sscanf(line, "syscr: %llu", &v) == 1) ru->ri_diskio_bytesread = v * 4096ull;
+        else if (sscanf(line, "pgpgin: %llu", &v) == 1) ru->ri_pageins = v;
+    }
+    fclose(f);
+}
+
+int proc_pid_rusage(int pid, int flavor, rusage_info_t *buffer) {
+    (void)pid;
+    if (flavor != RUSAGE_INFO_V4 || !buffer) return -1;
+    rusage_fill(buffer);
+    return 0;
+}
