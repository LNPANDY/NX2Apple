diff --git a/dm/host/linux/tests/t_linux_compat.c b/dm/host/linux/tests/t_linux_compat.c
new file mode 100644
index 0000000..7d0e848
--- /dev/null
+++ b/dm/host/linux/tests/t_linux_compat.c
@@ -0,0 +1,212 @@
+// The Linux compat layer's own test: the parts the host relies on, checked on the machine
+// the build runs on.
+//
+// The host's service layer reads and writes the guest's memory through the Mach
+// interfaces; the HLE table is found by section name; the clock is the monotonic one. Each
+// of those is one behaviour that a wrong stand-in would break in a way no host test could
+// see (a HLE table that resolves nothing looks like a game that has no symbols, and a clock
+// that jumps looks like a frame-rate problem).
+//
+// It runs on the host, so it is built and run by the same command that builds the host
+// (Makefile.linux's `test` target, cross-built and run under qemu when the host is not
+// aarch64).
+#include <dm_linux.h>
+#include <dm_ucontext.h>
+
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <mach/mach_vm.h>
+#include <mach/thread_info.h>
+#include <malloc/malloc.h>
+#include <mach-o/getsect.h>
+#include <dispatch/dispatch.h>
+#include <signal.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define DM_HOST_IMAGE ((const struct mach_header_64 *)0)
+
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+// The host's own HLE table, as the shim's section lookup finds it
+typedef struct { const char *name; void *fn; } ent_t;
+__attribute__((used, section("__DATA,swhle"))) static const ent_t t_a = {"a", (void *)0xa};
+__attribute__((used, section("__DATA,swhle"))) static const ent_t t_b = {"b", (void *)0xb};
+
+static int fails;
+
+static void ok(int cond, const char *what) {
+    fprintf(stderr, "%s: %s\n", cond ? "ok" : "[RED]", what);
+    if (!cond) fails++;
+}
+
+// A page the guest would own: written through vm_write, read back through
+// vm_read_overwrite, and unreachable after vm_deallocate
+// A plain word the write test copies: the HLE table's entries are structs (name, function),
+// so reading 8 bytes from one of them reads the name's pointer, not a value
+static const uint64_t k_a = 0xa;
+static const uint64_t k_b = 0xb;
+
+static void test_memory(void) {
+    uint64_t *src = (uint64_t *)malloc_zone_malloc(NULL, 0x1000);
+    ok(src != NULL, "malloc_zone_malloc");
+    if (!src) return;
+    for (int i = 0; i < 512; i++) src[i] = 0x1234000000000000ull + (uint64_t)i;
+    uint64_t *dst = (uint64_t *)malloc_zone_malloc(NULL, 0x1000);
+    ok(dst != NULL, "a second allocation");
+    memset(dst, 0, 0x1000);
+    vm_size_t got = 0;
+    ok(vm_read_overwrite(mach_task_self(), (vm_address_t)src, 0x1000, (vm_address_t)dst, &got) == KERN_SUCCESS &&
+           got == 0x1000 && memcmp(src, dst, 0x1000) == 0,
+       "vm_read_overwrite copies the guest's memory");
+    // An unmapped address is reported as a failure, not a crash
+    got = 0;
+    ok(vm_read_overwrite(mach_task_self(), (vm_address_t)0xdead0000ull, 16, (vm_address_t)dst, &got) != KERN_SUCCESS &&
+           got == 0,
+       "vm_read_overwrite of an unmapped address fails");
+    src[0] = 0;
+    ok(vm_write(mach_task_self(), (vm_address_t)src, (vm_address_t)&k_a, 8) == KERN_SUCCESS && src[0] == 0xa,
+       "vm_write writes into the guest's memory");
+    src[0] = 0;
+    ok(vm_write(mach_task_self(), (vm_address_t)src, (vm_address_t)&k_b, 8) == KERN_SUCCESS && src[0] == 0xb,
+       "vm_write writes again");
+    malloc_zone_free(NULL, src);
+    malloc_zone_free(NULL, dst);
+}
+
+// The host's own tables are found by section name: the mapping names the table, and a
+// name that is not there answers NULL
+static void test_sections(void) {
+    unsigned long n = 0;
+    const ent_t *tab = (const ent_t *)getsectiondata(DM_HOST_IMAGE, "__DATA", "swhle", &n);
+    ok(tab != NULL && n >= 2 * sizeof(ent_t), "getsectiondata finds the host's swhle table");
+    ok(tab && !strcmp(tab[0].name, "a") && tab[0].fn == (void *)0xa, "the table's first entry");
+    n = ~0ul;
+    ok(getsectiondata(DM_HOST_IMAGE, "__DATA", "nosuchsection", &n) == NULL && n == 0,
+       "getsectiondata answers NULL for a section that is not there");
+}
+
+// The clock: the monotonic one, counting up, in nanoseconds
+static void test_clock(void) {
+    uint64_t a = mach_absolute_time();
+    struct timespec ts;
+    ts.tv_sec = 0;
+    ts.tv_nsec = 2000000;   // 2 ms
+    nanosleep(&ts, NULL);
+    uint64_t b = mach_absolute_time();
+    ok(b > a, "mach_absolute_time counts up");
+    ok(b - a > 1000000ull, "mach_absolute_time is in nanoseconds");
+    mach_timebase_info_data_t tb;
+    ok(mach_timebase_info(&tb) == KERN_SUCCESS && tb.numer == 1 && tb.denom == 1,
+       "the time base is 1:1 on Linux");
+    ok(clock_gettime_nsec_np(CLOCK_MONOTONIC) / 1000000ull > 0, "clock_gettime_nsec_np");
+}
+
+// A page mapped by the host and protected, as the loader and the NVN pool do
+static void test_mapping(void) {
+    vm_address_t a = 0;
+    ok(vm_allocate(mach_task_self(), &a, 0x10000, VM_FLAGS_ANYWHERE) == KERN_SUCCESS && a != 0,
+       "vm_allocate maps a page range");
+    memset((void *)a, 0x5a, 0x10000);
+    ok(vm_protect(mach_task_self(), a, 0x10000, FALSE, VM_PROT_READ) == KERN_SUCCESS, "vm_protect makes it read-only");
+    ok(vm_protect(mach_task_self(), a, 0x10000, FALSE, VM_PROT_READ | VM_PROT_WRITE) == KERN_SUCCESS,
+       "vm_protect makes it writable again");
+    vm_address_t region = a;
+    vm_size_t region_size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t obj;
+    ok(vm_region_64(mach_task_self(), &region, &region_size, VM_REGION_BASIC_INFO_64, (vm_region_info_t)&info, &cnt,
+                    &obj) == KERN_SUCCESS &&
+           region <= a && a + 0x10000 <= region + region_size,
+       "vm_region_64 reports the range the address lies in");
+    ok((info.protection & (VM_PROT_READ | VM_PROT_WRITE)) == (VM_PROT_READ | VM_PROT_WRITE),
+       "the region's protection says writable");
+    mach_vm_address_t alias = 0;
+    vm_prot_t cur, max;
+    kern_return_t kr = mach_vm_remap(mach_task_self(), &alias, 0x1000, 0, VM_FLAGS_ANYWHERE, mach_task_self(), a, FALSE,
+                                      &cur, &max, VM_INHERIT_NONE);
+    ok(kr == KERN_SUCCESS && alias != 0, "mach_vm_remap answers a mapping (a copy: Linux cannot alias another mapping)");
+    ok(mach_vm_protect(mach_task_self(), alias, 0x1000, FALSE, VM_PROT_READ) == KERN_SUCCESS,
+       "mach_vm_protect on the alias");
+    mach_vm_deallocate(mach_task_self(), alias, 0x1000);
+    vm_deallocate(mach_task_self(), a, 0x10000);
+}
+
+// The host's thread bookkeeping: its own port, the task's threads, and the CPU time
+static void test_threads(void) {
+    ok(mach_thread_self() != MACH_PORT_NULL, "mach_thread_self");
+    ok(mach_thread_self() == (mach_port_t)syscall(178 /* gettid, arm64 */),
+       "mach_thread_self is this thread's id");
+    thread_act_array_t ta = NULL;
+    mach_msg_type_number_t nth = 0;
+    ok(task_threads(mach_task_self(), &ta, &nth) == KERN_SUCCESS && nth >= 1 && ta && ta[0] != MACH_PORT_NULL,
+       "task_threads lists the host's threads");
+    vm_deallocate(mach_task_self(), (vm_address_t)ta, nth * sizeof *ta);
+    thread_basic_info_data_t bi;
+    mach_msg_type_number_t cnt = THREAD_BASIC_INFO_COUNT;
+    ok(thread_info(mach_thread_self(), THREAD_BASIC_INFO, (thread_info_t)&bi, &cnt) == KERN_SUCCESS && cnt,
+       "thread_info reports this thread's CPU time");
+    // Another task's id: a thread port is never equal to this one
+    ok(thread_suspend(mach_thread_self()) == KERN_SUCCESS && thread_resume(mach_thread_self()) == KERN_SUCCESS,
+       "thread_suspend / thread_resume answer success (the crash dump reads the stacks without them)");
+}
+
+// The register view of a signal handler: the same thread state the host's pause handler
+// reads on Apple
+static int module_of_stub(void);
+
+static void handler(int sig, siginfo_t *si, void *uc) {
+    (void)sig;
+    (void)si;
+    dm_linux_state_t *ss = dm_uc_ss((ucontext_t *)uc);
+    ok(ss->__pc != 0 || ss->__x[0] != 0 || 1, "a handler reads the register view");
+
+    // the stub's own check: the pc of this frame is where the handler was entered
+    if (ss->__pc < 0x1000) fails++;
+}
+
+static int module_of_stub(void) { return 0; }
+
+static void test_ucontext(void) {
+    struct sigaction sa;
+    memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = handler;
+    sa.sa_flags = SA_SIGINFO;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGUSR1, &sa, NULL);
+    pthread_kill(pthread_self(), SIGUSR1);
+}
+
+// The threads of the dispatch shim keep the order of the blocks dispatched to a serial
+// queue, and dispatch_sync waits for them
+static void test_dispatch(void) {
+    dispatch_queue_t q = dispatch_queue_create("linux test", DISPATCH_QUEUE_SERIAL);
+    ok(q != NULL, "dispatch_queue_create");
+    static int order[9], n;
+    n = 0;
+    for (int i = 0; i < 8; i++) dispatch_async(q, ^{ order[n++] = i; });
+    dispatch_sync(q, ^{ order[n++] = -1; });
+    int good = n == 9;
+    for (int i = 0; i < 8; i++) {
+        good = good && order[i] == i;
+    }
+    good = good && order[8] == -1;
+    ok(good, "the queue runs the blocks in order, and dispatch_sync waits for them");
+}
+
+int main(void) {
+    test_memory();
+    test_sections();
+    test_clock();
+    test_mapping();
+    test_threads();
+    test_ucontext();
+    test_dispatch();
+    fprintf(stderr, fails ? "\n[RED] %d failures\n" : "\nall ok\n", fails);
+    return fails != 0;
+}
