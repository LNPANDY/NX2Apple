diff --git a/dm/host/linux/asm_elf.py b/dm/host/linux/asm_elf.py
new file mode 100644
index 0000000..767f220
--- /dev/null
+++ b/dm/host/linux/asm_elf.py
@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+"""Convert the engine's Mach-O assembly to ELF (the Linux build).
+
+The engine's hand-written assembly (dm/host/entry.S, dm/gfx/nvn/nvn_entry.S,
+dm/gfx/nvn/nvn_thunks.S) is in Mach-O syntax: the symbols carry a leading underscore,
+the visibility directive is .private_extern, an uninitialized reservation is .zerofill
+segment,section, and a C string block is .cstring. In ELF the symbols have no underscore,
+.private_extern is .hidden, .zerofill is a .bss reservation and .cstring is .rodata.
+
+The conversion is mechanical and the result goes to the .linux sibling of the source, so
+the macOS build keeps the file it always had. The words that must not be renamed (the
+ARM register names, and the symbols of the C interface, which have no underscore in the
+source either) are left alone.
+
+Usage: python3 mach_o_asm_to_elf.py <source.S> <out.S>
+"""
+import re
+import sys
+
+# The C interface the assembly references (they have no underscore in the C source, so
+# the Mach-O symbol got the underscore and the ELF one does not need it stripped).
+PLAIN = {   # kept for the record: every Mach-O symbol loses its underscore on ELF
+    "unused",
+    "nvn_slot", "nvn_real", "nvn_prof_ticks", "nvn_names", "nvn_unimpl_entry",
+    "nvn_prof_entry", "nvn_big_entry", "dm_gate", "dm_gate_top", "dm_gate_stubs",
+    "dm_thread_enter", "dm_thread_returned", "unimpl_stubs", "unimpl_entry",
+    "unimpl_c", "dm_bigstack_enter", "dm_bigstack_ret", "gate_dispatch", "dm_gate_nested",
+}
+
+
+def asm_to_elf(src: str) -> str:
+    t = src
+
+    # .cstring block -> .rodata (the strings, the labels and the relocations stay)
+    t = re.sub(r"^(\s*)\.cstring\s*$", r"\1.section .rodata", t, flags=re.M)
+
+    # .zerofill segment,section,symbol,size,align [comment] -> a .bss reservation
+    def zerofill(m):
+        seg, sect, sym, size, align = m.group(2), m.group(3), m.group(4), m.group(5), m.group(6)
+        sym = sym.lstrip("_")
+        return (f"{m.group(1)}.pushsection .bss\n{m.group(1)}.p2align {align}\n{m.group(1)}.globl {sym}\n"
+                f"{m.group(1)}.hidden {sym}\n{m.group(1)}{sym}:\n{m.group(1)}.zero {size}\n{m.group(1)}.popsection"
+                + (("\n" + m.group(1) + "// " + m.group(7).lstrip().lstrip("/").lstrip()) if m.group(7) else ""))
+    t = re.sub(r"^(\s*)\.zerofill\s+([^,]+),([^,]+),([^,]+),(\d+),(\d+)\s*(\S.*)?$", zerofill, t, flags=re.M)
+
+    # .private_extern X -> .hidden X
+    t = re.sub(r"^(\s*)\.private_extern\s+([A-Za-z_][A-Za-z0-9_]*)\s*$",
+               lambda m: f"{m.group(1)}.hidden {m.group(2).lstrip('_')}", t, flags=re.M)
+
+    # @PAGE / @PAGEOFF -> the ELF page-offset form
+    t = re.sub(r"([A-Za-z_][A-Za-z0-9_]*):lo12:", r":lo12:\1", t)
+    t = re.sub(r"([A-Za-z_][A-Za-z0-9_]*)\s*@PAGEOFF", r":lo12:\1", t)
+    t = re.sub(r"([A-Za-z_][A-Za-z0-9_]*)\s*@PAGE", r"\1", t)
+
+    # The symbols with a leading underscore: the label definitions and every word that
+    # refers to a symbol of this file or of the C interface.
+    # Every word that starts with an underscore and a letter is a Mach-O symbol name
+    # (Apple's assembler prefixes the linker's symbols with it): the underscore goes away.
+    t = re.sub(r"(?<![\w.])_([A-Za-z][A-Za-z0-9_]*)", r"\1", t)
+    return t
+
+
+def main():
+    if len(sys.argv) != 3:
+        print(__doc__)
+        return 2
+    src, out = sys.argv[1], sys.argv[2]
+    t = open(src, "r", encoding="utf-8").read()
+    open(out, "w", encoding="utf-8").write(asm_to_elf(t))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/dm/host/linux/entry_linux.S b/dm/host/linux/entry_linux.S
new file mode 100644
index 0000000..e2dc126
--- /dev/null
+++ b/dm/host/linux/entry_linux.S
@@ -0,0 +1,179 @@
+// Common entries + static stub tables.
+// 0) unimpl_stubs: named stubs for unimplemented imports, the k-th = movz x9,#k; b unimpl_entry (static code; iOS does not allow runtime generation)
+// 1) unimpl_entry: stub entry for unimplemented imports, x9 = stub number; save x0-x8+lr and call unimpl_c(idx, regs).
+// 2) dm_gate_stubs + dm_gate: the rewriter replaces svc / cntpct reads with a gate block that pushes the guest's x29 / x30 and calls the address in the thread's KGATE slot, which is
+//    this thread's stub (thread.c guest_gate_stack). The stub passes the top of the thread's gate stack to dm_gate, which saves x0-x30 there, calls gate_dispatch(ret, regs) on that stack,
+//    writes the registers back and returns. Horizon's kernel never writes a thread's stack during an SVC; the gate stack keeps it so.
+    .text
+    .globl unimpl_stubs
+    .p2align 3
+unimpl_stubs:
+    .set k, 0
+    .rept 4096                // = hle.c MAX_STUB
+    movz x9, #k
+    b unimpl_entry
+    .set k, k + 1
+    .endr
+
+    .globl unimpl_entry
+    .p2align 2
+unimpl_entry:
+    stp x29, x30, [sp, #-96]!
+    mov x29, sp
+    stp x0, x1, [sp, #16]
+    stp x2, x3, [sp, #32]
+    stp x4, x5, [sp, #48]
+    stp x6, x7, [sp, #64]
+    str x8, [sp, #80]
+    mov x0, x9
+    add x1, sp, #16
+    bl unimpl_c
+    ldp x29, x30, [sp], #96
+    ret
+
+// The gate stacks' tops, one per gate slot (thread.c guest_gate_stack). Page-aligned, so that stub k reaches its entry with adrp and an immediate offset alone
+    .globl dm_gate_top
+    .pushsection .bss
+    .p2align 12
+    .globl dm_gate_top
+    .hidden dm_gate_top
+dm_gate_top:
+    .zero 8192
+    .popsection
+
+// Stub k (16 bytes) serves gate slot k: x29 = the return point (the gate block holds the guest's x29 at [sp] and reloads it after the gate), x30 = the slot's gate stack top
+    .globl dm_gate_stubs
+    .p2align 4
+dm_gate_stubs:
+    .set k, 0
+    .rept 1024                // = thread.c GATE_SLOTS
+    mov x29, x30
+    adrp x30, dm_gate_top
+    ldr x30, [x30, #(8 * k)]
+    b dm_gate
+    .set k, k + 1
+    .endr
+
+    .globl dm_gate
+    .p2align 2
+dm_gate:
+    // The register frame (800 bytes) goes at the top of the gate stack, not below the guest's sp: on Horizon an SVC leaves the thread's stack as it was, including the words below sp.
+    // A collector that records a thread's sp before a blocking call and then scans from there finds pointers its callees left below their returned frames: Streets of Rage 4's BRUTE
+    // garbage collector parks a thread in Thread.Sleep with the caller's x20 only in such a word (main+0x2ff4c80's frame), which the old frame here overwrote, so a live array was freed.
+    // Layout as before: x0..x30 at +0 (x30 = the return point), q0..q31 at +256, nzcv / fpsr / fpcr at +768 / +776 / +784, and at +792 the gate block's sp
+    // (the guest's x29 / x30 the block pushed; the guest's stack follows at +16)
+    sub x30, x30, #800
+    stp x0, x1, [x30, #0]
+    stp x2, x3, [x30, #16]
+    stp x4, x5, [x30, #32]
+    stp x6, x7, [x30, #48]
+    stp x8, x9, [x30, #64]
+    stp x10, x11, [x30, #80]
+    stp x12, x13, [x30, #96]
+    stp x14, x15, [x30, #112]
+    stp x16, x17, [x30, #128]
+    stp x18, x19, [x30, #144]
+    stp x20, x21, [x30, #160]
+    stp x22, x23, [x30, #176]
+    stp x24, x25, [x30, #192]
+    stp x26, x27, [x30, #208]
+    str x28, [x30, #224]
+    stp q0, q1, [x30, #256]
+    stp q2, q3, [x30, #288]
+    stp q4, q5, [x30, #320]
+    stp q6, q7, [x30, #352]
+    stp q8, q9, [x30, #384]
+    stp q10, q11, [x30, #416]
+    stp q12, q13, [x30, #448]
+    stp q14, q15, [x30, #480]
+    stp q16, q17, [x30, #512]
+    stp q18, q19, [x30, #544]
+    stp q20, q21, [x30, #576]
+    stp q22, q23, [x30, #608]
+    stp q24, q25, [x30, #640]
+    stp q26, q27, [x30, #672]
+    stp q28, q29, [x30, #704]
+    stp q30, q31, [x30, #736]
+    mrs x9, nzcv
+    str x9, [x30, #768]
+    mrs x9, fpsr
+    str x9, [x30, #776]
+    mrs x9, fpcr
+    str x9, [x30, #784]
+    ldr x9, [sp]              // the guest's x29 (the crash backtrace walks the x29 chain from here)
+    stp x9, x29, [x30, #232]  // x29, then x30 = the return point
+    mov x9, sp
+    str x9, [x30, #792]
+    // A gate entered on its own gate stack would overwrite the frame of the gate below it: none is (gate handlers do not run guest code); stop if one ever is
+    add x10, x30, #800
+    cmp x9, x10
+    b.hs 1f
+    sub x10, x10, #0x100000   // = thread.c GATE_STACK_SIZE
+    cmp x9, x10
+    b.lo 1f
+    mov sp, x30
+    mov x0, x9
+    bl dm_gate_nested
+1:  mov sp, x30
+    ldr x29, [sp, #232]
+    ldr x0, [sp, #240]        // Return point = gate identifier
+    mov x1, sp                // regs
+    bl gate_dispatch
+    ldr x9, [sp, #784]
+    msr fpcr, x9
+    ldr x9, [sp, #776]
+    msr fpsr, x9
+    ldr x9, [sp, #768]
+    msr nzcv, x9
+    ldp q0, q1, [sp, #256]
+    ldp q2, q3, [sp, #288]
+    ldp q4, q5, [sp, #320]
+    ldp q6, q7, [sp, #352]
+    ldp q8, q9, [sp, #384]
+    ldp q10, q11, [sp, #416]
+    ldp q12, q13, [sp, #448]
+    ldp q14, q15, [sp, #480]
+    ldp q16, q17, [sp, #512]
+    ldp q18, q19, [sp, #544]
+    ldp q20, q21, [sp, #576]
+    ldp q22, q23, [sp, #608]
+    ldp q24, q25, [sp, #640]
+    ldp q26, q27, [sp, #672]
+    ldp q28, q29, [sp, #704]
+    ldp q30, q31, [sp, #736]
+    // A gate may modify any general-purpose register: svc out-parameters are in x0..x8, and the target of mrs cntpct can be any xN (14 of the 33 sites in sdk are x19..x23)
+    // ⇒ read back all of x0..x28 (x18 is the Apple platform register; the guest's x18 has been rewritten to the thread slot, so skip it and leave it alone).
+    // x29 / x30 are the gate block's to restore (from the words it pushed): here they carry the block's sp and the return point
+    ldp x0, x1, [sp, #0]
+    ldp x2, x3, [sp, #16]
+    ldp x4, x5, [sp, #32]
+    ldp x6, x7, [sp, #48]
+    ldp x8, x9, [sp, #64]
+    ldp x10, x11, [sp, #80]
+    ldp x12, x13, [sp, #96]
+    ldp x14, x15, [sp, #112]
+    ldp x16, x17, [sp, #128]
+    ldr x19, [sp, #152]
+    ldp x20, x21, [sp, #160]
+    ldp x22, x23, [sp, #176]
+    ldp x24, x25, [sp, #192]
+    ldp x26, x27, [sp, #208]
+    ldr x28, [sp, #224]
+    ldr x30, [sp, #240]
+    ldr x29, [sp, #792]
+    mov sp, x29
+    ret
+
+// 3) dm_thread_enter(entry, arg, sp): guest thread start. Switch to the guest stack given by the SDK and call entry with x0 = argument;
+//    Horizon threads must exit via ExitThread; returning from entry is reported as an error.
+    .globl dm_thread_enter
+    .p2align 2
+dm_thread_enter:
+    mov sp, x2
+    mov x29, #0
+    mov x16, x0
+    mov x0, x1
+    adr x30, 1f
+    br x16
+1:  bl dm_thread_returned
+    brk #0
diff --git a/dm/host/linux/front_linux.c b/dm/host/linux/front_linux.c
new file mode 100644
index 0000000..5bc1fc8
--- /dev/null
+++ b/dm/host/linux/front_linux.c
@@ -0,0 +1,125 @@
+// The Linux front end: the guest runs on the main thread, no window.
+//
+// The Mac front end (front_mac.m) holds a window, a display link that paces the presents,
+// the controller applet, the web applet and the input box. On Linux there is a window to
+// be written against (M3: X11 / Wayland, SDL or Vulkan surface), and until it exists the
+// host runs the guest directly on the calling thread with no window: the frame pacing is
+// the game's own waits, the input comes from the keyboard (DM_KEYS), and everything the
+// front end would show (progress screen, prompts, panels) is absent, as on a graphics unit
+// test.
+//
+// What the front end still gives the guest on Linux: a display with a shape (DM_SCREEN_W /
+// DM_SCREEN_H, 1280x720 by default, the Switch's own), the display's refresh rate for the
+// frame pacing, and the graceful exit on SIGINT / SIGTERM, which hle_lifecycle.c handles
+// through GCD.
+#include "front.h"
+
+#include "dm.h"
+
+#include <pthread.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+// The display the game draws on: the Switch's own screen, overridable (DM_SCREEN_W / H,
+// as the Mac front end reads its window's screen).
+static int screen_w(void) {
+    static int w = -1;
+    if (w < 0) {
+        const char *e = getenv("DM_SCREEN_W");
+        w = (e && atoi(e) > 0) ? atoi(e) : 1280;
+    }
+    return w;
+}
+
+static int screen_h(void) {
+    static int h = -1;
+    if (h < 0) {
+        const char *e = getenv("DM_SCREEN_H");
+        h = (e && atoi(e) > 0) ? atoi(e) : 720;
+    }
+    return h;
+}
+
+// 60 Hz unless the profile says otherwise (DM_SCREEN_HZ), and 120 for a game that asks for
+// it: the frame rate the game paces to.
+static int screen_fps(void) {
+    static int fps = -1;
+    if (fps < 0) {
+        const char *e = getenv("DM_SCREEN_HZ");
+        fps = (e && atoi(e) > 0) ? atoi(e) : 60;
+    }
+    return fps;
+}
+
+int front_screen_max_fps(void) { return screen_fps(); }
+
+int front_display_pixels(int *w, int *h) {
+    if (w) *w = screen_w();
+    if (h) *h = screen_h();
+    return 1;
+}
+
+int front_screen_variable_refresh(void) { return 0; }
+
+void front_screen_match(int fps) {
+    // No screen mode to switch: the front end is headless.
+    (void)fps;
+}
+
+void front_picture_shape(int w, int h) {
+    (void)w;
+    (void)h;
+}
+
+void front_progress(const char *title, long done, long total) {
+    // No window to draw it over: the host prints one line, as it does with no front end.
+    (void)done;
+    (void)total;
+    if (title)
+        fprintf(stderr, "[dm] progress: %s\n", title);
+}
+
+void (*front_progress_hook)(const char *title, long done, long total) = NULL;
+
+// The text box (software keyboard): without a window nothing is shown, and the caller
+// answers as the player cancelling it (front.h: -1 with no window).
+int front_text_input(const char *title, const char *sub, const char *guide, const char *initial, int max_chars,
+                    char *out, int out_cap) {
+    (void)title;
+    (void)sub;
+    (void)guide;
+    (void)initial;
+    (void)max_chars;
+    (void)out;
+    (void)out_cap;
+    return -1;
+}
+
+int front_ctrl_support(int min, int max) {
+    (void)min;
+    (void)max;
+    return -1;   // no controllers without a window
+}
+
+
+// The layer the game's frames go to: no window, no layer.
+void *front_metal_layer(void) { return NULL; }
+
+// The guest runs on the calling thread: the host has no main loop of its own on Linux
+// without a window, so this is the whole front end's run.
+void front_run(void (*guest)(void)) {
+    static int installed;
+    if (!installed) {
+        installed = 1;
+        // SIGINT from the terminal: the graceful exit (hle_lifecycle.c) takes SIGTERM; the
+        // console's Ctrl-C is SIGINT, so it is handed over to the same path.
+        struct sigaction sa;
+        memset(&sa, 0, sizeof sa);
+        sa.sa_handler = SIG_IGN;   // the default action would end the run without a flush
+        sigemptyset(&sa.sa_mask);
+        sigaction(SIGINT, &sa, NULL);
+    }
+    guest();
+}
diff --git a/dm/host/linux/include/Block.h b/dm/host/linux/include/Block.h
new file mode 100644
index 0000000..986330f
--- /dev/null
+++ b/dm/host/linux/include/Block.h
@@ -0,0 +1,30 @@
+// The declarations of the BlocksRuntime: the blocks the host's dispatch calls take.
+//
+// Clang's block syntax needs the runtime that Apple ships in libSystem (the class of a
+// stack block, and the copy and release of a block that outlives the stack it was made
+// on). The implementation is linux/linux_blocks.c.
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// The copy of a block to the heap: NULL when the block cannot be copied (a global block is
+// itself, a stack block is copied, a heap block's reference count goes up).
+void *_Block_copy(const void *block);
+
+// The release of a block: the reference count of a heap block goes down, and it is freed
+// when the last one is gone. A stack or a global block is left alone.
+void _Block_release(const void *block);
+
+// The byref helpers: the __block variables captured by a block are copied to the heap the
+// same way.
+void *_Block_byref_copy(const void *from);
+void _Block_byref_release(const void *from);
+
+void _Block_object_assign(void *dst, const void *object, const int flags);
+void _Block_object_dispose(const void *object, const int flags);
+
+#ifdef __cplusplus
+}
+#endif
