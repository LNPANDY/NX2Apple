+// ---- CommonCrypto: SHA-256
+//
+// The host hashes the game's modules (loader.c's DM_LOADHASH), the read-only section
+// (hle_ro.c) and the JIT requests (hle_jit.c). The implementation is the standard one.
+
+#define ROTR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
+
+static const uint32_t cc_k[64] = {
+    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+};
+
+static void sha256_block(uint32_t h[8], const uint8_t *p, size_t n) {
+    while (n--) {
+        uint32_t w[64];
+        for (int i = 0; i < 16; i++) {
+            w[i] = ((uint32_t)p[i * 4] << 24) | ((uint32_t)p[i * 4 + 1] << 16) |
+                   ((uint32_t)p[i * 4 + 2] << 8) | (uint32_t)p[i * 4 + 3];
+        }
+        for (int i = 16; i < 64; i++) {
+            uint32_t s0 = ROTR(w[i - 15], 7) ^ ROTR(w[i - 15], 18) ^ (w[i - 15] >> 3);
+            uint32_t s1 = ROTR(w[i - 2], 17) ^ ROTR(w[i - 2], 19) ^ (w[i - 2] >> 10);
+            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+        }
+        uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
+        for (int i = 0; i < 64; i++) {
+            uint32_t S1 = ROTR(e, 6) ^ ROTR(e, 11) ^ ROTR(e, 25);
+            uint32_t ch = (e & f) ^ (~e & g);
+            uint32_t t1 = hh + S1 + ch + cc_k[i] + w[i];
+            uint32_t S0 = ROTR(a, 2) ^ ROTR(a, 13) ^ ROTR(a, 22);
+            uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+            uint32_t t2 = S0 + maj;
+            hh = g;
+            g = f;
+            f = e;
+            e = d + t1;
+            d = c;
+            c = b;
+            b = a;
+            a = t1 + t2;
+        }
+        h[0] += a;
+        h[1] += b;
+        h[2] += c;
+        h[3] += d;
+        h[4] += e;
+        h[5] += f;
+        h[6] += g;
+        h[7] += hh;
+        p += 64;
+    }
+}
+
+void CC_SHA256_Init(CC_SHA256_CTX *ctx) {
+    ctx->state[0] = 0x6a09e667;
+    ctx->state[1] = 0xbb67ae85;
+    ctx->state[2] = 0x3c6ef372;
+    ctx->state[3] = 0xa54ff53a;
+    ctx->state[4] = 0x510e527f;
+    ctx->state[5] = 0x9b05688c;
+    ctx->state[6] = 0x1f83d9ab;
+    ctx->state[7] = 0x5be0cd19;
+    ctx->count = 0;
+}
+
+void CC_SHA256_Update(CC_SHA256_CTX *ctx, const void *data, CC_LONG len) {
+    const uint8_t *p = (const uint8_t *)data;
+    if (!ctx || !p) return;
+    uint64_t bits = (uint64_t)len * 8;
+    ctx->count += bits;
+    size_t fill = (size_t)(ctx->count / 8 % 64);
+    if (fill) {
+        size_t n = 64 - fill;
+        if (n > (size_t)len) n = (size_t)len;
+        memcpy(ctx->buffer + fill, p, n);
+        p += n;
+        len = (CC_LONG)((int64_t)len - (int64_t)n);
+        if (fill + n == 64) sha256_block(ctx->state, ctx->buffer, 1);
+    }
+    size_t blocks = (size_t)len / 64;
+    if (blocks) {
+        sha256_block(ctx->state, p, blocks);
+        p += blocks * 64;
+        len = (CC_LONG)((int64_t)len - (int64_t)(blocks * 64));
+    }
+    if (len) memcpy(ctx->buffer, p, (size_t)len);
+}
+
+void CC_SHA256_Final(unsigned char *digest, CC_SHA256_CTX *ctx) {
+    uint64_t bits = ctx->count;
+    uint8_t pad[72];
+    size_t fill = (size_t)(ctx->count / 8 % 64);
+    size_t n = fill < 56 ? 56 - fill : 120 - fill;
+    memset(pad, 0, sizeof pad);
+    pad[0] = 0x80;
+    for (int i = 0; i < 8; i++) pad[n + (size_t)i] = (uint8_t)(bits >> (56 - 8 * i));
+    CC_SHA256_Update(ctx, pad, (CC_LONG)n);
+    CC_SHA256_Update(ctx, pad + n, 8);
+    for (int i = 0; i < 8; i++) {
+        digest[i * 4] = (uint8_t)(ctx->state[i] >> 24);
+        digest[i * 4 + 1] = (uint8_t)(ctx->state[i] >> 16);
+        digest[i * 4 + 2] = (uint8_t)(ctx->state[i] >> 8);
+        digest[i * 4 + 3] = (uint8_t)ctx->state[i];
+    }
+}
+
+unsigned char *CC_SHA256(const void *data, CC_LONG len, unsigned char *digest) {
+    CC_SHA256_CTX ctx;
+    CC_SHA256_Init(&ctx);
+    CC_SHA256_Update(&ctx, data, len);
+    CC_SHA256_Final(digest, &ctx);
+    return digest;
+}
+
+// ---- sysctl and the BSD functions Apple's libc has that Linux's does not
+//
+// The two sysctl calls the host makes are the start time of the process (the zero point
+// of its boot timeline) and the model of the machine (the save sync's key). Linux has
+// both in /proc and uname.
+
+int sysctl(int *mib, unsigned int miblen, void *oldp, size_t *oldlenp, void *newp, size_t newlen) {
+    (void)newp;
+    (void)newlen;
+    if (miblen < 3 || mib[0] != CTL_KERN || mib[1] != KERN_PROC || mib[2] != KERN_PROC_PID)
+        return -1;
+    // The start time of the process: field 22 of /proc/self/stat, in clock ticks since
+    // the boot, converted to a wall-clock time.
+    FILE *f = fopen("/proc/self/stat", "r");
+    if (!f) return -1;
+    char line[4096];
+    if (!fgets(line, sizeof line, f)) {
+        fclose(f);
+        return -1;
+    }
+    fclose(f);
+    char *p = strrchr(line, ')');
+    if (!p) return -1;
+    unsigned long long start = 0;
+    long hz = sysconf(_SC_CLK_TCK);
+    if (hz <= 0) hz = 100;
+    if (sscanf(p + 1, "%*c %*d %*d %*d %*d %*d %*u %*u %*u %*u %*u %*u %*u %llu", &start) != 1)
+        return -1;
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    uint64_t now_ns = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+    uint64_t start_ns = start * 1000000000ull / (uint64_t)hz;
+    uint64_t wall_ns = now_ns > start_ns ? now_ns - start_ns : 0;
+    struct kinfo_proc *kp = (struct kinfo_proc *)oldp;
+    if (!kp) {
+        if (oldlenp) *oldlenp = sizeof(struct kinfo_proc);
+        return 0;
+    }
+    kp->kp_proc.p_starttime.tv_sec = (time_t)(wall_ns / 1000000000ull);
+    kp->kp_proc.p_starttime.tv_usec = (suseconds_t)((wall_ns % 1000000000ull) / 1000);
+    if (oldlenp) *oldlenp = sizeof(struct kinfo_proc);
+    return 0;
+}
+
+int sysctlbyname(const char *name, void *oldp, size_t *oldlenp, void *newp, size_t newlen) {
+    (void)newp;
+    (void)newlen;
+    if (!name) return -1;
+    if (!strcmp(name, "hw.machine") || !strcmp(name, "hw.model") || !strcmp(name, "hw.ncpu")) {
+        // The machine's name: uname on Linux.
+        struct utsname u;
+        if (uname(&u)) return -1;
+        const char *v = !strcmp(name, "hw.ncpu") ? NULL : (!strcmp(name, "hw.model") ? "Linux" : u.machine);
+        if (!v) {
+            long c = sysconf(_SC_NPROCESSORS_ONLN);
+            if (oldp && oldlenp && *oldlenp >= sizeof(int)) *(int *)oldp = (int)c;
+            if (oldlenp) *oldlenp = sizeof(int);
+            return 0;
+        }
+        size_t n = strlen(v);
+        if (!oldp || !oldlenp) return 0;
+        if (*oldlenp < n + 1) return -1;
+        memcpy(oldp, v, n + 1);
+        *oldlenp = n + 1;
+        return 0;
+    }
+    // Everything else (hw.nperflevels, the thermal state...) has no Linux answer.
+    return -1;
+}
+
+// ---- the sections of the running executable
+//
+// The host's tables (the HLE table, the forced-take-over table) are found by section name:
+// on Apple the __DATA segment, on Linux one section named "segment,section", because the
+// compiler puts every table with the same section attribute in the same section there too.
+// The section headers are not in memory, so they are read from /proc/self/exe, and the
+// address is the link-time address plus the base the image was loaded at.
+
+struct elf_sections {
+    char section[64];
+    unsigned long long sh_addr, sh_size, sh_offset;
+    int found;
+};
+
+static int elf_section_cb(struct dl_phdr_info *info, size_t size, void *data) {
+    (void)size;
+    struct elf_sections *want = (struct elf_sections *)data;
+    // The running executable is the first entry: it has no name, or the path the loader
+    // read it through (/proc/self/exe, which qemu-user reports). A loaded library has its
+    // own name and is not this one.
+    if (info->dlpi_name && info->dlpi_name[0] && strcmp(info->dlpi_name, "/proc/self/exe")) return 0;
+    ElfW(Ehdr) eh;
+    FILE *f = fopen("/proc/self/exe", "rb");
+    if (!f) return 0;
+    if (fread(&eh, sizeof eh, 1, f) != 1 || memcmp(eh.e_ident, "\177ELF", 4)) {
+        fclose(f);
+        return 0;
+    }
+    if (fseek(f, (long)eh.e_shoff, SEEK_SET) || !eh.e_shnum || eh.e_shstrndx >= eh.e_shnum) {
+        fclose(f);
+        return 0;
+    }
+    ElfW(Shdr) strtab;
+    if (fseek(f, (off_t)eh.e_shoff + (off_t)eh.e_shstrndx * (off_t)eh.e_shentsize, SEEK_SET) ||
+        fread(&strtab, sizeof strtab, 1, f) != 1) {
+        fclose(f);
+        return 0;
+    }
+    for (int s = 0; s < eh.e_shnum; s++) {
+        ElfW(Shdr) sh;
+        // Every section header, from the table's start (e_shoff), in file order
+        if (fseek(f, (off_t)eh.e_shoff + (off_t)s * (off_t)eh.e_shentsize, SEEK_SET) ||
+            fread(&sh, sizeof sh, 1, f) != 1)
+            break;
+        if (sh.sh_type == SHT_NOBITS || sh.sh_name >= strtab.sh_size) continue;
+        char name[64] = {0};
+        if (fseek(f, (off_t)strtab.sh_offset + (off_t)sh.sh_name, SEEK_SET)) continue;
+        size_t n = fread(name, 1, sizeof name - 1, f);
+        if (!n) continue;
+        name[n] = 0;
+        if (strncmp(name, want->section, 63)) continue;
+        want->sh_addr = (unsigned long long)info->dlpi_addr + sh.sh_addr;
+        want->sh_size = sh.sh_size;
+        want->sh_offset = sh.sh_offset;
+        want->found = 1;
+        break;
+    }
+    fclose(f);
+    return 0;
+}
+
+const void *getsectiondata(const struct mach_header_64 *mhp, const char *segname, const char *sectname,
+                            unsigned long *size) {
+    (void)mhp;
+    if (size) *size = 0;
+    if (!segname || !sectname) return NULL;
+    struct elf_sections want;
+    memset(&want, 0, sizeof want);
+    snprintf(want.section, sizeof want.section, "%s,%s", segname, sectname);
+    dl_iterate_phdr(elf_section_cb, &want);
+    if (!want.found) return NULL;
+    if (size) *size = (unsigned long)want.sh_size;
+    return (const void *)(uintptr_t)want.sh_addr;
+}
