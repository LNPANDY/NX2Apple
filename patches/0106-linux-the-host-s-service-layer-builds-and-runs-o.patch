+// ---- the quality of service of a thread
+//
+// Linux has no QoS classes: the class of a thread is unspecified and setting one is
+// accepted without effect. The host prints the class and asks for the user's interactive
+// class on its present thread.
+
+int pthread_get_qos_class_np(pthread_t thread, qos_class_t *qos_class, int *relative_priority) {
+    (void)thread;
+    if (qos_class) *qos_class = QOS_CLASS_UNSPECIFIED;
+    if (relative_priority) *relative_priority = 0;
+    return 0;
+}
+
+int pthread_set_qos_class_np(pthread_t thread, qos_class_t qos_class, int relative_priority) {
+    (void)thread;
+    (void)qos_class;
+    (void)relative_priority;
+    return 0;
+}
+
+// pthread_getattr_np: glibc's, and musl's since 1.1.24 (older musl does not have it, and
+// the shim below falls back to the stack size the thread was created with).
+extern int pthread_getattr_np(pthread_t thread, pthread_attr_t *attr);
+
+// ---- the bounds of a thread's stack
+//
+// The Horizon stub hle_svc.c reports the host thread's stack as the current stack (the
+// SDK records it for the main thread at start). Linux gives the address and the size of
+// the thread's stack through pthread_attr_getstack.
+void *pthread_get_stackaddr_np(pthread_t thread) {
+    pthread_attr_t a;
+    if (pthread_getattr_np(thread, &a)) return NULL;
+    void *addr = NULL;
+    size_t size = 0;
+    if (pthread_attr_getstack(&a, &addr, &size)) return NULL;
+    pthread_attr_destroy(&a);
+    return (char *)addr + size;   // Darwin: the address of the top of the stack
+}
+
+size_t pthread_get_stacksize_np(pthread_t thread) {
+    pthread_attr_t a;
+    if (pthread_getattr_np(thread, &a)) return 0;
+    void *addr = NULL;
+    size_t size = 0;
+    if (pthread_attr_getstack(&a, &addr, &size)) return 0;
+    pthread_attr_destroy(&a);
+    return size;
+}
+
+int pthread_set_qos_class_self_np(qos_class_t qos_class, int relative_priority) {
+    (void)qos_class;
+    (void)relative_priority;
+    return 0;   // Linux has no QoS classes: accepted, no effect
+}
+
+size_t malloc_good_size(size_t size) { return size; }
+
+// ---- the extended attributes of a file
+//
+// The host's Darwin-shaped calls (options and position) are answered over Linux's
+// syscalls, which take the two cases apart (follow / no-follow) and have no position.
+int setxattr(const char *path, const char *name, const void *value, size_t size, uint32_t position,
+             int options) {
+    (void)position;
+    if (options & XATTR_NOFOLLOW) return (int)syscall(SYS_lsetxattr, path, name, value, size, 0);
+    return (int)syscall(SYS_setxattr, path, name, value, size, 0);
+}
+
+int removexattr(const char *path, const char *name, int options) {
+    if (options & XATTR_NOFOLLOW) return (int)syscall(SYS_lremovexattr, path, name);
+    return (int)syscall(SYS_removexattr, path, name);
+}
+
+// ---- renamex_np with RENAME_SWAP
+//
+// The save transaction swaps the working directory with the committed one atomically
+// (hle_fs.c). Linux's renameat2 with RENAME_EXCHANGE is the same operation.
+#ifndef RENAME_EXCHANGE
+#define RENAME_EXCHANGE 2
+#endif
+
+int renamex_np(const char *from, const char *to, unsigned int flags) {
+    if (flags == RENAME_SWAP) {
+        long rc = syscall(SYS_renameat2, AT_FDCWD, from, AT_FDCWD, to, RENAME_EXCHANGE);
+        if (rc < 0) return -1;
+        return 0;
+    }
+    errno = EINVAL;
+    return -1;
+}
+
+// ---- the name of a thread
+//
+// Linux keeps names of 16 bytes including the terminator and names one thread at a time.
+void dm_thread_set_name(const char *name) {
+    if (!name) return;
+    char shortname[16] = {0};
+    snprintf(shortname, sizeof shortname, "%s", name);
+    if (pthread_setname_np(pthread_self(), shortname)) return;   // fine as it is
+}
+
+// ---- the registers a signal handler is handed
+//
+// The integer registers are in the sigcontext; the NEON registers and their control live
+// in the fpsimd extension the kernel chains after them (both musl and glibc's aarch64
+// layouts are this shape).
+
+void dm_linux_ctx_read(void *uc, dm_linux_ctx_t *out) {
+    memset(out, 0, sizeof *out);
+    if (!uc) return;
+    ucontext_t *u = (ucontext_t *)uc;
+    for (int i = 0; i < 29; i++) out->x[i] = (uint64_t)u->uc_mcontext.regs[i];
+    out->fp = (uint64_t)u->uc_mcontext.regs[29];
+    out->lr = (uint64_t)u->uc_mcontext.regs[30];
+    out->sp = (uint64_t)u->uc_mcontext.sp;
+    out->pc = (uint64_t)u->uc_mcontext.pc;
+    out->pstate = (uint32_t)u->uc_mcontext.pstate;
+    // The fpsimd record: the sigcontext's __reserved is where the kernel chains it
+    struct dm_linux_ctx_head *head = (struct dm_linux_ctx_head *)(void *)&u->uc_mcontext.__reserved[0];
+    for (int guard = 0; head && guard < 16; guard++) {
+        if (!head->magic) break;
+        if (head->magic == 0x46508001u) {   // FPSIMD_MAGIC: the NEON registers and their control
+            char *base = (char *)head;
+            uint32_t fpsr = 0, fpcr = 0;
+            memcpy(&fpsr, base + 8, sizeof fpsr);
+            memcpy(&fpcr, base + 12, sizeof fpcr);
+            out->fpsr = fpsr;
+            out->fpcr = fpcr;
+            memcpy(out->v, base + 16, sizeof out->v);
+            return;
+        }
+        char *next = (char *)head + head->size;
+        if (next <= (char *)head) break;
+        head = (struct dm_linux_ctx_head *)(void *)next;
+    }
+}
+
+// The fault address and the write bit of a memory fault. Darwin holds both in the
+// exception state of the ucontext; Linux gives the address in the sigcontext and the
+// write bit in si_addr's siginfo (a SIGSEGV's si_code SEGV_ACCERR with the page's
+// protection is the read / write answer, which the handler below reads from the code).
+uint64_t dm_linux_ctx_fault(void *uc) {
+    if (!uc) return 0;
+    return (uint64_t)((ucontext_t *)uc)->uc_mcontext.fault_address;
+}
+
+int dm_linux_ctx_is_write(void *uc) {
+    (void)uc;
+    return 0;
+}
+
+// ---- the register view of a ucontext, in Darwin's member names
+//
+// The host's handlers (crash.c on_crash, probe.c probe_hit, hle_thread.c thr_pause_sig)
+// read and write the thread state through `uc->uc_mcontext->__ss`. Linux's sigcontext
+// holds the same registers in a different order, so the view is filled from it once per
+// handler invocation and written back when the handler asks for it.
+
+static __thread dm_linux_state_t t_ss;
+static __thread dm_linux_neon_t t_ns;
+static __thread ucontext_t *t_ss_uc;
+static __thread int t_ss_dirty;
+
+dm_linux_state_t *dm_uc_ss(ucontext_t *uc) {
+    if (!uc) return &t_ss;
+    if (uc != t_ss_uc) {
+        memset(&t_ss, 0, sizeof t_ss);
+        memset(&t_ns, 0, sizeof t_ns);
+        for (int i = 0; i < 29; i++) t_ss.__x[i] = (uint64_t)uc->uc_mcontext.regs[i];
+        t_ss.__fp = (uint64_t)uc->uc_mcontext.regs[29];
+        t_ss.__lr = (uint64_t)uc->uc_mcontext.regs[30];
+        t_ss.__sp = (uint64_t)uc->uc_mcontext.sp;
+        t_ss.__pc = (uint64_t)uc->uc_mcontext.pc;
+        t_ss.__cpsr = (uint32_t)uc->uc_mcontext.pstate;
+        t_ss_uc = uc;
+        t_ss_dirty = 0;
+        // The NEON registers: in the fpsimd extension of the sigcontext
+        struct dm_linux_ctx_head *head =
+            (struct dm_linux_ctx_head *)(void *)&uc->uc_mcontext.__reserved[0];
+        for (int guard = 0; head && guard < 16; guard++) {
+            if (!head->magic) break;
+            if (head->magic == 0x46508001u) {   // FPSIMD_MAGIC
+                char *base = (char *)head;
+                uint32_t fpsr = 0, fpcr = 0;
+                memcpy(&fpsr, base + 8, sizeof fpsr);
+                memcpy(&fpcr, base + 12, sizeof fpcr);
+                t_ns.__fpsr = fpsr;
+                t_ns.__fpcr = fpcr;
+                memcpy(t_ns.__v, base + 16, sizeof t_ns.__v);
+                break;
+            }
+            char *next = (char *)head + head->size;
+            if (next <= (char *)head) break;
+            head = (struct dm_linux_ctx_head *)(void *)next;
+        }
+    }
+    return &t_ss;
+}
+
+dm_linux_neon_t *dm_uc_ns(ucontext_t *uc) {
+    dm_uc_ss(uc);
+    return &t_ns;
+}
+
+void dm_linux_ss_stash(ucontext_t *uc) {
+    if (!uc || uc != t_ss_uc) return;
+    for (int i = 0; i < 29; i++) uc->uc_mcontext.regs[i] = (unsigned long)t_ss.__x[i];
+    uc->uc_mcontext.regs[29] = (unsigned long)t_ss.__fp;
+    uc->uc_mcontext.regs[30] = (unsigned long)t_ss.__lr;
+    uc->uc_mcontext.sp = (unsigned long)t_ss.__sp;
+    uc->uc_mcontext.pc = (unsigned long)t_ss.__pc;
+    uc->uc_mcontext.pstate = (unsigned long)t_ss.__cpsr;
+    t_ss_dirty = 0;
+}
+
+// ---- the scheduler interfaces of Darwin's pthread
+
+// The page size is read once, when the host starts (it is the granularity the stack
+// printer walks a guest thread's stack in).
+long vm_page_size = 4096;
+__attribute__((constructor)) static void vm_page_size_init(void) {
+    long p = sysconf(_SC_PAGESIZE);
+    if (p > 0) vm_page_size = p;
+}
+
+int pthread_cond_timedwait_relative_np(pthread_cond_t *cond, pthread_mutex_t *mutex,
+                                       const struct timespec *timeout) {
+    struct timespec now;
+    clock_gettime(CLOCK_REALTIME, &now);
+    struct timespec abs;
+    abs.tv_sec = now.tv_sec + timeout->tv_sec;
+    abs.tv_nsec = now.tv_nsec + timeout->tv_nsec;
+    if (abs.tv_nsec >= 1000000000l) {
+        abs.tv_nsec -= 1000000000l;
+        abs.tv_sec++;
+    }
+    return pthread_cond_timedwait(cond, mutex, &abs);
+}
+
+pthread_override_t pthread_override_qos_class_start_np(pthread_t thread, uint32_t qos_class,
+                                                       int relative_priority) {
+    (void)thread;
+    (void)qos_class;
+    (void)relative_priority;
+    return NULL;   // Linux has no per-thread-class override (see the header)
+}
+
+pthread_override_t pthread_override_with_priority_np(pthread_t thread, unsigned qos_class) {
+    (void)thread;
+    (void)qos_class;
+    return NULL;
+}
+
+int pthread_override_qos_class_end_np(pthread_override_t override) {
+    (void)override;
+    return 0;
+}
+
+// ---- compression (Apple's libcompression)
+//
+// The host's texture capture compresses its records; Linux has no LZFSE, so the calls
+// answer 0 (the caller reports a capture that could not be compressed).
+
+const unsigned int COMPRESSION_ZLIB = 0;
+const unsigned int COMPRESSION_LZFSE = 3;
+const unsigned int COMPRESSION_LZ4 = 0x100;
+const unsigned int COMPRESSION_LZBITMAP = 0x701;
+
+size_t compression_encode_buffer(void *dst, size_t dst_size, const void *src, size_t src_size,
+                                void *scratch, unsigned int codec) {
+    (void)dst;
+    (void)dst_size;
+    (void)src;
+    (void)src_size;
+    (void)scratch;
+    (void)codec;
+    return 0;   // no LZFSE on Linux
+}
+
+size_t compression_decode_buffer(void *dst, size_t dst_size, const void *src, size_t src_size,
+                                void *scratch, unsigned int codec) {
+    (void)dst;
+    (void)dst_size;
+    (void)src;
+    (void)src_size;
+    (void)scratch;
+    (void)codec;
+    return 0;
+}
+
+// ---- the autorelease pool of the compiler's Objective-C runtime
+//
+// The Metal backend's queue worker wraps each item in an autorelease pool (nvn_queue.inc).
+// Without Objective-C objects there is nothing to drain, so the calls answer a dummy
+// handle and do nothing.
+static int g_pool_dummy;
+void *objc_autoreleasePoolPush(void) { return &g_pool_dummy; }
+void objc_autoreleasePoolPop(void *pool) { (void)pool; }
diff --git a/dm/host/linux/linux_dispatch.c b/dm/host/linux/linux_dispatch.c
new file mode 100644
index 0000000..8905220
--- /dev/null
+++ b/dm/host/linux/linux_dispatch.c
@@ -0,0 +1,418 @@
+// The GCD shim of the Linux build: the parts of dispatch the host uses, over threads.
+//
+// The host uses GCD for three things: a serial queue that writes the cheat state files
+// off the presenting thread (hle_cheats.c), a timeout that ends the run when a graceful
+// exit does not finish (hle_lifecycle.c), and a signal source that turns SIGTERM into a
+// graceful exit. Each of them is a thread here.
+//
+// The queue is serial: a block dispatched to it runs after the blocks dispatched before
+// it, and dispatch_sync waits for the ones before it to be done. That is the property
+// the host relies on (the cheat files are written in order, and the drain waits for the
+// last write).
+#include <Block.h>          // the runtime of the blocks dispatch takes
+#include <dispatch/dispatch.h>
+
+#include <errno.h>
+#include <pthread.h>
+#include <semaphore.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+// A block on a queue: the block itself, or a function with its context.
+typedef struct {
+    dispatch_block_t block;
+    void (*fn)(void *);
+    void *ctx;
+    sem_t *done;   // when set, the worker posts it when the item is done
+} item_t;
+
+typedef struct queue {
+    pthread_mutex_t mu;
+    pthread_cond_t cv;
+    item_t *items;
+    int n, cap;
+    int stop;
+    pthread_t worker;
+    const char *label;
+    struct { const void *key; void *value; } *specific;
+    int nspec, capspec;
+} queue_t;
+
+struct dispatch_semaphore_s {
+    sem_t sem;
+};
+
+struct dispatch_source_s {
+    int sig;
+    dispatch_block_t handler;
+    queue_t *queue;
+    int active;
+    struct dispatch_source_s *next;
+};
+
+// The queue the thread is running a block of (dispatch_get_specific reads the values of
+// it).
+static __thread queue_t *t_queue;
+
+static void *queue_worker(void *arg) {
+    queue_t *q = (queue_t *)arg;
+    pthread_mutex_lock(&q->mu);
+    for (;;) {
+        while (!q->n && !q->stop) pthread_cond_wait(&q->cv, &q->mu);
+        if (q->stop && !q->n) break;
+        item_t it = q->items[0];   // the first dispatched: the queue is FIFO
+        memmove(q->items, q->items + 1, (size_t)(--q->n) * sizeof *q->items);
+        pthread_mutex_unlock(&q->mu);
+        queue_t *prev = t_queue;
+        t_queue = q;
+        if (it.block) it.block();
+        else if (it.fn) it.fn(it.ctx);
+        t_queue = prev;
+        if (it.done) sem_post(it.done);
+        pthread_mutex_lock(&q->mu);
+    }
+    pthread_mutex_unlock(&q->mu);
+    return NULL;
+}
+
+static queue_t *queue_new(const char *label) {
+    queue_t *q = (queue_t *)calloc(1, sizeof *q);
+    if (!q) return NULL;
+    pthread_mutex_init(&q->mu, NULL);
+    pthread_cond_init(&q->cv, NULL);
+    q->label = label;
+    if (pthread_create(&q->worker, NULL, queue_worker, q) != 0) {
+        free(q);
+        return NULL;
+    }
+    return q;
+}
+
+dispatch_queue_t dispatch_queue_create(const char *label, dispatch_queue_attr_t attr) {
+    (void)attr;
+    return (dispatch_queue_t)queue_new(label ? label : "queue");
+}
+
+// The main queue: a thread of its own. The Linux front end runs the guest on the main
+// thread of the process, so this queue is not that thread (the GCD main queue of a
+// Cocoa application is).
+dispatch_queue_t dispatch_get_main_queue(void) {
+    static queue_t *q;
+    if (!q) q = queue_new("main");
+    return (dispatch_queue_t)q;
+}
+
+dispatch_queue_t dispatch_get_global_queue(long identifier, unsigned long flags) {
+    (void)identifier;
+    (void)flags;
+    static queue_t *q;
+    if (!q) q = queue_new("global");
+    return (dispatch_queue_t)q;
+}
+
+static int queue_push(queue_t *q, dispatch_block_t block, void (*fn)(void *), void *ctx, sem_t *done) {
+    pthread_mutex_lock(&q->mu);
+    if (q->n == q->cap) {
+        int cap = q->cap ? q->cap * 2 : 16;
+        item_t *items = (item_t *)realloc(q->items, (size_t)cap * sizeof *items);
+        if (!items) {
+            pthread_mutex_unlock(&q->mu);
+            return 0;
+        }
+        q->items = items;
+        q->cap = cap;
+    }
+    q->items[q->n].block = block;
+    q->items[q->n].fn = fn;
+    q->items[q->n].ctx = ctx;
+    q->items[q->n].done = done;
+    q->n++;
+    pthread_cond_signal(&q->cv);
+    pthread_mutex_unlock(&q->mu);
+    return 1;
+}
+
+void dispatch_async(dispatch_queue_t queue, dispatch_block_t block) {
+    if (!queue || !block) return;
+    queue_push((queue_t *)queue, _Block_copy(block), NULL, NULL, NULL);
+}
+
+void dispatch_async_f(dispatch_queue_t queue, void *context, void (*work)(void *)) {
+    if (!queue || !work) return;
+    queue_push((queue_t *)queue, NULL, work, context, NULL);
+}
+
+void dispatch_sync(dispatch_queue_t queue, dispatch_block_t block) {
+    if (!queue || !block) {
+        if (block) block();
+        return;
+    }
+    // The block runs on the queue, after the blocks already on it: the queue is serial.
+    sem_t done;
+    if (sem_init(&done, 0, 0)) return;
+    if (!queue_push((queue_t *)queue, _Block_copy(block), NULL, NULL, &done)) {
+        sem_destroy(&done);
+        block();
+        return;
+    }
+    while (sem_wait(&done) != 0 && errno == EINTR) {}
+    sem_destroy(&done);
+}
+
+// The time base of dispatch_time: nanoseconds since the boot, like mach_absolute_time.
+dispatch_time_t dispatch_time(dispatch_time_t when, int64_t delta) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    uint64_t now = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+    if (when == DISPATCH_TIME_FOREVER) return DISPATCH_TIME_FOREVER;
+    if (when == DISPATCH_TIME_NOW) return now + (uint64_t)(delta < 0 ? 0 : delta);
+    return when + (uint64_t)(delta < 0 ? 0 : delta);
+}
+
+typedef struct {
+    dispatch_queue_t queue;
+    dispatch_block_t block;
+    uint64_t when;
+} after_t;
+
+static void *after_thread(void *arg) {
+    after_t *a = (after_t *)arg;
+    struct timespec ts;
+    ts.tv_sec = (time_t)(a->when / 1000000000ull);
+    ts.tv_nsec = (long)(a->when % 1000000000ull);
+    while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL) == EINTR) {}
+    dispatch_async(a->queue, a->block);
+    _Block_release(a->block);
+    free(a);
+    return NULL;
+}
+
+void dispatch_after(dispatch_time_t when, dispatch_queue_t queue, dispatch_block_t block) {
+    if (!queue || !block) return;
+    after_t *a = (after_t *)calloc(1, sizeof *a);
+    if (!a) return;
+    a->queue = queue;
+    a->block = _Block_copy(block);
+    a->when = when;
+    pthread_t th;
+    if (pthread_create(&th, NULL, after_thread, a) != 0) {
+        _Block_release(a->block);
+        free(a);
+        return;
+    }
+    pthread_detach(th);
+}
+
+void dispatch_once(dispatch_once_t *predicate, dispatch_block_t block) {
+    static pthread_mutex_t mu = PTHREAD_MUTEX_INITIALIZER;
+    pthread_mutex_lock(&mu);
+    if (*predicate) {
+        pthread_mutex_unlock(&mu);
+        return;
+    }
+    *predicate = 1;
+    pthread_mutex_unlock(&mu);
+    if (block) block();
+}
+
+// ---- the semaphores
+
+dispatch_semaphore_t dispatch_semaphore_create(long value) {
+    dispatch_semaphore_t s = (dispatch_semaphore_t)calloc(1, sizeof *s);
+    if (!s) return NULL;
+    sem_init(&s->sem, 0, value);
+    return s;
+}
+
+long dispatch_semaphore_wait(dispatch_semaphore_t sema, dispatch_time_t timeout) {
+    if (!sema) return -1;
+    if (timeout == DISPATCH_TIME_FOREVER) {
+        while (sem_wait(&sema->sem) != 0 && errno == EINTR) {}
+        return 0;
+    }
+    struct timespec ts;
+    ts.tv_sec = (time_t)(timeout / 1000000000ull);
+    ts.tv_nsec = (long)(timeout % 1000000000ull);
+    while (sem_timedwait(&sema->sem, &ts) != 0) {
+        if (errno == EINTR) continue;
+        return -1;
+    }
+    return 0;
+}
+
+long dispatch_semaphore_signal(dispatch_semaphore_t sema) {
+    if (!sema) return -1;
+    sem_post(&sema->sem);
+    return 0;
+}
+
+// ---- the signal sources
+//
+// One pipe per signal: the signal is caught with a handler that writes to the pipe, and
+// a thread reads it and runs the handler blocks of the sources of that signal.
+
+typedef struct sig_watch {
+    int sig;
+    int pipe[2];
+    pthread_t thread;
+    int started;
+    struct sig_watch *next;
+} sig_watch_t;
+
+static sig_watch_t *g_watches;
+static struct dispatch_source_s *g_sources;   // a list of sources, linked through ->next
+static pthread_mutex_t g_sig_mu = PTHREAD_MUTEX_INITIALIZER;
+
+static void sig_handler(int sig) {
+    unsigned char c = (unsigned char)sig;
+    for (sig_watch_t *w = g_watches; w; w = w->next) {
+        if (w->sig != sig) continue;
+        ssize_t n = write(w->pipe[1], &c, 1);
+        (void)n;
+        break;
+    }
+}
+
+static void *watch_thread(void *arg) {
+    sig_watch_t *w = (sig_watch_t *)arg;
+    for (;;) {
+        unsigned char c = 0;
+        ssize_t n = read(w->pipe[0], &c, 1);
+        if (n != 1) {
+            if (n < 0 && errno == EINTR) continue;
+            break;
+        }
+        pthread_mutex_lock(&g_sig_mu);
+        for (struct dispatch_source_s *s = g_sources; s; s = s->next) {
+            if (s->sig != (int)c || !s->active || !s->handler) continue;
+            dispatch_block_t h = _Block_copy(s->handler);
+            pthread_mutex_unlock(&g_sig_mu);
+            if (s->queue) dispatch_async((dispatch_queue_t)s->queue, h);
+            else h();
+            _Block_release(h);
+            pthread_mutex_lock(&g_sig_mu);
+        }
+        pthread_mutex_unlock(&g_sig_mu);
+    }
+    return NULL;
+}
+
+dispatch_source_t dispatch_source_create(dispatch_source_type_t type, uintptr_t handle,
+                                         unsigned long mask, dispatch_queue_t queue) {
+    (void)mask;
+    if (type != DISPATCH_SOURCE_TYPE_SIGNAL) return NULL;
+    dispatch_source_t src = (dispatch_source_t)calloc(1, sizeof *src);
+    if (!src) return NULL;
+    src->sig = (int)handle;
+    src->queue = (queue_t *)queue;
+    pthread_mutex_lock(&g_sig_mu);
+    src->next = g_sources;
+    g_sources = src;   // the newest first
+    sig_watch_t *w = NULL;
+    for (sig_watch_t *p = g_watches; p; p = p->next) {
+        if (p->sig == src->sig) {
+            w = p;
+            break;
+        }
+    }
+    if (!w) {
+        w = (sig_watch_t *)calloc(1, sizeof *w);
+        if (!w || pipe(w->pipe)) {
+            pthread_mutex_unlock(&g_sig_mu);
+            free(w);
+            free(src);
+            return NULL;
+        }
+        w->sig = src->sig;
+        w->next = g_watches;
+        g_watches = w;
+        struct sigaction sa;
+        memset(&sa, 0, sizeof sa);
+        sa.sa_handler = sig_handler;
+        sigemptyset(&sa.sa_mask);
+        sa.sa_flags = SA_RESTART;
+        sigaction(w->sig, &sa, NULL);
+    }
+    pthread_mutex_unlock(&g_sig_mu);
+    return src;
+}
+
+void dispatch_source_set_event_handler(dispatch_source_t source, dispatch_block_t handler) {
+    if (!source) return;
+    pthread_mutex_lock(&g_sig_mu);
+    if (source->handler) _Block_release(source->handler);
+    source->handler = handler ? _Block_copy(handler) : NULL;
+    pthread_mutex_unlock(&g_sig_mu);
+}
+
+void dispatch_resume(dispatch_source_t source) {
+    if (!source) return;
+    pthread_mutex_lock(&g_sig_mu);
+    source->active = 1;
+    for (sig_watch_t *w = g_watches; w; w = w->next) {
+        if (w->sig != source->sig || w->started) continue;
+        w->started = 1;
+        pthread_t th;
+        if (pthread_create(&th, NULL, watch_thread, w) == 0) pthread_detach(th);
+        break;
+    }
+    pthread_mutex_unlock(&g_sig_mu);
+}
+
+void dispatch_suspend(dispatch_source_t source) {
+    if (!source) return;
+    pthread_mutex_lock(&g_sig_mu);
+    source->active = 0;
+    pthread_mutex_unlock(&g_sig_mu);
+}
+
+void dispatch_release(void *object) {
+    (void)object;
+}
+
+void dispatch_retain(void *object) {
+    (void)object;
+}
+
+// ---- the specific values of a queue
+
+void dispatch_queue_set_specific(dispatch_queue_t queue, const void *key, void *context,
+                                 void (*destructor)(void *)) {
+    (void)destructor;
+    if (!queue) return;
+    queue_t *q = (queue_t *)queue;
+    pthread_mutex_lock(&q->mu);
+    if (q->nspec == q->capspec) {
+        int cap = q->capspec ? q->capspec * 2 : 8;
+        void *p = realloc(q->specific, (size_t)cap * sizeof *q->specific);
+        if (!p) {
+            pthread_mutex_unlock(&q->mu);
+            return;
+        }
+        q->specific = (typeof(q->specific))p;
+        q->capspec = cap;
+    }
+    q->specific[q->nspec].key = key;
+    q->specific[q->nspec].value = context;
+    q->nspec++;
+    pthread_mutex_unlock(&q->mu);
+}
+
+void *dispatch_get_specific(const void *key) {
+    queue_t *q = t_queue;
+    if (!q) q = (queue_t *)dispatch_get_main_queue();
+    if (!q) return NULL;
+    void *v = NULL;
+    pthread_mutex_lock(&q->mu);
+    for (int i = 0; i < q->nspec; i++) {
+        if (q->specific[i].key == key) {
+            v = q->specific[i].value;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&q->mu);
+    return v;
+}
