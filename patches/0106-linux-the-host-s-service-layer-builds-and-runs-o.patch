diff --git a/dm/host/linux/include/CoreFoundation/CoreFoundation.h b/dm/host/linux/include/CoreFoundation/CoreFoundation.h
new file mode 100644
index 0000000..31e016a
--- /dev/null
+++ b/dm/host/linux/include/CoreFoundation/CoreFoundation.h
@@ -0,0 +1,64 @@
+// Linux stand-in for <CoreFoundation/CoreFoundation.h>.
+//
+// The host's portable sources use CoreFoundation for two things: the build stamp the
+// packer leaves in the bundle (main.c) and the dictionary of the NVN profile
+// (hle_nvn.c). On Linux there is no bundle and no plist, so the calls answer with
+// nothing and the callers take their "not recorded" path.
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+typedef signed long CFIndex;
+typedef unsigned long CFTypeID;
+typedef unsigned char Boolean;
+typedef const void *CFTypeRef;
+typedef const struct __CFString *CFStringRef;
+typedef const struct __CFString *CFMutableStringRef;
+typedef const struct __CFDictionary *CFDictionaryRef;
+typedef struct __CFDictionary *CFMutableDictionaryRef;
+typedef const struct __CFArray *CFArrayRef;
+typedef const struct __CFNumber *CFNumberRef;
+typedef const struct __CFData *CFDataRef;
+typedef const struct __CFBundle *CFBundleRef;
+typedef void *CFAllocatorRef;
+
+typedef struct { CFIndex location; CFIndex length; } CFRange;
+
+#define CFSTR(s) ((CFStringRef)(s))
+#define CFSTR_BOOL 0
+#define CFSTR_LITERAL 0
+
+// The type ids of the shim: every object is a plain C string, so they only have to be
+// distinct from each other.
+extern const CFTypeID kCFStringTypeID;
+extern const CFTypeID kCFNumberTypeID;
+extern const CFTypeID kCFBooleanTypeID;
+extern const CFTypeID kCFArrayTypeID;
+extern const CFTypeID kCFDictionaryTypeID;
+extern const CFTypeID kCFDataTypeID;
+
+CFTypeID CFGetTypeID(CFTypeRef cf);
+CFTypeID CFStringGetTypeID(void);
+CFStringRef CFStringCreateWithCString(CFAllocatorRef alloc, const char *cStr, unsigned int encoding);
+Boolean CFStringGetCString(CFStringRef theString, char *buffer, CFIndex bufferSize, unsigned int encoding);
+CFIndex CFStringGetLength(CFStringRef theString);
+Boolean CFEqual(CFTypeRef cf1, CFTypeRef cf2);
+void CFRelease(CFTypeRef cf);
+CFTypeRef CFRetain(CFTypeRef cf);
+
+CFBundleRef CFBundleGetMainBundle(void);
+CFTypeRef CFBundleGetValueForInfoDictionaryKey(CFBundleRef bundle, CFStringRef key);
+
+// A dictionary: the host uses one for the pipeline cache of the NVN layer, keyed by the
+// serial of a queue. The keys are pointers (the host casts them), the values are
+// pointers too, so the shim keeps a list of pairs.
+CFMutableDictionaryRef CFDictionaryCreateMutable(CFAllocatorRef allocator, CFIndex capacity,
+                                                  const void *keyCallbacks, const void *valueCallbacks);
+const void *CFDictionaryGetValue(CFDictionaryRef dict, const void *key);
+void CFDictionarySetValue(CFDictionaryRef dict, const void *key, const void *value);
+CFIndex CFDictionaryGetCount(CFDictionaryRef dict);
+
+// The encoding constant of Apple's CoreFoundation (the value is the same, so a caller
+// that prints it or compares it behaves the same).
+enum { kCFStringEncodingUTF8 = 0x08000100 };
diff --git a/dm/host/linux/include/TargetConditionals.h b/dm/host/linux/include/TargetConditionals.h
new file mode 100644
index 0000000..2bf08fe
--- /dev/null
+++ b/dm/host/linux/include/TargetConditionals.h
@@ -0,0 +1,18 @@
+// Linux stand-in for Apple's TargetConditionals.h.
+//
+// The host's sources branch on the platform with TARGET_OS_IPHONE, TARGET_OS_OSX and
+// TARGET_OS_SIMULATOR. On Linux the desktop branch is the right one everywhere except
+// where the code is about the phone itself (the embedded game image, the app's life
+// cycle), which the desktop branch does not use.
+//
+// The header is only on the include path of the Linux build (dm/host/Makefile.linux), so
+// the sources stay the same on every platform.
+#pragma once
+
+#define TARGET_OS_LINUX 1
+#define TARGET_OS_MAC 0
+#define TARGET_OS_OSX 0
+#define TARGET_OS_IPHONE 0
+#define TARGET_OS_IOS 0
+#define TARGET_OS_SIMULATOR 0
+#define TARGET_IPHONE_SIMULATOR 0
diff --git a/dm/host/linux/include/compression.h b/dm/host/linux/include/compression.h
new file mode 100644
index 0000000..c48325e
--- /dev/null
+++ b/dm/host/linux/include/compression.h
@@ -0,0 +1,19 @@
+// Linux stand-in for Apple's <compression.h>: the compression library.
+//
+// The host's texture capture writes its records compressed (nvn_capture.c). Linux has
+// zlib in libz; the codec set is smaller than Apple's (no LZFSE), so the calls answer with
+// 0, which the caller reports as it does on any failure.
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+extern const unsigned int COMPRESSION_ZLIB;
+extern const unsigned int COMPRESSION_LZFSE;
+extern const unsigned int COMPRESSION_LZ4;
+extern const unsigned int COMPRESSION_LZBITMAP;
+
+size_t compression_encode_buffer(void *dst, size_t dst_size, const void *src, size_t src_size,
+                                 void *scratch, unsigned int codec);
+size_t compression_decode_buffer(void *dst, size_t dst_size, const void *src, size_t src_size,
+                                 void *scratch, unsigned int codec);
diff --git a/dm/host/linux/include/dispatch/dispatch.h b/dm/host/linux/include/dispatch/dispatch.h
new file mode 100644
index 0000000..3784788
--- /dev/null
+++ b/dm/host/linux/include/dispatch/dispatch.h
@@ -0,0 +1,68 @@
+// Linux stand-in for <dispatch/dispatch.h>: the parts of GCD the host uses.
+//
+// The host uses GCD for three things: a serial queue that writes the cheat state files
+// off the presenting thread, a timeout that ends the run when a graceful exit does not
+// finish, and a signal source that turns SIGTERM into a graceful exit. On Linux the
+// same work is done with a worker thread per queue, a thread that sleeps, and a thread
+// that waits for the signal.
+#pragma once
+
+#include <stdint.h>
+#include <stddef.h>
+#include <TargetConditionals.h>   // Apple's dispatch.h pulls this in too
+
+typedef void (^dispatch_block_t)(void);
+
+typedef struct dispatch_queue_s *dispatch_queue_t;
+typedef struct dispatch_queue_attr_s *dispatch_queue_attr_t;
+typedef struct dispatch_semaphore_s *dispatch_semaphore_t;
+typedef struct dispatch_source_s *dispatch_source_t;
+typedef struct dispatch_group_s *dispatch_group_t;
+typedef struct dispatch_source_type_s *dispatch_source_type_t;
+typedef const struct dispatch_source_type_s *dispatch_source_type;
+typedef uint64_t dispatch_time_t;
+typedef long dispatch_once_t;
+typedef void *dispatch_queue_priority_t;
+typedef uint32_t dispatch_qos_class_t;
+
+#define DISPATCH_QUEUE_SERIAL ((dispatch_queue_attr_t)0)
+#define DISPATCH_QUEUE_CONCURRENT ((dispatch_queue_attr_t)1)
+
+#define DISPATCH_TIME_NOW ((dispatch_time_t)0ull)
+#define DISPATCH_TIME_FOREVER (~0ull)
+#define NSEC_PER_SEC 1000000000ull
+#define NSEC_PER_MSEC 1000000ull
+#define USEC_PER_SEC 1000000ull
+
+#define QOS_CLASS_UNSPECIFIED ((dispatch_qos_class_t)0x00)
+#define QOS_CLASS_USER_INTERACTIVE ((dispatch_qos_class_t)0x21)
+#define QOS_CLASS_USER_INITIATED ((dispatch_qos_class_t)0x20)
+#define QOS_CLASS_DEFAULT ((dispatch_qos_class_t)0x15)
+#define QOS_CLASS_UTILITY ((dispatch_qos_class_t)0x11)
+#define QOS_CLASS_BACKGROUND ((dispatch_qos_class_t)0x09)
+
+#define DISPATCH_SOURCE_TYPE_SIGNAL ((dispatch_source_type_t)1)
+#define DISPATCH_SOURCE_TYPE_TIMER ((dispatch_source_type_t)2)
+
+dispatch_queue_t dispatch_queue_create(const char *label, dispatch_queue_attr_t attr);
+dispatch_queue_t dispatch_get_main_queue(void);
+dispatch_queue_t dispatch_get_global_queue(long identifier, unsigned long flags);
+void dispatch_async(dispatch_queue_t queue, dispatch_block_t block);
+void dispatch_sync(dispatch_queue_t queue, dispatch_block_t block);
+void dispatch_after(dispatch_time_t when, dispatch_queue_t queue, dispatch_block_t block);
+dispatch_time_t dispatch_time(dispatch_time_t when, int64_t delta);
+void dispatch_once(dispatch_once_t *predicate, dispatch_block_t block);
+dispatch_semaphore_t dispatch_semaphore_create(long value);
+long dispatch_semaphore_wait(dispatch_semaphore_t sema, dispatch_time_t timeout);
+long dispatch_semaphore_signal(dispatch_semaphore_t sema);
+dispatch_source_t dispatch_source_create(dispatch_source_type_t type, uintptr_t handle,
+                                         unsigned long mask, dispatch_queue_t queue);
+void dispatch_source_set_event_handler(dispatch_source_t source, dispatch_block_t handler);
+void dispatch_resume(dispatch_source_t source);
+void dispatch_suspend(dispatch_source_t source);
+void dispatch_release(void *object);
+void dispatch_retain(void *object);
+void dispatch_queue_set_specific(dispatch_queue_t queue, const void *key, void *context,
+                                 void (*destructor)(void *));
+void *dispatch_get_specific(const void *key);
+void dispatch_async_f(dispatch_queue_t queue, void *context, void (*work)(void *));
diff --git a/dm/host/linux/include/dm_linux.h b/dm/host/linux/include/dm_linux.h
new file mode 100644
index 0000000..8ccbc2f
--- /dev/null
+++ b/dm/host/linux/include/dm_linux.h
@@ -0,0 +1,59 @@
+// Linux build: the stand-ins the host's portable sources take from libSystem.
+//
+// Two of them cannot be reproduced and are reported as such:
+//   clock_gettime_nsec_np: Darwin's clock read with the clock id as it is; it works here
+//   MAP_JIT and pthread_jit_write_protect_np: Apple's write-protect of the pages code is
+//     generated into (the JIT). Linux has no such interface, so the mapping is plain and
+//     the protect calls do nothing, which on a machine without a JIT write-protect
+//     policy is the same effect.
+#pragma once
+
+#include <pthread.h>
+#include <stdbool.h>
+#include <sys/stat.h>
+#include <stdint.h>
+#include <sys/mman.h>
+#include <sys/statfs.h>
+#include <time.h>
+
+#define DM_LINUX 1
+
+typedef uint64_t nsec_t;
+
+static inline uint64_t clock_gettime_nsec_np(clockid_t clock) {
+    struct timespec ts;
+    if (clock_gettime(clock, &ts)) return 0;
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+#define MAP_JIT 0
+
+static inline void pthread_jit_write_protect_np(int enabled) { (void)enabled; }
+
+// The value Darwin's confstr takes for the user's temp folder. Linux has no such query
+// (TMPDIR and /tmp are the answer), so the host's DM_GUEST_FILE path takes the "no
+// temporary folder" answer it prints and stays anonymous, which on Linux is right: Linux
+// swaps.
+#define _CS_DARWIN_USER_TEMP_DIR 65536
+
+// The bounds of a thread's stack (hle_svc.c reports them as the Horizon stack record):
+// Darwin's pthread interface.
+void *pthread_get_stackaddr_np(pthread_t thread);
+size_t pthread_get_stacksize_np(pthread_t thread);
+
+// The name of a thread, for the host's tools (hle_thread.c). Linux keeps names of 16
+// bytes including the terminator, so the name is cut to fit.
+void dm_thread_set_name(const char *name);
+
+// renamex_np with RENAME_SWAP: Darwin's atomic exchange of two paths. Linux has it as
+// renameat2 with RENAME_EXCHANGE (the same operation, spelled with an at-suffixed call and
+// two AT_FDCWD), which the shim below gives back in Darwin's shape.
+#define RENAME_SWAP 0x0002
+
+#define CC_SHA256_DIGEST_LENGTH 32
+int renamex_np(const char *from, const char *to, unsigned int flags);
+
+// The BSD library functions Apple's libc has that Linux's does not.
+void mergesort(void *base, size_t nmemb, size_t size, int (*compar)(const void *, const void *));
+unsigned int arc4random(void);
+void arc4random_buf(void *buf, size_t nbytes);
diff --git a/dm/host/linux/include/dm_ucontext.h b/dm/host/linux/include/dm_ucontext.h
new file mode 100644
index 0000000..67d5604
--- /dev/null
+++ b/dm/host/linux/include/dm_ucontext.h
@@ -0,0 +1,76 @@
+// Linux stand-in for Darwin's ucontext register view.
+//
+// The host stops a thread with a signal and reads its registers from the ucontext the
+// handler got (hle_thread.c thr_pause_sig: the Boehm collector's stop-the-world reads the
+// guest's registers for its roots). Darwin exposes the ARM thread state and the NEON
+// state inline (uc_mcontext->__ss, __ns); Linux keeps the integer registers in the
+// sigcontext and the NEON registers in the fpsimd extension of it, so the shim below
+// fills one plain struct from both.
+#pragma once
+
+#include <signal.h>
+#include <stdint.h>
+#include <sys/ucontext.h>
+
+// The registers of the thread the handler was called on, in the shape the host reads.
+// The member names are Darwin's (the host reads them): x0..x28, then fp (x29), lr (x30),
+// sp, pc and pstate, which Linux's sigcontext holds in its own order.
+typedef struct {
+    uint64_t __x[29];
+    uint64_t __fp;
+    uint64_t __lr;
+    uint64_t __sp;
+    uint64_t __pc;
+    uint32_t __cpsr;
+    uint32_t __pad;
+} dm_linux_state_t;
+
+typedef struct {
+    __uint128_t __v[32];
+    uint32_t __fpcr;
+    uint32_t __fpsr;
+    uint32_t __pad[2];
+} dm_linux_neon_t;
+
+// The register view of a ucontext, in Darwin's member names, over Linux's sigcontext.
+// One view fills once per handler invocation: a handler that writes __pc through it (the
+// probe's trampoline) is asked to write it back with dm_linux_ss_stash before it returns.
+#ifdef DM_LINUX
+dm_linux_state_t *dm_uc_ss(ucontext_t *uc);
+dm_linux_neon_t *dm_uc_ns(ucontext_t *uc);
+void dm_linux_ss_stash(ucontext_t *uc);
+#else
+#define dm_uc_ss(uc) (&(uc)->uc_mcontext->__ss)
+#define dm_uc_ns(uc) (&(uc)->uc_mcontext->__ns)
+#define dm_linux_ss_stash(uc) (void)0
+#endif
+
+// The legacy flat struct: the registers in one place, for the readers that want them.
+typedef struct {
+    uint64_t x[29];
+    uint64_t fp;
+    uint64_t lr;
+    uint64_t sp;
+    uint64_t pc;
+    uint32_t pstate;
+    __uint128_t v[32];
+    uint32_t fpcr;
+    uint32_t fpsr;
+} dm_linux_ctx_t;
+
+// The extension records the kernel chains after the sigcontext's own fields: each has a
+// magic, a size, and the next record follows at size (0 ends the chain).
+struct dm_linux_ctx_head {
+    unsigned int magic;
+    unsigned int size;
+};
+
+void dm_linux_ctx_read(void *uc, dm_linux_ctx_t *out);
+
+// The two reads the crash dump and the probe handlers make besides the registers: the
+// fault address of a SIGSEGV / SIGBUS (Darwin reads the ESR of the exception state) and
+// the write / read bit of it.
+uint64_t dm_linux_ctx_fault(void *uc);
+int dm_linux_ctx_is_write(void *uc);
+
+int dm_linux_dbg_sections(const char *path);
diff --git a/dm/host/linux/include/libkern/OSCacheControl.h b/dm/host/linux/include/libkern/OSCacheControl.h
new file mode 100644
index 0000000..495ef0b
--- /dev/null
+++ b/dm/host/linux/include/libkern/OSCacheControl.h
@@ -0,0 +1,12 @@
+// Linux stand-in for <libkern/OSCacheControl.h>: the instruction cache.
+//
+// The host writes code into the guest's pages (the cheat system) and into its own
+// (the JIT), and the CPU has to see the new instructions. On AArch64 the compiler's
+// cache flush does it.
+#pragma once
+
+#include <stddef.h>
+
+static inline void sys_icache_invalidate(void *start, size_t size) {
+    __builtin___clear_cache((char *)start, (char *)start + size);
+}
diff --git a/dm/host/linux/include/mach-o/getsect.h b/dm/host/linux/include/mach-o/getsect.h
new file mode 100644
index 0000000..c0a80df
--- /dev/null
+++ b/dm/host/linux/include/mach-o/getsect.h
@@ -0,0 +1,37 @@
+// Linux stand-in for <mach-o/getsect.h>: the lookup of a section inside an image.
+//
+// The host looks up its own tables (the HLE table and the forced-take-over table) by
+// section name, and the iOS front end looks up the game image it embeds. On Linux the
+// host is an ELF file, not a Mach-O, so the lookup reads the section headers of the
+// running executable instead: a section named "__DATA,swhle" on Apple is the section
+// named "__DATA,swhle" in the ELF file, because the compiler puts every table with the
+// same section attribute in the same section there too.
+#pragma once
+
+#include <stddef.h>
+
+struct mach_header_64 {
+    uint32_t magic;
+    uint32_t cputype;
+    uint32_t cpusubtype;
+    uint32_t filetype;
+    uint32_t ncmds;
+    uint32_t sizeofcmds;
+    uint32_t flags;
+    uint32_t reserved;
+};
+
+struct mach_header {
+    uint32_t magic;
+    uint32_t cputype;
+    uint32_t cpusubtype;
+    uint32_t filetype;
+    uint32_t ncmds;
+    uint32_t sizeofcmds;
+    uint32_t flags;
+};
+
+// The data of a section of the image, or NULL when the image has no such section.
+// The image is ignored on Linux: the sections are looked up in the running executable.
+const void *getsectiondata(const struct mach_header_64 *mhp, const char *segname, const char *sectname,
+                            unsigned long *size);
diff --git a/dm/host/linux/include/mach/mach.h b/dm/host/linux/include/mach/mach.h
new file mode 100644
index 0000000..3415bcb
--- /dev/null
+++ b/dm/host/linux/include/mach/mach.h
@@ -0,0 +1,239 @@
+// Linux stand-ins for the Mach interfaces the host takes from the platform.
+//
+// The host's service layer (dm/host) is portable C. What it asks of the kernel is small:
+// read and write the guest's memory from the host, map and protect pages, a monotonic
+// clock, and the bookkeeping of the host's own threads. On macOS and iOS those come from
+// the Mach interfaces below; on Linux the same work is done with process_vm_readv and
+// process_vm_writev, mmap and mprotect, clock_gettime and the pthread API.
+//
+// The header is only on the include path of the Linux build (dm/host/Makefile.linux), so
+// the sources stay the same on every platform.
+//
+// What cannot be reproduced is reported as it is: a call that has no Linux equivalent
+// returns the Mach failure code and the caller takes its own error path.
+#pragma once
+
+#include <stdint.h>
+#include <stddef.h>
+#include <sys/types.h>
+#include <pthread.h>
+
+// ---- return codes and ports
+
+typedef int32_t kern_return_t;
+#define KERN_SUCCESS 0
+#define KERN_FAILURE 1
+#define KERN_INVALID_ARGUMENT 22
+#define KERN_NO_SPACE 28
+#define KERN_PROTECTION_FAILURE 31
+
+typedef uint32_t mach_msg_type_number_t;
+typedef uint32_t mach_port_t;
+#define MACH_PORT_NULL ((mach_port_t)0)
+typedef int boolean_t;
+#ifndef TRUE
+#define TRUE 1
+#endif
+#ifndef FALSE
+#define FALSE 0
+#endif
+typedef int32_t natural_t;
+typedef int32_t integer_t;
+
+// ---- addresses and protections
+
+typedef uint64_t vm_address_t;
+typedef uint64_t vm_size_t;
+typedef uint64_t vm_offset_t;
+typedef uint64_t mach_vm_address_t;
+typedef uint64_t mach_vm_size_t;
+typedef uint64_t mach_vm_offset_t;
+typedef int vm_prot_t;
+typedef int vm_inherit_t;
+typedef int vm_behavior_t;
+typedef int vm_flags_t;
+
+#define VM_PROT_NONE 0x00
+#define VM_PROT_READ 0x01
+#define VM_PROT_WRITE 0x02
+#define VM_PROT_EXECUTE 0x04
+
+#define VM_FLAGS_FIXED 0x0000
+#define VM_FLAGS_ANYWHERE 0x0001
+#define VM_FLAGS_OVERWRITE 0x4000
+#define VM_INHERIT_NONE 0
+#define VM_INHERIT_COPY 1
+#define VM_INHERIT_SHARE 2
+#define VM_INHERIT_DONATE_COPY 3
+#define VM_INHERIT_DEFAULT 4
+#define VM_INHERIT_LAST_VALID 5
+
+// The resource usage of a process (Darwin's libproc.h). Linux has /proc/self/io for the
+// page-ins and the bytes read, and nothing for the others, which stay zero.
+typedef struct rusage_info_v4 {
+    uint64_t ri_diskio_bytesread;
+    uint64_t ri_diskio_byteswritten;
+    uint64_t ri_logical_writes;
+    uint64_t ri_wired_size;
+    uint64_t ri_resident_size;
+    uint64_t ri_user_time;
+    uint64_t ri_system_time;
+    uint64_t ri_pageins;
+    uint64_t ri_lifetime_max_phys_footprint;
+} rusage_info_v4;
+
+typedef rusage_info_v4 *rusage_info_t;   // a pointer to the struct, as on Apple
+
+#define RUSAGE_INFO_V4 4
+
+int proc_pid_rusage(int pid, int flavor, rusage_info_t *buffer);
+
+// ---- the task and its threads
+//
+// The task and the thread are the process id and the thread id here. The host only
+// compares them with each other (mach_thread_self() against the list of the task's
+// threads), so the values only have to be stable and distinct.
+
+mach_port_t mach_task_self(void);
+mach_port_t mach_thread_self(void);
+kern_return_t mach_port_deallocate(mach_port_t task, mach_port_t name);
+mach_port_t pthread_mach_thread_np(pthread_t thread);   // the thread id of a pthread
+
+// ---- reading and writing another task's memory
+
+kern_return_t vm_read_overwrite(mach_port_t task, vm_address_t address, vm_size_t size,
+                                 vm_offset_t data, vm_size_t *out_size);
+kern_return_t vm_write(mach_port_t task, vm_address_t address, vm_offset_t data,
+                        mach_msg_type_number_t size);
+
+// ---- mapping and protecting
+
+kern_return_t vm_allocate(mach_port_t task, vm_address_t *address, vm_size_t size, vm_flags_t flags);
+kern_return_t vm_deallocate(mach_port_t task, vm_address_t address, vm_size_t size);
+kern_return_t vm_protect(mach_port_t task, vm_address_t address, vm_size_t size,
+                          boolean_t set_maximum, vm_prot_t new_prot);
+kern_return_t vm_remap(mach_port_t target_task, vm_address_t *target_address, vm_size_t size,
+                        vm_offset_t offset, vm_flags_t flags, mach_port_t source_task,
+                        vm_address_t source_address, boolean_t copy, vm_prot_t *current_protection,
+                        vm_prot_t *max_protection, vm_inherit_t inherit);
+
+// ---- the regions of the task
+
+typedef int vm_region_flavor_t;
+typedef int *vm_region_info_t;
+typedef int vm_region_info_data_t;
+
+typedef struct {
+    vm_prot_t protection;
+    vm_prot_t max_protection;
+    vm_inherit_t inheritance;
+    boolean_t shared;
+    boolean_t reserved;
+    uint64_t offset;
+    vm_behavior_t behavior;
+    unsigned short user_wired_count;
+    unsigned short pages_resident;
+    unsigned long pages_reachable;
+} vm_region_basic_info_data_64_t;
+
+#define VM_REGION_BASIC_INFO_64 20
+#define VM_REGION_BASIC_INFO_COUNT_64 ((mach_msg_type_number_t)(sizeof(vm_region_basic_info_data_64_t) / sizeof(int)))
+
+kern_return_t vm_region_64(mach_port_t task, vm_address_t *address, vm_size_t *size,
+                            vm_region_flavor_t flavor, vm_region_info_t info,
+                            mach_msg_type_number_t *info_count, mach_port_t *object);
+
+// ---- the task's virtual memory
+
+typedef struct {
+    int64_t virtual_size;
+    int64_t region_count;
+    int64_t page_size;
+    int64_t resident_size;
+    int64_t resident_size_peak;
+    int64_t device;
+    int64_t device_peak;
+    int64_t internal;
+    int64_t internal_peak;
+    int64_t external;
+    int64_t external_peak;
+    int64_t reusable;
+    int64_t reusable_peak;
+    int64_t purgeable_volatile_pmap;
+    int64_t purgeable_volatile_resident;
+    int64_t purgeable_volatile_virtual;
+    int64_t compressed;
+    int64_t compressed_peak;
+    int64_t compressed_lifetime;
+    int64_t phys_footprint;
+    int64_t phys_footprint_peak;
+} task_vm_info_data_t;
+
+typedef natural_t *task_info_t;
+typedef task_vm_info_data_t *task_info_ptr;
+
+#define TASK_VM_INFO 4
+#define TASK_VM_INFO_COUNT ((mach_msg_type_number_t)(sizeof(task_vm_info_data_t) / sizeof(int)))
+
+// The power of the process. Linux has no per-process energy counter, so the fields stay
+// zero; the host's power line then reads zero and says so.
+typedef struct {
+    uint64_t total_user;
+    uint64_t total_system;
+    uint64_t task_interrupt_wakeups;
+    uint64_t task_platform_idle_wakeups;
+} task_cpu_energy_data_t;
+
+typedef struct {
+    uint64_t task_gpu_utilisation;
+    uint64_t task_gpu_energy;
+} task_gpu_energy_data_t;
+
+typedef struct {
+    int32_t task_watermarks;
+    uint64_t task_energy;
+    uint64_t task_energy_estimated;
+    uint64_t task_ptime;
+    uint64_t task_ptime_estimated;
+    uint64_t task_thermal_pressure;
+    task_cpu_energy_data_t cpu_energy;
+    task_gpu_energy_data_t gpu_energy;
+} task_power_info_v2_data_t;
+
+#define TASK_POWER_INFO_V2 21
+#define TASK_POWER_INFO_V2_COUNT ((mach_msg_type_number_t)(sizeof(task_power_info_v2_data_t) / sizeof(int)))
+
+kern_return_t task_info(mach_port_t task, int flavor, task_info_t info, mach_msg_type_number_t *count);
+
+// ---- the threads of the task
+
+typedef mach_port_t thread_act_t;
+typedef thread_act_t *thread_act_array_t;
+
+kern_return_t task_threads(mach_port_t task, thread_act_array_t *threads, mach_msg_type_number_t *count);
+kern_return_t thread_suspend(thread_act_t thread);
+kern_return_t thread_resume(thread_act_t thread);
+
+// The thread's register state. The host reads it to walk a thread's stack in a crash
+// report and to dump a guest thread that stopped. Linux has no equivalent of
+// ARM_THREAD_STATE64, so the call fails and the caller prints what it has.
+typedef natural_t *thread_state_t;
+typedef int thread_state_flavor_t;
+
+typedef struct {
+    uint64_t __x[29];
+    uint64_t __fp;
+    uint64_t __lr;
+    uint64_t __sp;
+    uint64_t __pc;
+    uint32_t __cpsr;
+    uint32_t __pad;
+} arm_thread_state64_t;
+
+#define ARM_THREAD_STATE64 6
+#define ARM_THREAD_STATE64_COUNT ((mach_msg_type_number_t)(sizeof(arm_thread_state64_t) / sizeof(int)))
+
+kern_return_t thread_get_state(thread_act_t thread, thread_state_flavor_t flavor, thread_state_t state,
+                                mach_msg_type_number_t *count);
+kern_return_t thread_set_state(thread_act_t thread, thread_state_flavor_t flavor, thread_state_t state,
+                                mach_msg_type_number_t count);
diff --git a/dm/host/linux/include/mach/mach_time.h b/dm/host/linux/include/mach/mach_time.h
new file mode 100644
index 0000000..73271c1
--- /dev/null
+++ b/dm/host/linux/include/mach/mach_time.h
@@ -0,0 +1,23 @@
+// Linux stand-in for <mach/mach_time.h>: the monotonic clock and the time base.
+//
+// The host's clock is the time since the boot (mach_absolute_time on Apple). Linux's
+// CLOCK_MONOTONIC counts the same, in nanoseconds, so the time base is 1:1 and the
+// conversions the host does with the base are the identity.
+#pragma once
+
+#include <stdint.h>
+#include <mach/mach.h>
+
+typedef struct {
+    uint32_t numer;
+    uint32_t denom;
+} mach_timebase_info_data_t;
+
+// The absolute time in the units of the time base (nanoseconds here).
+uint64_t mach_absolute_time(void);
+
+// The time base: nanoseconds per tick, and ticks per nanosecond.
+kern_return_t mach_timebase_info(mach_timebase_info_data_t *info);
+
+// Wait until the absolute time (the same base as mach_absolute_time) is reached.
+kern_return_t mach_wait_until(uint64_t deadline);
diff --git a/dm/host/linux/include/mach/mach_vm.h b/dm/host/linux/include/mach/mach_vm.h
new file mode 100644
index 0000000..c09bc59
--- /dev/null
+++ b/dm/host/linux/include/mach/mach_vm.h
@@ -0,0 +1,27 @@
+// Linux stand-in for <mach/mach_vm.h>: the 64-bit virtual memory interface.
+//
+// The host uses it for two things: an alias mapping of the guest's pages (the cheat
+// system's write path) and the protection of a region. Linux has no way to map the same
+// physical pages at two addresses (the kernel's page tables have one address per page),
+// so the alias is a copy: the cheat system's writes through it do not reach the game.
+// The call says so in the log the first time it happens.
+#pragma once
+
+#include <mach/mach.h>
+
+kern_return_t mach_vm_allocate(mach_port_t task, mach_vm_address_t *address, mach_vm_size_t size,
+                                vm_flags_t flags);
+kern_return_t mach_vm_deallocate(mach_port_t task, mach_vm_address_t address, mach_vm_size_t size);
+kern_return_t mach_vm_protect(mach_port_t task, mach_vm_address_t address, mach_vm_size_t size,
+                               boolean_t set_maximum, vm_prot_t new_prot);
+kern_return_t mach_vm_read_overwrite(mach_port_t task, mach_vm_address_t address, mach_vm_size_t size,
+                                     mach_vm_address_t data, mach_vm_size_t *out_size);
+kern_return_t mach_vm_write(mach_port_t task, mach_vm_address_t address, vm_offset_t data,
+                             mach_msg_type_number_t size);
+kern_return_t mach_vm_region(mach_port_t task, mach_vm_address_t *address, mach_vm_size_t *size,
+                              vm_region_flavor_t flavor, vm_region_info_t info,
+                              mach_msg_type_number_t *info_count, mach_port_t *object);
+kern_return_t mach_vm_remap(mach_port_t target_task, mach_vm_address_t *target_address,
+                             mach_vm_size_t size, mach_vm_offset_t offset, vm_flags_t flags,
+                             mach_port_t source_task, mach_vm_address_t source_address, boolean_t copy,
+                             vm_prot_t *current_protection, vm_prot_t *max_protection, vm_inherit_t inherit);
diff --git a/dm/host/linux/include/mach/thread_info.h b/dm/host/linux/include/mach/thread_info.h
new file mode 100644
index 0000000..a79c292
--- /dev/null
+++ b/dm/host/linux/include/mach/thread_info.h
@@ -0,0 +1,47 @@
+// Linux stand-in for <mach/thread_info.h>: the counters of a thread.
+//
+// Linux keeps the CPU time of a thread in /proc/<tid>/stat, which is what the host's
+// thread report and the NVN power line read here.
+#pragma once
+
+#include <mach/mach.h>
+
+typedef struct {
+    int32_t seconds;
+    int32_t microseconds;
+} time_value_t;
+
+typedef struct {
+    time_value_t user_time;
+    time_value_t system_time;
+    integer_t cpu_usage;
+    integer_t policy;
+    integer_t run_state;
+    integer_t flags;
+    integer_t suspend_count;
+    integer_t sleep_time;
+} thread_basic_info_data_t;
+
+typedef natural_t *thread_info_t;   // an integer view of the struct, as on Apple
+
+#define THREAD_BASIC_INFO 3
+#define THREAD_BASIC_INFO_COUNT ((mach_msg_type_number_t)(sizeof(thread_basic_info_data_t) / sizeof(int)))
+
+typedef struct {
+    time_value_t pth_user_time;
+    time_value_t pth_system_time;
+    integer_t pth_cpu_usage;
+    integer_t pth_policy;
+    integer_t pth_run_state;
+    integer_t pth_flags;
+    integer_t pth_sleep_time;
+    integer_t pth_curpri;
+    integer_t pth_priority;
+    integer_t pth_maxpriority;
+    char pth_name[64];
+} thread_extended_info_data_t;
+
+#define THREAD_EXTENDED_INFO 4
+#define THREAD_EXTENDED_INFO_COUNT ((mach_msg_type_number_t)(sizeof(thread_extended_info_data_t) / sizeof(int)))
+
+kern_return_t thread_info(mach_port_t thread, int flavor, thread_info_t info, mach_msg_type_number_t *count);
diff --git a/dm/host/linux/include/mach/thread_policy.h b/dm/host/linux/include/mach/thread_policy.h
new file mode 100644
index 0000000..2cf0829
--- /dev/null
+++ b/dm/host/linux/include/mach/thread_policy.h
@@ -0,0 +1,29 @@
+// Linux stand-in for <mach/thread_policy.h>: the scheduling policy of a thread.
+//
+// The host declares a real-time computation budget for its present thread (the NVN
+// pacing loop). Linux has no per-thread computation budget, so the policy is accepted
+// and remembered but not enforced: the call reports success and the host's own
+// accounting (the p90 of the declared budget) keeps the pacing honest.
+#pragma once
+
+#include <mach/mach.h>
+
+typedef natural_t thread_policy_flavor_t;   // the flavor of the policy asked for
+typedef natural_t *thread_policy_info_t;     // the struct the answer is written to
+typedef natural_t *thread_policy_t;          // the cast that shape takes in the host's calls
+
+typedef struct {
+    uint32_t period;
+    uint32_t computation;
+    uint32_t constraint;
+    uint32_t preemptible;
+} thread_time_constraint_policy_data_t;
+
+#define THREAD_TIME_CONSTRAINT_POLICY 14
+#define THREAD_TIME_CONSTRAINT_POLICY_COUNT \
+    ((mach_msg_type_number_t)(sizeof(thread_time_constraint_policy_data_t) / sizeof(int)))
+
+kern_return_t thread_policy_get(mach_port_t thread, thread_policy_flavor_t flavor, thread_policy_info_t info,
+                                 mach_msg_type_number_t *count, boolean_t *default_policy);
+kern_return_t thread_policy_set(mach_port_t thread, thread_policy_flavor_t flavor, thread_policy_info_t info,
+                                 mach_msg_type_number_t count);
