diff --git a/dm/host/Makefile.linux b/dm/host/Makefile.linux
new file mode 100644
index 0000000..3ced4d6
--- /dev/null
+++ b/dm/host/Makefile.linux
@@ -0,0 +1,126 @@
+# The Linux build of the host: the same sources as the Mac build, with the ELF assembly
+# twins and the Linux stand-ins.
+#
+# What changes from dm/host/Makefile:
+#   target     aarch64 Linux, the arch the guest's code is in (cross-built from any host
+#              with zig; HOST_TARGET and HOST_CC override). x86_64 does not run the guest:
+#              the game's code is executed natively, so the host must be an ARM64 process.
+#   toolchain  zig cc by default (static, runs anywhere), or a cross toolchain's gcc
+#   sources    the ObjC front ends and the Metal / Vulkan / OpenGL backends are not built;
+#              the front end is linux/front_linux.c and the graphics is
+#              linux/linux_gfx_stub.c until the Vulkan backend exists
+#   audio      hle_audio.c and the movie decoders need Apple's AudioToolbox / VideoToolbox
+#              and are not built yet (the host runs, no sound, no movies); their HLE
+#              entries are stubbed by linux/linux_media_stub.c
+#   c locale   the host's messages are English and its error strings are the C locale's,
+#              as tools/patches.py clean_env asks on every platform
+#
+# Same GAME / DM_GAMES_DIR profile rules as the Mac build: there is no default game.
+
+PYTHON ?= python3
+
+ifneq ($(strip $(GAME)),)
+GAME_DIR := $(if $(and $(wildcard ../games/$(GAME)/game.tsv),$(if $(DM_GAMES_FIRST),,1)),../games/$(GAME),$(shell "$(PYTHON)" ../games/game.py link $(GAME) gen/$(GAME)/profile >&2 && echo gen/$(GAME)/profile))
+ifeq ($(GAME_DIR),)
+$(error no game profile $(GAME) (neither in dm/games nor in DM_GAMES_DIR))
+endif
+else
+GAME_DIR :=
+endif
+GAME_H = gen/$(GAME)/game_profile.h
+
+# The cross target: aarch64 Linux by default (the guest's arch). HOST_TARGET=aarch64-linux-musl
+# gives a static binary that runs on any aarch64 Linux; HOST_TARGET=aarch64-linux-gnu links
+# against a distro's glibc instead.
+HOST_TARGET ?= aarch64-linux-musl
+HOST_CC ?= zig cc -target $(HOST_TARGET)
+LDFLAGS ?= -static
+CFLAGS = -O1 -g -Wall -Wno-unused-function -Wno-format -std=gnu11 -fblocks -D_GNU_SOURCE -DDM_LINUX=1
+INCLUDES = -Ilinux/include -I. -I../gfx -I../gfx/nvn/include -I$(dir $(GAME_H)) -I../third_party/libvpx \
+           -I../third_party/dav1d/include -I../third_party/stb_vorbis -I../third_party/vulkan-headers/include
+
+# The portable host: every *.c of dm/host except the ones that need Apple's frameworks
+# (hle_audio.c and hle_movie*.c: AudioToolbox / VideoToolbox), plus the Linux stand-ins and
+# the portable C of the graphics layer. libvpx (the movie codecs) is built from
+# dm/third_party/libvpx, as the Mac build does.
+SRC_C = $(sort $(wildcard *.c) $(wildcard linux/*.c))
+SRC_C := $(filter-out hle_audio.c hle_movie.c hle_movie_av1.c hle_movie_avc.c,$(SRC_C))
+HOST_C = $(SRC_C) ../gfx/hle_nv.c ../gfx/hle_vi.c ../gfx/nvn/hle_nvn.c ../gfx/nvn/nvn_capture.c \
+         ../gfx/nvn/nvn_dirty.c ../gfx/nvn/nvn_tex.c ../gfx/tex/nvn_bcdec.c ../gfx/tex/nvn_deswizzle.c \
+         ../gfx/tex/nvn_fmt_mtl.c ../third_party/stb_vorbis/stb_vorbis.c
+
+# The Mach-O assembly, converted to ELF by linux/asm_elf.py into gen/lin (the macOS build
+# keeps its own files). The two nvn_* files are the counting thunks and the special entries
+# of the NVN interface.
+HOST_S = entry.S ../gfx/nvn/nvn_entry.S ../gfx/nvn/nvn_thunks.S
+
+# libvpx: the VP8 and VP9 decoders the movie player uses (its arm64 configuration is in
+# dm/third_party/libvpx/config, the one the Mac build uses; the codec's CPU dispatch takes
+# it from there)
+VPX = ../third_party/libvpx
+VPX_SRC = $(sort $(shell find $(VPX) -name '*.c'))
+VPX_OBJ = $(patsubst $(VPX)/%.c,gen/lin/vpx_%.o,$(VPX_SRC))
+
+# Objects, one per source, flat under gen/lin (the basenames of the host are unique)
+TAG = tag
+ALL_SRC = $(HOST_C) $(HOST_S) $(VPX_SRC)
+OBJ = $(addprefix gen/lin/,$(notdir $(HOST_C:.c=.o))) $(addprefix gen/lin/asm_,$(notdir $(HOST_S:.S=.o))) $(VPX_OBJ)
+DEP = $(OBJ:.o=.d)
+
+.PHONY: host asm
+.DEFAULT_GOAL := host
+
+$(GAME_H): $(GAME_DIR)/game.tsv ../games/game.py FORCE
+	@mkdir -p $(dir $@)
+	"$(PYTHON)" ../games/game.py header $(GAME) $@
+
+gen/lin/asm_entry.S: entry.S linux/asm_elf.py FORCE
+	@mkdir -p $(dir $@)
+	"$(PYTHON)" linux/asm_elf.py entry.S $@
+gen/lin/asm_nvn_entry.S: ../gfx/nvn/nvn_entry.S linux/asm_elf.py FORCE
+	@mkdir -p $(dir $@)
+	"$(PYTHON)" linux/asm_elf.py ../gfx/nvn/nvn_entry.S $@
+gen/lin/asm_nvn_thunks.S: ../gfx/nvn/nvn_thunks.S linux/asm_elf.py FORCE
+	@mkdir -p $(dir $@)
+	"$(PYTHON)" linux/asm_elf.py ../gfx/nvn/nvn_thunks.S $@
+
+gen/lin/asm_entry.o: gen/lin/asm_entry.S FORCE
+	$(HOST_CC) $(CFLAGS) -c $< -o $@
+gen/lin/asm_nvn_entry.o: gen/lin/asm_nvn_entry.S FORCE
+	$(HOST_CC) $(CFLAGS) -c $< -o $@
+gen/lin/asm_nvn_thunks.o: gen/lin/asm_nvn_thunks.S FORCE
+	$(HOST_CC) $(CFLAGS) -c $< -o $@
+
+# One rule per source, by basename (the files of dm/host have unique basenames)
+define HOST_C_RULE
+gen/lin/$(notdir $(1:.c=.o)): $(1) $(GAME_H) FORCE
+	@mkdir -p $$(dir $$@)
+	$(HOST_CC) $(CFLAGS) $(INCLUDES) -MMD -MP -c $(1) -o $$@
+endef
+$(foreach src,$(HOST_C),$(eval $(call HOST_C_RULE,$(src))))
+
+gen/lin/vpx_%.o: $(VPX)/%.c $(GAME_H) FORCE
+	@mkdir -p $(dir $@)
+	$(HOST_CC) $(CFLAGS) -I$(VPX) -I$(VPX)/config -MMD -MP -c $< -o $@
+
+host: $(OBJ) $(GAME_H)
+	$(HOST_CC) $(LDFLAGS) -o dmhost_linux $(OBJ)
+
+# The compat layer's own test: the behaviour the host depends on. On an x86_64 host it runs
+# under qemu-user, which the test's arm64 binary needs.
+QEMU ?= qemu-aarch64-static
+TEST_OBJ = gen/lin/linux_compat.o gen/lin/linux_dispatch.o gen/lin/linux_blocks.o
+.PHONY: test
+test: gen/lin/t_linux_compat.o $(TEST_OBJ)
+	$(HOST_CC) $(LDFLAGS) -o dmhost_linuxtest $(TEST_OBJ) gen/lin/t_linux_compat.o
+	$(QEMU) ./dmhost_linuxtest
+
+gen/lin/t_linux_compat.o: linux/tests/t_linux_compat.c $(GAME_H) FORCE
+	@mkdir -p $(dir $@)
+	$(HOST_CC) $(CFLAGS) $(INCLUDES) -MMD -MP -c $< -o $@
+
+clean:
+	rm -rf gen dmhost_linux dmhost_linuxtest
+
+.PHONY: FORCE
+FORCE:
diff --git a/dm/host/crash.c b/dm/host/crash.c
index 6f5493c..94c5798 100644
--- a/dm/host/crash.c
+++ b/dm/host/crash.c
@@ -2,6 +2,9 @@
 // Crash state: prints the faulting address, pc, lr (converted to module-relative offsets) and the registers; dispatches page fault hooks.
 // Only signal handling itself lives here: diagnostic features (probes / UI messages / sampling) are in diag.c, and this file does not depend on them (the graphics unit tests link only this file).
 #include "dm.h"
+#ifdef DM_LINUX
+#include <dm_ucontext.h>   // the register view a Linux signal handler gets
+#endif
 #include <signal.h>
 #include <dlfcn.h>
 #include <sys/ucontext.h>
@@ -159,9 +162,17 @@ static void crash_gate(int sig) {
 }
 static void on_crash(int sig, siginfo_t *si, void *uc_) {
     ucontext_t *uc = uc_;
+#ifdef DM_LINUX
+    if (sig == SIGTRAP && g_trap_hook && g_trap_hook(uc)) { dm_linux_ss_stash(uc); return; }
+#else
     if (sig == SIGTRAP && g_trap_hook && g_trap_hook(uc)) return;
+#endif
     if (sig == SIGSEGV || sig == SIGBUS) {
+#ifdef DM_LINUX
+        int is_write = dm_linux_ctx_is_write(uc);   // Linux: the write bit is in the si_code of the siginfo, see dm_linux_ctx_is_write
+#else
         int is_write = (int)((uc->uc_mcontext->__es.__esr >> 6) & 1);   // The WnR bit of ESR
+#endif
         for (int i = 0; i < g_nfault_hook; i++) if (g_fault_hook[i](si->si_addr, is_write, uc)) return;
     }
     crash_gate(sig);
@@ -170,7 +181,11 @@ static void on_crash(int sig, siginfo_t *si, void *uc_) {
     for (int i = 0; ftrylockfile(stderr); i++) {
         if (i < 100) { usleep(10000); continue; }
         char b[256]; int n = snprintf(b, sizeof b, "[dm] CRASH sig=%d (stderr held for 1 s, no dump)", sig);
-        uint64_t at[2] = {uc->uc_mcontext->__ss.__pc, uc->uc_mcontext->__ss.__lr};
+#ifdef DM_LINUX
+        dm_linux_ctx_t ss; dm_linux_ctx_read(uc, &ss); uint64_t at[2] = {ss.pc, ss.lr};
+#else
+        uint64_t at[2] = {dm_uc_ss(uc)->__pc, dm_uc_ss(uc)->__lr};
+#endif
         for (int k = 0; k < 2; k++) { module_t *m = module_of((void *)at[k]);
             n += m ? snprintf(b + n, sizeof b - n, " %s=%s+%#llx", k ? "lr" : "pc", m->name, at[k] - (uint64_t)m->base) : snprintf(b + n, sizeof b - n, " %s=%#llx", k ? "lr" : "pc", at[k]); }
         n += snprintf(b + n, sizeof b - n, "\n");
@@ -179,25 +194,25 @@ static void on_crash(int sig, siginfo_t *si, void *uc_) {
     }
     funlockfile(stderr);
     fprintf(stderr, "[dm] CRASH sig=%d", sig);
-    off("addr", (uint64_t)si->si_addr); off("pc", uc->uc_mcontext->__ss.__pc); off("lr", uc->uc_mcontext->__ss.__lr);
-    fprintf(stderr, " sp=%#llx\n", uc->uc_mcontext->__ss.__sp);
-    for (int i = 0; i < 29; i++) fprintf(stderr, "x%d=%#llx%s", i, uc->uc_mcontext->__ss.__x[i], i % 6 == 5 ? "\n" : " ");
+    off("addr", (uint64_t)si->si_addr); off("pc", dm_uc_ss(uc)->__pc); off("lr", dm_uc_ss(uc)->__lr);
+    fprintf(stderr, " sp=%#llx\n", dm_uc_ss(uc)->__sp);
+    for (int i = 0; i < 29; i++) fprintf(stderr, "x%d=%#llx%s", i, dm_uc_ss(uc)->__x[i], i % 6 == 5 ? "\n" : " ");
     fprintf(stderr, "\n");
     // What the registers point at: the first six words of each readable target (read with vm_read_overwrite, which fails instead of faulting); a word inside a module prints as a module offset, so an object's vtable names its class
     for (int i = 0; i < 29; i++) {
-        uint64_t a = uc->uc_mcontext->__ss.__x[i], w[6]; vm_size_t got = 0;
+        uint64_t a = dm_uc_ss(uc)->__x[i], w[6]; vm_size_t got = 0;
         if (a < 0x100000000ull || (a & 7) || vm_read_overwrite(mach_task_self(), (vm_address_t)a, sizeof w, (vm_address_t)w, &got) != KERN_SUCCESS || got != sizeof w) continue;
         fprintf(stderr, "[dm] *x%d:", i);
         for (int k = 0; k < 6; k++) off("", w[k]);
         fputc('\n', stderr);
     }
-    dm_backtrace(uc->uc_mcontext->__ss.__fp);
+    dm_backtrace(dm_uc_ss(uc)->__fp);
     // Stack scan: when the frame chain is broken (a return address was overwritten, pc = lr lands on garbage) the backtrace prints nothing; scan 512 words up from sp and list everything that resolves to a module / host symbol (nearest callers first)
-    {   uint64_t sp = uc->uc_mcontext->__ss.__sp;   // The frame just popped (when a return address was overwritten, the bad value and the leftovers of whatever overwrote it sit below sp)
-        fprintf(stderr, "[dm] fp=%#llx  0x100 bytes below sp:", (unsigned long long)uc->uc_mcontext->__ss.__fp);
+    {   uint64_t sp = dm_uc_ss(uc)->__sp;   // The frame just popped (when a return address was overwritten, the bad value and the leftovers of whatever overwrote it sit below sp)
+        fprintf(stderr, "[dm] fp=%#llx  0x100 bytes below sp:", (unsigned long long)dm_uc_ss(uc)->__fp);
         for (int i = -32; i < 0 && sp && !(sp & 7); i++) fprintf(stderr, "%s%llx", (i + 32) % 4 ? " " : "\n[dm]   ", (unsigned long long)((uint64_t *)sp)[i]);
         fputc('\n', stderr); }
-    {   uint64_t sp = uc->uc_mcontext->__ss.__sp; int n = 0;
