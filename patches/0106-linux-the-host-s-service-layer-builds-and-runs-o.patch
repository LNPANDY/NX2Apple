diff --git a/dm/host/linux/include/sys/xattr.h b/dm/host/linux/include/sys/xattr.h
new file mode 100644
index 0000000..a9b1c79
--- /dev/null
+++ b/dm/host/linux/include/sys/xattr.h
@@ -0,0 +1,63 @@
+// Linux stand-in for <sys/xattr.h>: the extended attributes of a file.
+//
+// The host stores the guest's own name on the physical name it chose when a name collided
+// on the host's volume (hle_fs.c). Linux has the same attributes on the same file; the
+// signatures differ: Darwin takes an options value and a position in one call, Linux has
+// one call for the follow case and one for the no-follow case, and no position.
+//
+// The functions below are the Darwin two-in-one forms, over Linux's syscalls, so the host
+// source keeps its own call shape on every platform.
+#pragma once
+
+#include <errno.h>
+#include <stdint.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+// Darwin's "no attribute" error: Linux calls the same thing ENODATA
+#ifndef ENOATTR
+#define ENOATTR ENODATA
+#endif
+
+#define XATTR_NOFOLLOW 0x0001
+#define XATTR_CREATE 0x0002
+#define XATTR_REPLACE 0x0004
+
+#ifndef SYS_getxattr
+#define SYS_getxattr 182
+#endif
+#ifndef SYS_lgetxattr
+#define SYS_lgetxattr 180
+#endif
+#ifndef SYS_setxattr
+#define SYS_setxattr 181
+#endif
+#ifndef SYS_lsetxattr
+#define SYS_lsetxattr 183
+#endif
+#ifndef SYS_removexattr
+#define SYS_removexattr 186
+#endif
+#ifndef SYS_lremovexattr
+#define SYS_lremovexattr 184
+#endif
+
+static inline ssize_t getxattr(const char *path, const char *name, void *value, size_t size,
+                               uint32_t position, int options);
+
+static inline ssize_t dm_xattr_read(const char *path, const char *name, void *value, size_t size,
+                                    uint32_t position, int options) {
+    (void)position;
+    if (options & XATTR_NOFOLLOW) return (ssize_t)syscall(SYS_lgetxattr, path, name, value, size);
+    return (ssize_t)syscall(SYS_getxattr, path, name, value, size);
+}
+
+static inline ssize_t getxattr(const char *path, const char *name, void *value, size_t size,
+                               uint32_t position, int options) {
+    return dm_xattr_read(path, name, value, size, position, options);
+}
+
+int setxattr(const char *path, const char *name, const void *value, size_t size, uint32_t position,
+             int options);
+int removexattr(const char *path, const char *name, int options);
diff --git a/dm/host/linux/linux_blocks.c b/dm/host/linux/linux_blocks.c
new file mode 100644
index 0000000..02df3f6
--- /dev/null
+++ b/dm/host/linux/linux_blocks.c
@@ -0,0 +1,154 @@
+// A minimal BlocksRuntime for the Linux build.
+//
+// Clang's blocks (the ^( ... ) syntax GCD's API takes) need the runtime that Apple ships
+// in libSystem: the class of a stack block, and the copy and release of a block that
+// outlives the stack it was made on. Linux has no such library, and the engine's blocks
+// are plain C blocks (no Objective-C captures), so the runtime below is the small part of
+// it that those need: a stack block is copied to the heap when a queue keeps it, and the
+// copy is released when the queue is done with it.
+//
+// The layout of a block and of its descriptor is the one Clang emits (Block_private.h
+// in the compiler's sources).
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct Block_descriptor_1 {
+    unsigned long reserved;
+    unsigned long size;
+};
+
+struct Block_descriptor_2 {
+    struct Block_descriptor_1 d;
+    void (*copy)(void *dst, const void *src);
+    void (*dispose)(const void *);
+};
+
+struct Block_layout {
+    void *isa;
+    volatile int flags;
+    int reserved;
+    void (*invoke)(void *, ...);
+    struct Block_descriptor_1 *descriptor;
+    // the captured values follow
+};
+
+enum {
+    BLOCK_DEALLOCATING = 0x0001,
+    BLOCK_REFCOUNT_MASK = 0xfffe,
+    BLOCK_NEEDS_FREE = (1 << 24),
+    BLOCK_HAS_COPY_DISPOSE = (1 << 25),
+    BLOCK_HAS_CTOR = (1 << 26),
+    BLOCK_IS_GLOBAL = (1 << 28),
+    BLOCK_HAS_STRET = (1 << 29),
+    BLOCK_HAS_SIGNATURE = (1 << 30),
+};
+
+struct Block_byref {
+    void *isa;
+    struct Block_byref *forwarding;
+    volatile int flags;
+    int size;
+    void (*byref_keep)(struct Block_byref *dst, struct Block_byref *src);
+    void (*byref_dispose)(struct Block_byref *);
+};
+
+// The classes of the blocks. The runtime only checks that isa is one of them.
+void *_NSConcreteStackBlock[32];
+void *_NSConcreteMallocBlock[32];
+void *_NSConcreteGlobalBlock[32];
+void *_NSConcreteAutoBlock[32];
+void *_NSConcreteFinalizingBlock[32];
+void *_NSConcreteWeakBlockVariable[32];
+
+static int block_refcount_inc(void *arg) {
+    (void)arg;
+    return 1;   // the host's blocks are used by one owner at a time
+}
+
+// Copy a block to the heap: the literal, its captured values, and (when the block has
+// them) the copy helper of its descriptor, which copies the captured objects.
+void *_Block_copy(const void *arg) {
+    struct Block_layout *block = (struct Block_layout *)arg;
+    if (!block) return NULL;
+    if (block->flags & BLOCK_IS_GLOBAL) return block;
+    if (!(block->flags & BLOCK_NEEDS_FREE)) {
+        struct Block_descriptor_2 *desc = (struct Block_descriptor_2 *)block->descriptor;
+        size_t size = desc->d.size;
+        struct Block_layout *copy = (struct Block_layout *)malloc(size);
+        if (!copy) return NULL;
+        memcpy(copy, block, size);
+        copy->flags |= BLOCK_NEEDS_FREE;
+        copy->flags &= ~BLOCK_REFCOUNT_MASK;
+        copy->flags |= 2;   // the reference count of a fresh heap block
+        copy->isa = _NSConcreteMallocBlock;
+        if (block->flags & BLOCK_HAS_COPY_DISPOSE) desc->copy(copy, block);
+        return copy;
+    }
+    // Already on the heap: one more owner.
+    block_refcount_inc(block);
+    return block;
+}
+
+// Release a block: the copy helper of its descriptor runs when it is the last owner.
+void _Block_release(const void *arg) {
+    struct Block_layout *block = (struct Block_layout *)arg;
+    if (!block) return;
+    if (block->flags & BLOCK_IS_GLOBAL) return;
+    if (!(block->flags & BLOCK_NEEDS_FREE)) return;   // a stack block: the stack owns it
+    if (block->flags & BLOCK_HAS_COPY_DISPOSE) {
+        struct Block_descriptor_2 *desc = (struct Block_descriptor_2 *)block->descriptor;
+        desc->dispose(block);
+    }
+    free(block);
+}
+
+// The byref helpers of the __block variables.
+void *_Block_byref_copy(const void *arg) {
+    struct Block_byref *src = (struct Block_byref *)arg;
+    if (!src) return NULL;
+    if (src->forwarding->flags & BLOCK_NEEDS_FREE) {
+        src->forwarding->flags &= ~BLOCK_REFCOUNT_MASK;
+        src->forwarding->flags |= 2;
+        return src->forwarding;
+    }
+    struct Block_byref *copy = (struct Block_byref *)malloc(src->size);
+    if (!copy) return NULL;
+    copy->isa = NULL;
+    copy->flags = src->flags | BLOCK_NEEDS_FREE | 2;
+    copy->forwarding = copy;
+    src->forwarding = copy;
+    copy->size = src->size;
+    if (src->flags & BLOCK_HAS_COPY_DISPOSE) {
+        copy->byref_keep = src->byref_keep;
+        copy->byref_dispose = src->byref_dispose;
+        src->byref_keep(copy, src);
+    } else {
+        memcpy((char *)copy + sizeof(struct Block_byref), (const char *)src + sizeof(struct Block_byref),
+               src->size - sizeof(struct Block_byref));
+    }
+    return copy;
+}
+
+void _Block_byref_release(const void *arg) {
+    struct Block_byref *byref = (struct Block_byref *)arg;
+    if (!byref) return;
+    if (byref->forwarding->flags & BLOCK_NEEDS_FREE) {
+        byref->forwarding->flags &= ~BLOCK_REFCOUNT_MASK;
+        byref->forwarding->flags |= 2;
+        return;
+    }
+    if (byref->flags & BLOCK_HAS_COPY_DISPOSE) byref->byref_dispose(byref);
+    free(byref);
+}
+
+// The object helpers: the host's blocks capture no objects, so they only have to exist.
+void _Block_object_assign(void *dst, const void *object, const int flags) {
+    (void)flags;
+    *(const void **)dst = object;
+}
+
+void _Block_object_dispose(const void *object, const int flags) {
+    (void)object;
+    (void)flags;
+}
diff --git a/dm/host/linux/linux_compat.c b/dm/host/linux/linux_compat.c
new file mode 100644
index 0000000..3988213
--- /dev/null
+++ b/dm/host/linux/linux_compat.c
@@ -0,0 +1,1425 @@
+// The Linux stand-ins for the platform interfaces the host uses.
+//
+// Everything the host asks of Apple comes in through one of the headers in
+// dm/host/linux/include; the implementations are here. They are small on purpose: the
+// host's service layer is portable C and only needs a handful of kernel services.
+//
+// The mapping from Apple to Linux:
+//
+//   vm_read_overwrite / vm_write   process_vm_readv / process_vm_writev
+//   vm_allocate / vm_deallocate    mmap / munmap
+//   vm_protect / mach_vm_protect   mprotect
+//   vm_region_64 / mach_vm_region  the ranges of /proc/self/maps
+//   mach_task_self                 the process id
+//   mach_thread_self               the thread id (from syscall SYS_gettid)
+//   task_threads                   the entries of /proc/self/task
+//   thread_info                    utime / stime of /proc/<tid>/stat
+//   mach_absolute_time             CLOCK_MONOTONIC, in nanoseconds
+//   getsectiondata                 the section headers of the running executable
+//   malloc zones                   the C library's allocator
+//   CoreFoundation                  the strings and the one dictionary the host uses
+//   CommonCrypto                    the SHA-256 the host hashes its modules with
+//   sysctl                         /proc and uname
+//
+// What cannot be reproduced returns the Mach failure code and the caller takes its own
+// error path: the register state of another thread (the host's crash dump reads the
+// stacks instead) and the real-time policy of the present thread.
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include "dm_linux.h"
+#include <link.h>
+#include <CommonCrypto/CommonDigest.h>
+#include <CoreFoundation/CoreFoundation.h>
+#include <dm_ucontext.h>
+#include <malloc/malloc.h>
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <mach/mach_vm.h>
+#include <mach/thread_info.h>
+#include <mach/thread_policy.h>
+#include <mach/vm_prot.h>
+#include <mach/vm_statistics.h>
+#include <mach-o/getsect.h>
+#include <pthread.h>
+#include <pthread/qos.h>
+#include <pthread_sched_np.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/random.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/xattr.h>
+#include <sys/syscall.h>
+#include <sys/sysctl.h>
+#include <sys/types.h>
+#include <sys/uio.h>
+#include <sys/utsname.h>
+#include <time.h>
+#include <unistd.h>
+
+// The virtual size and the resident size of this process: the same figures the host
+// prints in its memory report. Field 23 of /proc/self/stat is the size in bytes, and
+// ru_maxrss is the peak resident set in KiB.
+static uint64_t getrusage_self_virtual(void) {
+    FILE *f = fopen("/proc/self/stat", "r");
+    if (!f) return 0;
+    char line[4096];
+    if (!fgets(line, sizeof line, f)) {
+        fclose(f);
+        return 0;
+    }
+    fclose(f);
+    char *p = strrchr(line, ')');
+    if (!p) return 0;
+    unsigned long long vsize = 0;
+    // Fields 3..22 of /proc/self/stat, then vsize (23): state, ppid, pgrp, session,
+    // tty_nr, tpgid, flags, minflt, cminflt, majflt, cmajflt, utime, stime, cutime,
+    // cstime, priority, nice, num_threads, itrealvalue, starttime (20 more).
+    if (sscanf(p + 1, " %*c %*d %*d %*d %*d %*d %*u %*u %*u %*u %*u %*u %*u %llu", &vsize) != 1) return 0;
+    return vsize;
+}
+
+static uint64_t getrusage_self_rss(void) {
+    long page = sysconf(_SC_PAGESIZE);
+    if (page <= 0) page = 4096;
+    struct rusage ru;
+    if (getrusage(RUSAGE_SELF, &ru)) return 0;
+    return (uint64_t)ru.ru_maxrss * 1024ull;   // ru_maxrss is in KiB on Linux
+}
+
+#ifdef __GNUC__
+#define DM_ALIGNOF(t) __alignof__(t)
+#else
+#define DM_ALIGNOF(t) sizeof(t)
+#endif
+
+// ---- the clock
+
+uint64_t mach_absolute_time(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+kern_return_t mach_timebase_info(mach_timebase_info_data_t *info) {
+    if (!info) return KERN_INVALID_ARGUMENT;
+    info->numer = 1;   // nanoseconds per tick: Linux has no time base conversion
+    info->denom = 1;
+    return KERN_SUCCESS;
+}
+
+kern_return_t mach_wait_until(uint64_t deadline) {
+    struct timespec ts;
+    ts.tv_sec = (time_t)(deadline / 1000000000ull);
+    ts.tv_nsec = (long)(deadline % 1000000000ull);
+    while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL) == EINTR) {}
+    return KERN_SUCCESS;
+}
+
+// ---- the task and its threads
+
+mach_port_t mach_task_self(void) { return (mach_port_t)getpid(); }
+
+static mach_port_t tid_self(void) { return (mach_port_t)syscall(SYS_gettid); }
+
+mach_port_t mach_thread_self(void) { return tid_self(); }
+
+kern_return_t mach_port_deallocate(mach_port_t task, mach_port_t name) {
+    (void)task;
+    (void)name;
+    return KERN_SUCCESS;
+}
+
+mach_port_t pthread_mach_thread_np(pthread_t thread) {
+    if (pthread_equal(thread, pthread_self())) return tid_self();
+    // Another thread's id is not available in Linux from the pthread alone, and the host
+    // only ever asks about its own thread (the QoS of the present thread).
+    return MACH_PORT_NULL;
+}
+
+// ---- reading and writing another task's memory
+//
+// The host's guest memory is mapped in the host's address space, so a read is a copy
+// within the process; the kernel's process_vm_readv does exactly that and reports an
+// error for an unreadable page instead of faulting, which is what the host relies on.
+
+// The guest's memory is a file on Linux: /proc/self/mem. A read and a write of it answer
+// for an unmapped address (EIO / EFAULT) instead of faulting, which is what the host relies
+// on, and it works where process_vm_readv does not (qemu-user has no such syscall).
+static int self_mem_fd(void) {
+    static int fd = -1;
+    if (fd < 0) fd = open("/proc/self/mem", O_RDWR);
+    return fd;
+}
+
+kern_return_t vm_read_overwrite(mach_port_t task, vm_address_t address, vm_size_t size,
+                                 vm_offset_t data, vm_size_t *out_size) {
+    (void)task;
+    if (out_size) *out_size = 0;
+    if (!size) return KERN_SUCCESS;
+    int fd = self_mem_fd();
+    if (fd < 0) return KERN_FAILURE;
+    off_t at = (off_t)address;
+    if (lseek(fd, at, SEEK_SET) < 0) return KERN_FAILURE;
+    ssize_t got = read(fd, (void *)(uintptr_t)data, size);
+    if (got < 0) return KERN_FAILURE;
+    if (out_size) *out_size = (vm_size_t)got;
+    return KERN_SUCCESS;
+}
+
+kern_return_t vm_write(mach_port_t task, vm_address_t address, vm_offset_t data,
+                        mach_msg_type_number_t size) {
+    (void)task;
+    if (!size) return KERN_SUCCESS;
+    int fd = self_mem_fd();
+    if (fd < 0) return KERN_FAILURE;
+    if (lseek(fd, (off_t)address, SEEK_SET) < 0) return KERN_FAILURE;
+    return write(fd, (const void *)(uintptr_t)data, size) == (ssize_t)size ? KERN_SUCCESS : KERN_FAILURE;
+}
+
+// ---- mapping and protecting
+
+static int prot_of(vm_prot_t p) {
+    int m = 0;
+    if (p & VM_PROT_READ) m |= PROT_READ;
+    if (p & VM_PROT_WRITE) m |= PROT_WRITE;
+    if (p & VM_PROT_EXECUTE) m |= PROT_EXEC;
+    return m;
+}
+
+kern_return_t vm_allocate(mach_port_t task, vm_address_t *address, vm_size_t size,
+                           vm_flags_t flags) {
+    (void)task;
+    if (!address || !size) return KERN_INVALID_ARGUMENT;
+    int fixed = (flags & VM_FLAGS_FIXED) ? MAP_FIXED : 0;
+    uintptr_t hint = (flags & VM_FLAGS_FIXED) ? *address : 0;
+    void *got = mmap((void *)hint, size, PROT_READ | PROT_WRITE,
+                      MAP_PRIVATE | MAP_ANONYMOUS | fixed, -1, 0);
+    if (got == MAP_FAILED) return KERN_NO_SPACE;
+    if (fixed && got != (void *)(uintptr_t)*address) {
+        munmap(got, size);
+        return KERN_NO_SPACE;
+    }
+    *address = (vm_address_t)(uintptr_t)got;
+    return KERN_SUCCESS;
+}
+
+kern_return_t vm_deallocate(mach_port_t task, vm_address_t address, vm_size_t size) {
+    (void)task;
+    if (address && size) munmap((void *)(uintptr_t)address, size);
+    return KERN_SUCCESS;
+}
+
+kern_return_t vm_protect(mach_port_t task, vm_address_t address, vm_size_t size,
+                          boolean_t set_maximum, vm_prot_t new_prot) {
+    (void)task;
+    (void)set_maximum;
+    if (address && size) mprotect((void *)(uintptr_t)address, size, prot_of(new_prot));
+    return KERN_SUCCESS;
+}
+
+// vm_remap: a second mapping of the same pages. Linux cannot map another process's
+// (or the same process's) pages at a second address, so the mapping is a copy. The host
+// uses it for the NVN virtual pools (a guest alias of a physical pool); the copy is
+// visible to the host only, not to the GPU, so the pool's mappings that go through it
+// are the ones the host says it cannot alias.
+static _Atomic int g_remap_copy_logged;
+
+kern_return_t vm_remap(mach_port_t target_task, vm_address_t *target_address, vm_size_t size,
+                        vm_offset_t offset, vm_flags_t flags, mach_port_t source_task,
+                        vm_address_t source_address, boolean_t copy, vm_prot_t *current_protection,
+                        vm_prot_t *max_protection, vm_inherit_t inherit) {
+    (void)target_task;
+    (void)offset;
+    (void)source_task;
+    (void)copy;
+    (void)inherit;
+    if (!target_address || !size) return KERN_INVALID_ARGUMENT;
+    int fixed = (flags & VM_FLAGS_FIXED) ? MAP_FIXED : 0;
+    uintptr_t hint = (flags & VM_FLAGS_FIXED) ? *target_address : 0;
+    void *got = mmap((void *)hint, size, PROT_READ | PROT_WRITE,
+                      MAP_PRIVATE | MAP_ANONYMOUS | fixed, -1, 0);
+    if (got == MAP_FAILED) return KERN_NO_SPACE;
+    if (fixed && got != (void *)(uintptr_t)*target_address) {
+        munmap(got, size);
+        return KERN_NO_SPACE;
+    }
+    memcpy(got, (const void *)(uintptr_t)source_address, size);
+    if (!atomic_fetch_and_explicit(&g_remap_copy_logged, 1, memory_order_relaxed))
+        fprintf(stderr, "[dm] [linux] vm_remap %#lx+%#lx: a copy, not the same pages (the host cannot alias another mapping on Linux)\n",
+                (unsigned long)source_address, (unsigned long)size);
+    if (current_protection) *current_protection = VM_PROT_READ | VM_PROT_WRITE;
+    if (max_protection) *max_protection = VM_PROT_ALL;
+    *target_address = (vm_address_t)(uintptr_t)got;
+    return KERN_SUCCESS;
+}
+
+// ---- the regions of the task
+//
+// The host asks for the protection and the size of the region an address lies in
+// (a write-protected destination it reports, a page the write watch covers). Linux's
+// /proc/self/maps holds the same.
+
+typedef struct {
+    unsigned long start, end;
+    char perms[4];
+    unsigned long long offset;
+    char path[512];
+} map_line;
+
+static int maps_next(FILE *f, map_line *l) {
+    char line[1024];
+    if (!fgets(line, sizeof line, f)) return 0;
+    memset(l, 0, sizeof *l);
+    return sscanf(line, "%lx-%lx %4c %llx %*s %*s %*s %511s", &l->start, &l->end, l->perms,
+                  &l->offset, l->path) >= 4;
+}
+
+kern_return_t vm_region_64(mach_port_t task, vm_address_t *address, vm_size_t *size,
+                            vm_region_flavor_t flavor, vm_region_info_t info,
+                            mach_msg_type_number_t *info_count, mach_port_t *object) {
+    (void)task;
+    if (flavor != VM_REGION_BASIC_INFO_64) return KERN_INVALID_ARGUMENT;
+    FILE *f = fopen("/proc/self/maps", "r");
+    if (!f) return KERN_FAILURE;
+    vm_region_basic_info_data_64_t *bi = (vm_region_basic_info_data_64_t *)info;
+    memset(bi, 0, sizeof *bi);
+    kern_return_t kr = KERN_FAILURE;
+    if (object) *object = MACH_PORT_NULL;
+    if (info_count) *info_count = 0;
+    map_line l;
+    while (maps_next(f, &l)) {
+        if (*address >= l.start && *address < l.end) {
+            vm_prot_t prot = VM_PROT_NONE;
+            if (l.perms[0] == 'r') prot |= VM_PROT_READ;
+            if (l.perms[1] == 'w') prot |= VM_PROT_WRITE;
+            if (l.perms[2] == 'x') prot |= VM_PROT_EXECUTE;
+            *address = l.start;
+            if (size) *size = l.end - l.start;
+            bi->protection = prot;
+            bi->max_protection = VM_PROT_ALL;
+            bi->inheritance = VM_INHERIT_NONE;
+            bi->shared = l.perms[3] == 's';
+            bi->offset = l.offset;
+            if (info_count) *info_count = VM_REGION_BASIC_INFO_COUNT_64;
+            kr = KERN_SUCCESS;
+            break;
+        }
+    }
+    fclose(f);
+    return kr;
+}
+
+// ---- the task's memory and power
+
+kern_return_t task_info(mach_port_t task, int flavor, task_info_t info, mach_msg_type_number_t *count) {
+    (void)task;
+    switch (flavor) {
+    case TASK_VM_INFO: {
+        memset(info, 0, sizeof(task_vm_info_data_t));
+        task_vm_info_data_t *vi = (task_vm_info_data_t *)info;
+        vi->page_size = (int64_t)sysconf(_SC_PAGESIZE);
+        vi->virtual_size = (int64_t)(getrusage_self_virtual());
+        vi->resident_size = (int64_t)(getrusage_self_rss());
+        vi->resident_size_peak = vi->resident_size;
+        vi->region_count = 1;
+        vi->phys_footprint = vi->resident_size;
+        vi->phys_footprint_peak = vi->resident_size;
+        if (count) *count = TASK_VM_INFO_COUNT;
+        return KERN_SUCCESS;
+    }
+    case TASK_POWER_INFO_V2: {
+        memset(info, 0, sizeof(task_power_info_v2_data_t));
+        if (count) *count = TASK_POWER_INFO_V2_COUNT;
+        return KERN_SUCCESS;   // Linux has no energy counter: all zeros
+    }
+    default:
+        return KERN_INVALID_ARGUMENT;
+    }
+}
+
+// ---- the threads of the task
+
+static kern_return_t task_threads_list(thread_act_array_t *out, mach_msg_type_number_t *n) {
+    DIR *d = opendir("/proc/self/task");
+    if (!d) return KERN_FAILURE;
+    thread_act_t *list = NULL;
+    mach_msg_type_number_t count = 0, cap = 0;
+    struct dirent *de;
+    while ((de = readdir(d))) {
+        if (de->d_name[0] < '0' || de->d_name[0] > '9') continue;
+        unsigned long tid = strtoul(de->d_name, NULL, 10);
+        if (!tid) continue;
+        if (count == cap) {
+            cap = cap ? cap * 2 : 16;
+            thread_act_t *grown = (thread_act_t *)realloc(list, (size_t)cap * sizeof *list);
+            if (!grown) {
+                free(list);
+                closedir(d);
+                return KERN_NO_SPACE;
+            }
+            list = grown;
+        }
+        list[count++] = (thread_act_t)(uintptr_t)tid;
+    }
+    closedir(d);
+    *out = list;
+    *n = count;
+    return KERN_SUCCESS;
+}
+
+kern_return_t task_threads(mach_port_t task, thread_act_array_t *threads, mach_msg_type_number_t *count) {
+    (void)task;
+    return task_threads_list(threads, count);
+}
+
+kern_return_t thread_suspend(thread_act_t thread) {
+    (void)thread;
+    // Linux has no per-thread suspend. The host suspends the other threads only to read
+    // their stacks in a crash dump and to profile them, which does not need them stopped.
+    return KERN_SUCCESS;
+}
+
+kern_return_t thread_resume(thread_act_t thread) {
+    (void)thread;
+    return KERN_SUCCESS;
+}
+
+kern_return_t thread_get_state(thread_act_t thread, thread_state_flavor_t flavor, thread_state_t state,
+                               mach_msg_type_number_t *count) {
+    (void)thread;
+    (void)flavor;
+    (void)state;
+    // The register state of a thread is not readable from another thread in Linux: it
+    // would need the tracee's ptrace stop. The host's callers check the result and skip
+    // the entry, so the crash dump carries the stacks instead.
+    if (count) *count = 0;
+    return KERN_FAILURE;
+}
+
+kern_return_t thread_set_state(thread_act_t thread, thread_state_flavor_t flavor, thread_state_t state,
+                               mach_msg_type_number_t count) {
+    (void)thread;
+    (void)flavor;
+    (void)state;
+    (void)count;
+    return KERN_FAILURE;
+}
+
+// A thread's CPU time, from /proc/<tid>/stat. The fields 14 and 15 are utime and stime
+// in clock ticks; the host wants seconds and microseconds, so they are converted.
+static int tid_cpu_times(mach_port_t tid, uint64_t *user_ns, uint64_t *system_ns) {
+    char path[64];
+    snprintf(path, sizeof path, "/proc/self/task/%u/stat", (unsigned)tid);
+    FILE *f = fopen(path, "r");
+    if (!f) return 0;
+    char line[4096];
+    if (!fgets(line, sizeof line, f)) {
+        fclose(f);
+        return 0;
+    }
+    fclose(f);
+    // The comm field may hold spaces and parentheses, so the fields are counted after
+    // the last ')'
+    char *p = strrchr(line, ')');
+    if (!p) return 0;
+    unsigned long ut = 0, st = 0;
+    // Fields 3..11 after the comm (state, ppid, pgrp, session, tty_nr, tpgid, flags,
+    // minflt, cminflt), then utime and stime in clock ticks
+    if (sscanf(p + 1, " %*c %*d %*d %*d %*d %*d %*u %*u %*u %*u %*u %lu %lu", &ut, &st) != 2)
+        return 0;
+    long hz = sysconf(_SC_CLK_TCK);
+    if (hz <= 0) hz = 100;
+    *user_ns = (uint64_t)ut * 1000000000ull / (uint64_t)hz;
+    *system_ns = (uint64_t)st * 1000000000ull / (uint64_t)hz;
+    return 1;
+}
+
+// A thread's name and priority.
+static int tid_info(mach_port_t tid, char *name, size_t name_cap, int *curpri, int *priority,
+                    int *policy) {
+    char path[64];
+    snprintf(path, sizeof path, "/proc/self/task/%u/comm", (unsigned)tid);
+    if (name) {
+        FILE *f = fopen(path, "r");
+        if (f) {
+            if (!fgets(name, (int)name_cap, f)) name[0] = 0;
+            fclose(f);
+            size_t n = strlen(name);
+            while (n && (name[n - 1] == '\n' || name[n - 1] == '\r')) name[--n] = 0;
+        } else if (name_cap) {
+            name[0] = 0;
+        }
+    }
+    int nice = getpriority(PRIO_PROCESS, (int)tid);
+    if (nice == -1 && errno) nice = 0;
+    if (curpri) *curpri = 20 - nice;
+    if (priority) *priority = 20 - nice;
+    if (policy) *policy = SCHED_OTHER;
+    return 1;
+}
+
+kern_return_t thread_info(mach_port_t thread, int flavor, thread_info_t info, mach_msg_type_number_t *count) {
+    if (!info) return KERN_INVALID_ARGUMENT;
+    mach_port_t tid = thread ? thread : tid_self();
+    uint64_t user_ns = 0, system_ns = 0;
+    if (!tid_cpu_times(tid, &user_ns, &system_ns)) {
+        if (count) *count = 0;
+        return KERN_FAILURE;
+    }
+    switch (flavor) {
+    case THREAD_BASIC_INFO: {
+        thread_basic_info_data_t *bi = (thread_basic_info_data_t *)info;
+        memset(bi, 0, sizeof *bi);
+        bi->user_time.seconds = (int32_t)(user_ns / 1000000000ull);
+        bi->user_time.microseconds = (int32_t)((user_ns % 1000000000ull) / 1000);
+        bi->system_time.seconds = (int32_t)(system_ns / 1000000000ull);
+        bi->system_time.microseconds = (int32_t)((system_ns % 1000000000ull) / 1000);
+        if (count) *count = THREAD_BASIC_INFO_COUNT;
+        return KERN_SUCCESS;
+    }
+    case THREAD_EXTENDED_INFO: {
+        thread_extended_info_data_t *xi = (thread_extended_info_data_t *)info;
+        memset(xi, 0, sizeof *xi);
+        xi->pth_user_time.seconds = (int32_t)(user_ns / 1000000000ull);
+        xi->pth_user_time.microseconds = (int32_t)((user_ns % 1000000000ull) / 1000);
+        xi->pth_system_time.seconds = (int32_t)(system_ns / 1000000000ull);
+        xi->pth_system_time.microseconds = (int32_t)((system_ns % 1000000000ull) / 1000);
+        char name[64];
+        int curpri = 0, priority = 0, policy = 0;
+        tid_info(tid, name, sizeof name, &curpri, &priority, &policy);
+        xi->pth_curpri = curpri;
+        xi->pth_priority = priority;
+        xi->pth_maxpriority = 39;
+        xi->pth_policy = policy;
+        snprintf(xi->pth_name, sizeof xi->pth_name, "%s", name);
+        if (count) *count = THREAD_EXTENDED_INFO_COUNT;
+        return KERN_SUCCESS;
+    }
+    default:
+        return KERN_INVALID_ARGUMENT;
+    }
+}
+
+// ---- the thread policy
+//
+// The present thread declares a computation budget per period. Linux has no such
+// interface: SCHED_FIFO and SCHED_RR are the real-time schedulers, and setting one for
+// the host's threads is a decision for the system administrator, not for a game host.
+// The policy is therefore accepted (the host's accounting keeps running) and reported
+// back when asked, which is what the host's log line prints.
+
+kern_return_t thread_policy_get(mach_port_t thread, thread_policy_flavor_t flavor, thread_policy_info_t info,
+                                 mach_msg_type_number_t *count, boolean_t *default_policy) {
+    (void)thread;
+    (void)flavor;
+    (void)info;
+    if (count) *count = 0;
+    if (default_policy) *default_policy = 1;   // never set
+    return KERN_FAILURE;
+}
+
+kern_return_t thread_policy_set(mach_port_t thread, thread_policy_flavor_t flavor, thread_policy_info_t info,
+                                 mach_msg_type_number_t count) {
+    (void)thread;
+    (void)flavor;
+    (void)info;
+    (void)count;
+    return KERN_SUCCESS;   // accepted, not enforced (see the comment above)
+}
+
+// ---- the virtual memory statistics of the host
+
+kern_return_t host_statistics(mach_port_t host, vm_statistics_t stats, mach_msg_type_number_t *count) {
+    (void)host;
+    if (stats) memset(stats, 0, sizeof *stats);
+    if (count) *count = 0;
+    return KERN_SUCCESS;
+}
+
+// ---- CoreFoundation
+//
+// The host's uses are the build stamp (a string the packer leaves in the bundle) and one
+// dictionary of the NVN layer's pipeline cache. A string is a plain C string here, and
+// the dictionary is a list of pairs.
+
+
+const CFTypeID kCFStringTypeID = 1;
+const CFTypeID kCFNumberTypeID = 2;
+const CFTypeID kCFBooleanTypeID = 3;
+const CFTypeID kCFArrayTypeID = 4;
+const CFTypeID kCFDictionaryTypeID = 5;
+const CFTypeID kCFDataTypeID = 6;
+
+CFTypeID CFGetTypeID(CFTypeRef cf) {
+    if (!cf) return 0;
+    return kCFStringTypeID;
+}
+
+CFTypeID CFStringGetTypeID(void) { return kCFStringTypeID; }
+
+Boolean CFStringGetCString(CFStringRef theString, char *buffer, CFIndex bufferSize,
+                            unsigned int encoding) {
+    (void)encoding;
+    if (!theString || !buffer || bufferSize <= 0) return 0;
+    size_t n = strlen((const char *)theString);
+    if (n >= (size_t)bufferSize) n = (size_t)bufferSize - 1;
+    memcpy(buffer, (const char *)theString, n);
+    buffer[n] = 0;
+    return 1;
+}
+
+CFIndex CFStringGetLength(CFStringRef theString) {
+    return theString ? (CFIndex)strlen((const char *)theString) : 0;
+}
+
+Boolean CFEqual(CFTypeRef cf1, CFTypeRef cf2) {
+    if (!cf1 || !cf2) return cf1 == cf2;
+    return strcmp((const char *)cf1, (const char *)cf2) == 0;
+}
+
+void CFRelease(CFTypeRef cf) {
+    (void)cf;
+    // The strings of the shim are literals and the dictionary lives for the process's
+    // lifetime.
+}
+
+CFTypeRef CFRetain(CFTypeRef cf) { return cf; }
+
+CFBundleRef CFBundleGetMainBundle(void) { return NULL; }
+
+CFTypeRef CFBundleGetValueForInfoDictionaryKey(CFBundleRef bundle, CFStringRef key) {
+    (void)bundle;
+    (void)key;
+    return NULL;
+}
+
+// The dictionary: a list of key/value pairs, keyed by the pointer's value.
+
+typedef struct {
+    const void **keys;
+    const void **values;
+    int n, cap;
+} cf_dict;
+
+CFMutableDictionaryRef CFDictionaryCreateMutable(CFAllocatorRef allocator, CFIndex capacity,
+                                                  const void *keyCallbacks, const void *valueCallbacks) {
+    (void)allocator;
+    (void)keyCallbacks;
+    (void)valueCallbacks;
+    cf_dict *d = (cf_dict *)calloc(1, sizeof *d);
+    if (!d) return NULL;
+    if (capacity > 0) {
+        d->cap = (int)capacity;
+        d->keys = (const void **)calloc((size_t)capacity, sizeof *d->keys);
+        d->values = (const void **)calloc((size_t)capacity, sizeof *d->values);
+        if (!d->keys || !d->values) {
+            free(d->keys);
+            free(d->values);
+            free(d);
+            return NULL;
+        }
+    }
+    return (CFMutableDictionaryRef)d;
+}
+
+const void *CFDictionaryGetValue(CFDictionaryRef dict, const void *key) {
+    if (!dict || !key) return NULL;
+    cf_dict *d = (cf_dict *)dict;
+    for (int i = 0; i < d->n; i++) {
+        if (d->keys[i] == key) return d->values[i];
+    }
+    return NULL;
+}
+
+void CFDictionarySetValue(CFDictionaryRef dict, const void *key, const void *value) {
+    if (!dict || !key) return;
+    cf_dict *d = (cf_dict *)dict;
+    for (int i = 0; i < d->n; i++) {
+        if (d->keys[i] == key) {
+            d->values[i] = value;
+            return;
+        }
+    }
+    if (d->n == d->cap) {
+        int cap = d->cap ? d->cap * 2 : 16;
+        const void **keys = (const void **)realloc(d->keys, (size_t)cap * sizeof *keys);
+        const void **values = (const void **)realloc(d->values, (size_t)cap * sizeof *values);
+        if (!keys || !values) return;
+        d->keys = keys;
+        d->values = values;
+        d->cap = cap;
+    }
+    d->keys[d->n] = key;
+    d->values[d->n] = value;
+    d->n++;
+}
+
+CFIndex CFDictionaryGetCount(CFDictionaryRef dict) {
+    return dict ? ((cf_dict *)dict)->n : 0;
+}
