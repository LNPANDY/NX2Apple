@@ -0,0 +1,30 @@
+// Linux stand-ins for the Darwin scheduler interfaces the host uses.
+//
+// Three of them have no Linux equivalent and say so:
+//   pthread_override_with_priority_np / qos_class_start_np: a thread overrides another
+//     thread's scheduling class. Linux has no such interface (one process, one policy per
+//     thread, and no borrowing of one thread's priority by another), so the start returns
+//     NULL and the end does nothing.
+//   pthread_cond_timedwait_relative_np: a wait with a relative timeout. Linux's
+//     pthread_cond_timedwait takes an absolute one, so the shim converts with
+//     CLOCK_REALTIME.
+//   vm_page_size: the granularity the host's stack printer walks a guest thread's stack
+//     in, which on Linux is the page size.
+#pragma once
+
+#include <pthread.h>
+#include <stdint.h>
+#include <sys/user.h>
+#include <time.h>
+
+extern long vm_page_size;
+
+typedef void *pthread_override_t;
+
+int pthread_cond_timedwait_relative_np(pthread_cond_t *cond, pthread_mutex_t *mutex,
+                                        const struct timespec *timeout);
+
+pthread_override_t pthread_override_qos_class_start_np(pthread_t thread, uint32_t qos_class,
+                                                       int relative_priority);
+pthread_override_t pthread_override_with_priority_np(pthread_t thread, unsigned qos_class);
+int pthread_override_qos_class_end_np(pthread_override_t override);
diff --git a/dm/host/linux/include/sys/clonefile.h b/dm/host/linux/include/sys/clonefile.h
new file mode 100644
index 0000000..277bcaa
--- /dev/null
+++ b/dm/host/linux/include/sys/clonefile.h
@@ -0,0 +1,27 @@
+// Linux stand-in for <sys/clonefile.h>: the copy of a file the file system layer uses.
+//
+// macOS's clonefile is a reflink. Linux has the same idea, per file system: FICLONE on
+// the destination file descriptor copies the extents of the source. Where the file system
+// has no reflink the call fails with ENOTSUP, which is what the caller reports.
+#pragma once
+
+#include <fcntl.h>
+#include <linux/fs.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+static inline int clonefile(const char *src, const char *dst, int flags) {
+    (void)flags;
+    int in = open(src, O_RDONLY);
+    if (in < 0) return -1;
+    int out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (out < 0) {
+        close(in);
+        return -1;
+    }
+    int rc = ioctl(out, FICLONE, in);
+    close(in);
+    close(out);
+    if (rc) unlink(dst);
+    return rc;
+}
