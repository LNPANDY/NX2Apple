 // ---------- nsd server name resolution / pctl free communication: networking, out of scope ----------
+// Link Play asks parental controls before it opens (research/06 §3.1): while co-op is on (DM_COOP, the launcher's Link Play switch) the three
+// communication queries answer allowed, else never
+struct coop_node; struct coop_node *dm_coop(void);   // hle_offline.c: NULL with co-op off
+static unsigned pctl_coop(void) { return dm_coop() != NULL; }
 HLE_FORCE("_ZN2nn3nsd7ResolveEPNS0_4FqdnERKS1_", "server name resolution, networking out of scope; cut", Result, h_nsd_Resolve, void *out, const void *in) { (void)out; (void)in; return RES_FAIL; }
 HLE_FORCE("_ZN2nn3nsd9ResolveExEPNS0_4FqdnERKS1_", "server name resolution, networking out of scope; cut", Result, h_nsd_ResolveEx, void *out, const void *in) { (void)out; (void)in; return RES_FAIL; }
 // bool arguments only look at the low 8 bits; returns bool
 // The permission query answers as TryBegin / IsFreeCommunicationAvailable do: the SDK's version calls the pctl service (pctl::detail::ipc::GetService), which the host never opens (DRAGON QUEST XI S imports it; from PR #38)
-HLE_FORCE("_ZN2nn4pctl32CheckFreeCommunicationPermissionEb", "parental controls · permission to communicate with others, networking out of scope; never, no system UI", unsigned, h_pctl_CheckFree, unsigned show_ui) { (void)show_ui; return 0; }
-HLE_FORCE("_ZN2nn4pctl25TryBeginFreeCommunicationEb", "parental controls · communication with others, networking out of scope; never allowed", unsigned, h_pctl_TryBegin, unsigned show_ui) { (void)show_ui; return 0; }
+HLE_FORCE("_ZN2nn4pctl32CheckFreeCommunicationPermissionEb", "parental controls · permission to communicate with others, networking out of scope; never, no system UI", unsigned, h_pctl_CheckFree, unsigned show_ui) { (void)show_ui; return pctl_coop(); }
+HLE_FORCE("_ZN2nn4pctl25TryBeginFreeCommunicationEb", "parental controls · communication with others, networking out of scope; never allowed", unsigned, h_pctl_TryBegin, unsigned show_ui) { (void)show_ui; return pctl_coop(); }
 // Parental control of the 3D (VR goggles) mode, Super Mario Odyssey: no restriction, nothing to configure
 HLE_FORCE("_ZN2nn4pctl26GetStereoVisionRestrictionEv", "parental controls · 3D view restriction; never restricted", unsigned, h_pctl_GetStereo, void) { return 0; }
 HLE_FORCE("_ZN2nn4pctl26SetStereoVisionRestrictionEb", "parental controls · 3D view restriction; the host does not store it", void, h_pctl_SetStereo, unsigned on) { (void)on; }
@@ -186,7 +190,7 @@ HLE_FORCE("_ZN2nn4pctl42ConfirmStereoVisionRestrictionConfigurableEv", "parental
 HLE_FORCE("_ZN2nn4pctl53RequestStereoVisionRestrictionConfigurationPermissionEv", "parental controls · permission to change the 3D restriction; granted at once", Result, h_pctl_ReqStereo, void) { return RES_OK; }
 HLE_FORCE("_ZN2nn4pctl20EndFreeCommunicationEv", "parental controls · communication with others", void, h_pctl_End, void) {}
 // Engage asks on entering a battle map (no UI); without this the SDK connects to the pctl service through sm, which the host does not have, and aborts
-HLE_FORCE("_ZN2nn4pctl28IsFreeCommunicationAvailableEv", "parental controls · whether communication with others is available, networking out of scope; never", unsigned, h_pctl_IsFree, void) { return 0; }
+HLE_FORCE("_ZN2nn4pctl28IsFreeCommunicationAvailableEv", "parental controls · whether communication with others is available, networking out of scope; never", unsigned, h_pctl_IsFree, void) { return pctl_coop(); }
 // The Legend of Zelda: Breath of the Wild: checks the parental-control permission for stereoscopic 3D before turning on the options' Labo VR mode (returns bool; the argument = whether to
 // show UI, the game passes 0). The host has no VR display (pl::BeginVrMode refuses, hle_sdk16.c): not permitted, so the game clears its VR flag and stays 2D (as MacNativeGames found on 1.6.0 and 1.9.0)
 HLE_FORCE("_ZN2nn4pctl33CheckAgcPermissionUnderMinimumAgeERKNS_7account3UidE", "parental controls · a user's permission under the minimum age (SDK 22), networking out of scope; never", unsigned, h_pctl_CheckAgc, const void *uid) { (void)uid; return 0; }
diff --git a/dm/host/hle_net.c b/dm/host/hle_net.c
index e4bc48c..88df5ec 100644
--- a/dm/host/hle_net.c
+++ b/dm/host/hle_net.c
@@ -38,6 +38,31 @@ HLE_FORCE("nnsslFinalize", "pairs with nnsslInitialize (cut)", Result, h_ssl_Fin
 #define SK_ENETDOWN 50                  // Horizon sockets use FreeBSD error codes
 static __thread int t_skerr = SK_ENETDOWN;
 static int sk_fail(void) { t_skerr = SK_ENETDOWN; return -1; }
+// Link Play (docs/coop-step1c.md): with co-op on, the AF_INET datagram sockets the game makes while nn::ldn is initialized are the coop module's virtual
+// sockets (descriptors 0x100 and up on 169.254.S.0/24, hle_coop_vnet.c). Any other descriptor, and every socket with co-op off, keeps the offline answer
+// (-1, ENETDOWN). A module result -errno comes back as -1 with the thread's last error set (FreeBSD values). hle_offline.c's overloads call these too.
+#include "coop.h"
+coop_node *dm_coop(void);   // hle_offline.c: NULL with co-op off
+static int mpsk_is(int s) { coop_node *c = dm_coop(); return c && coop_vnet_is(c, s); }
+static long mpsk_ret(int64_t r) { if (r >= 0) return (long)r; t_skerr = (int)-r; return -1; }
+int mpsk_errno(void) { return t_skerr; }
+int mpsk_socket(int fam, int type, int proto) {
+    coop_node *c = dm_coop();
+    if (!c) return sk_fail();
+    int r = coop_vnet_socket(c, fam, type, proto);
+    if (r < 0) LOG("[coop] sock: Socket(%d, %#x, %d) stays offline (only AF_INET datagram sockets after ldn::Initialize are virtual)", fam, type, proto);
+    return (int)mpsk_ret(r);
+}
+int mpsk_bind(int s, const void *a, unsigned n) { return mpsk_is(s) ? (int)mpsk_ret(coop_vnet_bind(dm_coop(), s, a, n)) : sk_fail(); }
+int mpsk_close(int s) { return mpsk_is(s) ? (int)mpsk_ret(coop_vnet_close(dm_coop(), s)) : sk_fail(); }
+int mpsk_setopt(int s, int l, int o, const void *v, unsigned n) { return mpsk_is(s) ? (int)mpsk_ret(coop_vnet_setsockopt(dm_coop(), s, l, o, v, n)) : sk_fail(); }
+int mpsk_getopt(int s, int l, int o, void *v, unsigned *n) { return mpsk_is(s) ? (int)mpsk_ret(coop_vnet_getsockopt(dm_coop(), s, l, o, v, n)) : sk_fail(); }
+int mpsk_getname(int s, void *a, unsigned *n) { return mpsk_is(s) ? (int)mpsk_ret(coop_vnet_getsockname(dm_coop(), s, a, n)) : sk_fail(); }
+int mpsk_fcntl(int s, int cmd, int v) { return mpsk_is(s) ? (int)mpsk_ret(coop_vnet_fcntl(dm_coop(), s, cmd, v)) : sk_fail(); }
+long mpsk_sendto(int s, const void *b, unsigned long n, int f, const void *to, unsigned tl) { return mpsk_is(s) ? mpsk_ret(coop_vnet_sendto(dm_coop(), s, b, n, f, to, tl)) : sk_fail(); }
+long mpsk_send(int s, const void *b, unsigned long n, int f) { return mpsk_sendto(s, b, n, f, NULL, 0); }   // no connected sockets: DestAddrRequired on a virtual one
+long mpsk_recvfrom(int s, void *b, unsigned long n, int f, void *from, unsigned *fl) { return mpsk_is(s) ? mpsk_ret(coop_vnet_recvfrom(dm_coop(), s, b, n, f, from, fl)) : sk_fail(); }
+long mpsk_recv(int s, void *b, unsigned long n, int f) { return mpsk_recvfrom(s, b, n, f, NULL, NULL); }
 #define SKF(m, cname, ...) HLE_FORCE(m, "bsd socket service (cut): returns -1/ENETDOWN", int, cname, __VA_ARGS__)
 // Poll / Select with nothing to wait on: the host creates no socket, so a game's descriptors are all -1, or it passes none. POSIX and Horizon's bsd service ignore negative
 // descriptors and wait out the timeout, returning 0. Failing at once made Dark Souls Remastered's network thread ("NexusRevolution Socket", main+0x92c7c4) spin a core at 100%
@@ -109,6 +134,17 @@ static int efd_ready(sk_pollfd *p, uint64_t n) {   // with g_efd_m held: fills r
 // waited out, 0. Failing with ENETDOWN here made the loop abort
 int dm_sk_poll(void *fds, uint64_t n, int ms) {   // also hle_offline.c's plain pollfd form
     sk_pollfd *p = fds;
+    // A Link Play poll set contains virtual UDP sockets. Keep the newer
+    // upstream EventFd poll implementation for all other descriptors.
+    int virtual_count = 0, other_count = 0;
+    for (uint64_t i = 0; i < n; ++i) if (p[i].fd >= 0) {
+        if (mpsk_is(p[i].fd)) virtual_count++;
+        else other_count++;
+    }
+    if (virtual_count) {
+        if (other_count) { LOG("[coop] Poll mixed virtual sockets and other descriptors is unsupported"); return sk_fail(); }
+        return (int)mpsk_ret(coop_vnet_poll(dm_coop(), (coop_pollfd *)fds, n, ms));
+    }
     int any = 0;
     pthread_mutex_lock(&g_efd_m);
     for (uint64_t i = 0; i < n; i++) if (p[i].fd >= 0) {
@@ -133,20 +169,23 @@ int dm_sk_poll(void *fds, uint64_t n, int ms) {   // also hle_offline.c's plain
 }
 int dm_sk_select(int nfds, const uint64_t *r, const uint64_t *w, const uint64_t *e, const int64_t *tv) {   // fd_set: 1024 bits; timeval: {i64 seconds, i64 microseconds}
     const uint64_t *sets[3] = {r, w, e};
-    for (int k = 0; k < 3; k++) for (int fd = 0; sets[k] && fd < nfds && fd < 1024; fd++) if (sets[k][fd >> 6] >> (fd & 63) & 1) return sk_fail();
-    return sk_idle(tv ? tv[0] * 1000 + tv[1] / 1000 : -1);
+    int virt = 0;
+    for (int k = 0; k < 3; k++) for (int fd = 0; sets[k] && fd < nfds && fd < 1024; fd++) if (sets[k][fd >> 6] >> (fd & 63) & 1) { if (!mpsk_is(fd)) return sk_fail(); virt = 1; }
+    int64_t ms = tv ? tv[0] * 1000 + tv[1] / 1000 : -1;
+    if (virt) return (int)mpsk_ret(coop_vnet_select(dm_coop(), nfds, (uint64_t *)r, (uint64_t *)w, (uint64_t *)e, ms > 0x7fffffff ? 0x7fffffff : (int)ms));
+    return sk_idle(ms);
 }
