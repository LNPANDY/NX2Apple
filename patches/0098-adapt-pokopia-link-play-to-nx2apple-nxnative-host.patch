@@ -0,0 +1,22 @@
+# Pokopia's patches for nxnative's rewriter (dm/tools/patch_nso.py reads the patches.py of every profile in DM_GAMES_DIR; the formats are its own).
+# OBS: observation gates, which change no instruction: the rewriter moves the instruction into a stub that first calls the host.
+
+# Link Play's "Interact everywhere" (hle_coop_interact.c, the launcher's switch DM_COOP_INTERACT, windows-native docs/coop-interact.md) and Story co-op
+# (DM_COOP_STORY, windows-native docs/story-coop.md). Gate number 27 is OBS_COOP_INTERACT (dm.h, from the co-op patch); the site's id is in its upper bits
+# (COOP_SITE_MASK = 1, COOP_SITE_TALK = 2). The callback does nothing while the switch is off
+OBS_COOP_INTERACT, COOP_SITE_MASK, COOP_SITE_TALK = 27, 1, 2
+OBS = {
+    '76a489f3bd3642fa5e18bd83d32c98ba': [   # 2.0.1 main
+        (0xb1030, OBS_COOP_INTERACT | COOP_SITE_MASK << 8, 'f2c0002d', 'Interact everywhere: the permissions a story area gives online players'),
+        (0x4c06d8, OBS_COOP_INTERACT | COOP_SITE_TALK << 8, '2a000328', 'Story co-op: a visitor talks to NPCs as the host does'),
+    ],
+}
+
+# Both observation gates target instructions in Pokopia 2.0.1's own main.
+# Their offsets and expected opcodes require verification against each subsequent build.
+BINDING = [
+    {'what': 'Pokopia story-area online interaction mask', 'now': 'build', 'goal': 'game', 'purpose': 'runtime',
+     'why': 'the permission-mask instruction is in Pokopia game code at a fixed offset and must be reviewed for each update'},
+    {'what': 'Pokopia visitor NPC talk permission', 'now': 'build', 'goal': 'game', 'purpose': 'runtime',
+     'why': 'the visitor dialogue decision is in Pokopia game code at a fixed offset and must be reviewed for each update'},
+]
diff --git a/dm/host/dm.h b/dm/host/dm.h
index 985a305..c262808 100644
--- a/dm/host/dm.h
+++ b/dm/host/dm.h
@@ -112,7 +112,8 @@ enum { OBS_UE_MALLOC = 21,                                       // Unreal's FMa
        OBS_REGION_ASK = 22, OBS_REGION_GOT = 23, OBS_REGION_FREE = 24,   // the SDK's address regions, gates the rewriter places by symbol in every sdk (patch_nso.py "Address regions", hle_svc.c)
        OBS_STDALLOC_INIT = 25,                                         // StandardAllocator::Initialize's entry, the same way: its callback writes the size (hle_svc.c)
        OBS_UE_REGION = 26,                                             // the store of Unreal's engine region size before nninitStartup reserves it: the register its upper bits name (dm/tools/ue_region.py, hle_svc.c)
-       OBS_MAX = 27 };
+       OBS_COOP_INTERACT = 27,                                         // Link Play's "Interact everywhere" (hle_coop_interact.c): a site of the profile's, its id in the upper bits
+       OBS_MAX = 28 };
 // A gate number's bits from 8 up are a parameter for its callback (OBS_REGION_GOT: the register that holds the address). Callbacks read the registers; a write to x0–x29 takes
 // effect when the gate returns (entry.S restores them from the frame), which OBS_STDALLOC_INIT and OBS_UE_REGION do
 void gate_obs_set(int id, void (*fn)(uint64_t *regs, int param));
