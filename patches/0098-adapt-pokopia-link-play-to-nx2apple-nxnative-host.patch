diff --git a/dm/tools/tests/test_link_play_pack.py b/dm/tools/tests/test_link_play_pack.py
new file mode 100644
index 0000000..0ed2984
--- /dev/null
+++ b/dm/tools/tests/test_link_play_pack.py
@@ -0,0 +1,49 @@
+# Link Play entitlement comes from the game profile, not a title-ID special case.
+from pathlib import Path
+from types import SimpleNamespace
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'mac'))
+import pack_app
+
+
+class LinkPlayBundleMetadata(unittest.TestCase):
+    def plist(self, profile, title_id='0100000000000000'):
+        a = SimpleNamespace(name='Synthetic', title_id=title_id, bundle_id=None,
+                            version='1.0', category=None, marker=None, lang=None,
+                            settings=None, tables=str(profile))
+        return pack_app.info_plist(a, '26.6', None)
+
+    def test_unmarked_profile_never_enables_link_play(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            profile = Path(tmp)
+            (profile / 'game.tsv').write_text('title_id\t0400A3A01EE4C000\n')
+            info = self.plist(profile, '0400A3A01EE4C000')
+            self.assertNotIn('DMLinkPlay', info)
+            self.assertNotIn('NSBonjourServices', info)
+            self.assertNotIn('NSLocalNetworkUsageDescription', info)
+
+    def test_capability_and_bonjour_service_follow_profile(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            profile = Path(tmp)
+            (profile / 'game.tsv').write_text(
+                'title_id\t0100000000000000\nlink_play\tldn\n'
+                'link_play_bonjour\t_synthetic-ldn._udp\n')
+            info = self.plist(profile)
+            self.assertEqual(info['DMLinkPlay'], 1)
+            self.assertEqual(info['NSBonjourServices'], ['_synthetic-ldn._udp'])
+            self.assertIn('NSLocalNetworkUsageDescription', info)
+
+    def test_without_bonjour_declaration_still_supports_manual_join(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            profile = Path(tmp)
+            (profile / 'game.tsv').write_text('link_play\tldn\n')
+            info = self.plist(profile)
+            self.assertEqual(info['DMLinkPlay'], 1)
+            self.assertNotIn('NSBonjourServices', info)
+
+
+if __name__ == '__main__':
+    unittest.main()
