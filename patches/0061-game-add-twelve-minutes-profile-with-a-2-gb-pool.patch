+# Twelve Minutes, SDK 12.3.7, Unity 2019.4.31f1 IL2CPP with FMOD (README.md)
+
+# ---- Identity ----
+title_id	0100CD701434C000
+program_id	0100CD701434C000
+
+# ---- App ----
+name	Twelve Minutes
+ipa	TwelveMinutes.ipa
+app_category	public.app-category.games
+
+# ---- Versions ----
+build	v0	1.0.1	main=e93717eabaa393489060fcbf8f086ca3	subsdk0=bffed55ea46c1b48ddeabcacdfbf81bf	sdk=56ec24747ec9e7f19b3efb062483a19d
+package	v0
+shader_versions	v0
+
+# ---- Files ----
+# every module main imports from
+modules	main subsdk0 sdk
+romfs_marker	Data/resources.assets
+zip_store	.assets:.bank:.dat:.resource:.ress:.metallib
+
+# ---- Memory ----
+# virtual address memory: nninitStartup hands app_pool - used to StandardAllocator. The Switch's 3285 MB pool made a 3.14 GB region and the
+# iPhone's 4.38 GB alias region ran out at the end of the first load; a 2 GB pool keeps the regions under +3.51 GB (README.md, Memory)
+mem_reserve	0x140000000
+mem_alias	0x118000000
+mem_stack	0x10000000
+app_pool	0x80000000
+# the NPDM declares 16 MB of system resource
+sys_resource	0x1000000
+
+# ---- Shader split ----
+shader_groups	/Data/=data
+shader_note	Twelve Minutes shaders
+
+# ---- Heap check on the Mac ----
+# the game calls nvnDeviceSetDepthMode with near = 0 in the check boot: the pipeline bases made before it runs are made for that mode
+depth_mode	zero
