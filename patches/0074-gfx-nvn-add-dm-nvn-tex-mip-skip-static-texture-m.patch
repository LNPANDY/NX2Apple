+// Exercise DM_NVN_TEX_MIP_SKIP=0|1|2 on the production Metal upload, registered-view,
+// CPU BC decode, harden-on-copy, and teardown paths.
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+
+static int checks, failed;
+#define CHECK(label, c) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s\n", label); } } while (0)
+
+static void finish(void) {
+    CHECK("submission completes", mtl_wait(mtl_sub_commit(), 5000000000ull));
+    CHECK("submission has no GPU error", !mtl_last_commit_error());
+}
+
+static void set_mode(const char *val) {
+    if (val) setenv("DM_NVN_TEX_MIP_SKIP", val, 1);
+    else unsetenv("DM_NVN_TEX_MIP_SKIP");
+    nvn_mip_skip_reset_env();
+}
+
+static void policy_tests(void) {
+    CHECK("parse empty/0", nvn_mip_skip_parse(NULL) == 0 && nvn_mip_skip_parse("") == 0 && nvn_mip_skip_parse("0") == 0);
+    CHECK("parse negative/text", nvn_mip_skip_parse("-1") == 0 && nvn_mip_skip_parse("abc") == 0);
+    CHECK("parse 1/2/clamp", nvn_mip_skip_parse("1") == 1 && nvn_mip_skip_parse("2") == 2 && nvn_mip_skip_parse("9") == 2);
+
+    nvn_mip_skip_desc base = {
+        .width = 512, .height = 512, .levels = 10, .samples = 1,
+        .block_w = 4, .block_h = 4,
+        .has_layout = 1, .has_mem = 1, .is_2d = 1, .sparse_pool = 0, .linear = 0,
+    };
+    CHECK("mode 0 skips 0", nvn_mip_skip_calc(&base, 0) == 0);
+    CHECK("512x512 BC4x4 mode 1 skips 1", nvn_mip_skip_calc(&base, 1) == 1);
+    CHECK("512x512 BC4x4 mode 2 skips 2", nvn_mip_skip_calc(&base, 2) == 2);
+
+    nvn_mip_skip_desc rect = base;
+    rect.width = 512; rect.height = 256; rect.levels = 9;
+    CHECK("512x256 mode 1 skips 1 (256x128)", nvn_mip_skip_calc(&rect, 1) == 1);
+    CHECK("512x256 mode 2 falls back to 1 (avoid 64px short edge)", nvn_mip_skip_calc(&rect, 2) == 1);
+
+    nvn_mip_skip_desc few = base;
+    few.levels = 3;
+    CHECK("3 levels mode 1 skips 1 (2 left)", nvn_mip_skip_calc(&few, 1) == 1);
+    CHECK("3 levels mode 2 falls back to 1 (2 left)", nvn_mip_skip_calc(&few, 2) == 1);
+    few.levels = 2;
+    CHECK("2 levels exempt", nvn_mip_skip_calc(&few, 1) == 0);
+
+    nvn_mip_skip_desc uncomp = base;
+    uncomp.block_w = 1; uncomp.block_h = 1;
+    CHECK("uncompressed UI/RT exempt", nvn_mip_skip_calc(&uncomp, 2) == 0);
+
+    nvn_mip_skip_desc small = base;
+    small.width = 256; small.height = 256;
+    CHECK("256x256 exempt", nvn_mip_skip_calc(&small, 2) == 0);
+
+    nvn_mip_skip_desc sparse = base;
+    sparse.sparse_pool = 1;
+    CHECK("sparse pool exempt", nvn_mip_skip_calc(&sparse, 2) == 0);
+
+    nvn_mip_skip_desc lin = base;
+    lin.linear = 1;
+    CHECK("linear exempt", nvn_mip_skip_calc(&lin, 2) == 0);
+
+    nvn_mip_skip_desc non2d = base;
+    non2d.is_2d = 0;
+    CHECK("non-2D exempt", nvn_mip_skip_calc(&non2d, 2) == 0);
+
+    nvn_mip_skip_desc astc8 = base;
+    astc8.block_w = 8; astc8.block_h = 8;
+    astc8.width = 516; astc8.height = 516;
+    CHECK("misaligned ASTC 8x8 falls back to 0", nvn_mip_skip_calc(&astc8, 2) == 0);
+    astc8.width = 512; astc8.height = 512;
+    CHECK("aligned ASTC 8x8 mode 2 skips 2", nvn_mip_skip_calc(&astc8, 2) == 2);
+}
+
+static void fill_bc1_levels(const tex_t *t, void *mem, size_t poolsize) {
+    dm_guest_write_prepare(mem, poolsize);
+    for (unsigned l = 0; l < t->d.levels; l++) {
+        unsigned w = MAX(t->d.width >> l, 1u), h = MAX(t->d.height >> l, 1u);
+        unsigned bw = (w + 3u) / 4u, bh = (h + 3u) / 4u, nb = bw * bh;
+        uint8_t *blocks = calloc(nb, 8);
+        if (!blocks) abort();
+        for (unsigned i = 0; i < nb; i++) {
+            uint8_t *b = blocks + (size_t)i * 8;
+            // Distinct uniform RGB565 colour and tag byte per mip level so readback proves which level was uploaded.
+            b[0] = (uint8_t)(0x10u + l * 0x11u);
+            b[1] = (uint8_t)(0x20u + l * 0x09u);
+            b[2] = b[0];
+            b[3] = b[1];
+            b[4] = b[5] = b[6] = b[7] = 0;
+        }
+        CHECK("BC1 swizzle succeeds", !nvn_swizzle(&t->d, l, 0, blocks, (size_t)bw * 8u, t->mem));
+        free(blocks);
+    }
+}
+
+static void readback_block0(id<MTLTexture> tex, unsigned level, uint8_t out[8]) {
+    id<MTLBuffer> buf = [g_dev newBufferWithLength:256 options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> cb = q_cb();
+    id<MTLBlitCommandEncoder> enc = [cb blitCommandEncoder];
+    [enc copyFromTexture:tex sourceSlice:0 sourceLevel:level sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(4, 4, 1)
+                toBuffer:buf destinationOffset:0 destinationBytesPerRow:8 destinationBytesPerImage:8];
+    [enc endEncoding];
+    [cb commit];
+    [cb waitUntilCompleted];
+    CHECK("block readback completes", cb.status == MTLCommandBufferStatusCompleted);
+    memcpy(out, buf.contents, 8);
+}
+
+static void upload_views_and_harden(unsigned mode, int force_bc_cpu) {
+    nvn_mip_skip_teardown();
+    char mbuf[8];
+    snprintf(mbuf, sizeof mbuf, "%u", mode);
+    set_mode(mbuf);
+    g_bc_cpu = force_bc_cpu;
+
+    static uint64_t serial = 950000;
+    tex_t t = {.magic = MAGIC('T', 'E', 'X', 0), .serial = serial++, .has_layout = 1};
+    t.d = (nvn_texdesc){.target = NVN_TEXTURE_TARGET_2D, .format = 0x41, .width = 512, .height = 512, .depth = 1, .levels = 10, .samples = 1};
+    nvn_tex_layout(&t.d, &t.L);
+    size_t poolsize = (t.L.size + 4096 + (size_t)getpagesize() - 1) & ~((size_t)getpagesize() - 1);
+    void *mem = NULL;
+    if (posix_memalign(&mem, (size_t)getpagesize(), poolsize)) abort();
+    memset(mem, 0, poolsize);
+    pool_t pool = {.magic = MAGIC('P', 'O', 'O', 'L'), .mem = mem, .size = poolsize,
+                   .flags = NVN_MEMORY_POOL_FLAGS_CPU_UNCACHED | NVN_MEMORY_POOL_FLAGS_GPU_CACHED};
+    t.pool = &pool;
+    t.mem = (uint8_t *)mem + 4096;
+    mtl_pool_add(mem, poolsize);
+    nvn_dirty_add_range(mem, poolsize);
+    fill_bc1_levels(&t, mem, poolsize);
+
+    mtl_sub_begin();
+    id<MTLTexture> mt = tex_mtl(&t);
+    CHECK("uploaded texture exists", mt != nil);
+    finish();
+
+    unsigned expect_w = 512u >> mode;
+    unsigned expect_levels = 10u - mode;
+    CHECK("uploaded width matches skip mode", mt && mt.width == expect_w && mt.height == expect_w);
+    CHECK("uploaded mip count matches skip mode", mt && mt.mipmapLevelCount == expect_levels);
+    CHECK("tex_level_shift matches skip mode", mt && tex_level_shift(&t, mt) == mode);
+
+    uint64_t s_up = 0, s_hard = 0, s_saved = 0;
+    nvn_mip_skip_stats(&s_up, &s_hard, &s_saved);
+    if (mode > 0) {
+        CHECK("stats recorded skipped upload", s_up == 1 && s_hard == 0 && s_saved > 0);
+    } else {
+        CHECK("stats zero when mode 0", s_up == 0 && s_hard == 0 && s_saved == 0);
+    }
+
+    if (!force_bc_cpu && mt) {
+        uint8_t b0[8] = {0};
+        readback_block0(mt, 0, b0);
+        CHECK("level 0 holds guest level <mode> compressed block",
+              b0[0] == (uint8_t)(0x10u + mode * 0x11u) && b0[1] == (uint8_t)(0x20u + mode * 0x09u));
+    }
+
+    // Registered views over skipped textures clamp fine levels and shift coarser ones.
+    int tid0 = 400 + (int)mode * 10 + force_bc_cpu * 3;
+    view_t v0 = {.set_levels = 1, .base_level = 0, .nlevels = 1};
+    mtl_reg_tex(tid0, &t, &v0);
+    view_t v1 = {.set_levels = 1, .base_level = 0, .nlevels = 10};
+    mtl_reg_tex(tid0 + 1, &t, &v1);
+    view_t v2 = {.set_levels = 1, .base_level = 3, .nlevels = 4};
+    mtl_reg_tex(tid0 + 2, &t, &v2);
+    os_unfair_lock_lock(&g_rmu);
+    id<MTLTexture> rv0 = tex_by_id(tid0);
+    id<MTLTexture> rv1 = tex_by_id(tid0 + 1);
+    id<MTLTexture> rv2 = tex_by_id(tid0 + 2);
+    CHECK("view [0,1) clamps to finest resident level", rv0 && rv0.width == expect_w && rv0.mipmapLevelCount == 1);
+    CHECK("view [0,10) spans all resident levels", rv1 && rv1.width == expect_w && rv1.mipmapLevelCount == expect_levels);
+    CHECK("view [3,7) lands on 64x64 with 4 levels", rv2 && rv2.width == 64 && rv2.mipmapLevelCount == 4);
+    os_unfair_lock_unlock(&g_rmu);
+
+    // Accessing through tex_mtl_all (copy_b2t / copy_t2t / copy_t2b / clear_tex) hardens to full 512x512.
+    if (mode > 0) {
+        mtl_sub_begin();
+        id<MTLTexture> full = tex_mtl_all(&t);
+        CHECK("tex_mtl_all hardens back to full 512x512", full && full.width == 512 && full.height == 512 && full.mipmapLevelCount == 10);
+        CHECK("hardened texture has zero level shift", full && tex_level_shift(&t, full) == 0);
+        finish();
+        if (!force_bc_cpu && full) {
+            uint8_t bfull[8] = {0};
+            readback_block0(full, 0, bfull);
+            CHECK("hardened level 0 holds guest level 0 block", bfull[0] == 0x10u && bfull[1] == 0x20u);
+        }
+        os_unfair_lock_lock(&g_rmu);
+        id<MTLTexture> rv0_after = tex_by_id(tid0);
+        CHECK("cached texture ID refreshes to full size after harden", rv0_after && rv0_after.width == 512 && rv0_after.mipmapLevelCount == 1);
+        os_unfair_lock_unlock(&g_rmu);
+
+        nvn_mip_skip_stats(&s_up, &s_hard, &s_saved);
+        CHECK("harden counter incremented", s_hard == 1);
+        CHECK("storage address stays hardened", nvn_mip_skip_is_hardened((uint64_t)(uintptr_t)t.mem) == 1);
+
+        // A new serial over the same hardened storage stays full size.
+        tex_t t2 = t;
+        t2.serial = serial++;
+        mtl_sub_begin();
+        id<MTLTexture> mt2 = tex_mtl(&t2);
+        CHECK("new serial on hardened storage stays full 512x512", mt2 && mt2.width == 512 && mt2.mipmapLevelCount == 10);
+        finish();
+        mtl_tex_release(&t2);
+    }
+
+    mtl_tex_release(&t);
+    mtl_drain();
+    mtl_alias_drop_pool(&pool);
+    nvn_dirty_remove_range(mem);
+    mtl_pool_del(mem);
+    mtl_drain();
+    free(mem);
+    g_bc_cpu = 0;
+}
+
+static void cpu_written_without_layout(void) {
+    // Games that upload compressed textures through a CPU-visible pool without setting a packaged layout
+    // (tex_cpu_content -> mtl_tex_cpu_written) must also participate in mip-skipping.
+    nvn_mip_skip_teardown();
+    set_mode("1");
+    g_bc_cpu = 0;
+
+    static uint64_t serial = 960000;
+    tex_t t = {.magic = MAGIC('T', 'E', 'X', 0), .serial = serial++, .has_layout = 0};
+    t.d = (nvn_texdesc){.target = NVN_TEXTURE_TARGET_2D, .format = 0x41, .width = 512, .height = 512, .depth = 1, .levels = 10, .samples = 1};
+    nvn_tex_layout(&t.d, &t.L);
+    size_t poolsize = (t.L.size + 4096 + (size_t)getpagesize() - 1) & ~((size_t)getpagesize() - 1);
+    void *mem = NULL;
+    if (posix_memalign(&mem, (size_t)getpagesize(), poolsize)) abort();
+    memset(mem, 0, poolsize);
+    pool_t pool = {.magic = MAGIC('P', 'O', 'O', 'L'), .mem = mem, .size = poolsize,
+                   .flags = NVN_MEMORY_POOL_FLAGS_CPU_UNCACHED | NVN_MEMORY_POOL_FLAGS_GPU_CACHED};
+    t.pool = &pool;
+    t.mem = (uint8_t *)mem + 4096;
+    mtl_pool_add(mem, poolsize);
+    nvn_dirty_add_range(mem, poolsize);
+    fill_bc1_levels(&t, mem, poolsize);
+
+    mtl_sub_begin();
+    id<MTLTexture> mt = tex_mtl(&t);
+    CHECK("cpu-written compressed texture skips top mip", mt && mt.width == 256 && mt.height == 256 && mt.mipmapLevelCount == 9);
+    CHECK("cpu-written compressed texture has level shift 1", mt && tex_level_shift(&t, mt) == 1);
+    finish();
+
+    mtl_tex_release(&t);
+    mtl_drain();
+    mtl_alias_drop_pool(&pool);
+    nvn_dirty_remove_range(mem);
+    mtl_pool_del(mem);
+    mtl_drain();
+    free(mem);
+}
+
+int main(void) { @autoreleasepool {
+    mtl_init();
+    policy_tests();
+    upload_views_and_harden(0, 0);
+    upload_views_and_harden(1, 0);
+    upload_views_and_harden(2, 0);
+    upload_views_and_harden(1, 1);   // CPU BC decode path (iOS without hardware BC)
+    cpu_written_without_layout();
+    nvn_mip_skip_teardown();
+    uint64_t s_up = 9, s_hard = 9, s_saved = 9;
+    nvn_mip_skip_stats(&s_up, &s_hard, &s_saved);
+    CHECK("teardown clears counters", s_up == 0 && s_hard == 0 && s_saved == 0);
+    CHECK("teardown clears hardened set", g_nvn_mip_skip_hardened.count == 0 && g_nvn_mip_skip_hardened.keys == NULL);
+    printf("mip-skip: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+} }
