+bool dm_menu_scan_get(int index, DmMenuScanHit *out) {
+    if (!out) return false;
+    dm_scan_hit_t hit;
+    if (dm_cheat_scan_get(index, &hit) != 0) return false;
+    out->region = hit.region;
+    out->type = hit.type;
