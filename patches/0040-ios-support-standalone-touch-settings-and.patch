+enum ScanValueCodec {
+    static func encode(_ rawText: String, type: ScanValueType) -> UInt64? {
+        let trimmed = rawText.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty else { return nil }
+        if type == .f32 {
+            let normalized = trimmed.replacingOccurrences(of: ",", with: ".")
+            guard let f = Float(normalized), f.isFinite else { return nil }
+            return UInt64(f.bitPattern)
+        }
+        let lower = trimmed.lowercased()
+        let parsed: UInt64?
+        if lower.hasPrefix("0x") {
+            let digits = String(lower.dropFirst(2))
+            guard !digits.isEmpty, let v = UInt64(digits, radix: 16) else { return nil }
+            parsed = v
+        } else if lower.hasPrefix("-0x") {
+            return nil
+        } else if lower.hasPrefix("-") {
+            guard let signed = Int64(trimmed) else { return nil }
+            switch type {
+            case .u8:
+                guard signed >= Int64(Int8.min) else { return nil }
+                parsed = UInt64(UInt8(bitPattern: Int8(signed)))
+            case .u16:
+                guard signed >= Int64(Int16.min) else { return nil }
+                parsed = UInt64(UInt16(bitPattern: Int16(signed)))
+            case .u32:
+                guard signed >= Int64(Int32.min) else { return nil }
+                parsed = UInt64(UInt32(bitPattern: Int32(signed)))
+            case .u64:
+                parsed = UInt64(bitPattern: signed)
+            case .f32:
+                return nil
+            }
+            return parsed
+        } else {
+            parsed = UInt64(trimmed)
+        }
+        guard let value = parsed else { return nil }
+        switch type {
+        case .u8: return value <= UInt64(UInt8.max) ? value : nil
+        case .u16: return value <= UInt64(UInt16.max) ? value : nil
+        case .u32: return value <= UInt64(UInt32.max) ? value : nil
+        case .u64: return value
+        case .f32: return nil
+        }
+    }
+
+    static func decode(_ rawBits: UInt64, type: ScanValueType) -> String {
+        switch type {
+        case .u8: return String(UInt8(truncatingIfNeeded: rawBits))
+        case .u16: return String(UInt16(truncatingIfNeeded: rawBits))
+        case .u32: return String(UInt32(truncatingIfNeeded: rawBits))
+        case .u64: return String(rawBits)
+        case .f32:
+            let f = Float(bitPattern: UInt32(truncatingIfNeeded: rawBits))
+            guard f.isFinite else { return "0" }
+            if f.rounded() == f, abs(f) < 1e7 {
+                return String(format: "%.1f", f)
+            }
+            return String(format: "%.4g", f)
+        }
+    }
+
+    static func formatAddress(region: UInt8, offset: UInt64) -> String {
+        let prefix: String
+        switch region {
+        case 0: prefix = "main"
+        case 1: prefix = "heap"
+        default: prefix = "mem"
+        }
+        return String(format: "%@+0x%llX", prefix, offset)
+    }
+}
