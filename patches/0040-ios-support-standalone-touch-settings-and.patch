+void dm_menu_present_view_controller(void *view_controller) {
+    if (!view_controller) return;
+    UIViewController *panel = (__bridge UIViewController *)view_controller;
+    UIViewController *host = g_root;
+    if (!host) {
+        for (UIScene *s in UIApplication.sharedApplication.connectedScenes) {
+            if ([s isKindOfClass:UIWindowScene.class] && [s.session.role isEqualToString:UIWindowSceneSessionRoleApplication]) {
+                for (UIWindow *w in ((UIWindowScene *)s).windows) {
+                    if (w.isKeyWindow || !host) host = w.rootViewController;
+                }
+            }
+        }
+    }
+    while (host.presentedViewController && !host.presentedViewController.isBeingDismissed) {
+        if (host.presentedViewController == panel) return;
+        host = host.presentedViewController;
+    }
+    if (!host || panel.presentingViewController) return;
+    [host presentViewController:panel animated:YES completion:nil];
+}
