+    func testScannerGenerationPreventsStaleBackgroundOverwrite() {
+        let backend = MockScannerBackend()
+        let started = expectation(description: "background scan started")
+        let release = DispatchSemaphore(value: 0)
+        backend.hits = [ScanHitItem(region: 1, type: .u32, offset: 0x200, valueRaw: 777)]
+        backend.startHandler = { _, _ in
+            started.fulfill()
+            release.wait()
+            return (1, 1)
+        }
+
+        let session = CheatScannerSession(backend: backend, installNotifications: false)
+        let done = expectation(description: "scan callback finished")
+        session.startInitialScan(rawText: "777") {
+            done.fulfill()
+        }
+        wait(for: [started], timeout: 2)
+        XCTAssertTrue(session.isSearching)
+
+        // Reset before background scan returns -> increments generation
+        session.reset()
+        XCTAssertFalse(session.isSearching)
+        XCTAssertFalse(session.hasActiveScan)
+        XCTAssertEqual(backend.resetCalls, 1)
+
+        release.signal()
+        wait(for: [done], timeout: 2)
+
+        // Stale scan result must NOT repopulate session
+        XCTAssertFalse(session.hasActiveScan)
+        XCTAssertTrue(session.hits.isEmpty)
