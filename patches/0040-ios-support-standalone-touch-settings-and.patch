+    private func makeStub(name: String, section: String, why: String, kind: Int32, flags: Int32, on: Int32, baked: Int32) -> DuoHarnessCheatStub {
+        var stub = DuoHarnessCheatStub()
+        copyCString(name, into: &stub.name)
+        copyCString(section, into: &stub.section)
+        copyCString(why, into: &stub.why)
+        stub.kind = kind
+        stub.flags = flags
+        stub.on = on
+        stub.baked_kind = baked
+        return stub
+    }
+
+    private func copyCString<T>(_ string: String, into tuple: inout T) {
+        withUnsafeMutableBytes(of: &tuple) { buf in
+            buf.initializeMemory(as: UInt8.self, repeating: 0)
+            let utf8 = Array(string.utf8)
+            let count = min(utf8.count, buf.count - 1)
+            for i in 0..<count { buf[i] = utf8[i] }
+        }
     }
