+    private func configureCompactPill(_ button: UIButton, title: String, filled: Bool) {
+        var cfg = filled ? UIButton.Configuration.filled() : UIButton.Configuration.tinted()
+        cfg.title = title
+        cfg.cornerStyle = .capsule
+        cfg.contentInsets = NSDirectionalEdgeInsets(top: 6, leading: 12, bottom: 6, trailing: 12)
+        if filled {
+            cfg.baseBackgroundColor = UIColor(red: 0.96, green: 0.93, blue: 0.86, alpha: 1)
+            cfg.baseForegroundColor = UIColor(white: 0.08, alpha: 1)
+        } else {
+            cfg.baseBackgroundColor = UIColor(white: 1, alpha: 0.14)
+            cfg.baseForegroundColor = .white
+        }
+        cfg.titleTextAttributesTransformer = UIConfigurationTextAttributesTransformer { incoming in
+            var out = incoming
+            out.font = UIFont.systemFont(ofSize: 12, weight: .semibold)
+            return out
+        }
+        button.configuration = cfg
+    }
+
+    func syncUI() {
+        guard isViewLoaded else { return }
+        text = CheatsMenuTextPayload.current()
+        titleLabel.text = text.tScannerTitle
+        if session.hasActiveScan {
+            let hitsText = CheatsMenuTextPayload.format(text.tHitsSummary, String(session.totalHits))
+            badgeLabel.text = "  \(session.selectedType.shortLabel) · \(hitsText)  "
+            badgeLabel.isHidden = false
+        } else {
+            badgeLabel.text = "  \(session.selectedType.shortLabel)  "
+            badgeLabel.isHidden = false
+        }
+
+        if let idx = ScanValueType.allCases.firstIndex(of: session.selectedType) {
+            typeSegment.selectedSegmentIndex = idx
+        }
+        typeSegment.isEnabled = !session.hasActiveScan && !session.isSearching
+        if valueField.text != session.valueInput {
+            valueField.text = session.valueInput
+        }
+        valueField.isEnabled = !session.isSearching
+        primaryScanButton.isEnabled = !session.isSearching
+        var pCfg = primaryScanButton.configuration
+        pCfg?.title = session.hasActiveScan ? text.tEqualsButton : text.tFirstScanButton
+        primaryScanButton.configuration = pCfg
+
+        refineRow.isHidden = !session.hasActiveScan
+        for (_, btn) in refineButtons {
+            btn.isEnabled = session.hasActiveScan && !session.isSearching
+        }
+        resetButton.isHidden = !session.hasActiveScan
+        resetButton.isEnabled = !session.isSearching
+
+        if session.isSearching {
+            spinner.startAnimating()
+        } else {
+            spinner.stopAnimating()
+        }
+
+        if let msg = session.statusMessage, !msg.isEmpty {
+            statusLabel.text = msg
+            statusLabel.textColor = session.statusIsError
+                ? UIColor(red: 1.0, green: 0.45, blue: 0.42, alpha: 1)
+                : UIColor(red: 0.62, green: 0.92, blue: 0.68, alpha: 1)
+            statusLabel.isHidden = false
+        } else {
+            statusLabel.text = nil
+            statusLabel.isHidden = true
+        }
+
+        if session.hits.isEmpty {
+            emptyLabel.isHidden = false
+            emptyLabel.text = session.hasActiveScan ? text.tNoMatches : text.tEmptyPrompt
+        } else {
+            emptyLabel.isHidden = true
+        }
+
+        if session.totalHits > UInt64(session.hits.count), !session.hits.isEmpty {
+            footerLabel.text = CheatsMenuTextPayload.format(text.tHitsCappedNotice, String(session.hits.count), String(session.totalHits))
+            footerLabel.frame = CGRect(x: 0, y: 0, width: tableView.bounds.width, height: 34)
+            tableView.tableFooterView = footerLabel
+        } else {
+            tableView.tableFooterView = nil
+        }
+
+        tableView.reloadData()
+    }
+
+    @objc private func handleBackdropTap() {
+        view.endEditing(true)
+        session.hidePanel()
+    }
+
+    @objc private func onHide() {
+        view.endEditing(true)
+        session.hidePanel()
+    }
+
+    @objc private func onReset() {
+        view.endEditing(true)
+        session.reset()
+    }
+
+    @objc private func onTypeChanged() {
+        let idx = typeSegment.selectedSegmentIndex
+        guard idx >= 0 && idx < ScanValueType.allCases.count else { return }
+        session.setType(ScanValueType.allCases[idx])
+    }
+
+    @objc private func onValueChanged() {
+        session.valueInput = valueField.text ?? ""
+    }
+
+    @objc private func onPrimaryScan() {
+        view.endEditing(true)
+        let input = valueField.text ?? ""
+        if session.hasActiveScan {
+            session.refineScan(mode: .eq, rawText: input, text: text)
+        } else {
+            session.startInitialScan(rawText: input, text: text)
+        }
+    }
+
+    @objc private func onRefineMode(_ sender: UIButton) {
+        view.endEditing(true)
+        guard let mode = ScanCompareMode(rawValue: Int32(sender.tag)) else { return }
+        session.refineScan(mode: mode, rawText: valueField.text ?? "", text: text)
+    }
+
+    func textFieldShouldReturn(_ textField: UITextField) -> Bool {
+        onPrimaryScan()
+        return true
+    }
+
+    // MARK: - UITableViewDataSource & Delegate
+
+    func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        session.hits.count
+    }
+
+    func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = tableView.dequeueReusableCell(withIdentifier: "HitCell", for: indexPath)
+        cell.backgroundColor = .clear
+        cell.selectionStyle = .none
+        let hit = session.hits[indexPath.row]
+
+        var content = UIListContentConfiguration.subtitleCell()
+        content.text = hit.addressText
+        content.textProperties.font = .monospacedSystemFont(ofSize: 13, weight: .semibold)
+        content.textProperties.color = .white
+        content.secondaryText = hit.valueText
+        content.secondaryTextProperties.font = .monospacedDigitSystemFont(ofSize: 12, weight: .medium)
+        content.secondaryTextProperties.color = UIColor(red: 0.96, green: 0.93, blue: 0.86, alpha: 0.85)
+        cell.contentConfiguration = content
+
+        let modBtn = UIButton(type: .system)
+        configureCompactPill(modBtn, title: text.tModifyAction, filled: false)
+        modBtn.tag = indexPath.row
+        modBtn.addTarget(self, action: #selector(onModifyHit(_:)), for: .touchUpInside)
+
+        let saveBtn = UIButton(type: .system)
+        configureCompactPill(saveBtn, title: text.tSaveAction, filled: true)
+        saveBtn.tag = indexPath.row
+        saveBtn.isEnabled = session.canSaveCheat()
+        saveBtn.addTarget(self, action: #selector(onSaveHit(_:)), for: .touchUpInside)
+
+        let accessory = UIStackView(arrangedSubviews: [modBtn, saveBtn])
+        accessory.axis = .horizontal
+        accessory.spacing = 6
+        let size = accessory.systemLayoutSizeFitting(UIView.layoutFittingCompressedSize)
+        accessory.frame = CGRect(origin: .zero, size: size)
+        cell.accessoryView = accessory
+        return cell
+    }
+
+    @objc private func onModifyHit(_ sender: UIButton) {
+        let row = sender.tag
+        guard row >= 0 && row < session.hits.count else { return }
+        let hit = session.hits[row]
+        let alert = UIAlertController(
+            title: text.tModifyTitle,
+            message: CheatsMenuTextPayload.format(text.tModifyMessage, hit.addressText),
+            preferredStyle: .alert
+        )
+        alert.addTextField { tf in
+            tf.text = hit.valueText
+            tf.keyboardType = .numbersAndPunctuation
+            tf.clearButtonMode = .whileEditing
+        }
+        alert.addAction(UIAlertAction(title: text.tCancelAction, style: .cancel))
+        alert.addAction(UIAlertAction(title: text.tConfirmAction, style: .default) { [weak self, weak alert] _ in
+            guard let self, let val = alert?.textFields?.first?.text else { return }
+            _ = self.session.writeHit(at: row, rawText: val, text: self.text)
+        })
+        present(alert, animated: true)
+    }
+
+    @objc private func onSaveHit(_ sender: UIButton) {
+        let row = sender.tag
+        guard row >= 0 && row < session.hits.count else { return }
+        let hit = session.hits[row]
+        let bid = session.buildID()
+        let msg = bid.isEmpty ? hit.addressText : CheatsMenuTextPayload.format(text.tSaveMessage, bid)
+        let alert = UIAlertController(title: text.tSaveTitle, message: msg, preferredStyle: .alert)
+        alert.addTextField { [weak self] tf in
+            guard let self else { return }
+            tf.placeholder = self.text.tCheatNamePlaceholder
+            tf.text = CheatsMenuTextPayload.format(self.text.tDefaultCheatName, hit.addressText)
+            tf.clearButtonMode = .whileEditing
+        }
+        alert.addTextField { tf in
+            tf.text = hit.valueText
+            tf.keyboardType = .numbersAndPunctuation
+            tf.clearButtonMode = .whileEditing
+        }
+        alert.addAction(UIAlertAction(title: text.tCancelAction, style: .cancel))
+        alert.addAction(UIAlertAction(title: text.tSaveConfirmAction, style: .default) { [weak self, weak alert] _ in
+            guard let self else { return }
+            let name = alert?.textFields?.first?.text ?? ""
+            let val = alert?.textFields?.dropFirst().first?.text
+            _ = self.session.saveHitAsCheat(at: row, name: name, rawText: val, text: self.text)
+        })
+        present(alert, animated: true)
+    }
+}
+
+@_cdecl("dm_cheat_scanner_teardown")
+public func dmCheatScannerTeardown() {
+    if Thread.isMainThread {
+        CheatScannerSession.shared.teardown()
+    } else {
+        DispatchQueue.main.async {
+            CheatScannerSession.shared.teardown()
+        }
+    }
+}
