+private final class MockScannerBackend: CheatScannerBackend {
+    var startHandler: ((ScanValueType, UInt64) -> (stored: Int, total: UInt64))?
+    var refineHandler: ((ScanCompareMode, UInt64) -> (stored: Int, total: UInt64))?
+    var hits: [ScanHitItem] = []
+    var writeResult = true
+    var appendResult = true
+    var canSave = true
+    var bid = "1111111111111111"
+    var resetCalls = 0
+    var writeCalls: [(UInt8, UInt64, ScanValueType, UInt64)] = []
+    var appendCalls: [(String, UInt8, UInt64, ScanValueType, UInt64)] = []
+
+    func startScan(type: ScanValueType, targetRaw: UInt64) -> (stored: Int, total: UInt64) {
+        startHandler?(type, targetRaw) ?? (hits.count, UInt64(hits.count))
+    }
+
+    func refineScan(cmp: ScanCompareMode, targetRaw: UInt64) -> (stored: Int, total: UInt64) {
