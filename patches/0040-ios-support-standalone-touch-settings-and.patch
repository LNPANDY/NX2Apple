+
+    static func compactReason(_ raw: String, bakedKind: Int32, kind: Int32, text: CheatsMenuTextPayload) -> String? {
+        var s = raw.trimmingCharacters(in: .whitespacesAndNewlines)
+        if s.hasPrefix("("), s.hasSuffix(")"), s.count >= 2 {
+            s = String(s.dropFirst().dropLast()).trimmingCharacters(in: .whitespacesAndNewlines)
+        }
+        if s.count > 48 {
+            let cut = s.index(s.startIndex, offsetBy: 47)
+            s = String(s[..<cut]) + "…"
+        }
+        if bakedKind == 3 {
+            return s.isEmpty ? text.tNeedsBuilderBake : s
+        }
+        if kind == 2 {
+            return s.isEmpty ? text.tUnavailable : s
+        }
+        return s.isEmpty ? nil : s
+    }
+
+    static func classifyAll(text: CheatsMenuTextPayload) -> [CheatMenuEntrySnapshot] {
+        let count = Int(dm_menu_cheats_count())
+        guard count > 0 else { return [] }
+        var result: [CheatMenuEntrySnapshot] = []
+        result.reserveCapacity(count)
+        for i in 0..<count {
+            let idx = Int32(i)
+            let kind = dm_menu_cheat_kind(idx)
+            let flags = dm_menu_cheat_flags(idx)
+            let bakedKind = dm_menu_cheat_baked_kind(idx)
+            let name = dm_menu_cheat_name(idx).map { String(cString: $0) } ?? ""
+            let section = dm_menu_cheat_section(idx).map { String(cString: $0) } ?? ""
+            let rawWhy = dm_menu_cheat_why(idx).map { String(cString: $0) } ?? ""
+            let on = dm_menu_cheat_on(idx)
+            let isLabel = kind == 3
+            let isSectionMarker = (flags & (flagSectionStart | flagSectionEnd)) != 0
+            if isLabel && (isSectionMarker || name.isEmpty) { continue }
+            let isMaster = kind == 1
+            let isDisabled = isLabel || isMaster || kind == 2 || bakedKind == 3
+            let displayOn: Bool
+            if isMaster {
+                displayOn = true
+            } else if kind == 2 || bakedKind == 3 || isLabel {
+                displayOn = false
+            } else {
+                displayOn = on
+            }
+            let subtitle: String?
+            if isMaster {
+                subtitle = text.tMasterSubtitle
+            } else if !isLabel {
+                subtitle = compactReason(rawWhy, bakedKind: bakedKind, kind: kind, text: text)
+            } else {
+                subtitle = nil
+            }
+            result.append(CheatMenuEntrySnapshot(
+                index: i,
+                name: name,
+                section: section,
+                isOn: displayOn,
+                isMaster: isMaster,
+                isDisabled: isDisabled,
+                isLabel: isLabel,
+                isSectionMarker: isSectionMarker,
+                subtitle: subtitle
+            ))
+        }
+        return result
+    }
+}
+
+func cheatsSubmenu() -> UIMenuElement {
+    let text = CheatsMenuTextPayload.current()
+    return UIMenu(
+        title: text.tCheatsTitle,
+        image: nil,
+        children: [UIDeferredMenuElement.uncached { done in
+            done(buildCheatsMenuElements())
+        }]
+    )
+}
+
+func buildCheatsMenuElements() -> [UIMenuElement] {
+    let text = CheatsMenuTextPayload.current()
+    let scanAction = UIAction(title: text.tMemoryScannerMenu, image: UIImage(systemName: "magnifyingglass")) { _ in
+        CheatScannerSession.shared.openPanel()
+    }
+    var topChildren: [UIMenuElement] = [scanAction]
+    let loaded = dm_menu_cheats_loaded()
+    let entries = loaded ? CheatMenuClassifier.classifyAll(text: text) : []
+    if loaded && dm_menu_cheats_count() > 0 {
+        let masterOn = dm_menu_cheats_master()
+        let masterAction = UIAction(title: text.tMasterSwitch, state: masterOn ? .on : .off) { _ in
+            dm_menu_cheats_set_master(!dm_menu_cheats_master())
+        }
+        topChildren.append(masterAction)
+    }
+    var groups: [UIMenuElement] = [UIMenu(options: .displayInline, children: topChildren)]
+    guard !entries.isEmpty else { return groups }
+
+    var currentSection: String? = nil
+    var currentItems: [UIMenuElement] = []
+    func flushGroup() {
+        guard !currentItems.isEmpty else { return }
+        let title = currentSection ?? ""
+        groups.append(UIMenu(title: title, options: .displayInline, children: currentItems))
+        currentItems.removeAll(keepingCapacity: true)
+    }
+
+    for entry in entries {
+        let sec = entry.section
+        if currentSection != sec {
+            flushGroup()
+            currentSection = sec
+        }
+        let attrs: UIMenuElement.Attributes = entry.isDisabled ? .disabled : []
+        let state: UIMenuElement.State = entry.isLabel ? .off : (entry.isOn ? .on : .off)
+        let idx = Int32(entry.index)
+        let action = UIAction(title: entry.name, attributes: attrs, state: state) { _ in
+            guard !entry.isDisabled else { return }
+            dm_menu_cheat_toggle(idx)
+        }
+        if let sub = entry.subtitle {
+            action.subtitle = sub
+        }
+        currentItems.append(action)
+    }
+    flushGroup()
+    return groups
+}
