+// MARK: - Memory Scanner Session & Backend
+
+struct ScanHitItem: Equatable {
+    let region: UInt8
+    let type: ScanValueType
+    let offset: UInt64
+    var valueRaw: UInt64
+
+    var addressText: String {
+        ScanValueCodec.formatAddress(region: region, offset: offset)
+    }
+
+    var valueText: String {
+        ScanValueCodec.decode(valueRaw, type: type)
+    }
+}
+
+protocol CheatScannerBackend {
+    func startScan(type: ScanValueType, targetRaw: UInt64) -> (stored: Int, total: UInt64)
+    func refineScan(cmp: ScanCompareMode, targetRaw: UInt64) -> (stored: Int, total: UInt64)
+    func fetchHits(limit: Int, type: ScanValueType) -> [ScanHitItem]
+    func writeValue(region: UInt8, offset: UInt64, type: ScanValueType, valueRaw: UInt64) -> Bool
+    func appendCheat(name: String, region: UInt8, offset: UInt64, type: ScanValueType, valueRaw: UInt64) -> Bool
+    func canSaveCheat() -> Bool
+    func buildID() -> String
+    func resetScan()
+}
+
+struct EngineCheatScannerBackend: CheatScannerBackend {
+    func startScan(type: ScanValueType, targetRaw: UInt64) -> (stored: Int, total: UInt64) {
+        var total: UInt64 = 0
+        let stored = Int(dm_menu_scan_start(type.rawValue, targetRaw, &total))
+        return (max(0, stored), total)
+    }
+
+    func refineScan(cmp: ScanCompareMode, targetRaw: UInt64) -> (stored: Int, total: UInt64) {
+        var total: UInt64 = 0
+        let stored = Int(dm_menu_scan_refine(cmp.rawValue, targetRaw, &total))
+        return (max(0, stored), total)
+    }
+
+    func fetchHits(limit: Int, type: ScanValueType) -> [ScanHitItem] {
+        let count = min(limit, max(0, Int(dm_menu_scan_count())))
+        var items: [ScanHitItem] = []
+        items.reserveCapacity(count)
+        var hit = DmMenuScanHit()
+        for i in 0..<count {
+            if dm_menu_scan_get(Int32(i), &hit) {
+                let resolvedType = ScanValueType(rawValue: Int32(hit.type)) ?? type
+                items.append(ScanHitItem(region: hit.region, type: resolvedType, offset: hit.offset, valueRaw: hit.value))
+            }
+        }
+        return items
+    }
+
+    func writeValue(region: UInt8, offset: UInt64, type: ScanValueType, valueRaw: UInt64) -> Bool {
+        dm_menu_scan_write(region, offset, type.rawValue, valueRaw)
+    }
+
+    func appendCheat(name: String, region: UInt8, offset: UInt64, type: ScanValueType, valueRaw: UInt64) -> Bool {
+        dm_menu_scan_append_cheat(name, region, offset, type.rawValue, valueRaw)
+    }
+
+    func canSaveCheat() -> Bool {
+        dm_menu_cheats_can_save()
+    }
+
+    func buildID() -> String {
+        dm_menu_cheats_build_id().map { String(cString: $0) } ?? ""
+    }
+
+    func resetScan() {
+        dm_menu_scan_reset()
+    }
+}
+
+final class CheatScannerSession {
+    static let shared = CheatScannerSession(backend: EngineCheatScannerBackend())
+    static let maxDisplayedHits = 100
+
+    private let backend: CheatScannerBackend
+    private let workQueue = DispatchQueue(label: "org.nxnative.cheat-scanner", qos: .userInitiated)
+    private var observers: [NSObjectProtocol] = []
+
+    private(set) var generation: UInt64 = 0
+    private(set) var isSearching = false
+    private(set) var hasActiveScan = false
+    private(set) var selectedType: ScanValueType = .u32
+    var valueInput: String = ""
+    private(set) var totalHits: UInt64 = 0
+    private(set) var storedCount: Int = 0
+    private(set) var hits: [ScanHitItem] = []
+    private(set) var statusMessage: String?
+    private(set) var statusIsError = false
+
+    weak var activeController: CheatScannerViewController?
+    var onStateChanged: (() -> Void)?
+
+    init(backend: CheatScannerBackend, installNotifications: Bool = true) {
+        self.backend = backend
+        if installNotifications {
+            let nc = NotificationCenter.default
+            observers.append(nc.addObserver(forName: Notification.Name("DMShellDidReturnToLibrary"), object: nil, queue: .main) { [weak self] _ in
+                self?.teardown()
+            })
+            observers.append(nc.addObserver(forName: UIApplication.willTerminateNotification, object: nil, queue: .main) { [weak self] _ in
+                self?.teardown()
+            })
+        }
+    }
+
+    deinit {
+        for token in observers {
+            NotificationCenter.default.removeObserver(token)
+        }
+    }
+
+    func openPanel() {
+        let vc: CheatScannerViewController
+        if let existing = activeController {
+            vc = existing
+        } else {
+            vc = CheatScannerViewController(session: self)
+            activeController = vc
+        }
+        if vc.presentingViewController == nil {
+            dm_menu_present_view_controller(Unmanaged.passUnretained(vc).toOpaque())
+        }
+        vc.syncUI()
+    }
+
+    func hidePanel() {
+        guard let vc = activeController else { return }
+        if vc.presentingViewController != nil {
+            vc.dismiss(animated: true)
+        }
+    }
+
+    func setType(_ type: ScanValueType) {
+        guard !hasActiveScan && !isSearching else { return }
+        selectedType = type
+        statusMessage = nil
+        statusIsError = false
+        notifyChange()
+    }
+
+    func startInitialScan(rawText: String, text: CheatsMenuTextPayload = .current(), completion: (() -> Void)? = nil) {
+        valueInput = rawText
+        guard !isSearching else { completion?(); return }
+        guard let target = ScanValueCodec.encode(rawText, type: selectedType) else {
+            statusMessage = text.tInvalidValueError
+            statusIsError = true
+            notifyChange()
+            completion?()
+            return
+        }
+        generation &+= 1
+        let opGen = generation
+        let scanType = selectedType
+        isSearching = true
+        statusMessage = text.tScanningStatus
+        statusIsError = false
+        notifyChange()
+
+        workQueue.async { [weak self] in
+            guard let self else { return }
+            let result = self.backend.startScan(type: scanType, targetRaw: target)
+            let fetched = result.stored > 0 ? self.backend.fetchHits(limit: Self.maxDisplayedHits, type: scanType) : []
+            DispatchQueue.main.async {
+                guard self.generation == opGen else {
+                    completion?()
+                    return
+                }
+                self.isSearching = false
+                self.hasActiveScan = true
+                self.storedCount = result.stored
+                self.totalHits = result.total
+                self.hits = fetched
+                self.statusMessage = result.total == 0 ? text.tNoMatches : nil
+                self.statusIsError = false
+                self.notifyChange()
+                completion?()
+            }
+        }
+    }
+
+    func refineScan(mode: ScanCompareMode, rawText: String, text: CheatsMenuTextPayload = .current(), completion: (() -> Void)? = nil) {
+        valueInput = rawText
+        guard hasActiveScan && !isSearching else { completion?(); return }
+        let needsTarget = mode == .eq || mode == .ne || mode == .gt || mode == .lt
+        var target: UInt64 = 0
+        if needsTarget {
+            guard let encoded = ScanValueCodec.encode(rawText, type: selectedType) else {
+                statusMessage = text.tInvalidValueError
+                statusIsError = true
+                notifyChange()
+                completion?()
+                return
+            }
+            target = encoded
+        }
+
+        generation &+= 1
+        let opGen = generation
+        let scanType = selectedType
+        isSearching = true
+        statusMessage = text.tScanningStatus
+        statusIsError = false
+        notifyChange()
+
+        workQueue.async { [weak self] in
+            guard let self else { return }
+            let result = self.backend.refineScan(cmp: mode, targetRaw: target)
+            let fetched = result.stored > 0 ? self.backend.fetchHits(limit: Self.maxDisplayedHits, type: scanType) : []
+            DispatchQueue.main.async {
+                guard self.generation == opGen else {
+                    completion?()
+                    return
+                }
+                self.isSearching = false
+                self.storedCount = result.stored
+                self.totalHits = result.total
+                self.hits = fetched
+                self.statusMessage = result.total == 0 ? text.tNoMatches : nil
+                self.statusIsError = false
+                self.notifyChange()
+                completion?()
+            }
+        }
+    }
+
+    func writeHit(at row: Int, rawText: String, text: CheatsMenuTextPayload = .current()) -> Bool {
+        guard row >= 0 && row < hits.count else { return false }
+        let hit = hits[row]
+        guard let rawValue = ScanValueCodec.encode(rawText, type: hit.type) else {
+            statusMessage = text.tInvalidValueError
+            statusIsError = true
+            notifyChange()
+            return false
+        }
+        let ok = backend.writeValue(region: hit.region, offset: hit.offset, type: hit.type, valueRaw: rawValue)
+        if ok {
+            hits[row].valueRaw = rawValue
+            let decoded = ScanValueCodec.decode(rawValue, type: hit.type)
+            statusMessage = CheatsMenuTextPayload.format(text.tWriteSuccess, hit.addressText, decoded)
+            statusIsError = false
+        } else {
+            statusMessage = CheatsMenuTextPayload.format(text.tWriteFailed, hit.addressText)
+            statusIsError = true
+        }
+        notifyChange()
+        return ok
+    }
+
+    func saveHitAsCheat(at row: Int, name: String, rawText: String?, text: CheatsMenuTextPayload = .current()) -> Bool {
+        guard row >= 0 && row < hits.count else { return false }
+        guard backend.canSaveCheat() else {
+            statusMessage = text.tSaveUnavailable
+            statusIsError = true
+            notifyChange()
+            return false
+        }
+        let hit = hits[row]
+        let cleanName = name.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !cleanName.isEmpty else {
+            statusMessage = text.tSaveFailed
+            statusIsError = true
+            notifyChange()
+            return false
+        }
+        let valueRaw: UInt64
+        if let rawText {
+            guard let encoded = ScanValueCodec.encode(rawText, type: hit.type) else {
+                statusMessage = text.tInvalidValueError
+                statusIsError = true
+                notifyChange()
+                return false
+            }
+            valueRaw = encoded
+        } else {
+            valueRaw = hit.valueRaw
+        }
+        let ok = backend.appendCheat(name: cleanName, region: hit.region, offset: hit.offset, type: hit.type, valueRaw: valueRaw)
+        if ok {
+            statusMessage = CheatsMenuTextPayload.format(text.tSaveSuccess, cleanName)
+            statusIsError = false
+        } else {
+            statusMessage = text.tSaveFailed
+            statusIsError = true
+        }
+        notifyChange()
+        return ok
+    }
+
+    func canSaveCheat() -> Bool {
+        backend.canSaveCheat()
+    }
+
+    func buildID() -> String {
+        backend.buildID()
+    }
+
+    func reset() {
+        generation &+= 1
+        isSearching = false
+        hasActiveScan = false
+        totalHits = 0
+        storedCount = 0
+        hits.removeAll()
+        statusMessage = nil
+        statusIsError = false
+        backend.resetScan()
+        notifyChange()
+    }
+
+    func teardown() {
+        generation &+= 1
+        isSearching = false
+        hasActiveScan = false
+        selectedType = .u32
+        valueInput = ""
+        totalHits = 0
+        storedCount = 0
+        hits.removeAll()
+        statusMessage = nil
+        statusIsError = false
+        backend.resetScan()
+        if let vc = activeController {
+            activeController = nil
+            if vc.presentingViewController != nil {
+                vc.dismiss(animated: false)
+            }
+        }
+        notifyChange()
+    }
+
+    private func notifyChange() {
+        activeController?.syncUI()
+        onStateChanged?()
+    }
+}
