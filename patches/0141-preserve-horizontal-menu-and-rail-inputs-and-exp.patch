diff --git a/dm/host/dsu_protocol.h b/dm/host/dsu_protocol.h
index d0991f4..35d69f9 100644
--- a/dm/host/dsu_protocol.h
+++ b/dm/host/dsu_protocol.h
@@ -4,6 +4,15 @@
 #include <stddef.h>
 #include <string.h>
 #include <math.h>
+// Explicit sources are decoded Switch bits, not extra fields on the DSU wire.
+static uint64_t dsu_rails(uint16_t raw,int role,int sl,int sr) {
+    uint64_t buttons=raw;if(role!=1 && role!=2)return buttons;
+    int shift=role==1?24:26;
+    uint64_t remove=0,add=0;
+    if(sl>=0 && sl<16 && (raw&(1u<<sl))){remove|=1ull<<sl;add|=1ull<<shift;}
+    if(sr>=0 && sr<16 && (raw&(1u<<sr))){remove|=1ull<<sr;add|=1ull<<(shift+1);}
+    return (buttons&~remove)|add;
+}
 static uint32_t dsu_u32(const uint8_t *p) { return (uint32_t)p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24; }
 static uint64_t dsu_u64(const uint8_t *p) { return dsu_u32(p) | (uint64_t)dsu_u32(p+4)<<32; }
 static void dsu_put(uint8_t *p, uint32_t v) { for (int i=0;i<4;i++) p[i]=(uint8_t)(v>>(i*8)); }
