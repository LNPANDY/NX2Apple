+    struct Inputs: Equatable {
+        var buttons: UInt32 = 0
+        var leftStick = SIMD2<Int>(repeating: 0)
+        var rightStick = SIMD2<Int>(repeating: 0)
+        static let buttonNames = [(0,"A"),(1,"B"),(2,"X"),(3,"Y"),(4,"L-stick"),(5,"R-stick"),
