+static struct { struct dm_dsu_status status; uint64_t last; uint32_t server; double interval_ns; } report[DM_PLAYERS];
+// Updated only by accepted packets, never by the UI's 0.5s polling timer.
+static void dsu_report_sample(int i,const dsu_sample *s,const float rot[3],uint64_t now) {
+    pthread_mutex_lock(&report_mu);
+    uint64_t last=report[i].last;
+    if(last && now>last && now-last<300000000ull && report[i].server==s->server) {
+        double dt=(double)(now-last);
+        report[i].interval_ns=report[i].interval_ns ? 0.8*report[i].interval_ns+0.2*dt : dt;
+    } else report[i].interval_ns=0;
+    report[i].last=now;report[i].server=s->server;
+    struct dm_dsu_status *d=&report[i].status;
+    d->packets++;d->model=s->model;d->buttons=s->buttons;
+    memcpy(d->sticks,s->sticks,sizeof d->sticks);memcpy(d->gyro,rot,sizeof d->gyro);
+    pthread_mutex_unlock(&report_mu);
+}
+void dm_dsu_snapshot(int player,struct dm_dsu_status *out) {
+    if(!out)return;
+    memset(out,0,sizeof *out);out->age_ms=-1;
+    if(player<0 || player>=DM_PLAYERS)return;
+    pthread_mutex_lock(&report_mu);
+    *out=report[player].status;
+    uint64_t now=now_ns(),last=report[player].last;
+    out->age_ms=last ? (double)(now>=last ? now-last : 0)/1e6 : -1;
+    out->connected=out->configured && last && out->age_ms<300;
+    out->hz=out->connected && report[player].interval_ns>0 ? 1e9/report[player].interval_ns : 0;
+    pthread_mutex_unlock(&report_mu);
+}
