+// The preview reads receiver-owned snapshots; it never publishes guest input,
+// reserves physical slots, or writes the physical mapping preferences.
+static NSString *controller_dsu_preview(int player, const struct dm_dsu_status *s) {
+    if(!s->configured) return [NSString stringWithFormat:@"SELECTED: DSU player %d — not configured\n\nNo endpoint is configured for this player.\nAdd/enable a phone in Setup, save, then reload here.\n",player];
+    NSMutableString *text=[NSMutableString stringWithFormat:@"SELECTED: DSU player %d\nEndpoint: %s:%d · DSU slot %d\nState: %@ · %@\nModel capability: %d (not handedness)\nPackets: %llu · %.1f Hz\n",player,s->host,s->port,s->slot,s->connected ? @"live" : s->packets ? @"stale / disconnected" : @"waiting for packets",s->buttons_enabled ? @"motion + buttons" : @"motion only",s->model,(unsigned long long)s->packets,s->hz];
+    [text appendString:s->age_ms<0 ? @"Sample age: no sample\n" : [NSString stringWithFormat:@"Sample age: %.0f ms\n",s->age_ms]];
+    [text appendString:@"\nBUTTONS (Switch positions, received state)\n"];
+    NSArray *names=@[@"A",@"B",@"X",@"Y",@"L stick",@"R stick",@"L",@"R",@"ZL",@"ZR",@"+",@"-",@"Left",@"Up",@"Right",@"Down"];
+    for(int i=0;i<16;i++) [text appendFormat:@"%@ %@%@",s->buttons&(1u<<i) ? @"●" : @"○",names[i],i%4==3 ? @"\n" : @"  "];
+    [text appendFormat:@"\nSTICKS (received, signed 16-bit)\nLeft  X %+6d  Y %+6d\nRight X %+6d  Y %+6d\n",s->sticks[0],s->sticks[1],s->sticks[2],s->sticks[3]];
+    if(!s->connected) [text appendString:@"Not live: values above are not current input.\n"];
+    if(!s->buttons_enabled) [text appendString:@"Buttons/sticks are preview only; guest button input is disabled.\n"];
+    return text;
+}
 
