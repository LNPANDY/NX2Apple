     if(p<0 || p>=DM_PLAYERS)return;
+    // Native upright halves: no sideways rotation, remapping or synthetic SL/SR.
+    int role=atomic_load(&g_dsu_role[p]);
+    if(role==DM_DSU_LEFT) { buttons &= DM_BTN_LEFT|DM_BTN_UP|DM_BTN_RIGHT|DM_BTN_DOWN|DM_BTN_L|DM_BTN_ZL|DM_BTN_MINUS|DM_BTN_LS;rx=ry=0; }
+    if(role==DM_DSU_RIGHT) { buttons &= DM_BTN_A|DM_BTN_B|DM_BTN_X|DM_BTN_Y|DM_BTN_R|DM_BTN_ZR|DM_BTN_PLUS|DM_BTN_RS;lx=ly=0; }
     uint64_t old=atomic_exchange(&g_dsu_btn[p],buttons);atomic_fetch_or(&g_dsu_latch[p],buttons&~old);
     atomic_store(&g_dsu_axes[p],(uint64_t)(uint16_t)lx | (uint64_t)(uint16_t)ly<<16 | (uint64_t)(uint16_t)rx<<32 | (uint64_t)(uint16_t)ry<<48);atomic_store(&g_dsu_input_time[p],t);
 }
@@ -320,16 +327,16 @@ static _Atomic uint32_t g_players = 1, g_ids_supported = 0x3ff;
 // applet leaves no more controllers connected than the game takes; here such a player is not reported, as one on an npad the game does not support
 static _Atomic uint32_t g_benched, g_bench_one;
 static uint32_t id_bit(uint32_t id) { return id < DM_PLAYERS ? 1u << id : id == NPAD_HANDHELD ? 1u << 8 : id == 0x10 ? 1u << 9 : 0; }
-static int reported(int p) { return p == 0 || (atomic_load(&g_players) >> p & 1 && atomic_load(&g_ids_supported) & id_bit((uint32_t)p) && !(atomic_load(&g_benched) >> p & 1)); }
+static int reported(int p) { return p == 0 || ((atomic_load(&g_players) | dsu_players()) >> p & 1 && atomic_load(&g_ids_supported) & id_bit((uint32_t)p) && !(atomic_load(&g_benched) >> p & 1)); }
 // Players with a controller that the game does not see: their npad is not supported, or the controller applet left them out. A one-player game (no npad past No1 supported, or
 // an applet opened for one player) gets them as player 1, so any controller plays it; in a game for fewer players than are connected (a fifth controller in a four-player game)
