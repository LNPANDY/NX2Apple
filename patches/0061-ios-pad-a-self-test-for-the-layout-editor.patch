+// The self-test's script (DmGamepad.m runLayoutSelfTest, DM_PAD_LAYOUT_TEST) through the same rules, on every screen and layout, every size and stick
+// place, with and without single moves: Both sides together, the shoulders go down together (the last step that fits is kept; on a screen where they
+// have no room below their built-in place the self-test logs that and skips the check, as here), Each side on its own, the left ones half of the way
+// back up while the right ones stay, Both sides together again (nothing moves), the pinch on A B X Y takes the stick along as far as it has room, the
+// choice is dimmed for the D-pad (2D: the middle group), whose slider gives 80 % or its floor, and the value read back gives the same frames and
+// touches. No combination fails: the self-test reports no FAIL that is the screen's and not the editor's.
+static void check_selftest_script(void) {
+    static const char *arrangements[] = {NULL, "1;3d/face:-4,-4/stick:0,-3", "1;2d/zr:-3,2/x:-1,-2/plus:5,1"};
+    int runs = 0, noRoom = 0, apartRuns = 0;
+    for (int i = 0; i < N_SCREENS; i++)
+        for (int full = 0; full < 2; full++)
+            for (int z = 0; z < 3; z++)
+                for (int st = 0; st < 3; st++)
+                    for (int ar = 0; ar < 3; ar++) {
+                        DmPadLayout arr; dm_pad_layout_parse(arrangements[ar], &arr);
+                        DmPadScene sc = scene(&k_screens[i], full, dm_pad_size_scale(k_sizes[z]), st, &arr);
+                        int set = dm_pad_scene_set(&sc);
+                        char what[128]; snprintf(what, sizeof what, "%s %s %s stick %d layout %d self-test", k_screens[i].name, full ? "3D" : "2D", k_sizes[z], st, ar);
+                        DmPadGroups d; memset(&d, 0, sizeof d);
+                        DmPadGeo g = dm_pad_scene_geo(&sc, &d);
+                        CGRect box = dm_pad_group_box(&g, full, DM_PAD_G_LEFT, NULL);
+                        CGPoint start = g.at[DM_PAD_G_LEFT];
+                        CGFloat dy = 0.3 * (g.area[DM_PAD_G_LEFT].size.height - box.size.height);
+                        for (int s = 1; s <= 10; s++) {   // as editDragMove: the centre the drag began at, plus the finger's move
+                            DmPadGeo cur = dm_pad_scene_geo(&sc, &d);
+                            DmPadPlace p = dm_pad_place_at(&cur, DM_PAD_G_LEFT, 100, CGPointMake(start.x, start.y + dy * s / 10), DM_PAD_SNAP);
+                            DmPadGroups t; if (dm_pad_try_places(&sc, &d, DM_PAD_G_LEFT, p, dm_pad_mate_size(&sc, &d, DM_PAD_G_LEFT), &t)) d = t;
+                        }
+                        DmPadPlace l = d.place[set][DM_PAD_G_LEFT], r = d.place[set][DM_PAD_G_RIGHT];
+                        if (!l.size && !r.size) noRoom++;   // no step fitted: the self-test says so and goes on
+                        else if (!l.size || !r.size || abs(r.x - (1000 - l.x)) > 1 || r.y != l.y)
+                            FAIL("%s: the shoulders did not go down together (%d,%d,%d / %d,%d,%d)", what, l.x, l.y, l.size, r.x, r.y, r.size);
+                        // 1b. Each side on its own (the choice is the left shoulders'): from the centre of their box, half of the way back up in five steps.
+                        if (!dm_pad_mirror_applies(&sc, DM_PAD_G_LEFT)) FAIL("%s: the choice does not apply to the left shoulders", what);
+                        d.solo[set] = 1;
+                        if (l.size || r.size) {
+                            DmPadGeo now = dm_pad_scene_geo(&sc, &d);
+                            CGRect moved = dm_pad_group_box(&now, full, DM_PAD_G_LEFT, NULL);
+                            CGFloat back = (CGRectGetMidY(moved) - CGRectGetMidY(box)) / 2;
+                            CGPoint from = now.at[DM_PAD_G_LEFT];
+                            int size = dm_pad_place_now(&sc, &d, DM_PAD_G_LEFT).size;
+                            for (int s = 1; s <= 5; s++) {
+                                DmPadGeo cur = dm_pad_scene_geo(&sc, &d);
+                                DmPadPlace p = dm_pad_place_at(&cur, DM_PAD_G_LEFT, size, CGPointMake(from.x, from.y - back * s / 5), DM_PAD_SNAP);
+                                DmPadGroups t; if (dm_pad_try_places(&sc, &d, DM_PAD_G_LEFT, p, dm_pad_mate_size(&sc, &d, DM_PAD_G_LEFT), &t)) d = t;
+                            }
+                            if (memcmp(&d.place[set][DM_PAD_G_RIGHT], &r, sizeof r)) FAIL("%s: on their own, the right shoulders moved", what);
+                            if (back > DM_PAD_SNAP + 1 && d.place[set][DM_PAD_G_LEFT].y >= l.y) FAIL("%s: on their own, the left shoulders did not go back up", what);
+                            apartRuns++;
+                        }
+                        DmPadGeo apart = dm_pad_scene_geo(&sc, &d);
+                        d.solo[set] = 0;   // Both sides together again: nothing moves
+                        DmPadGeo together = dm_pad_scene_geo(&sc, &d);
+                        if (!geo_identical(&apart, &together)) FAIL("%s: Both sides together moved something", what);
+                        DmPadGroups t;
+                        for (int s = 1; s <= 4; s++) { dm_pad_try_size_mated(&sc, &d, DM_PAD_G_FACE, (int)lround(100 * (1 + 0.05 * s)), &t, NULL); d = t; }
+                        int face = dm_pad_place_now(&sc, &d, DM_PAD_G_FACE).size, stick = dm_pad_place_now(&sc, &d, DM_PAD_G_STICK).size;
+                        if (stick != face && !dm_pad_mate_maxed(&sc, &d, DM_PAD_G_FACE)) FAIL("%s: the stick (%d) did not follow A B X Y (%d) as far as it has room", what, stick, face);
+                        int k3 = full ? DM_PAD_G_DPAD : DM_PAD_G_MID, want = MAX(80, dm_pad_size_min(&sc, &d, k3));
+                        if (dm_pad_mirror_applies(&sc, k3)) FAIL("%s: the choice applies to %s", what, dm_pad_group_names[k3]);
+                        int got = dm_pad_try_size_mated(&sc, &d, k3, 80, &t, NULL); d = t;
+                        if (got != want) FAIL("%s: %s's slider to 80 gave %d, not %d", what, dm_pad_group_names[k3], got, want);
+                        dm_pad_try_all(&sc, &d, 105, &t); d = t;
+                        char v[DM_PAD_GROUPS_MAX + 1]; DmPadGroups back;
+                        dm_pad_groups_encode(&d, v, sizeof v); dm_pad_groups_parse(v, &back);
+                        DmPadGeo a = dm_pad_scene_geo(&sc, &d), b = dm_pad_scene_geo(&sc, &back);
+                        int bad, n = dm_pad_hit_compare(&a, &b, full, sc.layout.separated, &bad);
+                        if (bad || b.groupDropped) FAIL("%s: read back, %d of %d points differ (dropped %#x)", what, bad, n, b.groupDropped);
+                        check_geo(&sc, &a, what);
+                        runs++;
+                    }
+    printf("self-test script: %d runs, %d with no room to lower the shoulders (skipped, not failed), %d with the left ones moved back on their own\n", runs, noRoom, apartRuns);
+}
