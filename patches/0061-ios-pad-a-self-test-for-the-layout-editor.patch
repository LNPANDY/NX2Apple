+// ---- The layout editor's self-test (DM_PAD_LAYOUT_TEST=1) ----
+// A scripted run for a build no one touches: 3 seconds after the gamepad's first layout it opens the editor, taps Both sides together on the panel,
+// drags the left shoulders down by 30 % of their free range in ten steps (the right ones follow; a screen where they have no room below their built-in
+// place says so and skips that check), taps Each side on its own and drags them half of the way back up (the right ones stay), taps Both sides together
+// again (nothing moves), pinches A B X Y toward 120 % (the stick goes along as far as it has room), taps the D-pad (in 2D the middle group: the choice is
+// dimmed there, no mirror image) and sets its slider to 80 %, sets all controls to 105 %, logging every control's frame before and after, and taps Done:
+// the value is saved where the editor saves it, read back from there, and the geometry of the value read back alone must give the same frames and send
+// every touch point to the same control as the edited one and the gamepad's own (dm_pad_hit_compare: what touchesBegan decides with). Then what was
+// stored before the test is put back, and what was not stored is forgotten again (a game with no layout of its own keeps none). Each step calls the
+// method a finger, the pinch or the panel calls (the choice through the action a tap on it sends, tapMirrorSegment:). The lines start with "pad layout
+// test:", a failure is a [RED] line, and the last line says PASS or FAIL. Returns the number of failures (the Duo harness runs it on a simulator).
+- (void)selfTestIfAsked {
+    if (_selfTestQueued || CGRectIsEmpty(self.bounds)) return;
+    const char *e = getenv("DM_PAD_LAYOUT_TEST");
+    if (!e || !atoi(e)) return;
+    _selfTestQueued = YES;
+    LOG("pad layout test: queued (DM_PAD_LAYOUT_TEST), it starts in 3 seconds");
+    __weak DmGamepad *weak = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ [weak runLayoutSelfTest]; });
+}
+static void selftest_frames(const char *when, const DmPadGeo *g, BOOL full) {
+    char line[2048]; size_t n = 0; line[0] = 0;
+    for (int c = 0; c < DM_PAD_C_N; c++) {
+        if (c >= DM_PAD_C_A && c <= DM_PAD_C_Y) continue;   // the diamond is "face"
+        CGRect f = dm_pad_control_frame(g, full, c);
+        if (CGRectIsNull(f)) continue;
+        int w = snprintf(line + n, sizeof line - n, " %s %.1f,%.1f %.1fx%.1f", dm_pad_control_names[c], f.origin.x, f.origin.y, f.size.width, f.size.height);
+        if (w < 0 || (size_t)w >= sizeof line - n) break;
+        n += (size_t)w;
+    }
+    LOG("pad layout test: %s:%s, menu %.1f,%.1f r %.1f, stick ring r %.1f knob r %.1f", when, line, g->swap.x, g->swap.y, g->swapR, g->stickR, g->knobR);
+}
+- (int)runLayoutSelfTest {
+    if (_tap) { LOG("pad layout test: skipped, the Tap layout has no controls to move"); return 0; }
+    if (CGRectIsEmpty(self.bounds)) { LOG("[RED] pad layout test: FAIL: the gamepad has no size yet"); return 1; }
+    if (_editing) [self finishEditing:NO];
+    int fails = 0;
+    #define T_FAIL(...) do { LOG("[RED] pad layout test: FAIL: " __VA_ARGS__); fails++; } while (0)
+    BOOL inShell = dlsym(RTLD_DEFAULT, "dm_shell_touch_groups_save") != NULL;
+    int scope = inShell && _groupsOwn ? 1 : 0;
+    NSString *stored = [self storedGroups:scope];
+    DmPadGroups inEffect = _groups; BOOL ownBefore = _groupsOwn;
+    char effect[DM_PAD_GROUPS_MAX + 1]; dm_pad_groups_encode(&_groups, effect, sizeof effect);
+    DmPadScene sc = [self editScene];
+    int set = dm_pad_scene_set(&sc);
+    _geoValid = NO;
+    DmPadGeo before = *self.geo;
+    LOG("pad layout test: start: view %.0fx%.0f, safe area %.0f %.0f %.0f %.0f, %s with the controls %s (layout %s), u %.3f, groups in effect: %s; stored for %s: %s (%s)",
+        self.bounds.size.width, self.bounds.size.height, sc.insets.top, sc.insets.left, sc.insets.bottom, sc.insets.right, _full ? "3D" : "2D",
+        _layout.separated ? "below the picture" : "over the picture", dm_pad_set_names[set], before.u, *effect ? effect : "none", scope ? "this game" : "every game",
+        stored ? (stored.length ? stored.UTF8String : "empty") : "nothing", inShell ? "the shell's store" : "this app's NSUserDefaults");
+    selftest_frames("before", &before, _full);
+    [self beginEditing];
+    if (!_editing) { T_FAIL("the editor did not open"); return fails; }
+    LOG("pad layout test: the editor is open");
+    // The test runs with Both sides together, the default, tapped on the panel (the layout on screen may have had Each side on its own).
+    if (![_panel tapMirrorSegment:0] || _draft.solo[set] || [_panel mirrorSegment] != 0)
+        T_FAIL("Both sides together, tapped on the panel, did not take (the halves %s, the panel shows %d)", _draft.solo[set] ? "on their own" : "together", [_panel mirrorSegment]);
+    // 1. A drag of the left shoulders, as a finger does it.
+    const DmPadGeo *g = self.geo;
+    CGRect box = dm_pad_group_box(g, _full, DM_PAD_G_LEFT, NULL);
+    CGPoint from = CGPointMake(CGRectGetMidX(box), CGRectGetMidY(box));
+    CGFloat dy = 0.3 * (g->area[DM_PAD_G_LEFT].size.height - box.size.height);
+    [self editDragBegin:from];
+    for (int i = 1; i <= 10; i++) [self editDragMove:CGPointMake(from.x, from.y + dy * i / 10)];
+    [self editDragEnd];
+    DmPadPlace l = _draft.place[set][DM_PAD_G_LEFT], r = _draft.place[set][DM_PAD_G_RIGHT];
+    CGRect moved = dm_pad_group_box(self.geo, _full, DM_PAD_G_LEFT, NULL);
+    if (!l.size && !r.size) LOG("pad layout test: drag: no room to move the left shoulders down on this screen (%.0fx%.0f, %s): that check is skipped",
+                                self.bounds.size.width, self.bounds.size.height, dm_pad_set_names[set]);
+    else if (!l.size || !r.size || abs(r.x - (DM_PAD_ANCHOR_MAX - l.x)) > 1 || r.y != l.y) T_FAIL("the shoulders did not move down together (left %d,%d,%d right %d,%d,%d)", l.x, l.y, l.size, r.x, r.y, r.size);
+    else LOG("pad layout test: drag: the left shoulders went down %.1f of %.1f points asked, the right ones followed mirrored (left at %d,%d, right at %d,%d)",
+             CGRectGetMidY(moved) - from.y, dy, l.x, l.y, r.x, r.y);
+    // 1b. Each side on its own, tapped on the panel (the choice is the left shoulders', chosen by the drag): they go half of the way back up on their
+    //     own, the right ones stay. Then Both sides together: nothing moves (the right ones go to the mirrored place at the next move).
+    if (![_panel mirrorApplies]) T_FAIL("the choice is dimmed with the left shoulders chosen");
+    if (![_panel tapMirrorSegment:1] || !_draft.solo[set] || [_panel mirrorSegment] != 1)
+        T_FAIL("Each side on its own, tapped on the panel, did not take (the halves %s, the panel shows %d)", _draft.solo[set] ? "on their own" : "together", [_panel mirrorSegment]);
+    DmPadPlace rStays = _draft.place[set][DM_PAD_G_RIGHT];
+    if (l.size || r.size) {
+        CGFloat back = (CGRectGetMidY(moved) - from.y) / 2;
+        CGPoint at = CGPointMake(CGRectGetMidX(moved), CGRectGetMidY(moved));
+        [self editDragBegin:at];
+        for (int i = 1; i <= 5; i++) [self editDragMove:CGPointMake(at.x, at.y - back * i / 5)];
+        [self editDragEnd];
+        DmPadPlace l2 = _draft.place[set][DM_PAD_G_LEFT], r2 = _draft.place[set][DM_PAD_G_RIGHT];
+        CGRect up = dm_pad_group_box(self.geo, _full, DM_PAD_G_LEFT, NULL);
+        if (r2.x != rStays.x || r2.y != rStays.y || r2.size != rStays.size)
+            T_FAIL("each side on its own: the right shoulders moved with the left ones (%d,%d,%d to %d,%d,%d)", rStays.x, rStays.y, rStays.size, r2.x, r2.y, r2.size);
+        else LOG("pad layout test: each side on its own: the left shoulders went back up %.1f of %.1f points asked (left at %d,%d), the right ones stayed (at %d,%d)",
+                 CGRectGetMidY(moved) - CGRectGetMidY(up), back, l2.x, l2.y, r2.x, r2.y);
+    } else LOG("pad layout test: each side on its own: no drag, the shoulders have no room to move on this screen");
+    DmPadGroups apart = _draft;
+    if (![_panel tapMirrorSegment:0] || _draft.solo[set] || [_panel mirrorSegment] != 0) T_FAIL("Both sides together, tapped again, did not take");
+    apart.solo[set] = 0;
+    if (dm_pad_groups_diff(&apart, &_draft)) T_FAIL("Both sides together moved a group by itself");
+    else LOG("pad layout test: both sides together again: nothing moved (the right shoulders go to the mirrored place at their next move)");
+    // 2. A pinch on A B X Y.
+    CGRect fb = dm_pad_group_box(self.geo, _full, DM_PAD_G_FACE, NULL);
+    [self editPinchBegin:CGPointMake(CGRectGetMidX(fb), CGRectGetMidY(fb))];
+    if (_pinchGroup != DM_PAD_G_FACE) T_FAIL("the pinch on A B X Y did not take them");
+    for (int i = 1; i <= 4; i++) [self editPinchScale:1 + 0.05 * i];
+    [self editPinchEnd];
+    DmPadScene scp = [self editScene];
+    int face = dm_pad_place_now(&scp, &_draft, DM_PAD_G_FACE).size, stick = dm_pad_place_now(&scp, &_draft, DM_PAD_G_STICK).size;
+    if (stick != face && !dm_pad_mate_maxed(&scp, &_draft, DM_PAD_G_FACE)) T_FAIL("the stick (%d %%) did not follow A B X Y (%d %%) as far as it has room", stick, face);
+    LOG("pad layout test: pinch: A B X Y at %d %% (120 asked), the stick with them at %d %%%s", face, stick, stick != face ? " (as large as it has room for)" : "");
+    // 3. A tap on the D-pad (2D: the middle group), then its slider.
+    int k3 = _full ? DM_PAD_G_DPAD : DM_PAD_G_MID;
+    CGRect b3 = dm_pad_group_box(self.geo, _full, k3, NULL);
+    [self editDragBegin:CGPointMake(CGRectGetMidX(b3), CGRectGetMidY(b3))];
+    [self editDragEnd];
+    if (_editGroup != k3) T_FAIL("a tap on %s chose %d", dm_pad_group_names[k3], _editGroup);
+    // The choice is not for a group with no mirror image: dimmed, still showing the layout's, and a tap on it does nothing.
+    if ([_panel mirrorApplies] || [_panel tapMirrorSegment:1] || _draft.solo[set] || [_panel mirrorSegment] != 0)
+        T_FAIL("the choice is not dimmed for %s, which has no mirror image (the halves %s)", dm_pad_group_names[k3], _draft.solo[set] ? "on their own" : "together");
+    else LOG("pad layout test: the choice is dimmed for %s (no mirror image), showing both sides together", dm_pad_group_names[k3]);
+    DmPadScene sc2 = [self editScene];
+    int want3 = MAX(80, dm_pad_size_min(&sc2, &_draft, k3)), got3 = [self editGroupSize:80 quiet:YES];
+    if (got3 != want3) T_FAIL("%s's slider to 80 %% gave %d %%, not %d %%", dm_pad_group_names[k3], got3, want3);
+    else LOG("pad layout test: slider: %s at %d %% (80 asked, its smallest is %d %%)", dm_pad_group_names[k3], got3, dm_pad_size_min(&sc2, &_draft, k3));
+    // 4. All controls.
+    int all = [self editAllSize:105];
+    LOG("pad layout test: all controls at %d %% (105 asked)", all);
+    _geoValid = NO;
+    DmPadGeo edited = *self.geo;
+    selftest_frames("after", &edited, _full);
+    LOG("pad layout test: the stick's ring went from r %.1f to r %.1f, its knob's travel with it (knob r %.1f)", before.stickR, edited.stickR, edited.knobR);
+    // 5. Done, as the button does it (nothing to save when no step changed anything on this screen).
+    char saved[DM_PAD_GROUPS_MAX + 1]; dm_pad_groups_encode(&_draft, saved, sizeof saved);
+    DmPadGroups scopeValue = [self editScopeValue:_editScope];
+    BOOL changed = dm_pad_done(_editScope, _editOpened, &_draft, &scopeValue) != DM_PAD_DONE_NOTHING;
+    [self finishEditing:YES];
+    if (_editing) T_FAIL("Done did not close the editor");
+    // 6. Read back from where Done saved it, and laid out from that value alone.
+    NSString *back = [self storedGroups:scope];
+    if (!changed) {
+        LOG("pad layout test: nothing changed on this screen, Done saved nothing (stored for %s: %s)", scope ? "this game" : "every game", back ? back.UTF8String : "nothing");
+        if (!(stored ? [back isEqualToString:stored] : back == nil)) T_FAIL("Done with nothing changed changed what is stored");
+        back = @(saved);
+    } else {
+        LOG("pad layout test: saved for %s: %s; read back: %s", scope ? "this game" : "every game", saved, back ? back.UTF8String : "nothing");
+        if (!back || strcmp(back.UTF8String, saved)) T_FAIL("the value read back is not the one saved");
+    }
+    DmPadGroups reloaded; memset(&reloaded, 0, sizeof reloaded);
+    if (back && !dm_pad_groups_parse(back.UTF8String, &reloaded)) T_FAIL("the value read back does not parse");
+    DmPadScene sc3 = [self editScene];
+    DmPadGeo fresh = dm_pad_scene_geo(&sc3, &reloaded);
+    _geoValid = NO;
+    const DmPadGeo *live = self.geo;   // what the gamepad now draws and hit-tests with
+    int bad = 0, badLive = 0, n = dm_pad_hit_compare(&edited, &fresh, _full, _layout.separated, &bad);
+    dm_pad_hit_compare(&edited, live, _full, _layout.separated, &badLive);
+    int controls = 0;
+    for (int c = 0; c < DM_PAD_C_N; c++) controls += !CGRectIsNull(dm_pad_control_frame(&fresh, _full, c));
+    if (bad || badLive) T_FAIL("reload: %d of %d touch points or frames differ from the edited layout (%d in the gamepad's own)", bad, n, badLive);
+    else LOG("pad layout test: reload matches: %d controls' frames, %d touch points each taken by its own control, in the value read back and in the gamepad", controls, n);
+    if (fresh.groupDropped) T_FAIL("reload: groups %#x kept their built-in place", fresh.groupDropped);
+    // 7. What was stored before the test goes back; with nothing stored before, nothing is stored after (forgotten, not an empty layout of its own).
+    BOOL forgotten = NO;
+    if (stored) [self storeGroupsValue:stored scope:scope];
+    else if (!(forgotten = [self forgetGroups:scope])) {
+        [self storeGroupsValue:@"" scope:scope];
+        LOG("pad layout test: this shell cannot forget a stored layout (no dm_shell_touch_groups_forget): the built-in one is stored for %s instead", scope ? "this game" : "every game");
+    }
+    _groups = inEffect; _groupsOwn = ownBefore; _geoValid = NO;
+    setenv("DM_TOUCH_GROUPS", effect, 1); setenv("DM_TOUCH_GROUPS_OWN", ownBefore ? "1" : "0", 1);
+    [self setNeedsLayout];
+    NSString *after = [self storedGroups:scope];
+    if (!(stored ? [after isEqualToString:stored] : forgotten ? after == nil : !after.length))
+        T_FAIL("the stored layout from before the test did not come back (%s)", after ? (after.length ? after.UTF8String : "empty") : "nothing");
+    else LOG("pad layout test: put back the stored layout from before the test (%s)", stored ? (stored.length ? stored.UTF8String : "empty") : "nothing stored");
+    if (fails) LOG("[RED] pad layout test: FAIL (%d)", fails);
+    else LOG("pad layout test: PASS");
+    #undef T_FAIL
+    return fails;
+}
+
 // ---- Physical controllers ----
 // Each controller with an extended gamepad profile is a player of its own, as on the Mac (front_mac.m): it holds a slot (pad_slots.h: player 1 first, a reconnected controller
 // gets its player back) and goes to dm_pad_set_player, and hle_hid.c reports player n on its own npad while the slot is held (dm_pad_players). Player 1's controller is ORed
@@ -1455,6 +1636,7 @@ bool dm_pad_layout_offered(int layout) { return layout == 0 || layout == 1 || (l
 void dm_pad_layout_set(int layout) { [g_view setPadLayout:layout]; }
 bool dm_pad_edit_offered(void) { return g_view && [g_view editOffered]; }
