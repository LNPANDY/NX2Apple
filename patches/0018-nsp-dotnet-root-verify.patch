From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: v0lumehi <aljic.zijad@googlemail.com>
Date: Wed, 28 Oct 2026 16:18:05 +0100
Subject: [PATCH] NSP script: verify DOTNET_ROOT by running the shader
 translator

configure_dotnet takes the first runtime root `dotnet --list-runtimes` names, which can be one the translator's apphost cannot use (an arm64 .NET beside an x86_64 apphost, a Homebrew wrapper's directory). The build then stopped at the iOS shader step with an empty translator fingerprint. The script now runs `dmsh_xlate --source-sha` with the chosen root and, when it prints nothing, tries the usual roots (Homebrew libexec, ~/.dotnet, /usr/local/share/dotnet) and keeps the first that answers, or removes DOTNET_ROOT so the apphost searches its own defaults. Never falls back to a guess.

Upstream-Status: pending
Reason: configure_dotnet takes the first listed root without checking that the shader translator runs with it; the build stops at the iOS shader step with an empty fingerprint (fork commit d0ed53df). Not sent to seedds/nxnative yet
Issue: LNPANDY/NX2Apple#123
---
 scripts/build_ipa_from_nsp.py | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/scripts/build_ipa_from_nsp.py b/scripts/build_ipa_from_nsp.py
index 94913824..18e374a8 100755
--- a/scripts/build_ipa_from_nsp.py
+++ b/scripts/build_ipa_from_nsp.py
@@ -2227,6 +2227,29 @@ def main(args=None):
     env.setdefault('DOTNET_CLI_TELEMETRY_OPTOUT', '1')
     env.setdefault('DOTNET_NOLOGO', '1')
     configure_dotnet(env)
+    xlate_bin = repo / 'dm/gfx/tools/dmsh_xlate_bin/dmsh_xlate'   # the fork's check of the root configure_dotnet chose (fork commit d0ed53df; the fork patch nsp-dotnet-root-verify)
+    def xlate_answers(root):
+        e = dict(env)
+        if root: e['DOTNET_ROOT'] = str(root)
+        else: e.pop('DOTNET_ROOT', None)
+        try:
+            r = subprocess.run([str(xlate_bin), '--source-sha'], capture_output=True, text=True, env=e, timeout=120)
+            return r.returncode == 0 and bool(r.stdout.strip())
+        except Exception:
+            return False
+    if xlate_bin.exists() and not xlate_answers(env.get('DOTNET_ROOT')):
+        cands = []
+        if dn := shutil.which('dotnet', path=env['PATH']):
+            real = Path(dn).resolve()
+            for base in (real.parent.parent, real.parent.parent.parent):
+                cands += [base / 'libexec', base]   # Homebrew's bin/../libexec; share/dotnet and aliases
+        cands += [Path.home() / '.dotnet', Path('/usr/local/share/dotnet'), Path('/opt/homebrew/opt/dotnet/libexec')]
+        if hit := next((c for c in cands if c.is_dir() and xlate_answers(c)), None):
+            env['DOTNET_ROOT'] = os.environ['DOTNET_ROOT'] = str(hit)
+            say(f'DOTNET_ROOT: {hit} (verified — the shader translator runs)')
+        elif env.get('DOTNET_ROOT'):
+            del env['DOTNET_ROOT']; os.environ.pop('DOTNET_ROOT', None)
+            say('DOTNET_ROOT: removed (none verified — the apphost searches its default locations)')
     env.setdefault('J', str(os.cpu_count() or 8))   # shader_split.py's and dmsh_build.py's workers (their default is 8)
     py = sys.executable
     app, fam = scan_nsps(nsp_dir)
