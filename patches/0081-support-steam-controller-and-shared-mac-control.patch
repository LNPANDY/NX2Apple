+static void test_split_joycon_routing(void) {
+    for(int merged=0;merged<2;merged++) {
+        g_merge=merged; g_slots=(pad_slots){0}; g_joycon_split=1;
+        JoyConController *pair=[JoyConController new]; native_devices=@[pair];
+        controllers_reconcile(@[pair]); assert(!g_devices.count);
+        joycon_pad left={0},right={0};
+        joycon_init(&left.st,JOYCON_PID_L); joycon_init(&right.st,JOYCON_PID_R);
+        snprintf(left.name,sizeof left.name,"Joy-Con (L)"); snprintf(right.name,sizeof right.name,"Joy-Con (R)");
+        joycon_attach(&left); joycon_attach(&right);
+        DMController *l=controller_for_joycon(&left), *r=controller_for_joycon(&right);
+        assert(l && r && l->slot==0 && r->slot==1 && players==(merged ? 1u : 3u));
+        assert(rumble[0]==pair);
+        if(!merged) assert(rumble[1]==pair && [rumble_locality[0] isEqual:GCHapticsLocalityLeftHandle] && [rumble_locality[1] isEqual:GCHapticsLocalityRightHandle]);
+        DMController *steam=[DMController new]; steam.name=@"Steam Controller"; steam.model=@"Valve Triton";
+        steam->device=(IOHIDDeviceRef)CFRetain(CFSTR("coexisting Steam")); steam->connected=YES; steam_write=fake_write;
+        controller_load_map(steam); [g_devices addObject:steam]; controller_connect(steam);
+        controllers_reconcile(@[pair]); assert(steam->slot==2 && g_devices.count==3 && players==(merged ? 1u : 7u));
+        assert(rumble[0]==pair && (merged || raw_output[2]));
+        controller_disconnect(steam); [g_devices removeObject:steam];
+        uint8_t report[49]={0x30}; report[1]=3; report[14]=16;
+        unsigned before=hid_motion_samples[merged ? 0 : r->slot];
+        joycon_read_motion(&right,report,sizeof report); assert(hid_motion_samples[merged ? 0 : r->slot]>before);
+        unsigned cleared=hid_motion_clears[0];
+        l->map[0]=3; left.st.buttons=DM_BTN_A; left.st.sx=.5f; joycon_read(&left);
