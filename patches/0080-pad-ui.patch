+// ---- Skin layout (DM_PAD_SKIN=1 in dm/env.txt or Documents/env.txt; art in dm/padskin, staged into the bundle by build_ipa.sh) ----
+// Drawn controls are replaced by image controls in the layout of the fan Android port of Silksong: a fixed stick disc
+// bottom-left (its medallion knob follows the touch), the action keys bottom-right in two rows, quick map / inventory / pause
+// small at the top-right. Centres are fractions of the whole screen, radii a fraction of its width. Keys follow the game's
+// Switch defaults. Three skill keys (grp SK_SKILL: tool, Clawline, Needolin) do nothing until the skill is earned and
+// the pad cannot know the game's progress, so the eye key (grp SK_TOGGLE, not a game key) shows or hides them for
+// the session; they start hidden at each launch, the eye in its pressed state (the default the player asked
+// for, set explicitly in init). Holding the eye key for 0.6s instead opens the layout editor: every key (and the
+// stick) can be dragged to a new centre and scaled, the result kept in NSUserDefaults (DmPadCustom, below).
+static BOOL padSkin(void) { const char *e = getenv("DM_PAD_SKIN"); return e && atoi(e); }
+static int silkSkinMode(void) { const char *e = getenv("DM_SILK_SKIN"); int m = e ? atoi(e) : 1; return m < 0 ? 0 : m > 3 ? 3 : m; }   // the launcher's button-skin choice for this pad: 0 glass, 1 the image skin, 2 the letter-badge skin (dm/padskin-badge), 3 the black-iron skin (dm/padskin-metal, the plain set's canvas, so no badge scaling); the image skin (1) when unset
+enum { SK_ALWAYS, SK_SKILL, SK_TOGGLE };
+static const struct { const char *art; int bit; int grp; CGFloat x, y, r; } k_skin[] = {
+    {"attack",   B_Y,     SK_ALWAYS, 0.7859, 0.770, 0.0374},   // needle attack: the fan's left key, level with the jump pivot
+    {"jump",     B_B,     SK_ALWAYS, 0.898, 0.770, 0.0480},   // the fan's pivot at the bottom-right corner, the largest key
+    {"dash",     B_ZR,    SK_ALWAYS, 0.8188, 0.5983, 0.0374},   // Swift Step: tap dashes, hold sprints; the fan's 45-degree key
+    {"tool",     B_R,     SK_SKILL,  0.7103, 0.770, 0.0254},   // the equipped tool: in the attack row between Clawline and attack (swapped with Clawline's seat), a 30pt edge gap each side at the reference size; an eye-key skill key
+    {"needolin", B_X,     SK_SKILL,  0.898, 0.3631, 0.0254},   // Needolin: above Bind in its column, a 30pt edge gap over it at the reference size, in its original round frame; an eye-key skill key (the eye hides it with the other two)
+    {"bind",     B_A,     SK_ALWAYS, 0.898, 0.5271, 0.0374},   // Bind (heal): the fan's top key, straight above the jump pivot
+    {"clawline", B_ZL,    SK_SKILL,  0.6468, 0.770, 0.0254},   // Clawline: in the attack row, leftmost of the three (swapped with the tool's seat), a 30pt edge gap to the tool at the reference size; an eye-key skill key
+    {"eye",      0,       SK_TOGGLE, 0.670, 0.082, 0.0224},   // show / hide the skill keys
+    {"map",      B_L,     SK_ALWAYS, 0.746, 0.082, 0.0224},   // quick map (the top row respaced evenly for four keys, shifted left so pause shares the fan's column)
+    {"bag",      B_MINUS, SK_ALWAYS, 0.822, 0.082, 0.0224},   // inventory
+    {"pause",    B_PLUS,  SK_ALWAYS, 0.898, 0.082, 0.0224},   // in the fan's column, above Bind
+    {"up",       B_UP,    SK_ALWAYS, 0.162, 0.628, 0.022},   // invisible in both skins (fully transparent art, no glass disc): the game's Up + R tool prompts read the D-pad, never the stick. On the stick disc's own up-pointing rim triangle, small enough that its hit circle (r x 1.35) stops well short of the disc centre, so a centred touch still starts the stick; skinCenter keeps it at raw fractions, anchored to the disc rather than the stacking cluster
+};
+#define SKIN_N (int)(sizeof k_skin / sizeof k_skin[0])
+#define SKIN_REF_HW 0.4615   // the screen the skin layout was measured on (19.5:9): its height as a fraction of its width
+static CGPoint skinCenterRaw(int i, CGRect b) {   // the centre of skin key i from the table alone, in points (the layout and the touch hit test share it)
+    CGFloat y = k_skin[i].y;
+    if (y > 0.2 && k_skin[i].bit != B_UP)   // an action key: the rows stack up from the bottom row (y 0.822) in width fractions, so the cluster keeps its phone shape on any screen; the top row stays a height fraction (it hugs the top edge). The D-pad Up key is exempt: it is anchored to the stick disc, which sits at raw fractions
+        y = 0.822 + (y - 0.822) * SKIN_REF_HW * b.size.width / b.size.height;
+    CGPoint c = CGPointMake(k_skin[i].x * b.size.width, y * b.size.height);
+    if (k_skin[i].bit == B_UP && !silkSkinMode())   // the glass choice draws the stick disc at 0.9 (stickR): the Up key's anchor on the disc's rim follows it, scaled about the disc's raw centre (0.162, 0.742, stickHome's)
+        c = CGPointMake((0.162 + (k_skin[i].x - 0.162) * 0.9) * b.size.width, (0.742 + (y - 0.742) * 0.9) * b.size.height);
+    return c;
+}
+// ---- Custom layout (the eye key's long-press editor) ----
+// The player can move every skin key (and the stick) and scale it between 0.6x and 1.6x; per key only the
+// centre's offset from the table (as screen fractions) and the size multiplier are kept, in NSUserDefaults
+// under DmPadCustom like DmPadLayout is, so an over-install keeps them and "restore defaults" is clearing the
+// key. skinCenter and skinR apply them, so the drawing, the hit test and the hit area all agree, in every skin
+// art set (the geometry is shared). The slot SKIN_N is the stick; the invisible Up key rides on it (its centre
+// and size follow the stick's), being anchored to the disc.
+static NSString *const k_custom_key = @"DmPadCustom";
+static CGFloat g_custDX[SKIN_N + 1], g_custDY[SKIN_N + 1], g_custS[SKIN_N + 1];
+static BOOL g_custReady;
+static void custLoad(void) {
+    if (g_custReady) return; g_custReady = YES;
+    for (int i = 0; i <= SKIN_N; i++) g_custS[i] = 1;
+    NSDictionary *d = [NSUserDefaults.standardUserDefaults dictionaryForKey:k_custom_key];
+    for (int i = 0; i <= SKIN_N; i++) {
+        NSDictionary *e = d[i == SKIN_N ? @"stick" : [NSString stringWithUTF8String:k_skin[i].art]];
+        if (!e) continue;
+        g_custDX[i] = [e[@"dx"] doubleValue]; g_custDY[i] = [e[@"dy"] doubleValue];
+        CGFloat s = [e[@"s"] doubleValue]; if (s >= 0.6 && s <= 1.6) g_custS[i] = s;
+    }
+}
+static void custSave(void) {
+    NSMutableDictionary *d = [NSMutableDictionary dictionary];
+    for (int i = 0; i <= SKIN_N; i++) if (g_custDX[i] || g_custDY[i] || g_custS[i] != 1)
+        d[i == SKIN_N ? @"stick" : [NSString stringWithUTF8String:k_skin[i].art]] = @{@"dx": @(g_custDX[i]), @"dy": @(g_custDY[i]), @"s": @(g_custS[i])};
+    [NSUserDefaults.standardUserDefaults setObject:d forKey:k_custom_key];
+}
+static int custSlot(int i) { return k_skin[i].bit == B_UP ? SKIN_N : i; }   // the Up key's slot is the stick's
+static CGFloat skinR(int i) { custLoad(); return k_skin[i].r * g_custS[custSlot(i)]; }   // skin key i's radius (a fraction of the width) with the player's size multiplier
+static CGPoint clampCentre(CGPoint c, CGFloat rp, CGRect b) {   // keep at least ~40% of the key (2 * rp across) on screen
+    CGFloat m = 0.2 * rp;
+    return CGPointMake(fmin(fmax(c.x, -m), b.size.width + m), fmin(fmax(c.y, -m), b.size.height + m));
+}
+static CGPoint skinCenter(int i, CGRect b) {   // the centre the pad draws and hit-tests at: the table's centre plus the player's custom offset
+    custLoad();
+    CGPoint c = skinCenterRaw(i, b); int s = custSlot(i);
+    c.x += g_custDX[s] * b.size.width; c.y += g_custDY[s] * b.size.height;
+    return clampCentre(c, skinR(i) * b.size.width, b);
+}
+#define SILK_BADGE_SCALE (1020.0 / 880.0)   // the badge set's canvas over the plain set's (the disc sits centred in the larger canvas, badge medallion below it)
+static BOOL silkBadged(const char *name) {   // the padskin keys the badge set bakes a letter medallion into: every k_skin art but the Up key (invisible in both skins, never badged); the eye carries its ON / OFF state word instead of a letter
+    static const char *const badged[] = {"attack", "jump", "dash", "tool", "needolin", "bind", "clawline", "eye", "map", "bag", "pause"};
+    for (int i = 0; i < (int)(sizeof badged / sizeof *badged); i++) if (!strcmp(name, badged[i])) return YES;
+    return NO;
+}
+static CGFloat silkArtScale(const char *name) {   // a badged key's layer grows by this in badge mode, so the disc itself lands at the plain skin's size and place; unbadged art keeps 1
+    return silkSkinMode() == 2 && silkBadged(name) ? SILK_BADGE_SCALE : 1.0;
+}
+static NSString *silkGlyph(int i) {   // a skin key's glass glyph, by art name: letters for the game keys, nil for the Up key (no glass disc at all) and for the keys drawn as symbols or a dot (the - / + bars, the eye)
+    const char *a = k_skin[i].art;
+    if (!strcmp(a, "attack")) return @"Y"; if (!strcmp(a, "jump")) return @"B"; if (!strcmp(a, "dash")) return @"ZR";
+    if (!strcmp(a, "tool")) return @"R"; if (!strcmp(a, "needolin")) return @"X"; if (!strcmp(a, "bind")) return @"A";
+    if (!strcmp(a, "clawline")) return @"ZL"; if (!strcmp(a, "map")) return @"L";
+    return nil;
+}
+static UIImage *skinImage(const char *name) {   // a padskin image, loaded once and cached (nil when the file is absent); the badge mode reads the dm/padskin-badge set and the black-iron mode the dm/padskin-metal set instead (same names, the mode is fixed for the process, so one cache serves all)
+    static NSMutableDictionary *cache;
+    if (!cache) cache = [[NSMutableDictionary alloc] init];
+    NSString *key = [NSString stringWithUTF8String:name];
+    UIImage *im = cache[key];
+    if (!im) {
+        NSString *p = [NSBundle.mainBundle.resourcePath stringByAppendingPathComponent:[NSString stringWithFormat:silkSkinMode() == 2 ? @"dm/padskin-badge/%s.png" : silkSkinMode() == 3 ? @"dm/padskin-metal/%s.png" : @"dm/padskin/%s.png", name]];
+        im = [UIImage imageWithContentsOfFile:p];
+        if (im) cache[key] = im;
+    }
+    return im;
+}
+static UIImage *skinPressedImage(int i) {   // the pressed-state art (<art>_p) for skin key i, or nil when the skin ships none
+    char pn[64]; snprintf(pn, sizeof pn, "%s_p", k_skin[i].art); return skinImage(pn);
+}
+static UIImage *namedPressedImage(const char *name) {   // the pressed-state art (<name>_p) for a named padskin image, or nil when the skin ships none
+    char pn[64]; snprintf(pn, sizeof pn, "%s_p", name); return skinImage(pn);
+}
+// ---- Bag layout (pad mode 4: the inventory is open) ----
+// While the inventory is open the combat pad gives way to nine keys of its own: a D-pad of four separate keys at the left
+// (the stick and its disc go away), X / A / B in a column at the right, and L / R alone at the top, for the inventory's
+// tabs. The layout is the measured one approved on the inventory's own screenshot (1564x720, the 19.5:9 frame): each
+// side's keys centre in the black bar between the inventory's white frame and the screen edge, the two groups share one
+// horizontal line (y 0.6389), and B sat at the combat bottom row's own height (the column scaling below lifts it a
+// hair). The D-pad cross was widened after the
+// first on-device pass: bigger keys (r 0.0248), the vertical pair spread further apart (72 in the frame) and the
+// horizontal pair drawn closer in (52), the group centre unmoved. The X / A / B column is scaled by the combat
+// cluster's own factor (0.9731) about A -- A keeps the groups' shared line and B ends a hair above the combat
+// bottom row -- so the two layouts' right-hand keys shrink together. The X key shows only on the crests tab
+// (bagXShown). Centres and radii follow the k_skin
+// convention, skinCenter's stacking included but without the Up key's disc exemption (the four D-pad keys move as one
+// cross). The art is the bag set in dm/padskin and dm/padskin-badge, made by dm/ios/tools/make_bagskin.py; dir is
+// triPath's order, for the glass keys' arrows
+static const struct { const char *art; int bit; int dir; CGFloat x, y, r; } k_bag[] = {
+    {"bagdup",    B_UP,    1, 0.0716, 0.5389, 0.0248},
+    {"bagddown",  B_DOWN,  2, 0.0716, 0.7389, 0.0248},
+    {"bagdleft",  B_LEFT,  0, 0.0384, 0.6389, 0.0248},
+    {"bagdright", B_RIGHT, 3, 0.1049, 0.6389, 0.0248},
+    {"bagx",       B_X,    -1, 0.9316, 0.4605, 0.0390},
+    {"baga",       B_A,    -1, 0.9316, 0.6390, 0.0390},
+    {"bagb",       B_B,    -1, 0.9316, 0.8172, 0.0390},
+    {"bagl",       B_L,    -1, 0.0716, 0.075,  0.023},
+    {"bagr",       B_R,    -1, 0.9316, 0.075,  0.023},
+};
+#define BAG_N (int)(sizeof k_bag / sizeof k_bag[0])
+#define BAG_X 4   // the X key's row in k_bag: it serves the crests tab alone, so it shows only while that tab is up (bagXShown)
+static CGPoint bagCenter(int i, CGRect b) {   // bag key i's centre, in points (the layout and the touch hit test share it)
+    CGFloat y = k_bag[i].y;
+    if (y > 0.2) y = 0.822 + (y - 0.822) * SKIN_REF_HW * b.size.width / b.size.height;
+    return CGPointMake(k_bag[i].x * b.size.width, y * b.size.height);
+}
+static NSString *bagGlyph(int i) {   // a bag key's glass glyph: the letter keys'; the D-pad keys carry a triangle instead
+    const char *a = k_bag[i].art;
+    if (!strcmp(a, "bagx")) return @"X"; if (!strcmp(a, "baga")) return @"A"; if (!strcmp(a, "bagb")) return @"B";
+    if (!strcmp(a, "bagl")) return @"L"; if (!strcmp(a, "bagr")) return @"R";
+    return nil;
+}
+static UIImage *bagPressedImage(int i) {   // the pressed-state art (<art>_p) for bag key i, or nil when the set ships none
+    char pn[64]; snprintf(pn, sizeof pn, "%s_p", k_bag[i].art); return skinImage(pn);
+}
+static CGFloat bagArtScale(void) {   // every bag key ships a badge version (its disc offset in the larger canvas, no medallion below it), so the badge choice grows the layer as a badged key's
+    return silkSkinMode() == 2 ? SILK_BADGE_SCALE : 1.0;
+}
+// ---- Title and settings layouts (pad modes 5, 6 and 7) ----
+// On the menu pages (mode 5: the title screen and the options branch's pages -- options, the save
+// select, sound, game options, extras -- and, while the game is paused, the pause menu, its
+// save-and-quit confirm and its own options branch) the combat pad gives way to a D-pad of four
+// separate keys at the left (k_tpad, the bag page's plus arrangement at equal pitch, in place of
+// the stick, which is gone there entirely) and two letter keys, stacked in
+// the bag page's right-hand column: A at the bag page's A seat sending A, B at its B seat below it
+// sending B -- the pair renders exactly as the inventory's own A / B, so the menus take the D-pad
+// and a confirm / back pair and nothing else covers the
+// menu art. On the achievements page (mode 7) only B of the pair shows, at its own seat: the list
+// scrolls on the D-pad and B is the page's only way out. On the controller pages (mode 6: the game's controller diagram and its key-binding page)
+// every key shows at its own seat as its letter instead of its icon, the skill keys included, so each key
+// names the button it sends while the binding page is worked; the eye shows there too, as its icon
+// (it has no letter; the glass choice shows its ON / OFF state word instead), and its tap still
+// flips the skill keys' visibility for the play pages, and the Up key stays invisible, as
+// in every mode. The letter art is the let* set in dm/padskin and
+// dm/padskin-badge, made by dm/ios/tools/make_bagskin.py; the glass skin needs no extra art, its keys'
+// glyphs (silkGlyph) being the same letters
+static const struct { const char *art; int bit; CGFloat x, y, r; } k_title[] = {
+    {"leta", B_A, 0.9316, 0.6390, 0.0390},   // A at the bag page's A seat (k_bag's baga row), so the pair stacks as the inventory's
+    {"letb", B_B, 0.9316, 0.8172, 0.0390},   // B at the bag page's B seat (k_bag's bagb row)
+};
+#define TITLE_N (int)(sizeof k_title / sizeof k_title[0])
+static CGPoint titleCenter(int j, CGRect b) {   // title key j's centre, in points (bagCenter's remap, so the pair lands on the bag page's seats on any screen)
+    CGFloat y = k_title[j].y;
+    if (y > 0.2) y = 0.822 + (y - 0.822) * SKIN_REF_HW * b.size.width / b.size.height;
+    return CGPointMake(k_title[j].x * b.size.width, y * b.size.height);
+}
+static const char *silkLetter(int i) {   // skin key i's letter art on the controller pages, or nil where a key has none (the eye, which hides there instead, and the Up key, invisible in every mode)
+    const char *a = k_skin[i].art;
+    if (!strcmp(a, "attack")) return "lety"; if (!strcmp(a, "jump")) return "letb"; if (!strcmp(a, "dash")) return "letzr";
+    if (!strcmp(a, "tool")) return "letr"; if (!strcmp(a, "needolin")) return "letx"; if (!strcmp(a, "bind")) return "leta";
+    if (!strcmp(a, "clawline")) return "letzl"; if (!strcmp(a, "map")) return "letl"; if (!strcmp(a, "bag")) return "letminus";
+    if (!strcmp(a, "pause")) return "letplus";
+    return nil;
+}
+static CGFloat letArtScale(void) {   // every letter key ships a badge version on the bag keys' terms, so the badge choice grows the layer as theirs
+    return silkSkinMode() == 2 ? SILK_BADGE_SCALE : 1.0;
+}
+// ---- Title D-pad (pad modes 5 and 7: the menu pages' direction keys, in place of the stick) ----
+// Four separate keys in the bag page's plus arrangement, but at equal pitch both ways (the bag
+// page's horizontal squeeze dodges the inventory's art; the menu pages have nothing to dodge):
+// on the reference screen each key is 125 across, the centres 120 apart in both axes (the
+// four keys overlap by 5), the cluster centred at
+// (0.1077, 0.7222). dir is triPath's order, for the glass keys' arrows; the art is the bag
+// set's own D-pad art (bagd*)
+static const struct { const char *art; int bit; int dir; CGFloat x, y, r; } k_tpad[] = {
+    {"bagdleft",  B_LEFT,  0, 0.0565, 0.7222, 0.02666},
+    {"bagdup",    B_UP,    1, 0.1077, 0.6111, 0.02666},
+    {"bagddown",  B_DOWN,  2, 0.1077, 0.8333, 0.02666},
+    {"bagdright", B_RIGHT, 3, 0.1589, 0.7222, 0.02666},
+};
+#define TPAD_N (int)(sizeof k_tpad / sizeof k_tpad[0])
+static CGPoint tpadCenter(int j, CGRect b) {   // title D-pad key j's centre, in points (titleCenter's remap, so the cross keeps its shape on any screen)
+    CGFloat y = k_tpad[j].y;
+    if (y > 0.2) y = 0.822 + (y - 0.822) * SKIN_REF_HW * b.size.width / b.size.height;
+    return CGPointMake(k_tpad[j].x * b.size.width, y * b.size.height);
+}
+static CALayer *imgLayer(CALayer *parent, const char *name) {
+    CALayer *l = [CALayer layer]; l.contents = (id)skinImage(name).CGImage; [parent addSublayer:l]; return l;
+}
+static UIImage *glassMedallionImage(const char *name) {   // a glass-choice cutscene medallion from dm/padskin-glass (the glass skin's own Skip and ON discs), loaded once and cached (nil when the file is absent)
+    static NSMutableDictionary *cache;
+    if (!cache) cache = [[NSMutableDictionary alloc] init];
+    NSString *key = [NSString stringWithUTF8String:name];
+    UIImage *im = cache[key];
+    if (!im) {
+        NSString *p = [NSBundle.mainBundle.resourcePath stringByAppendingPathComponent:[NSString stringWithFormat:@"dm/padskin-glass/%s.png", name]];
+        im = [UIImage imageWithContentsOfFile:p];
