+}
+static UIImage *medallionImage(const char *name) {   // a cutscene medallion's image for the current choice: the glass choice reads its own set, the image skins theirs
+    return silkSkinMode() ? skinImage(name) : glassMedallionImage(name);
+}
+
+// ---- Hades layout (DM_PAD_HADES=1 in an env file) ----
+// The touch layout of the earlier Hades II port this build replaces, measured from its recordings: a row of small keys at the
+// top right, the face keys in a quarter-circle fan around a larger Y, four separate D-pad circles along the bottom, and a
+// floating left stick. The keys are clear dark discs (a translucent black fill and a thin light rim, no material
+// blur): a view per key, with its label and a press wash as plain layers above it. Centres are fractions of the
+// whole screen, radii of its width — except the fan keys' y, which is an offset from Y's centre in width fractions
+// (hadesCenter), so the quarter circle keeps its shape on a taller screen (an iPad's); on the phone the layout was
+// measured on, the centres come out as before.
+static BOOL padHades(void) { const char *e = getenv("DM_PAD_HADES"); return e && atoi(e); }
+static int hadesSkinMode(void) { const char *e = getenv("DM_HADES_SKIN"); int m = e ? atoi(e) : 1; return m < 0 ? 0 : m > 2 ? 2 : m; }   // the launcher's button-skin choice: 0 glass, 1 the image skin, 2 the letter-badge skin (dm/hadesskin-badge); the image skin (1) when unset
+static UIImage *hadesImage(const char *name) {   // a hadesskin image, loaded once and cached (nil when the file is absent); the badge mode reads the dm/hadesskin-badge set instead (same names, the mode is fixed for the process, so one cache serves both)
+    static NSMutableDictionary *cache;
+    if (!cache) cache = [[NSMutableDictionary alloc] init];
+    NSString *key = [NSString stringWithUTF8String:name];
+    UIImage *im = cache[key];
+    if (!im) {
+        NSString *p = [NSBundle.mainBundle.resourcePath stringByAppendingPathComponent:[NSString stringWithFormat:hadesSkinMode() == 2 ? @"dm/hadesskin-badge/%s.png" : @"dm/hadesskin/%s.png", name]];
+        im = [UIImage imageWithContentsOfFile:p];
+        if (im) cache[key] = im;
+    }
+    return im;
+}
+static CALayer *hadesImgLayer(CALayer *parent, const char *name) {
+    CALayer *l = [CALayer layer]; l.contents = (id)hadesImage(name).CGImage; [parent addSublayer:l]; return l;
+}
+enum { H_TOP, H_FACE, H_DPAD };   // a D-pad entry carries a direction in dir (0 left, 1 up, 2 down, 3 right) and no label
+static const struct { int bit; int kind; int dir; const char *label; CGFloat x, y, r; } k_hades[] = {
+    {B_MINUS, H_TOP,  0, "−", 0.691, 0.086, 0.020},
+    {B_PLUS,  H_TOP,  0, "+",  0.754, 0.086, 0.020},
+    {B_L,     H_TOP,  0, "L",  0.817, 0.086, 0.020},
+    {B_ZL,    H_TOP,  0, "ZL", 0.880, 0.086, 0.020},
+    {B_ZR,    H_TOP,  0, "ZR", 0.943, 0.086, 0.020},
+    {B_R,     H_FACE, 0, "R",  0.903, -0.1451, 0.031},   // fan keys: y = offset from Y's centre, in width fractions; the four centres sit on a radius of 0.1451 about Y's centre, at 0/30/60/90 degrees from straight above Y
+    {B_A,     H_FACE, 0, "A",  0.8305, -0.1257, 0.031},
+    {B_X,     H_FACE, 0, "X",  0.7773, -0.0726, 0.031},
+    {B_B,     H_FACE, 0, "B",  0.758,  0.0,    0.031},
+    {B_Y,     H_FACE, 0, "Y",  0.903,  0.715,  0.038},
+    {B_LEFT,  H_DPAD, 0, NULL, 0.645, 0.896, 0.019},
+    {B_UP,    H_DPAD, 1, NULL, 0.701, 0.896, 0.019},
+    {B_DOWN,  H_DPAD, 2, NULL, 0.753, 0.896, 0.019},
+    {B_RIGHT, H_DPAD, 3, NULL, 0.807, 0.896, 0.019},
+};
+#define HADES_N (int)(sizeof k_hades / sizeof k_hades[0])
+static const char *k_hadesArt[HADES_N] = {"minus", "plus", "l", "zl", "zr", "r", "a", "x", "b", "y", "left", "up", "down", "right"};   // dm/hadesskin art per k_hades key, same order
+#define HADES_ART_F 0.875   // the art's disc diameter as a fraction of its square canvas (448 of 512, keys and stick alike)
+static BOOL hadesBadged(const char *name) {   // the hadesskin keys the badge set bakes a letter medallion into: the ten letter keys (the D-pad arrows, the stick and the knob stay plain)
+    static const char *const badged[] = {"minus", "plus", "l", "zl", "zr", "r", "a", "x", "b", "y"};
+    for (int i = 0; i < (int)(sizeof badged / sizeof *badged); i++) if (!strcmp(name, badged[i])) return YES;
+    return NO;
+}
+static CGFloat hadesArtF(const char *name) {   // a key's art fraction: in badge mode a badged key's canvas is 594 for the same 448 disc, so its layer grows to keep the disc itself at the plain skin's size and place
+    return hadesSkinMode() == 2 && hadesBadged(name) ? 448.0 / 594.0 : HADES_ART_F;
+}
+static CGPoint hadesCenter(int i, CGRect b) {   // the centre of Hades key i, in points
+    CGFloat y = k_hades[i].y;
+    if (k_hades[i].kind == H_FACE && k_hades[i].bit != B_Y) {   // a fan key: its y is an offset from Y's centre in width fractions
+        static int yi = -1;
+        if (yi < 0) for (int j = 0; j < HADES_N; j++) if (k_hades[j].bit == B_Y) yi = j;
+        y = k_hades[yi].y + y * b.size.width / b.size.height;
+    }
+    return CGPointMake(k_hades[i].x * b.size.width, y * b.size.height);
+}
+static UIView *clearDisc(UIView *parent, CGFloat tint) {
+    // A plain translucent disc: a black fill at the given alpha and a thin light rim, nothing else.
+    // The keys first used the system Liquid Glass material here (UIGlassEffect, regular style): over a
+    // bright scene it reads as frosted grey and hides the game behind the key, so the discs are plain
+    // now, like the earlier Hades II port's keys.
+    UIView *v = [[UIView alloc] init];
+    v.backgroundColor = [UIColor colorWithWhite:0 alpha:tint];
+    v.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.35].CGColor;
+    v.layer.borderWidth = 1;
+    v.userInteractionEnabled = NO;
+    [parent addSubview:v];
+    return v;
+}
+
+// ---- The silk pad's glass discs (the glass choice, DM_SILK_SKIN=0), restyled ----
+// A clear glass lens, matched to the approved preview: a near-clear face (white at 0.068 with a
+// directional lift to 0.092 at the top edge; nothing else on the face -- no specular blob, no sheen
+// wash, no arc line), a narrow bevel rim in the outer 5.3% of the radius lit from above (white to
+// 0.45 at the top, 0.08 at the sides, a dark glass edge, RGB 20/24/34, to 0.31 at the bottom) with
+// a dark hairline at the very edge (0.39), and a soft drop shadow under the disc (black 0.39,
+// offset 2% of the diameter down). There is no band inside the rim: a refraction band drawn low
+// inside it landed on the disc's upper half in the layer's coordinates and read as a grey stripe.
+// The three sublayers (face gradient, conic rim gradient, edge) are sized by
+// glassDiscLayout at the disc's radius; the view itself carries only the shadow.
+//
+// The image skins' art keeps its visible disc at 819 of its 880 canvas, while a drawn glass disc
+// fills its whole frame (and carries a shadow), so at the same table radius the glass keys read
+// larger than the image skins'. The glass BUTTON discs therefore draw at 0.93 of their nominal
+// radius, centred on the seat, their glyphs and press washes scaled with them; the stick and the
+// knob are not buttons and keep their own sizes.
+#define GLASS_BTN_F 0.93
+static UIView *glassDisc(UIView *parent) {
+    UIView *v = [[UIView alloc] init];
+    v.backgroundColor = UIColor.clearColor;
+    v.userInteractionEnabled = NO;
+    CAGradientLayer *face = [CAGradientLayer layer];
+    face.colors = @[(id)[UIColor colorWithWhite:1 alpha:0.092].CGColor, (id)[UIColor colorWithWhite:1 alpha:0.068].CGColor];
+    face.startPoint = CGPointMake(0.5, 0); face.endPoint = CGPointMake(0.5, 1);
+    CAShapeLayer *faceMask = [CAShapeLayer layer]; face.mask = faceMask;
+    [v.layer addSublayer:face];
+    CAGradientLayer *rim = [CAGradientLayer layer];
+    rim.type = kCAGradientLayerConic;
+    rim.startPoint = CGPointMake(0.5, 0.5); rim.endPoint = CGPointMake(0.5, 0);   // location 0 at the top, sweeping clockwise: right side, bottom, left side
+    rim.colors = @[(id)[UIColor colorWithWhite:1 alpha:0.45].CGColor,
+                   (id)[UIColor colorWithWhite:1 alpha:0.08].CGColor,
+                   (id)[UIColor colorWithRed:20.0 / 255 green:24.0 / 255 blue:34.0 / 255 alpha:0.31].CGColor,
+                   (id)[UIColor colorWithWhite:1 alpha:0.08].CGColor,
+                   (id)[UIColor colorWithWhite:1 alpha:0.45].CGColor];
+    rim.locations = @[@0, @0.25, @0.5, @0.75, @1];
+    CAShapeLayer *rimMask = [CAShapeLayer layer]; rimMask.fillRule = kCAFillRuleEvenOdd; rim.mask = rimMask;
+    [v.layer addSublayer:rim];
+    CAShapeLayer *edge = [CAShapeLayer layer]; edge.fillColor = nil;
+    edge.strokeColor = [UIColor colorWithRed:22.0 / 255 green:26.0 / 255 blue:38.0 / 255 alpha:0.39].CGColor;
+    [v.layer addSublayer:edge];
+    v.layer.shadowColor = UIColor.blackColor.CGColor; v.layer.shadowOpacity = 0.39;
+    [parent addSubview:v];
+    return v;
+}
+static void glassDiscLayout(UIView *v, CGFloat r) {   // size a glass disc's sublayers for radius r (points); the caller sets the view's frame to the 2r square
+    CGRect b = CGRectMake(0, 0, 2 * r, 2 * r);
+    CAGradientLayer *face = (CAGradientLayer *)v.layer.sublayers[0];
+    face.frame = b;
+    CAShapeLayer *faceMask = (CAShapeLayer *)face.mask; faceMask.frame = b;
+    CGPathRef fp = CGPathCreateWithEllipseInRect(b, NULL); faceMask.path = fp; CGPathRelease(fp);
+    CAGradientLayer *rim = (CAGradientLayer *)v.layer.sublayers[1];
+    rim.frame = b;
+    CGMutablePathRef rp = CGPathCreateMutable();
+    CGPathAddEllipseInRect(rp, NULL, b);
+    CGPathAddEllipseInRect(rp, NULL, CGRectInset(b, 0.053 * r, 0.053 * r));   // the bevel band: the outer 5.3% of the radius
+    CAShapeLayer *rimMask = (CAShapeLayer *)rim.mask; rimMask.frame = b; rimMask.path = rp; CGPathRelease(rp);
+    CAShapeLayer *edge = (CAShapeLayer *)v.layer.sublayers[2];
+    CGFloat lw = fmax(1, 0.014 * r); edge.lineWidth = lw;
+    CGPathRef ep = CGPathCreateWithEllipseInRect(CGRectInset(b, lw / 2, lw / 2), NULL); edge.path = ep; CGPathRelease(ep);
+    v.layer.shadowRadius = 0.12 * r; v.layer.shadowOffset = CGSizeMake(0, 0.04 * r);
+    CGPathRef sp = CGPathCreateWithEllipseInRect(b, NULL); v.layer.shadowPath = sp; CGPathRelease(sp);
+}
+static void placeGlassLabel(CATextLayer *t, CGPoint c, CGFloat fs) {   // a glass key's glyph: the rounded bold design, white at 0.95 with a soft dark emboss below it (the drawn-glass restyle)
+    UIFont *f = [UIFont systemFontOfSize:fs weight:UIFontWeightHeavy];
+    UIFontDescriptor *rd = [f.fontDescriptor fontDescriptorWithDesign:UIFontDescriptorSystemDesignRounded];
+    if (rd) f = [UIFont fontWithDescriptor:rd size:fs];
+    CTFontRef cf = CTFontCreateWithFontDescriptor((__bridge CTFontDescriptorRef)f.fontDescriptor, fs, NULL);
+    t.font = cf; t.fontSize = fs;
+    t.foregroundColor = [UIColor colorWithWhite:1 alpha:0.95].CGColor;
+    t.shadowColor = UIColor.blackColor.CGColor; t.shadowOpacity = 0.27; t.shadowOffset = CGSizeMake(0, 1); t.shadowRadius = 0;
+    CGFloat h = CTFontGetAscent(cf) + CTFontGetDescent(cf) + CTFontGetLeading(cf), w = fs * 3;
+    t.frame = CGRectMake(c.x - w / 2, c.y - h / 2, w, h);
+    CFRelease(cf);
+}
