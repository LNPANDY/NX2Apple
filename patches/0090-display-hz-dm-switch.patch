--- a/dm/games/settings.tsv
+++ b/dm/games/settings.tsv
@@ -16,7 +16,7 @@
 #             level=basic  a setting a front end shows first;  needs=<VAR>=<value>  a sub-setting, drawn only while the row that sets <VAR> has that value
 DM_FPS_TARGET	choice	30=30 fps,60=60 fps	DM_GAME_FPS_TARGET	DM_GAME_FPS_TARGET!=0	Game	Frame rate		level=basic
 DM_DYNAMIC_RESOLUTION	toggle	-	0	fixups:DYNAMIC_RESOLUTION	Game	Dynamic resolution	Adjusts resolution between 70% and 100% under load. Turn off to keep full resolution for the selected console mode.
-SS_DISPLAY_HZ	choice	60=60 Hz,120=120 Hz	60	DM_GAME_DISPLAY_HZ!=0	Game	Refresh rate	120 Hz needs a screen that supports it and falls back to 60 Hz on one that does not. Sustained heavy load may throttle with heat, so use it with care.	
+DM_DISPLAY_HZ	choice	60=60 Hz,120=120 Hz	60	DM_GAME_DISPLAY_HZ!=0	Game	Refresh rate	120 Hz needs a screen that supports it and falls back to 60 Hz on one that does not. Sustained heavy load may throttle with heat, so use it with care.	
 DM_RENDER_SCALE	range	0.5:1.0:0.05	1.0	fixups:RENDER_SCALE	Game	Render scale		level=basic
 DM_OPMODE	choice	1=Docked,0=Handheld	DM_GAME_OPMODE	always	Game	Console mode		level=basic
 DM_PRESENT_UPSCALE	choice	off=Standard,metalfx=MetalFX	off	always	Game	Upscaling	Uses more GPU time and can increase heat.
diff --git a/dm/ios/Sources/front_ios.m b/dm/ios/Sources/front_ios.m
index 0ef51e2..858f78a 100644
--- a/dm/ios/Sources/front_ios.m
+++ b/dm/ios/Sources/front_ios.m
@@ -86,7 +86,7 @@ static int front_ios_render_width_h(int height) {
 }
 static int front_ios_render_width(void) { return front_ios_render_width_h(1080); }
 
-// The launcher's frame-rate choice (SS_DISPLAY_HZ, settings.tsv; only a game whose profile offers it, game.tsv display_hz, shows
+// The launcher's frame-rate choice (DM_DISPLAY_HZ, settings.tsv; only a game whose profile offers it, game.tsv display_hz, shows
 // the choice): 60, 120, or 120 at a lowered render size. The choice is a request, not a fact: the display link below asks the
 // screen for 80-120 Hz and measures the rate the screen truly runs at, and only a rate that holds for 30 display frames is
 // handed to the host (dm_display_set_hz, hle_nvn.c), which moves the present tick, the present display link and the vi vsync
@@ -94,8 +94,8 @@ static int front_ios_render_width(void) { return front_ios_render_width_h(1080);
 // The lowered tier renders at 1912x880, the touch port of Silksong's 1916x882 tier taken to a multiple of 8 (a render width
 // must be one, loader.c: 1916 was refused there and the full width used instead, which squeezed the picture): the
 // width goes through the state page's docked cell as any render width does, the height through DM_RENDER_HEIGHT (loader.c)
-static int front_ios_display_hz(void) { const char *e = getenv("SS_DISPLAY_HZ"); return e ? atoi(e) : 60; }
-static int front_ios_display_lowered(void) { const char *e = getenv("SS_DISPLAY_HZ"); return e && strchr(e, 'L') != NULL; }
+static int front_ios_display_hz(void) { const char *e = getenv("DM_DISPLAY_HZ"); return e ? atoi(e) : 60; }
+static int front_ios_display_lowered(void) { const char *e = getenv("DM_DISPLAY_HZ"); return e && strchr(e, 'L') != NULL; }
 
 @interface DmRateLink : NSObject
 @property (nonatomic, strong) CADisplayLink *link;
@@ -112,7 +112,7 @@ static DmRateLink *g_rate_link;
     g_rate_link.link = [CADisplayLink displayLinkWithTarget:g_rate_link selector:@selector(tick:)];
     g_rate_link.link.preferredFrameRateRange = CAFrameRateRangeMake(80, 120, 120);
     [g_rate_link.link addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
-    LOG("front end: display rate %d Hz requested; the rate the screen holds decides (SS_DISPLAY_HZ)", want);
+    LOG("front end: display rate %d Hz requested; the rate the screen holds decides (DM_DISPLAY_HZ)", want);
 }
 - (void)tick:(CADisplayLink *)link {
     double dt = link.targetTimestamp > link.timestamp ? link.targetTimestamp - link.timestamp : 0;
