From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiaoge-tou <85100527+Tiaoge-tou@users.noreply.github.com>
Date: Wed, 4 Nov 2026 08:30:10 +0800
Subject: [PATCH] Rename the frame-rate switch SS_DISPLAY_HZ to DM_DISPLAY_HZ

The shell's launcher profile parser refuses any settings row whose env is not a DM_ switch, so both games of the first shell package show a damaged settings list on device. The name came across with the 120 Hz port (0077) from a launcher that did not check. Rename the settings row, the front end's getenv, the guard test and the comments, register the switch in docs/env_switches.tsv, and rename the l10n keys with it (frontend/l10n, in the outer change).

Upstream-Status: fork-only
Reason: the shell refuses SS_DISPLAY_HZ as a settings row (not a DM_ switch), leaving both games of the shell package with a damaged settings list
Issue: Tiaoge-tou/NX2Apple PROJECT.md Phase 4

---
 dm/games/010013C00E930000/game.tsv  | 2 +-
 dm/games/0100A00019DE0000/game.tsv  | 2 +-
 dm/games/game.py                    | 2 +-
 dm/games/settings.tsv               | 2 +-
 dm/ios/Sources/front_ios.m          | 8 ++++----
 dm/tools/tests/test_merge_guards.py | 2 +-
 docs/env_switches.tsv               | 1 +
 7 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/dm/games/010013C00E930000/game.tsv b/dm/games/010013C00E930000/game.tsv
index fd22f3c..7660438 100644
--- a/dm/games/010013C00E930000/game.tsv
+++ b/dm/games/010013C00E930000/game.tsv
@@ -60,7 +60,7 @@ shader_note	Hollow Knight: Silksong shaders
 # the reciprocal of the docked present stretch on the actual screen, the 0.856603 of the iPad mini falling out of the
 # same formula -- with the written pattern kept as the fallback when no render width is published.
 serve_patch	n:menu_title.bundle@6E3E5C:41030A3D>4129C10A@6EAA5C:00000000>401ADB34@6EAA6C:*3F5B4A53>3F800000 w:menu_title.bundle@6E3E5C:41030A3D>40B8A6E1>40B8A6E1@6EAA5C:00000000>C01ADB34>C01ADB34
-# The launcher's frame-rate choice (settings.tsv SS_DISPLAY_HZ): 60, 120 at the full render size, or 120 at a lowered render size
+# The launcher's frame-rate choice (settings.tsv DM_DISPLAY_HZ): 60, 120 at the full render size, or 120 at a lowered render size
 # (1916x882, the size the touch port measured on this class of screen). The front end drives the present, the present link and the
 # vi vsync event at the rate it measures on the screen, and falls back to 60 when the screen cannot hold 120 (hle_nvn.c)
 display_hz	120
diff --git a/dm/games/0100A00019DE0000/game.tsv b/dm/games/0100A00019DE0000/game.tsv
index 2240f7a..032a7ec 100644
--- a/dm/games/0100A00019DE0000/game.tsv
+++ b/dm/games/0100A00019DE0000/game.tsv
@@ -44,7 +44,7 @@ zip_store	.bank:.bik:.fsb:.gpk:.nro:.pkg:.xnb:.metallib
 # the engine renders the wide picture itself instead of the present stretching a 1920x1080 one
 display_wide	on
 
-# The launcher offers the frame-rate choice (SS_DISPLAY_HZ): the front end drives the present, the present link and the
+# The launcher offers the frame-rate choice (DM_DISPLAY_HZ): the front end drives the present, the present link and the
 # vi vsync event at the rate it measures on the screen, and falls back to 60 when the screen cannot hold 120 (hle_nvn.c).
 # Whether this engine follows past 60 is unmeasured (it has no hle_fpslock row for its build yet): an experiment, 2026-10-27.
 display_hz	120
diff --git a/dm/games/game.py b/dm/games/game.py
index f65017c..11c3e5c 100644
--- a/dm/games/game.py
+++ b/dm/games/game.py
@@ -97,7 +97,7 @@ def header(g):
     if pi not in ('game', 'display'): sys.exit(f'{g.id}: present_interval must be game or display: {pi}')
     ft = g.get('fps_target', '0')   # frame rate cap of the rewriter's frame step (FRAME_STEP in the profile's patches.py: Tears of the Kingdom 1.4.3, Breath of the Wild 1.9.0) or of the engine's own frame limit (hle_fpslock.c): 0 = the game's own step, 30 / 60
     if ft not in ('0', '30', '60'): sys.exit(f'{g.id}: fps_target must be 0, 30 or 60: {ft}')
-    dh = g.get('display_hz', '0')   # the highest display rate the launcher's frame-rate choice offers (settings.tsv SS_DISPLAY_HZ; the iOS front end drives the present, the present link and the vi vsync event at a rate it measures on the screen, hle_nvn.c): 0 = no choice, 60 Hz only; 120 = the 120 Hz tiers
+    dh = g.get('display_hz', '0')   # the highest display rate the launcher's frame-rate choice offers (settings.tsv DM_DISPLAY_HZ; the iOS front end drives the present, the present link and the vi vsync event at a rate it measures on the screen, hle_nvn.c): 0 = no choice, 60 Hz only; 120 = the 120 Hz tiers
     if dh not in ('0', '120'): sys.exit(f'{g.id}: display_hz must be 0 or 120: {dh}')
     fh = g.get('fps_hold', 'on')   # whether the frame step may hold a frame longer than the cap's vsyncs when frames come late (hle_nvn.c fstep_tick): on / off
     if fh not in ('on', 'off'): sys.exit(f'{g.id}: fps_hold must be on or off: {fh}')
diff --git a/dm/games/settings.tsv b/dm/games/settings.tsv
