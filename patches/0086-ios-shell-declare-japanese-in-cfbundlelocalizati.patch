From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Haseenesss <Haseenesss@gmail.com>
Date: Sat, 7 Nov 2026 10:09:58 +0900
Subject: [PATCH] ios shell: declare Japanese in CFBundleLocalizations

Upstream-Status: fork-only
Reason: frontend/l10n/ja.json adds Japanese, and iOS offers a language to the shell's package bundles only when the app declares it, so Japanese devices got English.
Issue: LNPANDY/NX2Apple#718
---
 dm/ios/project-shell.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dm/ios/project-shell.yml b/dm/ios/project-shell.yml
index 60fda10..aecb47f 100644
--- a/dm/ios/project-shell.yml
+++ b/dm/ios/project-shell.yml
@@ -40,7 +40,7 @@ targets:
       path: Gen/Info.plist
       properties:
         CFBundleDisplayName: ${DM_SHELL_NAME}
-        CFBundleLocalizations: [en, de, fr, it, sv, zh-Hans]   # one per file of frontend/l10n (tools/l10n_shell_catalogs.py), iOS offers only the declared ones to the package bundles
+        CFBundleLocalizations: [en, de, fr, it, ja, sv, zh-Hans]   # one per file of frontend/l10n (tools/l10n_shell_catalogs.py), iOS offers only the declared ones to the package bundles
         CFBundleVersion: $(CURRENT_PROJECT_VERSION)
         CFBundleShortVersionString: $(MARKETING_VERSION)
         UILaunchScreen: {}
