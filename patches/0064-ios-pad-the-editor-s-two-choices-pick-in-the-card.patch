From 34751bc2c33faf9d0eccc3a75bd34eaaefe9ff67 Mon Sep 17 00:00:00 2001
From: odonnellmatt <odonnellmatt@users.noreply.github.com>
Date: Tue, 17 Nov 2026 06:51:01 +0800
Subject: [PATCH] ios/pad: the editor's two choices pick in the card's cream,
 black text on it, on every iOS

Both sides together | Each side on its own set a font of its own, which dropped UIKit's picked-segment text colour: white on the cream that iOS 26 draws from the tint. iOS 27 draws the picked segment grey instead. Both choices (and Save for) now set the cream and the text colours themselves: black on the picked segment, white on the others.

Upstream-Status: pending [builds on 0020 and 0040: the seedds/nxnative pull request follows once they are upstream]
Reason: the editor's two choices readable on every iOS: black text on the cream of the picked segment
Issue: LNPANDY/NX2Apple#ISSUE (the feature issue, to be opened before the pull request)
---
 dm/ios/Sources/DmPadEditor.m | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/dm/ios/Sources/DmPadEditor.m b/dm/ios/Sources/DmPadEditor.m
index 803b12f8..e6a02429 100644
--- a/dm/ios/Sources/DmPadEditor.m
+++ b/dm/ios/Sources/DmPadEditor.m
@@ -126,6 +126,7 @@ static UIStackView *panel_row(NSArray<UIView *> *views) {
     _mirrorControl = [[UISegmentedControl alloc] initWithItems:@[panel_text(env, DM_PAD_TEXT_TOGETHER), panel_text(env, DM_PAD_TEXT_ON_ITS_OWN)]];
     _mirrorControl.apportionsSegmentWidthsByContent = YES;
     _mirrorControl.selectedSegmentIndex = 0;
+    _mirrorControl.selectedSegmentTintColor = panel_cream();   // the card's cream on every iOS: 26 draws the picked segment in the tint, 27 in grey
     _mirrorControl.accessibilityLabel = panel_text(env, DM_PAD_TEXT_MIRROR);
     _mirrorControl.accessibilityContainerType = UIAccessibilityContainerTypeSemanticGroup;   // the name is said on the way into the two segments
     [_mirrorControl addTarget:self action:@selector(mirrorPicked:) forControlEvents:UIControlEventValueChanged];
@@ -134,6 +135,9 @@ static UIStackView *panel_row(NSArray<UIView *> *views) {
     _scopeLabel = panel_label(13, UIFontWeightRegular, 0.9); _scopeLabel.text = panel_text(env, DM_PAD_TEXT_SAVE_FOR);
     _scopeControl = [[UISegmentedControl alloc] initWithItems:@[panel_text(env, DM_PAD_TEXT_ALL_GAMES), panel_text(env, DM_PAD_TEXT_THIS_GAME)]];
     _scopeControl.selectedSegmentIndex = 0; _scopeControl.accessibilityLabel = _scopeLabel.text;
+    _scopeControl.selectedSegmentTintColor = panel_cream();   // as the choice above: black on cream when picked, white otherwise
+    [_scopeControl setTitleTextAttributes:@{NSForegroundColorAttributeName: UIColor.whiteColor} forState:UIControlStateNormal];
+    [_scopeControl setTitleTextAttributes:@{NSForegroundColorAttributeName: UIColor.blackColor} forState:UIControlStateSelected];
     [_scopeControl addTarget:self action:@selector(scopePicked:) forControlEvents:UIControlEventValueChanged];
 
     _resetButton = panel_button(panel_text(env, DM_PAD_TEXT_RESET), NO);
@@ -311,9 +315,15 @@ static UIStackView *panel_row(NSArray<UIView *> *views) {
 - (BOOL)mirrorApplies { return _mirrorControl.enabled; }
 - (void)setMirrorFont:(CGFloat)size {   // the same font selected or not, so a segment keeps its width when it is picked
     _mirrorFont = size;
-    NSDictionary<NSAttributedStringKey, id> *a = @{NSFontAttributeName: [UIFont systemFontOfSize:size weight:UIFontWeightMedium]};
+    // The colours as Save for shows them: black on the cream of the picked segment, white on the others. A font of its own drops UIKit's
+    // picked-segment colour, which left white on cream.
+    UIFont *f = [UIFont systemFontOfSize:size weight:UIFontWeightMedium];
+    NSDictionary<NSAttributedStringKey, id> *a = @{NSFontAttributeName: f, NSForegroundColorAttributeName: UIColor.whiteColor};
+    NSDictionary<NSAttributedStringKey, id> *picked = @{NSFontAttributeName: f, NSForegroundColorAttributeName: UIColor.blackColor};
     [_mirrorControl setTitleTextAttributes:a forState:UIControlStateNormal];
-    [_mirrorControl setTitleTextAttributes:a forState:UIControlStateSelected];
+    [_mirrorControl setTitleTextAttributes:a forState:UIControlStateDisabled];
+    [_mirrorControl setTitleTextAttributes:picked forState:UIControlStateSelected];
+    [_mirrorControl setTitleTextAttributes:picked forState:UIControlStateSelected | UIControlStateDisabled];
 }
 // The choice's titles at the largest of 13, 12, 11 and 10 points at which the control, as UIKit sizes it, fits the row (width). Estimated with a stand-in
 // for the system font: 13 in every language on an iPad's card and on an iPhone held upright (a 323-point row), 10 to 13 in a 320-point window. A
-- 
2.43.0

