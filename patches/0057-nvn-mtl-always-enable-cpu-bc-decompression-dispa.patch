+// Drop top mip levels for CPU-decoded BC textures on devices without native BC support.
+// Dropping mip 0 halves width and height, reducing memory by 75%; for very large textures (>=1024),
+// dropping 2 mips reduces memory by 93.75% while keeping enough resolution for sharp rendering on mobile.
+// Profile/env DM_BC_DROP_MIP (1 on by default with tex_bc_cpu, 0 to disable).
+static inline int bc_drop_mips(const tex_t *t, int bc_cpu, int packaged) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("DM_BC_DROP_MIP"); on = !e || atoi(e); }
+    if (!on || !bc_cpu || !packaged || t->d.levels <= 1) return 0;
+    if (t->d.levels > 3 && (t->d.width >= 4096 || t->d.height >= 4096)) return 3;
+    if (t->d.levels > 2 && (t->d.width >= 1024 || t->d.height >= 1024)) return 2;
+    if (t->d.width >= 128 || t->d.height >= 128) return 1;
+    return 0;
+}
