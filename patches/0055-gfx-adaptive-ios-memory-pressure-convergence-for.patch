+static void fg_snap_seq_step(void) { g_fg_seq++; }
+
+static void fg_snap_retire_old(int k) {
+    if (g_fg_snap[k].gen_old) { [g_snap_res removeAllocation:g_fg_snap[k].gen_old]; [g_snap_res commit]; g_fg_snap[k].gen_old = nil; }
+    if (g_fg_snap[k].lum_old) { [g_snap_res removeAllocation:g_fg_snap[k].lum_old]; [g_snap_res commit]; g_fg_snap[k].lum_old = nil; }
+    fg_reap_retired(0);
+    g_fg_snap[k].gen_ok = 0;
+}
