+static void fg_snap_plan(id<MTLTexture> src, const int crop[4], NSUInteger *tw, NSUInteger *th, int *sub, int *scaled, NSUInteger cr[4], int *whole, MTLTextureUsage *usage) {
+    *tw = src.width; *th = src.height;
+    int fgc = fg_on() && !atomic_load_explicit(&g_origin_ll, memory_order_relaxed) && present_crop_rect(src, crop, cr);
+    *scaled = fgc && fg_shown_size(cr[2], cr[3], tw, th);
+    *sub = fgc && !*scaled && (cr[0] || cr[1] || cr[2] != src.width || cr[3] != src.height);
+    if (!*scaled) { *tw = *sub ? cr[2] : src.width; *th = *sub ? cr[3] : src.height; }
+    *whole = *scaled || *sub;
+    *usage = fg_on() ? MTLTextureUsageRenderTarget : 0;
+}
+
+static MTL4CommitOptions *fg_snap_encode(id<MTL4CommandBuffer> cb, int k, double period) {
+    if (!fg_on()) return nil;
+    int pk = (int)((atomic_load(&g_snap_next) + (uint64_t)g_snap_n - 1) % (uint64_t)g_snap_n);
+    g_fg_snap[k].seq = g_fg_seq;
+    int paused = fg_menu_pause();
+    if (!paused && fg_mv_on()) fg_luma(cb, k);
+    if (period > 0.025 && !paused) fg_encode(cb, k, pk, period);
+    else g_fg_warm = 0;
+    if (!g_fg_snap[k].gen_ok || !g_fg_heap) return nil;
+    MTL4CommitOptions *o = [MTL4CommitOptions new];
+    id<MTL4CounterHeap> heap = g_fg_heap;
+    id<MTLDevice> dev = g_dev;
+    double freq = dev ? (double)[dev queryTimestampFrequency] : 0;
+    NSUInteger fg_w = g_snap[k].tex.width, fg_h = g_snap[k].tex.height;
+    int slot = k;
+    [o addFeedbackHandler:^(id<MTL4CommitFeedback> f) {
+        if (f.error) { MLOG("[RED] frame generation: %s", f.error.description.UTF8String); return; }
+        NSData *r = [heap resolveCounterRange:NSMakeRange(2 * slot, 2)];
+        const uint64_t *ts = r.bytes;
+        if (ts && ts[1] > ts[0] && freq > 0) fg_gpu_note((ts[1] - ts[0]) / freq, fg_w, fg_h);
+    }];
+    return o;
+}
