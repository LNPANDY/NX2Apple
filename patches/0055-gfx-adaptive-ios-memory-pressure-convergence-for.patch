+// Evict expired or over-budget entries in 64-entry batches, releasing and calling res_remove outside g_rh_lk. → bytes freed
+static uint64_t rh_evict_to_budget(uint64_t now, const rh_policy *p, unsigned *n_out) {
+    uint64_t bytes = 0;
+    unsigned total = 0;
+    if (!p) { if (n_out) *n_out = 0; return 0; }
+    for (;;) {
+        void *drop[64];
+        unsigned nd = 0;
+        os_unfair_lock_lock(&g_rh_lk);
+        while (g_rh_n && nd < 64) {
+            unsigned old = 0;
+            for (unsigned i = 1; i < g_rh_n; i++) {
+                if (g_rh[i].t < g_rh[old].t) old = i;
+            }
+            if (!rh_needs_evict(g_rh_bytes, now, g_rh[old].t, p)) break;
+            drop[nd++] = g_rh[old].heap;
+            bytes += g_rh[old].size;
+            g_rh_bytes = g_rh_bytes >= g_rh[old].size ? g_rh_bytes - g_rh[old].size : 0;
+            g_rh[old] = g_rh[--g_rh_n];
+        }
+        int more = g_rh_n != 0 && nd == 64;
+        os_unfair_lock_unlock(&g_rh_lk);
+        if (!nd) break;
+        for (unsigned i = 0; i < nd; i++) {
+            id<MTLHeap> h = CFBridgingRelease(drop[i]);
+            res_remove(h);
+        }
+        total += nd;
+        atomic_fetch_add(&g_rh_trimmed, nd);
+        if (!more) break;
+    }
+    if (n_out) *n_out = total;
+    return bytes;
+}
