+    uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC);
+    if (!sw_on(rh_mode())) {
+        res_remove(heap);
+        rh_policy zero = {0, 0, 0, 1};
+        rh_evict_to_budget(now, &zero);
+        return;
