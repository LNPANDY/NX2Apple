+        MLOG("present upscaling: metalfx, as frame generation makes its frames smaller than shown (DM_FRAMEGEN_SCALE)");
+        return 1;
+    }
+    return 0;
+}
+
+static void fg_adjust_snap_ring(int *n) {
+    if (fg_on() && *n < 3) {
+        MLOG("frame generation: present snapshots on with a ring of 3 (DM_PRESENT_SNAP=%d)", *n);
+        *n = 3;
+    }
+}
+
+static int fg_alloc_slot(uint64_t ticket) {
+    int alloc_i = g_fg_owing ? 3 + (int)(g_fg_shown % 3) : (int)(ticket % 3);
+    if (!g_present_alloc4[alloc_i]) {
+        NSError *ae = nil;
+        MTL4CommandAllocatorDescriptor *pad = [MTL4CommandAllocatorDescriptor new];
+        pad.label = [NSString stringWithFormat:@"nvn-mtl present allocator %d (frame generation)", alloc_i];
+        g_present_alloc4[alloc_i] = [g_dev newCommandAllocatorWithDescriptor:pad error:&ae];
+        g_present_cb[alloc_i] = [g_dev newCommandBuffer];
+        g_present_uv[alloc_i] = [g_dev newBufferWithLength:sizeof(float) * 8 options:MTLResourceStorageModeShared];
+        if (!g_present_alloc4[alloc_i] || !g_present_cb[alloc_i] || !g_present_uv[alloc_i])
+            MDIE("failed to create present allocator %d: %s", alloc_i, ae.localizedDescription.UTF8String);
+        res_add(g_present_uv[alloc_i]);
+        res_commit();
+    }
+    return alloc_i;
+}
+
+static int fg_mv_on(void) {
+    if (g_fgmv_ok >= 0) return g_fgmv_ok;
+    const char *e = getenv("DM_FRAMEGEN_MV");
+    if (e && atoi(e) <= 0) {
+        MLOG("frame generation: no motion given to the interpolator (DM_FRAMEGEN_MV=0): its own flow finds it, up to about 64 px a frame");
+        return g_fgmv_ok = 0;
+    }
+    NSError *err = nil;
+    id<MTLLibrary> lib = host_lib("fgmv", &err);
+    static const char *const fn[8] = {"fgmv_luma", "fgmv_search", "fgmv_pick", "fgmv_still", "fgmv_hud", "fgmv_keep", "fgmv_pstill", "fgmv_conf"};
+    const char *pe = getenv("DM_FRAMEGEN_PASTE");
+    bool paste = pe && atoi(pe) > 0;
+    MTLFunctionConstantValues *cv = [MTLFunctionConstantValues new];
+    [cv setConstantValue:&paste type:MTLDataTypeBool atIndex:0];
+    for (int i = 0; i < 8; i++) {
+        id<MTLFunction> f = !lib ? nil : i == FGMV_HUD ? [lib newFunctionWithName:@(fn[i]) constantValues:cv error:&err] : [lib newFunctionWithName:@(fn[i])];
+        g_fgmv_ps[i] = f ? [g_dev newComputePipelineStateWithFunction:f error:&err] : nil;
+        if (!g_fgmv_ps[i]) {
+            MLOG("[RED] frame generation: no %s pipeline (%s): the interpolator gets no motion, as X6-X9", fn[i], err.description.UTF8String);
+            return g_fgmv_ok = 0;
+        }
+    }
+    if (g_fgmv_ps[FGMV_SEARCH].maxTotalThreadsPerThreadgroup < 256) {
+        MLOG("[RED] frame generation: the motion search needs 256 threads a group, this GPU gives %lu: no motion given",
+             (unsigned long)g_fgmv_ps[FGMV_SEARCH].maxTotalThreadsPerThreadgroup);
+        return g_fgmv_ok = 0;
+    }
+    MTL4ArgumentTableDescriptor *ad = [MTL4ArgumentTableDescriptor new];
+    ad.maxTextureBindCount = 5;
+    g_fgmv_args = [g_dev newArgumentTableWithDescriptor:ad error:&err];
+    if (!g_fgmv_args) {
+        MLOG("[RED] frame generation: no argument table for the motion (%s): no motion given", err.description.UTF8String);
+        return g_fgmv_ok = 0;
+    }
+    MLOG("frame generation: motion found from the presented pictures (DM_FRAMEGEN_MV=1: 64 px tiles searched within 192 px at 1/8 size, refined to 2 px), the still HUD kept from the present%s",
+         paste ? "; blocks whose motion is not trusted pasted from it (DM_FRAMEGEN_PASTE=1)" : "");
+    return g_fgmv_ok = 1;
+}
+
+static int fg_keep_fmt(MTLPixelFormat f) {
+    return f == MTLPixelFormatRGBA8Unorm || f == MTLPixelFormatBGRA8Unorm || f == MTLPixelFormatRGBA16Float ||
+           f == MTLPixelFormatRGB10A2Unorm || f == MTLPixelFormatRG11B10Float || f == MTLPixelFormatRGBA32Float;
+}
+
+static void fgmv_bind(id<MTL4ComputeCommandEncoder> ce, int ps, id<MTLTexture> t0, id<MTLTexture> t1, id<MTLTexture> t2, id<MTLTexture> t3) {
+    [ce setComputePipelineState:g_fgmv_ps[ps]];
+    id<MTLTexture> t[4] = {t0, t1, t2, t3};
+    for (int i = 0; i < 4; i++) if (t[i]) [g_fgmv_args setTexture:t[i].gpuResourceID atIndex:(NSUInteger)i];
+}
+
+static void fgmv_grid(id<MTL4ComputeCommandEncoder> ce, NSUInteger w, NSUInteger h) {
+    [ce dispatchThreads:MTLSizeMake(w, h, 1) threadsPerThreadgroup:MTLSizeMake(8, 8, 1)];
+}
+
+static void fgmv_step(id<MTL4ComputeCommandEncoder> ce) {
+    [ce barrierAfterEncoderStages:MTLStageDispatch beforeEncoderStages:MTLStageDispatch visibilityOptions:MTL4VisibilityOptionDevice];
+}
+
+static void fg_reap_retired(int force) {
+    if (!g_fg_retire_n) return;
+    uint64_t cmt = atomic_load_explicit(&g_snap_cmt, memory_order_acquire);
+    uint64_t sig = g_snap_ev ? g_snap_ev.signaledValue : 0;
+    int kept = 0, removed = 0;
+    for (int i = 0; i < g_fg_retire_n; i++) {
+        fg_retire_ent *e = &g_fg_retire[i];
+        int done = force || !e->ev || !g_snap_ev || (cmt >= e->ev && sig >= e->ev);
+        if (!done) {
+            if (kept != i) g_fg_retire[kept] = *e;
+            kept++;
+            continue;
+        }
+        for (int j = 0; j < 7; j++) {
+            if (e->tex[j]) {
+                if (g_snap_res) [g_snap_res removeAllocation:e->tex[j]];
+                e->tex[j] = nil;
+                removed = 1;
+            }
+        }
+        e->fi = nil;
+    }
+    for (int i = kept; i < g_fg_retire_n; i++) g_fg_retire[i] = (fg_retire_ent){0};
+    g_fg_retire_n = kept;
+    if (removed && g_snap_res) [g_snap_res commit];
+}
+
+static void fg_retire_current(void) {
+    id<MTLTexture> t[7] = {g_fg_depth, g_fg_motion, g_fg_tiles, g_fg_still, g_fg_keep, g_fg_pmask, g_fg_conf};
+    int has = g_fg_fi != nil;
+    for (int i = 0; i < 7; i++) if (t[i]) has = 1;
+    g_fg_depth = g_fg_motion = g_fg_tiles = g_fg_still = g_fg_keep = g_fg_pmask = g_fg_conf = nil;
+    id<MTL4FXFrameInterpolator> fi = g_fg_fi;
+    g_fg_fi = nil;
+    if (!has) return;
+    fg_reap_retired(0);
+    uint64_t ev = g_snap_v;
+    uint64_t cmt = atomic_load_explicit(&g_snap_cmt, memory_order_acquire);
+    uint64_t sig = g_snap_ev ? g_snap_ev.signaledValue : 0;
+    if (!ev || !g_snap_ev || (cmt >= ev && sig >= ev)) {
+        int removed = 0;
+        for (int i = 0; i < 7; i++) {
+            if (t[i]) {
+                if (g_snap_res) [g_snap_res removeAllocation:t[i]];
+                removed = 1;
+            }
+        }
+        if (removed && g_snap_res) [g_snap_res commit];
+        return;
+    }
+    if (g_fg_retire_n >= FG_RETIRE_CAP) {
+        uint64_t old_ev = g_fg_retire[0].ev;
+        snap_commit_wait(old_ev);
+        if (g_snap_ev && g_snap_ev.signaledValue < old_ev) [g_snap_ev waitUntilSignaledValue:old_ev timeoutMS:2000];
+        fg_reap_retired(0);
+        if (g_fg_retire_n >= FG_RETIRE_CAP) fg_reap_retired(1);
+    }
+    fg_retire_ent *e = &g_fg_retire[g_fg_retire_n++];
+    e->ev = ev;
+    e->fi = fi;
+    for (int i = 0; i < 7; i++) e->tex[i] = t[i];
+}
+
+static id<MTL4FXFrameInterpolator> fg_for(id<MTLTexture> col) {
+    NSUInteger key[3] = {col.pixelFormat, col.width, col.height};
+    if (!memcmp(key, g_fg_key, sizeof key)) return g_fg_bad ? nil : g_fg_fi;
+    memcpy(g_fg_key, key, sizeof key);
+    fg_retire_current();
+    g_fg_bad = 1;
+    uint64_t t0 = now_ns();
+    NSError *err = nil;
+    if (!g_fg_comp) g_fg_comp = [g_dev newCompilerWithDescriptor:[MTL4CompilerDescriptor new] error:&err];
+    int mv = fg_mv_on();
+    NSUInteger iw = mv ? MAX((col.width + 7) / 8, 16) : MAX(col.width / 2, 16);
+    NSUInteger ih = mv ? MAX((col.height + 7) / 8, 16) : MAX(col.height / 2, 16);
+    MTLFXFrameInterpolatorDescriptor *d = [MTLFXFrameInterpolatorDescriptor new];
+    d.colorTextureFormat = col.pixelFormat;
+    d.outputTextureFormat = col.pixelFormat;
+    d.depthTextureFormat = MTLPixelFormatDepth32Float;
+    d.motionTextureFormat = MTLPixelFormatRG16Float;
+    d.inputWidth = iw;
+    d.inputHeight = ih;
+    d.outputWidth = col.width;
+    d.outputHeight = col.height;
+    id<MTL4FXFrameInterpolator> fi = g_fg_comp ? [d newFrameInterpolatorWithDevice:g_dev compiler:g_fg_comp] : nil;
+    if (!fi) {
+        MLOG("[RED] frame generation: MetalFX makes no frame interpolator for %lux%lu format %lu; frames of this size are shown as the game draws them",
+             (unsigned long)col.width, (unsigned long)col.height, (unsigned long)col.pixelFormat);
+        return nil;
+    }
+    MTLTextureDescriptor *dd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatDepth32Float width:iw height:ih mipmapped:NO];
+    dd.storageMode = MTLStorageModePrivate;
+    dd.usage = fi.depthTextureUsage | MTLTextureUsageRenderTarget;
+    MTLTextureDescriptor *md = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRG16Float width:iw height:ih mipmapped:NO];
+    md.storageMode = MTLStorageModePrivate;
+    md.usage = fi.motionTextureUsage | MTLTextureUsageRenderTarget | (mv ? MTLTextureUsageShaderWrite : 0);
+    id<MTLTexture> dep = [g_dev newTextureWithDescriptor:dd], mot = [g_dev newTextureWithDescriptor:md];
+    if (!dep || !mot) { RED_ONCE(179, "frame generation: no depth or motion texture"); return nil; }
+    if (mv) {
+        MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA16Float width:(iw + 7) / 8 height:(ih + 7) / 8 mipmapped:NO];
+        td.storageMode = MTLStorageModePrivate;
+        td.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+        MTLTextureDescriptor *bd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR16Float width:(col.width + 3) / 4 height:(col.height + 3) / 4 mipmapped:NO];
+        bd.storageMode = MTLStorageModePrivate;
+        bd.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+        MTLTextureDescriptor *pd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR8Unorm width:col.width height:col.height mipmapped:NO];
+        pd.storageMode = MTLStorageModePrivate;
+        pd.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+        MTLTextureDescriptor *cd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR16Float width:iw height:ih mipmapped:NO];
+        cd.storageMode = MTLStorageModePrivate;
+        cd.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+        id<MTLTexture> tl = [g_dev newTextureWithDescriptor:td], sb = [g_dev newTextureWithDescriptor:bd], kb = [g_dev newTextureWithDescriptor:bd];
+        id<MTLTexture> pm = [g_dev newTextureWithDescriptor:pd], cf = [g_dev newTextureWithDescriptor:cd];
+        if (!tl || !sb || !kb || !pm || !cf) { RED_ONCE(179, "frame generation: no textures for the motion"); return nil; }
+        [g_snap_res addAllocation:tl]; [g_snap_res addAllocation:sb]; [g_snap_res addAllocation:kb]; [g_snap_res addAllocation:pm]; [g_snap_res addAllocation:cf];
+        g_fg_tiles = tl; g_fg_still = sb; g_fg_keep = kb; g_fg_pmask = pm; g_fg_conf = cf;
+    }
+    [g_snap_res addAllocation:dep]; [g_snap_res addAllocation:mot]; [g_snap_res commit];
+    g_fg_depth = dep; g_fg_motion = mot; g_fg_clear = 1; g_fg_fi = fi; g_fg_bad = 0; g_fg_warm = 0;
+    if (!g_fg_heap) {
+        MTL4CounterHeapDescriptor *hd = [MTL4CounterHeapDescriptor new];
+        hd.type = MTL4CounterHeapTypeTimestamp;
+        hd.count = 2 * SNAP_MAX;
+        g_fg_heap = [g_dev newCounterHeapWithDescriptor:hd error:&err];
+        g_fg_tsbuf = [g_dev newBufferWithLength:8 options:MTLResourceStorageModePrivate];
+        if (g_fg_tsbuf) { [g_snap_res addAllocation:g_fg_tsbuf]; [g_snap_res commit]; }
+        if (!g_fg_heap || !g_fg_tsbuf) {
+            MLOG("frame generation: no timestamp heap (%s): its GPU time is not logged", err.description.UTF8String);
+            g_fg_heap = nil;
+        }
+    }
+    MLOG("frame generation: MetalFX frame interpolator %lux%lu format %lu (depth and motion %lux%lu%s), made in %.1f ms",
+         (unsigned long)col.width, (unsigned long)col.height, (unsigned long)col.pixelFormat, (unsigned long)iw, (unsigned long)ih,
+         mv ? (fg_keep_fmt(col.pixelFormat) ? ", motion found, HUD kept" : ", motion found; this format cannot be written, the HUD is not kept") : "",
+         (now_ns() - t0) / 1e6);
+    return fi;
+}
+
+static double fg_fixed(void) {
+    if (atomic_load_explicit(&g_fg_fixed_init, memory_order_acquire)) return g_fg_fixed_cached;
+    pthread_mutex_lock(&g_fg_cfg_mu);
+    if (!atomic_load_explicit(&g_fg_fixed_init, memory_order_relaxed)) {
+        const char *e = getenv("DM_FRAMEGEN_SCALE");
+        double x = e && *e ? atof(e) : 0;
+        double v = !(e && *e) ? 0 : x >= 0.5 && x <= 1 ? x : 1;
+        if (e && *e && v != x) MLOG("[RED] DM_FRAMEGEN_SCALE=%s: 0.5 to 1; using %.2f", e, v);
+        if (v) MLOG("frame generation: its frames at %.2f of the size shown (DM_FRAMEGEN_SCALE) in place of the pixel budget", v);
+        g_fg_fixed_cached = v;
+        atomic_store_explicit(&g_fg_fixed_init, 1, memory_order_release);
+    }
+    double out = g_fg_fixed_cached;
+    pthread_mutex_unlock(&g_fg_cfg_mu);
+    return out;
+}
+
+static double fg_size_at(double px, int level) {
+    double b = g_fg_budget[level < 0 ? 0 : level >= FG_LEVELS ? FG_LEVELS - 1 : level];
+    return px <= 1.1 * b ? 1 : fmax(0.5, sqrt(b / px));
+}
+
+static double fg_size_for(double w, double h) {
+    double f = fg_fixed();
+    if (f) return f;
+    return fg_size_at(w * h, atomic_load(&g_fg_level));
+}
+
+static double fg_heavy_ms(void) {
+    if (atomic_load_explicit(&g_fg_heavy_init, memory_order_acquire)) return g_fg_heavy_ms_cached;
+    pthread_mutex_lock(&g_fg_cfg_mu);
+    if (!atomic_load_explicit(&g_fg_heavy_init, memory_order_relaxed)) {
+        const char *e = getenv("DM_FRAMEGEN_HEAVY_MS");
+        g_fg_heavy_ms_cached = e && *e ? atof(e) : 8;
+        if (e && *e) MLOG("frame generation: made lighter only while the interpolation takes %.1f ms or more (DM_FRAMEGEN_HEAVY_MS)", g_fg_heavy_ms_cached);
+        atomic_store_explicit(&g_fg_heavy_init, 1, memory_order_release);
+    }
+    double out = g_fg_heavy_ms_cached;
+    pthread_mutex_unlock(&g_fg_cfg_mu);
+    return out;
+}
+
+static int fg_level_down(void) {
+    int l = atomic_load(&g_fg_level);
+    double px = (double)atomic_load(&g_fg_shown_px);
+    if (!fg_fixed() && atomic_load(&g_fg_gpu_avg_us) < fg_heavy_ms() * 1000) return -1;
+    if (fg_fixed() || l + 1 >= FG_LEVELS || !px || !(fg_size_at(px, l + 1) < fg_size_at(px, l))) return 0;
+    atomic_store(&g_fg_level, l + 1);
+    return 1;
+}
+
+static double fg_size(void) {
+    CAMetalLayer *layer = (__bridge CAMetalLayer *)front_metal_layer();
+    CGSize ds = layer ? layer.drawableSize : CGSizeZero;
+    return ds.width >= 16 && ds.height >= 16 ? fg_size_for(ds.width, ds.height) : fg_fixed() ? fg_fixed() : 1;
+}
+
+static int fg_shown_size(NSUInteger cw, NSUInteger ch, NSUInteger *tw, NSUInteger *th) {
+    CAMetalLayer *layer = (__bridge CAMetalLayer *)front_metal_layer();
+    if (!layer || !cw || !ch) return 0;
+    CGSize ds = layer.drawableSize;
+    if (ds.width < 16 || ds.height < 16) return 0;
+    double s = fmin(fmin(ds.width / cw, ds.height / ch), 1);
+    atomic_store(&g_fg_shown_px, (uint64_t)(cw * s * ch * s));
+    double f = fg_size_for(cw * s, ch * s);
+    s *= f;
+    if (f != g_fg_last_logged_factor) {
+        g_fg_last_logged_factor = f;
+        if (f < 1) MLOG("frame generation: a picture shown at %.0fx%.0f is generated at %.2f of it (%lux%lu; %s%s), brought back by the present",
+                        cw * s / f, ch * s / f, f, (unsigned long)lround(cw * s), (unsigned long)lround(ch * s),
+                        fg_fixed() ? "DM_FRAMEGEN_SCALE" : "pixel budget ", fg_fixed() ? "" : g_fg_budget_name[atomic_load(&g_fg_level)]);
+    }
+    if (!(s < 0.95) || s < 0.25) return 0;
+    *tw = MAX((NSUInteger)lround(cw * s), 16);
+    *th = MAX((NSUInteger)lround(ch * s), 16);
+    return 1;
+}
+
+static int fg_scale(id<MTL4CommandBuffer> cb, int k, id<MTLTexture> src, id<MTLTexture> dst, const NSUInteger r[4]) {
+    NSError *e = nil;
+    if (!g_fg_scale_pso || g_fg_scale_fmt != dst.pixelFormat) {
+        id<MTLLibrary> lib = host_lib("present", &e);
+        MTLRenderPipelineDescriptor *pd = [MTLRenderPipelineDescriptor new];
+        pd.vertexFunction = [lib newFunctionWithName:@"vs"];
+        pd.fragmentFunction = [lib newFunctionWithName:@"fs"];
+        pd.colorAttachments[0].pixelFormat = dst.pixelFormat;
+        g_fg_scale_pso = lib ? [g_dev newRenderPipelineStateWithDescriptor:pd error:&e] : nil;
+        g_fg_scale_fmt = dst.pixelFormat;
+        if (!g_fg_scale_pso) {
+            RED_ONCE(182, "frame generation: no pipeline to copy the picture at its shown size (format %lu): %s",
+                     (unsigned long)dst.pixelFormat, e.description.UTF8String);
+            return 0;
+        }
+    }
+    if (!g_fg_args) {
+        MTL4ArgumentTableDescriptor *ad = [MTL4ArgumentTableDescriptor new];
+        ad.maxTextureBindCount = 1;
+        ad.maxSamplerStateBindCount = 1;
+        ad.maxBufferBindCount = 1;
+        g_fg_args = [g_dev newArgumentTableWithDescriptor:ad error:&e];
+        MTLSamplerDescriptor *sd = [MTLSamplerDescriptor new];
+        sd.minFilter = sd.magFilter = MTLSamplerMinMagFilterLinear;
+        sd.supportArgumentBuffers = YES;
+        g_fg_samp = [g_dev newSamplerStateWithDescriptor:sd];
+        if (!g_fg_args || !g_fg_samp) {
+            RED_ONCE(182, "frame generation: no argument table to copy the picture at its shown size");
+            g_fg_args = nil;
+            return 0;
+        }
+    }
+    if (!g_fg_uv[k]) {
+        g_fg_uv[k] = [g_dev newBufferWithLength:sizeof(float) * 8 options:MTLResourceStorageModeShared];
+        if (!g_fg_uv[k]) return 0;
+        [g_snap_res addAllocation:g_fg_uv[k]];
+        [g_snap_res commit];
+    }
+    float *uv = g_fg_uv[k].contents;
+    float w = (float)src.width, h = (float)src.height;
+    uv[0] = r[0] / w; uv[1] = r[1] / h; uv[2] = r[2] / w; uv[3] = r[3] / h;
+    uv[4] = (r[0] + 0.5f) / w; uv[5] = (r[1] + 0.5f) / h; uv[6] = (r[0] + r[2] - 0.5f) / w; uv[7] = (r[1] + r[3] - 0.5f) / h;
+    MTL4RenderPassDescriptor *rp = [MTL4RenderPassDescriptor new];
+    rp.colorAttachments[0].texture = dst;
+    rp.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+    rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTL4RenderCommandEncoder> en = [cb renderCommandEncoderWithDescriptor:rp];
+    if (!en) { RED_ONCE(182, "frame generation: no render encoder to copy the picture at its shown size"); return 0; }
+    [en barrierAfterQueueStages:MTLStageAll beforeStages:MTLStageFragment visibilityOptions:resource_vis()];
+    [en setArgumentTable:g_fg_args atStages:MTLRenderStageFragment];
+    [g_fg_args setTexture:src.gpuResourceID atIndex:0];
+    [g_fg_args setSamplerState:g_fg_samp.gpuResourceID atIndex:0];
+    [g_fg_args setAddress:g_fg_uv[k].gpuAddress atIndex:0];
+    [en setViewport:(MTLViewport){0, 0, dst.width, dst.height, 0, 1}];
+    [en setRenderPipelineState:g_fg_scale_pso];
+    [en drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [en barrierAfterStages:MTLStageFragment beforeQueueStages:MTLStageAll visibilityOptions:resource_vis()];
+    [en endEncoding];
+    return 1;
+}
+
+static void fg_gpu_note(double s, NSUInteger w, NSUInteger h) {
+    atomic_store_explicit(&g_fg_gpu_last, s, memory_order_relaxed);
+    if (s > 0 && s < 1) {
+        uint64_t a = atomic_load(&g_fg_gpu_avg_us), us = (uint64_t)(s * 1e6);
+        atomic_store(&g_fg_gpu_avg_us, a ? (a * 15 + us) / 16 : us);
+    }
+    if (!(s > 0 && s < 1)) return;
+    pthread_mutex_lock(&g_fg_gpu_mu);
+    g_fg_gpu_samples[g_fg_gpu_sample_n++] = s * 1e3;
+    if (g_fg_gpu_sample_n == 600) {
+        for (int i = 1; i < 600; i++) {
+            double x = g_fg_gpu_samples[i];
+            int j = i - 1;
+            while (j >= 0 && g_fg_gpu_samples[j] > x) { g_fg_gpu_samples[j + 1] = g_fg_gpu_samples[j]; j--; }
+            g_fg_gpu_samples[j + 1] = x;
+        }
+        MLOG("frame generation: GPU time of the interpolation over 600 generated frames: p50 %.3f ms, p95 %.3f ms, max %.3f ms (%lux%lu)",
+             g_fg_gpu_samples[299], g_fg_gpu_samples[569], g_fg_gpu_samples[599], (unsigned long)w, (unsigned long)h);
+        g_fg_gpu_sample_n = 0;
+    }
+    pthread_mutex_unlock(&g_fg_gpu_mu);
+}
+
+static void fg_luma(id<MTL4CommandBuffer> cb, int k) {
+    id<MTLTexture> col = g_snap[k].tex, l = g_fg_snap[k].lum;
+    NSUInteger w = MAX((col.width + 7) / 8, 16), h = MAX((col.height + 7) / 8, 16);
+    if (!l || l.width != w || l.height != h) {
+        MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR16Float width:w height:h mipmapped:NO];
+        d.storageMode = MTLStorageModePrivate;
+        d.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+        g_fg_snap[k].lum_old = l;
+        if (!(l = [g_dev newTextureWithDescriptor:d])) {
+            g_fg_snap[k].lum = nil;
+            RED_ONCE(183, "frame generation: no luma texture for the motion");
+            return;
+        }
+        [g_snap_res addAllocation:l];
+        [g_snap_res commit];
+        g_fg_snap[k].lum = l;
+    }
+    id<MTL4ComputeCommandEncoder> ce = [cb computeCommandEncoder];
+    [ce barrierAfterQueueStages:MTLStageAll beforeStages:MTLStageDispatch visibilityOptions:resource_vis()];
+    [ce setArgumentTable:g_fgmv_args];
+    fgmv_bind(ce, FGMV_LUMA, col, l, nil, nil);
+    fgmv_grid(ce, w, h);
+    [ce barrierAfterStages:MTLStageDispatch beforeQueueStages:MTLStageAll visibilityOptions:MTL4VisibilityOptionDevice];
+    [ce endEncoding];
+}
+
+static void fg_motion(id<MTL4ComputeCommandEncoder> ce, int k, int pk) {
+    id<MTLTexture> cl = g_fg_snap[k].lum, pl = g_fg_snap[pk].lum;
+    [ce setArgumentTable:g_fgmv_args];
+    fgmv_bind(ce, FGMV_SEARCH, cl, pl, g_fg_tiles, nil);
+    [ce dispatchThreadgroups:MTLSizeMake(g_fg_tiles.width, g_fg_tiles.height, 1) threadsPerThreadgroup:MTLSizeMake(256, 1, 1)];
+    fgmv_step(ce);
+    fgmv_bind(ce, FGMV_PICK, cl, pl, g_fg_tiles, g_fg_motion);
+    fgmv_grid(ce, g_fg_motion.width, g_fg_motion.height);
+}
+
+static void fg_keep(id<MTL4CommandBuffer> cb, int k, int pk, id<MTLTexture> gen) {
+    id<MTLTexture> col = g_snap[k].tex, prev = g_snap[pk].tex, prev2 = prev;
+    for (int i = 0; i < g_snap_n; i++) {
+        if (i != k && i != pk && g_fg_snap[i].seq + 2 == g_fg_snap[k].seq &&
+            g_snap[i].tex.width == col.width && g_snap[i].tex.height == col.height && g_snap[i].tex.pixelFormat == col.pixelFormat)
+            prev2 = g_snap[i].tex;
+    }
+    id<MTL4ComputeCommandEncoder> ce = [cb computeCommandEncoder];
+    [ce barrierAfterQueueStages:MTLStageAll beforeStages:MTLStageDispatch visibilityOptions:resource_vis()];
+    [ce setArgumentTable:g_fgmv_args];
+    fgmv_bind(ce, FGMV_STILL, col, prev, g_fg_still, nil); fgmv_grid(ce, g_fg_still.width, g_fg_still.height); fgmv_step(ce);
+    fgmv_bind(ce, FGMV_CONF, g_fg_snap[k].lum, g_fg_snap[pk].lum, g_fg_motion, g_fg_conf); fgmv_grid(ce, g_fg_conf.width, g_fg_conf.height); fgmv_step(ce);
+    fgmv_bind(ce, FGMV_HUD, g_fg_still, g_fg_keep, g_fg_conf, nil); fgmv_grid(ce, g_fg_keep.width, g_fg_keep.height); fgmv_step(ce);
+    fgmv_bind(ce, FGMV_PSTILL, col, prev, prev2, g_fg_pmask); fgmv_grid(ce, col.width, col.height); fgmv_step(ce);
+    fgmv_bind(ce, FGMV_KEEP, col, g_fg_keep, gen, g_fg_pmask); [g_fgmv_args setTexture:g_fg_motion.gpuResourceID atIndex:4]; fgmv_grid(ce, gen.width, gen.height);
+    [ce barrierAfterStages:MTLStageDispatch beforeQueueStages:MTLStageAll visibilityOptions:resource_vis()];
+    [ce endEncoding];
+}
+
+static void fg_encode(id<MTL4CommandBuffer> cb, int k, int pk, double period) {
+    g_fg_snap[k].gen_ok = 0;
+    id<MTLTexture> col = g_snap[k].tex, prev = pk >= 0 ? g_snap[pk].tex : nil;
+    id<MTL4FXFrameInterpolator> fi = fg_for(col);
+    if (!fi) return;
+    int follows = prev && g_fg_snap[pk].seq + 1 == g_fg_snap[k].seq && prev.width == col.width && prev.height == col.height && prev.pixelFormat == col.pixelFormat;
+    int mv = fg_mv_on() && g_fg_tiles && g_fg_snap[k].lum && g_fg_snap[pk].lum && g_fg_snap[k].lum.width == g_fg_snap[pk].lum.width && g_fg_snap[k].lum.height == g_fg_snap[pk].lum.height;
+    int keep = mv && fg_keep_fmt(col.pixelFormat);
+    if (!follows) {
+        if (g_fg_warm) g_fg_resets++;
+        g_fg_warm = 0;
+        return;
+    }
+    id<MTLTexture> gen = g_fg_snap[k].gen;
+    if (!gen || gen.width != col.width || gen.height != col.height || gen.pixelFormat != col.pixelFormat) {
+        MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:col.pixelFormat width:col.width height:col.height mipmapped:NO];
+        d.storageMode = MTLStorageModePrivate;
+        d.usage = fi.outputTextureUsage | MTLTextureUsageShaderRead | (fg_mv_on() && fg_keep_fmt(col.pixelFormat) ? MTLTextureUsageShaderWrite : 0);
+        g_fg_snap[k].gen_old = gen;
+        gen = [g_dev newTextureWithDescriptor:d];
+        if (!gen) { RED_ONCE(180, "frame generation: no texture for the generated frame"); return; }
+        [g_snap_res addAllocation:gen];
+        [g_snap_res commit];
+        if (!g_fg_snap[k].gen_serial) {
+            static _Atomic uint64_t n;
+            g_fg_snap[k].gen_serial = (1ull << 61) + (1ull << 40) + atomic_fetch_add(&n, 1) + 1;
+        }
+        serial_put(g_fg_snap[k].gen_serial, gen);
+        g_fg_snap[k].gen = gen;
+    }
+    if (g_fg_clear) {
+        MTL4RenderPassDescriptor *rp = [MTL4RenderPassDescriptor new];
+        rp.colorAttachments[0].texture = g_fg_motion; rp.colorAttachments[0].loadAction = MTLLoadActionClear; rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+        rp.colorAttachments[0].clearColor = MTLClearColorMake(0, 0, 0, 0);
+        rp.depthAttachment.texture = g_fg_depth; rp.depthAttachment.loadAction = MTLLoadActionClear; rp.depthAttachment.storeAction = MTLStoreActionStore; rp.depthAttachment.clearDepth = 0;
+        id<MTL4RenderCommandEncoder> en = [cb renderCommandEncoderWithDescriptor:rp];
+        if (!en) { RED_ONCE(181, "frame generation: the constant inputs could not be cleared"); return; }
+        [en endEncoding];
+        g_fg_clear = 0;
+    }
+    id<MTL4ComputeCommandEncoder> ce = [cb computeCommandEncoder];
+    [ce barrierAfterQueueStages:MTLStageAll beforeStages:MTLStageBlit | MTLStageDispatch visibilityOptions:resource_vis()];
+    if (g_fg_heap) {
+        [ce copyFromBuffer:g_fg_tsbuf sourceOffset:0 toBuffer:g_fg_tsbuf destinationOffset:4 size:4];
+        [ce writeTimestampWithGranularity:MTL4TimestampGranularityPrecise intoHeap:g_fg_heap atIndex:2 * k];
+    }
+    if (mv) fg_motion(ce, k, pk);
+    [ce barrierAfterStages:MTLStageBlit | MTLStageDispatch beforeQueueStages:MTLStageAll visibilityOptions:resource_vis()];
+    [ce endEncoding];
+    fi.colorTexture = col; fi.prevColorTexture = prev; fi.outputTexture = gen;
+    fi.depthTexture = g_fg_depth; fi.motionTexture = g_fg_motion; fi.motionVectorScaleX = 1; fi.motionVectorScaleY = 1;
+    fi.deltaTime = (float)period; fi.nearPlane = 0.1f; fi.farPlane = 1000; fi.fieldOfView = 60; fi.aspectRatio = (float)col.width / (float)col.height;
+    fi.jitterOffsetX = 0; fi.jitterOffsetY = 0; fi.depthReversed = YES;
+    fi.shouldResetHistory = g_fg_warm == 0;
+    [fi encodeToCommandBuffer:cb];
+    if (keep) fg_keep(cb, k, pk, gen);
+    if (g_fg_heap) {
+        id<MTL4ComputeCommandEncoder> te = [cb computeCommandEncoder];
+        [te barrierAfterQueueStages:MTLStageAll beforeStages:MTLStageBlit visibilityOptions:MTL4VisibilityOptionNone];
+        [te copyFromBuffer:g_fg_tsbuf sourceOffset:4 toBuffer:g_fg_tsbuf destinationOffset:0 size:4];
+        [te writeTimestampWithGranularity:MTL4TimestampGranularityPrecise intoHeap:g_fg_heap atIndex:2 * k + 1];
+        [te endEncoding];
+    }
+    g_fg_snap[k].gen_ok = ++g_fg_warm >= 3;
+    if (g_fg_snap[k].gen_ok && !(++g_fg_made % 1800))
+        MLOG("frame generation: %llu frames generated, the history started again %llu times", (unsigned long long)g_fg_made, (unsigned long long)g_fg_resets);
+}
+
+static int fg_menu_pause(void) {
+    if (g_fg_menu_pause_cached < 0) {
+        const char *e = getenv("DM_FRAMEGEN_MENU_PAUSE");
+        g_fg_menu_pause_cached = !e || atoi(e) != 0;
+        MLOG("frame generation: %s (DM_FRAMEGEN_MENU_PAUSE)",
+             g_fg_menu_pause_cached ? "pauses in the game's menus (under 300 draws a frame, after 30 s of play)" : "never pauses in menus");
+    }
+    uint64_t d = __atomic_load_n(&g_stat_draw, __ATOMIC_RELAXED), n = d - g_fg_pd_last;
+    g_fg_pd_last = d;
+    if (!g_fg_menu_pause_cached) return 0;
+    uint64_t f = atomic_load(&g_cur_frame);
+    if (n >= FG_MENU_DRAWS) {
+        g_fg_low = 0;
+        if (g_fg_armed < FG_MENU_ARM && ++g_fg_armed == FG_MENU_ARM)
+            MLOG("frame generation: menu pause armed at frame %llu (30 s of play)", (unsigned long long)f);
+        if (g_fg_paused && ++g_fg_high >= FG_MENU_OUT) {
+            g_fg_paused = 0; g_fg_high = 0;
+            if (g_fg_pauses <= 200) MLOG("frame generation: resumed at frame %llu (%llu draws a frame)", (unsigned long long)f, (unsigned long long)n);
+        }
+    } else {
+        g_fg_high = 0;
+        if (!g_fg_paused && g_fg_armed >= FG_MENU_ARM && ++g_fg_low >= FG_MENU_IN) {
+            g_fg_paused = 1; g_fg_low = 0;
+            if (++g_fg_pauses <= 200) MLOG("frame generation: paused at frame %llu, a menu (%llu draws a frame); pause %llu",
+                                           (unsigned long long)f, (unsigned long long)n, (unsigned long long)g_fg_pauses);
+        }
+    }
+    return g_fg_paused;
+}
