+// Joint memory-pressure trim on the submit thread (mtl_sub_begin, before a command buffer opens): converges RT heaps together with idle
+// texture ghost entries (down to RH_MEM_GHOST_CAP while sparing in-use entries), packaged texture spare copies, view cache, idle unreferenced
+// shared textures, idle upload staging slot blocks, and malloc pages. Driven by the single g_mp_src memory-pressure source (never a second listener).
+static void rh_mem_trim_sub_begin(void) { @autoreleasepool {
+    if (atomic_load(&g_gfx_teardown)) return;
+    int tier = atomic_exchange_explicit(&g_rh_tex_trim_req, 0, memory_order_acq_rel);
+    if (!tier) {
+        if (g_rh_tex_pressured && !atomic_load_explicit(&g_rh_pressure, memory_order_acquire)) {
+            pthread_mutex_lock(&g_smu);
+            own_ghost_limit_set_locked(NGHOST);
+            pthread_mutex_unlock(&g_smu);
+            g_rh_tex_pressured = 0;
+        }
+        return;
+    }
+    rh_trim();
+    int still_pressured = atomic_load_explicit(&g_rh_pressure, memory_order_acquire) != 0;
+    __block unsigned gn = 0, spn = 0;
+    __block uint64_t spb = 0;
+    uint32_t orn = 0; uint64_t orb = 0;
+    NSMutableArray *spares = [NSMutableArray array];
+    pthread_mutex_lock(&g_smu);
+    own_ghost_limit_set_locked(RH_MEM_GHOST_CAP);
+    gn = own_ghost_enforce_locked(NULL);
+    if (!still_pressured) own_ghost_limit_set_locked(NGHOST);
+    own_each_locked(^(uint64_t serial, id ob, int ghost) {
+        (void)serial;
+        if (ghost || ![ob isKindOfClass:NvPkg.class]) return;
+        NvPkg *pk = ob;
+        if (pk->spare) {
+            spb += pk->spare.heap ? 0 : pk->spare.allocatedSize;
+            spn++;
+            [spares addObject:pk->spare];
+            pk->spare = nil;
+        }
+    });
+    orn = own_alias_evict_idle_locked(tier >= 2 ? 16 : 64, &orb);
+    pthread_mutex_unlock(&g_smu);
+    for (id sp in spares) defer_obj_release(sp);
+    [spares removeAllObjects];
+    spares = nil;
+    unsigned ovn = 0;
+    os_unfair_lock_lock(&g_rmu);
+    ovn = g_vc.n;
+    nvn_hm_clear(&g_vc, vc_set_free);
+    os_unfair_lock_unlock(&g_rmu);
+    unsigned blk_n = 0; uint64_t blkb = 0;
+    int dropped_res = 0;
+    if (!g_up_cb && !g_up_block) {
+        for (unsigned s = 0; s < 3; s++) {
+            int busy = atomic_load(&g_up_alloc_busy[s]);
+            if (!busy) {
+                if (g_up_slot_blk[s]) { blkb += g_up_slot_blk[s].length; blk_n++; up_idle_drop(&g_up_slot_blk[s]); dropped_res = 1; }
+                if (g_up_slot_over[s]) { blkb += g_up_slot_over[s].length; blk_n++; up_idle_drop(&g_up_slot_over[s]); dropped_res = 1; }
+                g_up_slot_want[s] = 0;
+                g_up_idle_slot[s] = (up_idle_slot){0};
+            } else if (tier >= 2) {
+                if (g_up_slot_blk[s]) { blkb += g_up_slot_blk[s].length; blk_n++; id b = g_up_slot_blk[s]; g_up_slot_blk[s] = nil; defer_obj_release(b); }
+                if (g_up_slot_over[s]) { blkb += g_up_slot_over[s].length; blk_n++; id b = g_up_slot_over[s]; g_up_slot_over[s] = nil; defer_obj_release(b); }
+                g_up_slot_want[s] = 0;
+                g_up_idle_slot[s] = (up_idle_slot){0};
+            }
+        }
+    }
+    if (g_dev && g_q4 && !g_up_cb && (tier >= 2 || gn || spn || orn || blk_n)) {
+        mtl_finish_gpu();
+        pthread_mutex_lock(&g_deferred_mu);
+        for (NvDeferredRelease *d in g_deferred) if (d->fence > g_done) d->fence = g_done;
+        pthread_mutex_unlock(&g_deferred_mu);
+        defer_drain();
+        res_commit();
+    } else if (dropped_res) {
+        res_commit();
+    }
+    malloc_zone_pressure_relief(NULL, 0);
+    g_rh_tex_pressured = still_pressured;
+    MLOG("memory pressure trim (tier %d): idle ghost dropped %u (cap %d), spares %u (%llu MB), view cache %u, idle shared %u (%llu MB), staging blocks %u (%llu MB)",
+         tier, gn, still_pressured ? (int)RH_MEM_GHOST_CAP : (int)NGHOST, spn, (unsigned long long)(spb >> 20), ovn, orn, (unsigned long long)(orb >> 20), blk_n, (unsigned long long)(blkb >> 20));
+} }
 // A texture buffer bound to a slot whose 1D integer fetches the translator made 2D reads of rows of NVN_TBUF_ROW texels (nvn_refl f1d; Program.cs RecordTexelFetch1D): a linear 2D texture of
 // such rows over the same pool memory, so the shader reads the buffer. Maxwell reads 1D textures and texture buffers with the same instruction and the descriptor decides; without a type
 // answer the translator read them as 2D, and Age of Calamity's light and decal lists (and Three Houses' lighting) read the dummy texture, zeros. Kept with the texture's views (vc_set),
@@ -24066,6 +24228,14 @@ void dm_gfx_teardown(void) { @autoreleasepool {
     for (unsigned i = 0; i < g_rh_n; i++) if (g_rh[i].heap) CFRelease(g_rh[i].heap);
     free(g_rh); g_rh = NULL; g_rh_n = g_rh_cap = 0; g_rh_bytes = 0;
     os_unfair_lock_unlock(&g_rh_lk);
+    g_rh_mode = -1;
+    atomic_store(&g_rh_made, 0);
+    atomic_store(&g_rh_reused, 0);
+    atomic_store(&g_rh_trimmed, 0);
+    atomic_store(&g_rh_pressure, 0);
+    atomic_store(&g_rh_tex_trim_req, 0);
+    g_rh_tex_pressured = 0;
+    rh_test_set(0, 0, 0, 0);
 
     pthread_mutex_lock(&g_res_commit_mu);
     pthread_mutex_lock(&g_res_mu);
