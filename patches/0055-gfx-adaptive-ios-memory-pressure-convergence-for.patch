+static void fg_reset_owed(void) { g_fg_owed = 0; }
+
+static void fg_tick_note(double tick_time) {
+    double dt = tick_time - g_fg_tick_prev;
+    g_fg_tick_prev = tick_time;
+    if (dt > 0.004 && dt < 0.1) g_fg_tick = g_fg_tick > 0 ? g_fg_tick * 0.9 + dt * 0.1 : dt;
+}
+
+// Called with g_pq_mu held; returns 1 when an owed own-picture present is due on this tick.
+static int fg_has_owed(double tick_time) {
+    return g_fg_owed && tick_time >= g_fg_owe_at - 0.002;
+}
+
+// Called with g_pq_mu held; returns 1 (with g_pq_mu unlocked) when an owed own-picture present was handled on this tick.
+static int fg_service_owed(double tick_time, id<CAMetalDrawable> drawable, double target_ts) {
+    if (!fg_has_owed(tick_time)) return 0;
+    int newer = tick_time >= g_link_hold_until - 0.002 && g_pq_read != g_pq_in;
+    g_fg_owed = 0;
+    if (!newer && g_dm_present_link && !g_rescue_mode && !atomic_load(&g_present_suspended)) {
+        pq_item ow = g_fg_owe;
+        uint64_t tk = g_fg_owe_tk;
+        if (!(++g_fg_shown % 1800))
+            MLOG("frame generation on the display link: %llu generated frames shown, each followed by its present's own picture; %llu of those skipped for a newer present; "
+                 "presents dropped or late %llu, %llu of them shown without theirs (taken over dropped ones); "
+                 "made lighter %llu times and back %llu times, now the %s pixel budget",
+                 (unsigned long long)g_fg_shown, (unsigned long long)g_fg_late,
+                 (unsigned long long)g_fg_drops, (unsigned long long)g_fg_paused_behind,
+                 (unsigned long long)g_fg_lvl_downs, (unsigned long long)g_fg_lvl_ups,
+                 fg_fixed() ? "DM_FRAMEGEN_SCALE's" : g_fg_budget_name[atomic_load(&g_fg_level)]);
+        atomic_fetch_add(&g_link_presenting, 1);
+        pthread_mutex_unlock(&g_pq_mu);
+        atomic_store_explicit(&g_fg_owing, 1, memory_order_relaxed);
+        uint64_t p0 = now_ns();
+        @autoreleasepool { if (!atomic_load(&g_present_suspended)) present_now(&ow.t, 0, ow.frame, tk, ow.crop, ow.ev_val, drawable, target_ts, 0); }
+        atomic_store_explicit(&g_fg_owing, 0, memory_order_relaxed);
+        atomic_fetch_sub(&g_link_presenting, 1);
+        if (atomic_load(&g_present_suspended)) {
+            pthread_mutex_lock(&g_pq_mu);
+            pthread_cond_broadcast(&g_pq_cv);
+            pthread_mutex_unlock(&g_pq_mu);
+        }
+        uint64_t pd = now_ns() - p0;
+        if (pd >= 50000000ull) {
+            static uint64_t slow_n;
+            if (++slow_n <= 20 || !(slow_n % 100)) MLOG("display link callback took %.1f ms showing a picture after its generated frame (#%llu)", pd / 1e6, (unsigned long long)slow_n);
+        }
+        return 1;
+    }
+    g_fg_late++;
+    return 0;
+}
+
+static void fg_note_starved(int starved) { if (starved) g_fg_starved = 1; }
+
+static void fg_on_pop(pq_item *it, uint64_t ticket, uint64_t first) {
+    int behind = ticket > first, late = g_fg_starved, drop = behind || late;
+    g_fg_starved = 0;
+    if (drop) {
+        int again = g_fg_last_drop && ticket - g_fg_last_drop <= FG_AGAIN;
+        g_fg_last_drop = ticket;
+        g_fg_lvl_calm = 0;
+        g_fg_drops++;
+        if (again && fg_on()) {
+            int st = fg_level_down();
+            if (st < 0) {
+                static uint64_t n;
+                if (!(n++ % 100)) MLOG("frame generation: frames keep dropping, but the interpolation takes only %.1f ms: the game's frames are late, not its; its frames keep the %s pixel budget (%llu drops so far)",
+                                       atomic_load(&g_fg_gpu_avg_us) / 1000.0, g_fg_budget_name[atomic_load(&g_fg_level)], (unsigned long long)g_fg_drops);
+            } else if (st > 0) {
+                if (g_fg_up_at && ticket - g_fg_up_at <= FG_UP_BACK) g_fg_up_need = MIN(g_fg_up_need * 2, FG_UP_CALM_MAX);
+                g_fg_lvl_downs++;
+                g_fg_last_drop = 0;
+                MLOG("frame generation: frames keep dropping, its frames are made lighter: the %s pixel budget (step %d of %d; #%llu)",
+                     g_fg_budget_name[atomic_load(&g_fg_level)], atomic_load(&g_fg_level) + 1, FG_LEVELS, (unsigned long long)g_fg_lvl_downs);
+            } else {
+                static uint64_t n;
+                if (!(n++ % 100)) MLOG("frame generation: frames keep dropping at its lightest frames (the %s pixel budget); it keeps running, never falling back to 30 fps (%llu drops so far)",
+                                       fg_fixed() ? "DM_FRAMEGEN_SCALE's" : g_fg_budget_name[atomic_load(&g_fg_level)], (unsigned long long)g_fg_drops);
+            }
+        }
+    }
+    if (!drop && atomic_load(&g_fg_level) > 0 && ++g_fg_lvl_calm >= (uint64_t)g_fg_up_need) {
+        atomic_store(&g_fg_level, atomic_load(&g_fg_level) - 1);
+        g_fg_lvl_calm = 0;
+        g_fg_up_at = ticket;
+        g_fg_lvl_ups++;
+        MLOG("frame generation: %d presents in a row in time, its frames back to the %s pixel budget (step %d of %d)",
+             g_fg_up_need, g_fg_budget_name[atomic_load(&g_fg_level)], atomic_load(&g_fg_level) + 1, FG_LEVELS);
+    }
+    if (it->gen && behind) { it->gen = 0; g_fg_paused_behind++; }
+}
+
+static int fg_present_begin(const pq_item *it, tex_t *gt) {
+    int gen = it->gen && g_fg_tick > 0 && it->period >= 1.5 * g_fg_tick;
+    if (gen) { memset(gt, 0, sizeof *gt); gt->magic = MAGIC('T', 'E', 'X', 0); gt->serial = it->gen; }
+    return gen;
+}
+
+static void fg_present_end(int submitted, int gen, const pq_item *it, uint64_t ticket, double tick_time) {
+    if (submitted && gen) {
+        pthread_mutex_lock(&g_pq_mu);
+        g_fg_owe = *it;
+        g_fg_owe_tk = ticket;
+        g_fg_owe_at = tick_time + it->period / 2;
+        g_fg_owed = 1;
+        pthread_mutex_unlock(&g_pq_mu);
+    }
+}
+
+static void fg_teardown(void) {
+    fg_retire_current();
+    fg_reap_retired(1);
+    for (int i = 0; i < SNAP_MAX; i++) {
+        g_fg_snap[i].gen = nil; g_fg_snap[i].gen_old = nil;
+        g_fg_snap[i].lum = nil; g_fg_snap[i].lum_old = nil;
+        g_fg_snap[i].gen_serial = 0; g_fg_snap[i].seq = 0; g_fg_snap[i].gen_ok = 0;
+        g_fg_uv[i] = nil;
+    }
+    g_fg_comp = nil; g_fg_heap = nil; g_fg_tsbuf = nil;
+    g_fg_scale_pso = nil; g_fg_scale_fmt = MTLPixelFormatInvalid; g_fg_args = nil; g_fg_samp = nil;
+    for (int i = 0; i < 8; i++) g_fgmv_ps[i] = nil;
+    g_fgmv_args = nil;
+    memset(g_fg_key, 0, sizeof g_fg_key);
+    g_fg_bad = 0; g_fg_clear = 0;
+    atomic_store_explicit(&g_fg_mode, -1, memory_order_relaxed);
+    g_fgmv_ok = -1;
+    atomic_store_explicit(&g_fg_gpu_last, 0, memory_order_relaxed);
+    atomic_store(&g_fg_gpu_avg_us, 0);
+    g_fg_seq = 0; g_fg_made = 0; g_fg_resets = 0; g_fg_warm = 0;
+    g_fg_owe = (pq_item){0};
+    g_fg_owe_tk = 0; g_fg_owe_at = 0; g_fg_tick = 0; g_fg_owed = 0;
+    atomic_store_explicit(&g_fg_owing, 0, memory_order_relaxed);
+    g_fg_shown = 0; g_fg_late = 0;
+    g_fg_starved = 0; g_fg_paused_behind = 0; g_fg_last_drop = 0; g_fg_drops = 0;
+    atomic_store(&g_fg_level, 0);
+    atomic_store(&g_fg_shown_px, 0);
+    g_fg_lvl_calm = 0; g_fg_up_at = 0; g_fg_lvl_downs = 0; g_fg_lvl_ups = 0; g_fg_up_need = FG_UP_CALM;
+    g_fg_paused = 0; g_fg_pd_last = 0; g_fg_pauses = 0; g_fg_low = 0; g_fg_high = 0; g_fg_armed = 0;
+    atomic_store_explicit(&g_fg_fixed_init, 0, memory_order_relaxed);
+    g_fg_fixed_cached = 0;
+    atomic_store_explicit(&g_fg_heavy_init, 0, memory_order_relaxed);
+    g_fg_heavy_ms_cached = 0;
+    g_fg_menu_pause_cached = -1;
+    g_fg_last_logged_factor = -1; g_fg_tick_prev = 0;
+    pthread_mutex_lock(&g_fg_gpu_mu);
+    memset(g_fg_gpu_samples, 0, sizeof g_fg_gpu_samples);
+    g_fg_gpu_sample_n = 0;
+    pthread_mutex_unlock(&g_fg_gpu_mu);
+}
+
+#endif
diff --git a/dm/gfx/nvn/nvn_mip_skip.h b/dm/gfx/nvn/nvn_mip_skip.h
new file mode 100644
index 0000000..c636fba
--- /dev/null
+++ b/dm/gfx/nvn/nvn_mip_skip.h
@@ -0,0 +1,177 @@
+// Static texture top-mip skipping (DM_NVN_TEX_MIP_SKIP=0|1|2).
+// Skips the finest 1 or 2 mip levels of large block-compressed packaged 2D / 2D-array textures
+// at upload time to cut GPU memory footprint and bandwidth without recompiling games.
+// Textures that become GPU copy/clear sources or destinations are hardened back to full size
+// (keyed by guest storage address) so terrain/atlas copies never read truncated levels.
+#ifndef DM_NVN_MIP_SKIP_H
+#define DM_NVN_MIP_SKIP_H
+
+#include <os/lock.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct {
+    uint32_t width, height, levels, samples, block_w, block_h;
+    int has_layout, has_mem, is_2d, sparse_pool, linear;
+} nvn_mip_skip_desc;
+
+typedef struct {
+    uint64_t *keys;
+    size_t cap, count;
+} nvn_mip_skip_set;
+
+static _Atomic int g_nvn_mip_skip_env = -1;
+static os_unfair_lock g_nvn_mip_skip_lk = OS_UNFAIR_LOCK_INIT;
+static nvn_mip_skip_set g_nvn_mip_skip_hardened = {0};
+static _Atomic uint64_t g_nvn_mip_skip_uploads = 0;
+static _Atomic uint64_t g_nvn_mip_skip_hardens = 0;
+static _Atomic uint64_t g_nvn_mip_skip_saved = 0;
+
+static inline unsigned nvn_mip_skip_parse(const char *s) {
+    if (!s || !*s) return 0;
+    char *end = NULL;
+    long v = strtol(s, &end, 10);
+    if (end == s || v <= 0) return 0;
+    return v >= 2 ? 2u : 1u;
+}
+
+static inline unsigned nvn_mip_skip_mode(void) {
+    int v = atomic_load_explicit(&g_nvn_mip_skip_env, memory_order_relaxed);
+    if (v < 0) {
+        v = (int)nvn_mip_skip_parse(getenv("DM_NVN_TEX_MIP_SKIP"));
+        atomic_store_explicit(&g_nvn_mip_skip_env, v, memory_order_relaxed);
+    }
+    return (unsigned)v;
+}
+
+static inline void nvn_mip_skip_reset_env(void) {
+    atomic_store_explicit(&g_nvn_mip_skip_env, -1, memory_order_relaxed);
+}
+
+// Effective mip count that a 2D texture of width x height can hold.
+static inline uint32_t nvn_mip_skip_fit_levels(uint32_t w, uint32_t h, uint32_t levels) {
+    uint32_t big = w > h ? w : h;
+    uint32_t fit = 1;
+    while (big >> fit) fit++;
+    if (!levels) levels = 1;
+    return levels < fit ? levels : fit;
+}
+
+// Number of top mip levels to skip (0, 1, or 2) for a packaged texture candidate.
+// Preserves at least 2 mip levels, at least 128x128 dimensions, and exact compression block alignment
+// so downstream compressed uploads and BC-to-ASTC 4x4 transcoders always see aligned extents.
+static inline unsigned nvn_mip_skip_calc(const nvn_mip_skip_desc *d, unsigned req_skip) {
+    if (!d || !req_skip) return 0;
+    if (!d->has_layout || !d->has_mem || !d->is_2d || d->sparse_pool || d->linear) return 0;
+    if (d->samples > 1 || d->block_w < 2 || d->block_h < 2) return 0;
+    uint32_t lo = d->width < d->height ? d->width : d->height;
+    uint32_t hi = d->width < d->height ? d->height : d->width;
+    if (hi < 512u || lo < 256u) return 0;
+    uint32_t levels = nvn_mip_skip_fit_levels(d->width, d->height, d->levels);
+    if (levels < 3u) return 0;
+    unsigned max_try = req_skip > 2u ? 2u : req_skip;
+    for (unsigned s = max_try; s >= 1u; s--) {
+        if (levels < s + 2u) continue;
+        uint32_t nw = d->width >> s;
+        uint32_t nh = d->height >> s;
+        if (nw < 128u || nh < 128u) continue;
+        if ((nw % d->block_w) != 0u || (nh % d->block_h) != 0u) continue;
+        return s;
+    }
+    return 0;
+}
+
+static inline uint64_t nvn_mip_skip_saved_bytes(uint64_t level_skip_offset, uint32_t layers) {
+    return level_skip_offset * (uint64_t)(layers ? layers : 1u);
+}
+
+static inline size_t nvn_mip_skip_slot(uint64_t k, size_t cap) {
+    return (size_t)((k * 0x9E3779B97F4A7C15ull) >> 17) & (cap - 1u);
+}
+
+static inline int nvn_mip_skip_set_has(const nvn_mip_skip_set *s, uint64_t k) {
+    if (!s->cap || !k) return 0;
+    for (size_t i = nvn_mip_skip_slot(k, s->cap);; i = (i + 1u) & (s->cap - 1u)) {
+        if (s->keys[i] == k) return 1;
+        if (!s->keys[i]) return 0;
+    }
+}
+
+static inline int nvn_mip_skip_set_add(nvn_mip_skip_set *s, uint64_t k) {
+    if (!k || nvn_mip_skip_set_has(s, k)) return 0;
+    if ((s->count + 1u) * 2u > s->cap) {
+        size_t oc = s->cap, nc = oc ? oc * 2u : 256u;
+        uint64_t *o = s->keys;
+        uint64_t *nk = (uint64_t *)calloc(nc, sizeof *nk);
+        if (!nk) return 0;
+        s->keys = nk;
+        s->cap = nc;
+        s->count = 0;
+        for (size_t i = 0; i < oc; i++) {
+            if (o[i]) {
+                size_t j = nvn_mip_skip_slot(o[i], nc);
+                while (nk[j]) j = (j + 1u) & (nc - 1u);
+                nk[j] = o[i];
+                s->count++;
+            }
+        }
+        free(o);
+    }
+    size_t i = nvn_mip_skip_slot(k, s->cap);
+    while (s->keys[i]) i = (i + 1u) & (s->cap - 1u);
+    s->keys[i] = k;
+    s->count++;
+    return 1;
+}
+
+static inline void nvn_mip_skip_set_clear(nvn_mip_skip_set *s) {
+    free(s->keys);
+    s->keys = NULL;
+    s->cap = 0;
+    s->count = 0;
+}
+
+static inline int nvn_mip_skip_is_hardened(uint64_t addr) {
+    if (!addr) return 0;
+    os_unfair_lock_lock(&g_nvn_mip_skip_lk);
+    int r = nvn_mip_skip_set_has(&g_nvn_mip_skip_hardened, addr);
+    os_unfair_lock_unlock(&g_nvn_mip_skip_lk);
+    return r;
+}
+
+static inline int nvn_mip_skip_mark_hardened(uint64_t addr) {
+    if (!addr) return 0;
+    os_unfair_lock_lock(&g_nvn_mip_skip_lk);
+    int added = nvn_mip_skip_set_add(&g_nvn_mip_skip_hardened, addr);
+    os_unfair_lock_unlock(&g_nvn_mip_skip_lk);
+    return added;
+}
+
+static inline void nvn_mip_skip_record_upload(uint64_t saved_bytes) {
+    atomic_fetch_add_explicit(&g_nvn_mip_skip_uploads, 1u, memory_order_relaxed);
+    atomic_fetch_add_explicit(&g_nvn_mip_skip_saved, saved_bytes, memory_order_relaxed);
+}
+
+static inline void nvn_mip_skip_record_harden(void) {
+    atomic_fetch_add_explicit(&g_nvn_mip_skip_hardens, 1u, memory_order_relaxed);
+}
+
+static inline void nvn_mip_skip_stats(uint64_t *skipped, uint64_t *hardened, uint64_t *saved_bytes) {
+    if (skipped) *skipped = atomic_load_explicit(&g_nvn_mip_skip_uploads, memory_order_relaxed);
+    if (hardened) *hardened = atomic_load_explicit(&g_nvn_mip_skip_hardens, memory_order_relaxed);
+    if (saved_bytes) *saved_bytes = atomic_load_explicit(&g_nvn_mip_skip_saved, memory_order_relaxed);
+}
+
+static inline void nvn_mip_skip_teardown(void) {
+    os_unfair_lock_lock(&g_nvn_mip_skip_lk);
+    nvn_mip_skip_set_clear(&g_nvn_mip_skip_hardened);
+    os_unfair_lock_unlock(&g_nvn_mip_skip_lk);
+    atomic_store_explicit(&g_nvn_mip_skip_uploads, 0u, memory_order_relaxed);
+    atomic_store_explicit(&g_nvn_mip_skip_hardens, 0u, memory_order_relaxed);
+    atomic_store_explicit(&g_nvn_mip_skip_saved, 0u, memory_order_relaxed);
+    atomic_store_explicit(&g_nvn_mip_skip_env, -1, memory_order_relaxed);
+}
+
+#endif
