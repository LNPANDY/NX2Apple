+    NSString *fwd = [NSBundle.mainBundle.privateFrameworksURL URLByAppendingPathComponent:@DM_FRAMEWORK_DIRECTORY].path;
+    setenv("DM_PROFILE", [fwd stringByAppendingPathComponent:@"profile.tsv"].fileSystemRepresentation, 1);
+    fprintf(stderr, "boot: game framework %s\n", fwd.fileSystemRepresentation);
+#endif
     // Environment switch files (for on-device diagnostics: a sideloaded app cannot be given environment variables from outside): one KEY=VALUE per line, # starts a comment; Documents/env.txt takes precedence over dm/env.txt in the bundle (put there by build_ipa.sh's DM_ENV_FILE)
     NSMutableArray<NSString *> *from_file = [NSMutableArray array], *from_launch = [NSMutableArray array];
     for (char **e = environ; *e; e++) {   // set at launch (Xcode, devicectl): before the env files, and the launcher keeps them
@@ -283,6 +298,12 @@ static int boot_env(void) {
     if (!set_data_env(romfs, NO)) { if (!romfs) romfs_identity_report(doc);   // a slim build says why its romfs.img was not used
         fprintf(stderr, "boot: no game data yet (Documents/romfs.img, Documents/romfs or <App>/romfs); the launcher asks for it\n"); }
     setenv("DM_GUEST_FILE_DIR", NSTemporaryDirectory().fileSystemRepresentation, 0);   // DM_GUEST_FILE (hle_svc.c) keeps the guest's memory in files there
+#if DM_FRAMEWORK_BUILD
+    // Route C: the modules, their rewriter tables and the shader map are the framework's. dlopen + dlsym + dladdr hand its
+    // mach header to the loader here, after the data went to DM_ROMFS and before loading starts (the design's order).
+    if (!dm_open_game_framework(fwd.fileSystemRepresentation)) return 0;
+    dm = [fwd stringByAppendingPathComponent:@"dm"];
+#endif
     setenv("DM_NVN_SHMAP", [dm stringByAppendingPathComponent:@"shader_map.tsv"].fileSystemRepresentation, 0);
     // Shader libraries: a game's own <gdir>/msl first (a per-game layout may carry its own), else
     // the app's shared <App>/msl (the program's <App>/msl/p<N> in a game of several programs).
diff --git a/dm/ios/framework/DmGameMarker.m b/dm/ios/framework/DmGameMarker.m
new file mode 100644
index 00000000..c03357d4
--- /dev/null
+++ b/dm/ios/framework/DmGameMarker.m
@@ -0,0 +1,10 @@
+// The DmGame framework's only symbol. The framework carries the game's rewritten modules in Mach-O sections (Gen/embed.S,
+// the same file the default build compiles into the executable) and no host code; dlopen()ing it maps and signs those
+// sections, and dm/ios/Sources/FrameworkBootstrap.m finds this marker with dlsym() and reports the framework's mach header
+// through dladdr(). The loader (dm/host/loader.c, front.h) then reads the module sections from it.
+// Its value is not read: the symbol's address alone names the image, so it must stay externally visible (default visibility,
+// not static) and survive the linker.
+#include <stdint.h>
+
+__attribute__((used, visibility("default")))
+const char dmgame_image_marker[] = "DmGame";
diff --git a/dm/ios/framework/ShellGlue.h b/dm/ios/framework/ShellGlue.h
new file mode 100644
index 00000000..e5b52e21
--- /dev/null
+++ b/dm/ios/framework/ShellGlue.h
@@ -0,0 +1,11 @@
+// Route C shell (LNPANDY/NX2Apple#451): the entry points each game's DmGame<title ID>.framework exports for ShellMain.m to
+// look up with dlsym on the handle it dlopens at Play. Each game framework links its own dm/host, front_ios.m and shaders, so an
+// engine update never invalidates the games already in the shell.
+#pragma once
+
+// Bumped only when a signature below changes: a shell refuses a framework whose dm_glue_version does not match.
+#define DM_GLUE_VERSION 1
+
+typedef const char *(*dm_glue_start_fn)(const char *const *argv, int argc, const void *game_image);
+typedef void (*dm_glue_present_fn)(void *window);
+typedef void (*dm_glue_focus_fn)(int ev);
diff --git a/dm/ios/framework/ShellGlue.m b/dm/ios/framework/ShellGlue.m
new file mode 100644
index 00000000..5ddd0e4f
--- /dev/null
+++ b/dm/ios/framework/ShellGlue.m
@@ -0,0 +1,77 @@
+// Route C shell (LNPANDY/NX2Apple#451): compiled into each game's DmGame<title ID>.framework (project-framework.yml DmShellGame)
+// alongside dm/host, front_ios.m and Gen/embed.S. ShellMain.m sets the environment, dlopens the chosen game's framework and calls
+// dm_glue_start_game and dm_glue_present_game through dlsym.
+// This file also provides the symbols front_ios.m takes from main.m and Launcher.swift in the one-game app, so the framework
+// compiles front_ios.m, DmGamepad.m and GameMenu.swift unchanged.
+#import <UIKit/UIKit.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include "front.h"
+#include "ShellGlue.h"
+
+int dm_main(int argc, char **argv);   // dm/host/main.c compiled in with -Dmain=dm_main
+UIViewController *front_ios_root(void);
+void front_ios_focus_event(int ev);
+
+__attribute__((used, visibility("default"))) const int dm_glue_version = DM_GLUE_VERSION;
+
+static char **g_argv; static int g_argc; static int g_boot_ok;
+
+__attribute__((used, visibility("default")))
+const char *dm_glue_start_game(const char *const *argv, int argc, const void *game_image) {
+    if (argc < 2 || !game_image) return "The game's start arguments are incomplete.";
+    front_hud_env();   // before the early loading below can make a device (main.m's order)
+    dm_set_game_image_header(game_image);
+    g_argc = argc; g_argv = calloc((size_t)argc + 1, sizeof(char *));
+    for (int i = 0; i < argc; i++) g_argv[i] = strdup(argv[i]);
+    dm_host_preload_start(g_argc, g_argv);   // module tables, relocation and take-over in the background while the game view comes up
+    g_boot_ok = 1;
+    return NULL;
+}
+
+__attribute__((used, visibility("default")))
+void dm_glue_present_game(void *win) {
+    UIWindow *window = (__bridge UIWindow *)win;
+    if (!window) { fprintf(stderr, "[RED] shell: no window for the game view\n"); return; }
+    UIViewController *game = front_ios_root();   // DmRootVC: landscape, its viewDidAppear starts the game (no settings screen: dm_show_launcher)
+    window.rootViewController = game;
+    [game setNeedsUpdateOfSupportedInterfaceOrientations];
+    [window.windowScene requestGeometryUpdateWithPreferences:[[UIWindowSceneGeometryPreferencesIOS alloc] initWithInterfaceOrientations:UIInterfaceOrientationMaskLandscape]
+                                                errorHandler:^(NSError *e) { fprintf(stderr, "shell: landscape request: %s\n", e.localizedDescription.UTF8String); }];
+}
+
+__attribute__((used, visibility("default")))
+void dm_glue_focus_event(int ev) {
+    front_ios_focus_event(ev);
+}
+
+// ---- what front_ios.m takes from main.m and Launcher.swift ----
+static void *boot_thread(void *p) {
+    (void)p;
+    static char alt[65536]; stack_t ss = {.ss_sp = alt, .ss_size = sizeof alt}; sigaltstack(&ss, 0);   // crash printing must work on the host thread too
+    int rc = dm_main(g_argc, g_argv);
+    fprintf(stderr, "boot: dm_main returned %d\n", rc);
+    return NULL;
+}
+void front_ios_boot(void) {   // front_ios.m, once the game view exists
+    static int once; if (once++ || !g_boot_ok) return;
+    void front_ios_audio_session(void); front_ios_audio_session();
+    pthread_attr_t a; pthread_attr_init(&a); pthread_attr_setstacksize(&a, 64u << 20);
+    pthread_t t; pthread_create(&t, &a, boot_thread, NULL); pthread_detach(t);
+}
+int front_ios_boot_ok(void) { return g_boot_ok; }
+const char *front_ios_boot_message(void) { return NULL; }
+const char *front_ios_device_check(void) { return NULL; }   // main.m checks the GPU for the games (no BC textures, seedds#704) when Play is pressed, the shell does its own device handling: NULL = supported
+// The shell found the data before Play (DataLocator, EngineLaunchPlan): DM_ROMFS is set and the game view only checks it is still there
+int dm_locate_game_data(void) {
+    const char *r = getenv("DM_ROMFS"); struct stat st;
+    if (r && !stat(r, &st)) return 1;
+    fprintf(stderr, "[RED] shell: the game data at %s is gone\n", r ?: "(not set)");
+    return 0;
+}
+// The shell showed its own settings before Play: the game view starts the game at once
+bool dm_show_launcher(void *view_controller, void (*done)(void)) { (void)view_controller; (void)done; return false; }
diff --git a/dm/ios/project-framework.yml b/dm/ios/project-framework.yml
new file mode 100644
index 00000000..89a2df5f
--- /dev/null
+++ b/dm/ios/project-framework.yml
@@ -0,0 +1,200 @@
+# Route C framework project (docs/launcher-c-plan.md M1): the same app as project.yml, except that the game's rewritten
+# modules are not compiled into the executable (no Gen/embed.S) but into DmGame.framework, which the app dlopens at launch.
+# build_ipa.sh DM_FRAMEWORK=1 generates Gen/ and Gen/framework before xcodegen runs; the app source reads the framework's
+# mach header before the loader starts (dm/ios/Sources/FrameworkBootstrap.m, dm/host/front.h).
+# The default project (project.yml) is untouched: without DM_FRAMEWORK the build is what it was.
+name: DmIOS
+options:
+  bundleIdPrefix: ${DM_BUNDLE_ID}
+  deploymentTarget:
+    iOS: "26.0"   # Graphics replay uses Metal 4 (MTL4CommandQueue etc., from iOS 26)
+configFiles:     # Generated by build_ipa.sh: embedded-segment link flags + header paths and frameworks taken from dm/host/Makefile
+  Release: Gen/dm.xcconfig
+  Debug: Gen/dm.xcconfig
+targets:
+  DmIOS:
+    type: application
+    platform: iOS
+    sources:
+      - path: Sources
+        excludes: [Info.plist]  # generated per project under Gen/, so games never share the generated plist
+      # No Gen/embed.S: the modules are the DmGame framework's (below)
+      - path: Gen/dm          # Rewriter tables (*.fixups.tsv / gates / cuts / obs) + shader map / c1 list / warm-up list
+        type: folder
+        buildPhase: resources
+      - path: Gen/Assets.xcassets   # app icon (generated by build_ipa.sh from the game icon; an empty catalog when there is none, since xcodegen lists it in the project whether or not it exists)
+      - path: Gen/src         # Source files from the compile commands of dm/host/Makefile (linked in by tools/gen_build.py)
+      - path: Gen/main/main.c
+        compilerFlags: "-Dmain=dm_main"
+    dependencies:             # The framework is dlopen()ed at launch, not linked: embed it, add no load command (link: false)
+      - target: DmGame
+        embed: true
+        link: false
+    postBuildScripts:
+      - name: Copy game resources
+        script: /bin/bash "${SRCROOT}/tools/stage_resources.sh"
+        basedOnDependencyAnalysis: false   # rsync checks the game's files; no huge Xcode input/output lists
+    info:
+      path: Gen/Info.plist
+      properties:
+        CFBundleDisplayName: ${DM_DISPLAY_NAME}   # the game name in the base NSP (set by build_ipa.sh)
+        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
+        CFBundleShortVersionString: $(MARKETING_VERSION)
+        UILaunchStoryboardName: ""
+        UIFileSharingEnabled: true          # Documents (log.txt, saves) visible in the Files app
+        LSSupportsOpeningDocumentsInPlace: true
+        UISupportedInterfaceOrientations:
+          - UIInterfaceOrientationLandscapeRight
+          - UIInterfaceOrientationLandscapeLeft
+        UIRequiresFullScreen: true
+        UIStatusBarHidden: true
+        UIViewControllerBasedStatusBarAppearance: false
+        LSApplicationCategoryType: ${DM_APP_CATEGORY}   # game profile app_category
+        DMShowFPS: ${DM_SHOW_FPS}           # YES = the frame-rate counter is on (front_ios.m; set by build_ipa.sh)
+        DMLanguage: ${DM_LANG}              # the game language code (main.m sets DM_LANG from it; set by build_ipa.sh)
+        LSSupportsGameMode: true
+        GCSupportsControllerUserInteraction: true   # Physical controllers (GameController)
+        GCSupportedGameControllers:
+          - ProfileName: ExtendedGamepad
+        CADisableMinimumFrameDurationOnPhone: true
+        UIApplicationSceneManifest:
+          UIApplicationSupportsMultipleScenes: false
+          UISceneConfigurations:
+            UIWindowSceneSessionRoleApplication:
+              - UISceneConfigurationName: Default
+                UISceneDelegateClassName: SceneDelegate
+    settings:
+      PRODUCT_BUNDLE_IDENTIFIER: ${DM_BUNDLE_ID}
+      PRODUCT_NAME: DmIOS
+      MARKETING_VERSION: ${DM_APP_VERSION}         # the game's display version: the packed update's, else the base game's (set by build_ipa.sh)
+      CURRENT_PROJECT_VERSION: ${DM_APP_VERSION}
+      DEVELOPMENT_TEAM: ${DM_TEAM_ID}
+      CODE_SIGN_STYLE: Automatic
+      ENABLE_USER_SCRIPT_SANDBOXING: NO    # the game's files live on the external drive
+      DM_COPY_GAME_RESOURCES: YES          # build_ipa.sh overrides this only for its unsigned archive build
+      SYMROOT: $(DM_XCODE_OUTPUT_ROOT)/Build/Products
+      OBJROOT: $(DM_XCODE_OUTPUT_ROOT)/Build/Intermediates.noindex
+      # Workspaces can override SYMROOT/OBJROOT. Keep app bundles and compiles separate even then.
+      CONFIGURATION_BUILD_DIR: $(DM_XCODE_OUTPUT_ROOT)/Build/Products/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
+      CONFIGURATION_TEMP_DIR: $(DM_XCODE_OUTPUT_ROOT)/Build/Intermediates.noindex/$(PROJECT_NAME).build/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
+      ASSETCATALOG_COMPILER_APPICON_NAME: $(DM_APPICON)   # Gen/dm.xcconfig sets DM_APPICON = AppIcon when there is a game icon; empty = no icon (xcodegen's default is AppIcon, which fails the build when the catalog lacks it)
+      TARGETED_DEVICE_FAMILY: "1,2"
+      ENABLE_BITCODE: NO
+      GCC_C_LANGUAGE_STANDARD: gnu11
+      OTHER_CFLAGS: $(inherited) -mcpu=apple-a18 -DDM_FRAMEWORK_BUILD=1   # The host assembly contains LSE atomic instructions, which the default baseline does not accept; the framework build compiles main.m's dlopen path
+      LD_RUNPATH_SEARCH_PATHS: $(inherited) @executable_path/Frameworks   # where the embedded DmGame.framework is
+      CLANG_ENABLE_OBJC_ARC: YES
+      SWIFT_VERSION: "5.0"                         # Launcher.swift (SwiftUI)
+      SWIFT_OBJC_BRIDGING_HEADER: Sources/DmIOS-Bridging-Header.h   # DataBookmark (the Files app pick)
+      DEBUG_INFORMATION_FORMAT: dwarf
+      GCC_WARN_INHIBIT_ALL_WARNINGS: YES
+  DmGame:
