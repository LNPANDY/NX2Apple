+                   png_chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)) +
+                   png_chunk(b'IDAT', zlib.compress(raw_rows)) +
+                   png_chunk(b'IEND', b''))
