+        if not stat.S_ISDIR(st.st_mode):
+            raise ValueError(f'seed_root is not a directory: {root}')
+    else:
+        return {
+            'seed_root': root_abs,
+            'zstd_available': zstd_ok,
+            'total_games': 0,
+            'total_files': 0,
+            'uncompressed_bytes': 0,
+            'estimated_compressed_bytes': 0,
+            'estimated_saved_bytes': 0,
+            'games': [],
+        }
+
+    root_real = os.path.realpath(root)
+    games = []
+    with os.scandir(root) as it:
+        entries = sorted(it, key=lambda e: e.name)
+
+    for entry in entries:
+        if entry.name.startswith('.'):
+            continue
+        if entry.is_symlink() or _is_symlink_or_reparse(entry.path):
+            continue
+        if not entry.is_dir(follow_symlinks=False):
+            continue
+        tid = entry.name.upper()
+        if not _TID_RE.fullmatch(tid):
+            continue
