+def _scan_metal_sources_tree(metal_dir, *, allow_symlinks_as_error=False):
+    """Safely walks metal-sources/ without following symlinks.
+    Returns ([(relpath, abs_path, size_bytes, is_symlink_error), ...], tree_error_or_None)."""
+    if not os.path.lexists(metal_dir):
+        return [], None
+    mst = os.lstat(metal_dir)
+    if _is_symlink_or_reparse(metal_dir, mst):
+        msg = f'symlink forbidden for metal-sources: {metal_dir}'
+        return ([], msg) if allow_symlinks_as_error else ([], None)
+    if not stat.S_ISDIR(mst.st_mode):
+        return [], None
+
+    metal_real = os.path.realpath(metal_dir)
+    found = []
+    stack = [(metal_dir, '')]
+    visited = {_dir_loop_key(metal_dir, mst)}
+    entries_seen = 0
+
+    while stack:
+        cur_dir, cur_rel = stack.pop()
+        try:
+            with os.scandir(cur_dir) as it:
+                entries = sorted(it, key=lambda e: e.name)
+        except OSError as exc:
+            if allow_symlinks_as_error:
+                return found, f'cannot scan {cur_dir}: {exc}'
+            continue
+
+        for entry in entries:
+            entries_seen += 1
+            if entries_seen > SEED_MAX_ENTRIES:
+                return found, f'metal-sources exceeds entry quota ({SEED_MAX_ENTRIES})'
+            name = entry.name
+            if name.startswith('.') or '.tmp' in name or name.endswith('.part'):
+                continue
+            rel = f'{cur_rel}/{name}' if cur_rel else name
+            try:
+                _validate_rel_path(rel, metal_dir)
+            except ValueError as exc:
+                if allow_symlinks_as_error:
+                    return found, str(exc)
+                continue
+
+            try:
+                est = entry.stat(follow_symlinks=False)
+            except OSError as exc:
+                if allow_symlinks_as_error:
+                    return found, f'cannot stat {entry.path}: {exc}'
+                continue
+
+            if entry.is_symlink() or _is_symlink_or_reparse(entry.path, est):
+                if allow_symlinks_as_error:
+                    return found, f'symlink forbidden inside metal-sources: {entry.path}'
+                continue
+
+            if stat.S_ISDIR(est.st_mode):
+                try:
+                    lst = os.lstat(entry.path)
+                except OSError:
+                    continue
+                if _is_symlink_or_reparse(entry.path, lst) or not stat.S_ISDIR(lst.st_mode):
+                    if allow_symlinks_as_error:
+                        return found, f'symlink forbidden inside metal-sources: {entry.path}'
+                    continue
+                key = _dir_loop_key(entry.path, lst)
+                if key in visited:
+                    if allow_symlinks_as_error:
+                        return found, f'directory loop inside metal-sources: {entry.path}'
+                    continue
+                visited.add(key)
+                stack.append((entry.path, rel))
+            elif stat.S_ISREG(est.st_mode) and name.startswith('b-') and name.endswith('.img'):
+                try:
+                    ent_real = os.path.realpath(entry.path)
+                    if os.path.commonpath([metal_real, ent_real]) != metal_real:
+                        if allow_symlinks_as_error:
+                            return found, f'path escapes metal-sources: {entry.path}'
+                        continue
+                except ValueError:
+                    continue
+                found.append((rel, entry.path, est.st_size))
+
+    found.sort(key=lambda item: item[0])
+    return found, None
