+def _refresh_seed_json_timestamp(seed_dir):
+    """Best-effort atomic refresh of seed.json updated_at without altering existing fields."""
+    seed_json = os.path.join(seed_dir, 'seed.json')
+    if not os.path.lexists(seed_json):
+        return
+    try:
+        st = os.lstat(seed_json)
+        if _is_symlink_or_reparse(seed_json, st) or not stat.S_ISREG(st.st_mode):
+            return
+        with open(seed_json, 'r', encoding='utf-8') as f:
+            data = json.load(f)
+        if not isinstance(data, dict) or data.get('schema') != SEED_SCHEMA_VERSION:
+            return
+        data['updated_at'] = _utc_now_iso()
+        payload = (json.dumps(data, indent=2, ensure_ascii=False) + '\n').encode('utf-8')
+        tmp_json = os.path.join(seed_dir, f'.seed.json.{os.getpid()}.tmp')
+        if os.path.islink(tmp_json):
+            return
+        with open(tmp_json, 'wb') as tf:
+            tf.write(payload)
+            tf.flush()
+            os.fsync(tf.fileno())
+        os.replace(tmp_json, seed_json)
+    except (OSError, ValueError):
+        try:
+            tmp_json = os.path.join(seed_dir, f'.seed.json.{os.getpid()}.tmp')
+            if os.path.lexists(tmp_json) and not os.path.islink(tmp_json):
+                os.unlink(tmp_json)
+        except OSError:
+            pass
