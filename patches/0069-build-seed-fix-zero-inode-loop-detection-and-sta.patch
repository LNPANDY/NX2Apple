+                    print(json.dumps(res, indent=2))
+                else:
+                    print(
+                        f"{res['status']}: {res['completed_games']} completed, {res['failed_games']} failed, "
+                        f"saved {res['saved_bytes']} bytes in {res['elapsed_sec']}s"
+                    )
+            if res['status'] == 'partial' and res['completed_games'] == 0 and res['failed_games'] > 0:
+                return 1
+            return 0
+    except (OSError, ValueError, TypeError, RuntimeError) as exc:
+        if getattr(args, 'progress', None) == 'json':
+            print(json.dumps({'event': 'error', 'error': str(exc)}, ensure_ascii=False), flush=True)
+            return 1
         if getattr(args, 'json', False):
             print(json.dumps({'valid': False, 'ok': False, 'error': str(exc)}, indent=2))
             return 1
