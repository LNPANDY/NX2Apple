+def _stream_pack_shader_lib_to_zst(files_spec, zst_tmp_path, level=3):
+    """Streams a DMROMFS1 shader library directly into zstd without writing an uncompressed .img to disk."""
+    names = sorted(n.encode('utf-8') for n in files_spec)
+    ents = []
+    items = []
+    off = romfs.HEAD.size
+    for name_b in names:
+        name_s = name_b.decode('utf-8')
+        src_spec, expected_size = files_spec[name_s]
+        pad = -off % shader_lib.ALIGN
+        off += pad
+        ents.append((name_b, off, expected_size))
+        items.append((name_s, pad, src_spec, expected_size))
+        off += expected_size
+
+    pool = bytearray()
+    idx = bytearray(romfs.ENT.pack(1, len(names), 0, 0, 0, 0))
+    for name_b, a, b in ents:
+        idx += romfs.ENT.pack(a, b, len(pool), len(name_b), 1, 0)
+        pool += name_b
+
+    head_bytes = romfs.HEAD.pack(romfs.MAGIC, off, len(idx) + len(pool), len(names) + 1)
+    total_raw_size = off + len(idx) + len(pool)
+    img_paths = sorted({src._image.path for _, _, src, _ in items if isinstance(src, romfs._Entry)})
+
+    def _iter_chunks():
+        with romfs.reuse_descriptors(img_paths) if img_paths else contextlib.nullcontext():
+            yield head_bytes
+            for name_s, pad, src_spec, expected_size in items:
+                if pad:
+                    yield b'\0' * pad
+                if isinstance(src_spec, bytes):
+                    if len(src_spec) != expected_size:
+                        raise ValueError(f'size mismatch for {name_s}: expected {expected_size}, got {len(src_spec)}')
+                    if src_spec:
+                        yield src_spec
+                    continue
+                if isinstance(src_spec, romfs._Entry):
+                    fin = io.BufferedReader(romfs._File(src_spec._image, src_spec._k), _ZSTD_CHUNK)
+                else:
+                    fin, fst = _open_regular_nofollow(src_spec)
+                    if fst.st_size != expected_size:
+                        fin.close()
+                        raise ValueError(
+                            f'file changed while archiving {name_s}: expected {expected_size}, got {fst.st_size}'
+                        )
+                read_n = 0
+                with fin:
+                    while True:
+                        chunk = fin.read(_ZSTD_CHUNK)
+                        if not chunk:
+                            break
+                        read_n += len(chunk)
+                        if read_n > expected_size:
+                            raise ValueError(f'file grew while archiving {name_s}: expected {expected_size}')
+                        yield chunk
+                if read_n != expected_size:
+                    raise ValueError(
+                        f'file truncated while archiving {name_s}: expected {expected_size}, got {read_n}'
+                    )
+            yield bytes(idx)
+            if pool:
+                yield bytes(pool)
+
+    _zstd_compress_chunks(_iter_chunks(), zst_tmp_path, level=level)
+    return total_raw_size
+
