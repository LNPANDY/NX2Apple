+        'zstd_available': zstd_ok,
+        'total_games': len(games),
+        'total_files': total_files,
+        'uncompressed_bytes': total_uncomp,
+        'estimated_compressed_bytes': total_est_comp,
+        'estimated_saved_bytes': total_est_saved,
