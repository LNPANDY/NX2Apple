+</header>
+
+<!-- Main Playfield -->
+<main>
+  <!-- Top Bumpers & Shoulder Row -->
+  <div class="top-row">
+    <!-- Left Shoulder: ZL & L -->
+    <div class="shoulder-cluster">
+      <div class="gamepad-btn btn-zl" data-key="ZL">
+        <span class="trigger-sub">Trigger</span>
+        <span class="trigger-main">ZL</span>
+      </div>
+      <div class="gamepad-btn btn-l" data-key="L">L</div>
+    </div>
+
+    <!-- Center System Buttons: Minus, Capture, Home, Plus -->
+    <div class="center-cluster">
+      <div class="system-bar">
+        <div class="gamepad-btn btn-sys" data-key="MINUS" title="Minus (-)">
+          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="M20 12H4" stroke-linecap="round"/></svg>
+        </div>
+        <div class="gamepad-btn btn-sys-sq" data-key="CAPTURE" title="Capture">
+          <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="7"/></svg>
+        </div>
+        <div class="gamepad-btn btn-sys-home" data-key="HOME" title="Home">
+          <svg width="15" height="15" fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/></svg>
+        </div>
+        <div class="gamepad-btn btn-sys" data-key="PLUS" title="Plus (+)">
+          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-linecap="round"/></svg>
+        </div>
+      </div>
+    </div>
+
+    <!-- Right Shoulder: R & ZR -->
+    <div class="shoulder-cluster">
+      <div class="gamepad-btn btn-r" data-key="R">R</div>
+      <div class="gamepad-btn btn-zr" data-key="ZR">
+        <span class="trigger-sub">Trigger</span>
+        <span class="trigger-main">ZR</span>
+      </div>
+    </div>
+  </div>
+
+  <!-- Thumb Zones (Left Joystick | Right ABXY) -->
+  <div class="thumb-zones">
+    <!-- Left Thumb: Analog Joystick -->
+    <div class="joystick-container">
+      <div class="joystick-base" id="joystick-base">
+        <div class="stick-guide-v"><span>▲</span><span>▼</span></div>
+        <div class="stick-guide-h"><span>◀</span><span>▶</span></div>
+        <div class="joystick-thumb" id="joystick-thumb">
+          <div class="thumb-cup">
+            <div class="thumb-center-dot"></div>
+          </div>
+        </div>
+      </div>
+      <div class="stick-label">Left Stick (L3 Press)</div>
+    </div>
+
+    <!-- Right Thumb: Large ABXY Diamond Pad -->
+    <div class="abxy-container">
+      <div class="abxy-plate" id="abxy-plate">
+        <div class="cross-bar-h"></div>
+        <div class="cross-bar-v"></div>
+
+        <!-- X (Top) -->
+        <div class="gamepad-btn abxy-btn btn-pos-x" data-key="X">
+          <span class="btn-char">X</span>
+          <span class="color-pip"></span>
+        </div>
+        <!-- Y (Left) -->
+        <div class="gamepad-btn abxy-btn btn-pos-y" data-key="Y">
+          <span class="btn-char">Y</span>
+          <span class="color-pip"></span>
+        </div>
+        <!-- A (Right) -->
+        <div class="gamepad-btn abxy-btn btn-pos-a" data-key="A">
+          <span class="btn-char">A</span>
+          <span class="color-pip"></span>
+        </div>
+        <!-- B (Bottom) -->
+        <div class="gamepad-btn abxy-btn btn-pos-b" data-key="B">
+          <span class="btn-char">B</span>
+          <span class="color-pip"></span>
+        </div>
+      </div>
+      <div class="stick-label">Nintendo Diamond Pad</div>
+    </div>
+  </div>
+</main>
+
+<!-- PIN Pairing Modal -->
+<div id="pin-modal">
+  <div class="pin-dialog">
+    <div class="pin-title">Enter Host PIN</div>
+    <div class="pin-desc">Enter the 4-digit PIN shown on the game screen to pair this controller.</div>
+    <input class="pin-box" id="pin-input" type="tel" maxlength="4" placeholder="••••" autocomplete="off" />
+    <button class="pin-btn" id="pin-submit">Connect Gamepad</button>
+  </div>
+</div>
+
+<div id="rotate-hint">Turn your phone sideways 🔄</div>
+
+<script>
+// Button Bits matching Switch nn::hid::NpadButton / dm_input.h
+const BITS = {
+  A: 1, B: 2, X: 4, Y: 8, LS: 16, RS: 32,
+  L: 64, R: 128, ZL: 256, ZR: 512,
+  PLUS: 1024, MINUS: 2048,
+  HOME: 0, CAPTURE: 0
+};
+
+// Keyboard mappings for desktop preview
+const KEY_MAP = {
+  KeyX: 1, Enter: 1,
+  KeyZ: 2, Backspace: 2,
+  KeyC: 4,
+  KeyV: 8,
+  KeyQ: 64,
+  KeyE: 128,
+  Digit1: 256,
+  Digit3: 512,
+  Equal: 1024,
+  Minus: 2048
+};
+const STICK_KEYS = ['KeyW', 'KeyA', 'KeyS', 'KeyD'];
+
+let hapticsEnabled = true;
+function triggerHaptic(ms = 18) {
+  if (hapticsEnabled && navigator.vibrate) {
+    try { navigator.vibrate(ms); } catch (e) {}
+  }
+}
+
+document.getElementById('haptic-toggle').addEventListener('click', () => {
+  hapticsEnabled = !hapticsEnabled;
+  triggerHaptic(30);
+  document.getElementById('haptic-icon').style.color = hapticsEnabled ? '#22C55E' : '#64748b';
+});
+
+// Touch and Button State
+const activeTouches = new Map(); // touchId -> bitmask
+const activeKeys = new Set();
+let lx = 0, ly = 0;
+let buttonMask = 0;
+let sentState = '';
+let lastAck = 0;
+let playerNum = null;
+let ws = null;
+let pingStart = 0;
+// Only read PIN from query param; never force stale incorrect PINs from localStorage
+let currentPin = new URLSearchParams(location.search).get('pin') || '';
+
+const statusDot = document.getElementById('status-dot');
+const statusWave = document.getElementById('status-wave');
+const statusText = document.getElementById('status-text');
+const playerSlot = document.getElementById('player-slot');
+const pinModal = document.getElementById('pin-modal');
+const pinInput = document.getElementById('pin-input');
+const pinSubmit = document.getElementById('pin-submit');
+
+function setStatusState(color, label, slotStr) {
+  statusDot.style.backgroundColor = color;
+  statusWave.style.backgroundColor = color;
+  if (label) statusText.textContent = label;
+  if (slotStr) playerSlot.textContent = slotStr;
+}
+
+function refreshButtonsUI() {
+  const prevMask = buttonMask;
+  buttonMask = 0;
+  for (const b of activeTouches.values()) buttonMask |= b;
+  for (const k of activeKeys) buttonMask |= (KEY_MAP[k] || 0);
+
+  if ((buttonMask & ~prevMask)) triggerHaptic(15);
+
+  document.querySelectorAll('.gamepad-btn').forEach(btn => {
+    const key = btn.getAttribute('data-key');
+    const bit = BITS[key] || 0;
+    if (bit) {
+      btn.classList.toggle('pressed', !!(buttonMask & bit));
+    }
+  });
+
+  sendState(false);
+}
+
+function sendState(force) {
+  const msg = buttonMask + ',' + lx.toFixed(3) + ',' + ly.toFixed(3);
+  if ((force || msg !== sentState) && ws && ws.readyState === WebSocket.OPEN) {
+    ws.send(msg);
+    sentState = msg;
+  }
+}
+
+// Multitouch handling for all buttons
+function bitAtPoint(x, y) {
+  const el = document.elementFromPoint(x, y);
+  const btn = el && el.closest('.gamepad-btn');
+  if (!btn) return 0;
+  const key = btn.getAttribute('data-key');
+  return BITS[key] || 0;
+}
+
+// Analog Stick Touch Logic
+const stickBase = document.getElementById('joystick-base');
+const stickThumb = document.getElementById('joystick-thumb');
+let stickTouchId = null;
+let baseRect = null;
+
+function updateStick(clientX, clientY) {
+  if (!baseRect) baseRect = stickBase.getBoundingClientRect();
+  const maxR = baseRect.width * 0.38; // Slightly larger throw ratio for easier reaching of 100% deflection
+  const cx = baseRect.left + baseRect.width / 2;
+  const cy = baseRect.top + baseRect.height / 2;
+  let dx = clientX - cx;
+  let dy = clientY - cy;
+  const dist = Math.hypot(dx, dy);
+  if (dist > maxR) {
+    dx = (dx / dist) * maxR;
+    dy = (dy / dist) * maxR;
+  }
+  stickThumb.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
+
+  // Normalized direct coordinates [-1.0, 1.0]
+  let normX = dx / maxR;
+  let normY = -dy / maxR; // Switch Y is inverted (up is positive)
+
+  // Subtle deadzone
+  const mag = Math.hypot(normX, normY);
+  if (mag < 0.05) {
+    lx = 0;
+    ly = 0;
+  } else {
+    // Linear & responsive: no sticky snapping or locking onto down/up!
+    // A clean circular mapping with gentle axial damping only when clearly horizontal/vertical.
+    lx = Math.max(-1.0, Math.min(1.0, normX));
+    ly = Math.max(-1.0, Math.min(1.0, normY));
+  }
+
+  sendState(false);
+}
+
+function resetStick() {
+  stickThumb.style.transform = 'translate3d(0, 0, 0)';
+  lx = 0; ly = 0;
+  sendState(false);
+}
+
+// Global Touch Listeners
+window.addEventListener('touchstart', (e) => {
+  if (e.target.closest('#pin-modal')) return;
+  e.preventDefault();
+  for (let i = 0; i < e.changedTouches.length; i++) {
+    const t = e.changedTouches[i];
+    if (!baseRect) baseRect = stickBase.getBoundingClientRect();
+    const cx = baseRect.left + baseRect.width / 2;
+    const cy = baseRect.top + baseRect.height / 2;
+
+    // Check if touch is inside analog stick base
+    if (stickTouchId === null && Math.hypot(t.clientX - cx, t.clientY - cy) < baseRect.width * 0.58) {
+      stickTouchId = t.identifier;
+      triggerHaptic(10);
+      updateStick(t.clientX, t.clientY);
+    } else {
+      const bit = bitAtPoint(t.clientX, t.clientY);
+      if (bit) activeTouches.set(t.identifier, bit);
+    }
+  }
+  refreshButtonsUI();
+}, { passive: false });
+
+window.addEventListener('touchmove', (e) => {
+  if (e.target.closest('#pin-modal')) return;
+  e.preventDefault();
+  for (let i = 0; i < e.changedTouches.length; i++) {
+    const t = e.changedTouches[i];
+    if (t.identifier === stickTouchId) {
+      updateStick(t.clientX, t.clientY);
+    } else if (activeTouches.has(t.identifier)) {
+      activeTouches.set(t.identifier, bitAtPoint(t.clientX, t.clientY));
+    }
+  }
+  refreshButtonsUI();
+}, { passive: false });
+
+window.addEventListener('touchend', (e) => {
+  for (let i = 0; i < e.changedTouches.length; i++) {
+    const t = e.changedTouches[i];
+    if (t.identifier === stickTouchId) {
+      stickTouchId = null;
+      resetStick();
+    }
+    activeTouches.delete(t.identifier);
+  }
+  refreshButtonsUI();
+}, { passive: false });
+
+window.addEventListener('touchcancel', (e) => {
+  for (let i = 0; i < e.changedTouches.length; i++) {
+    const t = e.changedTouches[i];
+    if (t.identifier === stickTouchId) {
+      stickTouchId = null;
+      resetStick();
+    }
+    activeTouches.delete(t.identifier);
+  }
+  refreshButtonsUI();
+}, { passive: false });
+
+// Mouse fallback for desktop testing
+let isMouseDown = false;
+stickBase.addEventListener('mousedown', (e) => {
+  isMouseDown = true;
+  baseRect = stickBase.getBoundingClientRect();
+  updateStick(e.clientX, e.clientY);
+});
+window.addEventListener('mousemove', (e) => {
+  if (isMouseDown) updateStick(e.clientX, e.clientY);
+});
+window.addEventListener('mouseup', () => {
+  if (isMouseDown) {
+    isMouseDown = false;
+    resetStick();
+  }
+});
+
+// Desktop Keyboard mapping
+window.addEventListener('keydown', (e) => {
+  if (e.target === pinInput) return;
+  if (!(e.code in KEY_MAP) && !STICK_KEYS.includes(e.code)) return;
+  e.preventDefault();
+  activeKeys.add(e.code);
+  if (stickTouchId === null) {
+    lx = (activeKeys.has('KeyD') ? 1 : 0) - (activeKeys.has('KeyA') ? 1 : 0);
+    ly = (activeKeys.has('KeyW') ? 1 : 0) - (activeKeys.has('KeyS') ? 1 : 0);
+  }
+  refreshButtonsUI();
+});
+
+window.addEventListener('keyup', (e) => {
+  if (e.target === pinInput) return;
+  if (e.code in KEY_MAP || STICK_KEYS.includes(e.code)) {
+    e.preventDefault();
+    activeKeys.delete(e.code);
+    if (stickTouchId === null) {
+      lx = (activeKeys.has('KeyD') ? 1 : 0) - (activeKeys.has('KeyA') ? 1 : 0);
+      ly = (activeKeys.has('KeyW') ? 1 : 0) - (activeKeys.has('KeyS') ? 1 : 0);
+    }
+    refreshButtonsUI();
+  }
+});
+
+// PIN Dialog
+function showPinDialog() {
+  pinModal.classList.add('show');
+  pinInput.value = ''; // Always clear previous input so user can type freely without overwrite
+  pinInput.focus();
+}
+
+pinSubmit.addEventListener('click', () => {
+  currentPin = pinInput.value.trim();
+  pinModal.classList.remove('show');
+  if (ws && ws.readyState === WebSocket.OPEN) {
+    ws.send('PIN:' + currentPin);
+  } else {
+    connectWS();
+  }
+});
+
+pinInput.addEventListener('keydown', (e) => {
+  if (e.key === 'Enter') pinSubmit.click();
+});
+
+// WebSocket Connection
+function connectWS() {
+  setStatusState('#eab308', 'Connecting…', 'P-');
+  const wsUrl = 'ws://' + location.host + '/ws?pin=' + encodeURIComponent(currentPin);
+  ws = new WebSocket(wsUrl);
+
+  ws.onopen = () => {
+    setStatusState('#38bdf8', 'Authenticating…', 'P-');
+    if (currentPin) ws.send('PIN:' + currentPin);
+    sendState(true);
+  };
+
+  ws.onmessage = (m) => {
+    lastAck = Date.now();
+    const data = m.data;
+    if (data === 'AUTH_REQUIRED' || data === 'AUTH_FAILED') {
+      setStatusState('#ef4444', 'PIN Required', 'P-');
+      showPinDialog();
+      return;
+    }
+    if (data.startsWith('player ')) {
+      pinModal.classList.remove('show');
+      playerNum = parseInt(data.split(' ')[1], 10);
+      setStatusState('#22c55e', 'Connected', 'P' + playerNum);
+    }
+  };
+
+  ws.onclose = () => {
+    playerNum = null;
+    setStatusState('#ef4444', 'Disconnected', 'P-');
+    setTimeout(connectWS, 1500);
+  };
+}
+
+// 50ms keep-alive tick
+setInterval(() => {
+  sendState(true);
+}, 50);
+
+window.addEventListener('resize', () => {
+  baseRect = null;
+});
+
+connectWS();
+</script>
+</body>
+</html>
