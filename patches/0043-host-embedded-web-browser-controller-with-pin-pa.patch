+  </div>
+
+  <div class="util-group">
+    <button class="util-btn" id="haptic-toggle" title="Haptics">
+      <svg id="haptic-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
