+    else if (!strcmp(k, "shader_key_skip")) {   // <offset>+<length>; empty or 0+0 = none
+        char *e; uint64_t o = strtoull(v, &e, 0);
+        if (e != v && *e == '+') { uint64_t l = strtoull(e + 1, NULL, 0); P.shader_skip_off = (uint32_t)o; P.shader_skip_len = (uint32_t)l; }
+        else P.shader_skip_off = P.shader_skip_len = 0;
+    }
+    else if (!strcmp(k, "tex_bc_cpu")) P.tex_bc_cpu = truthy(v);
+    else if (!strcmp(k, "ue_texture_pool")) P.ue_texture_pool = (int)num(v, (uint64_t)P.ue_texture_pool);
+    else if (!strcmp(k, "enc_thread")) P.enc_thread = truthy(v);
+    else if (!strcmp(k, "draw_barriers")) P.draw_barriers_game = !strcmp(v, "game") || !strcmp(v, "1");
+    else if (!strcmp(k, "game_args")) copy_str(P.args, sizeof P.args, v);
+    else if (!strcmp(k, "game_env")) copy_str(P.genv, sizeof P.genv, v);
+    // any other key (ipa, zip_store, shader_*, build, package, ...) is not a host constant: ignored
+}
+
+// The file: KEY<TAB>VALUE (game.tsv's form) or KEY VALUE, # starts a comment; blank lines are skipped.
+static void read_file(const char *path) {
+    FILE *f = fopen(path, "r");
+    if (!f) { LOG("[RED] DM_PROFILE %s cannot be read; keeping the compiled profile", path); return; }
+    char line[4096];
+    int rows = 0;
+    while (fgets(line, sizeof line, f)) {
+        char *s = line; while (*s == ' ' || *s == '\t') s++;
+        size_t L = strlen(s); while (L && (s[L-1] == '\n' || s[L-1] == '\r')) s[--L] = 0;
+        if (!*s || *s == '#') continue;
+        char *sep = strpbrk(s, "\t ");
+        if (!sep) continue;
+        *sep = 0;
+        char *v = sep + 1; while (*v == '\t' || *v == ' ') v++;
+        if (!strcmp(s, "build")) {   // build<TAB>version<TAB>display<TAB>main=<build id>...: one display-version row
+            char *p = v, *cols[4] = {0}; int nc = 0;
+            for (char *t = strtok(p, "\t"); t && nc < 4; t = strtok(NULL, "\t")) cols[nc++] = t;
+            if (nc >= 2) { char buf[256]; snprintf(buf, sizeof buf, "%s\t%s", cols[0], cols[1]); set_kv("display_version", buf); }
+            continue;
+        }
+        set_kv(s, v); rows++;
+    }
+    fclose(f);
+    LOG("game profile %s: %d rows", path, rows);
+}
+
+// Environment: DM_PROF_<KEY> with the game.tsv key upper-cased (DM_PROF_MEM_RESERVE=0x140000000).
+static void read_env(void) {
+    static const char *keys[] = {"TITLE_ID","NAME","ROMFS_MARKER","PROGRAM_ID","MODULES","MEM_RESERVE","MEM_ALIAS","MEM_STACK","APP_POOL",
+        "MEM_USED","SYS_RESOURCE","MEM_MAP_LIMIT","PRESENT_INTERVAL","CORE_PREEMPT","ALLOC_BIG_ALIGN","FPS_TARGET","FPS_HOLD","PRESENT_SNAP",
+        "PSO_MTL4","SHARED_FONT","PAD_LAYOUT","OP_MODE","PERF_MODE","FEEDBACK_SNAP","TEX_FLUSH_UPLOAD","TEX_DIRTY_UPLOAD",
+        "TEX_DYN_SLOTS","GPU_TIMESTAMPS","VCONV_RANGE","DEVICE_API","STDALLOC_CAP","SHADER_KEY_SKIP","TEX_BC_CPU","UE_TEXTURE_POOL","ENC_THREAD","DRAW_BARRIERS","GAME_ARGS","GAME_ENV", NULL};
+    char k[64], name[96];
+    for (int i = 0; keys[i]; i++) {
+        snprintf(k, sizeof k, "%s", keys[i]);
+        for (char *p = k; *p; p++) *p = (char)tolower((unsigned char)*p);
+        snprintf(name, sizeof name, "DM_PROF_%s", keys[i]);
+        const char *v = getenv(name);
+        if (v) set_kv(k, v);
+    }
+}
+
+static void load(void) {
+    defaults();
+    const char *path = getenv("DM_PROFILE");
+    if (path && *path) { copy_str(P.source, sizeof P.source, path); read_file(path); }
+    read_env();   // DM_PROF_* overrides apply on top of the file or of the compiled profile
+    if (P.nmod <= 0) {   // a profile file that names no modules: the compiled list, which is the one the executable embeds
+        const char *m[] = DM_GAME_MODULES; int n = DM_GAME_NMOD; if (n > DM_PROF_MAX_MOD) n = DM_PROF_MAX_MOD;
+        for (int i = 0; i < n; i++) { copy_str(P.modbuf[i], sizeof P.modbuf[i], m[i]); P.modules[i] = P.modbuf[i]; } P.nmod = n;
+    }
+    g_loaded = 1;
+}
+
+const struct dm_profile *dm_profile(void) {
+    if (!g_loaded) load();
+    return &P;
+}
+
+void dm_profile_log(void) {
+    const struct dm_profile *p = dm_profile();
+    LOG("game profile: %s (%s) from %s", p->id, p->name, p->source);
+    LOG("  modules %d%s%s%s  program %016llx  reserve %#llx alias %#llx stack %#llx pool %#llx used %#llx sysres %#llx map_limit %d",
+        p->nmod, p->nmod > 0 ? ":" : "", p->nmod > 0 ? p->modules[0] : "", p->nmod > 1 ? " ..." : "",
+        (unsigned long long)p->program_id, (unsigned long long)p->mem_reserve, (unsigned long long)p->mem_alias,
+        (unsigned long long)p->mem_stack, (unsigned long long)p->app_pool, (unsigned long long)p->mem_used,
+        (unsigned long long)p->sys_resource, p->mem_map_limit);
+    LOG("  switches present_display %d core_preempt %d big_align %d fps %d hold %d snap %d pso4 %d font_ttf %d pad %d opmode %d boost %d",
+        p->present_display, p->core_preempt, p->alloc_big_align, p->fps_target, p->fps_hold, p->present_snap, p->pso_mtl4,
+        p->shared_font_ttf, p->pad_layout, p->opmode, p->perf_boost);
+    LOG("  graphics flush %d dirty %d dynslots %d gputs %d vconv %d nvn_api %d.%d  versions %d",
+        p->tex_flush_upload, p->tex_dirty_upload, p->tex_dyn_slots, p->gpu_ts_segment, p->vconv_range,
+        p->nvn_api_major, p->nvn_api_minor, p->nver);
+    LOG("  more stdalloc_cap %#llx key_skip %#x+%#x bc_cpu %d ue_pool %d enc_thread %d draw_barriers_game %d",
+        (unsigned long long)p->stdalloc_cap, p->shader_skip_off, p->shader_skip_len, p->tex_bc_cpu, p->ue_texture_pool, p->enc_thread, p->draw_barriers_game);
+}
diff --git a/dm/host/hle_profile.h b/dm/host/hle_profile.h
new file mode 100644
index 00000000..e73d4164
--- /dev/null
+++ b/dm/host/hle_profile.h
@@ -0,0 +1,48 @@
+// Runtime game profile: every constant the host used to take from game_profile.h at compile time, read once at start.
+// Loading order: the compiled profile (game_profile.h, the macros) → the file DM_PROFILE names (the key/value form of a
+// game profile, dm/games/game.py profile <id> <out.tsv>) → DM_PROF_<KEY> environment variables.
+// The per-knob switches the host already reads (DM_FPS_TARGET, DM_OPMODE, DM_PRESENT_INTERVAL, DM_NVN_API, ...) still win over
+// all of these: each site reads them after the profile.
+// A key a profile file leaves out keeps the compiled value, so dm/games/game.py profile writes every key (also the "decide by the SDK" ones).
+// A build with no DM_PROFILE set behaves exactly as the compile-time profile did.
+#pragma once
+#include <stdint.h>
+
+#define DM_PROF_MAX_MOD 8
+#define DM_PROF_MAX_VER 64
+#define DM_PROF_STR 128
+
+struct dm_profile {
+    char id[24];                 // base game title ID, hex text
+    char name[128];
+    char romfs_marker[256];
+    uint64_t program_id;
+    char modbuf[DM_PROF_MAX_MOD][16];
+    const char *modules[DM_PROF_MAX_MOD];   // point into modbuf
+    int nmod;
+    uint64_t mem_reserve, mem_alias, mem_stack, app_pool, mem_used, sys_resource;
+    int mem_map_limit;
+    struct { char build[40], ver[40]; } ver[DM_PROF_MAX_VER];   // display version by main build ID
+    int nver;
+    int present_display, core_preempt, alloc_big_align, fps_target, fps_hold, present_snap, pso_mtl4;
+    int shared_font_ttf;         // -1 = decide by the SDK version (hle_sdk16.c font_skip)
+    int pad_layout, opmode, perf_boost;
+    char feedback_snap[DM_PROF_STR];
+    int tex_flush_upload, tex_dirty_upload, tex_dyn_slots, gpu_ts_segment, vconv_range;
+    int nvn_api_major, nvn_api_minor;   // major 0 = decide by the SDK version (hle_nvn.c nvn_api)
+    uint64_t stdalloc_cap;       // StandardAllocator's address space (hle_svc.c); 0 = what the alias region has room for
+    uint32_t shader_skip_off, shader_skip_len;   // shader_key_skip <offset>+<length>: control bytes the shader keys hash as zeros (len 0 = none)
+    int tex_bc_cpu, ue_texture_pool, enc_thread, draw_barriers_game;   // ue_texture_pool in MB (0 = the game's own pool)
+    char args[512], genv[1024];  // game_args / game_env
+    char source[512];            // DM_PROFILE, or "compiled defaults"
+};
+
+const struct dm_profile *dm_profile(void);   // loaded once; never NULL
+void dm_profile_log(void);
+// The same pointer, cached per translation unit: for the hot paths (per draw, per texture) that cannot afford the function call.
+// dm_profile() is first called from main() before any thread starts, so the cache never sees a half-loaded profile.
+static inline const struct dm_profile *dm_prof(void) {
+    static const struct dm_profile *p;
+    if (__builtin_expect(!p, 0)) p = dm_profile();
+    return p;
+}                   // one line per differing value (called after loading)
