From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiaoge-tou <85100527+Tiaoge-tou@users.noreply.github.com>
Date: Wed, 4 Nov 2026 11:10:09 +0800
Subject: [PATCH] The way back to the library is a gesture, not a button: a
 three-finger long press (0.6 s) raises the same confirmation, so the game
 screen carries no extra chrome

Upstream-Status: fork-only
Reason: The library button from 0083 put permanent chrome on the game screen. The way back is a three-finger long press instead: no gameplay input makes it by accident, it works with a controller connected, and the confirmation from 0083 still guards the exit.
Issue: Tiaoge-tou/NX2Apple PROJECT.md Phase 4

---
 dm/ios/Sources/front_ios.m | 22 +++++++---------------
 1 file changed, 7 insertions(+), 15 deletions(-)

diff --git a/dm/ios/Sources/front_ios.m b/dm/ios/Sources/front_ios.m
index 852cfc7..ad02f10 100644
--- a/dm/ios/Sources/front_ios.m
+++ b/dm/ios/Sources/front_ios.m
@@ -64,7 +64,6 @@ static void tv_attach(void);
 @property (nonatomic, strong) DmGameView *game;
 @property (nonatomic, strong) UIView *pad;
 @property (nonatomic, strong) UILabel *fps;
-@property (nonatomic, strong) UIButton *library;   // the shell's way back to its game library (DM_SHELL): shown only when a shell launched the game
 @property (nonatomic) BOOL launched;
 @property (nonatomic, strong) id tv;   // the TV scene accessory's registration (iOS 27)
 @property (nonatomic) BOOL hasLauncher;   // the app has a settings screen: a failed Play goes back to it (its Game data section is the way out)
@@ -209,15 +208,10 @@ static void front_ios_hud_script_fix(int width) {
     [self.view addSubview:self.pad];
     self.fps = front_ios_fps_label();   // above the pad, which hides while a controller is connected
     if (self.fps) [self.view addSubview:self.fps];
-    if (getenv("DM_SHELL") && atoi(getenv("DM_SHELL"))) {   // a shell launched this game (its launch plan sets DM_SHELL): the process is the game and there is no library under it, so the way back is a button that closes the app onto its library. It stays up while a controller is connected, when the pad is hidden and it is the only way out
-        UIButton *b = [UIButton buttonWithType:UIButtonTypeSystem];
-        b.backgroundColor = [UIColor colorWithWhite:0 alpha:0.35];
-        b.tintColor = [UIColor colorWithWhite:1 alpha:0.85];
-        b.layer.cornerRadius = 18;
-        [b setImage:[UIImage systemImageNamed:@"square.grid.2x2"] forState:UIControlStateNormal];
-        b.accessibilityLabel = @"Game library";
-        [b addTarget:self action:@selector(dm_back_to_library) forControlEvents:UIControlEventTouchUpInside];
-        self.library = b; [self.view addSubview:b];
+    if (getenv("DM_SHELL") && atoi(getenv("DM_SHELL"))) {   // a shell launched this game (its launch plan sets DM_SHELL): the process is the game and there is no library under it, so the way back is a gesture that closes the app onto its library: a three-finger long press leaves the screen clean and no gameplay input makes it by accident (the stick thumb moves, the buttons are taps, and the alert it raises can still be cancelled); it also works while a controller is connected, when the pad is hidden
+        UILongPressGestureRecognizer *press = [[UILongPressGestureRecognizer alloc] initWithTarget:self action:@selector(dm_back_to_library:)];
+        press.numberOfTouchesRequired = 3; press.minimumPressDuration = 0.6; press.cancelsTouchesInView = NO;
+        [self.view addGestureRecognizer:press];
     }
     [self.view setNeedsLayout]; [self.view layoutIfNeeded];
     UIApplication.sharedApplication.idleTimerDisabled = YES;
@@ -247,12 +241,10 @@ static void front_ios_hud_script_fix(int width) {
         CGRect s = UIEdgeInsetsInsetRect(b, self.view.safeAreaInsets); CGFloat u = MIN(b.size.height / 430.0, 1.3);
         self.fps.frame = CGRectMake(floor(CGRectGetMinX(s) + 130 * u), floor(CGRectGetMinY(s) + 22 * u - 11), 64, 22);
     }
-    if (self.library) {   // the top row's right end, level with the fps label
-        CGRect s = UIEdgeInsetsInsetRect(b, self.view.safeAreaInsets); CGFloat u = MIN(b.size.height / 430.0, 1.3);
-        self.library.frame = CGRectMake(floor(CGRectGetMaxX(s) - 22 * u - 36), floor(CGRectGetMinY(s) + 22 * u - 18), 36, 36);
-    }
 }
-- (void)dm_back_to_library {
+- (void)dm_back_to_library:(UILongPressGestureRecognizer *)press {
+    if (press.state != UIGestureRecognizerStateBegan) return;   // once per press, not for every change it reports
+    if (self.presentedViewController) return;   // an alert is already up (a boot message, or this one from a second press)
     UIAlertController *a = [UIAlertController alertControllerWithTitle:@"Game library" message:@"Close the game and go back to the game library? Unsaved progress is lost." preferredStyle:UIAlertControllerStyleAlert];
     [a addAction:[UIAlertAction actionWithTitle:@"Cancel" style:UIAlertActionStyleCancel handler:nil]];
     [a addAction:[UIAlertAction actionWithTitle:@"Close game" style:UIAlertActionStyleDestructive handler:^(UIAlertAction *action) { exit(0); }]];   // the shell opens on its library, so closing the app is the way back to it
