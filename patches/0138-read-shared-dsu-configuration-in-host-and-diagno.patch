+// The host reads the same per-user document as NXMotion, not launcher memory.
+static BOOL dsu_integer(id value, double low, double high) {
+    if(![value isKindOfClass:NSNumber.class] || CFGetTypeID((__bridge CFTypeRef)value)==CFBooleanGetTypeID())return NO;
+    double n=[value doubleValue];return isfinite(n) && n==floor(n) && n>=low && n<=high;
+}
+static BOOL dsu_boolean(id value) {
+    return [value isKindOfClass:NSNumber.class] && CFGetTypeID((__bridge CFTypeRef)value)==CFBooleanGetTypeID();
+}
+static BOOL dsu_apply_configuration(NSData *data) {
+    @autoreleasepool {
+        NSError *error=nil;id root=data.length<=65536 ? [NSJSONSerialization JSONObjectWithData:data options:0 error:&error] : nil;
+        if(![root isKindOfClass:NSDictionary.class] || !dsu_integer(root[@"version"],1,1) || ![root[@"devices"] isKindOfClass:NSArray.class]) { LOG("[RED] DSU: invalid shared JSON configuration");return NO; }
+        NSArray *devices=root[@"devices"];if(devices.count>32)return NO;
+        NSMutableDictionary *values=[NSMutableDictionary dictionary];
+        for(id d in devices) {
+            if(![d isKindOfClass:NSDictionary.class] || !dsu_boolean(d[@"enabled"]))return NO;
+            if(!dsu_integer(d[@"player"],1,8) || !dsu_integer(d[@"port"],1,65535) || !dsu_integer(d[@"slot"],0,3))return NO;
+            if(d[@"buttons"] && !dsu_boolean(d[@"buttons"]))return NO;
+            NSInteger player=[d[@"player"] integerValue];id host=d[@"host"],axes=d[@"axes"],bias=d[@"bias"];
+            if(player<1 || player>8 || ![host isKindOfClass:NSString.class] || ![axes isKindOfClass:NSArray.class] || [axes count]!=3 || ![bias isKindOfClass:NSArray.class] || [bias count]!=3)return NO;
+            long port=[d[@"port"] longValue],slot=[d[@"slot"] longValue];
+            if(port<1 || port>65535 || slot<0 || slot>3)return NO;
+            struct in_addr address;if(inet_pton(AF_INET,[host UTF8String],&address)!=1)return NO;
+            NSMutableSet *seen=[NSMutableSet set];
+            for(int i=0;i<3;i++){
+                if(!dsu_integer(axes[i],-3,3) || ![bias[i] isKindOfClass:NSNumber.class] || CFGetTypeID((__bridge CFTypeRef)bias[i])==CFBooleanGetTypeID())return NO;
+                double a=[axes[i] doubleValue],b=[bias[i] doubleValue];
+                if(a!=floor(a) || a==0 || a < -3 || a>3 || !isfinite(b) || fabs(b)>10000)return NO;
+                [seen addObject:@(fabs(a))];
+            }
+            if(seen.count!=3)return NO;
+            if(![d[@"enabled"] boolValue])continue;
+            NSString *key=[NSString stringWithFormat:@"DM_DSU_%ld",(long)player];if(values[key])return NO;
+            NSString *buttonKey=[NSString stringWithFormat:@"DM_DSU_BUTTONS_%ld",(long)player];
+            values[buttonKey]=[d[@"buttons"] boolValue] ? @"1":@"0";
+            values[key]=[NSString stringWithFormat:@"%@,%ld,%ld,%@,%@,%@,%@,%@,%@",host,(long)[d[@"port"] integerValue],(long)[d[@"slot"] integerValue],axes[0],axes[1],axes[2],bias[0],bias[1],bias[2]];
+        }
+        // JSON is authoritative for the reload action. Explicit environment-only
+        // configurations remain available when there is no shared document.
+        for(int player=1;player<=8;player++){
+            NSString *key=[NSString stringWithFormat:@"DM_DSU_%d",player];unsetenv(key.UTF8String);
+            key=[NSString stringWithFormat:@"DM_DSU_BUTTONS_%d",player];unsetenv(key.UTF8String);
+        }
+        for(NSString *key in values)setenv(key.UTF8String,[values[key] UTF8String],1);
+        LOG("DSU: host loaded shared per-user JSON (%lu enabled players)",(unsigned long)values.count/2);
+        return YES;
+    }
+}
+void dm_dsu_load_configuration(void) {
+    @autoreleasepool {
+        NSString *path=[NSHomeDirectory() stringByAppendingPathComponent:@"Library/Application Support/nxnative/motion/dsu-v1.json"];
+        NSDictionary *attributes=[[NSFileManager defaultManager] attributesOfItemAtPath:path error:nil];
+        if(!attributes)return; // No shared document: preserve explicit environment configuration.
+        if([attributes fileSize]>65536) { LOG("[RED] DSU: shared configuration exceeds size limit");return; }
+        NSData *data=[NSData dataWithContentsOfFile:path];
+        if(!data || !dsu_apply_configuration(data))LOG("[RED] DSU: invalid shared JSON configuration, previous configuration retained");
+    }
+}
