From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: v0lumehi <aljic.zijad@gmail.com>
Date: Mon, 9 Nov 2026 21:19:53 +0100
Subject: [PATCH] iOS: write the game's console into game.manifest.json

gen_manifest.py takes the game's profile (--profile, build_ipa.sh passes dm/games/<id>/game.tsv) and writes console as switch2 or
switch1 after the schema's keys. The rule is the one the Mac launcher already uses (GameFolder.profileIsSwitch2): a Switch 2 profile
names it in its first line, "# Name (Switch 2, update v...)". Without a profile the key is left out. The shell can then mark a
Switch 2 game and warn about its memory. The profile carries no minimum memory, so no min_memory is written.

Upstream-Status: fork-only (declined seedds/nxnative#492)
Reason: the iPhone shell has no way to know a game is a Switch 2 game, the manifest is the file it reads per game
Issue: LNPANDY/NX2Apple#696
---
 dm/ios/tests/test_framework_build.py | 17 ++++++++++++++++-
 dm/ios/tools/build_ipa.sh            |  2 +-
 dm/ios/tools/gen_manifest.py         | 20 +++++++++++++++++++-
 3 files changed, 36 insertions(+), 3 deletions(-)

diff --git a/dm/ios/tests/test_framework_build.py b/dm/ios/tests/test_framework_build.py
index cfba21ff..f1c89929 100644
--- a/dm/ios/tests/test_framework_build.py
+++ b/dm/ios/tests/test_framework_build.py
@@ -81,6 +81,21 @@ class ManifestTests(unittest.TestCase):
         self.assertEqual(data['romfs_identity'], 'DMROMFSID1 title=x size=1 index=2')
         self.assertEqual(data['min_os'], '26.0')
 
+    def test_the_console_comes_from_the_profiles_first_line(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            for first, expected in (('# Donkey Kong Bananza (Switch 2, update v458752)', 'switch2'), ('# Fixture Game (update v1)', 'switch1')):
+                profile = Path(temporary) / 'game.tsv'
+                profile.write_text(first + '\nname\tx\n')
+                result, data = self.manifest('--profile', str(profile))
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(data['console'], expected)
+                self.assertEqual(list(data)[-2:], ['min_os', 'console'], 'after the schema keys, which keep their order')
+
+    def test_without_a_profile_the_manifest_says_nothing_about_the_console(self):
+        result, data = self.manifest()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertNotIn('console', data)
+
     def test_a_romfs_folder_has_no_identity_and_no_nro_table_counts_zero(self):
         result, data = self.manifest('--romfs-identity', '', nro=False)
         self.assertEqual(result.returncode, 0, result.stderr)
@@ -139,7 +154,7 @@ class FrameworkEnvironmentTests(unittest.TestCase):
             (root / 'tools').symlink_to(REPO / 'dm/ios/tools', target_is_directory=True)
             result = run_step(block, root, FRAMEWORK='1', FRAMEWORK_ONLY='out', FW_NAME='DmGame' + GAME,
                               PATCHED=str(root / 'patched'), ROMFS=str(root / 'none'), PREPARE_XCODE='NO', DM_COPY_ROMFS='NO',
-                              DM_DISPLAY_NAME='Fixture', DM_APP_VERSION='1.0', MODS='main', V='fixture', MARKER='marker', F='')
+                              DM_DISPLAY_NAME='Fixture', DM_APP_VERSION='1.0', MODS='main', V='fixture', MARKER='marker', F='', GD=str(root / 'gd'))
             self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
             self.assertTrue((root / 'Gen/framework/dm/env.txt').is_file(), 'the built framework must carry its environment')
             self.assertEqual((root / 'Gen/framework/dm/env.txt').read_text(), 'DM_PROF_TEX_BC_CPU=1\n')
diff --git a/dm/ios/tools/build_ipa.sh b/dm/ios/tools/build_ipa.sh
index be74dd66..ef52be27 100755
--- a/dm/ios/tools/build_ipa.sh
+++ b/dm/ios/tools/build_ipa.sh
@@ -222,7 +222,7 @@ if [ "$FRAMEWORK" = 1 ]; then
   FW_LOADER=FR; [ -z "$FRAMEWORK_ONLY" ] || FW_LOADER=FH
   python3 tools/gen_manifest.py Gen/framework/game.manifest.json --game "$GAME" --name "$DM_DISPLAY_NAME" \
     --display-version "$DM_APP_VERSION" --package-version "${PKG:-}" --modules "$MODS" ${NRO_TABLE:+--nro-table "$NRO_TABLE"} \
