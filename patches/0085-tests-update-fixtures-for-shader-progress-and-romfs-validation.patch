From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: thehobbit85 <thehobbit85@gmail.com>
Date: Fri, 6 Nov 2026 18:29:02 -0800
Subject: [PATCH] tests: update fixtures for shader progress and RomFS
 validation

Exercise ShaderWatch through its JSON progress file, use the production shader output reader for pairing fixtures, and pack a synthetic RomFS image for the Xcode preparation tests. Preserve the assertions on padded interfaces and preparation options.

Upstream-Status: forwarded seedds/nxnative#1612
Reason: Keep the pinned engine test fixtures aligned with JSON shader progress, staged shader outputs and RomFS format validation
Issue: LNPANDY/NX2Apple#861
---
 dm/gfx/tests/test_dmsh_pairs.py     | 15 ++++++++++++---
 dm/ios/tests/test_xcode_workflow.py |  4 +++-
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/dm/gfx/tests/test_dmsh_pairs.py b/dm/gfx/tests/test_dmsh_pairs.py
index e19075c..ca3358a 100644
--- a/dm/gfx/tests/test_dmsh_pairs.py
+++ b/dm/gfx/tests/test_dmsh_pairs.py
@@ -15,14 +15,16 @@ import unittest
 
 TOOLS = Path(__file__).resolve().parents[1] / 'tools'
 sys.path.insert(0, str(TOOLS))
+sys.path.insert(0, str(TOOLS.parents[1] / 'tools'))
 import dmsh_chain
 import dmsh_pull
 import pso_offline
+import shader_cache
 
 
 def builder():
     # Use production functions without the CLI's translator/profile initialization.
-    names = {'load_pairs', 'partner_inputs', 'vs_pad', 'vs_depth', 'shader_key', 'pair_keyed'}
+    names = {'load_pairs', 'partner_inputs', 'vs_pad', 'vs_depth', 'shader_key', 'pair_keyed', 'output', 'label_dir'}
     tree = ast.parse((TOOLS / 'dmsh_build.py').read_text())
     ns = dict(collections=collections, os=os, re=re, sys=sys, hashlib=hashlib)
     exec(compile(ast.Module(body=[n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in names],
@@ -74,9 +76,10 @@ class Pairing(unittest.TestCase):
         self.extra = self.package.parent / 'pso_pairs.tsv'
         self.extra.write_text('# BAHS\nv\tf1\nv\tf6\nv\tf1\n\n')
         self.ns = builder()
-        # output(): a finished shader's file as dmsh_build.py reads it back (from the compile cache there; from the folder here)
+        self.store = shader_cache.Store(self.root / 'cas.db')
+        self.addCleanup(self.store.close)
         self.ns.update(out=str(self.root), PAIRS=self.ns['load_pairs'](self.g, self.package),
-                       output=lambda target, name: (self.root / name).read_bytes() if (self.root / name).is_file() else None)
+                       STORE=self.store, STAGE='stage/test', want=set())
         for key, loc in [('f0', 0), ('f1', 1), ('f6', 6)]:
             src = pixel(loc)
             if not loc: src = src.replace('    float4 missing [[user(locn0)]];\n', '').replace('in.v0 + in.missing', 'in.v0')
@@ -92,6 +95,12 @@ class Pairing(unittest.TestCase):
         self.assertEqual(src.count('float4 v0 [[user(locn0)]];'), 1)
         self.assertEqual(self.ns['vs_pad']('v', src), (src, []))
 
+    def test_padding_reads_staged_pixel_outputs(self):
+        for path in self.root.glob('*_b.metal'):
+            self.store.put(f'stage/test/mac/{path.name}', path.read_bytes())
+            path.unlink()
+        self.test_split_fallback_union_and_defaults()
+
     def test_profile_table_wins_and_optional_table(self):
         self.g.table('pso_pairs.tsv').write_text('v\tf6\n')
         self.assertEqual(self.ns['load_pairs'](self.g, self.package), {'v': {'f0', 'f6'}})
diff --git a/dm/ios/tests/test_xcode_workflow.py b/dm/ios/tests/test_xcode_workflow.py
index 1b3bb27..e7cfcef 100644
--- a/dm/ios/tests/test_xcode_workflow.py
+++ b/dm/ios/tests/test_xcode_workflow.py
@@ -19,6 +19,7 @@ import game
 import gen_resources
 import nacp
 import profile_guess
+import romfs_image
 import xcode_projects
 
 
@@ -53,6 +54,7 @@ class XcodePipelineTests(unittest.TestCase):
             extraction = root / 'extracted' / version
             (extraction / 'RomFS').mkdir(parents=True)
             (extraction / 'ExeFS').mkdir()
+            romfs_image.pack(extraction / 'RomFS', extraction / 'RomFS.img')
             def fake_run(cmd, log, **kwargs):
                 log.parent.mkdir(parents=True, exist_ok=True)
                 log.write_text('')  # a successful command with no diagnostic output
@@ -89,7 +91,7 @@ class XcodePipelineTests(unittest.TestCase):
                                      + (['--framework'] if framework else []))
             finally:
                 progress.close()
-            self.assertEqual(code, 0)
+            self.assertEqual(code, 0, output.getvalue())
             events = [json.loads(line) for line in output.getvalue().splitlines()]
             self.assertTrue(any(event.get('name') == 'prepare Xcode' for event in events))
             self.assertFalse(any(event.get('name') == 'app build' for event in events))
