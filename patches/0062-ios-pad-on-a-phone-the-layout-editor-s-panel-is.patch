--- a/dm/ios/Sources/DmPadEditing.h
+++ b/dm/ios/Sources/DmPadEditing.h
@@ -413,6 +413,49 @@ static inline BOOL dm_pad_pinch_check(const DmPadFingers *s, int *group, BOOL *r
 static inline void dm_pad_pinch_on(DmPadFingers *s) { s->pinch = YES; s->drag = 0; s->moving = NO; }
 static inline void dm_pad_pinch_off(DmPadFingers *s) { s->pinch = NO; }
 
+// ---- The compact bar (a phone: DmPadEditor.h) ----
+// How many rows the bar's controls take in a row width (points): 1 when the chosen group's name, its − size +, the two-way choice, Cancel and Done and
+// the button for the rest all fit side by side; 2 with the choice on a row of its own below; 3 with Cancel and Done on a third row (a phone held
+// upright). name, sizes (− size + with the gaps between them), choice, buttons (Cancel and Done together) and more are those parts' widths; gap the
+// space between two parts of the row, which also has a stretch of room before Cancel (DmPadEditor.m: name, sizes, room, choice, Cancel, Done, more).
+static inline CGFloat dm_pad_compact_width(int rows, CGFloat name, CGFloat sizes, CGFloat choice, CGFloat buttons, CGFloat more, CGFloat gap) {
+    if (rows == 1) return name + sizes + choice + buttons + more + 6 * gap;
+    if (rows == 2) return name + sizes + buttons + more + 5 * gap;
+    return name + sizes + more + 3 * gap;
+}
+static inline int dm_pad_compact_rows(CGFloat row, CGFloat name, CGFloat sizes, CGFloat choice, CGFloat buttons, CGFloat more, CGFloat gap) {
+    if (dm_pad_compact_width(1, name, sizes, choice, buttons, more, gap) <= row) return 1;
+    if (dm_pad_compact_width(2, name, sizes, choice, buttons, more, gap) <= row) return 2;
+    return 3;
+}
+static const CGFloat DM_PAD_DOCK_MARGIN = 4;   // the bar from the safe area's edge
+// The bar (size bar, centred across the safe area) at the top (edge 0) or the bottom (1) of the safe area.
+static inline CGRect dm_pad_dock_rect(CGRect safe, CGSize bar, int edge) {
+    CGFloat x = CGRectGetMidX(safe) - bar.width / 2;
+    return CGRectMake(x, edge ? CGRectGetMaxY(safe) - DM_PAD_DOCK_MARGIN - bar.height : CGRectGetMinY(safe) + DM_PAD_DOCK_MARGIN, bar.width, bar.height);
+}
+static inline CGFloat dm_pad_cover(CGRect a, CGRect b) { CGRect x = CGRectIntersection(a, b); return CGRectIsNull(x) ? 0 : x.size.width * x.size.height; }
+// The edge the bar docks to. now: its edge (-1: none yet). chosen: the chosen group's rectangle with the groups that move with it (CGRectNull: none),
+// fresh when it was chosen since the last call. With nothing docked yet, the edge where the bar covers the least of the groups (rects, n of them),
+// the top on a tie; a group newly chosen sends it to the edge away from it (the top for a group in the lower half); and where the chosen group is
+// under the bar, to the other edge if the group is less under it there. A bar taller than the safe area keeps to the top, its first rows (Cancel and
+// Done among them) in view.
+static inline int dm_pad_dock_edge(CGRect safe, CGSize bar, CGRect chosen, BOOL fresh, const CGRect *_Nullable rects, int n, int now) {
+    if (bar.height > safe.size.height - 2 * DM_PAD_DOCK_MARGIN) return 0;
+    int e = now;
+    if (e < 0) {
+        CGFloat c[2] = {0, 0};
+        for (int s = 0; s < 2; s++) { CGRect r = dm_pad_dock_rect(safe, bar, s); for (int i = 0; i < n; i++) c[s] += dm_pad_cover(r, rects[i]); }
+        e = c[1] < c[0] - 1 ? 1 : 0;
+    }
+    if (!CGRectIsNull(chosen)) {
+        if (fresh) e = CGRectGetMidY(chosen) > CGRectGetMidY(safe) ? 0 : 1;
+        CGFloat here = dm_pad_cover(dm_pad_dock_rect(safe, bar, e), chosen), there = dm_pad_cover(dm_pad_dock_rect(safe, bar, !e), chosen);
+        if (here > 0 && there < here) e = !e;
+    }
+    return e;
+}
