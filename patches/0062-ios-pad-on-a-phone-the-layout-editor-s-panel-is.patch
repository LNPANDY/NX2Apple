+// A phone's bar (DmPadEditor.h, "The compact bar"): the chosen group's rectangle, with its mirror image while they move together and room for its
+// tag above, so the bar keeps clear of what the finger is moving; the safe area keeps it off the sensor housing and the home indicator.
+- (void)editDock {
+    CGRect chosen = CGRectNull;
+    if (_editGroup >= 0 && dm_pad_group_drawn(_editGroup, _full)) {
+        const DmPadGeo *g = self.geo;
