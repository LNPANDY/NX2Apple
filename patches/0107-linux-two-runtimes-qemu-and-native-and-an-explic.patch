+++ b/dm/host/hle_thread.c
@@ -460,8 +460,10 @@ static void on_pause_sig(int sig, siginfo_t *si, void *uc_) {
     if (atomic_load(&g_teardown_park)) {
         uint64_t gtop = guest_gate_top_self();
         if (gtop) {
-            uc->uc_mcontext->__ss.__sp = gtop & ~15ull;
-            uc->uc_mcontext->__ss.__pc = (uint64_t)(uintptr_t)teardown_from_sig;
+            dm_linux_state_t *ss = dm_uc_ss(uc);   // the register view: on Apple the sigcontext's own
+            ss->__sp = gtop & ~15ull;
+            ss->__pc = (uint64_t)(uintptr_t)teardown_from_sig;
+            dm_linux_ss_stash(uc);
             return;
         }
     }
