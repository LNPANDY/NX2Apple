diff --git a/dm/host/linux/guest_stub_x86_64.c b/dm/host/linux/guest_stub_x86_64.c
new file mode 100644
index 0000000..1b80bbc
--- /dev/null
+++ b/dm/host/linux/guest_stub_x86_64.c
@@ -0,0 +1,85 @@
+// x86_64 Linux: the guest's ARM64 code has no place to run here.
+//
+// The host is portable C, but three of the interfaces it presents to the guest are written
+// in ARM64 assembly (dm/host/entry.S and dm/gfx/nvn/nvn_thunks.S, converted for Linux by
+// asm_elf.py): the gate stubs the rewriter patches into the game's code, the NVN counting
+// thunks the game calls through, and the big-stack entry of the take-overs. They are ARM64
+// instructions, and no C reimplements them: they exist to be entered by ARM64 code.
+//
+// On an x86_64 host the guest never enters them, so this file defines the symbols the
+// portable code references, at the sizes the host declares, and any code that reached one
+// anyway stops with a line that says what happened and why. The tables stay empty: a
+// filled table would claim a capability the host does not have.
+//
+// What this host *can* do: load, relocate and inspect an ARM64 module (the loader is C and
+// its ELF reader is architecture-agnostic) and answer every Horizon service that does not
+// require executing the guest. What it cannot: run the guest, draw or make sound.
+#if defined(DM_LINUX) && defined(__x86_64__)
+
+#include "hle.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "../gfx/nvn/nvn_count.h"
+
+#define GUEST_UNSUPPORTED_MSG \
+    "[dm] [RED] the guest's code is ARM64 and this host is x86_64: guest execution is not supported"
+
+// The one line every entry point prints. It is an exit, not a warning: reaching one of
+// these means something believed the guest could run here, and that belief is the bug.
+static void guest_unsupported(const char *what) {
+    fprintf(stderr, "%s (%s)\n", GUEST_UNSUPPORTED_MSG, what);
+    exit(86);
+}
+
+// ---- the sizes the host declares elsewhere (the entries of the symbols below)
+//
+// entry.S's .rept 4096 (hle.c MAX_STUB) and thread.c GATE_SLOTS x 16 bytes of stub per
+// slot. They are repeated here because those two files keep their counts to themselves;
+// a change there needs the same change here, and the swap is checked by the build.
+#define GUEST_MAX_STUB 4096          // = hle.c MAX_STUB = entry.S's .rept count
+#define GUEST_GATE_SLOTS 1024        // = thread.c GATE_SLOTS = entry.S's .rept count
+#define GUEST_GATE_STUB 16           // = entry.S's stub size (a 16-byte aligned block)
+
+// ---- the entry.S stubs the loader hands out and the thread entry uses
+
+// One word per unimplemented import stub (hle.c takes &unimpl_stubs[k] as a function
+// address): host-visible size only, because the guest that would call it does not run.
+uint64_t unimpl_stubs[GUEST_MAX_STUB];
+
+// The gate stubs, one per slot: the rewriter writes a slot's address into the guest's SVC
+// sites. Empty of instructions here; the size is what the pointers are drawn from.
+const uint8_t dm_gate_stubs[GUEST_GATE_SLOTS * GUEST_GATE_STUB];
+
+// The gate stacks' tops (thread.c dm_gate_top): the stub k reads its slot's top here.
+uint64_t dm_gate_top[GUEST_GATE_SLOTS];
+
+// A guest thread's entry: the SDK switches to the guest stack and calls it. There is no
+// guest stack on this host, so the call reports and stops.
+void dm_thread_enter(void (*entry)(void *), void *arg, void *stack_top) {
+    (void)entry;
+    (void)arg;
+    (void)stack_top;
+    guest_unsupported("a guest thread entry was reached");
+}
+
+// ---- the NVN counting thunks and the reporting entries
+
+void nvn_unimpl_entry(void) { guest_unsupported("an NVN thunk was reached"); }
+void nvn_prof_entry(void) { guest_unsupported("an NVN thunk was reached"); }
+void nvn_big_entry(void) { guest_unsupported("an NVN thunk was reached"); }
+
+// The thunk tables: the counting and the plain one, one address per NVN function.
+void *nvn_thunk[NVN_NFUNC];
+void *nvn_thunk_fast[NVN_NFUNC];
+
+// The names the thunks carry. They are the guest's function names, taken from
+// dm/gfx/nvn/nvn_thunks.S by asm_elf.py --names, because the names decide which of the
+// NVN implementations the host has (hle_nvn.c nvn_init_slots resolves by them) and that
+// resolution has to be the same on every host.
+extern const char *nvn_names[NVN_NFUNC];
+
+
+
+#endif
\ No newline at end of file
