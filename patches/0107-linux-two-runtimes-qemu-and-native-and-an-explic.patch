diff --git a/dm/host/Makefile.linux b/dm/host/Makefile.linux
index 3ced4d6..5998386 100644
--- a/dm/host/Makefile.linux
+++ b/dm/host/Makefile.linux
@@ -2,9 +2,11 @@
 # twins and the Linux stand-ins.
 #
 # What changes from dm/host/Makefile:
-#   target     aarch64 Linux, the arch the guest's code is in (cross-built from any host
-#              with zig; HOST_TARGET and HOST_CC override). x86_64 does not run the guest:
-#              the game's code is executed natively, so the host must be an ARM64 process.
+#   target     ARCH=aarch64 (default) is the guest's own architecture: the game's ARM64 code
+#              runs natively on an ARM64 host. ARCH=x86_64 builds the host for an Intel or
+#              AMD machine: the host runs there, and it loads, relocates and inspects ARM64
+#              modules, but their code cannot run (main.c says so and stops at that
+#              boundary with exit status 86). Neither build uses QEMU to start itself.
 #   toolchain  zig cc by default (static, runs anywhere), or a cross toolchain's gcc
 #   sources    the ObjC front ends and the Metal / Vulkan / OpenGL backends are not built;
 #              the front end is linux/front_linux.c and the graphics is
@@ -12,10 +14,19 @@
 #   audio      hle_audio.c and the movie decoders need Apple's AudioToolbox / VideoToolbox
 #              and are not built yet (the host runs, no sound, no movies); their HLE
 #              entries are stubbed by linux/linux_media_stub.c
+#   x86_64     the ARM64 assembly (the gate stubs the rewriter patches into the game's code,
+#              the NVN counting thunks) is replaced by linux/guest_stub_x86_64.c, whose
+#              entries report that the guest's code cannot run here, plus the name table
+#              asm_elf.py takes from the thunks file
 #   c locale   the host's messages are English and its error strings are the C locale's,
 #              as tools/patches.py clean_env asks on every platform
 #
 # Same GAME / DM_GAMES_DIR profile rules as the Mac build: there is no default game.
+#
+#   make -f Makefile.linux GAME=<id> [ARCH=aarch64|x86_64] [test]
+#
+# Artifacts are per architecture: gen/lin-<ARCH>/ and dmhost_linux-<ARCH>, so one build
+# never overwrites the other.
 
 PYTHON ?= python3
 
@@ -29,98 +40,133 @@ GAME_DIR :=
 endif
 GAME_H = gen/$(GAME)/game_profile.h
 
-# The cross target: aarch64 Linux by default (the guest's arch). HOST_TARGET=aarch64-linux-musl
-# gives a static binary that runs on any aarch64 Linux; HOST_TARGET=aarch64-linux-gnu links
-# against a distro's glibc instead.
-HOST_TARGET ?= aarch64-linux-musl
+# The architecture and the cross target: aarch64 Linux by default (the guest's own).
+# HOST_TARGET=<triple> overrides the compiler's target (aarch64-linux-musl here gives a
+# static binary that runs on any aarch64 Linux, aarch64-linux-gnu links against a distro's
+# glibc instead).
+ARCH ?= aarch64
+HOST_TARGET ?= $(ARCH)-linux-musl
 HOST_CC ?= zig cc -target $(HOST_TARGET)
 LDFLAGS ?= -static
 CFLAGS = -O1 -g -Wall -Wno-unused-function -Wno-format -std=gnu11 -fblocks -D_GNU_SOURCE -DDM_LINUX=1
 INCLUDES = -Ilinux/include -I. -I../gfx -I../gfx/nvn/include -I$(dir $(GAME_H)) -I../third_party/libvpx \
-           -I../third_party/dav1d/include -I../third_party/stb_vorbis -I../third_party/vulkan-headers/include
+           -I../third_party/dav1d/include -I../third_party/stb_vorbis -I../third_party/vulkan-headers/include \
+           -I../gfx/nvn
+
+# Per-architecture output, so the two builds never touch each other
+BUILD = gen/lin-$(ARCH)
+BIN = dmhost_linux-$(ARCH)
+TESTBIN = dmhost_linuxtest-$(ARCH)
 
 # The portable host: every *.c of dm/host except the ones that need Apple's frameworks
 # (hle_audio.c and hle_movie*.c: AudioToolbox / VideoToolbox), plus the Linux stand-ins and
-# the portable C of the graphics layer. libvpx (the movie codecs) is built from
-# dm/third_party/libvpx, as the Mac build does.
+# the portable C of the graphics layer. Adding a file needs no change here.
+#
+# hle_codec_video.c (the nn::codec video decoders, over libvpx) is left out on x86_64: its
+# libvpx is built with the vendored ARM64 configuration (NEON), the pictures it produces are
+# only ever asked for by the guest's code, and this host does not run that. On aarch64 it
+# builds as it always did.
+ifeq ($(ARCH),x86_64)
+X86_ONLY_OUT = hle_codec_video.c
+else
+X86_ONLY_OUT =
+endif
 SRC_C = $(sort $(wildcard *.c) $(wildcard linux/*.c))
-SRC_C := $(filter-out hle_audio.c hle_movie.c hle_movie_av1.c hle_movie_avc.c,$(SRC_C))
-HOST_C = $(SRC_C) ../gfx/hle_nv.c ../gfx/hle_vi.c ../gfx/nvn/hle_nvn.c ../gfx/nvn/nvn_capture.c \
-         ../gfx/nvn/nvn_dirty.c ../gfx/nvn/nvn_tex.c ../gfx/tex/nvn_bcdec.c ../gfx/tex/nvn_deswizzle.c \
-         ../gfx/tex/nvn_fmt_mtl.c ../third_party/stb_vorbis/stb_vorbis.c
-
-# The Mach-O assembly, converted to ELF by linux/asm_elf.py into gen/lin (the macOS build
-# keeps its own files). The two nvn_* files are the counting thunks and the special entries
-# of the NVN interface.
+SRC_C := $(filter-out hle_audio.c hle_movie.c hle_movie_av1.c hle_movie_avc.c $(X86_ONLY_OUT),$(SRC_C))
+
+# the name table the x86_64 build needs (no thunk to carry it there): the guest stub itself
+# is in the wildcard above and carries its own guard
+ifeq ($(ARCH),x86_64)
+SRC_C += $(BUILD)/nvn_names_x86.c
+endif
+
+# The portable C of the graphics layer, by wildcard, as dm/host/Makefile takes it: the tree
+# changes what it ships (upstream dropped the BC decoder's own file) and the list follows it
+HOST_C = $(SRC_C) $(sort $(wildcard ../gfx/*.c ../gfx/nvn/*.c ../gfx/tex/*.c)) \
+         ../third_party/stb_vorbis/stb_vorbis.c
+
+# The Mach-O assembly, converted to ELF by linux/asm_elf.py into $(BUILD) (the macOS build
+# keeps the files it always had). On x86_64 it is not assembled at all: it is ARM64.
+HOST_S =
+ifeq ($(ARCH),x86_64)
+else
 HOST_S = entry.S ../gfx/nvn/nvn_entry.S ../gfx/nvn/nvn_thunks.S
+endif
 
-# libvpx: the VP8 and VP9 decoders the movie player uses (its arm64 configuration is in
-# dm/third_party/libvpx/config, the one the Mac build uses; the codec's CPU dispatch takes
-# it from there)
+# libvpx: the VP8 and VP9 decoders (the movie player's). Its vendored configuration is the
+# ARM64 one, so it builds on aarch64 hosts. On x86_64 the file that uses it is out of the
+# build (see X86_ONLY_OUT above) and so is the library.
+ifeq ($(ARCH),x86_64)
+VPX_SRC =
+else
 VPX = ../third_party/libvpx
 VPX_SRC = $(sort $(shell find $(VPX) -name '*.c'))
-VPX_OBJ = $(patsubst $(VPX)/%.c,gen/lin/vpx_%.o,$(VPX_SRC))
+endif
+VPX_OBJ = $(patsubst $(VPX)/%.c,$(BUILD)/vpx_%.o,$(VPX_SRC))
 
-# Objects, one per source, flat under gen/lin (the basenames of the host are unique)
-TAG = tag
+# Objects, one per source, flat under $(BUILD) (the basenames of the host are unique)
 ALL_SRC = $(HOST_C) $(HOST_S) $(VPX_SRC)
-OBJ = $(addprefix gen/lin/,$(notdir $(HOST_C:.c=.o))) $(addprefix gen/lin/asm_,$(notdir $(HOST_S:.S=.o))) $(VPX_OBJ)
-DEP = $(OBJ:.o=.d)
+OBJ = $(addprefix $(BUILD)/,$(notdir $(HOST_C:.c=.o))) $(addprefix $(BUILD)/asm_,$(notdir $(HOST_S:.S=.o))) $(VPX_OBJ)
 
-.PHONY: host asm
+.PHONY: host all test
 .DEFAULT_GOAL := host
 
+all: host test
+
 $(GAME_H): $(GAME_DIR)/game.tsv ../games/game.py FORCE
 	@mkdir -p $(dir $@)
 	"$(PYTHON)" ../games/game.py header $(GAME) $@
 
-gen/lin/asm_entry.S: entry.S linux/asm_elf.py FORCE
+# The ELF twins, and the name table the x86_64 build needs (no thunk to carry it there)
+$(BUILD)/asm_entry.S: entry.S linux/asm_elf.py FORCE
 	@mkdir -p $(dir $@)
 	"$(PYTHON)" linux/asm_elf.py entry.S $@
-gen/lin/asm_nvn_entry.S: ../gfx/nvn/nvn_entry.S linux/asm_elf.py FORCE
+$(BUILD)/asm_nvn_entry.S: ../gfx/nvn/nvn_entry.S linux/asm_elf.py FORCE
 	@mkdir -p $(dir $@)
 	"$(PYTHON)" linux/asm_elf.py ../gfx/nvn/nvn_entry.S $@
-gen/lin/asm_nvn_thunks.S: ../gfx/nvn/nvn_thunks.S linux/asm_elf.py FORCE
+$(BUILD)/asm_nvn_thunks.S: ../gfx/nvn/nvn_thunks.S linux/asm_elf.py FORCE
 	@mkdir -p $(dir $@)
 	"$(PYTHON)" linux/asm_elf.py ../gfx/nvn/nvn_thunks.S $@
+$(BUILD)/nvn_names_x86.c: ../gfx/nvn/nvn_thunks.S linux/asm_elf.py FORCE
+	@mkdir -p $(dir $@)
+	"$(PYTHON)" linux/asm_elf.py --names ../gfx/nvn/nvn_thunks.S $@
 
-gen/lin/asm_entry.o: gen/lin/asm_entry.S FORCE
+$(BUILD)/asm_entry.o: $(BUILD)/asm_entry.S FORCE
 	$(HOST_CC) $(CFLAGS) -c $< -o $@
-gen/lin/asm_nvn_entry.o: gen/lin/asm_nvn_entry.S FORCE
+$(BUILD)/asm_nvn_entry.o: $(BUILD)/asm_nvn_entry.S FORCE
 	$(HOST_CC) $(CFLAGS) -c $< -o $@
-gen/lin/asm_nvn_thunks.o: gen/lin/asm_nvn_thunks.S FORCE
+$(BUILD)/asm_nvn_thunks.o: $(BUILD)/asm_nvn_thunks.S FORCE
 	$(HOST_CC) $(CFLAGS) -c $< -o $@
 
 # One rule per source, by basename (the files of dm/host have unique basenames)
 define HOST_C_RULE
-gen/lin/$(notdir $(1:.c=.o)): $(1) $(GAME_H) FORCE
+$(BUILD)/$(notdir $(1:.c=.o)): $(1) $(GAME_H) FORCE
 	@mkdir -p $$(dir $$@)
 	$(HOST_CC) $(CFLAGS) $(INCLUDES) -MMD -MP -c $(1) -o $$@
 endef
 $(foreach src,$(HOST_C),$(eval $(call HOST_C_RULE,$(src))))
 
-gen/lin/vpx_%.o: $(VPX)/%.c $(GAME_H) FORCE
+$(BUILD)/vpx_%.o: $(VPX)/%.c $(GAME_H) FORCE
 	@mkdir -p $(dir $@)
 	$(HOST_CC) $(CFLAGS) -I$(VPX) -I$(VPX)/config -MMD -MP -c $< -o $@
 
 host: $(OBJ) $(GAME_H)
-	$(HOST_CC) $(LDFLAGS) -o dmhost_linux $(OBJ)
+	$(HOST_CC) $(LDFLAGS) -o $(BIN) $(OBJ)
 
-# The compat layer's own test: the behaviour the host depends on. On an x86_64 host it runs
-# under qemu-user, which the test's arm64 binary needs.
+# The compat layer's own test: the behaviour the host depends on. It runs on the machine it
+# was built for, so on an x86_64 host it needs no QEMU; on an x86_64 host building the
+# aarch64 binary, QEMU is the emulator that runs it (QEMU=<path> names it).
 QEMU ?= qemu-aarch64-static
-TEST_OBJ = gen/lin/linux_compat.o gen/lin/linux_dispatch.o gen/lin/linux_blocks.o
-.PHONY: test
-test: gen/lin/t_linux_compat.o $(TEST_OBJ)
-	$(HOST_CC) $(LDFLAGS) -o dmhost_linuxtest $(TEST_OBJ) gen/lin/t_linux_compat.o
-	$(QEMU) ./dmhost_linuxtest
-
-gen/lin/t_linux_compat.o: linux/tests/t_linux_compat.c $(GAME_H) FORCE
+TEST_OBJ = $(BUILD)/linux_compat.o $(BUILD)/linux_dispatch.o $(BUILD)/linux_blocks.o
+$(BUILD)/t_linux_compat.o: linux/tests/t_linux_compat.c $(GAME_H) FORCE
 	@mkdir -p $(dir $@)
 	$(HOST_CC) $(CFLAGS) $(INCLUDES) -MMD -MP -c $< -o $@
+test: $(TEST_OBJ) $(BUILD)/t_linux_compat.o
+	$(HOST_CC) $(LDFLAGS) -o $(TESTBIN) $(TEST_OBJ) $(BUILD)/t_linux_compat.o
+	$(QEMU) ./$(TESTBIN)
 
 clean:
-	rm -rf gen dmhost_linux dmhost_linuxtest
+	rm -rf gen dmhost_linux-* dmhost_linuxtest-*
 
 .PHONY: FORCE
 FORCE:
diff --git a/dm/host/hle.h b/dm/host/hle.h
index 53c9d42..8244c79 100644
--- a/dm/host/hle.h
+++ b/dm/host/hle.h
@@ -42,7 +42,17 @@ typedef struct { const char *name; void *fn; const char *why; } hle_force_ent;
     static ret cname(__VA_ARGS__)
 // Same as above, but the implementation runs on this thread's big host stack (hle_bigstack.c): what is registered is a stub generated at compile time (the implementation's address goes into x16, then a jump to dm_bigstack_enter).
 // For take-overs with large stack use (the file system sizes its buffers by PATH_MAX): a game thread's stack can be as small as 8 KB. Only register arguments are carried over (<= 8 integer, <= 8 floating point); not for variadic functions
-#ifdef DM_LINUX
+#if defined(DM_LINUX) && defined(__x86_64__)
+// x86_64 Linux: the guest's code is ARM64 and does not run here, so the big-stack entry
+// has nothing to switch for. The take-over registers the implementation itself; the
+// implementation is host C either way, and the registered address is what a host caller
+// would reach. No assembly is written for the guest's calling convention, because there
+// is no guest on this host.
+#define HLE_FORCE_BIG(mangled, why, ret, cname, ...)                                               \
+    static ret cname(__VA_ARGS__) __attribute__((used));                                          \
+    __attribute__((used, section("__DATA,swforce"))) static const hle_force_ent hle_force_##cname = {mangled, (void *)(uintptr_t)cname, why}; \
+    static ret cname(__VA_ARGS__)
+#elif defined(DM_LINUX)
 // ELF: the symbols have no leading underscore, and an entry point's visibility is set with
 // .hidden (ELF has no .private_extern)
 #define HLE_FORCE_BIG(mangled, why, ret, cname, ...)                                               \
diff --git a/dm/host/hle_bigstack.c b/dm/host/hle_bigstack.c
index b4ccbd3..902edce 100644
--- a/dm/host/hle_bigstack.c
+++ b/dm/host/hle_bigstack.c
@@ -39,6 +39,7 @@ uintptr_t dm_bigstack_top(uintptr_t sp) {
 }
 
 // x16 = implementation. Frame (on the original stack, 0xa0 bytes): +0x00 x0-x8, x16, +0x50 d0-d7, +0x90 x29 / x30. After the switch the original sp and the game's return address are stored at the new stack top; the sp is restored when the implementation returns
+#if defined(DM_LINUX) && !defined(__x86_64__)
 #ifdef DM_LINUX
 // ELF: no leading underscores, and .hidden instead of .private_extern
 __asm__(
@@ -90,7 +91,6 @@ __asm__(
     "    add sp, sp, #0xa0\n"
     "    br x16\n");
 #else
-__asm__(
 __asm__(
     ".text\n"
     ".p2align 2\n"
@@ -140,12 +140,17 @@ __asm__(
     "    add sp, sp, #0xa0\n"
     "    br x16\n");
 #endif
-
+#endif
 
 // The return address inside an implementation that came through the switch is _dm_bigstack_ret; the game's own is in the slot the entry stored below this thread's host stack top. Only the outermost
 // take-over of a thread switches (a nested one already runs off the guest block and is jumped to directly), so that slot belongs to the call in progress
 void *dm_bigstack_caller(void *ra) {
+#if defined(DM_LINUX) && defined(__x86_64__)
+    (void)ra;
+    return ra;   // no switch on x86_64: the return address is the caller's own
+#else
     extern const char dm_bigstack_ret[];
     void **top = ra == (void *)dm_bigstack_ret ? pthread_getspecific(g_bs_key) : NULL;   // set: a switch happened on this thread
     return top ? top[-1] : ra;
+#endif
 }
diff --git a/dm/host/hle_offline.c b/dm/host/hle_offline.c
index 9aaedd5..d075a94 100644
--- a/dm/host/hle_offline.c
+++ b/dm/host/hle_offline.c
@@ -11,7 +11,11 @@ HLE_FORCE("_ZN2nn5prepo10PlayReport4SaveEv", "telemetry report save; nothing is
 // SDK 22's PlayReport::Send (Ocarina of Time saves one as the first scene starts, main+0x379164c) returns an AsyncContext in x8, which holds a pointer to the service's object. Null is what the SDK's
 // own default context has: GetCompletionEvent makes a signaled event (sdk+0x5a9298), GetResult answers 0 and the destructor does nothing, so only this call is taken over. Naked because x8 is the
 // hidden result pointer, 8 bytes on the caller's stack, which no C return type can name
+#if defined(DM_LINUX) && defined(__x86_64__)
+static void h_prepo_Send(void) { }   // x86_64: no AAPCS64 hidden x8 to fill, and no guest to call it
+#else
 __attribute__((naked)) static void h_prepo_Send(void) { __asm__("str xzr, [x8]\n    ret"); }
+#endif
 __attribute__((used, section("__DATA,swforce"))) static const hle_force_ent hle_force_h_prepo_Send = {"_ZN2nn5prepo10PlayReport4SendERKNS_7account3UidE", (void *)h_prepo_Send, "telemetry report send; nothing is sent, a default context completes at once with success"};
 HLE_FORCE("_ZN2nn5prepo10InitializeEv", "telemetry init: the original connects to the prepo service (through sm), the host has no service process; no-op (Engage calls it explicitly)", Result, h_prepo_Init, void) { return RES_OK; }
 // Add the session ID / connection status to a report: on hardware these first connect to the prepo service for the session (Super Mario 3D World + Bowser's Fury calls them entering the save select); the host adds nothing and reports success
diff --git a/dm/host/hle_svc.c b/dm/host/hle_svc.c
index a0ff4da..62a9e3f 100644
--- a/dm/host/hle_svc.c
+++ b/dm/host/hle_svc.c
@@ -299,6 +299,9 @@ static void guest_file_init(void) {
     else if (!confstr(_CS_DARWIN_USER_TEMP_DIR, dir, sizeof dir)) { LOG("[RED] [mem] guest memory: anonymous (DM_GUEST_FILE: no temporary folder, errno %d)", errno); return; }
     snprintf(g_gf_dir, sizeof g_gf_dir, "%s", dir);
     if (!guest_files_map(dir, chunk, n, &fs, why, sizeof why)) { LOG("[RED] [mem] guest memory: anonymous (DM_GUEST_FILE: %s)", why); return; }
+    g_gf_n = n; g_gf_chunk = chunk;
+    { const char *pu = getenv("DM_GUEST_FILE_PUNCH"); if (pu && *pu) g_gf_punch = atoi(pu) > 0; }
+    double avail = (double)fs.f_bavail * fs.f_bsize, imp = guest_file_free_important(), most = avail > imp ? avail : imp;
 #ifdef DM_LINUX
     (void)fs;   // Linux has no f_fstypename / MNT_LOCAL: the volume's name and localness are not there to report
     LOG("[mem] guest memory: %d files of %.2f GB in %s (unlinked, sparse, shared), %.2f GB in all, %.1f GB free on it (%.1f with what the system can purge); holes punched where the game gives memory back: %s",
@@ -307,8 +310,846 @@ static void guest_file_init(void) {
     LOG("[mem] guest memory: %d files of %.2f GB in %s (unlinked, sparse, shared), %.2f GB in all, on the %s volume, %.1f GB free on it (%.1f with what the system can purge); holes punched where the game gives memory back: %s",
         n, chunk / G, dir, g_reserve / G, fs.f_fstypename, avail / G, imp / G, g_gf_punch ? "on" : "off (DM_GUEST_FILE_PUNCH=0)");
 #endif
