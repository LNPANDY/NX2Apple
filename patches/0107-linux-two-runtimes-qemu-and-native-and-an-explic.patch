diff --git a/dm/host/linux/tests/adversarial_linux.sh b/dm/host/linux/tests/adversarial_linux.sh
new file mode 100755
index 0000000..accae0b
--- /dev/null
+++ b/dm/host/linux/tests/adversarial_linux.sh
@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+# The Linux modes' adversarial checks: each one is a way the run can be asked for the wrong
+# thing, and each has one expected answer. They exist so the failure modes are properties
+# the build keeps, not behaviour someone remembered.
+#
+#   engine/dm/host/linux/tests/adversarial_linux.sh
+#
+# Run from anywhere; it builds nothing and uses the binaries beside the host's Makefile.
+set -u
+
+HERE="$(cd "$(dirname "$0")/../.." && pwd)"       # dm/host
+QEMU="${QEMU_AARCH64:-qemu-aarch64-static}"
+MODS="${M3_TEST_MODS:-/tmp/nx2-no-mods}"     # a folder with no game in it
+pass=0
+fail=0
+
+say() { printf '%s\n' "$*"; }
+check() { # check <name> <expected exit> <actual exit>
+    if [ "$2" = "$3" ]; then pass=$((pass + 1)); say "ok: $1 (exit $3)";
+    else fail=$((fail + 1)); say "[RED] $1: expected exit $2, got $3"; fi
+}
+
+# 1. the native mode needs no QEMU on the path
+PATH=/usr/bin:/bin QEMU_AARCH64= "$HERE/run-linux" --mode native "$MODS" >/dev/null 2>&1
+check "native without QEMU on the path still runs the host" 134 $?
+
+# 2. the qemu mode without QEMU says so and stops
+out=$(PATH=/usr/bin:/bin QEMU_AARCH64= "$HERE/run-linux" --mode qemu "$MODS" 2>&1)
+rc=$?
+check "qemu mode without QEMU fails cleanly" 3 $rc
+case "$out" in
+    *"needs qemu-aarch64-static"*) pass=$((pass + 1)); say "ok: the qemu failure names the emulator";;
+    *) fail=$((fail + 1)); say "[RED] the qemu failure does not name the emulator";;
+esac
+
+# 3. a missing binary is not a silent success
+tmp=$(mktemp -d)
+cp "$HERE/run-linux" "$tmp/"
+(cd "$tmp" && ./run-linux --mode native "$MODS" >/dev/null 2>&1)
+check "a mode whose binary is not built fails" 5 $?
+rm -rf "$tmp"
+
+# 4. the wrong ELF for the machine is caught before it runs
+tmp=$(mktemp -d)
+cp "$HERE/run-linux" "$tmp/"
+cp "$HERE/dmhost_linux-aarch64" "$tmp/dmhost_linux-x86_64" 2>/dev/null || true
+if [ -f "$tmp/dmhost_linux-x86_64" ]; then
+    (cd "$tmp" && ./run-linux --mode native "$MODS" >/dev/null 2>&1)
+    check "the native mode refuses an ELF built for another architecture" 4 $?
+fi
+rm -rf "$tmp"
+
+# 5. a game folder that is not there
+"$HERE/dmhost_linux-x86_64" /tmp/nx2-no-such-modules >/dev/null 2>&1
+check "a module folder that does not exist fails" 134 $?
+
+# 6. an unreadable runtime profile, and a profile with no rows
+DM_PROFILE=/tmp/nx2-no-such-profile "$HERE/dmhost_linux-x86_64" "$MODS" >/dev/null 2>&1
+check "a runtime profile that cannot be read fails" 134 $?
+echo garbage > /tmp/nx2-bad-profile
+DM_PROFILE=/tmp/nx2-bad-profile "$HERE/dmhost_linux-x86_64" "$MODS" >/dev/null 2>&1
+check "a runtime profile with no rows fails" 134 $?
+
+# 7. the native mode must never fall back to qemu: with qemu on the path and the native
+#    binary present, the process is the host itself, not an emulator
+if "$HERE/run-linux" --mode native "$MODS" 2>&1 | grep -q "\[dm\] host x86_64 Linux"; then
+    pass=$((pass + 1)); say "ok: the native mode runs the host binary itself"
+else
+    fail=$((fail + 1)); say "[RED] the native mode did not show the host's own banner"
+fi
+# and the qemu mode's host is the ARM64 one, under the emulator (the same banner says aarch64)
+if "$HERE/run-linux" --mode qemu --qemu "${QEMU}" "$MODS" 2>&1 | grep -q "\[dm\] host aarch64 Linux"; then
+    pass=$((pass + 1)); say "ok: the qemu mode runs the ARM64 host under the emulator"
+else
+    fail=$((fail + 1)); say "[RED] the qemu mode did not run the ARM64 host"
+fi
+
+say ""
+say "adversarial: $pass ok, $fail failed"
+[ "$fail" = 0 ]
