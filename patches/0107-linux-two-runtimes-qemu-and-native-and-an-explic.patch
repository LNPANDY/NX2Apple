+++ b/dm/host/run-linux
@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+"""Run the Linux host in one of two modes: qemu or native.
+
+    ./run-linux [--mode qemu|native] [--game <title ID>] [-- <host arguments>]
+
+qemu    The ARM64 host binary, run under an emulator. It is the differential reference: the
+        guest's ARM64 code runs (slowly) and the whole engine is exercised. Needs
+        qemu-aarch64-static (QEMU_AARCH64 or --qemu names it) on an x86_64 machine, and
+        nothing on an ARM64 one, where it runs the same binary as the native mode.
+
+native  The host binary for this machine's own architecture, run directly: no emulator, no
+        binfmt_misc, no QEMU on the path. On an ARM64 machine that is the ARM64 binary and
+        the guest's code runs as it does under the qemu mode. On an x86_64 machine it is the
+        x86_64 binary, and the host says so and stops where the guest's code would start
+        (exit status 86), because the game's modules are ARM64 and this engine has no
+        instruction-set translation.
+
+The native mode never falls back to qemu: a missing binary, a wrong architecture or a
+missing emulator are three different failures with three different exit codes.
+"""
+import argparse
+import os
+import platform
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+BIN = lambda arch: HERE / ("dmhost_linux-" + arch)
+QEMU_EXIT = 3          # the emulator the qemu mode needs is not there
+NATIVE_ARCH_EXIT = 4   # no native binary for this machine's architecture
+BIN_MISSING_EXIT = 5   # the mode's binary has not been built
+GUEST_UNSUPPORTED_EXIT = 86   # the host loaded the modules and cannot run their code
+
+EXIT_CODES = {
+    0: "ok",
+    1: "the host reported a failure",
+    2: "usage",
+    QEMU_EXIT: "qemu is not available",
+    NATIVE_ARCH_EXIT: "no native binary for this architecture",
+    BIN_MISSING_EXIT: "the binary for this mode has not been built",
+    GUEST_UNSUPPORTED_EXIT: "the guest's code cannot run on this host",
+    70: "the GPU was lost",
+    86: "the guest's code cannot run on this host",
+    87: "the disk is full",
+    128 + 6: "the host aborted",
+}
+
+
+def machine() -> str:
+    """This machine's architecture, in the names the build uses."""
+    m = platform.machine()
+    return {"x86_64": "x86_64", "AMD64": "x86_64", "aarch64": "aarch64", "arm64": "aarch64"}.get(m, m)
+
+
+def elf_arch(path: Path) -> str:
+    """The architecture an ELF file was built for, from its header (no external tools)."""
+    import struct
+    with open(path, "rb") as f:
+        head = f.read(20)
+    if head[:4] != b"\x7fELF":
+        return "not an ELF file"
+    # e_machine is the second 16-bit word of the header (byte 18)
+    f = open(path, "rb")
+    f.seek(18)
+    e_machine = struct.unpack("<H", f.read(2))[0]
+    f.close()
+    return {0xB7: "aarch64", 0x3E: "x86_64"}.get(e_machine, "unknown (%d)" % e_machine)
+
+
+def find_qemu(name=None) -> str:
+    """The emulator the qemu mode runs the ARM64 binary with."""
+    for cand in [name or os.environ.get("QEMU_AARCH64"), "qemu-aarch64-static", "qemu-aarch64"]:
+        if cand and (Path(cand).exists() or shutil.which(cand)):
+            return cand
+    return ""
+
+
+def run(argv, env=None):
+    """Run a process, print its output, and give back its exit status."""
+    p = subprocess.run(argv, env=env)
+    return p.returncode
+
+
+def main():
+    ap = argparse.ArgumentParser(add_help=False)
+    ap.add_argument("--mode", choices=["qemu", "native"], default=None)
+    ap.add_argument("--game", default=os.environ.get("DM_GAME", ""))
+    ap.add_argument("--qemu", default=None)
+    ap.add_argument("args", nargs=argparse.REMAINDER)
+    a = ap.parse_args()
+
+    mode = a.mode or ("qemu" if machine() == "x86_64" and BIN("aarch64").exists() else "native")
+    host_args = [x for x in a.args if x != "--"]
+
+    print("run-linux: host %s, mode %s" % (machine(), mode), file=sys.stderr)
+
+    if mode == "native":
+        arch = machine()
+        binary = BIN(arch)
+        if not binary.exists():
+            print("run-linux: no native binary for %s (dmhost_linux-%s): build it with "
+                  "make -f Makefile.linux GAME=<id> ARCH=%s" % (arch, arch, arch), file=sys.stderr)
+            return BIN_MISSING_EXIT
+        if elf_arch(binary) != arch:
+            print("run-linux: dmhost_linux-%s is an ELF for %s, not for this machine's %s"
+                  % (arch, elf_arch(binary), arch), file=sys.stderr)
+            return NATIVE_ARCH_EXIT
+        # The native mode runs the host itself. Nothing else is on the path: no qemu, no
+        # binfmt, no fallback of any kind.
+        return run([str(binary)] + host_args)
+
+    # qemu: the ARM64 binary under an emulator (on an ARM64 machine it is the same binary,
+    # run directly, which is what the mode's fallthrough does)
+    binary = BIN("aarch64")
+    if not binary.exists():
+        print("run-linux: dmhost_linux-aarch64 is not built: make -f Makefile.linux "
+              "GAME=<id> ARCH=aarch64", file=sys.stderr)
+        return BIN_MISSING_EXIT
+    if machine() == "aarch64":
+        return run([str(binary)] + host_args)
+    q = find_qemu(a.qemu)
+    if not q:
+        print("run-linux: the qemu mode needs qemu-aarch64-static (QEMU_AARCH64 or --qemu "
+              "names it) and it is not on the path", file=sys.stderr)
+        return QEMU_EXIT
+    return run([q, str(binary)] + host_args)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
