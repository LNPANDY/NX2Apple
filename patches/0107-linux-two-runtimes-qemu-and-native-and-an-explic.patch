+// not device output, so they exist on every host: the decoder that owns the rest of the
+// native-image table (hle_codec_video.c, over libvpx and the ARM64 configuration) is out of
+// the x86_64 build, and hle_nvn.c's dm_native_image stays weak and answers "no picture" for
+// the handles that belong to it.
+#include <pthread.h>
+#include <sys/mman.h>
+#include <stdint.h>
+
+#define BLANK_MAX_X86 32
+#define CV_NATIVE_ALIGN_X86 0x4000ull   // = hle_codec_video.c CV_NATIVE_ALIGN
+static struct { uint32_t w, h; uint8_t *mem; uint64_t size; } g_blank_x86[BLANK_MAX_X86];
+static pthread_mutex_t g_blank_x86_mu = PTHREAD_MUTEX_INITIALIZER;
+static uint32_t blank_stride_x86(uint32_t w) { return (w * 16 + 63) & ~63u; }
+
+uint32_t dm_native_image_blank(uint32_t w, uint32_t h) {
+    uint64_t size = ((uint64_t)blank_stride_x86(w) * h + CV_NATIVE_ALIGN_X86 - 1) & ~(CV_NATIVE_ALIGN_X86 - 1);
+    void *mem = size ? mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0) : MAP_FAILED;
+    if (mem == MAP_FAILED) return 0;
+    pthread_mutex_lock(&g_blank_x86_mu);
+    uint32_t k = 0;
+    while (k < BLANK_MAX_X86 && g_blank_x86[k].mem) k++;
+    if (k < BLANK_MAX_X86) {
+        g_blank_x86[k].w = w;
+        g_blank_x86[k].h = h;
+        g_blank_x86[k].mem = mem;
+        g_blank_x86[k].size = size;
+    }
+    pthread_mutex_unlock(&g_blank_x86_mu);
+    if (k == BLANK_MAX_X86) {
+        munmap(mem, size);
+        return 0;
+    }
+    return 0x80000000u | (k + 1);
+}
+
+void dm_native_image_blank_free(uint32_t handle) {
+    uint32_t k = (handle & 0x7fffffffu) - 1;
+    if (!(handle >> 31) || k >= BLANK_MAX_X86) return;
+    pthread_mutex_lock(&g_blank_x86_mu);
+    uint8_t *mem = g_blank_x86[k].mem;
+    uint64_t size = g_blank_x86[k].size;
+    memset(&g_blank_x86[k], 0, sizeof g_blank_x86[k]);
+    pthread_mutex_unlock(&g_blank_x86_mu);
+    if (mem) munmap(mem, size);
+}
