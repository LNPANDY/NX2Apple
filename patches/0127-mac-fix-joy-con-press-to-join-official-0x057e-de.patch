+static void send_joycon_0x30(NSDictionary *dev, uint8_t rb, uint8_t sh, uint8_t lb) {
+    NSNumber *id = dev[@"registry"];
+    IOHIDReportCallback cb = (IOHIDReportCallback)[hid_report_cbs[id] pointerValue];
