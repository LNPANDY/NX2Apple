From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jon Ochocki <24785922+jonochocki@users.noreply.github.com>
Date: Thu, 5 Nov 2026 16:15:00 -0600
Subject: [PATCH] ios: allow custom controls across Duo outer landscape

Keep built-in control positions and size fallback inside their existing
safe areas. Only when the native hinge reports Closed and the view is
landscape, allow manually arranged controls to use the full view bounds.
Keep collision rejection and the fixed menu button's protected area.

Mirror this rule in the launcher editor so its saved offsets match the
runtime. Other phones, iPad and Duo inner/split layouts retain their
current bounds. Existing games need rebuilding to consume this change.

Front-ends: enable full custom bounds only for native Closed hinge status
in landscape, after computing safe-area default placement.

This change depends on the fork touch-control geometry and arrangement
introduced by patches 0065-0070. Upstream does not yet contain those
files, so forwarding this patch awaits those prerequisites.

Upstream-Status: pending
Reason: preserve editor and gameplay geometry parity when customizing Duo outer controls
Issue: LNPANDY/NX2Apple#695
---
diff --git a/dm/ios/Sources/DmGamepad.m b/dm/ios/Sources/DmGamepad.m
index 167cc49..43bd72a 100644
--- a/dm/ios/Sources/DmGamepad.m
+++ b/dm/ios/Sources/DmGamepad.m
@@ -275,7 +275,8 @@ - (void)setTouchFeedback:(BOOL)on {
 
 // ---- Layout (points; computed inside the safe area) ----
 - (void)arrange:(DmLayout)layout {
-    if (CGRectEqualToRect(_layout.controls, layout.controls) && CGRectEqualToRect(_layout.game, layout.game) && _layout.separated == layout.separated && _layout.topSafeOnly == layout.topSafeOnly) return;
+    if (CGRectEqualToRect(_layout.controls, layout.controls) && CGRectEqualToRect(_layout.game, layout.game) && _layout.separated == layout.separated
+        && _layout.topSafeOnly == layout.topSafeOnly && _layout.customControlsFullBounds == layout.customControlsFullBounds) return;
     [self reset];   // A finger held across a pose change must not leave a key or game touch stuck.
     _layout = layout; _geoValid = NO;
     [self setNeedsLayout];
diff --git a/dm/ios/Sources/DmLayout.h b/dm/ios/Sources/DmLayout.h
index bb3631f..bfc19b7 100644
--- a/dm/ios/Sources/DmLayout.h
+++ b/dm/ios/Sources/DmLayout.h
@@ -5,7 +5,11 @@
 
 NS_ASSUME_NONNULL_BEGIN
 
-typedef struct { CGRect game, controls; BOOL separated, topSafeOnly; } DmLayout;
+typedef struct { CGRect game, controls; BOOL separated, topSafeOnly, customControlsFullBounds; } DmLayout;
+
+static inline BOOL dm_layout_custom_controls_full_bounds(CGRect bounds, BOOL hingeClosed) {
+    return hingeClosed && bounds.size.width > bounds.size.height;
+}
 
 static inline UIEdgeInsets dm_game_safe_insets(CGRect bounds, UIEdgeInsets insets, BOOL duo) {
     return duo && bounds.size.height > bounds.size.width ? UIEdgeInsetsMake(insets.top, 0, 0, 0) : insets;
@@ -46,7 +50,7 @@ static inline CGRect dm_horizontal_division(CGRect b, CGRect division) {
 }
 
 static inline DmLayout dm_layout(CGRect b, UIEdgeInsets insets, BOOL partiallyOpen, CGRect division, CGFloat aspect) {
-    DmLayout l = { dm_aspect_fit(b, aspect), b, NO, NO };
+    DmLayout l = { dm_aspect_fit(b, aspect), b, NO, NO, NO };
     if (CGRectIsEmpty(b)) return l;
     division = dm_horizontal_division(b, division);
     BOOL portrait = b.size.height > b.size.width;
@@ -63,7 +67,7 @@ static inline DmLayout dm_layout(CGRect b, UIEdgeInsets insets, BOOL partiallyOp
 }
 
 // The picture is on a TV (front_ios.m DmTVSceneDelegate): the controls take the whole view and no touch goes to the game's touch screen (the game is docked there).
-static inline DmLayout dm_layout_pad_only(CGRect b) { return (DmLayout){ CGRectZero, b, NO, NO }; }
+static inline DmLayout dm_layout_pad_only(CGRect b) { return (DmLayout){ CGRectZero, b, NO, NO, NO }; }
 
 // Fill covers the full view only in the overlay layout (landscape). A portrait or tabletop split keeps the picture fitted in its
 // area above the controls, where cropping a small picture would cost more than the bars.
