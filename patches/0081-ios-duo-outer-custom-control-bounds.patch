--- a/dm/ios/Sources/DmPadGeometry.h
+++ b/dm/ios/Sources/DmPadGeometry.h
@@ -37,7 +37,7 @@ typedef struct {
 
 typedef struct {
     CGFloat u;                            // the unit every size below is a multiple of
