From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Victor Wads <victor.laureano@gmail.com>
Date: Fri, 13 Nov 2026 07:50:18 -0300
Subject: [PATCH] Keep plus and minus distinct in horizontal fallback and
 preview

Upstream-Status: pending
Reason: Keep plus and minus as distinct DSU controls when rendering and falling back to full-pad input
Issue: LNPANDY/NX2Apple#1206

---
 dm/host/hle_hid.c                             | 4 +++-
 dm/mac/Motion/Protocol.swift                  | 2 +-
 dm/mac/Motion/Tests/MotionContractTests.swift | 2 ++
 3 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/dm/host/hle_hid.c b/dm/host/hle_hid.c
index 40a03fc..b5a0a58 100644
--- a/dm/host/hle_hid.c
+++ b/dm/host/hle_hid.c
@@ -652,7 +652,9 @@ static void fill(NpadState *s, uint32_t id, uint32_t style) {
                 // Convert only this source, as the native sideways decoder does.
                 static const int left_from[]={15,12,14,13,11,4,6,8};
                 static const int right_from[]={2,0,3,1,10,5,7,9};
-                static const int target[]={0,1,2,3,10,4,8,9};
+                static const int target_left[]={0,1,2,3,11,4,8,9};
+                static const int target_right[]={0,1,2,3,10,4,8,9};
+                const int *target=role==DM_DSU_LEFT?target_left:target_right;
                 const int *from=role==DM_DSU_LEFT?left_from:right_from;uint64_t mapped=phone_buttons&(DM_BTN_PLUS|DM_BTN_MINUS);
                 for(int k=0;k<8;k++)if(phone_buttons&(1ull<<from[k]))mapped|=1ull<<target[k];
                 int rail=role==DM_DSU_LEFT?24:26;
diff --git a/dm/mac/Motion/Protocol.swift b/dm/mac/Motion/Protocol.swift
index e789ca3..9a9d422 100644
--- a/dm/mac/Motion/Protocol.swift
+++ b/dm/mac/Motion/Protocol.swift
@@ -66,7 +66,7 @@ enum DSU {
         /// Native JoyLeft/JoyRight reports remain upright for the game SDK.
         func horizontalPreview(role: DSURole, railSL: Int = -1, railSR: Int = -1) -> Inputs {
             guard role != .full else { return self }
-            let pairs: [(Int,Int)] = role == .left ? [(15,0),(12,1),(14,2),(13,3),(11,10),(4,4),(6,8),(8,9)] : [(2,0),(0,1),(3,2),(1,3),(10,10),(5,4),(7,8),(9,9)]
+            let pairs: [(Int,Int)] = role == .left ? [(15,0),(12,1),(14,2),(13,3),(11,11),(4,4),(6,8),(8,9)] : [(2,0),(0,1),(3,2),(1,3),(10,10),(5,4),(7,8),(9,9)]
             var result=Inputs(buttons: buttons & ((1 << 10) | (1 << 11)))
             for (source,target) in pairs where buttons & (1 << source) != 0 { result.buttons |= 1 << target }
             // Remove selected sources before adding outputs: SR mapped from L must
diff --git a/dm/mac/Motion/Tests/MotionContractTests.swift b/dm/mac/Motion/Tests/MotionContractTests.swift
index c9e0837..1e8b1ee 100644
--- a/dm/mac/Motion/Tests/MotionContractTests.swift
+++ b/dm/mac/Motion/Tests/MotionContractTests.swift
@@ -2,6 +2,8 @@ import XCTest
 @testable import NXMotion
 final class MotionContractTests:XCTestCase {
     func testHorizontalHalfPreview() {
+        XCTAssertEqual(DSU.Inputs(buttons:1 << 11).horizontalPreview(role:.left).buttons,1 << 11)
+        XCTAssertEqual(DSU.Inputs(buttons:1 << 10).horizontalPreview(role:.right).buttons,1 << 10)
         let rails=DSU.Inputs(buttons:(1 << 7)|(1 << 9)).horizontalPreview(role:.left,railSL:7,railSR:9)
         XCTAssertNotEqual(rails.buttons & (1 << 6),0)
         XCTAssertNotEqual(rails.buttons & (1 << 7),0)
