+#   · Fenrir (Sega, Valkyria Chronicles 4): gzip streams of BNSH files, 6,712 in the HSPK package FENRIR_SHADER_NEW_NX64_.HSG (a CRI CPK entry) and 158 in main, see gzip_bnsh_shaders
 #   · BEA (NintendoWare Bezel Engine archives, Big Brain Academy: Brain vs. Brain): BNSH in the .bfsha entries of the archives (zstd entries), see bea_members
 #   · MGFX (MonoGame effects, Celeste, Bastion): the effects in its XNB files and SpriteBatch's in main, each shader a control section and a code area (version 5: a whole GLSLC output), see mgfx_effect
 #   · dvdbnd (FromSoftware, Dark Souls Remastered): GLSLC outputs in the BND3 archives (DCX zlib entries) of the .bdt files, indexed by the .bhd5 beside each, see bhd5_entries and bdt_shaders
@@ -2997,8 +2998,32 @@ NEST = 16   # archives in archives scan_blob opens (SARC, PlatinumGames' DAT): r
             # each counted by what it takes up in its archive, and left[1], what its Yaz0 members expand to. Counting a Yaz0 member by what it expands to in the first budget paid twice
             # for the same bytes, once for the member and once for its members (GitHub issue #640: Mario Kart 8 Deluxe's UI/<lang>/race.sarc, 204 KB, holds one layout archive
             # that expands 9 times, which then added up to 18 times the file)
+GZ_BNSH = bytes.fromhex('1f8b080000000000000b')   # the header of Fenrir's gzip streams (Valkyria Chronicles 4): no flags, no time, OS 11 (NTFS); all 6,870 of them have exactly these ten bytes
+GZ_IN, GZ_OUT = 1 << 18, 1 << 24   # the most compressed bytes and decoded bytes of one stream (the game's are at most 4,259 and 10,512): a longer one is not a shader file
+HSPK = b'HSPK'
+def gzip_bnsh_shaders(d, label, out):
+    """Gzip streams that each hold one BNSH file, back to back in a Fenrir shader package ('HSPK', FENRIR_SHADER_NEW_NX64_.HSG in Valkyria Chronicles 4's FEN_0000.CPK: 6,714 streams, 6,712 BNSH of one stage
+    each, 45.6 MB decoded) and in the game's own main (158 more, its built-in fen_prim_* shaders, as 4 KB-aligned arrays in its data). The game inflates them with the SDK's zlib at start-up and hands the BNSH
+    to nn::gfx. A stream counts only with the exact header above, complete (no truncated or damaged stream) and BNSH inside, so a gzip stream of anything else, or a magic in code, is skipped; the decoded
+    bytes of all together may not pass NEST times the file's. Each BNSH holds one stage, so the shaders are single-stage programs (separable_pairs)"""
+    budget = NEST * len(d); mv = memoryview(d); i = d.find(GZ_BNSH); skip = 0
+    while i >= 0:
+        if i >= skip:
+            z = zlib.decompressobj(31)
+            try: data = z.decompress(mv[i:i + GZ_IN], GZ_OUT)
+            except zlib.error: data = b''
+            if z.eof and data[:8] == b'BNSH\0\0\0\0':
+                budget -= len(data)
+                if budget < 0: red(f'{label}: the gzip streams expand to more than {NEST} times the file')
+                skip = i + min(GZ_IN, len(d) - i) - len(z.unused_data)
+                scan_blob(data, f'{label}#GZ@{i:#x}', out, 1)
+        i = d.find(GZ_BNSH, i + 1)
+
 def scan_blob(d, label, out, depth=0, left=None):
     if depth > NEST: red(f'{label}: archives nested more than {NEST} deep')
+    if d[:4] == HSPK:   # a Fenrir shader package: gzip streams of BNSH files (gzip_bnsh_shaders)
+        gzip_bnsh_shaders(d, label, out)
+        return
     if d[:8] == SUMO_MUX:
         members = list(sumo_members(d, label))
         if left is None: left = [NEST * sum(len(member) for _, member in members)] * 2   # as with Yaz0, count decoded bytes, not compressed bytes
@@ -3070,7 +3095,7 @@ def pixel_input_cover(shaders):
         k = min(ins, key=lambda k: (-len(ins[k] & left), k)); cover.append(k); left -= ins[k]
     return cover
 
-SINGLE_STAGE = ('#GLSLC@', '#VIPER', '#UE', '#MTSPK@', '#MGFX@', '#NLG', '#PGSO', '#RAW@', '#TFXO@', '#NEEDLE@', '#SNOWDROP@', '#PHYRE@', '#SUMO@', '#NVNSH@', '#D3@', '#SHAD@')   # sources whose every shader is a program of one stage: GLSLC outputs, Unreal's shader records, MT Framework's shader package (BNSH variations, Unity programs, MSHD and SDF pair theirs);
+SINGLE_STAGE = ('#GLSLC@', '#VIPER', '#UE', '#MTSPK@', '#MGFX@', '#NLG', '#PGSO', '#RAW@', '#TFXO@', '#NEEDLE@', '#GZ@', '#SNOWDROP@', '#PHYRE@', '#SUMO@', '#NVNSH@', '#D3@', '#SHAD@')   # sources whose every shader is a program of one stage: GLSLC outputs, Unreal's shader records, MT Framework's shader package (BNSH variations, Unity programs, MSHD and SDF pair theirs);
 # Unreal Engine 3's shader caches (ue3_shaders, '#UE3@'); MonoGame's effects, whose passes may name no vertex shader and keep the one bound (Celeste: 10 of its 13 effects draw through SpriteBatch's vertex shader, which is in main); Next Level Games'
 # archives (Luigi's Mansion 3 makes 5,317 programs of one stage each at boot); PlatinumGames' shader objects (Bayonetta 3: one stage each, pg_shader); control sections loose in main
 # (Advance Wars 1+2: Re-Boot Camp's Bink shaders, raw_shaders), which no file pairs; YEBIS's effect file (tfxo_shaders); and Sumo's Ninty_NX descriptors and NVNsh records, one stage
@@ -3411,6 +3436,7 @@ def main():
             except ValueError: common = None   # not a Unity game
         found = []; scan_blob(img, 'main' + ('@' + tag if tag else ''), found)
         found += glslc_shaders(img, 'main' + ('@' + tag if tag else ''), need=False)
+        gzip_bnsh_shaders(img, 'main' + ('@' + tag if tag else ''), found)   # Fenrir's built-in shaders, gzip streams in main (Valkyria Chronicles 4: 158 fen_prim_* shaders)
         found += tfxo_streams(img, 'main' + ('@' + tag if tag else ''))   # YEBIS's effect file, a zlib stream in main (Pokémon Sword)
         found += retro_main_forms(img, 'main' + ('@' + tag if tag else ''))   # Retro's startup material archive, LZSS in main (Donkey Kong Country: Tropical Freeze)
         if RGXD in img: found += rgxd_shaders(img, 'main' + ('@' + tag if tag else ''))   # RAGE's built-in effects (Red Dead Redemption: 20 in main's data, 168 shaders that shaders.rpf lacks)
diff --git a/dm/tools/tests/test_gzip_bnsh.py b/dm/tools/tests/test_gzip_bnsh.py
new file mode 100644
index 0000000..770fb66
--- /dev/null
+++ b/dm/tools/tests/test_gzip_bnsh.py
@@ -0,0 +1,72 @@
+"""shader_split.gzip_bnsh_shaders: Fenrir's gzip streams of BNSH files (Valkyria Chronicles 4: 6,712 in the HSPK package FENRIR_SHADER_NEW_NX64_.HSG, 158 in main). Synthetic packages and
+images, no game files needed. A stream counts only with the game's exact gzip header, complete, and BNSH inside."""
+import struct
+import sys
+import unittest
+import zlib
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPO / 'dm/tools/fuzz'))
+import fuzz_shader_split as fz   # its BNSH builder and shader_split with a profile
+ss = fz.ss
+
+HEADER = bytes.fromhex('1f8b080000000000000b')   # no flags, no time, OS 11: the ten bytes of all 6,870 of the game's streams
+
+
+def gz(data, header=HEADER):
+    c = zlib.compressobj(9, zlib.DEFLATED, -15); body = c.compress(data) + c.flush()
+    return header + body + struct.pack('<II', zlib.crc32(data), len(data))
+
+
+def package(*streams, pad=0x400):
+    """a Fenrir package: the 'HSPK' header, then the streams back to back (padded: the synthetic BNSH is mostly zeros and compresses far more than the game's, 2.7 times, which a short file would show as expansion)"""
+    return b'HSPK' + bytes(0x1c) + b''.join(s + bytes(pad) for s in streams)
+
+
+def scan(d, label='/FENRIR.HSG'):
+    out = []; ss.scan_blob(d, label, out)
+    return out
+
+
+class GzipBnsh(unittest.TestCase):
+    def test_package_gives_every_stream(self):
+        out = scan(package(gz(fz.bnsh()), gz(fz.bnsh()), gz(fz.bnsh())))
+        self.assertEqual(len(out), 6)   # a vertex and a pixel stage in each synthetic BNSH
+        self.assertTrue(all('#GZ@' in w and '#BNSH@' in w for w, *_ in out))
+        self.assertEqual(len({w for w, *_ in out}), 3)   # each stream is its own source (where it sits), shared by its two stages
+
+    def test_main_image_between_code_and_data(self):
+        img = bytes(0x2000) + b'\x1f\x8b\x08\0\0\0\0\0\0\x0b' + bytes(0x100) + package(gz(fz.bnsh()))[0x20:] + bytes(0x1000)   # a magic in code, then a stream
+        out = []; ss.gzip_bnsh_shaders(img, 'main', out)
+        self.assertEqual(len(out), 2)
+        self.assertTrue(all(w.startswith('main#GZ@') for w, *_ in out))
+
+    def test_other_gzip_streams_are_left_alone(self):
+        b = fz.bnsh()
+        other = gz(b'not a shader file' * 40)                                   # the right header, other content
+        header = gz(b, header=bytes.fromhex('1f8b0800000000000203'))             # BNSH, another header (another tool's)
+        truncated = gz(b)[:-20]                                                  # damaged: no end of stream
+        self.assertEqual(scan(package(other, header, truncated)), [])
+
+    def test_undamaged_streams_after_a_damaged_one_are_read(self):
+        out = scan(package(gz(fz.bnsh())[:-20], gz(fz.bnsh())))
+        self.assertEqual(len(out), 2)
+
+    def test_expansion_is_bounded(self):
+        # members of 1 MB of zeros after a BNSH magic compress to about 1 KB: together they pass NEST times a file of a few KB
+        bomb = gz(b'BNSH\0\0\0\0' + bytes(1 << 20))
+        d = package(*[bomb] * 8)
+        with self.assertRaises(SystemExit) as e: ss.gzip_bnsh_shaders(d, '/b.hsg', [])
+        self.assertIn('expand to more than', str(e.exception))
+
+    def test_a_stream_that_does_not_end_within_the_limit_is_not_read(self):
+        big = gz(b'BNSH\0\0\0\0' + bytes(ss.GZ_OUT + 1))
+        self.assertEqual(scan(package(big)), [])
+
+    def test_sources_are_single_stage_programs(self):
+        self.assertIn('#GZ@', ss.SINGLE_STAGE)
+
+
+if __name__ == '__main__':
+    unittest.main()
