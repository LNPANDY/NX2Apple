+    return SS_ASK;
+}
+
+// DM_SAVE_SYNC_CHOICE: what the player chose before the start, after a front end compared the two saves (docs/frontends.md, The cloud saves folder).
+// "cloud:<hash>" brings in the cloud's save with that hash, "local:<hash>" lets this device's replace the cloud's save with that hash ("local:none": the cloud had none),
+// "offline": the cloud could not be read before the start. A choice holds only for the save it was made on: when the cloud's has changed since, nothing is replaced
+typedef enum { CH_NONE, CH_CLOUD, CH_LOCAL, CH_OFFLINE } choice_kind;
+static choice_kind read_choice(char *hash) {
+    const char *v = getenv("DM_SAVE_SYNC_CHOICE"); hash[0] = 0;
+    if (!v || !*v) return CH_NONE;
+    if (!strcmp(v, "offline")) return CH_OFFLINE;
+    choice_kind k = !strncmp(v, "cloud:", 6) ? CH_CLOUD : !strncmp(v, "local:", 6) ? CH_LOCAL : CH_NONE;
+    const char *h = v + 6;
+    if (k == CH_LOCAL && !strcmp(h, "none")) return k;
+    if (k != CH_NONE && strlen(h) == SS_HASH && strspn(h, "0123456789abcdef") == SS_HASH) { memcpy(hash, h, SS_HASH + 1); return k; }
+    SRED("DM_SAVE_SYNC_CHOICE=%s is not a choice (cloud:<hash>, local:<hash>, local:none, offline): ignored", v);
+    return CH_NONE;
 }
 
