 ss_way ss_decide(const char *local, const char *base, const char *remote, int64_t local_saved, int64_t remote_saved, int *both) {
+    (void)local_saved; (void)remote_saved;   // a save's time is shown to the player, it never picks one: a clock can be wrong, and the older save may be the one with the progress
     *both = 0;
