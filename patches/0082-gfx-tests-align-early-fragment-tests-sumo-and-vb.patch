From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LNPANDY <lnp-andy@hotmail.com>
Date: Thu, 26 Nov 2026 03:10:59 +0800
Subject: [PATCH] gfx/tests: align early_fragment_tests, sumo, and vbf with
 upstream chain changes

Provide the unity_acescc_lut stub in test_early_fragment_tests.py after dmsh_build.py added the Unity ACEScc LUT rewrite in job_for, and pass tuple-wrapped budget lists ([1], [1]) to scan_blob in test_sumo.py and test_vbf.py to match 6b352934.

Upstream-Status: pending
Reason: Upstream dmsh_build.py and 6b352934 updated job_for and scan_blob without updating test_early_fragment_tests.py, test_sumo.py, and test_vbf.py
Issue: none

---
 dm/gfx/tests/test_early_fragment_tests.py | 2 +-
 dm/gfx/tests/test_sumo.py                 | 2 +-
 dm/gfx/tests/test_vbf.py                  | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/dm/gfx/tests/test_early_fragment_tests.py b/dm/gfx/tests/test_early_fragment_tests.py
index 4283a76..a9d0b55 100644
--- a/dm/gfx/tests/test_early_fragment_tests.py
+++ b/dm/gfx/tests/test_early_fragment_tests.py
@@ -11,7 +11,7 @@ path = Path(__file__).resolve().parents[1] / 'tools/dmsh_build.py'
 nodes = [n for n in ast.parse(path.read_text()).body if (isinstance(n, ast.FunctionDef) and n.name in ('early_fragment_tests', 'job_for'))
          or (isinstance(n, ast.Assign) and getattr(n.targets[0], 'id', None) == 'NVN2_STAGE_INDEX')]
 sys.path.insert(0, str(path.parent)); import dmsh_ampere, dmsh_abi
-scope = {'struct': struct, 'os': os, 'dmsh_ampere': dmsh_ampere, 'abi': dmsh_abi, 'FACTS': {}, 'tf_layout': lambda key, ctl: None, 'vertex_ab': lambda key, code, ctl: None}
+scope = {'struct': struct, 'os': os, 'dmsh_ampere': dmsh_ampere, 'abi': dmsh_abi, 'FACTS': {}, 'tf_layout': lambda key, ctl: None, 'vertex_ab': lambda key, code, ctl: None, 'unity_acescc_lut': lambda code: code}
 exec(compile(ast.Module(body=nodes, type_ignores=[]), str(path), 'exec'), scope)
 early = scope['early_fragment_tests']; job_for = scope['job_for']
 
diff --git a/dm/gfx/tests/test_sumo.py b/dm/gfx/tests/test_sumo.py
index f98af2c..42d4313 100644
--- a/dm/gfx/tests/test_sumo.py
+++ b/dm/gfx/tests/test_sumo.py
@@ -95,7 +95,7 @@ class SumoTests(unittest.TestCase):
 
     def test_streams_keep_the_parent_archive_budget(self):
         with self.assertRaisesRegex(SystemExit, 'archive members add up to more than'):
-            split.scan_blob(mux(descriptor('vs')), '/member', [], left=[1, 1])
+            split.scan_blob(mux(descriptor('vs')), '/member', [], left=([1], [1]))
 
     def test_descriptor_bounds_version_and_shader_validation(self):
         for offset, fmt, value in [(4, '<I', 2), (0x78, '<Q', 0xffffffff), (0x78 + 8, '<Q', 0xd0), (0x78 + 16, '<I', 0x10), (0xd0 + 0x704, '<I', 8)]:
diff --git a/dm/gfx/tests/test_vbf.py b/dm/gfx/tests/test_vbf.py
index b95ecc8..3fb43b2 100644
--- a/dm/gfx/tests/test_vbf.py
+++ b/dm/gfx/tests/test_vbf.py
@@ -92,7 +92,7 @@ class Vbf(unittest.TestCase):
     def test_effect_keeps_the_parent_archive_budget(self):
         effect = b'RYHP' + bytes(9) + program('ps')
         with self.assertRaisesRegex(SystemExit, 'archive members add up to more than'):
-            split.scan_blob(effect, '/member', [], left=[1, 1])
+            split.scan_blob(effect, '/member', [], left=([1], [1]))
 
     def test_phyre_programs_in_main(self):
         """FFXII TZA: Phyre code area + control section pairs in main, unaligned, outside any RYHP container and referenced by nothing: raw_shaders takes the code area that ends at each"""
