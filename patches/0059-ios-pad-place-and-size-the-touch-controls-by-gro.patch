+// Group k, still at its home, at size s and anchor ax, ay (0 to 1): what the value asks, without the fit test. A single move that took a control of
+// the group out of its home box can take it past the area: the whole group then moves back inside (as a moved control stops at the edge).
+static inline void dm_pad_group_apply(DmPadGeo *g, BOOL full, BOOL sep, int k, CGFloat s, CGFloat ax, CGFloat ay) {
+    CGRect h = g->home[k], a = g->area[k];
+    if (CGRectIsNull(h) || CGRectIsNull(a)) return;
+    CGPoint from = g->at[k];
+    CGPoint to = CGPointMake(dm_pad_anchor_pos(CGRectGetMinX(a), CGRectGetMaxX(a), s * h.size.width, ax),
+                             dm_pad_anchor_pos(CGRectGetMinY(a), CGRectGetMaxY(a), s * h.size.height, ay));
+    dm_pad_group_map(g, sep, k, from, to, s);
+    CGRect b = dm_pad_group_box(g, full, k, NULL);
+    CGFloat dx = dm_pad_clamp_1d(CGRectGetMinX(b), CGRectGetMaxX(b), CGRectGetMinX(a), CGRectGetMaxX(a));
+    CGFloat dy = dm_pad_clamp_1d(CGRectGetMinY(b), CGRectGetMaxY(b), CGRectGetMinY(a), CGRectGetMaxY(a));
+    if (dx != 0 || dy != 0) dm_pad_group_map(g, sep, k, CGPointZero, CGPointMake(dx, dy), 1);
