+// The bottom corners' groups (the left stick, the D-pad, A B X Y) may reach halfway into the side insets only in the bottom band, where they are built
+// in: on a phone held sideways the sensor housing (the notch, the Dynamic Island) sits in the middle of a side inset and the band below it is free. A
+// shape of a placed group that reaches above its home box's top (the group moved up, or grown) keeps out of the side insets altogether: the group
+// moves inward until every such shape is inside the safe area's sides. Over the picture only (split off below it, the corner area is the safe area);
+// an iPad has no side insets, so nothing moves there, and neither does a group that stays in its band.
+static inline void dm_pad_group_keep_off_sides(DmPadGeo *g, BOOL full, BOOL sep, int k) {
+    if (sep || (k != DM_PAD_G_STICK && k != DM_PAD_G_DPAD && k != DM_PAD_G_FACE)) return;
+    CGRect safe = g->safe, h = g->home[k];
+    if (CGRectIsNull(safe) || CGRectIsNull(h) || safe.size.width <= 0) return;
