+        exe = Path(tmp) / Path(check).stem
+        if sys.platform == "darwin":
+            cmd = ["clang", "-x", "objective-c", "-fobjc-arc", "-Wall", "-Werror", "-Wno-unused-function",
+                   "-I", str(HERE), "-I", str(IOS / "Sources"), str(HERE / check),
+                   "-framework", "Foundation", "-framework", "CoreGraphics", "-o", str(exe)]
+        else:
+            cmd = ["clang", "-x", "c", "-std=gnu11", "-Wall", "-Werror", "-Wno-unused-function",
+                   "-I", str(HERE / "portable"), "-I", str(IOS / "Sources"), str(HERE / check), "-lm", "-o", str(exe)]
+        subprocess.run(cmd, check=True)
+        run = subprocess.run([str(exe)], capture_output=True, text=True)
+        test.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+        test.assertIn("ok:", run.stdout)
+        return run.stdout
+
