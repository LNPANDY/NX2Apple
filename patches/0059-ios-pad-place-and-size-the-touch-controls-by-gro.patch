+    for (int i = 0; i < n; i++) {
+        if (dm_pad_shape_group(sh[i].id) != k) continue;
+        CGRect b = dm_pad_shape_box(&sh[i]);
+        if (CGRectGetMinY(b) >= CGRectGetMinY(h) - 0.5) continue;   // in the bottom band: as built in
+        right = fmax(right, CGRectGetMinX(safe) - CGRectGetMinX(b));
+        left = fmax(left, CGRectGetMaxX(b) - CGRectGetMaxX(safe));
+    }
+    CGFloat dx = right > 0 && left > 0 ? (right - left) / 2 : right > 0 ? right : left > 0 ? -left : 0;   // wider than the safe area: centred
