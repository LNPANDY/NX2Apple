+// One number of the value: 1 to 4 digits, no sign, at most max.
+static inline BOOL dm_pad_parse_number(const char *_Nonnull *_Nonnull pp, int max, int *out) {
+    const char *p = *pp; int v = 0, digits = 0;
+    while (*p >= '0' && *p <= '9') { if (++digits > 4) return NO; v = v * 10 + (*p++ - '0'); }
+    if (!digits || v > max) return NO;
+    *out = v; *pp = p;
+    return YES;
+}
+// NO for a value it ignored; out is then the built-in layout, as for an unset or empty value (which give YES).
+static inline BOOL dm_pad_groups_parse(const char *_Nullable v, DmPadGroups *out) {
+    memset(out, 0, sizeof *out);
+    if (!v || !*v) return YES;
+    if (strnlen(v, DM_PAD_GROUPS_MAX + 1) > DM_PAD_GROUPS_MAX || v[0] != '1' || (v[1] && v[1] != ';')) return NO;
+    DmPadGroups r; memset(&r, 0, sizeof r);
+    const char *p = v + 1;
+    while (*p == ';') {
+        const char *name = ++p;
+        while (*p && *p != '/' && *p != ';') p++;
+        int set = dm_pad_name_index(name, (size_t)(p - name), dm_pad_set_names, DM_PAD_SET_N);
+        while (*p == '/') {
+            const char *field = ++p;
+            while ((*p >= 'a' && *p <= 'z') || (*p >= '0' && *p <= '9')) p++;
+            size_t n = (size_t)(p - field);
+            if (!n || *p != ':') return NO;
+            p++;
+            int num[4], count = 0;
+            for (;;) {
+                if (count == 4 || !dm_pad_parse_number(&p, 9999, &num[count])) return NO;
+                count++;
+                if (*p != ',') break;
+                p++;
+            }
+            int k = dm_pad_name_index(field, n, dm_pad_group_names, DM_PAD_G_N);
+            if (k >= 0) {
+                if (count != 3 || num[0] > DM_PAD_ANCHOR_MAX || num[1] > DM_PAD_ANCHOR_MAX || num[2] < DM_PAD_SIZE_MIN || num[2] > DM_PAD_SIZE_MAX) return NO;
