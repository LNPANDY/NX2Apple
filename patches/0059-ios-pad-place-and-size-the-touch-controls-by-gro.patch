--- /dev/null
+++ b/dm/ios/Sources/DmPadEditing.h
@@ -0,0 +1,518 @@
+// The in-game layout editor's rules ("Adjust Gamepad Layout", DmGamepad.m draws it and takes its touches): pure functions of the scene and the draft,
+// tested without a device (dm/ios/tests/test_pad_geometry.py, pad_geometry/pad_groups_check.m), so a drag, a pinch, the sliders and the self-test
+// (DM_PAD_LAYOUT_TEST) all go through the same rules. The draft is a DmPadGroups (DmPadGeometry.h, "Groups"); the editor changes the layout on screen
+// (2D or 3D, over the picture or split off below it) and keeps the others as they were.
+//   A change is kept only when the geometry puts the group exactly there at that size and every group that was placed stays as it was
+//   (dm_pad_try_place): what the editor shows is what the game draws after a save and a new start. A spot it refuses is drawn red under the finger
+//   (dm_pad_preview) and the group goes back when the finger lifts.
+//   A size asked for (a pinch, the slider, − and +) is the largest between the size now and the one asked for that fits (dm_pad_try_size_mated), so a
+//   group grows until it meets another and stops there. All controls' size likewise (dm_pad_try_all), never below the size that keeps every touch
+//   target 44 points across (dm_pad_all_min).
+//   Mirror left and right (the draft's solo off, the default): a move or a size of one group goes to its mirror image too (the shoulders of both
+//   sides, the left stick and A B X Y), mirrored from their built-in places; a size only as far as the mirror image has room, the chosen group going
+//   on alone past it ("Mirror left and right when one side has less room").
+//   Where Done saves (every game's layout or this game's own) and what it keeps of the other layouts: "Where Done saves". Which finger drags and when
+//   two fingers pinch: "The editor's fingers".
+//   A drag snaps the group's box to the area's edges and to its middle within a few points (dm_pad_place_at).
+#pragma once
+#import "DmPadGeometry.h"
+#include <stdint.h>
+#include <stdlib.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+// What the editor lays out on: the gamepad's bounds, safe area, split and layout, and the player's options (whose groups are replaced by the draft's).
+typedef struct { CGRect bounds; UIEdgeInsets insets; DmLayout layout; BOOL full; DmPadOptions o; } DmPadScene;
+
+static inline int dm_pad_scene_set(const DmPadScene *sc) { return dm_pad_set_of(sc->full, sc->layout.separated); }
+static inline DmPadGeo dm_pad_scene_geo(const DmPadScene *sc, const DmPadGroups *draft) {
+    DmPadOptions o = sc->o; o.groups = draft;
+    return dm_pad_geo(sc->bounds, sc->insets, sc->layout, sc->full, o);
+}
+// The draft's layout on screen with every group at its built-in place (all controls' size kept): where each group's home and floor are measured.
+static inline DmPadGeo dm_pad_scene_home(const DmPadScene *sc, const DmPadGroups *draft) {
+    DmPadGroups t = *draft;
+    memset(t.place[dm_pad_scene_set(sc)], 0, sizeof t.place[0]);
+    return dm_pad_scene_geo(sc, &t);
+}
+static inline int dm_pad_clampi(int v, int lo, int hi) { return v < lo ? lo : v > hi ? hi : v; }
+static inline short dm_pad_permille(CGFloat a) { return (short)dm_pad_clampi((int)lround(a * DM_PAD_ANCHOR_MAX), 0, DM_PAD_ANCHOR_MAX); }
+
+// The sizes the editor offers group k, in percent: from its floor (DM_PAD_SIZE_MIN, or the 44-point touch target) to DM_PAD_SIZE_MAX.
+static inline int dm_pad_size_min(const DmPadScene *sc, const DmPadGroups *draft, int k) {
+    DmPadGeo h = dm_pad_scene_home(sc, draft);
+    CGFloat lo = fmax(DM_PAD_SIZE_MIN / 100.0, dm_pad_group_floor(&h, sc->full, sc->layout.separated, k));
+    return dm_pad_clampi((int)ceil(lo * 100 - 1e-6), DM_PAD_SIZE_MIN, 100);
+}
+// The all controls' sizes the editor offers for the layout on screen, in percent: from the size that keeps every touch target 44 points across
+// (dm_pad_all_floor) to DM_PAD_ALL_MAX; and the size it has now as drawn (a value saved below that floor is drawn at it).
+static inline int dm_pad_all_min(const DmPadScene *sc, const DmPadGroups *draft) {
+    (void)draft;
+    return dm_pad_all_drawn(sc->bounds, sc->insets, sc->layout, sc->full, sc->o, DM_PAD_ALL_MIN);
+}
+static inline int dm_pad_all_now(const DmPadScene *sc, const DmPadGroups *draft) {
+    return dm_pad_all_drawn(sc->bounds, sc->insets, sc->layout, sc->full, sc->o, draft->all[dm_pad_scene_set(sc)]);
+}
+// The anchor (in thousandths) of group k's home box at size percent, centred on c: the place that puts the group there.
+static inline DmPadPlace dm_pad_place_centred(const DmPadGeo *g, int k, int size, CGPoint c) {
+    CGRect h = g->home[k], a = g->area[k]; CGFloat s = size / 100.0;
+    return (DmPadPlace){dm_pad_permille(dm_pad_anchor_of(CGRectGetMinX(a), CGRectGetMaxX(a), s * h.size.width, c.x)),
+                        dm_pad_permille(dm_pad_anchor_of(CGRectGetMinY(a), CGRectGetMaxY(a), s * h.size.height, c.y)), (short)size};
+}
+// Where group k is now, as the editor stores it: its place in the draft, or for a group at its built-in place (none asked for, or one that did not
+// fit and stayed there) the anchor of its home box at size 100.
+static inline DmPadPlace dm_pad_place_now(const DmPadScene *sc, const DmPadGroups *draft, int k) {
+    int set = dm_pad_scene_set(sc);
+    DmPadGeo g = dm_pad_scene_geo(sc, draft);
+    if (draft->place[set][k].size && (g.groupMoved & (1u << k))) return draft->place[set][k];
+    return dm_pad_place_centred(&g, k, 100, CGPointMake(CGRectGetMidX(g.home[k]), CGRectGetMidY(g.home[k])));
+}
+// One axis of a drag: the box's centre c, w wide, snapped to the area lo..hi's edges and its middle within snap points.
+static inline CGFloat dm_pad_snap(CGFloat c, CGFloat w, CGFloat lo, CGFloat hi, CGFloat snap) {
+    if (fabs(c - w / 2 - lo) <= snap) return lo + w / 2;
+    if (fabs(c + w / 2 - hi) <= snap) return hi - w / 2;
+    if (fabs(c - (lo + hi) / 2) <= snap) return (lo + hi) / 2;
+    return c;
+}
+static const CGFloat DM_PAD_SNAP = 12;   // points
+// The place a drag gives group k at size percent: its home box centred on c (where its centre was when the drag began, plus the finger's move),
+// snapped to the edges and the middle of its area within snap points. A centre past an edge stops at it.
+static inline DmPadPlace dm_pad_place_at(const DmPadGeo *g, int k, int size, CGPoint c, CGFloat snap) {
+    CGRect h = g->home[k], a = g->area[k]; CGFloat s = size / 100.0;
+    c.x = dm_pad_snap(c.x, s * h.size.width, CGRectGetMinX(a), CGRectGetMaxX(a), snap);
+    c.y = dm_pad_snap(c.y, s * h.size.height, CGRectGetMinY(a), CGRectGetMaxY(a), snap);
+    return dm_pad_place_centred(g, k, size, c);
+}
+// The halves are linked (Mirror left and right) and group k has a mirror image drawn in this layout.
+static inline BOOL dm_pad_linked(const DmPadScene *sc, const DmPadGroups *draft, int k) {
+    int m = dm_pad_group_mirror(k);
+    return m >= 0 && !draft->solo[dm_pad_scene_set(sc)] && dm_pad_group_drawn(m, sc->full);
+}
+// The mirror image m of group k at p, at size sizeM (percent): the same move from its built-in place as k's, left and right swapped, at a size of
+// its own. For the shoulders (built in symmetric) at k's size that is the mirrored anchor. g holds the homes.
+static inline DmPadPlace dm_pad_place_partner_at(const DmPadGeo *g, int k, int m, DmPadPlace p, int sizeM) {
+    CGFloat s = p.size / 100.0, sm = sizeM / 100.0;
+    CGRect hk = g->home[k], ak = g->area[k], hm = g->home[m], am = g->area[m];
+    CGFloat kx = DM_PAD_ANCHOR_MAX * dm_pad_anchor_of(CGRectGetMinX(ak), CGRectGetMaxX(ak), s * hk.size.width, CGRectGetMidX(hk));
+    CGFloat ky = DM_PAD_ANCHOR_MAX * dm_pad_anchor_of(CGRectGetMinY(ak), CGRectGetMaxY(ak), s * hk.size.height, CGRectGetMidY(hk));
+    CGFloat mx = DM_PAD_ANCHOR_MAX * dm_pad_anchor_of(CGRectGetMinX(am), CGRectGetMaxX(am), sm * hm.size.width, CGRectGetMidX(hm));
+    CGFloat my = DM_PAD_ANCHOR_MAX * dm_pad_anchor_of(CGRectGetMinY(am), CGRectGetMaxY(am), sm * hm.size.height, CGRectGetMidY(hm));
+    return (DmPadPlace){(short)dm_pad_clampi((int)lround(mx - (p.x - kx)), 0, DM_PAD_ANCHOR_MAX),
+                        (short)dm_pad_clampi((int)lround(my + (p.y - ky)), 0, DM_PAD_ANCHOR_MAX), (short)sizeM};
+}
+// The mirror image m of group k at p at k's size.
+static inline DmPadPlace dm_pad_place_partner(const DmPadGeo *g, int k, int m, DmPadPlace p) { return dm_pad_place_partner_at(g, k, m, p, p.size); }
+// The draft with group k at p (and its mirror image where the halves are linked, at size sizeM; below 0: k's size), whether or not the geometry
+// takes it.
+static inline DmPadGroups dm_pad_with_places(const DmPadScene *sc, const DmPadGroups *draft, int k, DmPadPlace p, int sizeM, unsigned *_Nullable edited) {
+    int set = dm_pad_scene_set(sc);
+    DmPadGroups t = *draft;
+    t.place[set][k] = p;
+    unsigned e = 1u << k;
+    if (dm_pad_linked(sc, draft, k)) {
+        int m = dm_pad_group_mirror(k);
+        DmPadGeo h = dm_pad_scene_home(sc, draft);
+        t.place[set][m] = dm_pad_place_partner_at(&h, k, m, p, sizeM < 0 ? p.size : sizeM);
+        e |= 1u << m;
+    }
+    if (edited) *edited = e;
+    return t;
+}
+static inline DmPadGroups dm_pad_with_place(const DmPadScene *sc, const DmPadGroups *draft, int k, DmPadPlace p, unsigned *_Nullable edited) {
+    return dm_pad_with_places(sc, draft, k, p, -1, edited);
+}
+static inline BOOL dm_pad_same_point(CGPoint a, CGPoint b) { return fabs(a.x - b.x) < 0.01 && fabs(a.y - b.y) < 0.01; }
+// YES and the new draft in out when the geometry puts group k at p (and its mirror image at its place, at size sizeM; below 0: k's size) at exactly
+// the sizes asked for, and every group that was placed before keeps its place and size. A group that had kept its built-in place for want of room may
+// now take its own.
+static inline BOOL dm_pad_try_places(const DmPadScene *sc, const DmPadGroups *draft, int k, DmPadPlace p, int sizeM, DmPadGroups *out) {
+    if (!dm_pad_group_drawn(k, sc->full) || p.size < DM_PAD_SIZE_MIN || p.size > DM_PAD_SIZE_MAX) return NO;
+    if (sizeM >= 0 && (sizeM < DM_PAD_SIZE_MIN || sizeM > DM_PAD_SIZE_MAX)) return NO;
+    int set = dm_pad_scene_set(sc);
+    unsigned edited;
+    DmPadGroups t = dm_pad_with_places(sc, draft, k, p, sizeM, &edited);
+    DmPadGeo before = dm_pad_scene_geo(sc, draft), after = dm_pad_scene_geo(sc, &t), home = dm_pad_scene_home(sc, draft);
+    for (int j = 0; j < DM_PAD_G_N; j++) {
+        if (!dm_pad_group_drawn(j, sc->full)) continue;
+        if (edited & (1u << j)) {
+            CGFloat want = dm_pad_group_scale(&home, sc->full, sc->layout.separated, j, t.place[set][j].size);
+            if (!(after.groupMoved & (1u << j)) || fabs(after.gs[j] - want) > 1e-9) return NO;
+        } else if (before.groupMoved & (1u << j)) {
+            if (!(after.groupMoved & (1u << j)) || after.gs[j] != before.gs[j] || !dm_pad_same_point(after.at[j], before.at[j])) return NO;
+        }
+    }
+    *out = t;
+    return YES;
+}
+static inline BOOL dm_pad_try_place(const DmPadScene *sc, const DmPadGroups *draft, int k, DmPadPlace p, DmPadGroups *out) {
+    return dm_pad_try_places(sc, draft, k, p, -1, out);
+}
+// A size for group k where it is now (its anchor kept, and its mirror image's at the same size): the largest between its size now and want (percent,
+// kept within its range) that fits. Returns the size it got, and the draft in out (the draft as it was when not even a step fits).
+static inline int dm_pad_try_size(const DmPadScene *sc, const DmPadGroups *draft, int k, int want, DmPadGroups *out) {
+    *out = *draft;
+    if (!dm_pad_group_drawn(k, sc->full)) return 100;
+    DmPadPlace now = dm_pad_place_now(sc, draft, k), p = now;
+    want = dm_pad_clampi(want, dm_pad_size_min(sc, draft, k), DM_PAD_SIZE_MAX);
+    if (want == now.size) return want;
+    p.size = (short)want;
+    if (dm_pad_try_place(sc, draft, k, p, out)) return want;
+    int good = now.size, bad = want;
+    while (abs(bad - good) > 1) {
+        int mid = (good + bad) / 2; DmPadGroups t;
+        p.size = (short)mid;
+        if (dm_pad_try_place(sc, draft, k, p, &t)) { good = mid; *out = t; } else bad = mid;
+    }
+    return good;
+}
+
+// ---- Mirror left and right when one side has less room ----
+// A drag moves the mirror image along at the size it has (a drag never resizes anything). A size goes to the mirror image as far as it has room:
+// the two take it together while both fit, then the chosen group goes on alone and its mirror image keeps the largest size it has room for (A B X Y
+// larger than the left stick, which meets the D-pad in 3D). Mirror left and right then keeps the two places mirrored, not their sizes equal.
+// The size group k's mirror image has now, -1 when the halves are not linked or k has none.
+static inline int dm_pad_mate_size(const DmPadScene *sc, const DmPadGroups *draft, int k) {
+    return dm_pad_linked(sc, draft, k) ? dm_pad_place_now(sc, draft, dm_pad_group_mirror(k)).size : -1;
+}
+// Group k where it is now at size sizeK, its mirror image (when linked) mirrored at size sizeM: YES and the draft in out when that fits.
+static inline BOOL dm_pad_try_mated(const DmPadScene *sc, const DmPadGroups *draft, int k, int sizeK, int sizeM, DmPadGroups *out) {
+    DmPadPlace p = dm_pad_place_now(sc, draft, k);
+    p.size = (short)sizeK;
+    return dm_pad_try_places(sc, draft, k, p, sizeM, out);
+}
+// A size for group k where it is now, its mirror image along as far as it has room (see above): the largest between k's size now and want at which the
+// mirror image keeps at least its own size (or k's, when that is smaller), then the mirror image as large as it has room for, up to k's size. (Where
+// the mirror image goes depends a little on k's size, so its room is found at k's new size.) Returns k's size; *mate is the mirror image's (k's when
+// there is none), out the draft (the draft as it was when nothing fits).
+static inline int dm_pad_try_size_mated(const DmPadScene *sc, const DmPadGroups *draft, int k, int want, DmPadGroups *out, int *_Nullable mate) {
+    *out = *draft;
+    int nowM = dm_pad_mate_size(sc, draft, k);
+    if (!dm_pad_group_drawn(k, sc->full) || nowM < 0) {
+        int got = dm_pad_try_size(sc, draft, k, want, out);
+        if (mate) *mate = got;
+        return got;
+    }
+    int nowK = dm_pad_place_now(sc, draft, k).size;
+    want = dm_pad_clampi(want, dm_pad_size_min(sc, draft, k), DM_PAD_SIZE_MAX);
+    if (mate) *mate = nowM;
+    if (want == nowK && nowM == want) return want;
+    DmPadGroups t;
+    if (dm_pad_try_mated(sc, draft, k, want, want, &t)) { *out = t; if (mate) *mate = want; return want; }   // together
+    #define DM_PAD_MATE_LOW(s) ((s) < nowM ? (s) : nowM)
+    if (!dm_pad_try_mated(sc, draft, k, nowK, DM_PAD_MATE_LOW(nowK), &t)) {   // its mirrored place has no room (Mirror turned on after a move on its own)
+        int got = dm_pad_try_size(sc, draft, k, want, out);
+        if (mate) *mate = got;
+        return got;
+    }
+    int good = nowK, bad = want;
+    if (dm_pad_try_mated(sc, draft, k, want, DM_PAD_MATE_LOW(want), &t)) good = want;
+    else while (abs(bad - good) > 1) { int mid = (good + bad) / 2; if (dm_pad_try_mated(sc, draft, k, mid, DM_PAD_MATE_LOW(mid), &t)) good = mid; else bad = mid; }
+    int lo = DM_PAD_MATE_LOW(good), best = lo;
+    #undef DM_PAD_MATE_LOW
+    if (dm_pad_try_mated(sc, draft, k, good, lo, &t)) *out = t;
+    if (lo < good) {   // the mirror image as large as it has room for, up to k's size
+        if (dm_pad_try_mated(sc, draft, k, good, good, &t)) { best = good; *out = t; }
+        else {
+            int g2 = lo, b2 = good;
+            while (abs(b2 - g2) > 1) { int mid = (g2 + b2) / 2; if (dm_pad_try_mated(sc, draft, k, good, mid, &t)) { g2 = mid; *out = t; } else b2 = mid; }
+            best = g2;
+        }
+    }
+    if (mate) *mate = best;
+    return good;
+}
+// k's mirror image is as large as k, or the largest it has room for (one percent more does not fit): what a size leaves.
+static inline BOOL dm_pad_mate_maxed(const DmPadScene *sc, const DmPadGroups *draft, int k) {
+    int nowM = dm_pad_mate_size(sc, draft, k);
+    if (nowM < 0) return YES;
+    int nowK = dm_pad_place_now(sc, draft, k).size;
+    DmPadGroups t;
+    return nowM >= nowK || nowM >= DM_PAD_SIZE_MAX || !dm_pad_try_mated(sc, draft, k, nowK, nowM + 1, &t);
+}
+// The mirror image is why group k cannot go to p (where k on its own would fit): what the editor says on a spot it refuses.
+static inline BOOL dm_pad_mate_blocks(const DmPadScene *sc, const DmPadGroups *draft, int k, DmPadPlace p) {
+    if (!dm_pad_linked(sc, draft, k)) return NO;
+    DmPadGroups solo = *draft, t;
+    solo.solo[dm_pad_scene_set(sc)] = 1;
+    return dm_pad_try_place(sc, &solo, k, p, &t);
+}
+
+// All controls' size (percent of what DM_TOUCH_SIZE gives) for the layout on screen: the largest between the size now and want (kept within
+// dm_pad_all_min to DM_PAD_ALL_MAX) at which the base layout takes that size (DM_TOUCH_SIZE's fallback leaves it) and every group placed now stays
+// placed. Returns the size it got, and the draft in out.
+static inline BOOL dm_pad_all_fits(const DmPadScene *sc, const DmPadGroups *t, unsigned placed) {
+    int set = dm_pad_scene_set(sc);
+    DmPadGeo g = dm_pad_scene_geo(sc, t);
+    CGFloat base = sc->o.scale > 0 ? sc->o.scale : 1, want = base * (t->all[set] ? t->all[set] : 100) / 100.0;
+    CGFloat u0 = dm_pad_base_unit(sc->bounds, sc->insets, sc->layout);
+    return fabs(g.u - u0 * want) < 1e-9 && (g.groupMoved & placed) == placed;
+}
+static inline int dm_pad_try_all(const DmPadScene *sc, const DmPadGroups *draft, int want, DmPadGroups *out) {
+    int set = dm_pad_scene_set(sc);
+    *out = *draft;
+    int now = dm_pad_all_now(sc, draft);
+    want = dm_pad_clampi(want, dm_pad_all_min(sc, draft), DM_PAD_ALL_MAX);
+    unsigned placed = dm_pad_scene_geo(sc, draft).groupMoved;
+    DmPadGroups t = *draft;
+    t.all[set] = (short)(want == 100 ? 0 : want);
+    if (dm_pad_all_fits(sc, &t, placed)) { *out = t; return want; }
+    int good = now, bad = want;
+    while (abs(bad - good) > 1) {
+        int mid = (good + bad) / 2;
+        t.all[set] = (short)(mid == 100 ? 0 : mid);
+        if (dm_pad_all_fits(sc, &t, placed)) { good = mid; *out = t; } else bad = mid;
+    }
+    return good;
+}
+// Every group of the layout on screen back at its built-in place and size, all controls at 100 (Mirror left and right is kept).
+static inline void dm_pad_groups_reset(DmPadGroups *d, int set) { memset(d->place[set], 0, sizeof d->place[set]); d->all[set] = 0; }
+
+// The drawn group at p: the nearest one whose box, grown by slop, holds p; -1 for none.
+static inline int dm_pad_group_at(const DmPadGeo *g, BOOL full, CGPoint p, CGFloat slop) {
+    int best = -1; CGFloat bd = CGFLOAT_MAX;
+    for (int k = 0; k < DM_PAD_G_N; k++) {
+        if (!dm_pad_group_drawn(k, full)) continue;
+        CGRect b = dm_pad_group_box(g, full, k, NULL);
+        if (CGRectIsNull(b) || !CGRectContainsPoint(CGRectInset(b, -slop, -slop), p)) continue;
+        CGFloat d = hypot(p.x - CGRectGetMidX(b), p.y - CGRectGetMidY(b));
+        if (d < bd) { bd = d; best = k; }
+    }
+    return best;
+}
+// Group k (and its mirror image where linked, at size sizeM; below 0: k's size) drawn at p however it fits: what a drag shows under the finger on a
+// spot the editor refuses.
+static inline DmPadGeo dm_pad_preview_places(const DmPadScene *sc, const DmPadGroups *draft, int k, DmPadPlace p, int sizeM) {
+    int set = dm_pad_scene_set(sc);
+    unsigned edited;
+    DmPadGroups t = dm_pad_with_places(sc, draft, k, p, sizeM, &edited), rest = *draft;
+    for (int j = 0; j < DM_PAD_G_N; j++) if (edited & (1u << j)) rest.place[set][j].size = 0;
+    DmPadGeo g = dm_pad_scene_geo(sc, &rest);
+    for (int j = 0; j < DM_PAD_G_N; j++) if ((edited & (1u << j)) && dm_pad_group_drawn(j, sc->full)) {
+        const DmPadPlace *q = &t.place[set][j];
+        CGFloat s = dm_pad_group_scale(&g, sc->full, sc->layout.separated, j, q->size);
+        dm_pad_group_apply(&g, sc->full, sc->layout.separated, j, s, q->x / (CGFloat)DM_PAD_ANCHOR_MAX, q->y / (CGFloat)DM_PAD_ANCHOR_MAX);
+    }
+    return g;
+}
+static inline DmPadGeo dm_pad_preview(const DmPadScene *sc, const DmPadGroups *draft, int k, DmPadPlace p) { return dm_pad_preview_places(sc, draft, k, p, -1); }
+
+// ---- Where Done saves: every game's layout or this game's own (in the shell) ----
+// The editor shows what Done saves for the scope picked. The draft begins as the value in effect (the scope the game had: its own, or every game's).
+// Picking the other scope keeps the layouts the player changed and the one on screen (picked while looking at it: "Save for" saves what it shows) and
+// takes the others from what that scope holds, so a save for every game from a game with a layout of its own replaces only those in every game's
+// value, and the other way round. "Reset to default" › "Same as All games" (this game) shows every game's value and has Done forget the game's own.
+enum { DM_PAD_SCOPE_ALL = 0, DM_PAD_SCOPE_GAME = 1 };
+// The layouts (1 << DM_PAD_SET_*) in which two values differ.
+static inline unsigned dm_pad_groups_diff(const DmPadGroups *a, const DmPadGroups *b) {
+    unsigned d = 0;
+    for (int s = 0; s < DM_PAD_SET_N; s++)
+        if (memcmp(a->place[s], b->place[s], sizeof a->place[s]) || a->all[s] != b->all[s] || a->solo[s] != b->solo[s]) d |= 1u << s;
+    return d;
+}
+// base, with the layouts in sets taken from from.
+static inline DmPadGroups dm_pad_groups_merge(const DmPadGroups *base, const DmPadGroups *from, unsigned sets) {
+    DmPadGroups r = *base;
+    for (int s = 0; s < DM_PAD_SET_N; s++) if (sets & (1u << s)) { memcpy(r.place[s], from->place[s], sizeof r.place[s]); r.all[s] = from->all[s]; r.solo[s] = from->solo[s]; }
+    return r;
+}
+// What a scope holds for the editor that opened on scope opened with the value atOpen in effect: that value for the scope it opened on; for this
+// game when it followed every game's, its own if one is stored (stored1), else every game's in effect (its own starts there, as the shell's
+// This game does); for every game when the game had its own, every game's stored (stored0), else the built-in layout. NULL: nothing stored.
+static inline DmPadGroups dm_pad_scope_value(int scope, int opened, const DmPadGroups *atOpen, const DmPadGroups *_Nullable stored0, const DmPadGroups *_Nullable stored1) {
+    if (scope == opened) return *atOpen;
+    if (scope == DM_PAD_SCOPE_GAME) return stored1 ? *stored1 : *atOpen;
+    DmPadGroups none; memset(&none, 0, sizeof none);
+    return stored0 ? *stored0 : none;
+}
+// The draft once the player picked another scope (oldValue and newValue: what the two hold), the layout on screen being onScreen.
+static inline DmPadGroups dm_pad_scope_draft(const DmPadGroups *draft, const DmPadGroups *oldValue, const DmPadGroups *newValue, int onScreen) {
+    return dm_pad_groups_merge(newValue, draft, dm_pad_groups_diff(draft, oldValue) | 1u << onScreen);
+}
+// What Done does: SAVE the draft for the scope; NOTHING when it is what the scope holds and the scope is the one the editor opened on; FOLLOW when
+// it is what every game's holds and the game had a layout of its own: the game forgets its own (and follows every game's, which stays as it is).
+// A draft that is what this game's holds when the game followed every game's is saved: the game gets a layout of its own, as picked.
+enum { DM_PAD_DONE_NOTHING = 0, DM_PAD_DONE_SAVE, DM_PAD_DONE_FOLLOW };
+static inline int dm_pad_done(int scope, int opened, const DmPadGroups *draft, const DmPadGroups *scopeValue) {
+    if (dm_pad_groups_diff(draft, scopeValue)) return DM_PAD_DONE_SAVE;
+    if (scope == opened) return DM_PAD_DONE_NOTHING;
+    return scope == DM_PAD_SCOPE_ALL ? DM_PAD_DONE_FOLLOW : DM_PAD_DONE_SAVE;
+}
+
+// ---- The editor's fingers ----
+// Which finger moves the chosen group, and when two fingers are a pinch, as UIKit's touches come down, move and lift (DmGamepad.m passes them):
+// - a touch on the panel is the panel's (its controls, its title's drag), never the editor's;
+// - a finger that comes down on a group (within DM_PAD_TOUCH_SLOP) chooses it and moves it once it has gone DM_PAD_DRAG_SLOP from where it came
+//   down, so the first finger of a pinch does not drag the group first; it takes the chosen group over from a finger that has not moved it yet;
+// - a finger that comes down elsewhere chooses none, unless another finger holds a group: a thumb resting on the screen leaves a drag alone;
+// - a pinch begins only on two fingers that came down near one group (DM_PAD_PINCH_SLOP), never on a drag and a finger resting elsewhere. When the
+//   finger that moved the group and the other came down within DM_PAD_PINCH_JOIN seconds, they were one pinch from the start: the group goes back
+//   to where it was before that finger moved it.
+enum { DM_PAD_FINGERS = 10 };
+static const CGFloat DM_PAD_TOUCH_SLOP = 16, DM_PAD_PINCH_SLOP = 32, DM_PAD_DRAG_SLOP = 8;   // points
+static const double DM_PAD_PINCH_JOIN = 0.5;   // seconds
+typedef struct { uintptr_t id; int nearby; double t0; } DmPadFinger;   // a finger down: the group it came down near (-1: none), when
+typedef struct {
+    DmPadFinger f[DM_PAD_FINGERS]; int n;   // the fingers down, the panel's left out
+    uintptr_t drag; CGPoint dragFrom;       // the finger that holds the chosen group (0: none) and where it came down
+    BOOL moving;                            // it has gone past DM_PAD_DRAG_SLOP: the group follows it
+    BOOL pinch;                             // a pinch has the fingers
+} DmPadFingers;
+enum { DM_PAD_FINGER_NONE = 0, DM_PAD_FINGER_CHOOSE, DM_PAD_FINGER_MOVE, DM_PAD_FINGER_DROP };
+static inline int dm_pad_finger_index(const DmPadFingers *s, uintptr_t id) {
+    for (int i = 0; i < s->n; i++) if (s->f[i].id == id) return i;
+    return -1;
+}
+// A finger down at p at time t: on group (DM_PAD_TOUCH_SLOP; -1: none), near group nearby (DM_PAD_PINCH_SLOP; -1: none), on the panel.
+// CHOOSE: the editor chooses what is under the finger (the group, or none). NONE: nothing changes.
+static inline int dm_pad_finger_down(DmPadFingers *s, uintptr_t id, CGPoint p, int group, int nearby, BOOL panel, double t) {
+    if (panel || !id || dm_pad_finger_index(s, id) >= 0 || s->n >= DM_PAD_FINGERS) return DM_PAD_FINGER_NONE;
+    s->f[s->n++] = (DmPadFinger){id, group >= 0 ? group : nearby, t};
+    if (s->pinch || (s->drag && s->moving)) return DM_PAD_FINGER_NONE;   // a pinch has the fingers, or a drag goes on
+    if (group < 0) return s->drag ? DM_PAD_FINGER_NONE : DM_PAD_FINGER_CHOOSE;
+    s->drag = id; s->dragFrom = p; s->moving = NO;
+    return DM_PAD_FINGER_CHOOSE;
+}
+// The finger moved to p. MOVE: it holds the chosen group and has gone past DM_PAD_DRAG_SLOP: the group follows it (from where it came down).
+static inline int dm_pad_finger_moved(DmPadFingers *s, uintptr_t id, CGPoint p) {
+    if (!id || id != s->drag || s->pinch) return DM_PAD_FINGER_NONE;
+    if (!s->moving && hypot(p.x - s->dragFrom.x, p.y - s->dragFrom.y) <= DM_PAD_DRAG_SLOP) return DM_PAD_FINGER_NONE;
+    s->moving = YES;
+    return DM_PAD_FINGER_MOVE;
+}
+// The finger lifted, or the system took it. DROP: it had moved the chosen group (the group stays at the last spot that fits).
+static inline int dm_pad_finger_up(DmPadFingers *s, uintptr_t id) {
+    int i = dm_pad_finger_index(s, id), r = DM_PAD_FINGER_NONE;
+    if (i >= 0) s->f[i] = s->f[--s->n];
+    if (id && id == s->drag) { r = s->moving ? DM_PAD_FINGER_DROP : DM_PAD_FINGER_NONE; s->drag = 0; s->moving = NO; }
+    return r;
+}
+// Whether a pinch may begin: the fingers down that came down near a group are two, near the same one (*group). *restore: the finger that holds
+// it moved it and the two came down within DM_PAD_PINCH_JOIN seconds. Asks nothing of the fingers (UIKit may ask more than once).
+static inline BOOL dm_pad_pinch_check(const DmPadFingers *s, int *group, BOOL *restore) {
+    int a = -1, b = -1;
+    for (int i = 0; i < s->n; i++) {
+        if (s->f[i].nearby < 0) continue;
+        if (a < 0) a = i; else if (b < 0) b = i; else return NO;
+    }
+    if (b < 0 || s->f[a].nearby != s->f[b].nearby) return NO;
+    *group = s->f[a].nearby;
+    *restore = s->drag && s->moving && (s->f[a].id == s->drag || s->f[b].id == s->drag) && fabs(s->f[a].t0 - s->f[b].t0) <= DM_PAD_PINCH_JOIN;
+    return YES;
+}
+// The pinch began: no finger holds the group, and a finger that comes down meanwhile does nothing; and it ended.
+static inline void dm_pad_pinch_on(DmPadFingers *s) { s->pinch = YES; s->drag = 0; s->moving = NO; }
+static inline void dm_pad_pinch_off(DmPadFingers *s) { s->pinch = NO; }
+
+// ---- The editor's words ----
+// DM_PAD_EDIT_TEXT carries them in the player's language, one per line in this order (the shell passes it at launch; in an env file the lines are joined
+// by a backslash and n). A line that is missing or empty stays English. The groups' names are their keys' (ZL L L3 ...), but for the stick and the D-pad.
+// A newer line is added at the end. MATE_FULL and MATE_NO_ROOM follow a group's name and a colon ("Left stick: No more room to grow": the mirror
+// image stopped while the chosen group grew on; "Left stick: No room there while mirrored": the spot is refused for the mirror image's sake).
+// BUILT_IN and FOLLOW are what "Reset to default" offers for this game: the layout on screen built in, or this game's layout the same as every game's.
+enum { DM_PAD_TEXT_TITLE = 0, DM_PAD_TEXT_HINT, DM_PAD_TEXT_CHOOSE, DM_PAD_TEXT_ALL, DM_PAD_TEXT_MIRROR, DM_PAD_TEXT_SAVE_FOR, DM_PAD_TEXT_ALL_GAMES,
+       DM_PAD_TEXT_THIS_GAME, DM_PAD_TEXT_RESET, DM_PAD_TEXT_CANCEL, DM_PAD_TEXT_DONE, DM_PAD_TEXT_NO_ROOM, DM_PAD_TEXT_STICK, DM_PAD_TEXT_DPAD,
+       DM_PAD_TEXT_SMALLER, DM_PAD_TEXT_LARGER, DM_PAD_TEXT_UP, DM_PAD_TEXT_DOWN, DM_PAD_TEXT_LEFT, DM_PAD_TEXT_RIGHT, DM_PAD_TEXT_MATE_FULL,
+       DM_PAD_TEXT_MATE_NO_ROOM, DM_PAD_TEXT_BUILT_IN, DM_PAD_TEXT_FOLLOW, DM_PAD_TEXT_N };
+static const char *_Nonnull const dm_pad_text_english[DM_PAD_TEXT_N] = {
+    "Adjust Gamepad Layout", "Drag a group to move it. Pinch it or use the slider to resize it.", "Tap a group to choose it", "All controls",
+    "Mirror left and right", "Save for", "All games", "This game", "Reset to default", "Cancel", "Done", "No room there", "Left stick", "D-pad",
+    "Smaller", "Larger", "Move up", "Move down", "Move left", "Move right", "No more room to grow", "No room there while mirrored", "Built-in layout",
+    "Same as All games",
+};
+static inline void dm_pad_text(const char *_Nullable env, int i, char *_Nonnull out, size_t cap) {
+    if (!cap) return;
+    out[0] = 0;
+    if (i < 0 || i >= DM_PAD_TEXT_N) return;
+    const char *s = env; int line = 0;
+    while (s && *s && line < i) {   // a line ends at a newline or at a backslash and n
+        if (*s == '\n') { line++; s++; }
+        else if (s[0] == '\\' && s[1] == 'n') { line++; s += 2; }
+        else s++;
+    }
+    size_t n = 0;
+    if (s && line == i) {
+        while (*s == ' ') s++;
+        const char *e = s;
+        while (*e && *e != '\n' && !(e[0] == '\\' && e[1] == 'n')) e++;
+        while (e > s && e[-1] == ' ') e--;
+        n = (size_t)(e - s);
+    }
+    if (!n) { snprintf(out, cap, "%s", dm_pad_text_english[i]); return; }
+    if (n >= cap) n = cap - 1;
+    memcpy(out, s, n); out[n] = 0;
+}
+// A group's name in the editor: its keys, or the stick's and the D-pad's words.
+static inline void dm_pad_group_title(int k, BOOL full, const char *_Nullable env, char *_Nonnull out, size_t cap) {
+    switch (k) {
+    case DM_PAD_G_LEFT: snprintf(out, cap, "%s", full ? "ZL L L3" : "ZL L"); break;
+    case DM_PAD_G_RIGHT: snprintf(out, cap, "%s", full ? "ZR R R3" : "ZR R"); break;
+    case DM_PAD_G_STICK: dm_pad_text(env, DM_PAD_TEXT_STICK, out, cap); break;
+    case DM_PAD_G_DPAD: dm_pad_text(env, DM_PAD_TEXT_DPAD, out, cap); break;
+    case DM_PAD_G_FACE: snprintf(out, cap, "%s", "A B X Y"); break;
+    default: snprintf(out, cap, "%s", "\xE2\x88\x92 +"); break;   // − +
+    }
+}
+
+// ---- The self-test (DM_PAD_LAYOUT_TEST=1) ----
+// Control c's frame in g (its shapes' box; for the diamond the four keys), CGRectNull when it is not drawn.
+static inline CGRect dm_pad_control_frame(const DmPadGeo *g, BOOL full, int c) {
+    DmPadShape s[20]; int n = dm_pad_shapes(g, full, s);
+    CGFloat x0 = CGFLOAT_MAX, y0 = CGFLOAT_MAX, x1 = -CGFLOAT_MAX, y1 = -CGFLOAT_MAX; BOOL any = NO;
+    for (int i = 0; i < n; i++) if (dm_pad_is_shape_of(s[i].id, c)) {
+        CGRect b = dm_pad_shape_box(&s[i]); any = YES;
+        x0 = fmin(x0, CGRectGetMinX(b)); y0 = fmin(y0, CGRectGetMinY(b)); x1 = fmax(x1, CGRectGetMaxX(b)); y1 = fmax(y1, CGRectGetMaxY(b));
+    }
+    return any ? CGRectMake(x0, y0, x1 - x0, y1 - y0) : CGRectNull;
+}
+// The points the self-test touches: each drawn shape's centre and four points halfway to its edge (a pill along its length), as the geometry check does.
+static inline int dm_pad_hit_points(const DmPadGeo *g, BOOL full, CGPoint *_Nonnull pts, int *_Nonnull ids, int max) {
+    DmPadShape sh[20]; int n = dm_pad_shapes(g, full, sh), np = 0;
+    for (int i = 0; i < n; i++) {
+        if (sh[i].id >= DM_PAD_SHAPE_TIP && sh[i].id < DM_PAD_SHAPE_CLICK) continue;   // a teardrop's tip is a point
+        CGPoint c = sh[i].isRect ? CGPointMake(CGRectGetMidX(sh[i].rect), CGRectGetMidY(sh[i].rect)) : sh[i].c;
+        CGPoint p[5]; int k = 0; p[k++] = c;
+        if (sh[i].isRect) { CGFloat w = sh[i].rect.size.width * 0.3; p[k++] = CGPointMake(c.x - w, c.y); p[k++] = CGPointMake(c.x + w, c.y); }
+        else {
+            CGFloat r = sh[i].id == DM_PAD_SHAPE_DPAD ? g->dpadR * 0.6 : sh[i].r * 0.5;
+            p[k++] = CGPointMake(c.x + r, c.y); p[k++] = CGPointMake(c.x - r, c.y); p[k++] = CGPointMake(c.x, c.y + r); p[k++] = CGPointMake(c.x, c.y - r);
+        }
+        for (int j = 0; j < k && np < max; j++) { pts[np] = p[j]; ids[np] = sh[i].id; np++; }
+    }
+    return np;
+}
+// Who takes a touch-down at p, as DmGamepad.m decides it (the menu button first): DM_PAD_HIT_* + 16 * (the locked key + 1), or 1000 for the menu.
+static inline int dm_pad_who(const DmPadGeo *g, BOOL full, BOOL sep, CGPoint p) {
+    if (dm_pad_menu_takes(g, full, sep, p)) return 1000;
+    DmPadHit h = dm_pad_hit(g, full, sep, NO, YES, p);
+    return h.kind + 16 * (h.key + 1);
+}
+// What a shape id should take: the control it belongs to, as dm_pad_who names it.
+static inline int dm_pad_who_of_shape(int id) {
+    if (id < DM_PAD_SHAPE_STICK) return DM_PAD_HIT_FACE;
+    if (id == DM_PAD_SHAPE_STICK) return DM_PAD_HIT_STICK;
+    if (id == DM_PAD_SHAPE_DPAD) return DM_PAD_HIT_DPAD;
+    if (id >= DM_PAD_SHAPE_DROP && id < DM_PAD_SHAPE_TIP) return DM_PAD_HIT_KEY + 16 * (DM_PAD_C_ZL + (id - DM_PAD_SHAPE_DROP) + 1);
+    if (id >= DM_PAD_SHAPE_CLICK && id < DM_PAD_SHAPE_PILL) return DM_PAD_HIT_KEY + 16 * (DM_PAD_C_L3 + (id - DM_PAD_SHAPE_CLICK) + 1);
+    if (id >= DM_PAD_SHAPE_PILL && id < DM_PAD_SHAPE_SWAP) return DM_PAD_HIT_KEY + 16 * (DM_PAD_C_MINUS + (id - DM_PAD_SHAPE_PILL) + 1);
+    return 1000;
+}
+// The self-test's comparison of two geometries (the edited one and the one read back from the saved value): every control's frame the same (within
+// 0.01 point), and every touch point of a gives the same control in both and is taken by the control it lies in. Returns the number of points; *bad
+// the number that failed (frames that differ count as failures too).
+static inline int dm_pad_hit_compare(const DmPadGeo *a, const DmPadGeo *b, BOOL full, BOOL sep, int *_Nonnull bad) {
+    *bad = 0;
+    for (int c = 0; c < DM_PAD_C_N; c++) {
+        CGRect fa = dm_pad_control_frame(a, full, c), fb = dm_pad_control_frame(b, full, c);
+        if (CGRectIsNull(fa) != CGRectIsNull(fb)) { (*bad)++; continue; }
+        if (!CGRectIsNull(fa) && (fabs(fa.origin.x - fb.origin.x) > 0.01 || fabs(fa.origin.y - fb.origin.y) > 0.01
+                                  || fabs(fa.size.width - fb.size.width) > 0.01 || fabs(fa.size.height - fb.size.height) > 0.01)) (*bad)++;
+    }
+    CGPoint pts[128]; int ids[128], n = dm_pad_hit_points(a, full, pts, ids, 128);
+    for (int i = 0; i < n; i++) {
+        int wa = dm_pad_who(a, full, sep, pts[i]), wb = dm_pad_who(b, full, sep, pts[i]);
+        if (wa != wb || wa != dm_pad_who_of_shape(ids[i])) (*bad)++;
+    }
+    return n;
+}
