+// An 11-inch iPad Pro held sideways in 3D, top row lowered: the whole top row lowered in one drag, A B X Y and the stick larger, saved and read back;
+// then the same value on every other screen still gives a valid layout.
+static void check_ipad_top_row_lowered(void) {
+    DmPadScene sc = scene(&k_screens[IPAD11], YES, 1, 0, NULL);
+    DmPadGroups d; memset(&d, 0, sizeof d);
+    DmPadGeo g = dm_pad_scene_geo(&sc, &d);
+    CGPoint c = g.at[DM_PAD_G_LEFT]; c.y += 250;
+    DmPadGroups t;
+    if (!dm_pad_try_place(&sc, &d, DM_PAD_G_LEFT, dm_pad_place_at(&g, DM_PAD_G_LEFT, 100, c, DM_PAD_SNAP), &t)) FAIL("iPad Pro 11: the top row could not come down 250 points");
+    d = t;
+    g = dm_pad_scene_geo(&sc, &d);
+    if (fabs(g.drop[DM_PAD_ZL].y - 250 - (24 + 40 * 1.3)) > 1 || !near(g.drop[DM_PAD_ZR].y, g.drop[DM_PAD_ZL].y) || !near(g.click[1].y, g.click[0].y))
+        FAIL("iPad Pro 11: ZL at %.1f, ZR at %.1f after the drag", g.drop[DM_PAD_ZL].y, g.drop[DM_PAD_ZR].y);
+    // A B X Y larger: mirrored, the stick grows with them until it meets the D-pad; on their own they reach what was asked.
+    int mirrored = dm_pad_try_size(&sc, &d, DM_PAD_G_FACE, 115, &t);
+    if (!(mirrored > 100 && mirrored < 115) || t.place[DM_PAD_SET_3D][DM_PAD_G_STICK].size != mirrored)
+        FAIL("iPad Pro 11: A B X Y and the stick, mirrored, grew to %d (the stick %d)", mirrored, t.place[DM_PAD_SET_3D][DM_PAD_G_STICK].size);
+    d.solo[DM_PAD_SET_3D] = 1;
+    if (dm_pad_try_size(&sc, &d, DM_PAD_G_FACE, 115, &t) != 115 || t.place[DM_PAD_SET_3D][DM_PAD_G_STICK].size) FAIL("iPad Pro 11: A B X Y on their own could not grow to 115 %%");
+    d = t;
+    char v[DM_PAD_GROUPS_MAX + 1]; dm_pad_groups_encode(&d, v, sizeof v);
+    printf("iPad Pro 11, top row lowered: %s\n", v);
+    DmPadGroups back; dm_pad_groups_parse(v, &back);
+    DmPadGeo a = dm_pad_scene_geo(&sc, &d), b = dm_pad_scene_geo(&sc, &back);
+    int bad, n = dm_pad_hit_compare(&a, &b, YES, NO, &bad);
+    if (bad) FAIL("iPad Pro 11: read back, %d of %d points differ", bad, n);
+    check_geo(&sc, &a, "iPad Pro 11, top row lowered");
+    for (int i = 0; i < N_SCREENS; i++)
+        for (int full = 0; full < 2; full++) {
+            DmPadScene s = scene(&k_screens[i], full, 1, 0, NULL);
+            DmPadGeo h = dm_pad_scene_geo(&s, &back);
+            char what[96]; snprintf(what, sizeof what, "%s %s with the iPad's value", k_screens[i].name, full ? "3D" : "2D");
+            check_geo(&s, &h, what);
+            if (full && !s.layout.separated && (h.groupDropped & 3)) printf("  %s: the shoulders keep their built-in place (no room)\n", what);
+        }
+}
