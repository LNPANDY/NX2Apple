+// sides (a rectangle grows with square corners, a circle with round ones, and a teardrop's tip is a point), or by as much as the two groups are
+// apart where they are built in, when that is less.
+static inline BOOL dm_pad_group_fits(const DmPadGeo *g, BOOL full, BOOL sep, int k) {
+    DmPadShape s[20]; int n = dm_pad_shapes(g, full, s);
