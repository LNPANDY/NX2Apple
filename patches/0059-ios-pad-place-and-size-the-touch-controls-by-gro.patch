+        if (dm_pad_shape_group(s[i].id) != k) continue;
+        if (!dm_pad_shape_inside(&s[i])) return NO;
+        for (int j = 0; j < n; j++) {
+            if (j == i) continue;
+            if (dm_pad_shape_group(s[j].id) == k) {
+                if (j > i && !dm_pad_same_control(&s[i], &s[j]) && dm_pad_shapes_overlap(&s[i], &s[j])) return NO;
