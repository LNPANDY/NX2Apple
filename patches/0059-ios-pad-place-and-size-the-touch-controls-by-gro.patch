+            } else if (n == 3 && !strncmp(field, "all", 3)) {
+                if (count != 1 || num[0] < DM_PAD_ALL_MIN || num[0] > DM_PAD_ALL_MAX) return NO;
+                if (set >= 0) r.all[set] = (short)(num[0] == 100 ? 0 : num[0]);
