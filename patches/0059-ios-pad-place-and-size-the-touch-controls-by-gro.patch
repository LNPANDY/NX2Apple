+// A phone held sideways (side insets: the notch or the Dynamic Island sits in the middle of one): the stick, the D-pad and A B X Y moved up or grown
+// past their built-in band keep out of the side insets altogether, while in the band they reach halfway in as built in. An iPad's layout with the
+// stick and A B X Y lifted keeps its anchors on a phone (the proportions) and is moved in off the sides there. iPads move nothing (no side insets).
+static void check_side_insets(void) {
+    int above = 0, inBand = 0;
+    for (int i = 0; i < N_SCREENS; i++) {
+        const Screen *s = &k_screens[i];
+        for (int full = 0; full < 2; full++) {
+            DmPadScene sc = scene(s, full, 1, 0, NULL);
+            if (sc.layout.separated) continue;
+            int set = dm_pad_scene_set(&sc);
+            DmPadGroups none; memset(&none, 0, sizeof none);
+            for (int k = DM_PAD_G_STICK; k <= DM_PAD_G_FACE; k++) {
+                if (!dm_pad_group_drawn(k, full)) continue;
+                static const short sizes[3] = {80, 100, 150};
+                for (int z = 0; z < 3; z++)
+                    for (int ax = 0; ax <= 1000; ax += 250)
+                        for (int ay = 0; ay <= 1000; ay += 125) {
+                            DmPadGroups d = none;
+                            d.place[set][k] = (DmPadPlace){(short)ax, (short)ay, sizes[z]};
+                            d.place[set][DM_PAD_G_LEFT] = (DmPadPlace){0, 1000, 100};   // the shoulders out of the way, to the bottom of their area
+                            d.place[set][DM_PAD_G_RIGHT] = (DmPadPlace){1000, 1000, 100};
+                            DmPadGeo g = dm_pad_scene_geo(&sc, &d);
+                            char what[128]; snprintf(what, sizeof what, "%s %s: %s at %d,%d,%d", s->name, full ? "3D" : "2D", dm_pad_group_names[k], ax, ay, sizes[z]);
+                            check_geo(&sc, &g, what);
+                            if (!(g.groupMoved & (1u << k))) continue;
+                            DmPadShape sh[20]; int n = dm_pad_shapes(&g, full, sh); BOOL up = NO;
+                            for (int j = 0; j < n; j++) {
+                                if (dm_pad_shape_group(sh[j].id) != k) continue;
+                                CGRect b = dm_pad_shape_box(&sh[j]);
+                                if (CGRectGetMinY(b) >= CGRectGetMinY(g.home[k]) - 0.5) continue;
+                                up = YES;
+                                if (CGRectGetMinX(b) < CGRectGetMinX(g.safe) - 0.5 || CGRectGetMaxX(b) > CGRectGetMaxX(g.safe) + 0.5)
+                                    FAIL("%s: shape %d above the band reaches into a side inset (x %.1f to %.1f, safe %.1f to %.1f)", what, sh[j].id, CGRectGetMinX(b), CGRectGetMaxX(b), CGRectGetMinX(g.safe), CGRectGetMaxX(g.safe));
+                            }
+                            if (up) above++; else if (s->insets.left > 0) inBand++;   // in the band: the corner area, as before
+                        }
+            }
+        }
+    }
+    if (!above || !inBand) FAIL("side insets: nothing checked (%d above the band, %d in it)", above, inBand);
+    // The island measured on a Pro Max held sideways (x 11 to 48, y 152 to 278 of 932 x 430): the stick lifted to the middle stays clear of it.
+    DmPadScene pm = scene(&k_screens[3], NO, 1, 0, NULL);
+    DmPadGroups d; memset(&d, 0, sizeof d);
+    DmPadGeo g = dm_pad_scene_geo(&pm, &d);
+    for (short ay = 0; ay <= 1000; ay += 25) {   // as high as it goes below the shoulders, at the left edge
+        d.place[DM_PAD_SET_2D][DM_PAD_G_STICK] = (DmPadPlace){0, ay, 100};
+        g = dm_pad_scene_geo(&pm, &d);
+        if (g.groupMoved & (1u << DM_PAD_G_STICK)) break;
+    }
+    if (!(g.groupMoved & (1u << DM_PAD_G_STICK)) || g.stick.y - g.stickR > 278) FAIL("Pro Max: the stick could not be lifted beside the island");
+    else if (g.stick.x - g.stickR < 59 - 0.5 || (g.stick.x - g.stickR < 48 && g.stick.y + g.stickR > 152 && g.stick.y - g.stickR < 278))
+        FAIL("Pro Max: the lifted stick's ring (x %.1f to %.1f, y %.1f to %.1f) is by the island", g.stick.x - g.stickR, g.stick.x + g.stickR, g.stick.y - g.stickR, g.stick.y + g.stickR);
+    printf("side insets: %d placements above the band, %d in it; Pro Max stick lifted: ring x %.1f to %.1f, y %.1f to %.1f\n", above, inBand,
+           g.stick.x - g.stickR, g.stick.x + g.stickR, g.stick.y - g.stickR, g.stick.y + g.stickR);
+    // An iPad's value (the shoulders lowered, the stick and A B X Y lifted, A B X Y larger) on the phones: same anchors, inside the safe area's sides.
+    const char *ipad = "1;3d/lshoulder:21,421,100/rshoulder:979,421,100/stick:0,800,100/face:1000,800,110";
+    DmPadGroups iv; if (!dm_pad_groups_parse(ipad, &iv)) FAIL("the iPad's value does not read");
+    for (int i = 1; i <= 4; i++) {
+        DmPadScene sc = scene(&k_screens[i], YES, 1, 0, NULL);
+        DmPadGeo h = dm_pad_scene_geo(&sc, &iv);
+        char what[96]; snprintf(what, sizeof what, "%s with an iPad's value", k_screens[i].name);
+        check_geo(&sc, &h, what);
+        for (int k = DM_PAD_G_STICK; k <= DM_PAD_G_FACE; k += 2) {
+            if (!(h.groupMoved & (1u << k))) { printf("  %s: %s keeps its built-in place (no room)\n", what, dm_pad_group_names[k]); continue; }
+            DmPadPlace now = dm_pad_place_now(&sc, &iv, k);
+            if (now.x != iv.place[DM_PAD_SET_3D][k].x || now.y != iv.place[DM_PAD_SET_3D][k].y) FAIL("%s: %s's anchor changed", what, dm_pad_group_names[k]);
+            DmPadShape sh[20]; int n = dm_pad_shapes(&h, YES, sh);
+            for (int j = 0; j < n; j++) {
+                CGRect b = dm_pad_shape_box(&sh[j]);
+                if (dm_pad_shape_group(sh[j].id) == k && CGRectGetMinY(b) < CGRectGetMinY(h.home[k]) - 0.5
+                    && (CGRectGetMinX(b) < CGRectGetMinX(h.safe) - 0.5 || CGRectGetMaxX(b) > CGRectGetMaxX(h.safe) + 0.5)) FAIL("%s: %s reaches into a side inset", what, dm_pad_group_names[k]);
+            }
+        }
+    }
+}
