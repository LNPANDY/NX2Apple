+            CGFloat w = g.home[DM_PAD_G_STICK].size.width;
+            DmPadPlace e = dm_pad_place_at(&g, DM_PAD_G_STICK, 100, CGPointMake(CGRectGetMinX(g.area[DM_PAD_G_STICK]) + w / 2 + 7, g.at[DM_PAD_G_STICK].y), DM_PAD_SNAP);
+            if (e.x != 0) FAIL("%s: the stick 7 points from the edge did not snap to it (%d)", what, e.x);
+            e = dm_pad_place_at(&g, DM_PAD_G_MID, 100, CGPointMake(CGRectGetMidX(g.area[DM_PAD_G_MID]) + 5, g.at[DM_PAD_G_MID].y), DM_PAD_SNAP);
+            if (e.x != 500) FAIL("%s: the middle 5 points from the centre did not snap to it (%d)", what, e.x);
+            e = dm_pad_place_at(&g, DM_PAD_G_STICK, 100, CGPointMake(-500, -500), DM_PAD_SNAP);
+            if (e.x != 0 || e.y != 0) FAIL("%s: a drag past the corner does not stop at it", what);
+            // The stick onto the diamond: refused, nothing changes.
+            DmPadGeo before = dm_pad_scene_geo(&sc, &d);
+            DmPadPlace onto = dm_pad_place_at(&before, DM_PAD_G_STICK, 100, before.at[DM_PAD_G_FACE], 0);
+            DmPadGroups solo = d; solo.solo[set] = 1;
+            if (dm_pad_try_place(&sc, &solo, DM_PAD_G_STICK, onto, &t)) FAIL("%s: the stick was let onto the diamond", what);
+            DmPadGeo pv = dm_pad_preview(&sc, &solo, DM_PAD_G_STICK, onto);
+            if (fabs(pv.at[DM_PAD_G_STICK].x - before.at[DM_PAD_G_FACE].x) > 1) FAIL("%s: the refused spot is not drawn under the finger", what);
+            // A size: the largest that fits, between the size now and the one asked for.
+            int got = dm_pad_try_size(&sc, &d, DM_PAD_G_FACE, 200, &t);
+            if (got < 100 || got > 200) FAIL("%s: the diamond's size %d", what, got);
+            DmPadGeo hg = dm_pad_scene_geo(&sc, &t);
+            if (got > 100 && (!(hg.groupMoved & 1u << DM_PAD_G_FACE) || !near(hg.gs[DM_PAD_G_FACE], got / 100.0))) FAIL("%s: the diamond is not at %d %%", what, got);
+            if (got < 200) {
+                DmPadPlace more = dm_pad_place_now(&sc, &t, DM_PAD_G_FACE); more.size = (short)(got + 2);
+                DmPadGroups x;
+                if (dm_pad_try_place(&sc, &t, DM_PAD_G_FACE, more, &x)) FAIL("%s: the diamond stopped at %d %% but %d %% fits", what, got, got + 2);
+            }
+            check_geo(&sc, &hg, what);
+            d = t;
+            int small = dm_pad_try_size(&sc, &d, DM_PAD_G_FACE, 10, &t);
+            if (small != dm_pad_size_min(&sc, &d, DM_PAD_G_FACE)) FAIL("%s: the smallest diamond is %d, not its floor %d", what, small, dm_pad_size_min(&sc, &d, DM_PAD_G_FACE));
+            // All controls.
+            got = dm_pad_try_all(&sc, &d, 120, &t);
+            if (got < 100 || got > 120) FAIL("%s: all controls at %d", what, got);
+            hg = dm_pad_scene_geo(&sc, &t);
+            check_geo(&sc, &hg, what);
+            // Saved and read back: the same frames, and every touch to the same control.
+            char v[DM_PAD_GROUPS_MAX + 1]; DmPadGroups back;
+            if (!dm_pad_groups_encode(&t, v, sizeof v) || !dm_pad_groups_parse(v, &back)) FAIL("%s: the draft does not save ('%s')", what, v);
+            DmPadGeo rg = dm_pad_scene_geo(&sc, &back);
+            int bad, n = dm_pad_hit_compare(&hg, &rg, full, sc.layout.separated, &bad);
+            if (bad || n < 40) FAIL("%s: read back, %d of %d touch points differ", what, bad, n);
+            // Reset: every group of this layout back, the other layouts kept.
+            DmPadGroups r = t; r.place[set ^ 1][DM_PAD_G_FACE] = (DmPadPlace){1, 2, 100};
+            dm_pad_groups_reset(&r, set);
+            DmPadGeo rs = dm_pad_scene_geo(&sc, &r);
+            DmPadGroups none; memset(&none, 0, sizeof none);
+            DmPadGeo built = dm_pad_scene_geo(&sc, &none);
+            if (!geo_identical(&rs, &built) || r.place[set ^ 1][DM_PAD_G_FACE].x != 1) FAIL("%s: reset is not the built-in layout, or touched another layout", what);
+        }
+}
