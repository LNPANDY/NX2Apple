+// ---- All controls never take a touch target under 44 points ----
+// The smallest touch target radius of group k as drawn (as dm_pad_group_floor measures it, with the group's own size in the − and + margins).
+static CGFloat group_target(const DmPadGeo *g, BOOL full, BOOL sep, int k) {
+    switch (k) {
+    case DM_PAD_G_LEFT: case DM_PAD_G_RIGHT: {
+        int i = k == DM_PAD_G_LEFT ? DM_PAD_ZL : DM_PAD_ZR;
+        CGFloat r = fmin(MAX(g->dropR[i] * 1.35, sep ? 22 : 0), MAX(g->dropR[i + 1] * 1.35, sep ? 22 : 0));
+        return full ? fmin(r, MAX(g->clickR[k] * 1.35, sep ? 22 : 0)) : r;
+    }
+    case DM_PAD_G_STICK: return g->stickR;
+    case DM_PAD_G_DPAD: return g->dpadR;
+    case DM_PAD_G_FACE: return g->faceHitR;
+    default: {
+        CGFloat r = fmin(g->pill[0].size.height, g->pill[1].size.height) / 2 + 8 * g->u * g->gs[DM_PAD_G_MID];
+        if (sep) r = MAX(r, 14);
+        return fmin(r, MAX(g->swapR * 1.6, 22));
+    }
+    }
+}
+// All controls at 50 %, alone and with every group at its smallest size, on every screen, layout, size and stick place: no touch target under 44
+// points across, nor under the built-in one where that already is (− and + on an iPhone held sideways); the editor offers from that size up.
+static void check_all_floor(void) {
+    int checked = 0;
+    for (int i = 0; i < N_SCREENS; i++)
+        for (int full = 0; full < 2; full++)
+            for (int z = 0; z < 3; z++)
+                for (int st = 0; st < 3; st++) {
+                    DmPadScene sc = scene(&k_screens[i], full, dm_pad_size_scale(k_sizes[z]), st, NULL);
+                    int set = dm_pad_scene_set(&sc);
+                    BOOL sep = sc.layout.separated;
+                    char what[128]; snprintf(what, sizeof what, "%s %s %s stick %d", k_screens[i].name, full ? "3D" : "2D", k_sizes[z], st);
+                    DmPadGroups none; memset(&none, 0, sizeof none);
+                    DmPadGeo built = dm_pad_scene_geo(&sc, &none);
+                    DmPadGroups d = none, t;
+                    int lo = dm_pad_all_min(&sc, &none), got = dm_pad_try_all(&sc, &none, 50, &t);
+                    if (got < lo || lo < DM_PAD_ALL_MIN || lo > 100) FAIL("%s: all controls at 50 %% gave %d, the floor is %d", what, got, lo);
+                    d = t;
+                    DmPadGroups smallest = d; smallest.solo[set] = 1;
+                    for (int k = 0; k < DM_PAD_G_N; k++) if (dm_pad_group_drawn(k, full)) { dm_pad_try_size_mated(&sc, &smallest, k, 10, &t, NULL); smallest = t; }
+                    DmPadGroups asked = none; asked.all[set] = 50;   // a value asking for less than the floor (one saved before it) is drawn at the floor
+                    const DmPadGroups *cases[3] = {&d, &smallest, &asked};
+                    for (int c = 0; c < 3; c++) {
+                        DmPadGeo g = dm_pad_scene_geo(&sc, cases[c]);
+                        for (int k = 0; k < DM_PAD_G_N; k++) {
+                            if (!dm_pad_group_drawn(k, full)) continue;
+                            CGFloat r = group_target(&g, full, sep, k), r0 = group_target(&built, full, sep, k);
+                            if (r < fmin(DM_PAD_TARGET_MIN, r0) - 0.01) FAIL("%s case %d: %s's touch target is %.1f points across (built in %.1f)", what, c, dm_pad_group_names[k], 2 * r, 2 * r0);
+                        }
+                        check_geo(&sc, &g, what);
+                        checked++;
+                    }
+                    if (dm_pad_all_now(&sc, &asked) != lo) FAIL("%s: a saved 50 %% is not shown at the floor %d", what, lo);
+                }
+    // The 11-inch iPad held sideways goes down to 77 % (− and + then 44 points tall); an iPhone held sideways at the medium size keeps 100.
+    DmPadGroups none; memset(&none, 0, sizeof none);
+    DmPadScene ip = scene(&k_screens[IPAD11], YES, 1, 0, NULL), pm = scene(&k_screens[3], YES, 1, 0, NULL);
+    if (dm_pad_all_min(&ip, &none) != 77 || dm_pad_all_min(&pm, &none) != 100) FAIL("all controls' floor: iPad Pro 11 %d, Pro Max %d", dm_pad_all_min(&ip, &none), dm_pad_all_min(&pm, &none));
+    printf("all controls' floor: %d layouts, every touch target 44 points or the built-in one\n", checked);
+}
+
+// ---- Mirror left and right when one side has less room ----
+// On an 11-inch iPad held sideways in 3D with Mirror on, A B X Y asked at 150 %: the stick meets the D-pad near 109 %, where the two sized together
+// stop; A B X Y goes on alone to 150 % and the stick stays as large as it has room for. Back down, the stick follows. A drag of A B X Y then moves
+// the stick along at its own size (the stick at A B X Y's size had no room anywhere). The stick asked larger stops at its room, A B X Y with it.
+// A spot refused only for the mirror image's sake is told apart (dm_pad_mate_blocks), and taken with the halves on their own.
+static void check_mirror_room(void) {
+    DmPadScene sc = scene(&k_screens[IPAD11], YES, 1, 0, NULL);
+    DmPadGroups d, t; memset(&d, 0, sizeof d);
+    int strict = dm_pad_try_size(&sc, &d, DM_PAD_G_FACE, 150, &t);
+    int mate = 0, got = dm_pad_try_size_mated(&sc, &d, DM_PAD_G_FACE, 150, &t, &mate);
+    if (!(strict > 100 && strict < 115) || got != 150 || mate != strict || !dm_pad_mate_maxed(&sc, &t, DM_PAD_G_FACE))
+        FAIL("iPad Pro 11 mirrored: A B X Y at 150 asked gave %d with the stick at %d (together they stop at %d)", got, mate, strict);
+    DmPadGeo g = dm_pad_scene_geo(&sc, &t);
+    if (!near(g.gs[DM_PAD_G_FACE], 1.5) || !near(g.gs[DM_PAD_G_STICK], mate / 100.0) || (g.groupDropped & (1u << DM_PAD_G_STICK)))
+        FAIL("iPad Pro 11 mirrored: drawn at %.2f and %.2f", g.gs[DM_PAD_G_FACE], g.gs[DM_PAD_G_STICK]);
+    check_geo(&sc, &g, "iPad Pro 11 A B X Y past the stick");
+    printf("mirror: A B X Y at %d %%, the stick at %d %% (sized together they stopped at %d %%)\n", got, mate, strict);
+    d = t;
+    // A drag of A B X Y up by 60 points: the stick along at its own size, mirrored. With the stick at A B X Y's size it had no room.
+    DmPadGeo cur = dm_pad_scene_geo(&sc, &d);
+    DmPadPlace up = dm_pad_place_at(&cur, DM_PAD_G_FACE, 150, CGPointMake(cur.at[DM_PAD_G_FACE].x, cur.at[DM_PAD_G_FACE].y - 60), 0);
+    DmPadGroups moved;
+    if (!dm_pad_try_places(&sc, &d, DM_PAD_G_FACE, up, dm_pad_mate_size(&sc, &d, DM_PAD_G_FACE), &moved)) FAIL("iPad Pro 11 mirrored: A B X Y could not move up 60 points");
+    else {
+        DmPadGeo h = dm_pad_scene_geo(&sc, &moved);
+        if (dm_pad_place_now(&sc, &moved, DM_PAD_G_STICK).size != mate || !(h.at[DM_PAD_G_STICK].y < cur.at[DM_PAD_G_STICK].y - 30))
+            FAIL("iPad Pro 11 mirrored: the stick did not go along at its size (%d, y %.1f to %.1f)", dm_pad_place_now(&sc, &moved, DM_PAD_G_STICK).size,
+                 cur.at[DM_PAD_G_STICK].y, h.at[DM_PAD_G_STICK].y);
+        check_geo(&sc, &h, "iPad Pro 11 A B X Y moved, the stick along");
+    }
+    if (dm_pad_try_place(&sc, &d, DM_PAD_G_FACE, up, &t)) FAIL("iPad Pro 11 mirrored: the stick at 150 %% fitted after all (the case is moot)");
+    // Back to 100: the stick follows down.
+    got = dm_pad_try_size_mated(&sc, &d, DM_PAD_G_FACE, 100, &t, &mate);
+    if (got != 100 || mate != 100 || dm_pad_place_now(&sc, &t, DM_PAD_G_STICK).size != 100) FAIL("iPad Pro 11 mirrored: back to 100 gave %d, the stick %d", got, mate);
+    // The stick asked larger: it stops at its room, A B X Y with it.
+    memset(&d, 0, sizeof d);
+    got = dm_pad_try_size_mated(&sc, &d, DM_PAD_G_STICK, 150, &t, &mate);
+    if (got != strict || mate != strict) FAIL("iPad Pro 11 mirrored: the stick at 150 asked gave %d, A B X Y %d (not %d)", got, mate, strict);
+    // A spot refused for the stick's sake: A B X Y dragged inward sends the stick toward the D-pad.
+    cur = dm_pad_scene_geo(&sc, &d);
+    BOOL found = NO;
+    for (int dx = 5; dx <= 300 && !found; dx += 5) {
+        DmPadPlace p = dm_pad_place_at(&cur, DM_PAD_G_FACE, 100, CGPointMake(cur.at[DM_PAD_G_FACE].x - dx, cur.at[DM_PAD_G_FACE].y), 0);
+        if (dm_pad_try_places(&sc, &d, DM_PAD_G_FACE, p, dm_pad_mate_size(&sc, &d, DM_PAD_G_FACE), &t)) continue;
+        if (!dm_pad_mate_blocks(&sc, &d, DM_PAD_G_FACE, p)) break;   // A B X Y itself has no room: not this case
+        DmPadGroups solo = d; solo.solo[DM_PAD_SET_3D] = 1;
+        if (!dm_pad_try_place(&sc, &solo, DM_PAD_G_FACE, p, &t)) FAIL("iPad Pro 11: A B X Y on its own did not take the spot its mirror image had no room for");
+        found = YES;
+    }
+    if (!found) FAIL("iPad Pro 11: no spot was refused for the stick's sake (dragging A B X Y inward)");
+}
+
+// ---- Where Done saves ----
+static DmPadGroups groups_value(const char *v) {
+    DmPadGroups g;
+    if (!dm_pad_groups_parse(v, &g)) FAIL("'%s' does not read", v);
+    return g;
+}
+static BOOL same_set(const DmPadGroups *a, const DmPadGroups *b, int set) { return !(dm_pad_groups_diff(a, b) & (1u << set)); }
+// A layout tuned for every game in 2D and in portrait 3D (in another game), and a game whose own layout was copied from every game's earlier and has its
+// own 3D since. In that game the player lowers the top row (3D, on screen) and picks All games: every game's value takes 3D and keeps its 2D and its
+// portrait (the whole draft saved, as before, would have put the game's old copies there). Picked without a change, All games saves the layout on
+// screen and keeps the rest; "Same as All games" forgets the game's own; the other way round (This game from every game's) keeps every game's value
+// as it is and gives the game its own; nothing changed, nothing is saved.
+static void check_scopes(void) {
+    DmPadGroups all = groups_value("1;2d/face:900,900,120;3d/lshoulder:0,300,100/rshoulder:1000,300,100;3s/stick:0,1000,120");
+    DmPadGroups own = groups_value("1;2d/face:500,500,100;3d/lshoulder:0,600,100/rshoulder:1000,600,100;3s/stick:0,1000,100");
+    DmPadScene sc = scene(&k_screens[IPAD11], YES, 1, 0, NULL);
+    int set = dm_pad_scene_set(&sc);
+    if (set != DM_PAD_SET_3D) FAIL("scopes: the scene is not 3D landscape");
+    DmPadGroups vGame = dm_pad_scope_value(DM_PAD_SCOPE_GAME, DM_PAD_SCOPE_GAME, &own, &all, &own);
+    DmPadGroups vAll = dm_pad_scope_value(DM_PAD_SCOPE_ALL, DM_PAD_SCOPE_GAME, &own, &all, &own);
+    if (dm_pad_groups_diff(&vGame, &own) || dm_pad_groups_diff(&vAll, &all)) FAIL("scopes: what the scopes hold");
+    // The edit: the top row lowered (the right shoulders follow, mirrored).
+    DmPadGroups draft = own, t;
+    DmPadPlace p = draft.place[set][DM_PAD_G_LEFT]; p.y = 450;
+    if (!dm_pad_try_places(&sc, &draft, DM_PAD_G_LEFT, p, dm_pad_mate_size(&sc, &draft, DM_PAD_G_LEFT), &t)) FAIL("scopes: the top row could not go down");
+    draft = t;
+    DmPadGroups naive = draft;   // what the whole draft saved for every game gave before
+    draft = dm_pad_scope_draft(&draft, &vGame, &vAll, set);
+    if (!same_set(&draft, &all, DM_PAD_SET_2D) || !same_set(&draft, &all, DM_PAD_SET_3D_SPLIT) || !same_set(&draft, &t, DM_PAD_SET_3D)
+        || !same_set(&draft, &all, DM_PAD_SET_2D_SPLIT))
+        FAIL("scopes: picking All games did not keep every game's other layouts and this edit");
+    if (dm_pad_done(DM_PAD_SCOPE_ALL, DM_PAD_SCOPE_GAME, &draft, &vAll) != DM_PAD_DONE_SAVE) FAIL("scopes: Done does not save for every game");
+    if (same_set(&naive, &all, DM_PAD_SET_2D) || same_set(&naive, &all, DM_PAD_SET_3D_SPLIT)) FAIL("scopes: the case is moot (the old copies were the same)");
+    // Back to This game: what the game holds, with the edit.
+    DmPadGroups back = dm_pad_scope_draft(&draft, &vAll, &vGame, set);
+    if (dm_pad_groups_diff(&back, &t)) FAIL("scopes: back to This game is not the game's own layout with the edit");
+    // All games picked with no change: the layout on screen (the game's 3D) goes to every game's, the rest stays.
+    draft = dm_pad_scope_draft(&own, &vGame, &vAll, set);
+    if (dm_pad_groups_diff(&draft, &all) != (1u << DM_PAD_SET_3D) || !same_set(&draft, &own, DM_PAD_SET_3D)) FAIL("scopes: All games without a change");
+    // An edit in another layout (rotated to portrait and back): kept too.
+    draft = own; draft.place[DM_PAD_SET_3D_SPLIT][DM_PAD_G_FACE] = (DmPadPlace){1000, 1000, 120};
+    draft = dm_pad_scope_draft(&draft, &vGame, &vAll, set);
+    if (dm_pad_groups_diff(&draft, &all) != (1u << DM_PAD_SET_3D | 1u << DM_PAD_SET_3D_SPLIT) || draft.place[DM_PAD_SET_3D_SPLIT][DM_PAD_G_FACE].size != 120
+        || !same_set(&draft, &all, DM_PAD_SET_2D)) FAIL("scopes: an edit in portrait is not kept, or 2D is not every game's");
+    // Same as All games: every game's value shown, Done forgets the game's own and changes nothing else.
+    if (dm_pad_done(DM_PAD_SCOPE_ALL, DM_PAD_SCOPE_GAME, &vAll, &vAll) != DM_PAD_DONE_FOLLOW) FAIL("scopes: Same as All games does not follow");
+    // Nothing changed: nothing saved. A reset that leaves what is stored: nothing either.
+    if (dm_pad_done(DM_PAD_SCOPE_GAME, DM_PAD_SCOPE_GAME, &own, &vGame) != DM_PAD_DONE_NOTHING) FAIL("scopes: Done with no change saves");
+    // The other way: the game follows every game's; This game picked after an edit in 3D: the game's own is every game's with the edit, every game's
+    // value is not touched; picked without an edit: the game gets a copy of every game's (as the shell's This game row does).
+    DmPadGroups fAll = dm_pad_scope_value(DM_PAD_SCOPE_ALL, DM_PAD_SCOPE_ALL, &all, &all, NULL);
+    DmPadGroups fGame = dm_pad_scope_value(DM_PAD_SCOPE_GAME, DM_PAD_SCOPE_ALL, &all, &all, NULL);
+    draft = all; p = draft.place[set][DM_PAD_G_LEFT]; p.y = 450;
+    if (!dm_pad_try_places(&sc, &draft, DM_PAD_G_LEFT, p, dm_pad_mate_size(&sc, &draft, DM_PAD_G_LEFT), &t)) FAIL("scopes: the top row could not go down (2)");
+    draft = dm_pad_scope_draft(&t, &fAll, &fGame, set);
+    if (dm_pad_groups_diff(&draft, &t) || dm_pad_done(DM_PAD_SCOPE_GAME, DM_PAD_SCOPE_ALL, &draft, &fGame) != DM_PAD_DONE_SAVE) FAIL("scopes: This game after an edit");
+    if (dm_pad_done(DM_PAD_SCOPE_GAME, DM_PAD_SCOPE_ALL, &fGame, &fGame) != DM_PAD_DONE_SAVE) FAIL("scopes: This game without an edit does not give the game its own");
+    // A stored own value while the game followed every game's (a stale one): This game starts from it.
+    DmPadGroups sGame = dm_pad_scope_value(DM_PAD_SCOPE_GAME, DM_PAD_SCOPE_ALL, &all, &all, &own);
+    draft = dm_pad_scope_draft(&t, &fAll, &sGame, set);
+    if (!same_set(&draft, &own, DM_PAD_SET_2D) || !same_set(&draft, &t, DM_PAD_SET_3D)) FAIL("scopes: This game with a stored own value");
+    // Every game's with nothing stored is the built-in layout.
+    DmPadGroups empty = dm_pad_scope_value(DM_PAD_SCOPE_ALL, DM_PAD_SCOPE_GAME, &own, NULL, &own);
+    if (dm_pad_groups_count(&empty) || empty.all[set]) FAIL("scopes: every game's with nothing stored");
+}
+
+// ---- The editor's fingers ----
+static DmPadFingers g_fingers;
+static const DmPadGeo *g_fgeo;
+static int finger_down(uintptr_t id, CGPoint p, BOOL panel, double t) {
+    int k = panel ? -1 : dm_pad_group_at(g_fgeo, YES, p, DM_PAD_TOUCH_SLOP), nearby = panel ? -1 : k >= 0 ? k : dm_pad_group_at(g_fgeo, YES, p, DM_PAD_PINCH_SLOP);
+    return dm_pad_finger_down(&g_fingers, id, p, k, nearby, panel, t);
+}
+static CGPoint offset(CGPoint p, CGFloat dx, CGFloat dy) { return CGPointMake(p.x + dx, p.y + dy); }
+// On an 11-inch iPad in 3D: a touch on the panel never reaches the editor, even over a group; the right thumb drags the right shoulders while the left
+// thumb rests on the picture or on the stick, whichever came first, and no pinch begins; a pinch begins on two fingers near one group, and puts the
+// group back when its first finger had moved it at the pinch's start; a finger moves the group only past the slop.
+static void check_fingers(void) {
+    DmPadScene sc = scene(&k_screens[IPAD11], YES, 1, 0, NULL);
+    DmPadGroups none; memset(&none, 0, sizeof none);
+    DmPadGeo g = dm_pad_scene_geo(&sc, &none);
+    g_fgeo = &g;
+    CGPoint shoulders = g.at[DM_PAD_G_RIGHT], face = g.at[DM_PAD_G_FACE], stick = g.at[DM_PAD_G_STICK], picture = CGPointMake(380, 470);
+    if (dm_pad_group_at(&g, YES, picture, DM_PAD_PINCH_SLOP) >= 0 || dm_pad_group_at(&g, YES, shoulders, DM_PAD_TOUCH_SLOP) != DM_PAD_G_RIGHT)
+        FAIL("fingers: the points are not where the case needs them");
+    int k; BOOL restore;
+    // The panel: over the right shoulders, nothing at all.
+    memset(&g_fingers, 0, sizeof g_fingers);
+    if (finger_down(1, shoulders, YES, 0) != DM_PAD_FINGER_NONE || dm_pad_finger_moved(&g_fingers, 1, offset(shoulders, 0, 80)) != DM_PAD_FINGER_NONE
+        || dm_pad_finger_up(&g_fingers, 1) != DM_PAD_FINGER_NONE || g_fingers.drag || g_fingers.n) FAIL("fingers: a touch on the panel reached the editor");
+    // The left thumb rests on the picture first, then the right thumb drags the shoulders.
+    memset(&g_fingers, 0, sizeof g_fingers);
+    if (finger_down(1, picture, NO, 0) != DM_PAD_FINGER_CHOOSE) FAIL("fingers: a finger on no group does not choose none");
+    if (finger_down(2, shoulders, NO, 1) != DM_PAD_FINGER_CHOOSE) FAIL("fingers: the right thumb does not take the shoulders while the left one rests");
+    if (dm_pad_finger_moved(&g_fingers, 2, offset(shoulders, 0, 5)) != DM_PAD_FINGER_NONE) FAIL("fingers: the group moved within the slop");
+    if (dm_pad_finger_moved(&g_fingers, 2, offset(shoulders, 0, 40)) != DM_PAD_FINGER_MOVE) FAIL("fingers: the drag does not follow past the slop");
+    if (dm_pad_pinch_check(&g_fingers, &k, &restore)) FAIL("fingers: a pinch on a drag and a thumb resting on the picture");
+    if (dm_pad_finger_up(&g_fingers, 1) != DM_PAD_FINGER_NONE || dm_pad_finger_moved(&g_fingers, 2, offset(shoulders, 0, 60)) != DM_PAD_FINGER_MOVE
+        || dm_pad_finger_up(&g_fingers, 2) != DM_PAD_FINGER_DROP) FAIL("fingers: the resting thumb lifting disturbed the drag");
+    // The right thumb drags first; the left thumb then rests on the picture, or on the stick: the drag goes on, no pinch.
+    for (int other = 0; other < 2; other++) {
+        memset(&g_fingers, 0, sizeof g_fingers);
+        finger_down(1, shoulders, NO, 0);
+        dm_pad_finger_moved(&g_fingers, 1, offset(shoulders, 0, 30));
+        if (finger_down(2, other ? stick : picture, NO, 1) != DM_PAD_FINGER_NONE) FAIL("fingers: a resting thumb (%d) changed the choice during a drag", other);
+        if (dm_pad_pinch_check(&g_fingers, &k, &restore)) FAIL("fingers: a pinch on a drag and a thumb resting elsewhere (%d)", other);
+        if (dm_pad_finger_moved(&g_fingers, 2, offset(other ? stick : picture, 30, 0)) != DM_PAD_FINGER_NONE
+            || dm_pad_finger_moved(&g_fingers, 1, offset(shoulders, 0, 90)) != DM_PAD_FINGER_MOVE) FAIL("fingers: the drag stopped for a resting thumb (%d)", other);
+    }
+    // The left thumb rests on the stick first (it holds it, unmoved), the right thumb then takes the shoulders and drags them.
+    memset(&g_fingers, 0, sizeof g_fingers);
+    finger_down(1, stick, NO, 0);
+    if (finger_down(2, shoulders, NO, 3) != DM_PAD_FINGER_CHOOSE || dm_pad_finger_moved(&g_fingers, 1, offset(stick, 40, 0)) != DM_PAD_FINGER_NONE
+        || dm_pad_finger_moved(&g_fingers, 2, offset(shoulders, 0, 40)) != DM_PAD_FINGER_MOVE) FAIL("fingers: a thumb resting on the stick kept the drag");
+    // A pinch: two fingers near A B X Y within half a second; the first had moved the group: back where it was. A second finger two seconds into a
+    // drag: the drag stays where it took the group.
+    for (int late = 0; late < 2; late++) {
+        memset(&g_fingers, 0, sizeof g_fingers);
+        finger_down(1, face, NO, 10);
+        dm_pad_finger_moved(&g_fingers, 1, offset(face, -20, 0));
+        finger_down(2, offset(face, 30, 30), NO, late ? 12 : 10.2);
+        if (!dm_pad_pinch_check(&g_fingers, &k, &restore) || k != DM_PAD_G_FACE || restore != !late) FAIL("fingers: a pinch on A B X Y (%d): %d, restore %d", late, k, restore);
+        dm_pad_pinch_on(&g_fingers);
+        if (finger_down(3, shoulders, NO, 13) != DM_PAD_FINGER_NONE || dm_pad_finger_moved(&g_fingers, 1, offset(face, -60, 0)) != DM_PAD_FINGER_NONE)
+            FAIL("fingers: a finger during a pinch did something");
+        dm_pad_finger_up(&g_fingers, 1); dm_pad_finger_up(&g_fingers, 2); dm_pad_finger_up(&g_fingers, 3);
+        dm_pad_pinch_off(&g_fingers);
+        if (finger_down(4, shoulders, NO, 14) != DM_PAD_FINGER_CHOOSE) FAIL("fingers: no choice after the pinch");
+    }
+    // A pinch's first finger that stays within the slop does not move the group, and the pinch begins with nothing to put back.
+    memset(&g_fingers, 0, sizeof g_fingers);
+    finger_down(1, face, NO, 20);
+    if (dm_pad_finger_moved(&g_fingers, 1, offset(face, 6, 0)) != DM_PAD_FINGER_NONE) FAIL("fingers: the first finger of a pinch moved the group");
+    finger_down(2, offset(face, 40, 0), NO, 20.1);
+    if (!dm_pad_pinch_check(&g_fingers, &k, &restore) || restore) FAIL("fingers: a pinch from the start");
+    // Two fingers near different groups, or three near groups: no pinch. A finger the list has no room for is ignored.
+    memset(&g_fingers, 0, sizeof g_fingers);
+    finger_down(1, face, NO, 0); finger_down(2, stick, NO, 0);
+    if (dm_pad_pinch_check(&g_fingers, &k, &restore)) FAIL("fingers: a pinch across two groups");
+    memset(&g_fingers, 0, sizeof g_fingers);
+    finger_down(1, face, NO, 0); finger_down(2, offset(face, 20, 0), NO, 0); finger_down(3, offset(face, -20, 0), NO, 0);
+    if (dm_pad_pinch_check(&g_fingers, &k, &restore)) FAIL("fingers: a pinch on three fingers");
+    memset(&g_fingers, 0, sizeof g_fingers);
+    for (uintptr_t i = 1; i <= DM_PAD_FINGERS + 2; i++) finger_down(i, picture, NO, 0);
+    if (g_fingers.n != DM_PAD_FINGERS || dm_pad_finger_up(&g_fingers, DM_PAD_FINGERS + 2) != DM_PAD_FINGER_NONE) FAIL("fingers: more fingers than the list holds");
+}
+
+int main(void) {
+    check_values();
+    check_identity();
+    check_placement();
+    check_editor();
+    check_ipad_top_row_lowered();
+    check_side_insets();
+    check_all_floor();
+    check_mirror_room();
+    check_scopes();
+    check_fingers();
+    if (!g_fail) printf("ok: %d geometries checked\n", g_checked);
+    return g_fail > 100 ? 100 : g_fail;
+}
diff --git a/dm/ios/tests/pad_geometry/portable/UIKit/UIKit.h b/dm/ios/tests/pad_geometry/portable/UIKit/UIKit.h
new file mode 100644
index 0000000..b757e07
--- /dev/null
+++ b/dm/ios/tests/pad_geometry/portable/UIKit/UIKit.h
@@ -0,0 +1,120 @@
+// The UIKit, Foundation and Core Graphics names DmLayout.h and DmPadGeometry.h use, in plain C, so their pure geometry builds and runs where
+// Apple's frameworks are not (a Linux machine or CI: test_pad_geometry.py). The functions follow Core Graphics: a rectangle is standardized
+// first, the null rectangle sits at infinity, an intersection that is empty is the null rectangle, containment of a point is half open.
+// On the Mac the test builds against the real frameworks (pad_geometry/UIKit/UIKit.h) instead.
+#pragma once
+#include <float.h>
+#include <math.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef __clang__
+#define _Nullable
+#define _Nonnull
+#define _Null_unspecified
+#define NS_ASSUME_NONNULL_BEGIN
+#define NS_ASSUME_NONNULL_END
+#else
+#define NS_ASSUME_NONNULL_BEGIN _Pragma("clang assume_nonnull begin")
+#define NS_ASSUME_NONNULL_END _Pragma("clang assume_nonnull end")
+#endif
+
+// Foundation's MIN and MAX: each argument evaluated once, the comparison in the arguments' own types.
+#define MIN(A, B) ({ __typeof__(A) dm_min_a = (A); __typeof__(B) dm_min_b = (B); dm_min_a < dm_min_b ? dm_min_a : dm_min_b; })
+#define MAX(A, B) ({ __typeof__(A) dm_max_a = (A); __typeof__(B) dm_max_b = (B); dm_max_a < dm_max_b ? dm_max_b : dm_max_a; })
+
+typedef bool BOOL;
+#define YES true
+#define NO false
+
+typedef double CGFloat;
+#define CGFLOAT_MAX DBL_MAX
+typedef struct { CGFloat x, y; } CGPoint;
+typedef struct { CGFloat width, height; } CGSize;
+typedef struct { CGPoint origin; CGSize size; } CGRect;
+typedef struct UIView UIView;
+
+static const CGPoint CGPointZero = {0, 0};
+static const CGRect CGRectZero = {{0, 0}, {0, 0}};
+#define CGRectNull ((CGRect){{INFINITY, INFINITY}, {0, 0}})
+
+static inline CGPoint CGPointMake(CGFloat x, CGFloat y) { return (CGPoint){x, y}; }
+static inline CGSize CGSizeMake(CGFloat w, CGFloat h) { return (CGSize){w, h}; }
+static inline CGRect CGRectMake(CGFloat x, CGFloat y, CGFloat w, CGFloat h) { return (CGRect){{x, y}, {w, h}}; }
+static inline bool CGRectIsNull(CGRect r) { return isinf(r.origin.x) || isinf(r.origin.y); }
+static inline CGRect CGRectStandardize(CGRect r) {
+    if (CGRectIsNull(r)) return r;
+    if (r.size.width < 0) { r.origin.x += r.size.width; r.size.width = -r.size.width; }
+    if (r.size.height < 0) { r.origin.y += r.size.height; r.size.height = -r.size.height; }
+    return r;
+}
+static inline CGFloat CGRectGetMinX(CGRect r) { return CGRectStandardize(r).origin.x; }
+static inline CGFloat CGRectGetMinY(CGRect r) { return CGRectStandardize(r).origin.y; }
+static inline CGFloat CGRectGetWidth(CGRect r) { return fabs(r.size.width); }
+static inline CGFloat CGRectGetHeight(CGRect r) { return fabs(r.size.height); }
+static inline CGFloat CGRectGetMaxX(CGRect r) { r = CGRectStandardize(r); return r.origin.x + r.size.width; }
+static inline CGFloat CGRectGetMaxY(CGRect r) { r = CGRectStandardize(r); return r.origin.y + r.size.height; }
+static inline CGFloat CGRectGetMidX(CGRect r) { r = CGRectStandardize(r); return r.origin.x + r.size.width / 2; }
+static inline CGFloat CGRectGetMidY(CGRect r) { r = CGRectStandardize(r); return r.origin.y + r.size.height / 2; }
+static inline bool CGRectIsEmpty(CGRect r) { return CGRectIsNull(r) || r.size.width == 0 || r.size.height == 0; }
+static inline bool CGPointEqualToPoint(CGPoint a, CGPoint b) { return a.x == b.x && a.y == b.y; }
+static inline bool CGRectEqualToRect(CGRect a, CGRect b) {
+    if (CGRectIsNull(a) || CGRectIsNull(b)) return CGRectIsNull(a) && CGRectIsNull(b);
+    a = CGRectStandardize(a); b = CGRectStandardize(b);
+    return a.origin.x == b.origin.x && a.origin.y == b.origin.y && a.size.width == b.size.width && a.size.height == b.size.height;
+}
+static inline CGRect CGRectIntersection(CGRect a, CGRect b) {
+    if (CGRectIsNull(a) || CGRectIsNull(b)) return CGRectNull;
+    a = CGRectStandardize(a); b = CGRectStandardize(b);
+    CGFloat x0 = fmax(a.origin.x, b.origin.x), y0 = fmax(a.origin.y, b.origin.y);
+    CGFloat x1 = fmin(a.origin.x + a.size.width, b.origin.x + b.size.width), y1 = fmin(a.origin.y + a.size.height, b.origin.y + b.size.height);
+    if (x1 < x0 || y1 < y0) return CGRectNull;
+    return CGRectMake(x0, y0, x1 - x0, y1 - y0);
+}
+static inline CGRect CGRectUnion(CGRect a, CGRect b) {
+    if (CGRectIsNull(a)) return CGRectStandardize(b);
+    if (CGRectIsNull(b)) return CGRectStandardize(a);
+    a = CGRectStandardize(a); b = CGRectStandardize(b);
+    CGFloat x0 = fmin(a.origin.x, b.origin.x), y0 = fmin(a.origin.y, b.origin.y);
+    CGFloat x1 = fmax(a.origin.x + a.size.width, b.origin.x + b.size.width), y1 = fmax(a.origin.y + a.size.height, b.origin.y + b.size.height);
+    return CGRectMake(x0, y0, x1 - x0, y1 - y0);
+}
+static inline bool CGRectIntersectsRect(CGRect a, CGRect b) {
+    if (CGRectIsNull(a) || CGRectIsNull(b)) return false;
+    a = CGRectStandardize(a); b = CGRectStandardize(b);
+    return fmax(a.origin.x, b.origin.x) < fmin(a.origin.x + a.size.width, b.origin.x + b.size.width)
+        && fmax(a.origin.y, b.origin.y) < fmin(a.origin.y + a.size.height, b.origin.y + b.size.height);
+}
+static inline bool CGRectContainsPoint(CGRect r, CGPoint p) {
+    if (CGRectIsNull(r)) return false;
+    r = CGRectStandardize(r);
+    return p.x >= r.origin.x && p.x < r.origin.x + r.size.width && p.y >= r.origin.y && p.y < r.origin.y + r.size.height;
+}
+static inline bool CGRectContainsRect(CGRect a, CGRect b) {
+    if (CGRectIsNull(a) || CGRectIsNull(b)) return false;
+    a = CGRectStandardize(a); b = CGRectStandardize(b);
+    return b.origin.x >= a.origin.x && b.origin.y >= a.origin.y
+        && b.origin.x + b.size.width <= a.origin.x + a.size.width && b.origin.y + b.size.height <= a.origin.y + a.size.height;
+}
+static inline CGRect CGRectInset(CGRect r, CGFloat dx, CGFloat dy) {
+    if (CGRectIsNull(r)) return r;
+    r = CGRectStandardize(r);
+    r.origin.x += dx; r.origin.y += dy; r.size.width -= 2 * dx; r.size.height -= 2 * dy;
+    return r.size.width < 0 || r.size.height < 0 ? CGRectNull : r;
+}
+static inline CGRect CGRectOffset(CGRect r, CGFloat dx, CGFloat dy) {
+    if (CGRectIsNull(r)) return r;
+    r.origin.x += dx; r.origin.y += dy; return r;
+}
+
+typedef struct { CGFloat top, left, bottom, right; } UIEdgeInsets;
+static const UIEdgeInsets UIEdgeInsetsZero = {0, 0, 0, 0};
+static inline UIEdgeInsets UIEdgeInsetsMake(CGFloat t, CGFloat l, CGFloat b, CGFloat r) { return (UIEdgeInsets){t, l, b, r}; }
+static inline CGRect UIEdgeInsetsInsetRect(CGRect r, UIEdgeInsets i) {
+    r.origin.x += i.left; r.origin.y += i.top; r.size.width -= i.left + i.right; r.size.height -= i.top + i.bottom; return r;
+}
+static inline bool UIEdgeInsetsEqualToEdgeInsets(UIEdgeInsets a, UIEdgeInsets b) { return a.top == b.top && a.left == b.left && a.bottom == b.bottom && a.right == b.right; }
diff --git a/dm/ios/tests/test_pad_geometry.py b/dm/ios/tests/test_pad_geometry.py
