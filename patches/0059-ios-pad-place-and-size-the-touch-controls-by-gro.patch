+static inline CGFloat dm_pad_shape_reach(const DmPadGeo *g, BOOL sep, const DmPadShape *s) {
+    int id = s->id;
+    if ((id >= DM_PAD_SHAPE_DROP && id < DM_PAD_SHAPE_TIP) || (id >= DM_PAD_SHAPE_CLICK && id < DM_PAD_SHAPE_PILL)) return MAX(s->r * 1.35, sep ? 22 : 0) - s->r;
