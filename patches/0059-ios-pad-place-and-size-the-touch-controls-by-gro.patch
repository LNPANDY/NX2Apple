+                    d.place[set][k] = (DmPadPlace){(short)(corner & 1 ? 1000 : 0), (short)(corner & 2 ? 1000 : 0), 100};
+                    DmPadGeo g = dm_pad_scene_geo(&sc, &d);
+                    if (!(g.groupMoved & (1u << k))) continue;   // another group there: checked by the fuzz
+                    CGRect b = dm_pad_group_box(&g, full, k, NULL), a = g.area[k];
