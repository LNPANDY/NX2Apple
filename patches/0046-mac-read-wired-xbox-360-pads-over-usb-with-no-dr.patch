+// A wired Xbox 360 pad read over USB (pad_xusb_mac.h) joins the same registry, slot table and button map as a generic HID pad: its report is decoded already into Switch buttons
+static DMController *controller_for_xusb(xusb_pad *x) {
+    for(DMController *d in g_devices) if(d->xusb==x) return d;
+    return nil;
+}
+static void xusbpad_read(xusb_pad *x) {
+    DMController *d=controller_for_xusb(x); if(!d) return;
+    int32_t s[4]; pad_xusb_sticks(&x->st,s);
+    uint64_t buttons=pad_xusb_buttons(&x->st);
+    d->input=(steam_state){.buttons=buttons,.lx=s[0],.ly=s[1],.rx=s[2],.ry=s[3]};
+    if(d->slot<0 && g_press_to_join && !buttons) return;
+    controller_connect(d); controller_publish(d);
+}
+static void xusbpad_attach(xusb_pad *x) {
+    DMController *d=[DMController new]; d->xusb=x;
+    d.name=@(x->name); d.model=[@"USB / " stringByAppendingString:d.name];
+    controller_load_map(d); [g_devices addObject:d]; xusbpad_read(x);
+}
+static void xusbpad_detach(xusb_pad *x) {
+    DMController *d=controller_for_xusb(x); if(!d) return;
+    controller_disconnect(d); d->xusb=NULL; [g_devices removeObject:d];
+    controller_panel_refresh();
+}
 static int32_t controller_axis(float v) { return (int32_t)(fmaxf(-1, fminf(1, v)) * DM_STICK_MAX); }
 // Main's split Joy-Con decoder keeps each half sideways, with the shared
 // registry owning its slot, mappings and focus gate alongside Steam and GC.
@@ -1289,6 +1316,7 @@ void front_controllers_start(void) {
     joycon_start();
     controllers_changed(nil);
     hidpad_start();
+    xusb_start();
     static const dm_switch2_front s2front={s2pad_attach,s2pad_detach,s2pad_read,s2pad_player,s2pad_blocked};
     dm_switch2_start(&s2front);
     dm_motion_pro_start(controller_pro_changed);
diff --git a/dm/host/pad_xusb.h b/dm/host/pad_xusb.h
new file mode 100644
index 0000000..a849888
--- /dev/null
+++ b/dm/host/pad_xusb.h
@@ -0,0 +1,55 @@
+// Xbox 360 (XUSB) pads over USB, read by pad_xusb_mac.h: one 20-byte input report turned into Switch buttons and sticks. Pure, so tests/t_pad_xusb.c checks it without a pad.
+// Report: byte 0 is 0x00 (input), byte 1 its length 0x14; byte 2 holds the D-pad (bits 0..3: up, down, left, right), Start (4), Back (5) and the stick clicks (6, 7); byte 3 holds
+// LB (0), RB (1), Guide (2), A (4), B (5), X (6), Y (7); bytes 4 and 5 are the left and right triggers (0..255); bytes 6..13 are the left X and Y and the right X and Y, each a
+// little-endian int16 with up positive. Other reports (a 3-byte state message at connect, 0x01 0x03 ...) are not input and are skipped.
+// Buttons by position, as front_mac.m maps GameController (right A, bottom B, top X, left Y): Xbox B is the Switch's A, Xbox A its B, Xbox Y its X and Xbox X its Y.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include "pad_hid.h"   // pad_hid_stick: the round dead zone shared with the other HID pads
+
+#define XUSB_REPORT_LEN 20
+#define XUSB_TRIGGER_PRESS 128   // a trigger past half presses ZL / ZR, as pad_hid_buttons does for a HID trigger
+
+typedef struct { uint8_t b1, b2, lt, rt; int16_t lx, ly, rx, ry; } pad_xusb;
+
+// 1 when r is an input report and s was filled, 0 for anything else (a short report, a state message)
+static int pad_xusb_parse(const uint8_t *r, size_t n, pad_xusb *s) {
+    if (n < XUSB_REPORT_LEN || r[0] != 0x00 || r[1] != 0x14) return 0;
+    s->b1 = r[2]; s->b2 = r[3]; s->lt = r[4]; s->rt = r[5];
+    s->lx = (int16_t)(r[6] | r[7] << 8); s->ly = (int16_t)(r[8] | r[9] << 8);
+    s->rx = (int16_t)(r[10] | r[11] << 8); s->ry = (int16_t)(r[12] | r[13] << 8);
+    return 1;
+}
+
+static uint64_t pad_xusb_buttons(const pad_xusb *s) {
+    uint64_t m = 0;
+    if (s->b1 & 0x01) m |= DM_BTN_UP;
+    if (s->b1 & 0x02) m |= DM_BTN_DOWN;
+    if (s->b1 & 0x04) m |= DM_BTN_LEFT;
+    if (s->b1 & 0x08) m |= DM_BTN_RIGHT;
+    if (s->b1 & 0x10) m |= DM_BTN_PLUS;
+    if (s->b1 & 0x20) m |= DM_BTN_MINUS;
+    if (s->b1 & 0x40) m |= DM_BTN_LS;
+    if (s->b1 & 0x80) m |= DM_BTN_RS;
+    if (s->b2 & 0x01) m |= DM_BTN_L;
+    if (s->b2 & 0x02) m |= DM_BTN_R;
+    if (s->b2 & 0x10) m |= DM_BTN_B;
+    if (s->b2 & 0x20) m |= DM_BTN_A;
+    if (s->b2 & 0x40) m |= DM_BTN_Y;
+    if (s->b2 & 0x80) m |= DM_BTN_X;
+    if (s->lt >= XUSB_TRIGGER_PRESS) m |= DM_BTN_ZL;
+    if (s->rt >= XUSB_TRIGGER_PRESS) m |= DM_BTN_ZR;
+    return m;
+}
+
+static float pad_xusb_norm(int16_t v) { return v < 0 ? v / 32768.0f : v / 32767.0f; }
+static void pad_xusb_sticks(const pad_xusb *s, int32_t o[4]) {   // lx, ly, rx, ry; both pads and the Switch have up positive
+    pad_hid_stick(pad_xusb_norm(s->lx), pad_xusb_norm(s->ly), &o[0], &o[1]);
+    pad_hid_stick(pad_xusb_norm(s->rx), pad_xusb_norm(s->ry), &o[2], &o[3]);
+}
+
+// Whether a USB device may hold an XUSB interface: the vendor-specific class at the device level (Microsoft's pads, the receiver and most third-party pads). Only such a device is
+// opened, so a hub, a disk or a keyboard is never touched
+static int pad_xusb_device_ok(int dev_class, int dev_subclass, int dev_protocol) { return dev_class == 0xff && dev_subclass == 0xff && dev_protocol == 0xff; }
+static int pad_xusb_interface_ok(int cls, int sub, int pro) { return cls == 0xff && sub == 0x5d && pro == 0x01; }
diff --git a/dm/host/pad_xusb_mac.h b/dm/host/pad_xusb_mac.h
new file mode 100644
index 0000000..e653155
--- /dev/null
+++ b/dm/host/pad_xusb_mac.h
@@ -0,0 +1,154 @@
+// Mac: wired Xbox 360 (XUSB) pads that macOS has no driver for, read directly over USB from the host's own process, with no driver, no kernel extension and no entitlement
+// (pad_xusb.h decodes the report). GameController lists only the pads Apple supports and a XUSB pad has no HID interface, so neither GameController nor pad_hid_mac.h sees it.
+// controllers_mac.m owns slots, mappings and focus (xusbpad_attach / xusbpad_detach / xusbpad_read), as for a generic HID pad.
+// Only a device whose class is vendor-specific at the device level (ff/ff/ff) is opened, and then only to claim its XUSB interface (ff/5d/01); a hub, a disk or a keyboard is never
+// touched. A pad that connects without an active configuration (the ones macOS leaves unconfigured) is given its first one. The pad is read with one pending interrupt read on the
+// main run loop, so a USB device that another process has claimed is skipped with a log line and the pad can be read by one process only.
+// Not read: the Xbox 360 wireless receiver (another protocol), the Xbox One pads (ff/47/d0, another protocol), rumble and the player light, the Guide button.
+// DM_XUSB=0 turns this off, DM_XUSB_LOG=1 logs every report that changes.
+#pragma once
+#import <CoreFoundation/CoreFoundation.h>
+#import <IOKit/IOKitLib.h>
+#import <IOKit/IOCFPlugIn.h>
+#import <IOKit/IOMessage.h>
+#import <IOKit/usb/IOUSBLib.h>
+#include "pad_xusb.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct xusb_pad {
+    IOUSBDeviceInterface942 **dev; IOUSBInterfaceInterface942 **intf; CFRunLoopSourceRef src;
+    UInt8 pipe; UInt32 maxp; uint8_t report[64];
+    pad_xusb st; char name[64]; int vid, pid; uint64_t entry; io_object_t interest; struct xusb_pad *next;
+} xusb_pad;
+
+static xusb_pad *g_xusb_pads;
+static IONotificationPortRef g_xusb_port;
+static int g_xusb_log;
+static void xusbpad_attach(xusb_pad *d);
+static void xusbpad_detach(xusb_pad *d);
+static void xusbpad_read(xusb_pad *d);
+
+static int xusb_prop_int(io_service_t s, CFStringRef key, int fallback) {
+    CFTypeRef v = IORegistryEntryCreateCFProperty(s, key, kCFAllocatorDefault, 0); int n = fallback;
+    if (v) { if (CFGetTypeID(v) == CFNumberGetTypeID()) CFNumberGetValue((CFNumberRef)v, kCFNumberIntType, &n); CFRelease(v); }
+    return n;
+}
+static void xusb_prop_str(io_service_t s, CFStringRef key, char *out, size_t n) {
+    CFTypeRef v = IORegistryEntryCreateCFProperty(s, key, kCFAllocatorDefault, 0);
+    if (v) { if (CFGetTypeID(v) == CFStringGetTypeID()) CFStringGetCString((CFStringRef)v, out, (CFIndex)n, kCFStringEncodingUTF8); CFRelease(v); }
+}
+
+// A pad gone (unplugged, or a read that failed): the controller leaves its slot first, then the USB objects are released. The run loop source goes first, so no completion of
+// the aborted read can reach a pad that is being freed.
+static void xusb_drop(xusb_pad *d) {
+    xusbpad_detach(d);
+    for (xusb_pad **p = &g_xusb_pads; *p; p = &(*p)->next) if (*p == d) { *p = d->next; break; }
+    if (d->src) CFRunLoopRemoveSource(CFRunLoopGetMain(), d->src, kCFRunLoopCommonModes);
+    if (d->intf) { (*d->intf)->AbortPipe(d->intf, d->pipe); (*d->intf)->USBInterfaceClose(d->intf); (*d->intf)->Release(d->intf); }
+    if (d->dev) { (*d->dev)->USBDeviceClose(d->dev); (*d->dev)->Release(d->dev); }
+    if (d->interest) IOObjectRelease(d->interest);
+    fprintf(stderr, "xusb: pad '%s' (%04x:%04x) gone\n", d->name, d->vid, d->pid);
+    free(d);
+}
+
+static void xusb_arm(xusb_pad *d);
+static void xusb_done(void *ref, IOReturn result, void *arg0) {
+    xusb_pad *d = ref; UInt32 n = (UInt32)(uintptr_t)arg0;
+    if (result != kIOReturnSuccess) { xusb_drop(d); return; }   // an unplugged pad completes its pending read with an error
+    pad_xusb s;
+    if (pad_xusb_parse(d->report, n, &s)) {
+        if (g_xusb_log && memcmp(&s, &d->st, sizeof s)) fprintf(stderr, "xusb: %04x:%04x b1 %02x b2 %02x lt %u rt %u l(%d,%d) r(%d,%d)\n", d->vid, d->pid, s.b1, s.b2, s.lt, s.rt, s.lx, s.ly, s.rx, s.ry);
+        d->st = s; xusbpad_read(d);
+    }
+    xusb_arm(d);
+}
+static void xusb_arm(xusb_pad *d) {
+    IOReturn r = (*d->intf)->ReadPipeAsync(d->intf, d->pipe, d->report, d->maxp < sizeof d->report ? d->maxp : sizeof d->report, xusb_done, d);
+    if (r != kIOReturnSuccess) { fprintf(stderr, "[RED] xusb: cannot read '%s' (0x%x)\n", d->name, r); xusb_drop(d); }
+}
+
+static void xusb_interest(void *ref, io_service_t svc, natural_t msg, void *arg) {
+    (void)svc; (void)arg;
+    if (msg == kIOMessageServiceIsTerminated) xusb_drop((xusb_pad *)ref);
+}
+
+// One USB device the registry reports: a pad's USB device is opened only after its class says it may hold one, and kept only when it has the XUSB interface
+static void xusb_open(io_service_t svc) {
+    uint64_t entry = 0; IORegistryEntryGetRegistryEntryID(svc, &entry);
+    for (xusb_pad *p = g_xusb_pads; p; p = p->next) if (p->entry == entry) return;
+    if (!pad_xusb_device_ok(xusb_prop_int(svc, CFSTR("bDeviceClass"), -1), xusb_prop_int(svc, CFSTR("bDeviceSubClass"), -1), xusb_prop_int(svc, CFSTR("bDeviceProtocol"), -1))) return;
+    xusb_pad *d = calloc(1, sizeof *d); if (!d) return;
+    d->entry = entry; d->vid = xusb_prop_int(svc, CFSTR("idVendor"), 0); d->pid = xusb_prop_int(svc, CFSTR("idProduct"), 0);
+    xusb_prop_str(svc, CFSTR("USB Product Name"), d->name, sizeof d->name);
+    if (!d->name[0]) snprintf(d->name, sizeof d->name, "USB pad %04x:%04x", d->vid, d->pid);
+    IOCFPlugInInterface **plug = NULL; SInt32 score;
+    kern_return_t kr = IOCreatePlugInInterfaceForService(svc, kIOUSBDeviceUserClientTypeID, kIOCFPlugInInterfaceID, &plug, &score);
+    if (kr != KERN_SUCCESS || !plug) { fprintf(stderr, "xusb: '%s' (%04x:%04x): no USB plug-in (0x%x)\n", d->name, d->vid, d->pid, kr); free(d); return; }
+    (*plug)->QueryInterface(plug, CFUUIDGetUUIDBytes(kIOUSBDeviceInterfaceID942), (LPVOID *)&d->dev); (*plug)->Release(plug);
+    if (!d->dev) { fprintf(stderr, "xusb: '%s' (%04x:%04x): no USB device interface\n", d->name, d->vid, d->pid); free(d); return; }
+    IOReturn r = (*d->dev)->USBDeviceOpen(d->dev);
+    if (r != kIOReturnSuccess) { fprintf(stderr, "xusb: '%s' (%04x:%04x) cannot be opened (0x%x): another process may hold it\n", d->name, d->vid, d->pid, r); (*d->dev)->Release(d->dev); free(d); return; }
+    UInt8 cfg = 0; (*d->dev)->GetConfiguration(d->dev, &cfg);
+    if (!cfg) {
+        IOUSBConfigurationDescriptorPtr cd = NULL;
+        if ((*d->dev)->GetConfigurationDescriptorPtr(d->dev, 0, &cd) == kIOReturnSuccess && cd) (*d->dev)->SetConfiguration(d->dev, cd->bConfigurationValue);
+    }
+    IOUSBFindInterfaceRequest req = { kIOUSBFindInterfaceDontCare, kIOUSBFindInterfaceDontCare, kIOUSBFindInterfaceDontCare, kIOUSBFindInterfaceDontCare };
+    io_iterator_t ifs = 0; io_service_t isvc;
+    if ((*d->dev)->CreateInterfaceIterator(d->dev, &req, &ifs) == kIOReturnSuccess) {
+        while (!d->intf && (isvc = IOIteratorNext(ifs))) {
+            IOCFPlugInInterface **ip = NULL; IOUSBInterfaceInterface942 **c = NULL;
+            if (IOCreatePlugInInterfaceForService(isvc, kIOUSBInterfaceUserClientTypeID, kIOCFPlugInInterfaceID, &ip, &score) == KERN_SUCCESS && ip) {
+                (*ip)->QueryInterface(ip, CFUUIDGetUUIDBytes(kIOUSBInterfaceInterfaceID942), (LPVOID *)&c); (*ip)->Release(ip);
+                UInt8 cls = 0, sub = 0, pro = 0;
+                if (c) { (*c)->GetInterfaceClass(c, &cls); (*c)->GetInterfaceSubClass(c, &sub); (*c)->GetInterfaceProtocol(c, &pro); }
+                if (c && pad_xusb_interface_ok(cls, sub, pro)) d->intf = c; else if (c) (*c)->Release(c);
+            }
+            IOObjectRelease(isvc);
+        }
+        IOObjectRelease(ifs);
+    }
+    if (!d->intf) { if (g_xusb_log) fprintf(stderr, "xusb: '%s' (%04x:%04x) has no XUSB interface\n", d->name, d->vid, d->pid); (*d->dev)->USBDeviceClose(d->dev); (*d->dev)->Release(d->dev); free(d); return; }   // a vendor-specific device that is no XUSB pad: left as it was found
+    if ((*d->intf)->USBInterfaceOpen(d->intf) != kIOReturnSuccess) {
+        fprintf(stderr, "xusb: '%s' (%04x:%04x): the XUSB interface is in use by another process\n", d->name, d->vid, d->pid);
+        (*d->intf)->Release(d->intf); (*d->dev)->USBDeviceClose(d->dev); (*d->dev)->Release(d->dev); free(d); return;
+    }
+    UInt8 neps = 0; (*d->intf)->GetNumEndpoints(d->intf, &neps);
+    for (UInt8 p = 1; p <= neps && !d->pipe; p++) {
+        UInt8 dir, num, tt, iv; UInt16 mp;
+        if ((*d->intf)->GetPipeProperties(d->intf, p, &dir, &num, &tt, &mp, &iv) == kIOReturnSuccess && dir == kUSBIn && tt == kUSBInterrupt) { d->pipe = p; d->maxp = mp; }
+    }
+    if (!d->pipe || (*d->intf)->CreateInterfaceAsyncEventSource(d->intf, &d->src) != kIOReturnSuccess || !d->src) {
+        fprintf(stderr, "[RED] xusb: '%s' (%04x:%04x) has no interrupt IN pipe to read\n", d->name, d->vid, d->pid);
+        (*d->intf)->USBInterfaceClose(d->intf); (*d->intf)->Release(d->intf); (*d->dev)->USBDeviceClose(d->dev); (*d->dev)->Release(d->dev); free(d); return;
+    }
+    CFRunLoopAddSource(CFRunLoopGetMain(), d->src, kCFRunLoopCommonModes);
+    d->next = g_xusb_pads; g_xusb_pads = d;
+    IOServiceAddInterestNotification(g_xusb_port, svc, kIOGeneralInterest, xusb_interest, d, &d->interest);
+    fprintf(stderr, "xusb: pad '%s' (%04x:%04x) is read directly over USB\n", d->name, d->vid, d->pid);
+    xusbpad_attach(d);
+    xusb_arm(d);
+}
+
+static void xusb_matched(void *ref, io_iterator_t it) {
+    (void)ref; io_service_t svc;
+    while ((svc = IOIteratorNext(it))) { if (g_xusb_log) fprintf(stderr, "xusb: USB device %llx matched\n", ({ uint64_t id = 0; IORegistryEntryGetRegistryEntryID(svc, &id); id; })); xusb_open(svc); IOObjectRelease(svc); }
+}
+
+static void xusb_start(void) {
+    const char *e = getenv("DM_XUSB"); if (e && !atoi(e)) return;
+    e = getenv("DM_XUSB_LOG"); g_xusb_log = e && atoi(e);
+    g_xusb_port = IONotificationPortCreate(kIOMainPortDefault); if (!g_xusb_port) return;
+    CFRunLoopAddSource(CFRunLoopGetMain(), IONotificationPortGetRunLoopSource(g_xusb_port), kCFRunLoopCommonModes);
+    CFMutableDictionaryRef m = IOServiceMatching("IOUSBHostDevice"); if (!m) return;
+    // The registry matches the device's class too, so a hub or a disk never reaches xusb_open
+    int v = 0xff; CFNumberRef n = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &v);
+    CFMutableDictionaryRef props = CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(props, CFSTR("bDeviceClass"), n); CFDictionarySetValue(props, CFSTR("bDeviceSubClass"), n); CFDictionarySetValue(props, CFSTR("bDeviceProtocol"), n);
+    CFDictionarySetValue(m, CFSTR(kIOPropertyMatchKey), props); CFRelease(props); CFRelease(n);
+    io_iterator_t it = 0;   // the matching dictionary is consumed
+    if (IOServiceAddMatchingNotification(g_xusb_port, kIOFirstMatchNotification, m, xusb_matched, NULL, &it) != KERN_SUCCESS) return;
+    xusb_matched(NULL, it);   // the pads already connected; a notification's iterator is armed once it is drained
+}
