+
     def test_controller_mapping_capability_without_settings(self):
         self.args.settings = None
         info = pack_app.info_plist(self.args, '26.6', False)
diff --git a/docs/development.md b/docs/development.md
index a400b91317ae271363c2daf9ee7250abbdb8a7f9..d448513a61f69a1ed42c548f56c971aca7eb7aaa 100644
--- a/docs/development.md
+++ b/docs/development.md
@@ -471,6 +471,8 @@ The Mac is the development host. To test or debug a game on the Mac, `--platform
 - the Mac host for the profile into `<id>_build/tools/dmhost`: the compile line of `make -C dm/host GAME=<id> dmhost`, with a provisional or derived profile through `DM_GAMES_DIR` / `DM_GAMES_FIRST` as for the script's other host builds. It is reused while its sources (the chain header `dm/gfx/nvn/dmsh_chain.h` among them), the generated profile header, libvpx and the compiler are unchanged;
 - the button-icon font (`make_ext_font.py`) into `<id>_build/font/`.
 
+For Hogwarts Legacy, an opt-in Mac build can use a separate libopus for the game's 24 kHz mono HardwareOpusDecoder calls. The SDK fallback produced distorted dialogue in the 1.0.5 test. Install libopus and set `HOGWARTS_OPUS_ROOT` to its installation prefix when running the build, for example `HOGWARTS_OPUS_ROOT="$(brew --prefix opus)"`. The prefix must provide `include/opus/opus.h`, `lib/libopus.a` and `COPYING`. The library is linked statically and `--platform mac-app` includes its license. Stereo, other games and iOS keep using the SDK path.
+
 It skips the iOS shaders, the Xcode project and the IPA. For Mario Kart 8 Deluxe that saves about 30,000 iOS shader compiles and the 12 GB IPA. It keeps the extracted files even with `--no-keep-extracted`, because the game runs from them. It needs a Mac with Apple silicon, and it cannot be combined with `--prepare-xcode`. The last line it prints is the command that runs the game, built from the run's own paths (step 5 of [Build by hand (Mac)](#build-by-hand-mac)), for example:
 
 ```
diff --git a/scripts/build_ipa_from_nsp.py b/scripts/build_ipa_from_nsp.py
index 2d88a2240b6d5ebe365f6f7d1f1fc82e585564bd..2f44f0321aba8d68e9de1e22f00c95bd2d70f0da 100755
--- a/scripts/build_ipa_from_nsp.py
+++ b/scripts/build_ipa_from_nsp.py
@@ -1817,12 +1817,27 @@ def decoder_host_key(host):
     return None
 
 
+def mac_opus_root(env, game_id):
+    """The optional static decoder used only by the Hogwarts Mac host."""
+    root = env.get('HOGWARTS_OPUS_ROOT')
+    if game_id != '0100F7E00C70E000' or not root: return None
+    root = Path(root).expanduser().resolve()
+    if any(c.isspace() for c in str(root)):
+        raise BuildError('HOGWARTS_OPUS_ROOT must name a libopus installation at a path without spaces')
+    for file in ('lib/libopus.a', 'include/opus/opus.h', 'COPYING'):
+        if not (root / file).is_file(): raise BuildError(f'HOGWARTS_OPUS_ROOT is missing {root / file}')
+    return root
+
+
 def build_mac_host(repo, out, env, logs, g):
     """The Mac host for the profile, built into out: dm/host's own compile line (make -n) with the output moved, since make takes no target path with spaces and dm/host/dmhost may be another build's.
     Reused when the compile line and its inputs (the source files of HOST_DIRS, the chain header dm/gfx/nvn/dmsh_chain.h among them, the profile header make generates, libvpx, dav1d and the third-party headers, the compiler
     and the macOS SDK) are as at the last build into out. The host runs the game's own arm64 code natively, so an Intel Mac stops here (GitHub issue #54)"""
     if not apple_silicon(): raise BuildError('this step boots the game in the Mac host, which runs the game\'s own arm64 code natively: it needs a Mac with Apple silicon, and this Mac has an Intel processor')
     host = repo / 'dm/host'
+    opus = mac_opus_root(env, g.id)
+    opus_inputs = [('files', [opus / 'lib/libopus.a']), ('tree', opus / 'include/opus')] if opus else []
+    if opus: env = dict(env, HOGWARTS_OPUS_ROOT=str(opus))
     run(['make', '-s', f'PYTHON={sys.executable}', f'GAME={g.id}', f'gen/{g.id}/game_profile.h', 'gen/vpx/libvpx.a', 'gen/dav1d/libdav1d.a', 'host_msl'], logs / 'mac_host_make.log', env=env, cwd=host)
     dry = subprocess.run(['make', '-n', '-B', f'PYTHON={sys.executable}', f'GAME={g.id}', 'dmhost'], env=env, cwd=host, capture_output=True, text=True)
     line = next((l for l in dry.stdout.splitlines() if ' -o dmhost ' in l), None)
@@ -1831,7 +1846,7 @@ def build_mac_host(repo, out, env, logs, g):
     kf, tp = out.with_name(out.name + '.key'), repo / 'dm/third_party'
     srcs = [p for d in HOST_DIRS for p in sorted((repo / d).iterdir()) if p.is_file() and p.suffix in ('.c', '.m', '.h', '.S', '.inc')]
     common = fingerprint(cmd, ('files', [host / f'gen/{g.id}/game_profile.h', host / 'gen/msl-macosx/host_msl_gen.h', host / 'gen/vpx/libvpx.a', host / 'gen/dav1d/libdav1d.a', tp / 'stb_vorbis/stb_vorbis.c']),
-                         ('tree', tp / 'vulkan-headers/include'), ('tree', tp / 'libvpx/vpx'), ('tree', tp / 'dav1d/include'), ('cmd', ['clang', '--version']), ('cmd', ['xcrun', '--show-sdk-build-version']), env=env)
+                         ('tree', tp / 'vulkan-headers/include'), ('tree', tp / 'libvpx/vpx'), ('tree', tp / 'dav1d/include'), *opus_inputs, ('cmd', ['clang', '--version']), ('cmd', ['xcrun', '--show-sdk-build-version']), env=env)
     key = fingerprint(common, ('files', srcs))
     chain = repo / CHAIN_H
     # The decoder serves game bytes before rendering. DMSH_CHAIN selects translated shader libraries and appears in the startup log; it cannot change decompression.
@@ -3037,6 +3052,8 @@ def mac_app(py, repo, out, app, work, game, patched, host, font, msl, aoc, gfx,
     run([py, repo / 'dm/games/settings.py', g.id, patched, control or game / 'control.nacp', settings], logs / 'mac_settings.log', env=dict(env, GFXAPI=gfx, SETTINGS_PLATFORM='mac', DM_LANG=lang))
     cmd = [py, repo / 'dm/mac/pack_app.py', out, '--host', host, '--patched', patched, '--romfs', rfs.source(game), '--msl', lib, '--tables', g.table('shader_map.tsv').parent,
            '--font', font, '--title-id', f'{app:016X}', '--name', name, '--bundle-id', bundle_id, '--lang', lang, '--sign', sign or '-']
+    opus = mac_opus_root(env, g.id)
