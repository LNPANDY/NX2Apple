+# Red Dead Redemption: the NSP script's provisional profile (dm/games/profile_guess.py), checked on the Mac through the opening into Armadillo; render_cond added (README.md)
+# SDK 15.3.2, RAGE (Double Eleven port), NVN
+
+# ---- Identity ----
+title_id	01007820196A6000
+program_id	01007820196A6000
+
+# ---- App ----
+name	Red Dead Redemption
+ipa	RedDeadRedemption.ipa
+app_category	public.app-category.games
+
+# ---- Versions ----
+build	v0	1.0.0	main=9515ef1f79ef3cb800bd85e5d3de0d98	sdk=8618895246b420329b77746b960a66ab
+package	v0
+shader_versions	v0
+
+# ---- Files ----
+# every module main imports from
+modules	main sdk
+romfs_marker	audio_switch.rpf
+zip_store	.bk2:.pkdswitch:.rpf:.metallib
+
+# ---- Memory ----
+# main sets a heap of at most the pool − 64 MB − 1207 MB of bss (counted as used memory): a 2048 MB heap region
+mem_reserve	0xb0000000
+mem_alias	0x10000000
+mem_stack	0x10000000
+app_pool	0xCD500000
+# the NPDM declares 0 MB of system resource: IsVirtualAddressMemoryEnabled is false, as on Horizon (Big Brain Academy: Brain vs. Brain sets a heap only then)
+sys_resource	0x0
+
+# ---- Shader split ----
+shader_groups	/redemption/=redemption /cero/=cero /d11extra/=d11extra
+shader_note	Red Dead Redemption shaders (RAGE effects in shaders.rpf and main, Double Eleven pack)
+
+# ---- After the rewrite ----
+# used memory for the current rewritten modules, at least the default 64 MB
+mem_used	0x4ca4000
+# render_cond: the game draws under SetRenderEnableConditional (its only [RED] line in a 5-minute run); without the key small black squares showed in the title scene and the opening cutscene
+render_cond	on
