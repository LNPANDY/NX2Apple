From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Victor Wads <victor.laureano@gmail.com>
Date: Fri, 13 Nov 2026 17:36:55 -0300
Subject: [PATCH] Make setup axis selections match game configuration directly

Upstream-Status: pending
Reason: Expose the exact game axis mapping in Setup and keep renderer basis conversion separate
Issue: LNPANDY/NX2Apple#1206

---
 dm/mac/Motion/AxisMap.swift                   |  3 +++
 dm/mac/Motion/Calibration.swift               |  2 +-
 dm/mac/Motion/MotionView.swift                |  8 +++---
 dm/mac/Motion/Store.swift                     | 12 ++++-----
 dm/mac/Motion/Tests/MotionContractTests.swift | 27 +++++++++++++++++--
 5 files changed, 39 insertions(+), 13 deletions(-)

diff --git a/dm/mac/Motion/AxisMap.swift b/dm/mac/Motion/AxisMap.swift
index 17d046b..aca6514 100644
--- a/dm/mac/Motion/AxisMap.swift
+++ b/dm/mac/Motion/AxisMap.swift
@@ -9,5 +9,8 @@ struct AxisMap: Codable, Equatable {
         func component(_ a: Int) -> Double { guard (1...3).contains(abs(a)) else { return 0 }; return v[abs(a)-1] * (a < 0 ? -1 : 1) }
         return SIMD3(component(x),component(y),component(z))
     }
+    // Renderer-only basis conversion. Saved axes are always the game axes.
+    static func gameToDisplay(_ v:SIMD3<Double>) -> SIMD3<Double> { SIMD3(v.x,v.z,-v.y) }
+    var fromDisplayToGame: AxisMap { AxisMap(x:x,y:-z,z:y) }
     var valid: Bool { Set([abs(x),abs(y),abs(z)]) == Set([1,2,3]) }
 }
diff --git a/dm/mac/Motion/Calibration.swift b/dm/mac/Motion/Calibration.swift
index 953faf3..15ea561 100644
--- a/dm/mac/Motion/Calibration.swift
+++ b/dm/mac/Motion/Calibration.swift
@@ -179,7 +179,7 @@ struct CalibrationView: View {
                 Button(L("Start over")) { sensor.autoCalibration=AutoCalibration();started=Date() }
                 Spacer();Button(L("Cancel")) { dismiss() }
 
-                if step==7 { Button(L("OK")) { if let map=sensor.autoCalibration.result { sensor.applyCalibration(map:map,bias:sensor.autoCalibration.bias,gravity:sensor.autoCalibration.flatGravity,preview:sensor.autoCalibration.preview) };dismiss() }.keyboardShortcut(.defaultAction).disabled(!sensor.autoCalibration.previewReady) }
+                if step==7 { Button(L("OK")) { if let map=sensor.autoCalibration.result { sensor.applyCalibration(map:map.fromDisplayToGame,bias:sensor.autoCalibration.bias,gravity:sensor.autoCalibration.flatGravity,preview:sensor.autoCalibration.preview) };dismiss() }.keyboardShortcut(.defaultAction).disabled(!sensor.autoCalibration.previewReady) }
             }
         }.padding(24).frame(width:780)
         .onChange(of:sensor.autoCalibration.phase) { _,_ in started=Date() }
diff --git a/dm/mac/Motion/MotionView.swift b/dm/mac/Motion/MotionView.swift
index 10d8d1e..a5f9541 100644
--- a/dm/mac/Motion/MotionView.swift
+++ b/dm/mac/Motion/MotionView.swift
@@ -132,7 +132,7 @@ import simd
         inputs = s.inputs
         acceleration = s.acceleration; gyro = s.gyro
         if calibrating { autoCalibration.add(s) }
-        var mapped = s; mapped.gyro = axes.apply(s.gyro-gyroBias)
+        var mapped = s; mapped.gyro = AxisMap.gameToDisplay(axes.apply(s.gyro-gyroBias))
         if axes.valid { orientation.update(mapped) }
         confirmed = true; status = "CONNECTED — receiving DSU slot " + String(s.slot)
     }
@@ -252,9 +252,9 @@ struct SensorCard: View {
                 Spacer(); LocalizedText("\(sensor.samples) samples").monospacedDigit()
             }
             DisclosureGroup(L("Axis mapping (saved for this phone)")) {
-                AxisPicker(title:"Display X · tilt toward you",selection:$sensor.axes.x)
-                AxisPicker(title:"Display Y · turn flat on table",selection:$sensor.axes.y)
-                AxisPicker(title:"Display Z · lean left/right",selection:$sensor.axes.z)
+                AxisPicker(title:"Game X · right",selection:$sensor.axes.x)
+                AxisPicker(title:"Game Y · forward",selection:$sensor.axes.y)
+                AxisPicker(title:"Game Z · up",selection:$sensor.axes.z)
                 LocalizedText("Input X = DSU pitch, Y = yaw, Z = roll. Choose each input once. Minus reverses direction. Mapping changes reset orientation.").font(.caption)
                 if !sensor.axes.valid { LocalizedText("Choose three different input axes.").foregroundStyle(.red) }
                 Button(L("Swap X / Y")) { let a=sensor.axes; sensor.axes=AxisMap(x:a.y,y:a.x,z:a.z) }
diff --git a/dm/mac/Motion/Store.swift b/dm/mac/Motion/Store.swift
index f8c105d..d6f434f 100644
--- a/dm/mac/Motion/Store.swift
+++ b/dm/mac/Motion/Store.swift
@@ -16,9 +16,9 @@ import Combine
             baseline=config
             for d in config.devices {
                 let s=Sensor(id:d.id);s.railSL=d.railSL ?? -1;s.railSR=d.railSR ?? -1;s.role=d.role ?? .full;s.buttons=d.buttons ?? false;s.name=d.name;s.player=d.player;s.host=d.host;s.port=String(d.port);s.slot=d.slot
-                // Switch x/right,y/forward,z/up -> preview x/right,y/up,z/back.
-                s.axes=AxisMap(x:d.axes[0],y:d.axes[2],z:-d.axes[1]);s.gyroBias=SIMD3(d.bias[0],d.bias[1],d.bias[2]);s.calibrated=d.calibrated ?? d.enabled
-                if let axes=d.displayAxes,axes.count==3 { s.axes=AxisMap(x:axes[0],y:axes[1],z:axes[2]) }
+                // Controls edit the game-frame map directly. Renderer conversion is separate.
+                s.axes=AxisMap(x:d.axes[0],y:d.axes[1],z:d.axes[2]);s.gyroBias=SIMD3(d.bias[0],d.bias[1],d.bias[2]);s.calibrated=d.calibrated ?? d.enabled
+                // Preserve existing game mapping, ignoring legacy renderer-only axes.
                 sensors.append(s);observe(s)
             }
         } catch { self.error=String(describing:error) }
@@ -47,8 +47,8 @@ import Combine
             s.onEdit=nil;s.disconnect()
             s.name=d.name;s.player=d.player;s.host=d.host;s.port=String(d.port);s.slot=d.slot
             s.role=d.role ?? .full;s.buttons=d.buttons ?? false;s.railSL=d.railSL ?? -1;s.railSR=d.railSR ?? -1
-            s.axes=AxisMap(x:d.axes[0],y:d.axes[2],z:-d.axes[1])
-            if let a=d.displayAxes { s.axes=AxisMap(x:a[0],y:a[1],z:a[2]) }
+            s.axes=AxisMap(x:d.axes[0],y:d.axes[1],z:d.axes[2])
+
             s.gyroBias=SIMD3(d.bias[0],d.bias[1],d.bias[2]);s.calibrated=d.calibrated ?? d.enabled
             observe(s);if reconnect { s.connect() };return s
         }
@@ -63,7 +63,7 @@ import Combine
         for s in sensors {
             let slot=s.slot<0 ? (s.detectedSlot ?? 0) : s.slot
             guard let port=Int(s.port) else { throw DSUConfiguration.Failure.invalid }
-            devices.append(DSUDevice(id:s.id,name:s.name,player:s.player,host:s.host,port:port,slot:slot,axes:[s.axes.x,-s.axes.z,s.axes.y],bias:[s.gyroBias.x,s.gyroBias.y,s.gyroBias.z],enabled:s.calibrated,role:s.role,railSL:s.railSL,railSR:s.railSR,buttons:s.buttons,calibrated:s.calibrated,displayAxes:[s.axes.x,s.axes.y,s.axes.z]))
+            devices.append(DSUDevice(id:s.id,name:s.name,player:s.player,host:s.host,port:port,slot:slot,axes:[s.axes.x,s.axes.y,s.axes.z],bias:[s.gyroBias.x,s.gyroBias.y,s.gyroBias.z],enabled:s.calibrated,role:s.role,railSL:s.railSL,railSR:s.railSR,buttons:s.buttons,calibrated:s.calibrated,displayAxes:nil))
         }
         let config=DSUConfiguration(devices:devices);_ = try config.environment();return config
     }
diff --git a/dm/mac/Motion/Tests/MotionContractTests.swift b/dm/mac/Motion/Tests/MotionContractTests.swift
index 6c7e232..a89f35d 100644
--- a/dm/mac/Motion/Tests/MotionContractTests.swift
+++ b/dm/mac/Motion/Tests/MotionContractTests.swift
@@ -1,6 +1,29 @@
 import XCTest
 @testable import NXMotion
 final class MotionContractTests:XCTestCase {
+    @MainActor func testGameAxisIdentityAndLegacyMappingPreserved() throws {
+        let dir=FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at:dir) }
+        let url=dir.appendingPathComponent("dsu.json")
+        let old=DSUDevice(id:UUID(),name:"Phone",player:1,host:"127.0.0.1",port:26760,slot:1,axes:[1,-3,2],bias:[0,0,0],enabled:true,displayAxes:[1,2,3])
+        try DSUConfiguration(devices:[old]).save(to:url)
+        let store=SensorStore(url:url),sensor=try XCTUnwrap(store.sensors.first)
+        XCTAssertEqual(sensor.axes,AxisMap(x:1,y:-3,z:2))
+        XCTAssertEqual(try store.configuration().devices[0].axes,old.axes)
+        sensor.axes=AxisMap()
+        XCTAssertEqual(try DSUConfiguration.load(from:url).devices[0].axes,[1,2,3])
+        XCTAssertEqual(try store.configuration().environment()["DM_DSU_1"],"127.0.0.1,26760,1,1,2,3,0.0,0.0,0.0")
+    }
+    func testRendererBasisIsOnlyPresentation() {
+        let v=SIMD3<Double>(2,3,5),map=AxisMap(x:2,y:-1,z:3)
+        XCTAssertEqual(AxisMap.gameToDisplay(map.fromDisplayToGame.apply(v)),map.apply(v))
+        for axis in 0..<3 {
+            var unit=SIMD3<Double>.zero;unit[axis]=1
+            let rendered=AxisMap.gameToDisplay(unit)
+            XCTAssertEqual(rendered.x*rendered.x+rendered.y*rendered.y+rendered.z*rendered.z,1)
+        }
+    }
+
     @MainActor func testTwoAppsShareChangesAndRejectStaleWrites() throws {
         let dir=FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
         defer { try? FileManager.default.removeItem(at:dir) }
@@ -68,8 +91,8 @@ final class MotionContractTests:XCTestCase {
         phone.host="127.0.0.1";phone.port="26760";phone.slot=1
         phone.applyCalibration(map:AxisMap(x:2,y:-1,z:3),bias:SIMD3(0.1,0.2,0.3),gravity:SIMD3(0,-1,0),preview:Orientation())
         let saved=try DSUConfiguration.load(from:url)
-        XCTAssertEqual(saved.devices[0].axes,[2,-3,-1])
-        XCTAssertEqual(try saved.environment()["DM_DSU_1"],"127.0.0.1,26760,1,2,-3,-1,0.1,0.2,0.3")
+        XCTAssertEqual(saved.devices[0].axes,[2,-1,3])
+        XCTAssertEqual(try saved.environment()["DM_DSU_1"],"127.0.0.1,26760,1,2,-1,3,0.1,0.2,0.3")
         let restored=SensorStore(url:url)
         XCTAssertEqual(restored.sensors.first?.id,phone.id)
         XCTAssertEqual(restored.sensors.first?.axes,phone.axes)
