 dm/gfx/tests/Makefile         |  3 ++
 dm/gfx/tests/t_clear_layers.m | 76 +++++++++++++++++++++++++++++++++++
 docs/reference/rendering.md   |  8 ++++
 4 files changed, 105 insertions(+), 4 deletions(-)
