From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: v0lumehi <aljic.zijad@gmail.com>
Date: Sat, 31 Oct 2026 00:09:25 +0100
Subject: [PATCH] settings: Breath of the Wild offers 120 fps and a render
 scale up to 2.4 on the Mac

A build whose rewriter table has VAR_STEP (seedds/nxnative#76) takes DM_FPS_TARGET 61 to 240, and one with RENDER_POOL takes
DM_RENDER_SCALE up to 3.0 on the Mac. The launcher list still offered 30 / 60 and 0.5 to 1.0, so a player could reach them
only through the environment. Two Mac rows now replace the usual ones for such a build: 30, 60 or 120 fps, and 0.5 to 2.4
(3840 x 2160 docked). The iPhone list is unchanged.

settings.py: a condition may join several with &, and of several rows for one variable the last whose condition holds is
listed, in the place of the first.

Upstream-Status: pending (follow-up to seedds/nxnative#76)
Reason: The Mac launcher offers the frame rate and render scale that seedds/nxnative#76 makes possible
Issue: LNPANDY/NX2Apple#287
---
 dm/games/settings.py                     |  9 +++++--
 dm/games/settings.tsv                    |  3 +++
 dm/tools/tests/test_launcher_settings.py | 30 ++++++++++++++++++++++++
 docs/frontends.md                        |  4 ++--
 docs/settings.md                         |  8 +++++--
 5 files changed, 48 insertions(+), 6 deletions(-)

diff --git a/dm/games/settings.py b/dm/games/settings.py
index d16b9cb9..d609768b 100644
--- a/dm/games/settings.py
+++ b/dm/games/settings.py
@@ -69,6 +69,7 @@ def build(gid, patched, control):
         return macros[name].strip('"')
 
     def shown(cond, n):
+        if '&' in cond: return all(shown(c, n) for c in cond.split('&'))   # every one of the joined conditions
         if cond == 'always': return True
         if cond == 'languages>1': return len(langs) > 1
         if cond.startswith('fixups:'): return cond[7:] in keys
@@ -94,7 +95,10 @@ def build(gid, patched, control):
         if kind == 'choice' and values != 'languages': return {v.split('=', 1)[0] for v in values.split(',')}
         return None
 
-    out, table, base = [], {r[1][0]: takes(r[1][1], r[1][2]) for r in rows()}, render_base(g)
+    out, at, table, base = [], {}, {}, render_base(g)
+    for _, r in rows():   # a variable several rows set takes the values of all of them
+        t = takes(r[1], r[2])
+        table[r[0]] = None if t is None or (r[0] in table and table[r[0]] is None) else table.get(r[0], set()) | t
     for n, (var, kind, values, default, cond, section, label, note, extra) in rows():
         m = meta(extra, n)
         if 'needs' in m:
@@ -119,7 +123,8 @@ def build(gid, patched, control):
             if len(on_off) != 2 or not all(on_off) or on_off[0] == on_off[1]: sys.exit(f'settings.tsv:{n}: toggle values are - or <on>/<off>: {values}')
             s.update(on=on_off[0], off=on_off[1], default=on_off[0] if s['default'] == '1' else on_off[1])   # the default as the value the variable takes
         else: sys.exit(f'settings.tsv:{n}: unknown kind {kind}')
-        out.append(s)
+        if var in at: out[at[var]] = s   # a later row whose condition holds replaces an earlier one for the same variable, in its place
+        else: at[var] = len(out); out.append(s)
     return {'schema': SCHEMA, 'game': g.id, 'settings': out}
 
 
diff --git a/dm/games/settings.tsv b/dm/games/settings.tsv
