From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LNPANDY <lnp-andy@hotmail.com>
Date: Sun, 22 Nov 2026 19:40:51 +0800
Subject: [PATCH] gfx: keep shader cache directory resolvable across app moves
 via F_GETPATH

Upstream-Status: pending
Reason: Track the shader library directory fd with F_GETPATH so moving the app bundle during play does not break shader loading, and close it on teardown
Issue: none
---
 dm/gfx/nvn/nvn_mtl.m       |  50 ++++++++++++++++--
 dm/gfx/tests/Makefile      |   5 ++
 dm/gfx/tests/t_msl_moved.m | 105 +++++++++++++++++++++++++++++++++++++
 3 files changed, 155 insertions(+), 5 deletions(-)
 create mode 100644 dm/gfx/tests/t_msl_moved.m

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index 77e824d..4e91cac 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -13,6 +13,7 @@
 #include <sys/mman.h>
 #include <sys/sysctl.h>
 #include <fcntl.h>
+#include <limits.h>
 #include <sys/file.h>   // flock: the lock beside Metal's build folders (ga_claim)
 #include <TargetConditionals.h>
 #if TARGET_OS_OSX
@@ -7225,7 +7226,9 @@ static int clear_rect_zero(int i) {
 static os_unfair_lock g_rmu = OS_UNFAIR_LOCK_INIT;
 // ---------- Shader mapping table: Switch control section hash → PC metallib (produced by dm/gfx/tools/shader_map.py) ----------
 static NSMutableDictionary<NSString *, NSString *> *g_shmap;
-static NSString *g_shmap_path, *g_msl_dir;
+static NSString *g_shmap_path, *g_msl_dir, *g_msl_fd_path;
+static int g_msl_fd = -1;
+static _Atomic int g_msl_moved_told;
 #include "nvn_live.inc"
 // The library may be one file beside its folder, b-<chain>.img (dm/tools/shader_lib.py, msl_image.h), read in place. Each file comes from the folder first: what a partial dmsh_build.py run rebuilt goes
 // over the image, a build folder from before the image works as it did, and a host running from a folder goes on when a build packs it (the image is whole before the folder goes). So the image is
@@ -7250,9 +7253,27 @@ static int clear_rect_zero(int i) {
     if (!g_msl_dir || path.length <= g_msl_dir.length + 1 || ![path hasPrefix:g_msl_dir] || [path characterAtIndex:g_msl_dir.length] != '/') return nil;
     return [NSString stringWithFormat:@"b-%s/%@", DMSH_CHAIN, [path substringFromIndex:g_msl_dir.length + 1]];
 }
+// Keep an open fd on the shader library directory so moving the app or renaming its folder during play resolves to the new path via F_GETPATH.
+static NSString *msl_moved(NSString *path) {
+    NSString *dir = g_msl_dir, *orig = g_msl_fd_path;
+    int fd = g_msl_fd;
+    if (fd < 0 || !dir || path.length <= dir.length + 1 || ![path hasPrefix:dir] || [path characterAtIndex:dir.length] != '/') return nil;
+    char now[PATH_MAX];
+    if (fcntl(fd, F_GETPATH, now) < 0) return nil;
+    NSString *nd = @(now);
+    if ([nd isEqual:dir] || (orig && [nd isEqual:orig])) return nil;
+    if (!atomic_exchange(&g_msl_moved_told, 1))
+        MLOG("shader library directory moved while running: %s -> %s; loading from the new location", dir.UTF8String, now);
+    return [nd stringByAppendingString:[path substringFromIndex:dir.length]];
+}
 static NSData *msl_data(NSString *path) {   // a file of the library, nil when it has none
     NSData *d = [NSData dataWithContentsOfFile:path];
     if (d) return d;
+    NSString *np = msl_moved(path);
+    if (np) {
+        d = [NSData dataWithContentsOfFile:np];
+        if (d) return d;
+    }
     romfs_img *m; const img_ent *x = msl_image_file(path, &m);
     if (x) {
         NSMutableData *o = [NSMutableData dataWithLength:(NSUInteger)x->b];
@@ -7305,6 +7326,14 @@ static void shmap_read(void) {
     const char *m = getenv("DM_MSL_DIR");
     // Library directory = <DM_MSL_DIR or default cache>/b-<translation chain version>: the version comes from dm/gfx/nvn/dmsh_chain.h (tools/dmsh_chain.py), one for every game; a host built from an old source tree only accepts libraries of the old version
     g_msl_dir = [NSString stringWithFormat:@"%@/b-%s", m ? @(m) : [NSString stringWithFormat:@"%s%s/build/cache/metal_shader_cache", getenv("DM_ROOT") ?: (getenv("HOME") ?: ""), getenv("DM_ROOT") ? "" : "/dm-work"], DMSH_CHAIN];
+    if (g_msl_fd >= 0) { close(g_msl_fd); g_msl_fd = -1; }
+    g_msl_fd_path = nil;
+    atomic_store(&g_msl_moved_told, 0);
+    g_msl_fd = open(g_msl_dir.fileSystemRepresentation, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (g_msl_fd >= 0) {
+        char open_path[PATH_MAX];
+        if (fcntl(g_msl_fd, F_GETPATH, open_path) == 0) g_msl_fd_path = @(open_path);
+    }
     if (![NSFileManager.defaultManager fileExistsAtPath:g_msl_dir]) {
         NSString *image = [g_msl_dir stringByAppendingString:@".img"];
         dm_msl_footer tf;
@@ -7515,7 +7544,12 @@ static void pso_user_record(const char *fmt, ...) {
     return lib_tag([g_dev newLibraryWithData:d error:err], tag);
 }
 static id<MTLLibrary> lib_from_file(NSString *path, NSError **err) {
-    int fd = open(path.fileSystemRepresentation, O_RDONLY); struct stat st;
+    NSString *open_path = path;
+    int fd = open(open_path.fileSystemRepresentation, O_RDONLY); struct stat st;
+    if (fd < 0) {
+        NSString *np = msl_moved(path);
+        if (np) { fd = open(np.fileSystemRepresentation, O_RDONLY); if (fd >= 0) open_path = np; }
+    }
     if (fd < 0) {   // not in the folder: the library's image or DM_ROMFS shader trailer, whose one descriptor is shared, and only this file's pages are mapped
         int open_errno = errno; romfs_img *img; const img_ent *x = msl_image_file(path, &img); msl_map f;
         if (x && msl_image_map(img, x, &f)) return lib_from_map(f, err);
@@ -7542,9 +7576,9 @@ static void pso_user_record(const char *fmt, ...) {
         }
         else if (!x && !in_trailer) errno = open_errno;
     }
-    if (fd < 0 || fstat(fd, &st) || st.st_size <= 0) { if (fd >= 0) close(fd); if (err) *err = [NSError errorWithDomain:NSPOSIXErrorDomain code:errno userInfo:@{NSLocalizedDescriptionKey: [NSString stringWithFormat:@"cannot open %@", path]}]; return nil; }
+    if (fd < 0 || fstat(fd, &st) || st.st_size <= 0) { if (fd >= 0) close(fd); if (err) *err = [NSError errorWithDomain:NSPOSIXErrorDomain code:errno userInfo:@{NSLocalizedDescriptionKey: [NSString stringWithFormat:@"cannot open %@", open_path]}]; return nil; }
     size_t len = (size_t)st.st_size; void *m = mmap(NULL, len, PROT_READ, MAP_PRIVATE, fd, 0); int map_errno = errno; close(fd);
-    if (m == MAP_FAILED) { if (err) *err = [NSError errorWithDomain:NSPOSIXErrorDomain code:map_errno userInfo:@{NSLocalizedDescriptionKey: [NSString stringWithFormat:@"mmap failed %@", path]}]; return nil; }
+    if (m == MAP_FAILED) { if (err) *err = [NSError errorWithDomain:NSPOSIXErrorDomain code:map_errno userInfo:@{NSLocalizedDescriptionKey: [NSString stringWithFormat:@"mmap failed %@", open_path]}]; return nil; }
     return lib_from_map((msl_map){.data = m, .size = len, .base = m, .base_len = len}, err);
 }
 // NVN depth mode (nvnDeviceSetDepthMode): every vertex library has two entry points (dmsh_entry.py vs_depth): main0 rewrites z for the GL convention (near = -w, NVN's default),
@@ -12150,7 +12184,10 @@ static int pre_later_take(PreLater *l, int wait) {
 // Whether the library has the file: in its folder, in its image (msl_image_file), or in the DM_ROMFS shader trailer
 static int msl_has(NSString *path) {
     romfs_img *m;
-    if (!access(path.fileSystemRepresentation, F_OK) || msl_image_file(path, &m) != NULL) return 1;
+    if (!access(path.fileSystemRepresentation, F_OK)) return 1;
+    NSString *np = msl_moved(path);
+    if (np && !access(np.fileSystemRepresentation, F_OK)) return 1;
+    if (msl_image_file(path, &m) != NULL) return 1;
     NSString *rel = msl_trailer_rel(path);
     return rel && dm_msl_trailer_has(rel.UTF8String);
 }
@@ -21472,6 +21509,9 @@ void dm_gfx_teardown(void) { @autoreleasepool {
     if (mimg) romfs_image_close(mimg);
     dm_msl_trailer_teardown();
 
+    if (g_msl_fd >= 0) { close(g_msl_fd); g_msl_fd = -1; }
+    g_msl_fd_path = nil;
+    atomic_store(&g_msl_moved_told, 0);
     g_shmap = nil; g_shmap_path = nil; g_msl_dir = nil;
     g_shcache = nil; g_builtin = nil; g_builtin_lib = nil;
     g_c1_banks = nil; g_c1_full = nil; g_c1_full_valid = 0; g_cb_ext = nil;
diff --git a/dm/gfx/tests/Makefile b/dm/gfx/tests/Makefile
index afb7992..877cdc2 100644
--- a/dm/gfx/tests/Makefile
+++ b/dm/gfx/tests/Makefile
@@ -504,6 +504,11 @@ check_t_pso_demand_record: t_pso_demand_record
 	MTL_DEBUG_LAYER=1 ./t_pso_demand_record --cap
 t_shmap_warm: t_shmap_warm.m $(MTL_T_DEP)
 	clang $(CFLAGS) -fobjc-arc -o $@ t_shmap_warm.m $(MTL_T_SRC) $(FW)
+t_msl_moved: t_msl_moved.m $(MTL_T_DEP)
+	clang $(CFLAGS) -fobjc-arc -o $@ t_msl_moved.m $(MTL_T_SRC) $(FW)
+.PHONY: check_t_msl_moved
+check_t_msl_moved: t_msl_moved
+	./t_msl_moved
 t_pso_bg_look: t_pso_bg_look.m $(MTL_T_DEP)
 	clang $(CFLAGS) -fobjc-arc -o $@ t_pso_bg_look.m $(MTL_T_SRC) $(FW)
 .PHONY: check_t_pso_bg_look
diff --git a/dm/gfx/tests/t_msl_moved.m b/dm/gfx/tests/t_msl_moved.m
new file mode 100644
index 0000000..e09f1f2
--- /dev/null
+++ b/dm/gfx/tests/t_msl_moved.m
@@ -0,0 +1,105 @@
+// Keep loading shader libraries and reflection JSON after the cache or app bundle directory is moved while running, and close the tracking fd on teardown.
+#include "../nvn/nvn_mtl.m"
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod;
+int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+
+static int g_checks, g_failed;
+#define EXPECT_EQ(name, want, got) do { \
+    long long w_ = (long long)(want), g_ = (long long)(got); g_checks++; \
+    printf("%s expected %lld -> got %lld %s\n", name, w_, g_, w_ == g_ ? "OK" : "FAIL"); \
+    g_failed += w_ != g_; \
+} while (0)
+
+static void put(NSString *path, NSString *text) {
+    [NSFileManager.defaultManager createDirectoryAtPath:path.stringByDeletingLastPathComponent withIntermediateDirectories:YES attributes:nil error:nil];
+    if (![text writeToFile:path atomically:YES encoding:NSUTF8StringEncoding error:nil]) {
+        fprintf(stderr, "FAIL: cannot write %s\n", path.UTF8String);
+        exit(2);
+    }
+}
+
+static int compile_metallib(NSString *dir, NSString *name) {
+    NSString *src = @"#include <metal_stdlib>\nusing namespace metal;\nvertex float4 main0(uint id [[vertex_id]]) { return float4(0, 0, 0, 1); }\n";
+    put([NSString stringWithFormat:@"%@/%@.metal", dir, name], src);
+    NSString *cmd = [NSString stringWithFormat:
+        @"cd '%@' && xcrun -sdk macosx metal -c %@.metal -o %@.air && xcrun -sdk macosx metallib %@.air -o %@.metallib && rm -f %@.metal %@.air",
+        dir, name, name, name, name, name, name];
+    int r = system(cmd.UTF8String);
+    return WIFEXITED(r) ? WEXITSTATUS(r) : -1;
+}
+
+int main(void) { @autoreleasepool {
+    char tmpl[] = "/tmp/t_msl_moved.XXXXXX";
+    if (!mkdtemp(tmpl)) { perror("mkdtemp"); return 2; }
+    NSString *sandbox = @(tmpl);
+    NSString *src_root = [sandbox stringByAppendingPathComponent:@"AppA"];
+    NSString *dst_root = [sandbox stringByAppendingPathComponent:@"AppB"];
+    NSString *shmap = [sandbox stringByAppendingPathComponent:@"shader_map.tsv"];
+    put(shmap, @"# no shaders\n");
+
+    NSString *b_rel = [NSString stringWithFormat:@"b-%s", DMSH_CHAIN];
+    NSString *src_b = [src_root stringByAppendingPathComponent:b_rel];
+    NSString *dst_b = [dst_root stringByAppendingPathComponent:b_rel];
+    put([src_b stringByAppendingPathComponent:@"inputs.tsv"],
+        [NSString stringWithFormat:@"game\t%s\ninputs\tinit\n", dm_profile()->id]);
+    put([src_b stringByAppendingPathComponent:@"before_b.json"], @"{\"phase\":\"before\"}");
+
+    setenv("DM_NVN_SHMAP", shmap.fileSystemRepresentation, 1);
+    setenv("DM_MSL_DIR", src_root.fileSystemRepresentation, 1);
+    unsetenv("DM_ROMFS");
+
+    if (!mtl_device_classic()) { fputs("FAIL: mtl_device_classic failed\n", stderr); return 1; }
+    shmap_read();
+
+    int tracked_fd = g_msl_fd;
+    EXPECT_EQ("shmap_read opened directory fd", 1, tracked_fd >= 0);
+
+    NSData *before = msl_data([g_msl_dir stringByAppendingPathComponent:@"before_b.json"]);
+    NSString *before_str = before ? [[NSString alloc] initWithData:before encoding:NSUTF8StringEncoding] : @"";
+    EXPECT_EQ("initial msl_data reads before move", 1, [before_str isEqualToString:@"{\"phase\":\"before\"}"]);
+    EXPECT_EQ("symlinked /tmp does not false-trigger move warning before rename", 0, atomic_load(&g_msl_moved_told));
+
+    if (rename(src_root.fileSystemRepresentation, dst_root.fileSystemRepresentation) != 0) {
+        perror("rename");
+        return 2;
+    }
+    EXPECT_EQ("old path no longer exists on disk", 0, access([g_msl_dir stringByAppendingPathComponent:@"before_b.json"].fileSystemRepresentation, F_OK) == 0);
+
+    // Write additional cache artifacts into the moved location.
+    put([dst_b stringByAppendingPathComponent:@"after_b.json"], @"{\"phase\":\"after\"}");
+    EXPECT_EQ("compile metallib in moved cache dir", 0, compile_metallib(dst_b, @"after_b"));
+
+    // Queries still pass the stale g_msl_dir path captured before the move.
+    EXPECT_EQ("msl_has resolves moved json via F_GETPATH", 1, msl_has([g_msl_dir stringByAppendingPathComponent:@"after_b.json"]));
+    EXPECT_EQ("msl_has still returns 0 for missing file", 0, msl_has([g_msl_dir stringByAppendingPathComponent:@"missing_b.json"]));
+    EXPECT_EQ("msl_moved rejects sibling prefix without slash", 1, msl_moved([g_msl_dir stringByAppendingString:@"_sibling/after_b.json"]) == nil);
+
+    NSData *after = msl_data([g_msl_dir stringByAppendingPathComponent:@"after_b.json"]);
+    NSString *after_str = after ? [[NSString alloc] initWithData:after encoding:NSUTF8StringEncoding] : @"";
+    EXPECT_EQ("msl_data reads newly written file in moved dir", 1, [after_str isEqualToString:@"{\"phase\":\"after\"}"]);
+    EXPECT_EQ("move logged once", 1, atomic_load(&g_msl_moved_told));
+
+    NSError *err = nil;
+    id<MTLLibrary> lib = lib_from_file([g_msl_dir stringByAppendingPathComponent:@"after_b.metallib"], &err);
+    EXPECT_EQ("lib_from_file loads newly written metallib from moved dir", 1, lib != nil && [lib newFunctionWithName:@"main0"] != nil);
+
+    dm_gfx_teardown();
+    EXPECT_EQ("dm_gfx_teardown resets g_msl_fd to -1", -1, g_msl_fd);
+    errno = 0;
+    int fd_alive = fcntl(tracked_fd, F_GETFD);
+    EXPECT_EQ("dm_gfx_teardown closed tracked directory fd", 1, fd_alive == -1 && errno == EBADF);
+    EXPECT_EQ("msl_moved returns nil after teardown", 1, msl_moved([src_b stringByAppendingPathComponent:@"after_b.json"]) == nil);
+
+    [NSFileManager.defaultManager removeItemAtPath:sandbox error:nil];
+    printf("%d checks, %d failed\n", g_checks, g_failed);
+    return g_failed != 0;
+} }
