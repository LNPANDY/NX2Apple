     sigemptyset(&sa.sa_mask);
     sigaction(SIGTERM, &sa, NULL); sigaction(SIGINT, &sa, NULL); sigaction(SIGHUP, &sa, NULL);
-    char *host_argv[] = {host, dm, NULL};
+    // A multi-program application (Info.plist DMPrograms, "0 1 2 3": Assassin's Creed: The Ezio Collection's menu and AC2, then Brotherhood and the others): program 0 is Resources/dm with
+    // Resources/romfs.img, program N Resources/dm/p<N> (its own main beside the shared sdk) with Resources/romfs_p<N>.img. A host whose game calls oe::ExecuteProgram writes the hand-over file
+    // (DM_PROGRAM_HANDOFF) and sends SIGUSR1; the next program's host starts with the launch parameter (DM_LAUNCH_PARAM), the index it came from (DM_PREV_PROGRAM), the old window's place
+    // (DM_WINDOW_PLACE) and the old host's pid (DM_HANDOFF_FROM), which it ends once its first frame is on screen (dm/host/front_mac.m). The session ends when the current host exits
+    char programs[256] = ""; info_string("DMPrograms", programs, sizeof programs);
+    char handoff[PATH_MAX]; snprintf(handoff, sizeof handoff, "%s/program_handoff.txt", temp); unlink(handoff);
+    if (*programs) { setenv("DM_PROGRAMS", programs, 1); setenv("DM_PROGRAM_HANDOFF", handoff, 1); fprintf(stderr, "launcher: programs %s\n", programs); }
+    struct sigaction su = {.sa_handler = on_handoff}; sigemptyset(&su.sa_mask); sigaction(SIGUSR1, &su, NULL);
+    char moddir[PATH_MAX]; snprintf(moddir, sizeof moddir, "%s", dm);
+    char *host_argv[] = {host, moddir, NULL};
     int err = posix_spawn(&g_child, host, NULL, NULL, host_argv, environ);
