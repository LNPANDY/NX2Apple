index 525765e..fb6d5b1 100644
--- a/dm/host/front_mac.m
+++ b/dm/host/front_mac.m
@@ -1178,13 +1178,60 @@ - (BOOL)windowShouldClose:(NSWindow *)w {
 }
 @end
 
+// ---- Program hand-over (oe::ExecuteProgram, hle_oe.c; dm/mac/launcher.c): the game window never closes ----
+// The old host: its window goes black and its sound stops, and its place ("x y w h fullscreen") goes to the launcher, which starts the next program's host with it in DM_WINDOW_PLACE and
+// DM_HANDOFF_FROM=<old host's pid>. The new host opens its window there, in front without a Dock icon (an accessory app while the old one runs). With its window in place it sends
+// the old host SIGUSR2: the old host gives up activation to the new pid (the launcher wrote it to <DM_PROGRAM_HANDOFF>.next) and exits, and the new host becomes a regular app and takes focus
+void dm_host_shutdown(const char *why);   // hle_lifecycle.c
+void dm_front_handoff_begin(char *place, size_t n) {
+    dispatch_sync(dispatch_get_main_queue(), ^{
+        if (!g_win) { if (n) *place = 0; return; }
+        NSRect f = g_win.frame; int fs = (g_win.styleMask & NSWindowStyleMaskFullScreen) != 0;
+        snprintf(place, n, "%.0f %.0f %.0f %.0f %d", f.origin.x, f.origin.y, f.size.width, f.size.height, fs);
+        g_win.backgroundColor = NSColor.blackColor; g_layer.hidden = YES;   // the Switch's black screen between programs
+    });
+    dm_audio_suspend(1);
+    static dispatch_source_t src; signal(SIGUSR2, SIG_IGN);
+    src = dispatch_source_create(DISPATCH_SOURCE_TYPE_SIGNAL, SIGUSR2, 0, dispatch_get_main_queue());
+    dispatch_source_set_event_handler(src, ^{
+        char p[1100]; snprintf(p, sizeof p, "%s.next", getenv("DM_PROGRAM_HANDOFF")); FILE *f = fopen(p, "r"); int pid = 0;
+        if (f) { if (fscanf(f, "%d", &pid) != 1) pid = 0; fclose(f); }
+        NSRunningApplication *next = pid > 0 ? [NSRunningApplication runningApplicationWithProcessIdentifier:pid] : nil;
+        if (next) { if (@available(macOS 14.0, *)) [NSApp yieldActivationToApplication:next]; }
+        [g_win orderOut:nil];
+        dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{ dm_host_shutdown("the next program's first frame (hand-over)"); });
+    });
+    dispatch_resume(src);
+}
+// The new host takes over as soon as its window is in place, not at its first frame: both windows are black then, and a window that waits behind macOS's activation is "covered",
+// its display link firing about once a second; Assassin's Creed II's Ubisoft logo movie played in that time and showed black (its sound played). The first present calls it too (no window)
+static void handoff_take_over(const char *why) {
+    static int once; const char *from = getenv("DM_HANDOFF_FROM"); pid_t old = from ? (pid_t)atoi(from) : 0;
+    if (old <= 0 || once++) return;
+    LOG("front end: %s, ending the program that started this one (pid %d)", why, (int)old);
+    kill(old, SIGUSR2);
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        for (int i = 0; i < 300 && !kill(old, 0); i++) usleep(10000);   // until it has gone (3 s at most)
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
+            if (@available(macOS 14.0, *)) [NSApp activate]; else [NSApp activateIgnoringOtherApps:YES];
+            [g_win makeKeyAndOrderFront:nil];
+            LOG("front end: hand-over done, this window has the focus");
+        });
+    });
+}
+void dm_front_first_present(void) { handoff_take_over("first frame on screen"); }
+
 void front_run(void (*guest)(void)) {
     // A game: tell macOS its work is latency-critical, so the system does not trade its frame time for power while the frame rate is capped
     static id activity; activity = [[NSProcessInfo processInfo] beginActivityWithOptions:NSActivityUserInitiated | NSActivityLatencyCritical reason:@"game"];
     if (!getenv("DM_WINDOW")) { guest(); return; }
     @autoreleasepool {
         [NSApplication sharedApplication];
-        [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
+        const char *from = getenv("DM_HANDOFF_FROM"), *place = getenv("DM_WINDOW_PLACE"); int handoff = from && atoi(from) > 0;
+        double px, py, pw, ph; int pfs = 0, placed = place && sscanf(place, "%lf %lf %lf %lf %d", &px, &py, &pw, &ph, &pfs) == 5 && pw > 0 && ph > 0;
+        if (placed && pfs) setenv("DM_FULLSCREEN", "1", 1);   // the old window was fullscreen: this one enters it too
+        [NSApp setActivationPolicy:handoff ? NSApplicationActivationPolicyAccessory : NSApplicationActivationPolicyRegular];   // no second Dock icon while the old host runs
         NSRect r = NSMakeRect(0, 0, 1280, 720);
         NSWindow *win = [[NSWindow alloc] initWithContentRect:r
                                                     styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable | NSWindowStyleMaskResizable
@@ -1215,10 +1262,14 @@ void front_run(void (*guest)(void)) {
                 LOG("front end: window on screen %lu '%s' (DM_SCREEN)", id, on.localizedName.UTF8String);
             } else LOG("front end: DM_SCREEN=%s ignored, no connected screen has that number", want_scr);
         }
-        [win makeKeyAndOrderFront:nil];
+        if (placed && !pfs) { [win setFrame:NSMakeRect(px, py, pw, ph) display:NO]; LOG("front end: window where the previous program's was (DM_WINDOW_PLACE %s)", place); }
+        win.backgroundColor = NSColor.blackColor;
+        if (handoff) [win orderFrontRegardless];   // over the old host's black window; focus comes at the first frame (dm_front_first_present)
+        else [win makeKeyAndOrderFront:nil];
         screen_refresh(win.screen ?: NSScreen.mainScreen);
         g_win = win;
-        [NSApp activateIgnoringOtherApps:YES];
+        if (!handoff) [NSApp activateIgnoringOtherApps:YES];
+        else handoff_take_over("window in place");
         // A host another process starts (scripts/regress.py) is not activated (its focus state stays 2), so its window opened wherever it landed in the window order, and behind
         // another app's window macOS fires its display link about once a second: Breath of the Wild stepped up to 3 vsyncs at boot and never came back (20 fps runs).
         // DM_WINDOW_TOP=1 orders it in front without activation and keeps it above other apps' windows; the log names every change of the window's visibility either way
