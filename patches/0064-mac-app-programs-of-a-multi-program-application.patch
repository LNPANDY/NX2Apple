 // The operation mode is runtime state (the front end can change it: iOS overheat downgrade switches to handheld): the single source is here, taken once from DM_OPMODE at startup, the environment variable is not read again afterwards
 #include <stdatomic.h>
@@ -104,14 +106,46 @@ HLE_FORCE("_ZN2nn2oe15EnableRecordingEv", "video recording switch; the host has
 // Applet resource user ID (ARUID, the number am assigns to this process): the host has no am, and the SDK's own getter returns 0. SDK 20's OpenAudioRenderer (the CPU rendering + manual execution path, sdk+0x221730)
 //   aborts when it gets 0 (The Legend of Zelda: Breath of the Wild 1.9.0); SDK 16 did not check. Report a fixed non-zero ID, used only as an identifier
 HLE_FORCE("_ZN2nn6applet23GetAppletResourceUserIdEv", "applet resource user ID; the host returns a fixed non-zero value", uint64_t, h_applet_Aruid, void) { return 0x80; }
-// Launch parameter (present only when another program launched this one with one; returns bool): the host never passes one
-HLE_FORCE("_ZN2nn2oe21TryPopLaunchParameterEPmPvm", "launch parameter: none", unsigned, h_oe_PopLaunchParam, size_t *out, void *buf, size_t n) { (void)buf; (void)n; if (out) *out = 0; return 0; }
+// Launch parameter (present only when another program launched this one with one; returns bool): the one the launcher hands over in DM_LAUNCH_PARAM (hex), from the program that
+// called ExecuteProgram (Assassin's Creed: The Ezio Collection's menu passes 80 bytes to the game it starts, and the game passes some back to the menu); popped once, as am does
+static _Atomic int g_param_popped;
+HLE_FORCE("_ZN2nn2oe21TryPopLaunchParameterEPmPvm", "launch parameter: DM_LAUNCH_PARAM from the program that started this one, once", unsigned, h_oe_PopLaunchParam, size_t *out, void *buf, size_t n) {
+    const char *h = getenv("DM_LAUNCH_PARAM"); size_t len = h ? strlen(h) / 2 : 0;
+    if (out) *out = 0;
+    if (!len || atomic_exchange(&g_param_popped, 1)) return 0;
+    if (len > n) { LOG("[RED] oe::TryPopLaunchParameter: %zu bytes of launch parameter, the game's buffer holds %zu; cut", len, n); len = n; }
+    for (size_t i = 0; i < len; i++) { unsigned v; sscanf(h + 2 * i, "%2x", &v); ((uint8_t *)buf)[i] = (uint8_t)v; }
+    if (out) *out = len;
+    LOG("oe::TryPopLaunchParameter: %zu bytes from program %s: %.*s", len, getenv("DM_PREV_PROGRAM") ? getenv("DM_PREV_PROGRAM") : "?", (int)(2 * len), h);   // in full, to start the program the same way again
+    return 1;
+}
 // Tears of the Kingdom (SDK 20.5.22): the index of the program that launched this one in a multi-program application. The SDK asks the applet proxy, which the host never opens
 // (null read in applet::GetPreviousProgramIndex right after the window setup); -1 = launched from the home menu
-HLE_FORCE("_ZN2nn2oe23GetPreviousProgramIndexEv", "previous program index: launched from HOME, -1", int, h_oe_PrevProgram, void) { return -1; }
-// Launch another program of a multi-program application (Octopath Traveler 0 imports it); on hardware it does not return. The host has only this program: logged, and the game carries on
-HLE_FORCE("_ZN2nn2oe14ExecuteProgramEiPKvm", "launch another program of the application: the host runs only this one (logged)", void, h_oe_ExecProgram, int index, const void *param, size_t n) {
-    (void)param; LOG("[RED] oe::ExecuteProgram(%d, %zu bytes of parameters): the host runs only this program; the game carries on", index, n);
+// The launcher sets DM_PREV_PROGRAM when it starts this program for another one's ExecuteProgram
+HLE_FORCE("_ZN2nn2oe23GetPreviousProgramIndexEv", "previous program index: DM_PREV_PROGRAM, else launched from HOME, -1", int, h_oe_PrevProgram, void) { const char *e = getenv("DM_PREV_PROGRAM"); return e ? atoi(e) : -1; }
+// Launch another program of a multi-program application (Octopath Traveler 0 imports it; Assassin's Creed: The Ezio Collection's menu starts each game with it); on hardware it does not return.
+// From a Mac app that carries the program (the launcher lists them in DM_PROGRAMS and names the hand-over file in DM_PROGRAM_HANDOFF, dm/mac/launcher.c): the index, the parameter (hex)
+// and this window's place go into the file, the window goes black and quiet (dm_front_handoff_begin), the launcher is told (SIGUSR1) and starts the program; the new host ends this one
+// (SIGUSR2, dm_front_handoff_end) once its first frame is on screen, so the game window never closes. This thread waits there, as the program never returns from the call.
+// Without the program (a run outside such an app, an index the app does not carry): logged, and the game carries on
+__attribute__((weak)) void dm_front_handoff_begin(char *place, size_t n) { if (n) *place = 0; }   // a front end without a window keeps this one (front_mac.m has its own)
+HLE_FORCE("_ZN2nn2oe14ExecuteProgramEiPKvm", "launch another program of the application: the launcher starts it in a new host, which takes over the window (dm/mac/launcher.c)", void, h_oe_ExecProgram, int index, const void *param, size_t n) {
+    const char *list = getenv("DM_PROGRAMS"), *file = getenv("DM_PROGRAM_HANDOFF"); char want[16]; snprintf(want, sizeof want, " %d ", index);
+    char have[256]; snprintf(have, sizeof have, " %s ", list ? list : "");
+    if (!file || !*file || !strstr(have, want)) {
+        LOG("[RED] oe::ExecuteProgram(%d, %zu bytes of parameters): %s; the game carries on", index, n, !file || !*file ? "the host runs only this program (no launcher hand-over, DM_PROGRAM_HANDOFF)" : "this app does not carry that program (DM_PROGRAMS)");
+        return;
+    }
+    char place[128] = ""; dm_front_handoff_begin(place, sizeof place);   // the window goes black, the sound stops; its frame and fullscreen state for the next host
+    char tmp[1024]; snprintf(tmp, sizeof tmp, "%s.partial", file);
+    FILE *f = fopen(tmp, "w");
+    if (!f) { LOG("[RED] oe::ExecuteProgram(%d): cannot write the hand-over file %s; the game carries on", index, tmp); return; }
+    fprintf(f, "program %d\nparam ", index);
+    for (size_t i = 0; i < n; i++) fprintf(f, "%02x", ((const uint8_t *)param)[i]);
+    fprintf(f, "\nwindow %s\n", place); fclose(f); rename(tmp, file);
+    LOG("oe::ExecuteProgram(%d, %zu bytes of parameters): handed to the launcher (window %s)", index, n, *place ? place : "none");
+    kill(getppid(), SIGUSR1);
+    for (;;) pause();   // the new host ends this process
 }
 HLE_FORCE("_ZN2nn2oe16DisableRecordingEv", "video recording switch; the host has no system recording", void, h_oe_DisableRec, void) {}
 // Silence the game's sound in system video captures (through am; FINAL FANTASY RESONANCE imports both): the host records nothing
