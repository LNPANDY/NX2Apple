-    while (waitpid(g_child, &status, 0) < 0) if (errno != EINTR) return 1;
+    for (;;) {
+        if (g_handoff) {
+            g_handoff = 0;
+            int prog = -1; char param[1024] = "", place[256] = "", ln[1200]; FILE *f = fopen(handoff, "r");
+            while (f && fgets(ln, sizeof ln, f)) {
+                ln[strcspn(ln, "\n")] = 0;
+                if (!strncmp(ln, "program ", 8)) prog = atoi(ln + 8);
+                else if (!strncmp(ln, "param ", 6)) snprintf(param, sizeof param, "%s", ln + 6);
+                else if (!strncmp(ln, "window ", 7)) snprintf(place, sizeof place, "%s", ln + 7);
+            }
+            if (f) fclose(f);
+            unlink(handoff);
+            if (prog == 0) { snprintf(moddir, sizeof moddir, "%s", dm); snprintf(p, sizeof p, "%s/romfs.img", res); }
+            else { snprintf(moddir, sizeof moddir, "%s/p%d", dm, prog); snprintf(p, sizeof p, "%s/romfs_p%d.img", res, prog); }
+            if (prog < 0 || stat(moddir, &st) || stat(p, &st)) { fprintf(stderr, "[RED] launcher: a hand-over to program %d, which this app does not carry (%s, %s)\n", prog, moddir, p); continue; }
+            char ps[16], from[16]; snprintf(ps, sizeof ps, "%d", g_program); snprintf(from, sizeof from, "%d", (int)g_child);
+            setenv("DM_ROMFS", p, 1); setenv("DM_PREV_PROGRAM", ps, 1); setenv("DM_HANDOFF_FROM", from, 1); setenv("DM_WINDOW_PLACE", place, 1);
+            if (*param) setenv("DM_LAUNCH_PARAM", param, 1); else unsetenv("DM_LAUNCH_PARAM");
+            pid_t next; err = posix_spawn(&next, host, NULL, NULL, host_argv, environ);
+            if (err) { fprintf(stderr, "[RED] launcher: cannot start program %d: %s\n", prog, strerror(err)); continue; }
+            char np[PATH_MAX + 8]; snprintf(np, sizeof np, "%s.next", handoff); FILE *nf = fopen(np, "w"); if (nf) { fprintf(nf, "%d\n", (int)next); fclose(nf); }
+            fprintf(stderr, "launcher: program %d → %d (host %d → %d, %zu bytes of launch parameter, window %s)\n", g_program, prog, (int)g_child, (int)next, strlen(param) / 2, *place ? place : "none");
+            g_old = g_child; g_program = prog; g_child = next;
+        }
+        pid_t done = waitpid(-1, &status, WNOHANG);   // polled: a SIGUSR1 between the check above and a blocking wait would wait for good
+        if (!done) { usleep(20000); continue; }
+        if (done < 0) { if (errno == EINTR) continue; return 1; }
+        if (done == g_child) break;
+        if (done == g_old) g_old = 0;
+        fprintf(stderr, "launcher: the previous program's host %d exited (%d)\n", (int)done, WIFEXITED(status) ? WEXITSTATUS(status) : -1);
+        if (!save_sync_after_exit(getenv("DM_SAVE"), id)) fprintf(stderr, "launcher: the save did not reach the cloud; it goes at the next start\n");
+    }
+    if (g_old > 0) { kill(g_old, SIGTERM); while (waitpid(g_old, NULL, 0) < 0 && errno == EINTR) {} }   // the new host ended before its first frame: the old one, still waiting, goes too
     // Cloud saves (DM_SAVE_SYNC, dm/host/save_sync.h): what the host committed and had not sent yet goes now, after a crash too (the committed save is whole whatever the host was doing)
     // DM_SAVE as the host had it: an env file or the launch environment may have set another folder than this app's own
     if (!save_sync_after_exit(getenv("DM_SAVE"), id)) fprintf(stderr, "launcher: the save did not reach the cloud; it goes at the next start\n");
