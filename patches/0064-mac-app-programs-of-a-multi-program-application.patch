index aafb831..c977abf 100644
--- a/dm/mac/launcher.c
+++ b/dm/mac/launcher.c
@@ -40,6 +40,8 @@ static void add_key(char **list, const char *k) {   // a space-separated list of
 }
 
 static void forward(int sig) { if (g_child > 0) kill(g_child, sig); }
+static volatile sig_atomic_t g_handoff; static int g_program; static pid_t g_old;   // g_old: the previous program's host until it has exited   // a host asked for another program (SIGUSR1, the hand-over file); the program the current host runs
+static void on_handoff(int sig) { (void)sig; g_handoff = 1; }
 
 static int info_string(const char *key, char *out, size_t n) {   // a string key of the bundle's Info.plist
     CFBundleRef b = CFBundleGetMainBundle(); if (!b) return 0;
@@ -292,11 +294,52 @@ int main(int argc, char **argv) {
