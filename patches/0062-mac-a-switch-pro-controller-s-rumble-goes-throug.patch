+    dm_haptics_apple_controller(0, (id)sp); drain();
+    assert(pro_hid_of(0) == proBt && proBt.opens == 1 && channels[0].count == 1 && [channels[0][0] isKindOfClass:DmProChannel.class]);
+    b = proBt.reports.lastObject.bytes;
