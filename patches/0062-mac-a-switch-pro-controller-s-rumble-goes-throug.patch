From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Haseenesss <haseenesss@gmail.com>
Date: Wed, 18 Nov 2026 11:05:13 +0900
Subject: [PATCH] Mac: a Switch Pro Controller's rumble goes through its own
 report

A controller that presents itself as a Switch Pro Controller (a GameSir
Nova in its Switch mode, 057E:2009 over Bluetooth or its 2.4 GHz
receiver) never vibrated in a game. Core Haptics started every engine
with no error, but the pad plays only a sharpness of 0, and the host
plays 0.5.

Such a controller now gets its rumble through HID report 0x10, next to
the DualShock 4 route and as SDL's hidapi driver does: each motor's own
low and high band on its own actuator, encoded by pad_jc1.h's HD Rumble
encoder, renewed every 40 ms while it plays. Vibration is turned on with
subcommand 0x48 when the device is taken.

The route is off unless DM_RUMBLE_PRO_REPORT=1. A Nintendo Pro
Controller rumbles through Core Haptics and reports the same 057E:2009,
Core Haptics gives no error on the pads it does not reach, and the
report was tried on the Nova alone.

The route and its tests are the patch in LNPANDY/NX2Apple#1194, ported
to the current haptics_apple.m, with the encoder the engine already has
in place of a second one.

Upstream-Status: pending
Reason: A controller presenting itself as a Switch Pro Controller plays Core Haptics only at sharpness 0, so games never vibrated on it
Issue: LNPANDY/NX2Apple#1194
---
 dm/host/haptics_apple.m         | 103 ++++++++++++++++++++++++++++++++
 dm/host/tests/Makefile          |   2 +-
 dm/host/tests/t_haptics_apple.m |  73 ++++++++++++++++++++--
 3 files changed, 172 insertions(+), 6 deletions(-)

diff --git a/dm/host/haptics_apple.m b/dm/host/haptics_apple.m
index ce6153b..3f3f9d0 100644
--- a/dm/host/haptics_apple.m
+++ b/dm/host/haptics_apple.m
@@ -10,6 +10,7 @@
 #import <AppKit/AppKit.h>
 #import <IOKit/IOKitLib.h>
 #import <IOKit/hid/IOHIDDevice.h>
+#include "pad_jc1.h"
 #endif
 #include <math.h>
 #include <pthread.h>
@@ -349,6 +350,99 @@ static BOOL ds4_route(int p, GCController *controller) {
             ds4[p].bluetooth ? "Bluetooth" : "USB", [(__bridge NSNumber *)IOHIDDeviceGetProperty(ds4[p].dev, CFSTR(kIOHIDProductIDKey)) intValue]);
     return YES;
 }
+
+// A Switch Pro Controller, or a controller that presents itself as one (a GameSir Nova in its Switch mode: Nintendo 057E / 2009 over Bluetooth or
+// its 2.4 GHz receiver), is driven through its own rumble report, as SDL's hidapi driver does: 0x10, the packet counter, then four bytes of HD Rumble
+// for the left actuator and four for the right (pad_jc1.h's encoding). Core Haptics reaches some of these only at its lowest sharpness: on the Nova
+// (macOS 27.2.1) every engine and locality started with no error and only a sharpness of 0 was felt, so a game's rumble never was
+// (LNPANDY/NX2Apple#1194). The report also plays the game's own bands, each motor's low and high frequency and amplitude, where an engine gets an
+// intensity and a sharpness. Off unless DM_RUMBLE_PRO_REPORT=1: a Nintendo Pro Controller rumbles through Core Haptics, and nothing tells the two apart.
+typedef struct { IOHIDDeviceRef dev; uint64_t id; CFIndex size; uint8_t counter; uint8_t rumble[8], sent[8]; uint64_t generation; } pro_out;   // id: its registry entry
+static pro_out pro[DM_PLAYERS];
+static BOOL pro_report_on = NO;
+// Report 0x10 with the rumble alone, or 0x01 with a subcommand after it. Padded to the device's output report size (49 over Bluetooth, 64 over USB)
+static void pro_send(int p, const uint8_t rumble[8], const uint8_t *sub, size_t sublen) {
+    pro_out *o = &pro[p]; uint8_t r[64] = {0};
+    CFIndex n = MIN(MAX(o->size, (CFIndex)(10 + sublen)), (CFIndex)sizeof r);
+    r[0] = sub ? 0x01 : 0x10; r[1] = o->counter++ & 0x0F; memcpy(r + 2, rumble, 8);
+    if (sub) memcpy(r + 10, sub, sublen);
+    IOReturn e = IOHIDDeviceSetReport(o->dev, kIOHIDReportTypeOutput, r[0], r, n);
+    if (e != kIOReturnSuccess) { if (++errors <= 8 || errors % 64 == 0) fprintf(stderr, "[RED] haptics: Pro Controller rumble report: IOReturn 0x%x\n", e); return; }
+    if (!sub) memcpy(o->sent, rumble, 8);
+}
+// The left actuator plays the game's left motor and the right one its right motor, with the gain and DM_RUMBLE_MIN on each band's amplitude. A silent
+// actuator gets the neutral bytes whatever its frequencies. Resent every 40 ms while it plays: a Pro Controller lets a rumble fade out when no report renews it
+static void pro_apply(dm_haptic_state s) {
+    pro_out *o = &pro[s.player];
+    if (!o->dev) return;
+    for (int m = 0; m < 2; m++) {
+        dm_vibration v = s.motor[m];
+        v.amplitude_low = dm_haptics_apple_controller_intensity(v.amplitude_low * gain); v.amplitude_high = dm_haptics_apple_controller_intensity(v.amplitude_high * gain);
+        if (jc1_vibration_on(&v)) jc1_rumble_encode(&v, o->rumble + 4 * m); else memcpy(o->rumble + 4 * m, jc1_neutral_rumble, 4);
+    }
+    uint64_t generation = ++o->generation;
+    BOOL silent = !memcmp(o->rumble, jc1_neutral_rumble, 8);
+    if (silent && !memcmp(o->rumble, o->sent, 8)) return;
+    pro_send(s.player, o->rumble, NULL, 0);
+    if (silent) return;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 40 * NSEC_PER_MSEC), queue, ^{
+        if (pro[s.player].dev && pro[s.player].generation == generation && s.epoch == dm_haptics_epoch(s.player)) { pro[s.player].generation--; pro_apply(s); }
+    });
+}
+static void pro_silence(int p) {
+    pro_out *o = &pro[p];
+    o->generation++;
+    memcpy(o->rumble, jc1_neutral_rumble, 8);
+    if (o->dev && memcmp(o->sent, jc1_neutral_rumble, 8)) pro_send(p, jc1_neutral_rumble, NULL, 0);
+}
+static void pro_release(int p) {
+    pro_out *o = &pro[p];
+    if (o->dev) { pro_silence(p); IOHIDDeviceClose(o->dev, kIOHIDOptionsTypeNone); CFRelease(o->dev); }
+    *o = (pro_out){0};
+}
+@interface DmProChannel : DmRumbleChannel   // one for both actuators; the route takes both motors' values at once (pro_apply)
+@end
+@implementation DmProChannel
+- (void)apply:(dm_haptic_level)level { (void)level; }
+- (void)stop { pro_silence(self.player); }
+@end
+// The first Pro Controller HID device no other player drives, opened for player p, asked of the registry at each connect as ds4_take does.
+// Its vibration is turned on (subcommand 0x48) once it is taken: GameController's own driver leaves it as it found it
+static BOOL pro_take(int p) {
+    CFMutableDictionaryRef match = IOServiceMatching(kIOHIDDeviceKey); io_iterator_t it = 0;
+    if (!match) return NO;
+    CFDictionarySetValue(match, CFSTR(kIOHIDVendorIDKey), (__bridge CFNumberRef)@0x057E);
+    CFDictionarySetValue(match, CFSTR(kIOHIDProductIDKey), (__bridge CFNumberRef)@0x2009);
+    if (IOServiceGetMatchingServices(kIOMainPortDefault, match, &it) != KERN_SUCCESS) return NO;   // takes match
+    BOOL found = NO;
+    for (io_service_t s; !found && (s = IOIteratorNext(it)); IOObjectRelease(s)) {
+        uint64_t id = 0; BOOL taken = NO;
+        if (IORegistryEntryGetRegistryEntryID(s, &id) != KERN_SUCCESS) continue;
+        for (int q = 0; q < DM_PLAYERS; q++) taken |= q != p && pro[q].dev && pro[q].id == id;
+        IOHIDDeviceRef dev = taken ? NULL : IOHIDDeviceCreate(kCFAllocatorDefault, s);
+        if (!dev) continue;
+        if (IOHIDDeviceOpen(dev, kIOHIDOptionsTypeNone) == kIOReturnSuccess) {
+            NSNumber *size = (__bridge NSNumber *)IOHIDDeviceGetProperty(dev, CFSTR(kIOHIDMaxOutputReportSizeKey));
+            pro[p] = (pro_out){.dev = dev, .id = id, .size = size.integerValue > 0 ? size.integerValue : JC1_REPORT_LEN};
+            found = YES;
+        } else CFRelease(dev);
+    }
+    IOObjectRelease(it);
+    if (found) {
+        static const uint8_t enable[2] = {0x48, 0x01};
+        pro_send(p, jc1_neutral_rumble, enable, sizeof enable);
+        memcpy(pro[p].sent, jc1_neutral_rumble, 8); memcpy(pro[p].rumble, jc1_neutral_rumble, 8);
+    }
+    return found;
+}
+// Only a controller GameController calls a Switch Pro Controller, and only while such a HID device is free
+static BOOL pro_route(int p, GCController *controller) {
+    if (!pro_report_on || ![controller.productCategory isEqualToString:@"Switch Pro Controller"] || !pro_take(p)) return NO;
+    DmProChannel *c = [DmProChannel new]; c.player = p; c.motor = -1; c.target = @"Pro Controller report"; [channels[p] addObject:c];
+    fprintf(stderr, "haptics: player %d controller %s, rumble through the Pro Controller report (%s)\n", p + 1, controller.vendorName.UTF8String ?: "unknown",
+            [(__bridge NSString *)IOHIDDeviceGetProperty(pro[p].dev, CFSTR(kIOHIDTransportKey)) UTF8String] ?: "unknown transport");
+    return YES;
+}
 #endif
 
 static void (*sinks[DM_PLAYERS])(const dm_haptic_state *);   // a player's own output instead of engines (dm_haptics_apple_set_sink)
@@ -381,6 +475,7 @@ static void apply(dm_haptic_state s) {
         NSArray<DmRumbleChannel *> *out = channels[s.player];
 #if !TARGET_OS_IPHONE
         if ([out.firstObject isKindOfClass:DmDs4Channel.class]) { ds4_apply(s); return; }
+        if ([out.firstObject isKindOfClass:DmProChannel.class]) { pro_apply(s); return; }
 #endif
         for (NSUInteger i = 0; i < out.count; i++) {
             if (s.epoch != dm_haptics_epoch(s.player)) break;   // a failed channel may replace this route
@@ -407,7 +502,9 @@ static void configure(int p, GCController *controller, GCHapticsLocality localit
     if (sinks[p]) { sink_silence(p); dm_haptics_route(p, 1); return; }
 #if !TARGET_OS_IPHONE
     ds4_release(p);
+    pro_release(p);
     if (controller && !locality && ds4_route(p, controller)) { dm_haptics_route(p, 1); return; }   // the report first, as SDL drives it
+    if (controller && !locality && pro_route(p, controller)) { dm_haptics_route(p, 1); return; }
 #endif
     if (controller) {
         GCDeviceHaptics *h = controller.haptics;
@@ -526,6 +623,7 @@ void dm_haptics_apple_output(int p, id owner, dm_haptics_output output) {
             for (DmRumbleChannel *c in channels[p]) [c stop];
 #if !TARGET_OS_IPHONE
             ds4_release(p);
+            pro_release(p);
 #endif
             channels[p]=[NSMutableArray new]; nativeOutputs[p]=[output copy]; dm_haptics_route(p,1);
         });
@@ -571,6 +669,7 @@ void dm_haptics_apple_teardown(void) {
                 sinks[p] = NULL;
 #if !TARGET_OS_IPHONE
                 ds4_release(p);
+                pro_release(p);
 #endif
                 channels[p] = nil;
                 nativeOutputs[p] = nil;
@@ -612,6 +711,10 @@ void dm_haptics_apple_init(void) {
     if (e && *e) { float v = strtof(e, &end); if (end != e && !*end && isfinite(v)) rumble_min = fmaxf(0, fminf(0.9f, v)); }
     e = getenv("DM_RUMBLE");
     dm_haptics_init(apply, !e || atoi(e) != 0);
+#if !TARGET_OS_IPHONE
+    e = getenv("DM_RUMBLE_PRO_REPORT");
+    pro_report_on = e && atoi(e) != 0;
+#endif
 #if TARGET_OS_IPHONE
     phoneSupported = CHHapticEngine.capabilitiesForHardware.supportsHaptics;
 #endif
