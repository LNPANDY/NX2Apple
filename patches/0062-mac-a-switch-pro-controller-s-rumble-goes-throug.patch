+    // Each motor on its own actuator, with the game's bands (HD Rumble bytes, pad_jc1.h); renewed every 40 ms while it plays, never through Core Haptics
+    dm_vibration_update u2[] = {{0, 0, {1, 160, 0, 320}}, {0, 1, {0, 160, 1, 320}}};
+    dm_haptics_send(u2, 2); drain();
+    b = proBt.reports.lastObject.bytes;
+    assert(proBt.reports.count == 2 && proBt.reports[1].length == 49 && b[0] == 0x10 && (b[1] & 0x0F) == 1);
+    assert(!memcmp(b + 2, (uint8_t[]){0x00, 0x01, 0x40, 0x72, 0x00, 0xC9, 0x40, 0x40}, 8));
+    advance(0.1);
+    assert(proBt.reports.count >= 4 && !memcmp((const uint8_t *)proBt.reports.lastObject.bytes + 2, (uint8_t[]){0x00, 0x01, 0x40, 0x72, 0x00, 0xC9, 0x40, 0x40}, 8) && sp.haptics.attempts == 0);
+    // The gain scales the amplitude, and a motor at rest keeps the neutral bytes
+    uint8_t half[4]; dm_vibration hv = {0.5f, 160, 0, 320}; jc1_rumble_encode(&hv, half);
+    gain = 0.5f; send_pair(1, 0); drain();
+    assert(half[3] != 0x72 && !memcmp((const uint8_t *)proBt.reports.lastObject.bytes + 2, half, 4) && !memcmp((const uint8_t *)proBt.reports.lastObject.bytes + 6, neutral, 4));
