diff --git a/dm/host/tests/t_haptics_apple.m b/dm/host/tests/t_haptics_apple.m
index 041eb69..d87b1d9 100644
--- a/dm/host/tests/t_haptics_apple.m
+++ b/dm/host/tests/t_haptics_apple.m
@@ -169,9 +169,10 @@ static void test_dispatch_after(dispatch_time_t when, dispatch_queue_t target, d
 // A HID device in the fake registry: its entry (one per connection), and the handles made on it
 @interface TestHid : NSObject
 @property io_service_t service;
-@property int product, opens, closes;
+@property int vendor, product, opens, closes;
 @property BOOL bluetooth, failOpen;
 @property NSData *report;
+@property NSMutableArray<NSData *> *reports;   // every report sent to it, oldest first
 @end
 @implementation TestHid
 @end
@@ -187,18 +188,28 @@ static NSUInteger listedNext;
 static int objects;   // iterators and services not released yet
 static TestHid *hid_add(int product) {
     static io_service_t next = 1000;
-    TestHid *h = [TestHid new]; h.service = next++; h.product = product; h.bluetooth = YES;
+    TestHid *h = [TestHid new]; h.service = next++; h.vendor = 0x054C; h.product = product; h.bluetooth = YES; h.reports = [NSMutableArray new];
     [registry addObject:h]; return h;
 }
+static TestHid *pro_hid_add(void) { TestHid *h = hid_add(0x2009); h.vendor = 0x057E; return h; }
+static TestHid *pro_hid_of(int player) {
+    __block IOHIDDeviceRef d; dispatch_sync(queue, ^{ d = pro[player].dev; });
+    return d ? ((__bridge TestHandle *)d).hid : nil;
+}
 static TestHid *hid_of(int player) {
     __block IOHIDDeviceRef d; dispatch_sync(queue, ^{ d = ds4[player].dev; });
     return d ? ((__bridge TestHandle *)d).hid : nil;
 }
 static kern_return_t test_matching_services(mach_port_t port, CFDictionaryRef match, io_iterator_t *it) {
     (void)port;
-    assert(!listed && [(__bridge NSNumber *)CFDictionaryGetValue(match, CFSTR(kIOHIDVendorIDKey)) intValue] == 0x054C);
+    int vendor = [(__bridge NSNumber *)CFDictionaryGetValue(match, CFSTR(kIOHIDVendorIDKey)) intValue];
+    NSNumber *product = (__bridge NSNumber *)CFDictionaryGetValue(match, CFSTR(kIOHIDProductIDKey));
+    assert(!listed && (vendor == 0x054C || vendor == 0x057E));
     CFRelease(match);
-    listed = [registry copy]; listedNext = 0; objects++; *it = SONY_ITERATOR;
+    listed = [registry filteredArrayUsingPredicate:[NSPredicate predicateWithBlock:^BOOL(TestHid *h, NSDictionary *b) {
+        (void)b; return h.vendor == vendor && (!product || h.product == product.intValue);
+    }]];
+    listedNext = 0; objects++; *it = SONY_ITERATOR;
     return KERN_SUCCESS;
 }
 static io_object_t test_iterator_next(io_iterator_t it) {
@@ -223,6 +234,7 @@ static IOHIDDeviceRef test_device_create(CFAllocatorRef a, io_service_t s) {
 static CFTypeRef test_device_property(IOHIDDeviceRef d, CFStringRef key) {
     TestHid *h = ((__bridge TestHandle *)d).hid;
     if (CFEqual(key, CFSTR(kIOHIDProductIDKey))) return (__bridge CFTypeRef)@(h.product);
+    if (CFEqual(key, CFSTR(kIOHIDMaxOutputReportSizeKey))) return (__bridge CFTypeRef)@(h.bluetooth ? 49 : 64);
     assert(CFEqual(key, CFSTR(kIOHIDTransportKey)));
     return (__bridge CFTypeRef)(h.bluetooth ? @"Bluetooth" : @"USB");
 }
@@ -237,6 +249,7 @@ static IOReturn test_device_report(IOHIDDeviceRef d, IOHIDReportType t, CFIndex
     assert(t == kIOHIDReportTypeOutput && id == r[0] && h.opens > h.closes);
     if (![registry containsObject:h]) return kIOReturnNoDevice;
     h.report = [NSData dataWithBytes:r length:n];
+    [h.reports addObject:h.report];
     return kIOReturnSuccess;
 }
 static void drain(void) { dispatch_sync(queue, ^{}); dispatch_sync(queue, ^{}); }
@@ -608,6 +621,56 @@ int main(void) { @autoreleasepool {
     assert(nativeStops && !outputOwners[0] && !nativeOutputs[0] && channels[0].count==1 && [controllerLocalities[0] isEqual:GCHapticsLocalityLeftHandle]);
     dm_haptics_apple_controller(0, nil); dm_haptics_apple_controller(1, nil); drain();
     assert(ds4_crc((const uint8_t *)"123456789", 9) == 0xCBF43926u);   // the report's CRC32 (IEEE, reflected)
+    // A Switch Pro Controller (or a pad presenting itself as one, LNPANDY/NX2Apple#1194) gets its rumble report while a 057E / 2009 device is free; vibration is turned on once
+    static const uint8_t neutral[8] = {0x00, 0x01, 0x40, 0x40, 0x00, 0x01, 0x40, 0x40};
+    registry = [NSMutableArray new];
+    hid_add(0x05C4);   // a Sony device is not a Pro Controller's
+    TestHid *proBt = pro_hid_add();
+    TestController *sp = [TestController new]; sp.haptics = [TestHaptics new]; sp.productCategory = @"Switch Pro Controller";
+    // Without DM_RUMBLE_PRO_REPORT=1 it stays on Core Haptics and the device is left alone
+    assert(!pro_report_on);
+    dm_haptics_apple_controller(0, (id)sp); drain();
+    assert(!pro_hid_of(0) && proBt.opens == 0 && channels[0].count == 1 && ![channels[0][0] isKindOfClass:DmProChannel.class]);
+    dm_haptics_apple_controller(0, nil); drain();
