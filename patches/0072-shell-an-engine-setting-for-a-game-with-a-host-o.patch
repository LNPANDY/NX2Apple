@@ -164,6 +164,14 @@ class ShellGlueProvidesWhatFrontIosTakes(unittest.TestCase):
         missing = [n for n in dict.fromkeys(wanted) if not re.search(r'^[A-Za-z_][\w \t\*]*?\b' + n + r'\([^)]*\)[ \t]*\{', shell, re.M)]
         self.assertEqual(missing, [], 'ShellGlue.m does not define what front_ios.m takes from main.m')
 
+    def test_the_engine_setting_is_the_one_shell_main_reads(self):
+        # settings.tsv's DM_SHELL_HOST offers shared, the value with which ShellMain.m keeps the built-in host
+        row = next(line.split('\t') for line in (REPO / 'dm/games/settings.tsv').read_text().splitlines() if line.startswith('DM_SHELL_HOST\t'))
