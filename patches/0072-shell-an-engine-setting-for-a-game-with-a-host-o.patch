+        main = (REPO / 'dm/ios/Shell/ShellMain.m').read_text()
+        self.assertIn('"DM_SHELL_HOST"', main)
+        self.assertIn('"shared"', main)
+
     def test_the_glue_does_not_use_the_app(self):
         # A game's own host is linked without the app's code: the Swift side (DmShell-Swift.h, ShellLibrary) stays in ShellMain.m
         glue = (REPO / 'dm/ios/Shell/ShellGlue.m').read_text()
