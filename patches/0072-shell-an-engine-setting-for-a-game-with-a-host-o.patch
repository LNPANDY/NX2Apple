                                 const char *executable, const char *marker, const char *log_path, const char *cwd) {
     static char err[512];
     NSString *host = executable ? own_host(executable) : nil;
+    // The game's Engine setting (DM_SHELL_HOST, settings.tsv): shared keeps the built-in host, to compare the two
+    for (int i = 0; host && i < n; i++)
+        if (!strcmp(keys[i], "DM_SHELL_HOST") && !strcmp(values[i], "shared")) {
+            fprintf(stderr, "shell: the game has its own host %s, and its Engine setting chose the shared app's\n", host.UTF8String);
+            host = nil;
+        }
     if (host) {
         // RTLD_NOW: a host that cannot bind fails here, with dyld's reason, and not in the middle of the game
         void *h = dlopen(host.fileSystemRepresentation, RTLD_NOW | RTLD_LOCAL);
