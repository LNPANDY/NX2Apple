{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is not a DM_ switch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kein DM_-Schalter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is not a DM_ switch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no es un interruptor DM_."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas un réglage DM_."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” non è un interruttore DM_."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" は DM_ スイッチではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) DM_ 스위치가 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não é uma chave DM_."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” är ingen DM_-växel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 不是 DM_ 开关。"
          }
        }
      }
    },
    "%@ (from Settings)": {
