    "That file or archive contains an unsafe path or symbolic link and was rejected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei oder das Archiv enthält einen unsicheren Pfad oder symbolischen Link und wurde abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file or archive contains an unsafe path or symbolic link and was rejected."
          }
        },
        "es": {
