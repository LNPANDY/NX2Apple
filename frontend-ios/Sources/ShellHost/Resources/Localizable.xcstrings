    "%@ has the same title ID %@ as %@, which is used instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat dieselbe Title-ID %@ wie %@, das stattdessen verwendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has the same title ID %@ as %@, which is used instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene el mismo ID de título %@ que %@, que es el que se usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a le même ID de titre %@ que %@, qui est utilisé à sa place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha lo stesso ID titolo %@ di %@, che viene usato al suo posto."
