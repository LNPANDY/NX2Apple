    "Choose a data type and enter a starting value to scan game memory.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datentyp wählen und Startwert eingeben, um den Spielspeicher zu durchsuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a data type and enter a starting value to scan game memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un tipo de dato e introduce un valor inicial para buscar en memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un type et saisissez une valeur initiale pour analyser la mémoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un tipo di dato e inserisci un valore iniziale per cercare in memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データ型を選択し、開始値を入力してゲームメモリを検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 유형을 선택하고 시작 값을 입력해 게임 메모리를 검색하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um tipo de dado e informe um valor inicial para buscar na memória."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj datatyp och ange ett startvärde för att söka i spelminnet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择数值类型并输入初始数值以搜索游戏内存。"
          }
        }
      }
    },
    "Choose a destination outside the save folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Ziel außerhalb des Spielstandordners."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a destination outside the save folder."
          }
        },
        "es": {
