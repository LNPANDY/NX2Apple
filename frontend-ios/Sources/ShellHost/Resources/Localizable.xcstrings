    "Could not load the game framework because the signing certificate does not match this app. Reinstall the app from your computer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel-Framework konnte nicht geladen werden, da das Signaturzertifikat nicht zur App passt. Installiere die App auf dem Computer neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load the game framework because the signing certificate does not match this app. Reinstall the app from your computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el framework del juego porque el certificado de firma no coincide con esta app. Vuelve a instalar la app desde tu ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger le framework du jeu car le certificat de signature ne correspond pas à cette application. Réinstallez l'application depuis votre ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare il framework del gioco perché il certificato di firma non corrisponde a questa app. Reinstalla l'app dal tuo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名証明書がアプリと一致しないためゲームフレームワークを読み込めません。パソコンからアプリを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명 인증서가 앱과 일치하지 않아 게임 프레임워크를 불러올 수 없습니다. 컴퓨터에서 앱을 다시 설치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o framework do jogo porque o certificado de assinatura não corresponde ao deste app. Reinstale o app pelo computador."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att läsa in spelramverket eftersom signeringscertifikatet inte stämmer överens med appen. Installera om appen från datorn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载游戏框架：证书不一致，请在电脑上重新安装。"
          }
        }
      }
    },
