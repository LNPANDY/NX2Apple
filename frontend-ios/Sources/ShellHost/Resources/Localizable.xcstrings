    "Re-signing failed. Check your identity and profile. iOS must accept the signature. The installed game was not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das erneute Signieren ist fehlgeschlagen. Prüfe deine Signieridentität und dein Profil. iOS muss die Signatur akzeptieren. Das installierte Spiel wurde nicht verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-signing failed. Check your identity and profile. iOS must accept the signature. The installed game was not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido volver a firmar. Comprueba tu identidad y tu perfil. iOS debe aceptar la firma. El juego instalado no se ha modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle signature a échoué. Vérifiez votre identité et votre profil. iOS doit accepter la signature. Le jeu installé n’a pas été modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile firmare di nuovo. Controlla la tua identità e il profilo. iOS deve accettare la firma. Il gioco installato non è stato modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再署名に失敗しました。署名用IDとプロファイルを確認してください。iOSが署名を承認する必要があります。インストール済みのゲームは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 서명하지 못했습니다. 서명 ID와 프로파일을 확인하세요. iOS가 서명을 승인해야 합니다. 설치된 게임은 변경되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível assinar novamente. Confira sua identidade e seu perfil. O iOS precisa aceitar a assinatura. O jogo instalado não foi alterado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omsigneringen misslyckades. Kontrollera din signeringsidentitet och profil. iOS måste godkänna signaturen. Det installerade spelet har inte ändrats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新签名失败。请检查签名身份和描述文件。签名必须获得 iOS 认可。已安装的游戏未改动。"
          }
        }
      }
    },
