            "state": "translated",
            "value": "Ese archivo supera el límite de tamaño o de cantidad de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette archive dépasse la limite de taille ou de nombre de fichiers."
          }
        },
