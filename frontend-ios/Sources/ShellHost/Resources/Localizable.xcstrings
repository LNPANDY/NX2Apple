    "Choose the folder holding romfs.img (or the game's title ID folder) on this device, an external drive, or iCloud Drive.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ordner mit romfs.img (oder den Title-ID-Ordner des Spiels) auf diesem Gerät, einem externen Laufwerk oder in iCloud Drive."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder holding romfs.img (or the game's title ID folder) on this device, an external drive, or iCloud Drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la carpeta que contiene romfs.img (o la carpeta del ID de título del juego) en este dispositivo, una unidad externa o iCloud Drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le dossier contenant romfs.img (ou le dossier d’identifiant du jeu) sur cet appareil, un disque externe ou iCloud Drive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la cartella che contiene romfs.img (o la cartella con l’ID titolo del gioco) su questo dispositivo, un’unità esterna o iCloud Drive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス、外部ドライブ、または iCloud Drive 上で romfs.img が入ったフォルダ（またはゲームのタイトル ID フォルダ）を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기, 외장 드라이브 또는 iCloud Drive에서 romfs.img가 들어 있는 폴더(또는 게임의 타이틀 ID 폴더)를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a pasta que contém romfs.img (ou a pasta do ID do título do jogo) neste dispositivo, em uma unidade externa ou no iCloud Drive."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj mappen som innehåller romfs.img (eller spelets titel-ID-mapp) på den här enheten, en extern enhet eller iCloud Drive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备、外置硬盘或 iCloud Drive 上选择包含 romfs.img 的文件夹（或游戏的 Title ID 文件夹）。"
          }
        }
      }
    },
