        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gioco è stato compilato per un’altra versione di questa app. Aggiorna l’app o ricompila il gioco nel launcher sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームは別のバージョンのアプリ用にビルドされています。アプリをアップデートするか、Mac のランチャーでゲームを再ビルドしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임은 이 앱의 다른 버전용으로 빌드되었습니다. 앱을 업데이트하거나 Mac의 런처에서 게임을 다시 빌드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este jogo foi compilado para outra versão deste app. Atualize o app ou refaça o build do jogo no launcher do seu Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här spelet byggdes för en annan version av appen. Uppdatera appen eller bygg om spelet i launchern på din Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此游戏是为本 App 的其它版本构建的。请更新 App 或在 Mac 启动器中重新构建。"
          }
        }
      }
    },
    "This game was updated while the app was open. Close and reopen the app to load the new build.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Spiel wurde aktualisiert, während die App geöffnet war. Schließe die App und öffne sie erneut, um die neue Version zu laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game was updated while the app was open. Close and reopen the app to load the new build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este juego se actualizó mientras la app estaba abierta. Cierra y vuelve a abrir la app para cargar la nueva versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu a été mis à jour pendant que l’app était ouverte. Fermez puis rouvrez l’app pour charger la nouvelle version."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gioco è stato aggiornato mentre l’app era aperta. Chiudi e riapri l’app per caricare la nuova versione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開いている間にこのゲームが更新されました。新しいビルドを読み込むには、アプリを一度閉じて開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 열려 있는 동안 이 게임이 업데이트되었습니다. 새 빌드를 불러오려면 앱을 닫았다가 다시 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este jogo foi atualizado enquanto o app estava aberto. Feche e abra o app novamente para carregar a nova compilação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här spelet uppdaterades medan appen var öppen. Stäng och öppna appen igen för att läsa in den nya versionen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用打开期间此游戏已更新。请关闭并重新打开应用以加载新版本。"
          }
        }
      }
    },
    "This game's files are damaged. Rebuild the game in the launcher on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien dieses Spiels sind beschädigt. Baue das Spiel im Launcher auf deinem Mac neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game's files are damaged. Rebuild the game in the launcher on your Mac."
          }
        },
        "es": {
