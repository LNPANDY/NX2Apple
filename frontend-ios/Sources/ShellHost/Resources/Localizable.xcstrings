    "Check the P12 password and use a profile from this app's signing team.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe das P12-Passwort und verwende ein Profil vom Signierteam dieser App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the P12 password and use a profile from this app's signing team."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la contraseña del P12 y usa un perfil del equipo que firmó esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le mot de passe du P12 et utilisez un profil de l’équipe qui a signé cette app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la password del P12 e usa un profilo del team che ha firmato questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "P12のパスワードを確認し、このアプリの署名チームのプロファイルを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "P12 비밀번호를 확인하고 이 앱에 서명한 팀의 프로파일을 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira a senha do P12 e use um perfil da equipe que assinou este app."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera P12-lösenordet och använd en profil från teamet som signerade den här appen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查 P12 密码，并使用与此应用签名团队匹配的描述文件。"
          }
        }
      }
    },
    "Check your signing identity in Settings and unlock this device, then try again. The installed game was not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Signierungsidentität in den Einstellungen und entsperre dieses Gerät. Versuche es dann erneut. Das installierte Spiel wurde nicht verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your signing identity in Settings and unlock this device, then try again. The installed game was not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu identidad de firma en Ajustes y desbloquea este dispositivo. Después, inténtalo de nuevo. El juego instalado no se ha modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre identité de signature dans les réglages et déverrouillez cet appareil, puis réessayez. Le jeu installé n’a pas été modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la tua identità di firma nelle Impostazioni e sblocca questo dispositivo, poi riprova. Il gioco installato non è stato modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で署名情報を確認し、このデバイスのロックを解除してから、もう一度お試しください。インストール済みのゲームは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 서명 정보를 확인하고 이 기기의 잠금을 해제한 뒤 다시 시도하세요. 설치된 게임은 변경되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua identidade de assinatura nos Ajustes e desbloqueie este dispositivo. Depois, tente novamente. O jogo instalado não foi alterado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera din signeringsidentitet i Inställningar och lås upp enheten. Försök sedan igen. Det installerade spelet ändrades inte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中检查签名身份并解锁此设备，然后重试。已安装的游戏未被更改。"
          }
        }
      }
    },
