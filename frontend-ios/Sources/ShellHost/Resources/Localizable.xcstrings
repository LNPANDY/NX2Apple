      }
    },
    "The game's code is missing from this app. Rebuild and reinstall it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code des Spiels fehlt in dieser App. Baue es neu und installiere es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game's code is missing from this app. Rebuild and reinstall it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el código del juego en esta app. Vuelve a compilarla y a instalarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code du jeu manque dans cette app. Recompilez-le et réinstallez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa app manca il codice del gioco. Ricompilalo e installalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリにゲームのコードがありません。再ビルドして、もう一度インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
