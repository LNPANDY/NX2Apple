          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 中缺少游戏代码。请重新构建并安装。"
          }
        }
      }
    },
    "The game's framework executable could not be read. Install the game again from NX2Apple.": {
      "localizations": {
