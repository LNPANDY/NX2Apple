    "Launch this game once to finish syncing your previous cloud save before importing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte dieses Spiel einmal, um die vorherige Cloud-Synchronisierung abzuschließen, bevor du importierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch this game once to finish syncing your previous cloud save before importing."
          }
        },
        "es": {
