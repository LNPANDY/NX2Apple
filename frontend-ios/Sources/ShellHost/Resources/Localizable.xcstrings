            "value": "폴더 이름은 %@인데 매니페스트에는 %@(으)로 되어 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta se chama %@, mas o manifesto diz %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen heter %@ men manifestet anger %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹名为 %@，但清单显示 %@。"
          }
        }
      }
    },
    "The folder picker could not open here. Open the app on its own and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ordnerauswahl konnte hier nicht geöffnet werden. Öffne die App allein und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder picker could not open here. Open the app on its own and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El selector de carpetas no se pudo abrir aquí. Abre la app por separado e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sélecteur de dossier n’a pas pu s’ouvrir ici. Ouvrez l’app seule et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il selettore di cartelle non si è potuto aprire qui. Apri l’app da sola e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではフォルダ選択を開けませんでした。アプリを単独で開いて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 폴더 선택기를 열 수 없습니다. 앱을 단독으로 열고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seletor de pastas não pôde ser aberto aqui. Abra o app sozinho e tente de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappväljaren kunde inte öppnas här. Öppna appen på egen hand och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处无法打开文件夹选择器。请单独打开此 App 后再试。"
          }
        }
      }
    },
    "The folder you chose before is no longer readable. Please choose it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner, den du vorher gewählt hast, ist nicht mehr lesbar. Bitte wähle ihn erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder you chose before is no longer readable. Please choose it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta que elegiste antes ya no se puede leer. Elígela de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier choisi auparavant n’est plus lisible. Choisissez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella scelta prima non è più leggibile. Sceglila di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前選んだフォルダを読み込めなくなりました。もう一度選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전에 선택한 폴더를 더는 읽을 수 없습니다. 다시 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta que você escolheu antes não pode mais ser lida. Escolha-a de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen du valde tidigare går inte längre att läsa. Välj den igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前选择的文件夹已无法读取。请重新选择。"
          }
