    "This app signature does not support loading games from Documents/Frameworks. Reinstall the app from NX2Apple on your computer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App-Signatur unterstützt kein Hot-Loading von Spielen aus Documents/Frameworks. Installiere die App über NX2Apple auf dem Computer neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app signature does not support loading games from Documents/Frameworks. Reinstall the app from NX2Apple on your computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma de esta app no admite la carga en caliente desde Documents/Frameworks. Vuelve a instalar la app desde NX2Apple en tu ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La signature de cette application ne permet pas de charger des jeux depuis Documents/Frameworks. Réinstallez l'application depuis NX2Apple sur votre ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa firma dell'app non supporta il caricamento di giochi da Documents/Frameworks. Reinstalla l'app da NX2Apple sul tuo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリ署名では Documents/Frameworks からのゲーム読み込みに対応していません。パソコンの NX2Apple からアプリを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 앱 서명은 Documents/Frameworks에서 게임을 불러올 수 없습니다. 컴퓨터의 NX2Apple에서 앱을 다시 설치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura deste app não oferece suporte ao carregamento de jogos de Documents/Frameworks. Reinstale o app pelo NX2Apple no computador."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här appsignaturen stöder inte inläsning av spel från Documents/Frameworks. Installera om appen från NX2Apple på datorn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前应用签名不支持从 Documents/Frameworks 热加载游戏。请在电脑端 NX2Apple 重新安装应用。"
          }
        }
      }
