    "“%@” holds unjoined .nxpart split files. External folders cannot read split parts directly. Copy them to games/%@ in this app's folder in Files to join automatically, or use a whole romfs.img.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ enthält nicht zusammengefügte .nxpart-Teildateien. Externe Ordner können Teildateien nicht direkt lesen. Kopiere sie in „Dateien“ nach games/%@ im Ordner dieser App, um sie automatisch zusammenzufügen, oder verwende eine vollständige romfs.img."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” holds unjoined .nxpart split files. External folders cannot read split parts directly. Copy them to games/%@ in this app's folder in Files to join automatically, or use a whole romfs.img."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» contiene archivos divididos .nxpart sin unir. Las carpetas externas no pueden leer partes divididas directamente. Cópialos en games/%@ dentro de la carpeta de esta app en Archivos para unirlos automáticamente, o usa un archivo romfs.img completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » contient des fichiers .nxpart non assemblés. Les dossiers externes ne peuvent pas lire directement des parties découpées. Copiez-les dans games/%@ du dossier de cette app dans Fichiers pour les assembler automatiquement, ou utilisez un fichier romfs.img complet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» contiene file divisi .nxpart non uniti. Le cartelle esterne non possono leggere direttamente le parti divise. Copiali in games/%@ nella cartella di questa app in File per unirli automaticamente, oppure usa un file romfs.img intero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」には未結合の .nxpart 分割ファイルがあります。外部フォルダからは分割ファイルを直接読み込めません。「ファイル」でこのアプリのフォルダ内の games/%@ にコピーして自動結合するか、結合済みの romfs.img を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 폴더에 병합되지 않은 .nxpart 분할 파일이 있습니다. 외부 폴더에서는 분할 파일을 직접 읽을 수 없습니다. ‘파일’ 앱에서 이 앱 폴더의 games/%@ 경로로 복사해 자동 병합하거나 단일 romfs.img 파일을 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” contém arquivos divididos .nxpart não unidos. Pastas externas não podem ler partes divididas diretamente. Copie-os para games/%@ na pasta deste app no Arquivos para unir automaticamente ou use um romfs.img completo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” innehåller oihopsatta .nxpart-delfiler. Externa mappar kan inte läsa delfiler direkt. Kopiera dem till games/%@ i den här appens mapp i Filer för att slå ihop dem automatiskt, eller använd en hel romfs.img."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”中包含未合并的 .nxpart 分片文件。外部文件夹无法直接读取分片，请在“文件”中将它们拷贝到本应用文件夹下的 games/%@ 以自动合并，或使用完整的 romfs.img。"
          }
        }
      }
    }
  },
  "version": "1.0"
}