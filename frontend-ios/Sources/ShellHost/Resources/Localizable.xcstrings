    "Game data for %@ in “%@” has not been downloaded from iCloud Drive yet. Download it in Files first, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spieldaten für %@ in „%@“ wurden noch nicht aus iCloud Drive geladen. Lade sie zuerst in „Dateien“ herunter und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game data for %@ in “%@” has not been downloaded from iCloud Drive yet. Download it in Files first, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos del juego de %@ en «%@» aún no se han descargado de iCloud Drive. Descárgalos primero en Archivos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de jeu de %@ dans « %@ » n’ont pas encore été téléchargées depuis iCloud Drive. Téléchargez-les d’abord dans Fichiers, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di gioco di %@ in «%@» non sono ancora stati scaricati da iCloud Drive. Scaricali prima nell’app File, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のゲームデータ（「%@」内）はまだ iCloud Drive からダウンロードされていません。先に「ファイル」でダウンロードしてからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 게임 데이터(‘%@’ 폴더)가 아직 iCloud Drive에서 다운로드되지 않았습니다. 먼저 ‘파일’ 앱에서 다운로드한 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados do jogo de %@ em “%@” ainda não foram baixados do iCloud Drive. Baixe-os primeiro no app Arquivos e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Speldata för %@ i ”%@” har inte hämtats från iCloud Drive än. Hämta dem först i Filer och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在“%@”中的游戏数据尚未从 iCloud Drive 下载。请先在“文件”中下载后再试。"
          }
        }
      }
    },
    "Game data for %@ is inside the subfolder “%@”. Choose that inner folder directly so the game can read its files.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spieldaten für %@ liegen im Unterordner „%@“. Wähle diesen inneren Ordner direkt aus, damit das Spiel seine Dateien lesen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game data for %@ is inside the subfolder “%@”. Choose that inner folder directly so the game can read its files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de juego de %@ están dentro de la subcarpeta «%@». Elige directamente esa carpeta interna para que el juego pueda leer sus archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de jeu de %@ se trouvent dans le sous-dossier « %@ ». Choisissez directement ce dossier interne pour que le jeu puisse lire ses fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di gioco di %@ si trovano nella sottocartella «%@». Scegli direttamente quella cartella interna così il gioco potrà leggere i suoi file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のゲームデータはサブフォルダ「%@」の中にあります。ゲームがファイルを読み取れるよう、その内側のフォルダを直接選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 게임 데이터가 하위 폴더 ‘%@’ 안에 있습니다. 게임이 파일을 읽을 수 있도록 해당 안쪽 폴더를 직접 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de jogo de %@ estão dentro da subpasta “%@”. Escolha essa pasta interna diretamente para que o jogo possa ler os arquivos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Speldata för %@ ligger i undermappen ”%@”. Välj den inre mappen direkt så att spelet kan läsa sina filer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的游戏数据位于子文件夹“%@”内。请直接选择该内层文件夹，以便游戏读取文件。"
          }
        }
      }
    },
