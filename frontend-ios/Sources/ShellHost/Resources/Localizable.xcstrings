            "state": "translated",
            "value": "本 App 的文件夹"
          }
        }
      }
    },
    "This app's folder has no data for this game yet. Copy it to games/%@ in this app's folder in Files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app's folder has no data for this game yet. Copy it to games/%@ in this app's folder in Files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 的文件夹中还没有此游戏的数据。请拷贝到 games/%@，或点「使用应用数据」。"
          }
        }
      }
    },
    "This game has no launcher.json.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game has no launcher.json."
