    "This game was built for a different version of this app. Update the app or rebuild the game in the launcher on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Spiel wurde für eine andere Version dieser App gebaut. Aktualisiere die App oder baue das Spiel im Launcher auf deinem Mac neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game was built for a different version of this app. Update the app or rebuild the game in the launcher on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este juego se compiló para otra versión de esta app. Actualiza la app o vuelve a compilar el juego en el lanzador de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu a été compilé pour une autre version de cette app. Mettez l’app à jour ou recompilez le jeu dans le lanceur sur votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gioco è stato compilato per un’altra versione di questa app. Aggiorna l’app o ricompila il gioco nel launcher sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームは別のバージョンのアプリ用にビルドされています。アプリをアップデートするか、Mac のランチャーでゲームを再ビルドしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임은 이 앱의 다른 버전용으로 빌드되었습니다. 앱을 업데이트하거나 Mac의 런처에서 게임을 다시 빌드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este jogo foi compilado para outra versão deste app. Atualize o app ou refaça o build do jogo no launcher do seu Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här spelet byggdes för en annan version av appen. Uppdatera appen eller bygg om spelet i launchern på din Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此游戏是为本 App 的其它版本构建的。请更新 App 或在 Mac 启动器中重新构建。"
          }
        }
      }
    },
    "This game's files are damaged. Rebuild the game in the launcher on your Mac.": {
      "localizations": {
