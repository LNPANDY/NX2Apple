            "state": "translated",
            "value": "Ese archivo contiene una ruta no segura o un enlace simbólico y fue rechazado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ou cette archive contient un chemin non sûr ou un lien symbolique et a été rejeté."
          }
        },
        "it": {
