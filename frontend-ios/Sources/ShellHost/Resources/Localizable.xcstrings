    "Shader files (msl) for this game are incomplete or still transferring. Wait for transfer to complete or send the game data again from NX2Apple.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Shader-Dateien (msl) für dieses Spiel sind unvollständig oder werden noch übertragen. Warte, bis die Übertragung abgeschlossen ist, oder sende die Spieldaten erneut aus NX2Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shader files (msl) for this game are incomplete or still transferring. Wait for transfer to complete or send the game data again from NX2Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de shaders (msl) de este juego están incompletos o aún se están transfiriendo. Espera a que termine la transferencia o vuelve a enviar los datos del juego desde NX2Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de shaders (msl) de ce jeu sont incomplets ou en cours de transfert. Attendez la fin du transfert ou renvoyez les données du jeu depuis NX2Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file shader (msl) per questo gioco sono incompleti o ancora in fase di trasferimento. Attendi il completamento del trasferimento o invia di nuovo i dati di gioco da NX2Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームのシェーダーファイル（msl）が不完全であるか、転送中です。転送が完了するのを待つか、NX2Apple からゲームデータをもう一度送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임의 셰이더 파일(msl)이 불완전하거나 아직 전송 중입니다. 전송이 완료될 때까지 기다리거나 NX2Apple에서 게임 데이터를 다시 보내세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos de shaders (msl) deste jogo estão incompletos ou ainda estão sendo transferidos. Aguarde a transferência terminar ou envie os dados do jogo novamente pelo NX2Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Shaderfilerna (msl) för det här spelet är ofullständiga eller överförs fortfarande. Vänta tills överföringen är klar eller skicka speldatan igen från NX2Apple."
          }
        },
        "zh-Hans": {
