    "Restored the save backup from %@. Your previous save was backed up first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speicherdaten-Backup vom %@ wurde wiederhergestellt. Dein vorheriger Spielstand wurde zuvor gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored the save backup from %@. Your previous save was backed up first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restauró la copia de seguridad de guardado de %@. Tu partida anterior se respaldó primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde de secours du %@ a été restaurée. Votre sauvegarde précédente a d’abord été mise de côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup dei dati di salvataggio del %@ ripristinato. Il salvataggio precedente è stato prima copiato nei backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のセーブバックアップを復元しました。直前のセーブデータも先にバックアップされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 세이브 백업을 복원했습니다. 이전 세이브 데이터도 먼저 백업되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup de salvamento de %@ foi restaurado. Seu salvamento anterior foi copiado antes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställde säkerhetskopian från %@. Din tidigare sparfil säkerhetskopierades först."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢复 %@ 的存档备份，恢复前的存档也已先行备份。"
          }
        }
      }
    },
