          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar la identidad de firma. Desbloquea este dispositivo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identité de signature n’a pas pu être enregistrée. Déverrouillez cet appareil et réessayez."
