        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este jogo foi compilado para outra versão deste app. Atualize o app ou refaça o build do jogo no launcher do seu Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
