    "Unsaved progress will be lost. The app closes. Open it again to get back to your games.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gesicherter Fortschritt geht verloren. Die App wird geschlossen. Öffne sie erneut, um zu deinen Spielen zurückzukehren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsaved progress will be lost. The app closes. Open it again to get back to your games."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderá el progreso sin guardar. La app se cierra. Ábrela de nuevo para volver a tus juegos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression non sauvegardée sera perdue. L’app se ferme. Rouvrez-la pour revenir à vos jeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progressi non salvati andranno persi. L’app si chiude. Riaprila per tornare ai tuoi giochi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存していない進行状況は失われます。アプリが閉じます。もう一度開くとゲーム一覧に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 않은 진행 상황은 사라집니다. 앱이 닫힙니다. 게임으로 돌아가려면 다시 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso não salvo será perdido. O app fecha. Abra-o de novo para voltar aos seus jogos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Osparade framsteg går förlorade. Appen stängs. Öppna den igen för att komma tillbaka till dina spel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存的进度将会丢失。App 会关闭，再次打开即可回到你的游戏。"
          }
        }
      }
    },
