          "stringUnit": {
            "state": "translated",
            "value": "%@ kunde inte startas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动 %@。"
          }
        }
      }
    },
    "%@ has a wrong or missing value at \"%@\".": {
      "localizations": {
