    },
    "This game's framework in Documents/Frameworks is unsigned. Reinstall it with the same signing team from NX2Apple, or import your sideload .p12 certificate in Settings to sign it automatically on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Framework dieses Spiels in Documents/Frameworks ist unsigniert. Installiere es mit demselben Signaturteam aus NX2Apple neu oder importiere dein Sideload-.p12-Zertifikat in den Einstellungen, um es auf diesem Gerät automatisch zu signieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game's framework in Documents/Frameworks is unsigned. Reinstall it with the same signing team from NX2Apple, or import your sideload .p12 certificate in Settings to sign it automatically on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El framework de este juego en Documents/Frameworks no está firmado. Reinstálalo con el mismo equipo de firma desde NX2Apple o importa tu certificado .p12 de sideload en Ajustes para firmarlo automáticamente en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le framework de ce jeu dans Documents/Frameworks n'est pas signé. Réinstallez-le avec la même équipe de signature depuis NX2Apple ou importez votre certificat .p12 de sideload dans Réglages pour le signer automatiquement sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il framework di questo gioco in Documents/Frameworks non è firmato. Reinstallalo con lo stesso team di firma da NX2Apple oppure importa il certificato .p12 di sideload in Impostazioni per firmarlo automaticamente su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents/Frameworks 内のこのゲームのフレームワークは未署名です。NX2Apple から同じ署名チームで再インストールするか、設定でサイドロード用 .p12 証明書を読み込むとこの端末で自動署名して起動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents/Frameworks에 있는 이 게임 프레임워크가 서명되지 않았습니다. NX2Apple에서 같은 서명 팀으로 다시 설치하거나 설정에서 사이드로드 .p12 인증서를 가져오면 이 기기에서 자동으로 서명됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O framework deste jogo em Documents/Frameworks não está assinado. Reinstale com a mesma equipe de assinatura no NX2Apple ou importe seu certificado .p12 de sideload em Ajustes para assiná-lo automaticamente neste dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här spelets framework i Documents/Frameworks saknar signatur. Installera om det med samma signeringsteam från NX2Apple eller importera ditt .p12-certifikat för sidoladdning i Inställningar för automatisk signering på den här enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents/Frameworks 中该游戏的框架未签名。请从 NX2Apple 使用相同签名团队重新安装，或在「设置」中导入侧载 .p12 证书即可在本机自动签名运行。"
          }
        }
      }
    },
    "This game's framework is signed for %@, while this app is signed for team %@. Reinstall it with the same signing team from NX2Apple, or import your sideload .p12 certificate in Settings to sign it automatically on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Framework dieses Spiels ist für %@ signiert, während diese App für Team %@ signiert ist. Installiere es mit demselben Signaturteam aus NX2Apple neu oder importiere dein Sideload-.p12-Zertifikat in den Einstellungen, um es auf diesem Gerät automatisch zu signieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game's framework is signed for %@, while this app is signed for team %@. Reinstall it with the same signing team from NX2Apple, or import your sideload .p12 certificate in Settings to sign it automatically on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El framework de este juego está firmado para %@, mientras que esta app está firmada para el equipo %@. Reinstálalo con el mismo equipo de firma desde NX2Apple o importa tu certificado .p12 de sideload en Ajustes para firmarlo automáticamente en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le framework de ce jeu est signé pour %@, alors que cette app est signée pour l'équipe %@. Réinstallez-le avec la même équipe de signature depuis NX2Apple ou importez votre certificat .p12 de sideload dans Réglages pour le signer automatiquement sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il framework di questo gioco è firmato per %@, mentre questa app è firmata per il team %@. Reinstallalo con lo stesso team di firma da NX2Apple oppure importa il certificato .p12 di sideload in Impostazioni per firmarlo automaticamente su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームのフレームワークは %@ で署名されていますが、このアプリはチーム %@ で署名されています。NX2Apple から同じ署名チームで再インストールするか、設定でサイドロード用 .p12 証明書を読み込むとこの端末で自動署名して起動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임 프레임워크는 %@(으)로 서명되어 있지만 이 앱은 팀 %@(으)로 서명되어 있습니다. NX2Apple에서 같은 서명 팀으로 다시 설치하거나 설정에서 사이드로드 .p12 인증서를 가져오면 이 기기에서 자동으로 서명됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O framework deste jogo está assinado para %@, enquanto este app está assinado para a equipe %@. Reinstale com a mesma equipe de assinatura no NX2Apple ou importe seu certificado .p12 de sideload em Ajustes para assiná-lo automaticamente neste dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här spelets framework är signerat för %@, medan den här appen är signerad för team %@. Installera om det med samma signeringsteam från NX2Apple eller importera ditt .p12-certifikat för sidoladdning i Inställningar för automatisk signering på den här enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该游戏框架的签名团队为 %@，而当前应用的签名团队为 %@。请从 NX2Apple 使用相同签名团队重新安装，或在「设置」中导入侧载 .p12 证书即可在本机自动签名运行。"
          }
        }
      }
    },
