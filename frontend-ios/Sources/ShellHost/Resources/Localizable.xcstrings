    "%@ appears twice in launcher.json.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ steht zweimal in launcher.json."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ appears twice in launcher.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aparece dos veces en launcher.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ apparaît deux fois dans launcher.json."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ compare due volte in launcher.json."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が launcher.json に 2 回出てきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) launcher.json에 두 번 나옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aparece duas vezes em launcher.json."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ förekommer två gånger i launcher.json."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在 launcher.json 中出现了两次。"
          }
        }
      }
    },
    "%@ could not be launched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht gestartet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ could not be launched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas pu être lancé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を起動できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 실행할 수 없습니다."
          }
        },
        "pt-BR": {
