        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したセーブデータを読み込めませんでした。iCloud Drive 上にある場合は「ファイル」でダウンロードしてからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 저장 데이터를 읽을 수 없습니다. iCloud Drive에 있는 경우 파일 앱에서 먼저 다운로드한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o salvamento selecionado. Baixe primeiro no app Arquivos se estiver no iCloud Drive e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
