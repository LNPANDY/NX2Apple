    "This game's framework in Documents/Frameworks is unsigned. Install the game again from NX2Apple.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel-Framework in Documents/Frameworks ist nicht signiert. Installiere das Spiel erneut über NX2Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game's framework in Documents/Frameworks is unsigned. Install the game again from NX2Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El framework de este juego en Documents/Frameworks no tiene firma. Vuelve a instalar el juego desde NX2Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le framework de ce jeu dans Documents/Frameworks n'est pas signé. Réinstallez le jeu depuis NX2Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il framework di questo gioco in Documents/Frameworks non è firmato. Installa di nuovo il gioco da NX2Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents/Frameworks 内のゲームフレームワークが未署名です。NX2Apple からもう一度インストールしてください。"
          }
