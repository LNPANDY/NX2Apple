    "%@ appears twice in launcher.json.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ steht zweimal in launcher.json."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ appears twice in launcher.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aparece dos veces en launcher.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ apparaît deux fois dans launcher.json."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ compare due volte in launcher.json."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が launcher.json に 2 回出てきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) launcher.json에 두 번 나옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aparece duas vezes em launcher.json."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ förekommer två gånger i launcher.json."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在 launcher.json 中出现了两次。"
          }
        }
      }
    },
    "%@ has a wrong or missing value at \"%@\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat einen falschen oder fehlenden Wert bei „%@“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has a wrong or missing value at \"%@\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene un valor incorrecto o ausente en «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a une valeur erronée ou manquante à « %@ »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha un valore errato o mancante in “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の \"%@\" の値が正しくないか、ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 “%@”에 값이 잘못되었거나 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem um valor errado ou ausente em “%@”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ett felaktigt eller saknat värde vid ”%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 \"%@\" 值错误或缺失。"
          }
        }
      }
    },
    "%@ has been re-signed. The expiry date is unavailable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde erneut signiert. Das Ablaufdatum ist nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has been re-signed. The expiry date is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha firmado de nuevo. La fecha de caducidad no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été signé à nouveau. La date d’expiration n’est pas disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato firmato di nuovo. La data di scadenza non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を再署名しました。有効期限を取得できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 다시 서명했습니다. 만료일을 확인할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi assinado novamente. A data de validade não está disponível."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har signerats om. Utgångsdatumet är inte tillgängligt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已重新签名。无法获取到期日期。"
          }
        }
      }
    },
