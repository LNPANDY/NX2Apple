    "The selected save could not be read. Download it in Files first if it is in iCloud Drive, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgewählte Spielstand konnte nicht gelesen werden. Lade ihn zuerst in „Dateien“ aus iCloud Drive herunter und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected save could not be read. Download it in Files first if it is in iCloud Drive, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la partida seleccionada. Descárgala primero en Archivos si está en iCloud Drive e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la sauvegarde sélectionnée. Téléchargez-la d’abord dans Fichiers si elle est sur iCloud Drive, puis réessayez."
