    "iOS rejected this game's signature. Check that your signing identity matches this app. The installed game was not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat die Signatur dieses Spiels abgelehnt. Prüfe, ob deine Signierungsidentität zu dieser App passt. Das installierte Spiel wurde nicht verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS rejected this game's signature. Check that your signing identity matches this app. The installed game was not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ha rechazado la firma de este juego. Comprueba que tu identidad de firma coincide con esta app. El juego instalado no se ha modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS a refusé la signature de ce jeu. Vérifiez que votre identité de signature correspond à cette app. Le jeu installé n’a pas été modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ha rifiutato la firma di questo gioco. Verifica che la tua identità di firma corrisponda a questa app. Il gioco installato non è stato modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSがこのゲームの署名を拒否しました。署名情報がこのアプリと一致するか確認してください。インストール済みのゲームは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 이 게임의 서명을 거부했습니다. 서명 정보가 이 앱과 일치하는지 확인하세요. 설치된 게임은 변경되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS rejeitou a assinatura deste jogo. Verifique se sua identidade de assinatura corresponde a este app. O jogo instalado não foi alterado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS avvisade spelets signatur. Kontrollera att din signeringsidentitet matchar appen. Det installerade spelet ändrades inte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 拒绝了此游戏的签名。请检查签名身份是否与此应用匹配。已安装的游戏未被更改。"
          }
        }
      }
    },
