    "Unsaved progress will be lost. You will return to your games.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungespeicherter Fortschritt geht verloren. Du kehrst zu deinen Spielen zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsaved progress will be lost. You will return to your games."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderá el progreso no guardado. Volverás a tus juegos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression non enregistrée sera perdue. Vous reviendrez à vos jeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progressi non salvati andranno persi. Tornerai ai tuoi giochi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されていない進行状況は失われます。ゲーム一覧に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 않은 진행 상황은 사라집니다. 게임 목록으로 돌아갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso não salvo será perdido. Você voltará aos seus jogos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Osparade framsteg går förlorade. Du återvänder till dina spel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存的进度将会丢失。你将返回游戏库。"
          }
        }
      }
    },
    "Your signing identity stays on this device. It must match the team that signed this app. Imported code still needs iOS approval.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Signieridentität bleibt auf diesem Gerät. Sie muss zum Team passen, das diese App signiert hat. Importierter Code benötigt weiterhin die Genehmigung von iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your signing identity stays on this device. It must match the team that signed this app. Imported code still needs iOS approval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu identidad de firma permanece en este dispositivo. Debe coincidir con el equipo que firmó esta app. El código importado sigue necesitando la aprobación de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre identité de signature reste sur cet appareil. Elle doit correspondre à l’équipe qui a signé cette app. Le code importé nécessite toujours l’approbation d’iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua identità di firma rimane su questo dispositivo. Deve corrispondere al team che ha firmato questa app. Il codice importato richiede comunque l’approvazione di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名用IDはこのデバイスに保存されます。このアプリに署名したチームと一致する必要があります。インポートしたコードには引き続きiOSの承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명 ID는 이 기기에 보관됩니다. 이 앱에 서명한 팀과 일치해야 합니다. 가져온 코드에는 여전히 iOS의 승인이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua identidade de assinatura fica neste dispositivo. Ela deve corresponder à equipe que assinou este app. O código importado ainda precisa da aprovação do iOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din signeringsidentitet stannar på den här enheten. Den måste stämma överens med teamet som signerade appen. Importerad kod behöver fortfarande godkännas av iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的签名身份将保留在此设备上，且必须与此应用的签名团队匹配。导入的代码仍需获得 iOS 许可。"
          }
        }
      }
    },
