    "%@ appears twice in launcher.json.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ steht zweimal in launcher.json."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ appears twice in launcher.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aparece dos veces en launcher.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ apparaît deux fois dans launcher.json."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ compare due volte in launcher.json."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が launcher.json に 2 回出てきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) launcher.json에 두 번 나옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
