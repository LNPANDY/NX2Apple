{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is not a DM_ switch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is not a DM_ switch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 不是 DM_ 开关。"
          }
        }
      }
    },
    "%@ (from Settings)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (from Settings)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（来自设置）"
          }
        }
      }
    },
    "%@ appears twice in launcher.json.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ appears twice in launcher.json."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在 launcher.json 中出现了两次。"
          }
        }
      }
    },
    "%@ has a wrong or missing value at \"%@\".": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has a wrong or missing value at \"%@\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 \"%@\" 值错误或缺失。"
          }
        }
      }
    },
    "%@ has no \"%@\"%@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no \"%@\"%@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 缺少 \"%@\"%@。"
          }
        }
      }
    },
    "%@ has the unknown kind \"%@\".": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has the unknown kind \"%@\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的类型 \"%@\" 未知。"
          }
        }
      }
    },
    "%@ is a choice without [value, label] options.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a choice without [value, label] options."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是没有 [value, label] 选项的选择项。"
          }
        }
      }
    },
    "%@ is a range without min, max and step.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a range without min, max and step."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是缺少 min、max、step 的范围项。"
          }
        }
      }
    },
    "%@ is not in this game's folder. Install the game again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not in this game's folder. Install the game again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在此游戏的文件夹中。请重新安装游戏。"
          }
        }
      }
    },
    "%@ is not valid JSON.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not valid JSON."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是有效的 JSON。"
          }
        }
      }
    },
    "%lld additional content packs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld additional content packs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个附加内容包"
          }
        }
      }
    },
    "1 additional content pack": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 additional content pack"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个附加内容包"
          }
        }
      }
    },
    "Can't read this game": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't read this game"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此游戏"
          }
        }
      }
