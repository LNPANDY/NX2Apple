    "The game framework binary does not have enough header space for a code signature.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Binärdatei des Spiel-Frameworks hat nicht genug Header-Platz für eine Codesignatur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game framework binary does not have enough header space for a code signature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El binario del framework del juego no tiene suficiente espacio de cabecera para una firma de código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le binaire du framework du jeu ne dispose pas d'assez d'espace d'en-tête pour une signature de code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
