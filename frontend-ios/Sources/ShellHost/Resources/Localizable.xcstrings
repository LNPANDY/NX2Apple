            "state": "translated",
            "value": "Inicia este juego una vez para terminar la sincronización en la nube anterior antes de importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez ce jeu une fois pour terminer la synchronisation cloud précédente avant d’importer."
          }
        },
        "it": {
