    "%@ is not in this game's folder. Install the game again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fehlt im Ordner dieses Spiels. Installiere das Spiel erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not in this game's folder. Install the game again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está en la carpeta de este juego. Vuelve a instalar el juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas dans le dossier de ce jeu. Réinstallez le jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è nella cartella di questo gioco. Installa di nuovo il gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がこのゲームのフォルダにありません。ゲームをもう一度インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이 게임의 폴더에 없습니다. 게임을 다시 설치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não está na pasta deste jogo. Instale o jogo de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ finns inte i spelets mapp. Installera spelet igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在此游戏的文件夹中。请重新安装游戏。"
          }
        }
      }
    },
    "%@ is not ready to launch.": {
      "localizations": {
        "de": {
