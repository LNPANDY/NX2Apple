    "“%@” holds unjoined .nxpart split files. External folders cannot read split parts directly. Copy them to games/%@ in this app's folder in Files to join automatically, or use a whole romfs.img.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ enthält nicht zusammengefügte .nxpart-Teildateien. Externe Ordner können Teildateien nicht direkt lesen. Kopiere sie in „Dateien“ nach games/%@ im Ordner dieser App, um sie automatisch zusammenzufügen, oder verwende eine vollständige romfs.img."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” holds unjoined .nxpart split files. External folders cannot read split parts directly. Copy them to games/%@ in this app's folder in Files to join automatically, or use a whole romfs.img."
          }
        },
        "es": {
