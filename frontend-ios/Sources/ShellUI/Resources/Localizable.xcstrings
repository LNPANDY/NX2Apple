    "A Switch 2 game. It needs a lot of memory and may not start on every device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Switch-2-Spiel. Es braucht viel Speicher und startet vielleicht nicht auf jedem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Switch 2 game. It needs a lot of memory and may not start on every device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un juego de Switch 2. Necesita mucha memoria y puede que no arranque en todos los dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jeu Switch 2. Il demande beaucoup de mémoire et peut ne pas démarrer sur tous les appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gioco Switch 2. Richiede molta memoria e potrebbe non avviarsi su tutti i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 2のゲームです。多くのメモリを使うため、すべてのデバイスで起動するとは限りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch 2 게임입니다. 메모리를 많이 사용하며 일부 기기에서는 시작되지 않을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jogo de Switch 2. Ele precisa de muita memória e pode não iniciar em todos os dispositivos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett Switch 2-spel. Det kräver mycket minne och startar kanske inte på alla enheter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 Switch 2 游戏。它需要大量内存，可能无法在所有设备上启动。"
          }
        }
      }
    },
