    "Glass is the glass keys, Moon is the picture skin, and Moon (badges) is the picture skin with letter badges.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glass sind die gläsernen Tasten, Moon ist die Bild-Skin, und Moon (Abzeichen) ist die Bild-Skin mit Buchstabenabzeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glass is the glass keys, Moon is the picture skin, and Moon (badges) is the picture skin with letter badges."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 = 玻璃按键；冥月 = 图标皮肤；冥月（角标）= 带字母角标的图标皮肤"
          }
        }
      }
    },
    "Glass is the glass keys, Thorn is the picture skin, Thorn (badges) is the picture skin with letter badges, and Black iron is the picture skin in black-iron rings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glass sind die gläsernen Tasten, Thorn ist die Bild-Skin, Thorn (Abzeichen) ist die Bild-Skin mit Buchstabenabzeichen, und Black iron ist die Bild-Skin in Ringen aus schwarzem Eisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glass is the glass keys, Thorn is the picture skin, Thorn (badges) is the picture skin with letter badges, and Black iron is the picture skin in black-iron rings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 = 玻璃按键；黑荆棘 = 图标皮肤；黑荆棘（角标）= 带字母角标的图标皮肤；黑铁 = 黑铁金属外框的图标皮肤"
          }
        }
      }
    },
