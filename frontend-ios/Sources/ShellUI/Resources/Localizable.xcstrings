    "Refresh this app on your computer or signing tool soon. Your saves and game data stay safe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneuere die Signatur dieser App bald am Computer oder mit deinem Signier-Tool. Deine Spielstände und Spieldaten bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh this app on your computer or signing tool soon. Your saves and game data stay safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renueva pronto esta app en tu ordenador o herramienta de firma. Tus partidas guardadas y datos del juego se conservarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvelez bientôt cette app sur votre ordinateur ou votre outil de signature. Vos sauvegardes et données de jeu restent intactes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinnova presto questa app dal computer o dallo strumento di firma. I salvataggi e i dati di gioco restano al sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早めにパソコンや署名ツールでこのアプリを再署名してください。セーブデータとゲームデータはそのまま保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터나 서명 도구에서 앱을 미리 갱신하세요. 세이브 데이터와 게임 데이터는 안전하게 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renove este app em breve no computador ou na ferramenta de assinatura. Seus dados salvos e dados do jogo continuam seguros."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnya appen snart på datorn eller i ditt signeringsverktyg. Dina sparfiler och speldata ligger kvar säkert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请尽快在电脑或续签工具上刷新签名。你的存档和游戏数据不会丢失。"
          }
        }
      }
    },
