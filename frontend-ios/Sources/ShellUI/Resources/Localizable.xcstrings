    "Loads each program's shader libraries in the background, whether a draw uses them or not.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt die Shader-Bibliotheken jedes Programms im Hintergrund, ob ein Draw Call sie nutzt oder nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loads each program's shader libraries in the background, whether a draw uses them or not."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga en segundo plano las bibliotecas de shaders de cada programa, las use o no un dibujado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge en arrière-plan les bibliothèques de shaders de chaque programme, qu’un draw call les utilise ou non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica in background le librerie di shader di ogni programma, che una draw call le usi o no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画で使うかどうかに関わらず、各プログラムのシェーダーライブラリをバックグラウンドで読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리기에서 쓰든 안 쓰든 각 프로그램의 셰이더 라이브러리를 백그라운드에서 불러옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega em segundo plano as bibliotecas de shaders de cada programa, quer um desenho as use ou não."
