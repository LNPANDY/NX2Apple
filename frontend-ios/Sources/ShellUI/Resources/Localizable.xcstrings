    "Saves are deleted too and cannot be brought back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spielstände werden auch gelöscht und lassen sich nicht wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves are deleted too and cannot be brought back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partidas también se eliminan y no se pueden recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes sont aussi supprimées et ne peuvent pas être récupérées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche i salvataggi vengono eliminati e non si possono recuperare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブデータも削除され、元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 데이터도 삭제되며 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saves também são excluídos e não podem ser recuperados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparfilerna raderas också och kan inte återställas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档也会被删除，且无法恢复。"
          }
        }
      }
    },
    "Saves memory on devices without hardware BC textures, with slightly less precise HDR textures.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spart Speicher auf Geräten ohne Hardware-BC-Texturen, mit etwas weniger genauen HDR-Texturen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves memory on devices without hardware BC textures, with slightly less precise HDR textures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahorra memoria en dispositivos sin texturas BC por hardware, con texturas HDR algo menos precisas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Économise de la mémoire sur les appareils sans textures BC matérielles, avec des textures HDR un peu moins précises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risparmia memoria sui dispositivi senza texture BC hardware, con texture HDR un po' meno precise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードウェアBCテクスチャのない端末でメモリを節約します。HDRテクスチャの精度は少し下がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하드웨어 BC 텍스처가 없는 기기에서 메모리를 아끼며, HDR 텍스처의 정밀도가 약간 낮아집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Economiza memória em dispositivos sem texturas BC em hardware, com texturas HDR um pouco menos precisas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparar minne på enheter utan hårdvaru-BC-texturer, med något mindre exakta HDR-texturer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在不支持硬件 BC 贴图的设备上节省内存，HDR 贴图的精度会略有下降。"
          }
        }
      }
    },
    "Saves stay unless you choose to delete them too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielstände bleiben, außer du löschst sie ausdrücklich mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves stay unless you choose to delete them too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partidas se conservan salvo que elijas eliminarlas también."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes restent, sauf si vous choisissez de les supprimer aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I salvataggi restano, a meno che tu non scelga di eliminarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を選ばない限り、セーブデータは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 데이터는 함께 삭제하도록 선택하지 않으면 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saves ficam, a menos que você escolha excluí-los também."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparfilerna ligger kvar om du inte väljer att radera dem också."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你选择一并删除，否则存档会保留。"
