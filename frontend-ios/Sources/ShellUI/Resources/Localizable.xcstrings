    "Switch in the game with the button at the top centre. 3D adds the D-pad, L3 and R3.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Spiel umschalten mit der Taste oben in der Mitte. 3D hat zusätzlich Steuerkreuz, L3 und R3."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch in the game with the button at the top centre. 3D adds the D-pad, L3 and R3."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia dentro del juego con el botón de arriba en el centro. 3D añade la cruceta, L3 y R3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En jeu, changez avec le bouton en haut au centre. Le 3D ajoute la croix, L3 et R3."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel gioco si cambia con il pulsante in alto al centro. Il 3D aggiunge la croce direzionale, L3 e R3."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム内では上部中央のボタンで切り替えます。3D では十字キー、L3、R3 が加わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 안에서 맨 위 가운데 버튼으로 전환합니다. 3D는 방향키, L3, R3를 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque dentro do jogo com o botão no centro do topo. O 3D adiciona o direcional, L3 e R3."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt i spelet med knappen överst i mitten. 3D har även styrkors, L3 och R3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏中用顶部中间的按钮切换。3D 另有十字键、L3 和 R3。"
          }
        }
      }
    },
    "Tap a button to change what it sends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Taste, um zu ändern, was sie auslöst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a button to change what it sends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un botón para cambiar lo que envía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un bouton pour changer ce qu’il envoie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tasto per cambiare il suo comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンをタップすると、送る入力を変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼을 탭해 보내는 것을 바꾸세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um botão para mudar o que ele envia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en knapp för att ändra vad den skickar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按某个按键即可更改它对应的键。"
          }
        }
      }
    },
    "Tap a control in the picture.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Taste im Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a control in the picture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un control en la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une commande dans l’image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un comando nell’immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像内のコントロールをタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에서 컨트롤을 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um controle na imagem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en kontroll i bilden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按画面中的一个按键。"
          }
        }
      }
    },
    "The cloud save for %@ could not be read right now. You can play with this device's save without overwriting the cloud file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cloud-Spielstand für %@ konnte gerade nicht gelesen werden. Du kannst mit dem Spielstand dieses Geräts spielen, ohne die Cloud-Datei zu überschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud save for %@ could not be read right now. You can play with this device's save without overwriting the cloud file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el guardado en la nube de %@ en este momento. Puedes jugar con la partida de este dispositivo sin sobrescribir el archivo de la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde cloud de %@ n’a pas pu être lue pour le moment. Vous pouvez jouer avec la sauvegarde de cet appareil sans écraser le fichier cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere ora il salvataggio cloud di %@. Puoi giocare con il salvataggio di questo dispositivo senza sovrascrivere il file nel cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在 %@ のクラウドセーブを読み取れませんでした。クラウド上のファイルを上書きせずに、このデバイスのセーブデータでプレイできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 %@의 클라우드 세이브를 읽을 수 없습니다. 클라우드 파일을 덮어쓰지 않고 이 기기의 세이브로 플레이할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o salvamento na nuvem de %@ agora. Você pode jogar com o salvamento deste dispositivo sem substituir o arquivo na nuvem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Molnsparfilen för %@ kunde inte läsas just nu. Du kan spela med den här enhetens sparfil utan att skriva över molnfilen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法读取 %@ 的云存档。你可以先使用本机存档游玩，不会覆盖云端文件。"
          }
        }
      }
    },
    "The first start waits a few minutes for it, once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Start wartet dafür einmalig einige Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first start waits a few minutes for it, once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer inicio espera unos minutos por ello, una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier démarrage l’attend quelques minutes, une seule fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al primo avvio prepara le pipeline grafiche. L’operazione può richiedere alcuni minuti e viene eseguita una sola volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回起動時に 1 回だけ、数分待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 실행 때 한 번 몇 분 기다립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira inicialização espera alguns minutos por isso, uma só vez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första starten väntar några minuter på det, en gång."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次启动需要等待几分钟，仅此一次。"
          }
        }
      }
    },
    "The game’s data on this device is deleted and the game leaves the list. A folder you chose yourself is not touched. Send the game data from your Mac again to bring it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spieldaten auf diesem Gerät werden gelöscht und das Spiel verschwindet aus der Liste. Ein Ordner, den du selbst gewählt hast, bleibt unberührt. Sende die Spieldaten erneut von deinem Mac, um es zurückzuholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game’s data on this device is deleted and the game leaves the list. A folder you chose yourself is not touched. Send the game data from your Mac again to bring it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan los datos del juego en este dispositivo y el juego sale de la lista. Una carpeta que elegiste tú no se toca. Vuelve a enviar los datos del juego desde tu Mac para recuperarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données du jeu sur cet appareil sont supprimées et le jeu quitte la liste. Un dossier que vous avez choisi vous-même n’est pas touché. Envoyez à nouveau les données du jeu depuis votre Mac pour le retrouver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati del gioco su questo dispositivo vengono eliminati e il gioco viene rimosso dall’elenco. Un’eventuale cartella scelta da te non viene toccata. Invia nuovamente i dati del gioco dal tuo Mac per ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス上のゲームのデータが削除され、ゲームは一覧から消えます。自分で選んだフォルダには手を加えません。元に戻すには、Mac からもう一度ゲームデータを送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 게임 데이터가 삭제되고 게임이 목록에서 빠집니다. 직접 선택한 폴더는 건드리지 않습니다. 되돌리려면 Mac에서 게임 데이터를 다시 보내세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados do jogo neste dispositivo são excluídos e o jogo sai da lista. Uma pasta que você mesmo escolheu não é tocada. Envie os dados do jogo do seu Mac de novo para trazê-lo de volta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Speldatan på den här enheten raderas och spelet försvinner från listan. En mapp du själv har valt rörs inte. Skicka speldatan från din Mac igen för att få tillbaka det."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备上的游戏数据会被删除，游戏也会从列表中移除。你自己选择的文件夹不受影响。从 Mac 再次发送游戏数据即可恢复。"
          }
        }
      }
    },
    "The size of the on-screen controls. Controls move toward medium when a size does not fit the screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Größe der Steuerelemente auf dem Bildschirm. Passt eine Größe nicht auf den Bildschirm, rücken sie zur mittleren Größe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The size of the on-screen controls. Controls move toward medium when a size does not fit the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño de los controles en pantalla. Si un tamaño no cabe en la pantalla, los controles se acercan al mediano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille des commandes à l'écran. Elles se rapprochent de la taille moyenne quand une taille ne tient pas à l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dimensione dei comandi sullo schermo. Si avvicinano alla dimensione media quando una dimensione non sta nello schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上のコントロールの大きさです。画面に収まらない大きさは、中くらいに近づきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 속 컨트롤의 크기입니다. 크기가 화면에 맞지 않으면 컨트롤이 보통 크기에 가까워집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho dos controles na tela. Se um tamanho não couber na tela, os controles se aproximam do médio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Storleken på kontrollerna på skärmen. De flyttas mot medelstorlek när en storlek inte får plats på skärmen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕控件的大小。尺寸放不下时，控件会向中等尺寸靠拢。"
          }
        }
      }
    },
    "This game needs a newer version of this app. Update it with the Mac app on your Mac, then install it on this device again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Spiel braucht eine neuere Version dieser App. Aktualisiere sie mit der Mac-App auf deinem Mac und installiere sie dann erneut auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game needs a newer version of this app. Update it with the Mac app on your Mac, then install it on this device again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este juego necesita una versión más nueva de esta app. Actualízala con la app de Mac en tu Mac y luego vuelve a instalarla en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu nécessite une version plus récente de cette app. Mettez-la à jour avec l’app Mac sur votre Mac, puis réinstallez-la sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gioco richiede una versione più recente dell’app. Aggiornala dal launcher sul tuo Mac, poi installala nuovamente su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームには、このアプリの新しいバージョンが必要です。Mac の Mac アプリでアップデートしてから、このデバイスにもう一度インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임에는 이 앱의 새 버전이 필요합니다. Mac의 Mac 앱으로 업데이트한 뒤 이 기기에 다시 설치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este jogo precisa de uma versão mais nova deste app. Atualize-o com o app para Mac no seu Mac e instale-o de novo neste dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här spelet behöver en nyare version av appen. Uppdatera den med Mac-appen på din Mac och installera den sedan igen på den här enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此游戏需要本 App 的更新版本。请在 Mac 应用中更新。"
          }
        }
      }
    },
