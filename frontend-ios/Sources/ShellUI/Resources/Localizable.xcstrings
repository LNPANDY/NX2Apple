    "Plays Joy-Con 2 and Pro Controller 2 over Bluetooth: hold Sync on one during the game to pair it. macOS asks once for Bluetooth access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt Joy-Con 2 und Pro Controller 2 über Bluetooth: Halte während des Spiels die Sync-Taste an einem gedrückt, um ihn zu koppeln. macOS fragt einmal nach dem Bluetooth-Zugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays Joy-Con 2 and Pro Controller 2 over Bluetooth: hold Sync on one during the game to pair it. macOS asks once for Bluetooth access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Joy-Con 2 y Pro Controller 2 por Bluetooth: mantén pulsado Sync en uno durante el juego para emparejarlo. macOS pide una vez el acceso a Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise les Joy-Con 2 et la Pro Controller 2 en Bluetooth : maintenez Sync sur une manette pendant le jeu pour l’associer. macOS demande une seule fois l’accès au Bluetooth."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Joy-Con 2 e Pro Controller 2 via Bluetooth: tieni premuto Sync su uno durante il gioco per associarlo. macOS chiede una sola volta l’accesso al Bluetooth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Joy-Con 2 と Pro Controller 2 を Bluetooth で使えます。ゲーム中にコントローラーの Sync ボタンを長押しするとペアリングされます。macOS は Bluetooth へのアクセスを一度だけ確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Joy-Con 2와 Pro Controller 2를 블루투스로 사용합니다. 게임 중에 하나의 Sync를 길게 눌러 페어링하세요. macOS가 블루투스 접근을 한 번 묻습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Joy-Con 2 e Pro Controller 2 por Bluetooth: segure Sync em um deles durante o jogo para pareá-lo. O macOS pede o acesso ao Bluetooth uma vez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelar med Joy-Con 2 och Pro Controller 2 över Bluetooth: håll Sync nedtryckt på en under spelet för att para ihop den. macOS frågar en gång om åtkomst till Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过蓝牙使用 Joy-Con 2 和 Pro Controller 2：游戏中按住手柄上的同步键即可配对。macOS 会请求一次蓝牙访问权限。"
          }
        }
      }
    },
    "Plays game audio alongside other apps instead of stopping them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt den Spielton zusammen mit anderen Apps ab, statt sie zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays game audio alongside other apps instead of stopping them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce el audio del juego junto con otras apps en lugar de detenerlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit le son du jeu en même temps que d’autres apps au lieu de les interrompre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce l’audio del gioco insieme ad altre app invece di interromperle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリを停止せず、ゲームの音声を同時に再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱을 멈추지 않고 게임 오디오를 함께 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz o áudio do jogo junto com outros apps em vez de interrompê-los."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelar upp spelljud tillsammans med andra appar i stället för att stoppa dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让游戏声音与其他 App 的音频同时播放，而不是中断它们。"
          }
        }
      }
    },
