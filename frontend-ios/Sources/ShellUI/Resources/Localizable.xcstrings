    "For controllers in games only. This app’s menus keep A to confirm and B to go back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Controller in Spielen. Die Menüs dieser App bestätigen weiter mit A und gehen mit B zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For controllers in games only. This app’s menus keep A to confirm and B to go back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para mandos dentro de los juegos. Los menús de esta app mantienen A para confirmar y B para volver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement pour les manettes en jeu. Les menus de cette app gardent A pour valider et B pour revenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per i controller nei giochi. I menu di questa app usano sempre A per confermare e B per tornare indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム内のコントローラーだけに適用されます。このアプリのメニューでは、A で決定、B で戻るのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 안의 컨트롤러에만 적용됩니다. 이 앱의 메뉴는 A로 확인하고 B로 뒤로 갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para controles dentro dos jogos. Os menus deste app mantêm A para confirmar e B para voltar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara för handkontroller i spel. Appens menyer bekräftar fortfarande med A och går tillbaka med B."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对游戏中的手柄有效。本应用的菜单仍用 A 确认、B 返回。"
          }
        }
      }
    },
    "For this game only. A button left alone does what it does in all games.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für dieses Spiel. Eine unveränderte Taste verhält sich wie in allen Spielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For this game only. A button left alone does what it does in all games."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para este juego. Un botón que no toques hace lo que hace en todos los juegos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ce jeu uniquement. Un bouton non modifié fait la même chose que dans tous les jeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per questo gioco. Un tasto non modificato funziona come in tutti gli altri giochi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームだけに適用されます。変更していないボタンは、すべてのゲーム共通の動作になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임에만 적용됩니다. 건드리지 않은 버튼은 모든 게임에서와 같게 동작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para este jogo. Um botão que você não mexer faz o que faz em todos os jogos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara för det här spelet. En knapp du inte ändrar gör samma sak som i alla spel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对此游戏有效。未更改的按键与所有游戏相同。"
          }
        }
      }
    },
