    "Brings back the settings this game was tested with.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt die Einstellungen wieder her, mit denen dieses Spiel getestet wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings back the settings this game was tested with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura los ajustes con los que se probó este juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit les réglages avec lesquels ce jeu a été testé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina le impostazioni con cui questo gioco è stato testato."
