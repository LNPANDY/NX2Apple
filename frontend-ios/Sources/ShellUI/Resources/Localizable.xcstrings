    "Build this game again on your Mac and install it on this device. The Mac app checks every file while it builds, so the new copy is complete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue dieses Spiel auf deinem Mac neu und installiere es auf diesem Gerät. Die Mac-App prüft beim Bauen jede Datei, die neue Kopie ist also vollständig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build this game again on your Mac and install it on this device. The Mac app checks every file while it builds, so the new copy is complete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recompilez ce jeu sur votre Mac et installez-le sur cet appareil. L’app Mac vérifie chaque fichier pendant la compilation, la nouvelle copie est donc complète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricompila questo gioco sul Mac e installalo su questo dispositivo. L’app per Mac controlla ogni file durante la compilazione, quindi la nuova copia è completa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac でこのゲームをもう一度ビルドし、このデバイスにインストールしてください。Mac アプリはビルド中にすべてのファイルを確認するので、新しいコピーは完全なものになります。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygg spelet igen på din Mac och installera det på den här enheten. Mac-appen kontrollerar varje fil när den bygger, så den nya kopian är komplett."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上重新构建此游戏并安装到本设备。Mac 应用构建时会检查每个文件，新副本是完整的。"
          }
        }
      }
    },
