    "Deletes the game’s data on this device. You choose whether its saves go too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Spieldaten auf diesem Gerät. Du entscheidest, ob die Spielstände mitgehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the game’s data on this device. You choose whether its saves go too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les données du jeu sur cet appareil. Vous choisissez si ses sauvegardes partent aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina i dati del gioco su questo dispositivo. Scegli tu se eliminare anche i salvataggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス上のゲームのデータを削除します。セーブデータも削除するかは選べます。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderar speldatan på den här enheten. Du väljer om sparfilerna också ska bort."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这台设备上的游戏数据。是否一并删除存档由你决定。"
          }
        }
      }
    },
