    "Saves are deleted too and cannot be brought back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spielstände werden auch gelöscht und lassen sich nicht wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves are deleted too and cannot be brought back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes sont aussi supprimées et ne peuvent pas être récupérées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche i salvataggi vengono eliminati e non si possono recuperare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparfilerna raderas också och kan inte återställas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档也会被删除，且无法恢复。"
          }
        }
      }
    },
    "Saves stay unless you choose to delete them too.": {
      "localizations": {
        "de": {
          "stringUnit": {
