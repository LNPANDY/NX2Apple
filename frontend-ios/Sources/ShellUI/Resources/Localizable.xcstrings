  "strings": {
    "%lld of %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 个，共 %lld"
          }
        }
      }
    },
    "120 Hz": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "120 Hz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "120 帧"
          }
        }
      }
    },
    "120 Hz needs a screen that supports it and falls back to 60 Hz on one that does not. Sustained heavy load may throttle with heat, so use it with care.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "120 Hz braucht einen Bildschirm, der das unterstützt, und fällt sonst auf 60 Hz zurück. Dauerhaft hohe Last kann durch Hitze drosseln, also bitte mit Vorsicht nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "120 Hz needs a screen that supports it and falls back to 60 Hz on one that does not. Sustained heavy load may throttle with heat, so use it with care."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "120 帧需要设备屏幕支持，若设备不支持会自动回落 60 帧，持续高负载下可能因温控而降频，请谨慎使用"
          }
        }
      }
    },
