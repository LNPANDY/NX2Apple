    "Renders about a quarter more pixels: a little slower and warmer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet etwa ein Viertel mehr Pixel: etwas langsamer und wärmer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renders about a quarter more pixels: a little slower and warmer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza aproximadamente un cuarto más de píxeles: algo más lento y más caliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule environ un quart de pixels en plus : un peu plus lent et plus chaud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcola circa un quarto di pixel in più: un po’ più lento e più caldo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画するピクセルが約 4 分の 1 増えます。少し遅くなり、発熱も少し増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 4분의 1 더 많은 픽셀을 렌더링하여 조금 느려지고 더 뜨거워집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza cerca de um quarto a mais de pixels: um pouco mais lento e mais quente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderar ungefär en fjärdedel fler pixlar: lite långsammare och varmare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渲染的像素约多四分之一：稍慢，发热稍多。"
          }
        }
      }
    },
    "Replaces this device's current save with the backup from %@. Your current save is backed up first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt den aktuellen Spielstand auf diesem Gerät durch das Backup vom %@. Dein aktueller Spielstand wird zuvor gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces this device's current save with the backup from %@. Your current save is backed up first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplaza la partida actual de este dispositivo con la copia de %@. Primero se respaldará tu partida actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace la sauvegarde actuelle de cet appareil par la copie du %@. Votre sauvegarde actuelle est d’abord sauvegardée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisce il salvataggio attuale su questo dispositivo con il backup del %@. Il salvataggio attuale viene prima copiato nei backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの現在のセーブデータを %@ のバックアップに置き換えます。現在のセーブデータは先にバックアップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 현재 세이브를 %@ 백업으로 바꿉니다. 현재 세이브는 먼저 백업됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui o salvamento atual deste dispositivo pelo backup de %@. Seu salvamento atual será copiado antes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersätter enhetens nuvarande sparfil med säkerhetskopian från %@. Din nuvarande sparfil säkerhetskopieras först."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将用 %@ 的备份替换本机当前存档。替换前会先自动备份当前存档。"
          }
        }
      }
    },
