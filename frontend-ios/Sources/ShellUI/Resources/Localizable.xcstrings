    "Adjusts resolution between 70% and 100% under load. Turn off to keep full resolution for the selected console mode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt die Auflösung unter Last zwischen 70 % und 100 % an. Ausschalten, um die volle Auflösung des gewählten Konsolenmodus zu behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjusts resolution between 70% and 100% under load. Turn off to keep full resolution for the selected console mode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la résolution entre 70 % et 100 % selon la charge. Désactivez pour garder la pleine résolution du mode choisi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassar upplösningen mellan 70 % och 100 % under belastning. Stäng av för att behålla full upplösning för det valda konsolläget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负载较高时在 70% 到 100% 之间调整分辨率。关闭后保持所选主机模式的完整分辨率。"
          }
        }
      }
    },
