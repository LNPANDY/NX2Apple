          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara för handkontroller i spel. Appens menyer bekräftar fortfarande med A och går tillbaka med B."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对游戏中的手柄有效。本应用的菜单仍用 A 确认、B 返回。"
          }
        }
      }
    },
    "For every game. On a screen too small for a size, the controls stay smaller.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für alle Spiele. Ist der Bildschirm für eine Größe zu klein, bleiben die Tasten kleiner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For every game. On a screen too small for a size, the controls stay smaller."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour tous les jeux. Sur un écran trop petit pour une taille, les commandes restent plus petites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tutti i giochi. Su uno schermo troppo piccolo per una dimensione, i comandi restano più piccoli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För alla spel. På en skärm som är för liten för en storlek förblir kontrollerna mindre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于所有游戏。屏幕放不下所选大小时，按键会保持较小。"
          }
        }
      }
    },
    "For this game only. A button left alone does what it does in all games.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für dieses Spiel. Eine unveränderte Taste verhält sich wie in allen Spielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For this game only. A button left alone does what it does in all games."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ce jeu uniquement. Un bouton non modifié fait la même chose que dans tous les jeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per questo gioco. Un tasto non modificato fa ciò che fa in tutti i giochi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara för det här spelet. En knapp du inte ändrar gör samma sak som i alla spel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对此游戏有效。未更改的按键与所有游戏相同。"
          }
        }
      }
    },
