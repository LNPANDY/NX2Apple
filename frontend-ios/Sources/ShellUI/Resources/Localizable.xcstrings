    "Switch in the game with the button at the top centre. 3D adds the D-pad, L3 and R3.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Spiel umschalten mit der Taste oben in der Mitte. 3D hat zusätzlich Steuerkreuz, L3 und R3."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch in the game with the button at the top centre. 3D adds the D-pad, L3 and R3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En jeu, changez avec le bouton en haut au centre. Le 3D ajoute la croix, L3 et R3."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel gioco si cambia con il pulsante in alto al centro. Il 3D aggiunge la croce direzionale, L3 e R3."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム内では上部中央のボタンで切り替えます。3D では十字キー、L3、R3 が加わります。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt i spelet med knappen överst i mitten. 3D har även styrkors, L3 och R3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏中用顶部中间的按钮切换。3D 另有十字键、L3 和 R3。"
          }
        }
      }
    },
    "Tap a button to change what it sends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Taste, um zu ändern, was sie auslöst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a button to change what it sends."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un bouton pour changer ce qu’il envoie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tasto per cambiare il suo comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンをタップすると、送る入力を変更できます。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en knapp för att ändra vad den skickar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按某个按键即可更改它对应的键。"
          }
        }
      }
    },
    "Tap a control in the picture.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Taste im Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a control in the picture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une commande dans l’image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un comando nell’immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像内のコントロールをタップしてください。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en kontroll i bilden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按画面中的一个按键。"
          }
        }
      }
    },
    "The first start waits a few minutes for it, once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Start wartet dafür einmalig einige Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first start waits a few minutes for it, once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier démarrage l’attend quelques minutes, une seule fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al primo avvio prepara le pipeline grafiche. L’operazione può richiedere alcuni minuti e viene eseguita una sola volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回起動時に 1 回だけ、数分待ちます。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första starten väntar några minuter på det, en gång."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次启动需要等待几分钟，仅此一次。"
          }
        }
      }
    },
    "The game’s data on this device is deleted and the game leaves the list. A folder you chose yourself is not touched. Send the game data from your Mac again to bring it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spieldaten auf diesem Gerät werden gelöscht und das Spiel verschwindet aus der Liste. Ein Ordner, den du selbst gewählt hast, bleibt unberührt. Sende die Spieldaten erneut von deinem Mac, um es zurückzuholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game’s data on this device is deleted and the game leaves the list. A folder you chose yourself is not touched. Send the game data from your Mac again to bring it back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données du jeu sur cet appareil sont supprimées et le jeu quitte la liste. Un dossier que vous avez choisi vous-même n’est pas touché. Envoyez à nouveau les données du jeu depuis votre Mac pour le retrouver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati del gioco su questo dispositivo vengono eliminati e il gioco viene rimosso dall’elenco. Un’eventuale cartella scelta da te non viene toccata. Invia nuovamente i dati del gioco dal tuo Mac per ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス上のゲームのデータが削除され、ゲームは一覧から消えます。自分で選んだフォルダには手を加えません。元に戻すには、Mac からもう一度ゲームデータを送ってください。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Speldatan på den här enheten raderas och spelet försvinner från listan. En mapp du själv har valt rörs inte. Skicka speldatan från din Mac igen för att få tillbaka det."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备上的游戏数据会被删除，游戏也会从列表中移除。你自己选择的文件夹不受影响。从 Mac 再次发送游戏数据即可恢复。"
          }
        }
      }
    },
    "This game needs a newer version of this app. Update it with the Mac app on your Mac, then install it on this device again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Spiel braucht eine neuere Version dieser App. Aktualisiere sie mit der Mac-App auf deinem Mac und installiere sie dann erneut auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game needs a newer version of this app. Update it with the Mac app on your Mac, then install it on this device again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu nécessite une version plus récente de cette app. Mettez-la à jour avec l’app Mac sur votre Mac, puis réinstallez-la sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gioco richiede una versione più recente dell’app. Aggiornala dal launcher sul tuo Mac, poi installala nuovamente su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームには、このアプリの新しいバージョンが必要です。Mac の Mac アプリでアップデートしてから、このデバイスにもう一度インストールしてください。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här spelet behöver en nyare version av appen. Uppdatera den med Mac-appen på din Mac och installera den sedan igen på den här enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此游戏需要本 App 的更新版本。请在 Mac 应用中更新。"
          }
        }
      }
    },
