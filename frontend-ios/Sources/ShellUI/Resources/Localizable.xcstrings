    "Both the cloud save and this device's save for %@ changed since they were last in sync. The save you do not pick is backed up in save-backups.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sowohl der Cloud-Spielstand als auch der Spielstand auf diesem Gerät für %@ wurden seit der letzten Synchronisierung geändert. Der nicht gewählte Spielstand wird in save-backups gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both the cloud save and this device's save for %@ changed since they were last in sync. The save you do not pick is backed up in save-backups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanto el guardado en la nube como el de este dispositivo para %@ cambiaron desde la última sincronización. La partida que no elijas se guardará en save-backups."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde cloud et celle de cet appareil pour %@ ont toutes deux changé depuis la dernière synchronisation. Celle que vous ne choisissez pas est conservée dans save-backups."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sia il salvataggio cloud sia quello su questo dispositivo per %@ sono cambiati dall’ultima sincronizzazione. Il salvataggio non scelto viene conservato in save-backups."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のクラウドセーブとこのデバイスのセーブデータの両方が前回の同期以降に変更されています。選ばなかった方のセーブデータは save-backups にバックアップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 동기화 이후 %@의 클라우드 세이브와 이 기기의 세이브가 모두 변경되었습니다. 선택하지 않은 세이브는 save-backups에 백업됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanto o salvamento na nuvem quanto o deste dispositivo para %@ mudaram desde a última sincronização. O salvamento não escolhido será guardado em save-backups."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Både molnsparfilen och enhetens sparfil för %@ har ändrats sedan senaste synkroniseringen. Den sparfil du inte väljer sparas i save-backups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的云存档与本机存档自上次同步后都有修改。未被选中的那份存档会自动备份到 save-backups。"
          }
        }
      }
    },
