    "Positions are saved for portrait and tabletop controls.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Positionen werden für Hochformat- und Tischmodus-Steuerung gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positions are saved for portrait and tabletop controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las posiciones se guardan para los controles verticales y de sobremesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les positions sont enregistrées pour les commandes en portrait et en mode posé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le posizioni vengono salvate per i controlli verticali e in modalità da tavolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配置は縦向きとテーブルトップのコントロール用に保存されます。"
