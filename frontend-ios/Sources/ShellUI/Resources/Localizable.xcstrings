    "Allow other apps to keep playing audio alongside games.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt anderen Apps, während des Spiels weiter Ton abzuspielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow other apps to keep playing audio alongside games."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que otras apps sigan reproduciendo audio mientras juegas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise d’autres apps à continuer la lecture audio pendant le jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente ad altre app di continuare a riprodurre audio durante il gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームのプレイ中も、ほかのアプリで音声を再生し続けられるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임을 플레이하는 동안 다른 앱이 오디오를 계속 재생할 수 있도록 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que outros apps continuem reproduzindo áudio durante os jogos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt andra appar att fortsätta spela upp ljud samtidigt som du spelar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许其他 App 在游玩时继续播放音频。"
          }
        }
      }
    },
