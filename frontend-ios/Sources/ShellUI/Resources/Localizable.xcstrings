    "Tap a button to change what it sends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Taste, um zu ändern, was sie auslöst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a button to change what it sends."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un bouton pour changer ce qu’il envoie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un tasto per cambiare cosa invia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
