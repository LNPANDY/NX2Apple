    "Put every control of the %@ layout back in its built-in place?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Tasten des %@-Layouts an ihren Standardplatz zurücksetzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put every control of the %@ layout back in its built-in place?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Volver a poner cada control de la disposición %@ en su sitio integrado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remettre toutes les commandes de l’agencement %@ à leur place par défaut ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimettere tutti i comandi dello schema %@ al loro posto predefinito?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ レイアウトのすべてのコントロールを標準の位置に戻しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 레이아웃의 모든 컨트롤을 기본 위치로 되돌릴까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar cada controle do layout %@ ao seu lugar integrado?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta alla kontroller i %@-layouten tillbaka till standardplatsen?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 %@ 布局的所有按键放回默认位置？"
          }
        }
      }
    },
    "Puts A on the bottom button, where Xbox and PlayStation controllers confirm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt A auf die untere Taste, wo Xbox- und PlayStation-Controller bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts A on the bottom button, where Xbox and PlayStation controllers confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone A en el botón inferior, donde confirman los mandos de Xbox y PlayStation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place A sur le bouton du bas, là où les manettes Xbox et PlayStation valident."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette A sul tasto in basso, dove confermano i controller Xbox e PlayStation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox や PlayStation のコントローラーで決定に使う下のボタンに A を割り当てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "A를 아래 버튼에 둡니다. Xbox와 PlayStation 컨트롤러가 확인에 쓰는 위치입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Põe o A no botão de baixo, onde os controles de Xbox e PlayStation confirmam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger A på den nedre knappen, där Xbox- och PlayStation-handkontroller bekräftar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 A 放到下方按键，与 Xbox 和 PlayStation 手柄的确认键位置一致。"
          }
        }
      }
    },
    "Ready to play": {
